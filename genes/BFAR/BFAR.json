_ad":0.186698,"pct_control":0.179848,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0767196,"donor_lfcse":0.0833429,"donor_log2fc_shrunk":1.14679e-05,"degas_log2fc":-0.392738,"degas_padj":4.12558e-09},{"cell_type":"Oli","gene_symbol":"BFAR","gene_symbol_current":"BFAR","gene_id":"ENSG00000103429","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0148399,"nucleus_log2fc":0.0784996,"nucleus_score":2.57161,"pct_ad":0.133482,"pct_control":0.126841,"donor_test":"not significant","donor_padj":0.927014,"donor_log2fc":0.0474693,"donor_lfcse":0.0802448,"donor_log2fc_shrunk":0.0071796,"degas_log2fc":-0.12819,"degas_padj":0.000107264}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000103429","entrez_id":["51283"],"uniprot":["Q9NZS9"],"ncbi_summary":"Enables caspase binding activity; protein-macromolecule adaptor activity; and ubiquitin protein ligase activity. Involved in negative regulation of IRE1-mediated unfolded protein response; proteasome-mediated ubiquitin-dependent protein catabolic process; and protein ubiquitination. Acts upstream of or within negative regulation of apoptotic process. Located in endoplasmic reticulum and membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NZS9","text":"Membrane-bound E3 ubiquitin ligase that plays a role in several processes including apoptosis regulation or reticulum endoplasmic stress (PubMed:14502241, PubMed:21068390). Has anti-apoptotic activity, both for apoptosis triggered via death-receptors and via mitochondrial factors (PubMed:14502241). Contributes to the dynamic control of IRE1/ERN1 signaling during ER stress by inducing BAX inhibitor 1/TMBIM6 proteasomal degradation (PubMed:21068390). Promotes the activation of TGF-beta signaling by mediating the 'Lys-63'-linked ubiquitination of TGFBR1 which is critical to activate the pathway (PubMed:33914044). Together with NGFR, negatively regulates NF-kappa-B and JNK-related signaling pathways (PubMed:22566094). Promotes the proteasome-mediated degradation of PNPLA3, a protein involveld in lipid metabolism (PubMed:38294943)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}