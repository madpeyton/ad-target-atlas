n":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000176945","module":"green","kme":0.188067,"hub":false,"module_direction":"higher in AD","module_padj":0.232138,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000176945","module":"blue","kme":0.0803166,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000176945","entrez_id":["200958"],"uniprot":["Q8N307"],"ncbi_summary":"This gene encodes a member of the mucin protein family. Mucins are high molecular weight glycoproteins secreted by many epithelial tissues to form an insoluble mucous barrier. The C-terminus of this family member associates with the multifunctional docking site of the MET proto-oncogene and suppresses activation of some downstream MET signaling cascades. The protein features a mucin tandem repeat domain that varies between two and six copies in most individuals. Multiple variants encoding different isoforms have been found for this gene. A related pseudogene, which is also located on chromosome 3, has been identified. [provided by RefSeq, Apr 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8N307","text":"May regulate MET signaling cascade. Seems to decrease hepatocyte growth factor (HGF)-induced transient MAPK activation. Blocks GRB2 recruitment to MET thus suppressing the GRB2-RAS pathway. Inhibits HGF-induced proliferation of MMP1 and MMP9 expression."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}