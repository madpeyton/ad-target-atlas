:0.61685,"pct_control":0.63198,"donor_test":"not significant","donor_padj":0.857026,"donor_log2fc":0.0382361,"donor_lfcse":0.0574015,"donor_log2fc_shrunk":0.0110889},{"cell_type":"Mic","gene_symbol":"SSX2IP","gene_symbol_current":"SSX2IP","gene_id":"ENSG00000117155","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00282706,"nucleus_log2fc":-0.243491,"nucleus_score":-3.2747,"pct_ad":0.1039,"pct_control":0.118088,"donor_test":"not significant","donor_padj":0.659328,"donor_log2fc":-0.199949,"donor_lfcse":0.148739,"donor_log2fc_shrunk":-0.0186821},{"cell_type":"OPC","gene_symbol":"SSX2IP","gene_symbol_current":"SSX2IP","gene_id":"ENSG00000117155","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0106034,"nucleus_log2fc":-0.19094,"nucleus_score":-3.04433,"pct_ad":0.172532,"pct_control":0.193057,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.202733,"donor_lfcse":0.107905,"donor_log2fc_shrunk":-1.79899e-05},{"cell_type":"Oli","gene_symbol":"SSX2IP","gene_symbol_current":"SSX2IP","gene_id":"ENSG00000117155","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":9.09261e-07,"nucleus_log2fc":0.168954,"nucleus_score":5.0665,"pct_ad":0.182848,"pct_control":0.169495,"donor_test":"not significant","donor_padj":0.690954,"donor_log2fc":0.18905,"donor_lfcse":0.114671,"donor_log2fc_shrunk":0.0162178}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000117155","module":"pink","kme":0.22336,"hub":false,"module_direction":"lower in AD","module_padj":0.531952,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000117155","module":"turquoise","kme":0.119354,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000117155","entrez_id":["117178"],"uniprot":["Q9Y2D8"],"ncbi_summary":"This gene encodes a protein that binds the cancer-testis antigen Synovial Sarcoma X breakpoint 2 protein. The encoded protein may regulate the activity of Synovial Sarcoma X breakpoint 2 protein in malignant cells. Alternate splicing results in multiple transcript variants. A pseudogene of this gene is found on chromosome 3. [provided by RefSeq, Oct 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y2D8","text":"Belongs to an adhesion system, which plays a role in the organization of homotypic, interneuronal and heterotypic cell-cell adherens junctions (AJs). May connect the nectin-afadin and E-cadherin-catenin system through alpha-actinin and may be involved in organization of the actin cytoskeleton at AJs through afadin and alpha-actinin (By similarity). Involved in cell movement: localizes at the leading edge of moving cells in response to PDGF and is required for the formation of the leading edge and the promotion of cell movement, possibly via activation of Rac signaling (By similarity). Acts as a centrosome maturation factor, probably by maintaining the integrity of the pericentriolar material and proper microtubule nucleation at mitotic spindle poles. The function seems to implicate at least in part WRAP73; the SSX2IP:WRAP73 complex is proposed to act as regulator of spindle anchoring at the mitotic centrosome (PubMed:23816619, PubMed:26545777). Involved in ciliogenesis (PubMed:24356449). It is required for targeted recruitment of the BBSome, CEP290, RAB8, and SSTR3 to the cilia (PubMed:24356449)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}