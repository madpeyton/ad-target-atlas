icant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.350504,"nucleus_log2fc":0.0499375,"nucleus_score":1.12825,"pct_ad":0.395265,"pct_control":0.390899,"donor_test":"not significant","donor_padj":0.993502,"donor_log2fc":-0.00438497,"donor_lfcse":0.116361,"donor_log2fc_shrunk":-0.000565407},{"cell_type":"OPC","gene_symbol":"ABCC5","gene_symbol_current":"ABCC5","gene_id":"ENSG00000114770","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.982773,"nucleus_log2fc":0.000304973,"nucleus_score":0.0348738,"pct_ad":0.594691,"pct_control":0.592887,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.021911,"donor_lfcse":0.100874,"donor_log2fc_shrunk":2.259e-06},{"cell_type":"Oli","gene_symbol":"ABCC5","gene_symbol_current":"ABCC5","gene_id":"ENSG00000114770","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.193817,"nucleus_log2fc":0.0267734,"nucleus_score":1.40837,"pct_ad":0.429504,"pct_control":0.426267,"donor_test":"not significant","donor_padj":0.957944,"donor_log2fc":0.049581,"donor_lfcse":0.130969,"donor_log2fc_shrunk":0.00307792}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000114770","module":"magenta","kme":0.16744,"hub":false,"module_direction":"lower in AD","module_padj":0.209344,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000114770","module":"black","kme":0.157713,"hub":false,"module_direction":"higher in AD","module_padj":0.169392,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000114770","module":"blue","kme":0.142284,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000114770","entrez_id":["10057"],"uniprot":["O15440"],"ncbi_summary":"The protein encoded by this gene is a member of the superfamily of ATP-binding cassette (ABC) transporters. ABC proteins transport various molecules across extra- and intra-cellular membranes. ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, White). This protein is a member of the MRP subfamily which is involved in multi-drug resistance. This protein functions in the cellular export of its substrate, cyclic nucleotides. This export contributes to the degradation of phosphodiesterases and possibly an elimination pathway for cyclic nucleotides. Studies show that this protein provides resistance to thiopurine anticancer drugs, 6-mercatopurine and thioguanine, and the anti-HIV drug 9-(2-phosphonylmethoxyethyl)adenine. This protein may be involved in resistance to thiopurines in acute lymphoblastic leukemia and antiretroviral nucleoside analogs in HIV-infected patients. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Feb 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O15440","text":"ATP-dependent transporter of the ATP-binding cassette (ABC) family that actively extrudes physiological compounds, and xenobiotics from cells. Mediates ATP-dependent transport of endogenous metabolites such as cAMP and cGMP, folic acid and N-lactoyl-amino acids (in vitro) (PubMed:10893247, PubMed:12637526, PubMed:12695538, PubMed:15899835, PubMed:17229149, PubMed:25964343). Also acts as a general glutamate conjugate and analog transporter that can limit the brain levels of endogenous metabolites, drugs, and toxins (PubMed:26515061). Confers resistance to the antiviral agent PMEA (PubMed:12695538). Able to transport several anticancer drugs including methotrexate, and nucleotide analogs in vitro, however it does with low affinity, thus the exact role of ABCC5 in mediating resistance still needs to be elucidated (PubMed:10840050, PubMed:12435799, PubMed:12695538, PubMed:15899835). Acts as a heme transporter required for the translocation of cytosolic heme to the secretory pathway (PubMed:24836561). May play a role in energy metabolism by regulating the glucagon-like peptide 1 (GLP-1) secretion from enteroendocrine cells (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}