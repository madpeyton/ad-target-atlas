shrunk":-3.28586e-06},{"cell_type":"Oli","gene_symbol":"MTO1","gene_symbol_current":"MTO1","gene_id":"ENSG00000135297","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.594928,"nucleus_log2fc":0.0177662,"nucleus_score":0.598815,"pct_ad":0.179468,"pct_control":0.177251,"donor_test":"not significant","donor_padj":0.93178,"donor_log2fc":0.0364572,"donor_lfcse":0.0673291,"donor_log2fc_shrunk":0.00729698}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000135297","entrez_id":["25821"],"uniprot":["Q9Y2Z2"],"ncbi_summary":"This gene encodes a mitochondrial protein thought to be involved in mitochondrial tRNA modification. The encoded protein may also play a role in the expression of the non-syndromic and aminoglycoside-induced deafness phenotypes associated with a specific mutation in the mitochondrial 12S rRNA gene. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y2Z2","text":"Component of the GTPBP3-MTO1 complex that catalyzes the 5-taurinomethyluridine (taum(5)U) modification at the 34th wobble position (U34) of mitochondrial tRNAs (mt-tRNAs), which plays a role in mt-tRNA decoding and mitochondrial translation (PubMed:29390138, PubMed:33619562). Taum(5)U formation on mammalian mt-tRNA requires the presence of both GTPBP3-mediated GTPase activity and MTO1 catalytic activity (PubMed:29390138)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}