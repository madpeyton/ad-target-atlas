A5","gene_id":"ENSG00000145740","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.712079,"nucleus_log2fc":0.0203909,"nucleus_score":0.478322,"pct_ad":0.2039,"pct_control":0.201613,"donor_test":"not significant","donor_padj":0.984872,"donor_log2fc":0.00790593,"donor_lfcse":0.0774306,"donor_log2fc_shrunk":0.00210713,"degas_log2fc":0.0259354,"degas_padj":0.680788},{"cell_type":"OPC","gene_symbol":"SLC30A5","gene_symbol_current":"SLC30A5","gene_id":"ENSG00000145740","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.171092,"nucleus_log2fc":-0.0914465,"nucleus_score":-1.76981,"pct_ad":0.252162,"pct_control":0.265368,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0937028,"donor_lfcse":0.0844245,"donor_log2fc_shrunk":-1.35485e-05,"degas_log2fc":-0.0339417,"degas_padj":0.569441},{"cell_type":"Oli","gene_symbol":"SLC30A5","gene_symbol_current":"SLC30A5","gene_id":"ENSG00000145740","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0356067,"nucleus_log2fc":-0.0590699,"nucleus_score":-2.23275,"pct_ad":0.191744,"pct_control":0.198297,"donor_test":"not significant","donor_padj":0.901039,"donor_log2fc":-0.0448501,"donor_lfcse":0.0605161,"donor_log2fc_shrunk":-0.0111737,"degas_log2fc":-0.119802,"degas_padj":9.02658e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000145740","module":"turquoise","kme":0.0673633,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000145740","module":"turquoise","kme":0.0215697,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000145740","entrez_id":["64924"],"uniprot":["Q8TAD4"],"ncbi_summary":"This gene encodes a member of the SLC30A/ZnT family of zinc transporter proteins. ZnT proteins mediate both cellular zinc efflux and zinc sequestration into membrane-bound organelles. The encoded protein plays a role in the early secretory pathway as a heterodimer with zinc transporter 6, and may also regulate zinc sequestration into secretory granules of pancreatic beta cells. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene, and a pseudogene of this gene is located on the long arm of chromosome 19. [provided by RefSeq, Oct 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TAD4","text":"Together with SLC30A6 forms a functional proton-coupled zinc ion antiporter mediating zinc entry into the lumen of organelles along the secretory pathway (PubMed:11904301, PubMed:15525635, PubMed:15994300, PubMed:19366695, PubMed:22529353). By contributing to zinc ion homeostasis within the early secretory pathway, regulates the activation and folding of enzymes like alkaline phosphatases and enzymes involved in phosphatidylinositol glycan anchor biosynthesis (PubMed:15525635, PubMed:15994300, PubMed:16636052, PubMed:35525268). Through the transport of zinc into secretory granules of pancreatic beta-cells, plays an important role in the storage and secretion of insulin (PubMed:11904301). [Isoform 2]: Zinc ion:proton antiporter mediating influx and efflux of zinc at the plasma membrane."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}