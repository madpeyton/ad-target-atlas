9"],"dataset_symbols":["ADCYAP1R1"],"explorer":"explorer.html?dataset=mathys2019#gene/ADCYAP1R1","cell_types":[{"cell_type":"Ast","gene_symbol":"ADCYAP1R1","gene_symbol_current":"ADCYAP1R1","gene_id":"ENSG00000078549","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.405893,"nucleus_log2fc":0.199592,"nucleus_score":1.08566,"pct_ad":0.177938,"pct_control":0.166558,"donor_test":"not significant","donor_padj":0.674583,"donor_log2fc":0.229365,"donor_lfcse":0.148128,"donor_log2fc_shrunk":0.0230274},{"cell_type":"Ex","gene_symbol":"ADCYAP1R1","gene_symbol_current":"ADCYAP1R1","gene_id":"ENSG00000078549","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.875755,"nucleus_log2fc":0.0321455,"nucleus_score":0.200221,"pct_ad":0.135616,"pct_control":0.135109,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.169681,"donor_lfcse":0.0992906,"donor_log2fc_shrunk":1.11576e-05},{"cell_type":"In","gene_symbol":"ADCYAP1R1","gene_symbol_current":"ADCYAP1R1","gene_id":"ENSG00000078549","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.979889,"nucleus_log2fc":-0.0208258,"nucleus_score":-0.0777597,"pct_ad":0.310559,"pct_control":0.305945,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0496269,"donor_lfcse":0.0958922,"donor_log2fc_shrunk":5.66134e-06}],"modules":[],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000078549","entrez_id":["117"],"uniprot":["P41586"],"ncbi_summary":"This gene encodes type I adenylate cyclase activating polypeptide receptor, which is a membrane-associated protein and shares significant homology with members of the glucagon/secretin receptor family. This receptor mediates diverse biological actions of adenylate cyclase activating polypeptide 1 and is positively coupled to adenylate cyclase. Multiple alternatively spliced transcript variants encoding distinct isoforms have been identified. [provided by RefSeq, Dec 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P41586","text":"G protein-coupled receptor activated by the neuropeptide pituitary adenylate cyclase-activating polypeptide (ADCYAP1/PACAP) (PubMed:32004469, PubMed:32047270, PubMed:33715378, PubMed:35477937, PubMed:36385145). Binds both PACAP27 and PACAP38 bioactive peptides (PubMed:32004469, PubMed:32047270, PubMed:35477937, PubMed:36385145). Ligand binding causes a conformation change that triggers signaling via guanine nucleotide-binding proteins (G proteins) and modulates the activity of downstream effectors. Activates cAMP-dependent pathway (PubMed:32004469, PubMed:32047270, PubMed:33715378, PubMed:35477937, PubMed:36385145). May regulate the release of adrenocorticotropin, luteinizing hormone, growth hormone, prolactin, epinephrine, and catecholamine. May play a role in spermatogenesis and sperm motility. Causes smooth muscle relaxation and secretion in the gastrointestinal tract (PubMed:32047270, PubMed:33715378)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}