wer in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000072210","module":"blue","kme":0.0874114,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000072210","module":"blue","kme":0.116608,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000072210","entrez_id":["224"],"uniprot":["P51648"],"ncbi_summary":"Aldehyde dehydrogenase isozymes are thought to play a major role in the detoxification of aldehydes generated by alcohol metabolism and lipid peroxidation. This gene product catalyzes the oxidation of long-chain aliphatic aldehydes to fatty acid. Mutations in the gene cause Sjogren-Larsson syndrome. Alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P51648","text":"Catalyzes the oxidation of medium and long chain aliphatic aldehydes to fatty acids. Active on a variety of saturated and unsaturated aliphatic aldehydes between 6 and 24 carbons in length (PubMed:18035827, PubMed:18182499, PubMed:22633490, PubMed:25047030, PubMed:9133646, PubMed:9662422). Responsible for conversion of the sphingosine 1-phosphate (S1P) degradation product hexadecenal to hexadecenoic acid (PubMed:22633490)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}