ficant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000151576"],"dataset_symbols":["QTRTD1"],"explorer":"explorer.html?dataset=mathys2019#gene/QTRTD1","cell_types":[{"cell_type":"Ex","gene_symbol":"QTRTD1","gene_symbol_current":"QTRT2","gene_id":"ENSG00000151576","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.28866e-05,"nucleus_log2fc":-0.221159,"nucleus_score":-4.54592,"pct_ad":0.10707,"pct_control":0.127054,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.165342,"donor_lfcse":0.1154,"donor_log2fc_shrunk":-1.29594e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000151576","entrez_id":["79691"],"uniprot":["Q9H974"],"ncbi_summary":"This gene encodes a subunit of tRNA-guanine transglycosylase. tRNA-guanine transglycosylase is a heterodimeric enzyme complex that plays a critical role in tRNA modification by synthesizing the 7-deazaguanosine queuosine, which is found in tRNAs that code for asparagine, aspartic acid, histidine, and tyrosine. The encoded protein may play a role in the queuosine 5'-monophosphate salvage pathway. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene. [provided by RefSeq, Feb 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H974","text":"Non-catalytic subunit of the queuine tRNA-ribosyltransferase (TGT) that catalyzes the base-exchange of a guanine (G) residue with queuine (Q) at position 34 (anticodon wobble position) in tRNAs with GU(N) anticodons (tRNA-Asp, -Asn, -His and -Tyr), resulting in the hypermodified nucleoside queuosine (7-(((4,5-cis-dihydroxy-2-cyclopenten-1-yl)amino)methyl)-7-deazaguanosine)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}