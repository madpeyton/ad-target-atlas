s_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.18995e-24,"nucleus_log2fc":-0.17059,"nucleus_score":-10.4109,"pct_ad":0.411941,"pct_control":0.453692,"donor_test":"not significant","donor_padj":0.704519,"donor_log2fc":-0.120885,"donor_lfcse":0.0758223,"donor_log2fc_shrunk":-0.024714}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000197386","module":"blue","kme":0.22659,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000197386","module":"brown","kme":0.187371,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000197386","module":"blue","kme":0.144163,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000197386","entrez_id":["3064"],"uniprot":["P42858"],"ncbi_summary":"Huntingtin is a disease gene linked to Huntington's disease, a neurodegenerative disorder characterized by loss of striatal neurons. This is thought to be caused by an expanded, unstable trinucleotide repeat in the huntingtin gene, which translates as a polyglutamine repeat in the protein product. A fairly broad range of trinucleotide repeats (9-35) has been identified in normal controls, and repeat numbers in excess of 40 have been described as pathological. The huntingtin locus is large, spanning 180 kb and consisting of 67 exons. The huntingtin gene is widely expressed and is required for normal development. It is expressed as 2 alternatively polyadenylated forms displaying different relative abundance in various fetal and adult tissues. The larger transcript is approximately 13.7 kb and is expressed predominantly in adult and fetal brain whereas the smaller transcript of approximately 10.3 kb is more widely expressed. The genetic defect leading to Huntington's disease may not necessarily eliminate transcription, but may confer a new property on the mRNA or alter the function of the protein. One candidate is the huntingtin-associated protein-1, highly expressed in brain, which has increased affinity for huntingtin protein with expanded polyglutamine repeats. This gene contains an upstream open reading frame in the 5' UTR that inhibits expression of the huntingtin gene product through translational repression. [provided by RefSeq, Jul 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P42858","text":"[Huntingtin]: May play a role in microtubule-mediated transport or vesicle function. [Huntingtin, myristoylated N-terminal fragment]: Promotes the formation of autophagic vesicles."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}