e},{"cell_type":"OPC","gene_id":"ENSG00000198276","module":"turquoise","kme":0.167244,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000198276","module":"turquoise","kme":0.137346,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198276","entrez_id":["54963"],"uniprot":["Q9NWZ5"],"ncbi_summary":"The protein encoded by this gene is a uridine kinase. Uridine kinases catalyze the phosphorylation of uridine to uridine monophosphate. This protein has been shown to bind to Epstein-Barr nuclear antigen 3 as well as natural killer lytic-associated molecule. Ubiquitination of this protein is enhanced by the presence of natural killer lytic-associated molecule. In addition, protein levels decrease in the presence of natural killer lytic-associated molecule, suggesting that association with natural killer lytic-associated molecule results in ubiquitination and subsequent degradation of this protein. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Nov 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NWZ5","text":"Phosphorylates uridine and cytidine to uridine monophosphate and cytidine monophosphate."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}