6,"pct_control":0.277311,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0408396,"donor_lfcse":0.104927,"donor_log2fc_shrunk":3.89368e-06},{"cell_type":"Mic","gene_symbol":"MAX","gene_symbol_current":"MAX","gene_id":"ENSG00000125952","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.54112,"nucleus_log2fc":-0.317297,"nucleus_score":-1.20196,"pct_ad":0.0885609,"pct_control":0.106117,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"MAX","gene_symbol_current":"MAX","gene_id":"ENSG00000125952","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.011083,"nucleus_log2fc":-0.536085,"nucleus_score":-3.71737,"pct_ad":0.102826,"pct_control":0.154023,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"MAX","gene_symbol_current":"MAX","gene_id":"ENSG00000125952","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.875193,"donor_log2fc":-0.0908691,"donor_lfcse":0.108084,"donor_log2fc_shrunk":-0.00717017}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000125952","module":"black","kme":0.209922,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000125952","entrez_id":["4149"],"uniprot":["P61244"],"ncbi_summary":"The protein encoded by this gene is a member of the basic helix-loop-helix leucine zipper (bHLHZ) family of transcription factors. It is able to form homodimers and heterodimers with other family members, which include Mad, Mxi1 and Myc. Myc is an oncoprotein implicated in cell proliferation, differentiation and apoptosis. The homodimers and heterodimers compete for a common DNA target site (the E box) and rearrangement among these dimer forms provides a complex system of transcriptional regulation. Mutations of this gene have been reported to be associated with hereditary pheochromocytoma. A pseudogene of this gene is located on the long arm of chromosome 7. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P61244","text":"Transcription regulator. Forms a sequence-specific DNA-binding protein complex with MYC or MAD which recognizes the core sequence 5'-CAC[GA]TG-3'. The MYC:MAX complex is a transcriptional activator, whereas the MAD:MAX complex is a repressor. May repress transcription via the recruitment of a chromatin remodeling complex containing H3 'Lys-9' histone methyltransferase activity. Represses MYC transcriptional activity from E-box elements."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}