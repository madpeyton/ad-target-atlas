donor_log2fc":-0.0792822,"donor_lfcse":0.0814552,"donor_log2fc_shrunk":-1.23766e-05,"degas_log2fc":-0.394599,"degas_padj":1.90226e-36},{"cell_type":"Oli","gene_symbol":"ANKH","gene_symbol_current":"ANKH","gene_id":"ENSG00000154122","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":5.44966e-40,"nucleus_log2fc":0.186356,"nucleus_score":13.3969,"pct_ad":0.677865,"pct_control":0.654996,"donor_test":"not significant","donor_padj":0.867386,"donor_log2fc":0.116252,"donor_lfcse":0.125596,"donor_log2fc_shrunk":0.00882509,"degas_log2fc":-0.186538,"degas_padj":4.5778e-40}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000154122","module":"yellow","kme":0.175389,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000154122","module":"green","kme":0.26877,"hub":false,"module_direction":"higher in AD","module_padj":0.232138,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000154122","module":"black","kme":0.356053,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000154122","module":"turquoise","kme":0.0527584,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000154122","module":"brown","kme":0.199823,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000154122","module":"blue","kme":0.246472,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000154122","entrez_id":["56172"],"uniprot":["Q9HCJ1"],"ncbi_summary":"This gene encodes a multipass transmembrane protein that is expressed in joints and other tissues and controls pyrophosphate levels in cultured cells. Progressive ankylosis-mediated control of pyrophosphate levels has been suggested as a possible mechanism regulating tissue calcification and susceptibility to arthritis in higher animals. Mutations in this gene have been associated with autosomal dominant craniometaphyseal dysplasia. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9HCJ1","text":"Transports adenosine triphosphate (ATP) and possibly other nucleoside triphosphates (NTPs) from cytosol to the extracellular space. Mainly regulates their levels locally in peripheral tissues while playing a minor systemic role. Prevents abnormal ectopic mineralization of the joints by regulating the extracellular levels of the calcification inhibitor inorganic pyrophosphate (PPi), which originates from the conversion of extracellular NTPs to NMPs and PPis by ENPP1 (PubMed:20943778, PubMed:32639996, PubMed:35147247). Regulates the release of the TCA cycle intermediates to the extracellular space, in particular citrate, succinate and malate. Extracellular citrate mostly present in bone tissue is required for osteogenic differentiation of mesenchymal stem cells, stabilization of hydroxyapatite structure and overall bone strength (PubMed:32639996). The transport mechanism remains to be elucidated (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}