,"module_padj":0.979936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000115461"],"dataset_symbols":["IGFBP5"],"explorer":"explorer.html?dataset=mathys2019#gene/IGFBP5","cell_types":[{"cell_type":"Ex","gene_symbol":"IGFBP5","gene_symbol_current":"IGFBP5","gene_id":"ENSG00000115461","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0637757,"nucleus_log2fc":0.132232,"nucleus_score":2.06672,"pct_ad":0.219931,"pct_control":0.211437,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.340792,"donor_lfcse":0.183225,"donor_log2fc_shrunk":1.05084e-05},{"cell_type":"In","gene_symbol":"IGFBP5","gene_symbol_current":"IGFBP5","gene_id":"ENSG00000115461","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.144501,"nucleus_log2fc":0.384641,"nucleus_score":2.57735,"pct_ad":0.119343,"pct_control":0.0980392,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.866512,"donor_lfcse":0.363719,"donor_log2fc_shrunk":6.58962e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000115461","module":"pink","kme":0.350245,"hub":false,"module_direction":"higher in AD","module_padj":1.0,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000115461","module":"blue","kme":0.318944,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000115461","module":"brown","kme":0.131711,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000115461","entrez_id":["3488"],"uniprot":["P24593"],"ncbi_summary":"Enables insulin-like growth factor I binding activity. Involved in several processes, including cellular response to cAMP; regulation of smooth muscle cell migration; and regulation of smooth muscle cell proliferation. Part of insulin-like growth factor ternary complex. Biomarker of pulmonary fibrosis. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P24593","text":"Multifunctional protein that plays a critical role in regulating the availability of IGFs to their receptors and thereby regulates IGF-mediated cellular processes including proliferation, differentiation, and apoptosis in a cell-type specific manner (PubMed:18930415, PubMed:7683690). Increases the cell proliferation of osteoblasts, intestinal smooth muscle cells and neuroblastoma cells. Enhances adhesion and survival of epithelial cells but decreases adhesion of mesenchymal cells (By similarity). Once secreted, acts as a major mediator of mTORC1-dependent feedback inhibition of IGF1 signaling (By similarity). Also plays a role in the induction of extracellular matrix (ECM) production and deposition independently of its nuclear translocation and binding to IGFs (PubMed:20345844, PubMed:26103640). Acts itself as a growth factor that can act independently of IGFs to regulate bone formation. Acts as a ligand for the ROR1 receptor which triggers formation of ROR1/HER2 heterodimer to enhance CREB oncogenic signaling (PubMed:36949068)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}