":"blue","kme":0.268234,"hub":true,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000123636","module":"blue","kme":0.211781,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000123636","module":"blue","kme":0.181339,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000123636","module":"brown","kme":0.195974,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000123636","module":"blue","kme":0.193334,"hub":false,"module_direction":"lower in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000123636","entrez_id":["29994"],"uniprot":["Q9UIF8"],"ncbi_summary":"This gene belongs to the bromodomain gene family. Members of this gene family encode proteins that are integral components of chromatin remodeling complexes. The encoded protein showed strong preference for the activating H3K14Ac mark in a histone peptide screen, suggesting a potential role in transcriptional activation. This gene may be associated with susceptibility to sudden cardiac death (SCD). [provided by RefSeq, Aug 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UIF8","text":"Regulatory subunit of the ATP-dependent BRF-1 and BRF-5 ISWI chromatin remodeling complexes, which form ordered nucleosome arrays on chromatin and facilitate access to DNA during DNA-templated processes such as DNA replication, transcription, and repair (PubMed:28801535). Both complexes regulate the spacing of nucleosomes along the chromatin and have the ability to slide mononucleosomes to the center of a DNA template (PubMed:28801535). The BRF-1 ISWI chromatin remodeling complex has a lower ATP hydrolysis rate than the BRF-5 ISWI chromatin remodeling complex (PubMed:28801535). Chromatin reader protein, which may play a role in transcriptional regulation via interaction with ISWI (By similarity) (PubMed:10662543). Involved in positively modulating the rate of age-related behavioral deterioration (By similarity). Represses the expression of mitochondrial function-related genes, perhaps by occupying their promoter regions, working in concert with histone methyltransferase EHMT1 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}