not significant","donor_padj":0.966681,"donor_log2fc":-0.0390702,"donor_lfcse":0.252335,"donor_log2fc_shrunk":-0.0006235},{"cell_type":"In","gene_symbol":"KRT17","gene_symbol_current":"KRT17","gene_id":"ENSG00000128422","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.94052,"donor_log2fc":-0.0604573,"donor_lfcse":0.195074,"donor_log2fc_shrunk":-0.000770802}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000128422","entrez_id":["3872"],"uniprot":["Q04695"],"ncbi_summary":"This gene encodes the type I intermediate filament chain keratin 17, expressed in nail bed, hair follicle, sebaceous glands, and other epidermal appendages. Mutations in this gene lead to Jackson-Lawler type pachyonychia congenita and steatocystoma multiplex. [provided by RefSeq, Aug 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q04695","text":"Structural component of intermediate filaments in epithelial keratinocytes. Forms heteropolymers with type II keratins KRT6A and KRT6B, assembling into keratin filament networks that contribute to the structural integrity and specialized differentiation of various epithelial appendages, including nail and hair follicle (PubMed:10844551, PubMed:11886499, PubMed:16620218, PubMed:17719747, PubMed:7539673). Required for the correct growth of hair follicles, in particular for the persistence of the anagen (growth) state (By similarity). Modulates the function of TNF in the specific context of hair cycling (By similarity). Regulates protein synthesis and epithelial cell growth through binding to the adapter protein SFN and by stimulating Akt/mTOR pathway (By similarity). Involved in tissue repair (By similarity). Promotes epithelial proliferation by acting a regulator of immune response in skin: promotes Th1/Th17-dominated immune environment contributing to the development of basaloid skin tumors (By similarity). May act as an autoantigen in the immunopathogenesis of psoriasis, with certain peptide regions being a major target for autoreactive T-cells and hence causing their proliferation (PubMed:15795121, PubMed:16713453)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}