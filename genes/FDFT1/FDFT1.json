_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.496392,"nucleus_log2fc":-0.193349,"nucleus_score":-1.28673,"pct_ad":0.128728,"pct_control":0.147893,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"FDFT1","gene_symbol_current":"FDFT1","gene_id":"ENSG00000079459","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.254434,"nucleus_log2fc":0.0601752,"nucleus_score":1.39929,"pct_ad":0.202342,"pct_control":0.192442,"donor_test":"not significant","donor_padj":0.944582,"donor_log2fc":-0.0507173,"donor_lfcse":0.111086,"donor_log2fc_shrunk":-0.00347474}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000079459","module":"turquoise","kme":0.249462,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000079459","module":"yellow","kme":0.13802,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000079459","entrez_id":["2222"],"uniprot":["P37268"],"ncbi_summary":"This gene encodes a membrane-associated enzyme located at a branch point in the mevalonate pathway. The encoded protein is the first specific enzyme in cholesterol biosynthesis, catalyzing the dimerization of two molecules of farnesyl diphosphate in a two-step reaction to form squalene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P37268","text":"Catalyzes the condensation of 2 farnesyl pyrophosphate (FPP) moieties to form squalene. Proceeds in two distinct steps. In the first half-reaction, two molecules of FPP react to form the stable presqualene diphosphate intermediate (PSQPP), with concomitant release of a proton and a molecule of inorganic diphosphate. In the second half-reaction, PSQPP undergoes heterolysis, isomerization, and reduction with NADPH or NADH to form squalene. It is the first committed enzyme of the sterol biosynthesis pathway."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}