"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000120868"],"dataset_symbols":["APAF1"],"explorer":"explorer.html?dataset=mathys2019#gene/APAF1","cell_types":[{"cell_type":"Ex","gene_symbol":"APAF1","gene_symbol_current":"APAF1","gene_id":"ENSG00000120868","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.909783,"nucleus_log2fc":0.0282274,"nucleus_score":-0.146762,"pct_ad":0.104531,"pct_control":0.105439,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0933495,"donor_lfcse":0.0952802,"donor_log2fc_shrunk":1.06414e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000120868","entrez_id":["317"],"uniprot":["O14727"],"ncbi_summary":"This gene encodes a cytoplasmic protein that initiates apoptosis. This protein contains several copies of the WD-40 domain, a caspase recruitment domain (CARD), and an ATPase domain (NB-ARC). Upon binding cytochrome c and dATP, this protein forms an oligomeric apoptosome. The apoptosome binds and cleaves caspase 9 preproprotein, releasing its mature, activated form. Activated caspase 9 stimulates the subsequent caspase cascade that commits the cell to apoptosis. Alternative splicing results in several transcript variants encoding different isoforms. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O14727","text":"Oligomeric Apaf-1 mediates the cytochrome c-dependent autocatalytic activation of pro-caspase-9 (Apaf-3), leading to the activation of caspase-3 and apoptosis. This activation requires ATP. Isoform 6 is less effective in inducing apoptosis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}