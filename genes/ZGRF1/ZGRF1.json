nucleus_score":-3.13675,"pct_ad":0.176377,"pct_control":0.185371,"donor_test":"not significant","donor_padj":0.938293,"donor_log2fc":-0.0529811,"donor_lfcse":0.106006,"donor_log2fc_shrunk":-0.00432934,"degas_log2fc":-0.184602,"degas_padj":5.20155e-11}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000138658","module":"magenta","kme":0.324966,"hub":false,"module_direction":"higher in AD","module_padj":0.939268,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000138658","entrez_id":["55345"],"uniprot":["Q86YA3"],"ncbi_summary":"The encoded protein contains GRF zinc finger (zf-GRF) and transmembrane domains. GRF zinc fingers are found in a number of DNA-binding proteins. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Apr 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86YA3","text":"5'-3' DNA helicase which is recruited to sites of DNA damage and promotes repair of replication-blocking DNA lesions through stimulation of homologous recombination (HR) (PubMed:32640219, PubMed:34552057). Promotes HR by directly stimulating RAD51-mediated strand exchange activity (PubMed:32640219). Not required to load RAD51 at sites of DNA damage but promotes recombinational repair after RAD51 recruitment (PubMed:32640219). Also promotes HR by positively regulating EXO1-mediated DNA end resection of double-strand breaks (PubMed:34552057). Required for recruitment of replication protein RPA2 to DNA damage sites (PubMed:34552057). Promotes the initiation of the G2/M checkpoint but not its maintenance (PubMed:34552057). Catalyzes Holliday junction branch migration and dissociation of D-loops and DNA flaps (PubMed:32640219)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}