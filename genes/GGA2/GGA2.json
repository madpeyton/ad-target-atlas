ificant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.852209,"nucleus_log2fc":0.0893466,"nucleus_score":0.459113,"pct_ad":0.109471,"pct_control":0.102372,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"GGA2","gene_symbol_current":"GGA2","gene_id":"ENSG00000103365","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.756357,"nucleus_log2fc":0.105133,"nucleus_score":0.674543,"pct_ad":0.131083,"pct_control":0.122605,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"GGA2","gene_symbol_current":"GGA2","gene_id":"ENSG00000103365","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.732555,"donor_log2fc":-0.305956,"donor_lfcse":0.150212,"donor_log2fc_shrunk":-0.0140904}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000103365","module":"magenta","kme":0.156367,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000103365","entrez_id":["23062"],"uniprot":["Q9UJY4"],"ncbi_summary":"This gene encodes a member of the Golgi-localized, gamma adaptin ear-containing, ARF-binding (GGA) family. This family includes ubiquitous coat proteins that regulate the trafficking of proteins between the trans-Golgi network and the lysosome. These proteins share an amino-terminal VHS domain which mediates sorting of the mannose 6-phosphate receptors at the trans-Golgi network. They also contain a carboxy-terminal region with homology to the ear domain of gamma-adaptins. This family member may play a significant role in cargo molecules regulation and clathrin-coated vesicle assembly. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UJY4","text":"Plays a role in protein sorting and trafficking between the trans-Golgi network (TGN) and endosomes. Mediates the ARF-dependent recruitment of clathrin to the TGN and binds ubiquitinated proteins and membrane cargo molecules with a cytosolic acidic cluster-dileucine (DXXLL) motif (PubMed:10747088). Mediates export of the GPCR receptor ADRA2B to the cell surface (PubMed:27901063). Regulates retrograde transport of phosphorylated form of BACE1 from endosomes to the trans-Golgi network (PubMed:15615712)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}