se":0.138916,"donor_log2fc_shrunk":3.73152e-07},{"cell_type":"Oli","gene_symbol":"TMEM216","gene_symbol_current":"TMEM216","gene_id":"ENSG00000187049","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.946847,"donor_log2fc":0.0714051,"donor_lfcse":0.16213,"donor_log2fc_shrunk":0.00267215}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000187049","module":"turquoise","kme":0.048981,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000187049","entrez_id":["51259"],"uniprot":["Q9P0N5"],"ncbi_summary":"This locus encodes a transmembrane domain-containing protein. Mutations at this locus have been associated with Meckel-Gruber Syndrome Type 2, and Joubert Syndrome 2, also known as Cerebello-oculorenal Syndrome 2. [provided by RefSeq, Aug 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9P0N5","text":"Essential for primary ciliogenesis and embryonic development, facilitating the activation of Hedgehog (Hh) signaling pathway. Disrupts the interaction of GLI2 and GLI3 with the negative regulator SUFU. Inhibiting SUFU's interaction with GLI2 promotes the entry of GLI2 into the nucleus, allowing it to activate Hh target gene expression. Disrupting SUFU's interaction with GLI3 prevents its conversion into the repressor form, leading to increased nuclear GLI3 and enhanced Hh signaling. Required for the proper development and structural integrity of photoreceptor outer segment disks, ensuring normal outer segment morphogenesis and survival of photoreceptors."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}