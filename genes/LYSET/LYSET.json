"ENSG00000153485","module":"turquoise","kme":0.225566,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000153485","module":"turquoise","kme":0.125708,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000153485","module":"turquoise","kme":0.145222,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000153485","entrez_id":["26175"],"uniprot":["Q8N6I4"],"ncbi_summary":"Predicted to be integral component of membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8N6I4","text":"Required for mannose-6-phosphate-dependent trafficking of lysosomal enzymes (PubMed:36074821, PubMed:36074822, PubMed:36096887). LYSET bridges GlcNAc-1-phosphate transferase (GNPTAB), to the membrane-bound transcription factor site-1 protease (MBTPS1), thus allowing proteolytic activation of the GNPTAB. GNPTAB is involved in the regulation of M6P-dependent Golgi-to-lysosome trafficking of lysosomal enzymes (PubMed:36074821, PubMed:36074822, PubMed:36096887). LYSET is thus an essential factor for maturation and delivery of lysosomal hydrolases (PubMed:36074822). (Microbial infection) Essential for infection by muliple viruses, including SARS-CoV-2, that utilize activated cathepsins for entry after M6P-dependent lysosomal transport."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}