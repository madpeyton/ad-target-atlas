r_test":"not significant","donor_padj":0.973523,"donor_log2fc":-0.0173258,"donor_lfcse":0.0780478,"donor_log2fc_shrunk":-0.00260592,"degas_log2fc":-0.194905,"degas_padj":1.57292e-17}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000164715","module":"blue","kme":0.045606,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000164715","module":"turquoise","kme":0.0954583,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164715","entrez_id":["22853"],"uniprot":["Q8IWU2"],"ncbi_summary":"The protein encoded by this gene belongs to the protein kinase superfamily and the protein tyrosine kinase family. It contains N-terminal transmembrane helices and a long C-terminal cytoplasmic tail with serine/threonine/tyrosine kinase activity. This protein interacts with several other proteins, such as Inhibitor-2 (Inh2), protein phosphatase-1 (PP1C), p35, and myosin VI. It phosporylates other proteins, and is itself also phosporylated when interacting with cyclin-dependent kinase 5 (cdk5)/p35 complex. This protein involves in nerve growth factor (NGF)-TrkA signalling, and also plays a critical role in endosomal membrane trafficking. Mouse studies suggested an essential role of this protein in spermatogenesis. [provided by RefSeq, Oct 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IWU2","text":"Phosphorylates PPP1C, phosphorylase b and CFTR."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}