urce":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P12109","text":"Collagen VI acts as a cell-binding protein."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}