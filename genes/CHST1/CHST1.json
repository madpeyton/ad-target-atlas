r_padj":0.985617,"donor_log2fc":0.0938626,"donor_lfcse":0.0939256,"donor_log2fc_shrunk":1.10094e-05},{"cell_type":"In","gene_symbol":"CHST1","gene_symbol_current":"CHST1","gene_id":"ENSG00000175264","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0213893,"nucleus_log2fc":0.530554,"nucleus_score":3.47734,"pct_ad":0.112245,"pct_control":0.0849673,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.548134,"donor_lfcse":0.195433,"donor_log2fc_shrunk":1.42444e-05}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000175264","module":"pink","kme":0.330824,"hub":false,"module_direction":"higher in AD","module_padj":1.0,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000175264","module":"blue","kme":0.217856,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000175264","entrez_id":["8534"],"uniprot":["O43916"],"ncbi_summary":"This locus encodes a member of the keratin sulfotransferase family of proteins. The encoded enzyme catalyzes the sulfation of the proteoglycan keratin. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43916","text":"Sulfotransferase that utilizes 3'-phospho-5'-adenylyl sulfate (PAPS) as sulfonate donor to catalyze the transfer of sulfate to position 6 of internal galactose (Gal) residues of keratan. Cooperates with B4GALT4 and B3GNT7 glycosyltransferases and CHST6 sulfotransferase to construct and elongate disulfated disaccharide unit [->3(6-sulfoGalbeta)1->4(6-sulfoGlcNAcbeta)1->] within keratan sulfate polymer (PubMed:10642612, PubMed:17690104, PubMed:9405439). Has a preference for sulfating keratan sulfate, but it also transfers sulfate to the unsulfated polymer (PubMed:9405439). Involved in biosynthesis of phosphacan, a major keratan sulfate proteoglycan in the developing brain (By similarity). Involved in biosynthesis of 6-sulfoGalbeta-containing O-linked glycans in high endothelial venules of lymph nodes. May act in a synergistic manner with CHST4 to generate sialyl 6',6-disulfo Lewis X motif, a recognition determinant for immune cell receptors implicated in leukocyte trafficking (PubMed:10330415). Catalyzes sulfation of N-acetyllactosamine (LacNAc) oligosaccharides with highest efficiency for sialylated LacNAc structures (PubMed:10642612)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}