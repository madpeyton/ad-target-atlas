ll}],"modules":[{"cell_type":"CUX2-","gene_id":"ENSG00000084073","module":"turquoise","kme":0.146744,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000084073"],"dataset_symbols":["ZMPSTE24"],"explorer":"explorer.html?dataset=mathys2019#gene/ZMPSTE24","cell_types":[{"cell_type":"Ex","gene_symbol":"ZMPSTE24","gene_symbol_current":"ZMPSTE24","gene_id":"ENSG00000084073","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.309751,"nucleus_log2fc":0.103215,"nucleus_score":1.17256,"pct_ad":0.181837,"pct_control":0.176902,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.123728,"donor_lfcse":0.0681076,"donor_log2fc_shrunk":2.1996e-05},{"cell_type":"Oli","gene_symbol":"ZMPSTE24","gene_symbol_current":"ZMPSTE24","gene_id":"ENSG00000084073","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.710602,"donor_log2fc":0.329479,"donor_lfcse":0.140159,"donor_log2fc_shrunk":0.0184819}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000084073","entrez_id":["10269"],"uniprot":["O75844"],"ncbi_summary":"This gene encodes a member of the peptidase M48A family. The encoded protein is a zinc metalloproteinase involved in the two step post-translational proteolytic cleavage of carboxy terminal residues of farnesylated prelamin A to form mature lamin A. Mutations in this gene have been associated with mandibuloacral dysplasia and restrictive dermopathy. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75844","text":"Transmembrane metalloprotease whose catalytic activity is critical for processing lamin A/LMNA on the inner nuclear membrane and clearing clogged translocons on the endoplasmic reticulum (PubMed:33293369, PubMed:33315887). Proteolytically removes the C-terminal three residues of farnesylated proteins (PubMed:33293369, PubMed:33315887). Also plays an antiviral role independently of its protease activity by restricting enveloped RNA and DNA viruses, including influenza A, Zika, Ebola, Sindbis, vesicular stomatitis, cowpox, and vaccinia (PubMed:28169297, PubMed:28246125). Mechanistically, controls IFITM antiviral pathway to hinder viruses from breaching the endosomal barrier by modulating membrane fluidity (PubMed:35283811)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}