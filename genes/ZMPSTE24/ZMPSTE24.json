ucleus_score":5.19813,"pct_ad":0.140905,"pct_control":0.127459,"donor_test":"not significant","donor_padj":0.695921,"donor_log2fc":0.144494,"donor_lfcse":0.0891549,"donor_log2fc_shrunk":0.0198825}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000084073","module":"blue","kme":0.103198,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000084073","entrez_id":["10269"],"uniprot":["O75844"],"ncbi_summary":"This gene encodes a member of the peptidase M48A family. The encoded protein is a zinc metalloproteinase involved in the two step post-translational proteolytic cleavage of carboxy terminal residues of farnesylated prelamin A to form mature lamin A. Mutations in this gene have been associated with mandibuloacral dysplasia and restrictive dermopathy. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75844","text":"Transmembrane metalloprotease whose catalytic activity is critical for processing lamin A/LMNA on the inner nuclear membrane and clearing clogged translocons on the endoplasmic reticulum (PubMed:33293369, PubMed:33315887). Proteolytically removes the C-terminal three residues of farnesylated proteins (PubMed:33293369, PubMed:33315887). Also plays an antiviral role independently of its protease activity by restricting enveloped RNA and DNA viruses, including influenza A, Zika, Ebola, Sindbis, vesicular stomatitis, cowpox, and vaccinia (PubMed:28169297, PubMed:28246125). Mechanistically, controls IFITM antiviral pathway to hinder viruses from breaching the endosomal barrier by modulating membrane fluidity (PubMed:35283811)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}