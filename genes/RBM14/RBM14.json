ucleus_score":3.05633,"pct_ad":0.512702,"pct_control":0.497578,"donor_test":"not significant","donor_padj":0.997384,"donor_log2fc":0.000626308,"donor_lfcse":0.0604459,"donor_log2fc_shrunk":-0.000666523},{"cell_type":"Inhibitory","gene_symbol":"RBM14","gene_symbol_current":"RBM14","gene_id":"ENSG00000239306","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":4.27955e-06,"nucleus_log2fc":0.0635615,"nucleus_score":4.94877,"pct_ad":0.357485,"pct_control":0.338598,"donor_test":"not significant","donor_padj":0.818802,"donor_log2fc":0.0401377,"donor_lfcse":0.0641352,"donor_log2fc_shrunk":0.00652152},{"cell_type":"Microglia","gene_symbol":"RBM14","gene_symbol_current":"RBM14","gene_id":"ENSG00000239306","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0313339,"nucleus_log2fc":0.0627125,"nucleus_score":2.30616,"pct_ad":0.183817,"pct_control":0.171545,"donor_test":"not significant","donor_padj":0.992876,"donor_log2fc":-0.00202184,"donor_lfcse":0.0573913,"donor_log2fc_shrunk":-0.000681267},{"cell_type":"Oligodendroglia","gene_symbol":"RBM14","gene_symbol_current":"RBM14","gene_id":"ENSG00000239306","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":4.46717e-12,"nucleus_log2fc":0.095206,"nucleus_score":7.03689,"pct_ad":0.165983,"pct_control":0.151077,"donor_test":"not significant","donor_padj":0.85434,"donor_log2fc":-0.0157602,"donor_lfcse":0.0442886,"donor_log2fc_shrunk":-0.00748716},{"cell_type":"Vascular.niche","gene_symbol":"RBM14","gene_symbol_current":"RBM14","gene_id":"ENSG00000239306","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.375477,"nucleus_log2fc":0.0774208,"nucleus_score":1.41013,"pct_ad":0.184439,"pct_control":0.170028,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000239306","entrez_id":["10432"],"uniprot":["Q96PK6"],"ncbi_summary":"This gene encodes a ribonucleoprotein that functions as a general nuclear coactivator, and an RNA splicing modulator. This protein contains two RNA recognition motifs (RRM) at the N-terminus, and multiple hexapeptide repeat domain at the C-terminus that interacts with thyroid hormone receptor-binding protein (TRBP), and is required for transcription activation. Alternatively spliced transcript variants encoding different isoforms (with opposing effects on transcription) have been described for this gene. [provided by RefSeq, Oct 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96PK6","text":"Isoform 1 may function as a nuclear receptor coactivator, enhancing transcription through other coactivators such as NCOA6 and CITED1. Isoform 2, functions as a transcriptional repressor, modulating transcriptional activities of coactivators including isoform 1, NCOA6 and CITED1 (PubMed:11443112). Regulates centriole biogenesis by suppressing the formation of aberrant centriolar protein complexes in the cytoplasm and thus preserving mitotic spindle integrity. Prevents the formation of the STIL-CPAP complex (which can induce the formation of aberrant centriolar protein complexes) by interfering with the interaction of STIL with CPAP (PubMed:25385835). Plays a role in the regulation of DNA virus-mediated innate immune response by assembling into the HDP-RNP complex, a complex that serves as a platform for IRF3 phosphorylation and subsequent innate immune response activation through the cGAS-STING pathway (PubMed:28712728). Also involved in the regulation of pre-mRNA alternative splicing (PubMed:37548402)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}