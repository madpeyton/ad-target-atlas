:0.0833457,"degas_padj":0.358792},{"cell_type":"Oli","gene_symbol":"CLK3","gene_symbol_current":"CLK3","gene_id":"ENSG00000179335","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.812424,"nucleus_log2fc":0.0162452,"nucleus_score":0.277095,"pct_ad":0.111268,"pct_control":0.110599,"donor_test":"not significant","donor_padj":0.919976,"donor_log2fc":0.046411,"donor_lfcse":0.0713857,"donor_log2fc_shrunk":0.00806377,"degas_log2fc":-0.0808205,"degas_padj":0.0250274}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000179335","entrez_id":["1198"],"uniprot":["P49761"],"ncbi_summary":"This gene encodes a protein belonging to the serine/threonine type protein kinase family. This protein is a nuclear dual-specificity kinase that regulates the intranuclear distribution of the serine/arginine-rich (SR) family of splicing factors. Two transcript variants encoding different isoforms have been found for this gene. Related pseudogenes are located on chromosomes 1 and 9. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49761","text":"Dual specificity kinase acting on both serine/threonine and tyrosine-containing substrates. Phosphorylates serine- and arginine-rich (SR) proteins of the spliceosomal complex. May be a constituent of a network of regulatory mechanisms that enable SR proteins to control RNA splicing and can cause redistribution of SR proteins from speckles to a diffuse nucleoplasmic distribution. Phosphorylates SRSF1 and SRSF3. Regulates the alternative splicing of tissue factor (F3) pre-mRNA in endothelial cells."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}