":"lower in AD","nucleus_padj":6.77179e-37,"nucleus_log2fc":-0.235007,"nucleus_score":-12.8509,"pct_ad":0.360034,"pct_control":0.408087,"donor_test":"not significant","donor_padj":0.808361,"donor_log2fc":-0.17908,"donor_lfcse":0.14955,"donor_log2fc_shrunk":-0.00883399,"degas_log2fc":-0.303058,"degas_padj":1.07644e-55}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000140937","module":"turquoise","kme":0.114465,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000140937","module":"blue","kme":0.234598,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000140937","module":"yellow","kme":0.19331,"hub":false,"module_direction":"lower in AD","module_padj":0.0240838,"module_significant":true}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000140937","entrez_id":["1009"],"uniprot":["P55287"],"ncbi_summary":"This gene encodes a type II classical cadherin from the cadherin superfamily, integral membrane proteins that mediate calcium-dependent cell-cell adhesion. Mature cadherin proteins are composed of a large N-terminal extracellular domain, a single membrane-spanning domain, and a small, highly conserved C-terminal cytoplasmic domain. Type II (atypical) cadherins are defined based on their lack of a HAV cell adhesion recognition sequence specific to type I cadherins. Expression of this particular cadherin in osteoblastic cell lines, and its upregulation during differentiation, suggests a specific function in bone development and maintenance. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P55287","text":"Cadherins are calcium-dependent cell adhesion proteins. They preferentially interact with themselves in a homophilic manner in connecting cells; cadherins may thus contribute to the sorting of heterogeneous cell types. Required for proper focal adhesion assembly (PubMed:33811546). Involved in the regulation of cell migration (PubMed:33811546)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}