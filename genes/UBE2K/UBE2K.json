nk":0.00295014,"degas_log2fc":-0.127387,"degas_padj":2.33707e-119},{"cell_type":"Mic","gene_symbol":"UBE2K","gene_symbol_current":"UBE2K","gene_id":"ENSG00000078140","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0962626,"nucleus_log2fc":-0.0467745,"nucleus_score":-1.91316,"pct_ad":0.729434,"pct_control":0.736751,"donor_test":"not significant","donor_padj":0.909337,"donor_log2fc":-0.0317688,"donor_lfcse":0.0608756,"donor_log2fc_shrunk":-0.0118298,"degas_log2fc":0.0672531,"degas_padj":0.0111621},{"cell_type":"OPC","gene_symbol":"UBE2K","gene_symbol_current":"UBE2K","gene_id":"ENSG00000078140","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00239193,"nucleus_log2fc":-0.110812,"nucleus_score":-3.54122,"pct_ad":0.664181,"pct_control":0.679763,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0784784,"donor_lfcse":0.0682067,"donor_log2fc_shrunk":-1.7501e-05,"degas_log2fc":-0.305269,"degas_padj":1.09917e-23},{"cell_type":"Oli","gene_symbol":"UBE2K","gene_symbol_current":"UBE2K","gene_id":"ENSG00000078140","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0012598,"nucleus_log2fc":-0.0500773,"nucleus_score":-3.36791,"pct_ad":0.555071,"pct_control":0.573199,"donor_test":"not significant","donor_padj":0.949076,"donor_log2fc":-0.0333109,"donor_lfcse":0.0798384,"donor_log2fc_shrunk":-0.00494727,"degas_log2fc":-0.216043,"degas_padj":1.00038e-45}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000078140","module":"blue","kme":0.177433,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000078140","entrez_id":["3093"],"uniprot":["P61086"],"ncbi_summary":"The protein encoded by this gene belongs to the ubiquitin-conjugating enzyme family. This protein interacts with RING finger proteins, and it can ubiquitinate huntingtin, the gene product for Huntington's disease. Known functions for this protein include a role in aggregate formation of expanded polyglutamine proteins and the suppression of apoptosis in polyglutamine diseases, a role in the dislocation of newly synthesized MHC class I heavy chains from the endoplasmic reticulum, and involvement in foam cell formation. Multiple transcript variants encoding different isoforms have been identified for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P61086","text":"Accepts ubiquitin from the E1 complex and catalyzes its covalent attachment to other proteins. In vitro, in the presence or in the absence of BRCA1-BARD1 E3 ubiquitin-protein ligase complex, catalyzes the synthesis of 'Lys-48'-linked polyubiquitin chains. Does not transfer ubiquitin directly to but elongates monoubiquitinated substrate protein. Mediates the selective degradation of short-lived and abnormal proteins, such as the endoplasmic reticulum-associated degradation (ERAD) of misfolded lumenal proteins. Ubiquitinates huntingtin. May mediate foam cell formation by the suppression of apoptosis of lipid-bearing macrophages through ubiquitination and subsequence degradation of p53/TP53. Proposed to be involved in ubiquitination and proteolytic processing of NF-kappa-B; in vitro supports ubiquitination of NFKB1. In case of infection by cytomegaloviruses may be involved in the US11-dependent degradation of MHC class I heavy chains following their export from the ER to the cytosol. In case of viral infections may be involved in the HPV E7 protein-dependent degradation of RB1."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}