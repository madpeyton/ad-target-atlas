ucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.750561,"nucleus_log2fc":-0.143815,"nucleus_score":-0.728445,"pct_ad":0.206642,"pct_control":0.219725,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"UBE2K","gene_symbol_current":"UBE2K","gene_id":"ENSG00000078140","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.566805,"nucleus_log2fc":-0.161819,"nucleus_score":-1.12045,"pct_ad":0.243328,"pct_control":0.259004,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":-0.117342,"donor_lfcse":0.129638,"donor_log2fc_shrunk":-0.00144027},{"cell_type":"Oli","gene_symbol":"UBE2K","gene_symbol_current":"UBE2K","gene_id":"ENSG00000078140","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.658058,"nucleus_log2fc":-0.0642035,"nucleus_score":-0.600811,"pct_ad":0.131404,"pct_control":0.133425,"donor_test":"not significant","donor_padj":0.942097,"donor_log2fc":-0.043832,"donor_lfcse":0.0922802,"donor_log2fc_shrunk":-0.0046289}],"modules":[{"cell_type":"In","gene_id":"ENSG00000078140","module":"brown","kme":0.194932,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000078140","module":"green","kme":0.163806,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000078140","module":"blue","kme":0.11699,"hub":false,"module_direction":"lower in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000078140","entrez_id":["3093"],"uniprot":["P61086"],"ncbi_summary":"The protein encoded by this gene belongs to the ubiquitin-conjugating enzyme family. This protein interacts with RING finger proteins, and it can ubiquitinate huntingtin, the gene product for Huntington's disease. Known functions for this protein include a role in aggregate formation of expanded polyglutamine proteins and the suppression of apoptosis in polyglutamine diseases, a role in the dislocation of newly synthesized MHC class I heavy chains from the endoplasmic reticulum, and involvement in foam cell formation. Multiple transcript variants encoding different isoforms have been identified for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P61086","text":"Accepts ubiquitin from the E1 complex and catalyzes its covalent attachment to other proteins. In vitro, in the presence or in the absence of BRCA1-BARD1 E3 ubiquitin-protein ligase complex, catalyzes the synthesis of 'Lys-48'-linked polyubiquitin chains. Does not transfer ubiquitin directly to but elongates monoubiquitinated substrate protein. Mediates the selective degradation of short-lived and abnormal proteins, such as the endoplasmic reticulum-associated degradation (ERAD) of misfolded lumenal proteins. Ubiquitinates huntingtin. May mediate foam cell formation by the suppression of apoptosis of lipid-bearing macrophages through ubiquitination and subsequence degradation of p53/TP53. Proposed to be involved in ubiquitination and proteolytic processing of NF-kappa-B; in vitro supports ubiquitination of NFKB1. In case of infection by cytomegaloviruses may be involved in the US11-dependent degradation of MHC class I heavy chains following their export from the ER to the cytosol. In case of viral infections may be involved in the HPV E7 protein-dependent degradation of RB1."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}