nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":4.64508e-09,"nucleus_log2fc":0.0650549,"nucleus_score":5.95402,"pct_ad":0.532809,"pct_control":0.525126,"donor_test":"not significant","donor_padj":0.760675,"donor_log2fc":0.122789,"donor_lfcse":0.100282,"donor_log2fc_shrunk":0.0058119},{"cell_type":"Mic","gene_symbol":"WDR82","gene_symbol_current":"WDR82","gene_id":"ENSG00000164091","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.62453e-05,"nucleus_log2fc":0.188951,"nucleus_score":4.62548,"pct_ad":0.289786,"pct_control":0.260829,"donor_test":"not significant","donor_padj":0.298251,"donor_log2fc":0.215658,"donor_lfcse":0.0858406,"donor_log2fc_shrunk":0.121484},{"cell_type":"OPC","gene_symbol":"WDR82","gene_symbol_current":"WDR82","gene_id":"ENSG00000164091","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.990922,"nucleus_log2fc":-0.03067,"nucleus_score":-0.01864,"pct_ad":0.257531,"pct_control":0.255377,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.00175946,"donor_lfcse":0.0834944,"donor_log2fc_shrunk":2.71751e-07},{"cell_type":"Oli","gene_symbol":"WDR82","gene_symbol_current":"WDR82","gene_id":"ENSG00000164091","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":4.84965e-07,"nucleus_log2fc":0.120634,"nucleus_score":5.18898,"pct_ad":0.242237,"pct_control":0.225806,"donor_test":"not significant","donor_padj":0.672104,"donor_log2fc":0.121156,"donor_lfcse":0.0709808,"donor_log2fc_shrunk":0.0275394}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000164091","module":"red","kme":0.301889,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164091","entrez_id":["80335"],"uniprot":["Q6UXN9"],"ncbi_summary":"TMEM113 (WDR82) is a component of the mammalian SET1A (MIM 611052)/SET1B (MIM 611055) histone H3-Lys4 methyltransferase complexes (Lee and Skalnik, 2005 [PubMed 16253997]; Lee et al., 2007 [PubMed 17355966]).[supplied by OMIM, Jul 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6UXN9","text":"Regulatory component of the SET1/COMPASS complex implicated in the tethering of this complex to transcriptional start sites of active genes (PubMed:17998332, PubMed:18838538, PubMed:20516061). Facilitates histone H3 'Lys-4' methylation (H3K4me) via recruitment of the SETD1A or SETD1B to the 'Ser-5' phosphorylated C-terminal domain (CTD) of RNA polymerase II large subunit (POLR2A) (PubMed:17998332, PubMed:18838538). Component of the PNUTS-PP1 protein phosphatase complex, a protein phosphatase 1 (PP1) complex that promotes RNA polymerase II transcription pause-release, allowing transcription elongation (PubMed:39603240, PubMed:39603239). PNUTS-PP1 also plays a role in the control of chromatin structure and cell cycle progression during the transition from mitosis into interphase (PubMed:20516061). Together with ZC3H4, but independently of the SET1 complex, part of a transcription termination checkpoint that promotes transcription termination of long non-coding RNAs (lncRNAs) (PubMed:33767452, PubMed:33913806). The transcription termination checkpoint is activated by the inefficiently spliced first exon of lncRNAs and promotes transcription termination of lncRNAs and their subsequent degradation by the exosome (PubMed:33767452)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}