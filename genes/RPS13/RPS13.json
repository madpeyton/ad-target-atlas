13","gene_id":"ENSG00000110700","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.864067,"nucleus_log2fc":-0.0907618,"nucleus_score":-0.503148,"pct_ad":0.248891,"pct_control":0.248677,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0966819,"donor_lfcse":0.239584,"donor_log2fc_shrunk":1.77975e-06},{"cell_type":"Oli","gene_symbol":"RPS13","gene_symbol_current":"RPS13","gene_id":"ENSG00000110700","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.869731,"donor_log2fc":0.180504,"donor_lfcse":0.202423,"donor_log2fc_shrunk":0.00422501}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000110700","module":"brown","kme":0.229816,"hub":false,"module_direction":"lower in AD","module_padj":0.652213,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000110700","module":"turquoise","kme":0.435267,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000110700","module":"turquoise","kme":0.401201,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000110700","module":"turquoise","kme":0.205989,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000110700","entrez_id":["6207"],"uniprot":["P62277"],"ncbi_summary":"Ribosomes, the organelles that catalyze protein synthesis, consist of a small 40S subunit and a large 60S subunit. Together these subunits are composed of 4 RNA species and approximately 80 structurally distinct proteins. This gene encodes a ribosomal protein that is a component of the 40S subunit. The protein belongs to the S15P family of ribosomal proteins. It is located in the cytoplasm. The protein has been shown to bind to the 5.8S rRNA in rat. The gene product of the E. coli ortholog (ribosomal protein S15) functions at early steps in ribosome assembly. This gene is co-transcribed with two U14 small nucleolar RNA genes, which are located in its third and fifth introns. As is typical for genes encoding ribosomal proteins, there are multiple processed pseudogenes of this gene dispersed through the genome. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P62277","text":"Component of the small ribosomal subunit. The ribosome is a large ribonucleoprotein complex responsible for the synthesis of proteins in the cell. Part of the small subunit (SSU) processome, first precursor of the small eukaryotic ribosomal subunit. During the assembly of the SSU processome in the nucleolus, many ribosome biogenesis factors, an RNA chaperone and ribosomal proteins associate with the nascent pre-rRNA and work in concert to generate RNA folding, modifications, rearrangements and cleavage as well as targeted degradation of pre-ribosomal RNA by the RNA exosome (PubMed:34516797)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}