,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.77069,"nucleus_log2fc":0.0578449,"nucleus_score":0.760071,"pct_ad":0.494232,"pct_control":0.47868,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0288126,"donor_lfcse":0.0672098,"donor_log2fc_shrunk":6.65929e-06},{"cell_type":"Mic","gene_symbol":"CSNK1A1","gene_symbol_current":"CSNK1A1","gene_id":"ENSG00000113712","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.960073,"nucleus_log2fc":-0.0389332,"nucleus_score":-0.150138,"pct_ad":0.230012,"pct_control":0.230961,"donor_test":"not significant","donor_padj":0.994287,"donor_log2fc":0.0228698,"donor_lfcse":0.172453,"donor_log2fc_shrunk":0.000951336},{"cell_type":"OPC","gene_symbol":"CSNK1A1","gene_symbol_current":"CSNK1A1","gene_id":"ENSG00000113712","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.157718,"nucleus_log2fc":-0.229506,"nucleus_score":-2.36083,"pct_ad":0.414443,"pct_control":0.459004,"donor_test":"not significant","donor_padj":0.940764,"donor_log2fc":-0.140417,"donor_lfcse":0.0865787,"donor_log2fc_shrunk":-0.00346782},{"cell_type":"Oli","gene_symbol":"CSNK1A1","gene_symbol_current":"CSNK1A1","gene_id":"ENSG00000113712","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0937012,"nucleus_log2fc":0.0910853,"nucleus_score":1.97208,"pct_ad":0.219232,"pct_control":0.205286,"donor_test":"not significant","donor_padj":0.875193,"donor_log2fc":0.0510122,"donor_lfcse":0.0610994,"donor_log2fc_shrunk":0.0107608}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000113712","module":"turquoise","kme":0.168311,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000113712","entrez_id":["1452"],"uniprot":["P48729"],"ncbi_summary":"Enables protein serine/threonine kinase activity. Involved in several processes, including negative regulation of canonical Wnt signaling pathway; peptidyl-serine phosphorylation; and positive regulation of proteasomal ubiquitin-dependent protein catabolic process. Located in centrosome; cytosol; and nuclear speck. Part of beta-catenin destruction complex. Colocalizes with keratin filament and mRNA cleavage and polyadenylation specificity factor complex. Biomarker of Alzheimer's disease and inclusion body myositis. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P48729","text":"Casein kinases are operationally defined by their preferential utilization of acidic proteins such as caseins as substrates (PubMed:11955436, PubMed:1409656, PubMed:18305108, PubMed:23902688). Phosphorylates a large number of proteins (PubMed:11955436, PubMed:1409656, PubMed:18305108, PubMed:23902688). Participates in Wnt signaling (PubMed:11955436). Phosphorylates CTNNB1 at 'Ser-45' (PubMed:11955436). May phosphorylate PER1 and PER2 (By similarity). May play a role in segregating chromosomes during mitosis (PubMed:1409656). May play a role in keratin cytoskeleton disassembly and thereby, it may regulate epithelial cell migration (PubMed:23902688). Acts as a positive regulator of mTORC1 and mTORC2 signaling in response to nutrients by mediating phosphorylation of DEPTOR inhibitor (PubMed:22017875, PubMed:22017877). Acts as an inhibitor of NLRP3 inflammasome assembly by mediating phosphorylation of NLRP3 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}