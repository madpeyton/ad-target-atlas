},{"cell_type":"Oli","gene_symbol":"SEC23A","gene_symbol_current":"SEC23A","gene_id":"ENSG00000100934","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0476668,"nucleus_log2fc":-0.0264316,"nucleus_score":-2.10963,"pct_ad":0.284121,"pct_control":0.293245,"donor_test":"not significant","donor_padj":0.950097,"donor_log2fc":0.0295722,"donor_lfcse":0.0714976,"donor_log2fc_shrunk":0.00523972,"degas_log2fc":-0.0972543,"degas_padj":1.04923e-05}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000100934","module":"turquoise","kme":0.0946862,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100934","entrez_id":["10484"],"uniprot":["Q15436"],"ncbi_summary":"The protein encoded by this gene is a member of the SEC23 subfamily of the SEC23/SEC24 family. It is part of a protein complex and found in the ribosome-free transitional face of the endoplasmic reticulum (ER) and associated vesicles. This protein has similarity to yeast Sec23p component of COPII. COPII is the coat protein complex responsible for vesicle budding from the ER. The encoded protein is suggested to play a role in the ER-Golgi protein trafficking. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15436","text":"Component of the coat protein complex II (COPII) which promotes the formation of transport vesicles from the endoplasmic reticulum (ER). The coat has two main functions, the physical deformation of the endoplasmic reticulum membrane into vesicles and the selection of cargo molecules for their transport to the Golgi complex. Required for the translocation of insulin-induced glucose transporter SLC2A4/GLUT4 to the cell membrane (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}