,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.99717,"donor_log2fc":0.00160576,"donor_lfcse":0.101194,"donor_log2fc_shrunk":0.000406054},{"cell_type":"OPC","gene_symbol":"VPS16","gene_symbol_current":"VPS16","gene_id":"ENSG00000215305","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.798698,"nucleus_log2fc":-0.0494161,"nucleus_score":-0.402172,"pct_ad":0.114823,"pct_control":0.11685,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0193912,"donor_lfcse":0.0999411,"donor_log2fc_shrunk":-2.00012e-06},{"cell_type":"Oli","gene_symbol":"VPS16","gene_symbol_current":"VPS16","gene_id":"ENSG00000215305","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.817592,"donor_log2fc":0.0974673,"donor_lfcse":0.0839853,"donor_log2fc_shrunk":0.0140369}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000215305","entrez_id":["64601"],"uniprot":["Q9H269"],"ncbi_summary":"Vesicle mediated protein sorting plays an important role in segregation of intracellular molecules into distinct organelles. Genetic studies in yeast have identified more than 40 vacuolar protein sorting (VPS) genes involved in vesicle transport to vacuoles. This gene encodes the human homolog of yeast class C Vps16 protein. The mammalian class C Vps proteins are predominantly associated with late endosomes/lysosomes, and like their yeast counterparts, may mediate vesicle trafficking steps in the endosome/lysosome pathway. Two transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H269","text":"Plays a role in vesicle-mediated protein trafficking to lysosomal compartments including the endocytic membrane transport and autophagic pathways. Believed to act as a core component of the putative HOPS and CORVET endosomal tethering complexes which are proposed to be involved in the Rab5-to-Rab7 endosome conversion probably implicating MON1A/B, and via binding SNAREs and SNARE complexes to mediate tethering and docking events during SNARE-mediated membrane fusion. The HOPS complex is proposed to be recruited to Rab7 on the late endosomal membrane and to regulate late endocytic, phagocytic and autophagic traffic towards lysosomes. The CORVET complex is proposed to function as a Rab5 effector to mediate early endosome fusion probably in specific endosome subpopulations (PubMed:11382755, PubMed:23351085, PubMed:24554770, PubMed:25266290, PubMed:25783203). Required for recruitment of VPS33A to the HOPS complex (PubMed:23901104). Required for fusion of endosomes and autophagosomes with lysosomes; the function is dependent on its association with VPS33A but not VPS33B (PubMed:25783203). The function in autophagosome-lysosome fusion implicates STX17 but not UVRAG (PubMed:24554770)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}