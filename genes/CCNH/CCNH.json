0.181455,"pct_control":0.167756,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0377957,"donor_lfcse":0.160616,"donor_log2fc_shrunk":1.55132e-06},{"cell_type":"Oli","gene_symbol":"CCNH","gene_symbol_current":"CCNH","gene_id":"ENSG00000134480","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.869731,"donor_log2fc":0.161522,"donor_lfcse":0.18166,"donor_log2fc_shrunk":0.00462606}],"modules":[{"cell_type":"In","gene_id":"ENSG00000134480","module":"blue","kme":0.199666,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000134480","module":"turquoise","kme":0.115029,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000134480","entrez_id":["902"],"uniprot":["P51946"],"ncbi_summary":"The protein encoded by this gene belongs to the highly conserved cyclin family, whose members are characterized by a dramatic periodicity in protein abundance through the cell cycle. Cyclins function as regulators of CDK kinases. Different cyclins exhibit distinct expression and degradation patterns which contribute to the temporal coordination of each mitotic event. This cyclin forms a complex with CDK7 kinase and ring finger protein MAT1. The kinase complex is able to phosphorylate CDK2 and CDC2 kinases, thus functions as a CDK-activating kinase (CAK). This cyclin and its kinase partner are components of TFIIH, as well as RNA polymerase II protein complexes. They participate in two different transcriptional regulation processes, suggesting an important link between basal transcription control and the cell cycle machinery. A pseudogene of this gene is found on chromosome 4. Alternate splicing results in multiple transcript variants.[provided by RefSeq, Nov 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P51946","text":"Component of the CDK-activating kinase (CAK) complex, a master regulator of CDK activity by catalyzing the activating threonine phosphorylation of CDKs (PubMed:41100585). Binds and activates cyclin-dependent protein kinase CDK7, the catalytic subunit of CAK (PubMed:41100585). CAK activates major mediators of cell cycle control, including CDK1, CDK2, CDK4 and CDK6, and plays a key role in regulating cell cycle progression (PubMed:41100585). CAK complexed to the core-TFIIH basal transcription factor activates RNA polymerase II by serine phosphorylation of the repetitive C-terminal domain (CTD) of its large subunit (POLR2A), allowing its escape from the promoter and elongation of the transcripts (PubMed:7533895, PubMed:10024882). Involved in cell cycle control and in RNA transcription by RNA polymerase II (PubMed:7533895, PubMed:10024882). Its expression and activity are constant throughout the cell cycle."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}