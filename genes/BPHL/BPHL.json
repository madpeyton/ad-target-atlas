fc":-0.084613,"donor_lfcse":0.127843,"donor_log2fc_shrunk":-5.42256e-06},{"cell_type":"In","gene_symbol":"BPHL","gene_symbol_current":"BPHL","gene_id":"ENSG00000137274","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0473447,"donor_lfcse":0.174998,"donor_log2fc_shrunk":-1.62942e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000137274","entrez_id":["670"],"uniprot":["Q86WA6"],"ncbi_summary":"This gene encodes a member of the serine protease family of hydrolytic enzymes which contain a serine in their active site. The encoded protein may play a role in activation of the antiviral prodrug valacyclovir. Alternatively spliced transcript variants have been described.[provided by RefSeq, Jan 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86WA6","text":"Specific alpha-amino acid ester serine hydrolase that prefers small, hydrophobic, and aromatic side chains and does not have a stringent requirement for the leaving group other than preferring a primary alcohol (PubMed:12732646, PubMed:15832508, PubMed:18256025, PubMed:25333274, PubMed:32196348). Has homocysteine-thiolactonase activity (in vitro) and may play a significant role in the detoxification of homocysteine thiolactone in vivo (PubMed:25333274). Catalyzes the hydrolytic activation of amino acid ester prodrugs of nucleoside analogs such as valacyclovir and valganciclovir, converting them into their active forms (acyclovir and ganciclovir) (PubMed:15832508, PubMed:18256025)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}