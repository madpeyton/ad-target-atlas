":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.991477,"donor_log2fc":-0.0108331,"donor_lfcse":0.19064,"donor_log2fc_shrunk":-0.000298484,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"SLCO1C1","gene_symbol_current":"SLCO1C1","gene_id":"ENSG00000139155","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.596364,"donor_log2fc":-0.507242,"donor_lfcse":0.249589,"donor_log2fc_shrunk":-0.00887113,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000139155","module":"pink","kme":0.443351,"hub":false,"module_direction":"lower in AD","module_padj":0.531952,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000139155","entrez_id":["53919"],"uniprot":["Q9NYB5"],"ncbi_summary":"This gene encodes a member of the organic anion transporter family. The encoded protein is a transmembrane receptor that mediates the sodium-independent uptake of thyroid hormones in brain tissues. This protein has particularly high affinity for the thyroid hormones thyroxine, tri-iodothyronine and reverse tri-iodothyronine. Polymorphisms in the gene encoding this protein may be associated with fatigue and depression in patients suffering from hyperthyroidism. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NYB5","text":"Mediates the Na(+)-independent high affinity transport of organic anions such as the thyroid hormones L-thyroxine (T4), L-thyroxine sulfate (T4S), and 3,3',5'-triiodo-L-thyronine (reverse T3, rT3) at the plasma membrane (PubMed:12351693, PubMed:18566113, PubMed:19129463, PubMed:40680733). Regulates T4 levels in different brain regions by transporting T4, and also by serving as an export pump for T4S, which is a source of T4 after hydrolysis by local sulfatases (PubMed:18566113). Increases the access of these substrates to the intracellular sites where they are metabolized by the deiodinases (PubMed:18566113). Other potential substrates, such as triiodothyronine (T3), 17-beta-glucuronosyl estradiol (17beta-estradiol 17-O-(beta-D-glucuronate)), estrone-3-sulfate (E1S) and sulfobromophthalein (BSP) are transported with much lower efficiency (PubMed:12351693, PubMed:19129463, PubMed:40680733). Transports T4 and E1S in a pH-insensitive manner (PubMed:19129463). Facilitates the transport of thyroid hormones across the blood-brain barrier and into glia and neuronal cells in the brain (PubMed:30296914)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}