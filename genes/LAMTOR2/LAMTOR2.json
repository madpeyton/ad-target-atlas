me":0.103382,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2+","gene_id":"ENSG00000116586","module":"turquoise","kme":0.20458,"hub":false,"module_direction":"higher in AD","module_padj":0.789273,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000116586","module":"turquoise","kme":0.192601,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000116586","module":"turquoise","kme":0.148171,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000116586","module":"turquoise","kme":0.0714614,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000116586"],"dataset_symbols":["LAMTOR2"],"explorer":"explorer.html?dataset=mathys2019#gene/LAMTOR2","cell_types":[{"cell_type":"Ex","gene_symbol":"LAMTOR2","gene_symbol_current":"LAMTOR2","gene_id":"ENSG00000116586","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":9.28362e-06,"nucleus_log2fc":-0.254163,"nucleus_score":-4.75314,"pct_ad":0.130536,"pct_control":0.152417,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.129391,"donor_lfcse":0.170923,"donor_log2fc_shrunk":-4.65364e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000116586","module":"turquoise","kme":0.238302,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000116586","module":"turquoise","kme":0.252221,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000116586","entrez_id":["28956"],"uniprot":["Q9Y2Q5"],"ncbi_summary":"The product of this gene is highly conserved with a mouse protein associated with the cytoplasmic face of late endosomes and lysosomes. The mouse protein interacts with MAPK scaffold protein 1, a component of the mitogen-activated protein kinase pathway. In humans, a mutation in this gene has been associated with a primary immunodeficiency syndrome, and suggests a role for this protein in endosomal biogenesis. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Feb 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y2Q5","text":"As part of the Ragulator complex it is involved in amino acid sensing and activation of mTORC1, a signaling complex promoting cell growth in response to growth factors, energy levels, and amino acids (PubMed:20381137, PubMed:28935770, PubMed:29107538, PubMed:29123114, PubMed:29158492). Activated by amino acids through a mechanism involving the lysosomal V-ATPase, the Ragulator plays a dual role for the small GTPases Rag (RagA/RRAGA, RagB/RRAGB, RagC/RRAGC and/or RagD/RRAGD): it (1) acts as a guanine nucleotide exchange factor (GEF), activating the small GTPases Rag and (2) mediates recruitment of Rag GTPases to the lysosome membrane (PubMed:22053050, PubMed:22980980, PubMed:28935770, PubMed:29107538, PubMed:29123114, PubMed:29158492, PubMed:30181260). Activated Ragulator and Rag GTPases function as a scaffold recruiting mTORC1 to lysosomes where it is in turn activated (PubMed:22980980, PubMed:29107538, PubMed:29123114, PubMed:29158492). Adapter protein that enhances the efficiency of the MAP kinase cascade facilitating the activation of MAPK2 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}