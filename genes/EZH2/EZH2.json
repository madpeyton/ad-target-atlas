hrunk":0.00419104,"degas_log2fc":0.0133355,"degas_padj":0.449027},{"cell_type":"Mic","gene_symbol":"EZH2","gene_symbol_current":"EZH2","gene_id":"ENSG00000106462","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.618388,"nucleus_log2fc":-0.0269402,"nucleus_score":-0.634737,"pct_ad":0.1039,"pct_control":0.106797,"donor_test":"not significant","donor_padj":0.971199,"donor_log2fc":-0.0569081,"donor_lfcse":0.274796,"donor_log2fc_shrunk":-0.00151091,"degas_log2fc":-0.56097,"degas_padj":4.43786e-14},{"cell_type":"OPC","gene_symbol":"EZH2","gene_symbol_current":"EZH2","gene_id":"ENSG00000106462","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0683716,"nucleus_log2fc":0.181037,"nucleus_score":2.2674,"pct_ad":0.146585,"pct_control":0.133108,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.134742,"donor_lfcse":0.104128,"donor_log2fc_shrunk":1.2206e-05,"degas_log2fc":-0.0555942,"degas_padj":0.497038},{"cell_type":"Oli","gene_symbol":"EZH2","gene_symbol_current":"EZH2","gene_id":"ENSG00000106462","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.458942,"donor_log2fc":-0.377826,"donor_lfcse":0.143331,"donor_log2fc_shrunk":-0.0244078,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000106462","module":"magenta","kme":0.492716,"hub":true,"module_direction":"higher in AD","module_padj":0.939268,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000106462","module":"turquoise","kme":0.0179486,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000106462","entrez_id":["2146"],"uniprot":["Q15910"],"ncbi_summary":"This gene encodes a member of the Polycomb-group (PcG) family. PcG family members form multimeric protein complexes, which are involved in maintaining the transcriptional repressive state of genes over successive cell generations. This protein associates with the embryonic ectoderm development protein, the VAV1 oncoprotein, and the X-linked nuclear protein. This protein may play a role in the hematopoietic and central nervous systems. Multiple alternatively splcied transcript variants encoding distinct isoforms have been identified for this gene. [provided by RefSeq, Feb 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15910","text":"Catalytic subunit of the PRC2/EED-EZH2 complex, a Polycomb group (PcG) complex that methylates 'Lys-9' (H3K9me) and 'Lys-27' (H3K27me) of histone H3, leading to transcriptional repression of the affected target gene (PubMed:14532106, PubMed:15225548, PubMed:15385962, PubMed:16618801, PubMed:16936726, PubMed:17344414, PubMed:22323599, PubMed:24474760, PubMed:26581166, PubMed:30026490, PubMed:30923826). Able to mono-, di- and trimethylate 'Lys-27' of histone H3 to form H3K27me1, H3K27me2 and H3K27me3, respectively (PubMed:15231737, PubMed:17210787, PubMed:18285464, PubMed:22323599, PubMed:30923826). Displays a preference for substrates with less methylation, loses activity when progressively more methyl groups are incorporated into H3K27, H3K27me0 > H3K27me1 > H3K27me2 (PubMed:22323599, PubMed:30923826). Compared to EZH1-containing complexes, it is more abundant in embryonic stem cells and plays a major role in forming H3K27me3, which is required for embryonic stem cell identity and proper differentiation (PubMed:19026781). The PRC2/EED-EZH2 complex may also serve as a recruiting platform for DNA methyltransferases, thereby linking two epigenetic repression systems (PubMed:16357870, PubMed:17200670). Genes repressed by the PRC2/EED-EZH2 complex include HOXC8, HOXA9, MYT1, CDKN2A and retinoic acid target genes (PubMed:16179254, PubMed:18086877, PubMed:20935635). EZH2 can also methylate non-histone proteins such as the transcription factor GATA4 and the nuclear receptor RORA (PubMed:23063525). Regulates the circadian clock via histone methylation at the promoter of the circadian genes (PubMed:16717091). Essential for the CRY1/2-mediated repression of the transcriptional activation of PER1/2 by the CLOCK-BMAL1 heterodimer; involved in the di and trimethylation of 'Lys-27' of histone H3 on PER1/2 promoters which is necessary for the CRY1/2 proteins to inhibit transcription (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}