ore":0.878227,"pct_ad":0.122332,"pct_control":0.120855,"donor_test":"not significant","donor_padj":0.938366,"donor_log2fc":0.058159,"donor_lfcse":0.116563,"donor_log2fc_shrunk":0.00449163,"degas_log2fc":0.108362,"degas_padj":0.00163864}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000132879","module":"red","kme":0.10144,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000132879","module":"brown","kme":0.211871,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000132879","module":"turquoise","kme":0.0733619,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000132879","module":"turquoise","kme":0.0497425,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000132879","module":"turquoise","kme":0.0489476,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000132879","entrez_id":["93611"],"uniprot":["Q9H4M3"],"ncbi_summary":"This gene encodes a member of the F-box protein family which is characterized by an approximately 40 amino acid motif, the F-box. The F-box proteins constitute one of the four subunits of the ubiquitin protein ligase complex called SCFs (SKP1-cullin-F-box), which function in phosphorylation-dependent ubiquitination. The F-box proteins are divided into 3 classes: Fbws containing WD-40 domains, Fbls containing leucine-rich repeats, and Fbxs containing either different protein-protein interaction modules or no recognizable motifs. The protein encoded by this gene belongs to the Fbxs class. It is also a member of the NFB42 (neural F Box 42 kDa) family, similar to F-box only protein 2 and F-box only protein 6. Several alternatively spliced transcript variants encoding two distinct isoforms have been found for this gene. [provided by RefSeq, Feb 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H4M3","text":"Substrate-recognition component of two distinct E3 ligase complexes, the SKP1-CUL1-FBXO44 complex and the CUL4B-DDB1-FBXO44 complex (PubMed:18203720, PubMed:25970626). The complex SCF(FBXO44) complex ubiquitinates and mediates BRCA1 degradation (PubMed:23086937). In association with cullin 4B/CUL4B and DDB1, mediates the ubiquitination of RGS2 leading to its degradation (PubMed:25970626). Additionally, regulates the pregnane X receptor/NR1I2 protein level by ubiquitination and degradation (PubMed:37969738)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}