d":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":8.85798e-06,"nucleus_log2fc":0.126737,"nucleus_score":4.59776,"pct_ad":0.170311,"pct_control":0.157413,"donor_test":"not significant","donor_padj":0.927014,"donor_log2fc":0.0692168,"donor_lfcse":0.116071,"donor_log2fc_shrunk":0.0054022,"degas_log2fc":-0.0116067,"degas_padj":0.705771}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000120438","module":"magenta","kme":0.16237,"hub":false,"module_direction":"higher in AD","module_padj":0.456482,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000120438","module":"brown","kme":0.330745,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000120438","module":"turquoise","kme":0.0701185,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000120438","module":"turquoise","kme":0.0686534,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000120438","entrez_id":["6950"],"uniprot":["P17987"],"ncbi_summary":"The protein encoded by this gene is a molecular chaperone that is a member of the chaperonin containing TCP1 complex (CCT), also known as the TCP1 ring complex (TRiC). This complex consists of two identical stacked rings, each containing eight different proteins. Unfolded polypeptides enter the central cavity of the complex and are folded in an ATP-dependent manner. The complex folds various proteins, including actin and tubulin. Alternate transcriptional splice variants of this gene, encoding different isoforms, have been characterized. In addition, three pseudogenes that appear to be derived from this gene have been found. [provided by RefSeq, Jun 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P17987","text":"Component of the chaperonin-containing T-complex (TRiC), a molecular chaperone complex that assists the folding of actin, tubulin and other proteins upon ATP hydrolysis (PubMed:25467444, PubMed:36493755, PubMed:35449234, PubMed:37193829). The TRiC complex mediates the folding of WRAP53/TCAB1, thereby regulating telomere maintenance (PubMed:25467444). As part of the TRiC complex may play a role in the assembly of BBSome, a complex involved in ciliogenesis regulating transports vesicles to the cilia (PubMed:20080638)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}