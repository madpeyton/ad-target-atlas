hub":false,"module_direction":"lower in AD","module_padj":0.627226,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000184611","module":"brown","kme":0.251796,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000184611","entrez_id":["90134"],"uniprot":["Q9NS40"],"ncbi_summary":"Voltage-gated potassium (Kv) channels represent the most complex class of voltage-gated ion channels from both functional and structural standpoints. Their diverse functions include regulating neurotransmitter release, heart rate, insulin secretion, neuronal excitability, epithelial electrolyte transport, smooth muscle contraction, and cell volume. This gene encodes a member of the potassium channel, voltage-gated, subfamily H. This member is a pore-forming (alpha) subunit. There are at least two alternatively spliced transcript variants derived from this gene and encoding distinct isoforms. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NS40","text":"Pore-forming (alpha) subunit of voltage-gated inwardly rectifying potassium channel (PubMed:32723862). Exhibits faster activation and deactivation kinetics and slow inactivation at membrane potentials positive to 240 mV, resulting in the weakest inward rectification (PubMed:32723862)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}