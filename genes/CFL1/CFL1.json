g2fc":-0.00474509,"nucleus_score":-1.1574,"pct_ad":0.276698,"pct_control":0.282764,"donor_test":"not significant","donor_padj":0.936164,"donor_log2fc":0.0902922,"donor_lfcse":0.174946,"donor_log2fc_shrunk":0.00326973,"degas_log2fc":0.123393,"degas_padj":5.28507e-08}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000172757","module":"turquoise","kme":0.0963282,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000172757","module":"brown","kme":0.556888,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000172757","module":"brown","kme":0.368131,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000172757","module":"red","kme":0.218404,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000172757","module":"turquoise","kme":0.216566,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000172757","module":"turquoise","kme":0.280857,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000172757","entrez_id":["1072"],"uniprot":["P23528"],"ncbi_summary":"The protein encoded by this gene can polymerize and depolymerize F-actin and G-actin in a pH-dependent manner. Increased phosphorylation of this protein by LIM kinase aids in Rho-induced reorganization of the actin cytoskeleton. Cofilin is a widely distributed intracellular actin-modulating protein that binds and depolymerizes filamentous F-actin and inhibits the polymerization of monomeric G-actin in a pH-dependent manner. It is involved in the translocation of actin-cofilin complex from cytoplasm to nucleus.[supplied by OMIM, Apr 2004].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P23528","text":"Binds to F-actin and exhibits pH-sensitive F-actin depolymerizing activity (PubMed:11812157, PubMed:33670794). In conjunction with the subcortical maternal complex (SCMC), plays an essential role for zygotes to progress beyond the first embryonic cell divisions via regulation of actin dynamics (PubMed:15580268). Required for the centralization of the mitotic spindle and symmetric division of zygotes (By similarity). Plays a role in the regulation of cell morphology and cytoskeletal organization in epithelial cells (PubMed:21834987). Required for the up-regulation of atypical chemokine receptor ACKR2 from endosomal compartment to cell membrane, increasing its efficiency in chemokine uptake and degradation (PubMed:23633677). Required for neural tube morphogenesis and neural crest cell migration (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}