e_symbol":"MTPN","gene_symbol_current":"MTPN","gene_id":"ENSG00000105887","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.953589,"donor_log2fc":0.0626123,"donor_lfcse":0.162687,"donor_log2fc_shrunk":0.00265842}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000105887","module":"pink","kme":0.0688053,"hub":false,"module_direction":"lower in AD","module_padj":0.923706,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000105887","module":"yellow","kme":0.350745,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000105887","module":"turquoise","kme":0.160878,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000105887","entrez_id":["136319"],"uniprot":["P58546"],"ncbi_summary":"The transcript produced from this gene is bi-cistronic and can encode both myotrophin and leucine zipper protein 6. The myotrophin protein is associated with cardiac hypertrophy, where it is involved in the conversion of NFkappa B p50-p65 heterodimers to p50-p50 and p65-p65 homodimers. This protein also has a potential function in cerebellar morphogenesis, and it may be involved in the differentiation of cerebellar neurons, particularly of granule cells. A cryptic ORF at the 3' end of this transcript uses a novel internal ribosome entry site and a non-AUG translation initiation codon to produce leucine zipper protein 6, a 6.4 kDa tumor antigen that is associated with myeloproliferative disease. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P58546","text":"Promotes dimerization of NF-kappa-B subunits and regulates NF-kappa-B transcription factor activity (By similarity). Plays a role in the regulation of the growth of actin filaments. Inhibits the activity of the F-actin-capping protein complex formed by the CAPZA1 and CAPZB heterodimer. Promotes growth of cardiomyocytes, but not cardiomyocyte proliferation. Promotes cardiac muscle hypertrophy."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}