donor_padj":0.999342,"donor_log2fc":0.0866423,"donor_lfcse":0.127741,"donor_log2fc_shrunk":5.505e-06},{"cell_type":"Oli","gene_symbol":"WRAP73","gene_symbol_current":"WRAP73","gene_id":"ENSG00000116213","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.767138,"donor_log2fc":-0.115502,"donor_lfcse":0.0843056,"donor_log2fc_shrunk":-0.0175822}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000116213","module":"turquoise","kme":0.0487632,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000116213","module":"turquoise","kme":0.037719,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000116213","entrez_id":["49856"],"uniprot":["Q9P2S5"],"ncbi_summary":"This gene encodes a member of the WD repeat protein family. WD repeats are minimally conserved regions of approximately 40 amino acids typically bracketed by gly-his and trp-asp (GH-WD), which may facilitate formation of heterotrimeric or multiprotein complexes. Members of this family are involved in a variety of cellular processes, including cell cycle progression, signal transduction, apoptosis, and gene regulation. Studies of the related mouse protein suggest that the encoded protein may play a role in the process of ossification. [provided by RefSeq, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9P2S5","text":"The SSX2IP:WRAP73 complex is proposed to act as regulator of spindle anchoring at the mitotic centrosome. Required for the centrosomal localization of SSX2IP and normal mitotic bipolar spindle morphology (PubMed:26545777). Required for the targeting of centriole satellite proteins to centrosomes such as of PCM1, SSX2IP, CEP290 and PIBF1/CEP90. Required for ciliogenesis and involved in the removal of the CEP97:CCP110 complex from the mother centriole. Involved in ciliary vesicle formation at the mother centriole and required for the docking of vesicles to the basal body during ciliogenesis; may promote docking of RAB8A- and ARL13B-containing vesicles (PubMed:26675238)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}