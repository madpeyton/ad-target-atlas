onor_log2fc_shrunk":1.04426e-05,"degas_log2fc":0.142701,"degas_padj":0.00780704},{"cell_type":"Oli","gene_symbol":"ZSWIM7","gene_symbol_current":"ZSWIM7","gene_id":"ENSG00000214941","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.289442,"nucleus_log2fc":-0.035054,"nucleus_score":-1.15999,"pct_ad":0.221699,"pct_control":0.224542,"donor_test":"not significant","donor_padj":0.973523,"donor_log2fc":-0.0141758,"donor_lfcse":0.0653214,"donor_log2fc_shrunk":-0.00282954,"degas_log2fc":0.028914,"degas_padj":0.263025}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000214941","module":"turquoise","kme":0.201762,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000214941","module":"turquoise","kme":0.162176,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000214941","module":"turquoise","kme":0.0601149,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000214941","module":"turquoise","kme":0.059657,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000214941","entrez_id":["125150"],"uniprot":["Q19AV6"],"ncbi_summary":"Predicted to enable zinc ion binding activity. Involved in double-strand break repair via homologous recombination and protein stabilization. Part of Shu complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q19AV6","text":"Involved in early stages DNA double-strand break (DSB) repair via homologous recombination (HR) (PubMed:16710300, PubMed:21965664, PubMed:34253720, PubMed:39169038, PubMed:40345587). Forms a heterodimeric complex with ZSWIM7/SWS1 that promotes HR by regulating replication protein-A (RPA) dynamics on single-stranded DNA, thereby stabilizing RAD51 and DMC1 filaments on DNA (PubMed:34253720, PubMed:39169038, PubMed:40345587). The SWSAP1-ZSWIM7/SWS1 heterodimer is essential during meiosis by stabilizing DMC1 filaments (PubMed:32719396, PubMed:33713115, PubMed:34402903). In contrast, it is critical for only certain types of homologous-directed DNA repair, such as inter-homolog homologous recombination (IR-HR) (PubMed:34253720). IR-HR is a DNA repair mechanism where a cell repairs a DSB on one chromosome using the matching homologous chromosome as a template, rather than the sister chromatid (PubMed:34253720)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}