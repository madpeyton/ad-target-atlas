ested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.714111,"donor_log2fc":-0.287297,"donor_lfcse":0.161691,"donor_log2fc_shrunk":-0.00539119,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Mic","gene_symbol":"PCK2","gene_symbol_current":"PCK2","gene_id":"ENSG00000100889","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.998818,"donor_log2fc":0.00138767,"donor_lfcse":0.214239,"donor_log2fc_shrunk":8.44276e-05,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"PCK2","gene_symbol_current":"PCK2","gene_id":"ENSG00000100889","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.967811,"donor_log2fc":0.0726961,"donor_lfcse":0.227252,"donor_log2fc_shrunk":0.00156485,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100889","entrez_id":["5106"],"uniprot":["Q16822"],"ncbi_summary":"This gene encodes a mitochondrial enzyme that catalyzes the conversion of oxaloacetate to phosphoenolpyruvate in the presence of guanosine triphosphate (GTP). A cytosolic form of this protein is encoded by a different gene and is the key enzyme of gluconeogenesis in the liver. Alternatively spliced transcript variants have been described. [provided by RefSeq, Apr 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q16822","text":"Mitochondrial phosphoenolpyruvate carboxykinase that catalyzes the conversion of oxaloacetate (OAA) to phosphoenolpyruvate (PEP), the rate-limiting step in the metabolic pathway that produces glucose from lactate and other precursors derived from the citric acid cycle (PubMed:28955899). Can play an active role in glyceroneogenesis and gluconeogenesis (PubMed:28955899). In lipogenic cells such as adipocytes, it generates PEP via the mitochondrial pyruvate-to-PEP bypass, driving the PEP flux required for cytosolic glycerol 3-phosphate and triglyceride synthesis (By similarity). Also acts as a serine/threonine-protein kinase: phosphorylates and activates ACSL4, thereby promoting ferroptosis (PubMed:38720107)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}