ule_significant":false},{"cell_type":"In","gene_id":"ENSG00000114686","module":"turquoise","kme":0.163677,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000114686","module":"turquoise","kme":0.0747708,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000114686","entrez_id":["11222"],"uniprot":["P09001"],"ncbi_summary":"Mammalian mitochondrial ribosomal proteins are encoded by nuclear genes and help in protein synthesis within the mitochondrion. Mitochondrial ribosomes (mitoribosomes) consist of a small 28S subunit and a large 39S subunit. They have an estimated 75% protein to rRNA composition compared to prokaryotic ribosomes, where this ratio is reversed. Another difference between mammalian mitoribosomes and prokaryotic ribosomes is that the latter contain a 5S rRNA. Among different species, the proteins comprising the mitoribosome differ greatly in sequence, and sometimes in biochemical properties, which prevents easy recognition by sequence homology. This gene encodes a 39S subunit protein that belongs to the L3P ribosomal protein family. A pseudogene corresponding to this gene is found on chromosome 13q. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}