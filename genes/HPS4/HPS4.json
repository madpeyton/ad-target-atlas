icant":true,"nucleus_direction":"lower in AD","nucleus_padj":5.51066e-16,"nucleus_log2fc":-0.196948,"nucleus_score":-8.26178,"pct_ad":0.202461,"pct_control":0.22783,"donor_test":"not significant","donor_padj":0.530062,"donor_log2fc":-0.145905,"donor_lfcse":0.0642914,"donor_log2fc_shrunk":-0.0609081,"degas_log2fc":-0.147131,"degas_padj":7.567e-09}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100099","entrez_id":["89781"],"uniprot":["Q9NQG7"],"ncbi_summary":"This gene encodes a protein component of biogenesis of lysosome-related organelles complexes (BLOC). BLOC complexes are important for the formation of endosomal-lysosomal organelles such as melanosomes and platelet dense granules. Mutations in this gene result in subtype 4 of Hermansky-Pudlak syndrome, a form of albinism. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NQG7","text":"Component of the BLOC-3 complex, a complex that acts as a guanine exchange factor (GEF) for RAB32 and RAB38, promotes the exchange of GDP to GTP, converting them from an inactive GDP-bound form into an active GTP-bound form. The BLOC-3 complex plays an important role in the control of melanin production and melanosome biogenesis and promotes the membrane localization of RAB32 and RAB38 (PubMed:23084991)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}