":0.259949,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0316137,"donor_lfcse":0.131832,"donor_log2fc_shrunk":1.87528e-06,"degas_log2fc":0.215629,"degas_padj":0.000127533},{"cell_type":"Oli","gene_symbol":"SPRY2","gene_symbol_current":"SPRY2","gene_id":"ENSG00000136158","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.22898,"donor_log2fc":0.814961,"donor_lfcse":0.238697,"donor_log2fc_shrunk":0.63414,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000136158","module":"turquoise","kme":0.150355,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000136158","module":"turquoise","kme":0.101602,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136158","entrez_id":["10253"],"uniprot":["O43597"],"ncbi_summary":"This gene encodes a protein belonging to the sprouty family. The encoded protein contains a carboxyl-terminal cysteine-rich domain essential for the inhibitory activity on receptor tyrosine kinase signaling proteins and is required for growth factor stimulated translocation of the protein to membrane ruffles. In primary dermal endothelial cells this gene is transiently upregulated in response to fibroblast growth factor two. This protein is indirectly involved in the non-cell autonomous inhibitory effect on fibroblast growth factor two signaling. The protein interacts with Cas-Br-M (murine) ectropic retroviral transforming sequence, and can function as a bimodal regulator of epidermal growth factor receptor/mitogen-activated protein kinase signaling. This protein may play a role in alveoli branching during lung development as shown by a similar mouse protein. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43597","text":"Antagonist of fibroblast growth factor (FGF) pathways via inhibition of FGF-mediated phosphorylation of ERK1/2 (By similarity). Thereby acts as an antagonist of FGF-induced retinal lens fiber differentiation, may inhibit limb bud outgrowth and may negatively modulate respiratory organogenesis (By similarity). Inhibits TGFB-induced epithelial-to-mesenchymal transition in retinal lens epithelial cells (By similarity). Inhibits CBL/C-CBL-mediated EGFR ubiquitination (PubMed:17974561)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}