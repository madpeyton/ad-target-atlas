donor_test":"not significant","donor_padj":0.988516,"donor_log2fc":-0.00555905,"donor_lfcse":0.0721686,"donor_log2fc_shrunk":-0.00149517,"degas_log2fc":0.122193,"degas_padj":0.00916969},{"cell_type":"OPC","gene_symbol":"ZCCHC8","gene_symbol_current":"ZCCHC8","gene_id":"ENSG00000033030","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.103618,"nucleus_log2fc":0.100853,"nucleus_score":2.05894,"pct_ad":0.303161,"pct_control":0.285521,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0777211,"donor_lfcse":0.100298,"donor_log2fc_shrunk":8.0245e-06,"degas_log2fc":-0.299316,"degas_padj":5.51294e-09},{"cell_type":"Oli","gene_symbol":"ZCCHC8","gene_symbol_current":"ZCCHC8","gene_id":"ENSG00000033030","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.1604e-06,"nucleus_log2fc":0.11067,"nucleus_score":5.01871,"pct_ad":0.263555,"pct_control":0.24705,"donor_test":"not significant","donor_padj":0.910716,"donor_log2fc":0.0712439,"donor_lfcse":0.101388,"donor_log2fc_shrunk":0.00661526,"degas_log2fc":-0.15839,"degas_padj":1.17612e-11}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000033030","module":"green","kme":0.113568,"hub":false,"module_direction":"higher in AD","module_padj":0.232138,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000033030","module":"blue","kme":0.115552,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000033030","entrez_id":["55596"],"uniprot":["Q6NZY4"],"ncbi_summary":"This gene encodes a scaffold protein which serves as an assessory factor to the nuclear RNA exosome complex. The encoded protein forms a trimeric human nuclear exosome targeting (NEXT) complex, together with hMTR4 and the RNA-binding factor RBM7 which promotes the exosomal degradation of non-coding promoter-upstream transcripts, enhancer RNAs and 3'-extended products of histone- and small nuclear RNA transcription. This complex is also thought to recruit the exosome to degrade intronic RNAs via its interaction with both the exosome and the spliceosome. It contains both an N-terminal zinc-knuckle domain and a C-terminal proline-rich domain. [provided by RefSeq, Apr 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6NZY4","text":"Scaffolding subunit of the trimeric nuclear exosome targeting (NEXT) complex that is involved in the surveillance and turnover of aberrant transcripts and non-coding RNAs (PubMed:27871484). NEXT functions as an RNA exosome cofactor that directs a subset of non-coding short-lived RNAs for exosomal degradation. May be involved in pre-mRNA splicing (Probable). It is required for 3'-end maturation of telomerase RNA component (TERC), TERC 3'-end targeting to the nuclear RNA exosome, and for telomerase function (PubMed:31488579)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}