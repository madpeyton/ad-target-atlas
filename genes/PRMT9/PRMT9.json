ene_id":"ENSG00000164169","module":"green","kme":0.151098,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000164169","entrez_id":["90826"],"uniprot":["Q6P2P2"],"ncbi_summary":"This gene encodes a type II methyltransferase. Post-translational modification of target proteins by PRMTs plays an important regulatory role in many biological processes, whereby PRMTs methylate arginine residues by transferring methyl groups from S-adenosyl-L-methionine to the guanidino nitrogen atoms of arginine. The protein encoded by this gene methylates spliceosome associated protein 145 to regulate alternative splicing and acts as a modulator of small nuclear ribonucleoprotein maturation. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene. [provided by RefSeq, Apr 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6P2P2","text":"Arginine methyltransferase that can both catalyze the formation of omega-N monomethylarginine (MMA) and symmetrical dimethylarginine (sDMA). Specifically mediates the symmetrical dimethylation of SF3B2. Involved in the regulation of alternative splicing of pre-mRNA (PubMed:25737013, PubMed:25979344)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}