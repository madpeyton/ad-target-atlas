rol":0.186406,"donor_test":"not significant","donor_padj":0.931098,"donor_log2fc":-0.0321069,"donor_lfcse":0.0741543,"donor_log2fc_shrunk":-0.00912153,"degas_log2fc":0.160765,"degas_padj":0.00396754},{"cell_type":"OPC","gene_symbol":"ATF6B","gene_symbol_current":"ATF6B","gene_id":"ENSG00000213676","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.875203,"nucleus_log2fc":-0.0116813,"nucleus_score":0.254475,"pct_ad":0.256934,"pct_control":0.252329,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0417476,"donor_lfcse":0.105055,"donor_log2fc_shrunk":-3.90406e-06,"degas_log2fc":0.00191102,"degas_padj":0.975569},{"cell_type":"Oli","gene_symbol":"ATF6B","gene_symbol_current":"ATF6B","gene_id":"ENSG00000213676","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.834821,"nucleus_log2fc":-0.0054506,"nucleus_score":-0.243419,"pct_ad":0.179786,"pct_control":0.180229,"donor_test":"not significant","donor_padj":0.925939,"donor_log2fc":0.042971,"donor_lfcse":0.0704605,"donor_log2fc_shrunk":0.00800602,"degas_log2fc":-0.0854959,"degas_padj":0.00244016}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000213676","module":"red","kme":0.158098,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000213676","entrez_id":["1388"],"uniprot":["Q99941"],"ncbi_summary":"The protein encoded by this gene is a transcription factor in the unfolded protein response (UPR) pathway during ER stress. Either as a homodimer or as a heterodimer with ATF6-alpha, the encoded protein binds to the ER stress response element, interacting with nuclear transcription factor Y to activate UPR target genes. The protein is normally found in the membrane of the endoplasmic reticulum; however, under ER stress, the N-terminal cytoplasmic domain is cleaved from the rest of the protein and translocates to the nucleus. Two transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Oct 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q99941","text":"[Cyclic AMP-dependent transcription factor ATF-6 beta]: Precursor of the transcription factor form (Processed cyclic AMP-dependent transcription factor ATF-6 beta), which is embedded in the endoplasmic reticulum membrane (PubMed:11256944). Endoplasmic reticulum stress promotes processing of this form, releasing the transcription factor form that translocates into the nucleus, where it activates transcription of genes involved in the unfolded protein response (UPR) (PubMed:11256944). [Processed cyclic AMP-dependent transcription factor ATF-6 beta]: Transcription factor that acts in the unfolded protein response (UPR) pathway by activating UPR target genes induced during ER stress (PubMed:11256944). Binds DNA on the 5'-CCAC[GA]-3' half of the ER stress response element (ERSE) (5'-CCAATN(9)CCAC[GA]-3') when NF-Y is bound to ERSE (PubMed:11256944)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}