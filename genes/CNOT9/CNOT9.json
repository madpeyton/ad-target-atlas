se,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000144580"],"dataset_symbols":["RQCD1"],"explorer":"explorer.html?dataset=mathys2019#gene/RQCD1","cell_types":[{"cell_type":"Ex","gene_symbol":"RQCD1","gene_symbol_current":"CNOT9","gene_id":"ENSG00000144580","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.112056,"nucleus_log2fc":-0.038728,"nucleus_score":-1.78672,"pct_ad":0.157863,"pct_control":0.16765,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":0.0406922,"donor_lfcse":0.0742123,"donor_log2fc_shrunk":1.4997e-05},{"cell_type":"In","gene_symbol":"RQCD1","gene_symbol_current":"CNOT9","gene_id":"ENSG00000144580","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.651937,"nucleus_log2fc":0.167071,"nucleus_score":1.10227,"pct_ad":0.102928,"pct_control":0.0936819,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.12009,"donor_lfcse":0.151042,"donor_log2fc_shrunk":5.45972e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000144580","module":"green","kme":0.0422773,"hub":false,"module_direction":"lower in AD","module_padj":0.234072,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000144580","entrez_id":["9125"],"uniprot":["Q92600"],"ncbi_summary":"This gene encodes a member of the highly conserved RCD1 protein family. The encoded protein is a transcriptional cofactor and a core protein of the CCR4-NOT complex. It may be involved in signal transduction as well as retinoic acid-regulated cell differentiation and development. Alternatively spliced transcript variants have been described for this gene. [provided by RefSeq, Oct 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92600","text":"Component of the CCR4-NOT complex which is one of the major cellular mRNA deadenylases and is linked to various cellular processes including bulk mRNA degradation, miRNA-mediated repression, translational repression during translational initiation and general transcription regulation. Additional complex functions may be a consequence of its influence on mRNA expression. Involved in down-regulation of MYB- and JUN-dependent transcription. May play a role in cell differentiation (By similarity). Can bind oligonucleotides, such as poly-G, poly-C or poly-T (in vitro), but the physiological relevance of this is not certain. Does not bind poly-A. Enhances ligand-dependent transcriptional activity of nuclear hormone receptors, including RARA, expect ESR1-mediated transcription that is not only slightly increased, if at all."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}