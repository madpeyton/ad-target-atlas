_test":"not significant","donor_padj":0.940074,"donor_log2fc":-0.0959615,"donor_lfcse":0.197498,"donor_log2fc_shrunk":-0.0027041}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000182154","module":"blue","kme":0.0599264,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000182154","module":"turquoise","kme":0.0674244,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000182154","module":"turquoise","kme":0.0918969,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000182154","module":"turquoise","kme":0.142935,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000182154","entrez_id":["64975"],"uniprot":["Q8IXM3"],"ncbi_summary":"Mammalian mitochondrial ribosomal proteins are encoded by nuclear genes and help in protein synthesis within the mitochondrion. Mitochondrial ribosomes (mitoribosomes) consist of a small 28S subunit and a large 39S subunit. They have an estimated 75% protein to rRNA composition compared to prokaryotic ribosomes, where this ratio is reversed. Another difference between mammalian mitoribosomes and prokaryotic ribosomes is that the latter contain a 5S rRNA. Among different species, the proteins comprising the mitoribosome differ greatly in sequence, and sometimes in biochemical properties, which prevents easy recognition by sequence homology. This gene encodes a 39S subunit protein that belongs to the YmL27 ribosomal protein family. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IXM3","text":"Component of the mitochondrial ribosome large subunit (PubMed:25278503, PubMed:25838379, PubMed:28892042, PubMed:35177605). Also involved in apoptosis and cell cycle (PubMed:16024796, PubMed:16256947). Enhances p53/TP53 stability, thereby contributing to p53/TP53-induced apoptosis in response to growth-inhibitory condition. Enhances p53/TP53 translocation to the mitochondria. Has the ability to arrest the cell cycle at the G1 phase, possibly by stabilizing the CDKN1A and CDKN1B (p27Kip1) proteins (PubMed:16024796)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}