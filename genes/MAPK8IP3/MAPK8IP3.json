ontrol":0.412076,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0258574,"donor_lfcse":0.099974,"donor_log2fc_shrunk":2.9938e-06},{"cell_type":"Mic","gene_symbol":"MAPK8IP3","gene_symbol_current":"MAPK8IP3","gene_id":"ENSG00000138834","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.339035,"nucleus_log2fc":-0.444175,"nucleus_score":-1.6805,"pct_ad":0.0774908,"pct_control":0.101124,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"MAPK8IP3","gene_symbol_current":"MAPK8IP3","gene_id":"ENSG00000138834","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.936573,"nucleus_log2fc":0.0424664,"nucleus_score":0.202163,"pct_ad":0.197802,"pct_control":0.195402,"donor_test":"not significant","donor_padj":0.993604,"donor_log2fc":0.0370413,"donor_lfcse":0.149097,"donor_log2fc_shrunk":0.000335588},{"cell_type":"Oli","gene_symbol":"MAPK8IP3","gene_symbol_current":"MAPK8IP3","gene_id":"ENSG00000138834","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.909161,"nucleus_log2fc":-0.0286767,"nucleus_score":-0.176454,"pct_ad":0.143002,"pct_control":0.143297,"donor_test":"not significant","donor_padj":0.9355,"donor_log2fc":-0.0531901,"donor_lfcse":0.100033,"donor_log2fc_shrunk":-0.00477916}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000138834","module":"magenta","kme":0.278939,"hub":false,"module_direction":"higher in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000138834","module":"yellow","kme":0.18219,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000138834","entrez_id":["23162"],"uniprot":["Q9UPT6"],"ncbi_summary":"The protein encoded by this gene shares similarity with the product of Drosophila syd gene, required for the functional interaction of kinesin I with axonal cargo. Studies of the similar gene in mouse suggested that this protein may interact with, and regulate the activity of numerous protein kinases of the JNK signaling pathway, and thus function as a scaffold protein in neuronal cells. The C. elegans counterpart of this gene is found to regulate synaptic vesicle transport possibly by integrating JNK signaling and kinesin-1 transport. Several alternatively spliced transcript variants of this gene have been described, but the full-length nature of some of these variants has not been determined. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UPT6","text":"The JNK-interacting protein (JIP) group of scaffold proteins selectively mediates JNK signaling by aggregating specific components of the MAPK cascade to form a functional JNK signaling module (PubMed:12189133). May function as a regulator of vesicle transport, through interactions with the JNK-signaling components and motor proteins (By similarity). Promotes neuronal axon elongation in a kinesin- and JNK-dependent manner. Activates cofilin at axon tips via local activation of JNK, thereby regulating filopodial dynamics and enhancing axon elongation. Its binding to kinesin heavy chains (KHC), promotes kinesin-1 motility along microtubules and is essential for axon elongation and regeneration. Regulates cortical neuronal migration by mediating NTRK2/TRKB anterograde axonal transport during brain development (By similarity). Acts as an adapter that bridges the interaction between NTRK2/TRKB and KLC1 and drives NTRK2/TRKB axonal but not dendritic anterograde transport, which is essential for subsequent BDNF-triggered signaling and filopodia formation (PubMed:21775604)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}