"ENSG00000172465","module":"red","kme":0.0630437,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000172465","module":"brown","kme":0.278845,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000172465","module":"turquoise","kme":0.101242,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000172465","entrez_id":["9338"],"uniprot":["Q15170"],"ncbi_summary":"This gene encodes a member of the transcription elongation factor A (SII)-like (TCEAL) gene family. Members of this family may function as nuclear phosphoproteins that modulate transcription in a promoter context-dependent manner. The encoded protein is similar to transcription elongation factor A/transcription factor SII and contains a zinc finger-like motif as well as a sequence related to the transcription factor SII Pol II-binding region. It may exert its effects via protein-protein interactions with other transcriptional regulators rather than via direct binding of DNA. Multiple family members are located on the X chromosome. Alternative splicing results in multiple transcript variants encoding a single isoform. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15170","text":"May be involved in transcriptional regulation. Modulates various viral and cellular promoters in a promoter context-dependent manner. For example, transcription from the FOS promoter is increased, while Rous sarcoma virus (RSV) long terminal repeat (LTR) promoter activity is repressed. Does not bind DNA directly."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}