dj":0.986262,"donor_log2fc":0.0421377,"donor_lfcse":0.100387,"donor_log2fc_shrunk":4.31608e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198252","entrez_id":["6815"],"uniprot":["Q8WUJ0"],"ncbi_summary":"The protein encoded by this gene is a pseudophosphatase, able to bind potential substrates but lacking an active catalytic loop. The encoded protein may be involved in spermiogenesis. Two transcript variants encoding the same protein have been found for these genes. [provided by RefSeq, Oct 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WUJ0","text":"Catalytically inactive phosphatase (PubMed:23847209). Acts as a nuclear anchor for MAPK1/MAPK3 (ERK1/ERK2) (PubMed:23847209). Modulates cell-fate decisions and cell migration by spatiotemporal regulation of MAPK1/MAPK3 (ERK1/ERK2) (PubMed:23847209). By binding to the F-box of FBXW7, prevents the assembly of FBXW7 into the SCF E3 ubiquitin-protein ligase complex, and thereby inhibits degradation of its substrates (PubMed:28007894). Plays a role in spermatogenesis (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}