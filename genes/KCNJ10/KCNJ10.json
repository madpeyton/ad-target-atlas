her in AD","nucleus_padj":0.0115378,"nucleus_log2fc":0.361763,"nucleus_score":3.08486,"pct_ad":0.308204,"pct_control":0.275211,"donor_test":"not significant","donor_padj":0.601973,"donor_log2fc":0.449502,"donor_lfcse":0.227996,"donor_log2fc_shrunk":0.0193269},{"cell_type":"OPC","gene_symbol":"KCNJ10","gene_symbol_current":"KCNJ10","gene_id":"ENSG00000177807","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.359481,"nucleus_log2fc":0.245979,"nucleus_score":1.65186,"pct_ad":0.159341,"pct_control":0.135632,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"KCNJ10","gene_symbol_current":"KCNJ10","gene_id":"ENSG00000177807","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.30765e-07,"nucleus_log2fc":0.352714,"nucleus_score":5.58691,"pct_ad":0.141876,"pct_control":0.114001,"donor_test":"not significant","donor_padj":0.773686,"donor_log2fc":0.210359,"donor_lfcse":0.142712,"donor_log2fc_shrunk":0.0101758}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000177807","module":"turquoise","kme":0.320813,"hub":true,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000177807","module":"turquoise","kme":0.187338,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000177807","entrez_id":["3766"],"uniprot":["P78508"],"ncbi_summary":"This gene encodes a member of the inward rectifier-type potassium channel family, characterized by having a greater tendency to allow potassium to flow into, rather than out of, a cell. The encoded protein may form a heterodimer with another potassium channel protein and may be responsible for the potassium buffering action of glial cells in the brain. Mutations in this gene have been associated with seizure susceptibility of common idiopathic generalized epilepsy syndromes. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P78508","text":"May be responsible for potassium buffering action of glial cells in the brain (By similarity). Inward rectifier potassium channels are characterized by a greater tendency to allow potassium to flow into the cell rather than out of it (PubMed:8995301). Their voltage dependence is regulated by the concentration of extracellular potassium; as external potassium is raised, the voltage range of the channel opening shifts to more positive voltages (PubMed:8995301). The inward rectification is mainly due to the blockage of outward current by internal magnesium. Can be blocked by extracellular barium and cesium (PubMed:8995301). In the kidney, together with KCNJ16, mediates basolateral K(+) recycling in distal tubules; this process is critical for Na(+) reabsorption at the tubules (PubMed:24561201)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}