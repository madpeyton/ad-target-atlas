gene_ids":["ENSG00000169220"],"dataset_symbols":["RGS14"],"explorer":"explorer.html?dataset=seaad_pfc#gene/RGS14","cell_types":[{"cell_type":"Ast","gene_symbol":"RGS14","gene_symbol_current":"RGS14","gene_id":"ENSG00000169220","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.92557,"donor_log2fc":-0.126241,"donor_lfcse":0.254635,"donor_log2fc_shrunk":-0.00119147},{"cell_type":"Ex","gene_symbol":"RGS14","gene_symbol_current":"RGS14","gene_id":"ENSG00000169220","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000133972,"nucleus_log2fc":0.106198,"nucleus_score":3.87266,"pct_ad":0.165883,"pct_control":0.161914,"donor_test":"not significant","donor_padj":0.799223,"donor_log2fc":0.110894,"donor_lfcse":0.144779,"donor_log2fc_shrunk":0.00487398},{"cell_type":"In","gene_symbol":"RGS14","gene_symbol_current":"RGS14","gene_id":"ENSG00000169220","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.91112,"donor_log2fc":-0.0926789,"donor_lfcse":0.213625,"donor_log2fc_shrunk":-0.000969398},{"cell_type":"Mic","gene_symbol":"RGS14","gene_symbol_current":"RGS14","gene_id":"ENSG00000169220","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.514002,"donor_log2fc":0.32094,"donor_lfcse":0.179557,"donor_log2fc_shrunk":0.021915}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000169220","entrez_id":["10636"],"uniprot":["O43566"],"ncbi_summary":"This gene encodes a member of the regulator of G-protein signaling family. This protein contains one RGS domain, two Raf-like Ras-binding domains (RBDs), and one GoLoco domain. The protein attenuates the signaling activity of G-proteins by binding, through its GoLoco domain, to specific types of activated, GTP-bound G alpha subunits. Acting as a GTPase activating protein (GAP), the protein increases the rate of conversion of the GTP to GDP. This hydrolysis allows the G alpha subunits to bind G beta/gamma subunit heterodimers, forming inactive G-protein heterotrimers, thereby terminating the signal. Alternate transcriptional splice variants of this gene have been observed but have not been thoroughly characterized. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43566","text":"Regulates G protein-coupled receptor signaling cascades. Inhibits signal transduction by increasing the GTPase activity of G protein alpha subunits, thereby driving them into their inactive GDP-bound form. Besides, modulates signal transduction via G protein alpha subunits by functioning as a GDP-dissociation inhibitor (GDI). Has GDI activity on G(i) alpha subunits GNAI1 and GNAI3, but not on GNAI2 and G(o)-alpha subunit GNAO1. Has GAP activity on GNAI0, GNAI2 and GNAI3. May act as a scaffold integrating G protein and Ras/Raf MAPkinase signaling pathways. Inhibits platelet-derived growth factor (PDGF)-stimulated ERK1/ERK2 phosphorylation; a process depending on its interaction with HRAS and that is reversed by G(i) alpha subunit GNAI1. Acts as a positive modulator of microtubule polymerization and spindle organization through a G(i)-alpha-dependent mechanism. Plays a role in cell division. Required for the nerve growth factor (NGF)-mediated neurite outgrowth. Involved in stress resistance. May be involved in visual memory processing capacity and hippocampal-based learning and memory."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}