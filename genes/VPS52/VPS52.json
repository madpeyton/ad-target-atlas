.597545},{"cell_type":"Oli","gene_symbol":"VPS52","gene_symbol_current":"VPS52","gene_id":"ENSG00000223501","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000244436,"nucleus_log2fc":-0.120807,"nucleus_score":-3.81607,"pct_ad":0.112886,"pct_control":0.122148,"donor_test":"not significant","donor_padj":0.824887,"donor_log2fc":-0.0803378,"donor_lfcse":0.0717861,"donor_log2fc_shrunk":-0.0158803,"degas_log2fc":-0.124479,"degas_padj":0.000350212}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000223501","entrez_id":["6293"],"uniprot":["Q8N1B4"],"ncbi_summary":"This gene encodes a protein that is similar to the yeast suppressor of actin mutations 2 gene. The yeast protein forms a subunit of the tetrameric Golgi-associated retrograde protein complex that is involved in vesicle trafficking from from both early and late endosomes, back to the trans-Golgi network. This gene is located on chromosome 6 in a head-to-head orientation with the gene encoding ribosomal protein S18. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jan 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8N1B4","text":"Acts as a component of the GARP complex that is involved in retrograde transport from early and late endosomes to the trans-Golgi network (TGN). The GARP complex is required for the maintenance of the cycling of mannose 6-phosphate receptors between the TGN and endosomes, this cycling is necessary for proper lysosomal sorting of acid hydrolases such as CTSD (PubMed:15878329, PubMed:18367545). Acts as a component of the EARP complex that is involved in endocytic recycling. The EARP complex associates with Rab4-positive endosomes and promotes recycling of internalized transferrin receptor (TFRC) to the plasma membrane (PubMed:25799061)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}