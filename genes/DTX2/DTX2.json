og2fc_shrunk":7.21018e-06},{"cell_type":"OPC","gene_symbol":"DTX2","gene_symbol_current":"DTX2","gene_id":"ENSG00000091073","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.301174,"nucleus_log2fc":-0.318314,"nucleus_score":-1.82935,"pct_ad":0.0926217,"pct_control":0.114943,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000091073","module":"green","kme":0.05981,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000091073","entrez_id":["113878"],"uniprot":["Q86UW9"],"ncbi_summary":"DTX2 functions as an E3 ubiquitin ligase (Takeyama et al., 2003 [PubMed 12670957]).[supplied by OMIM, Nov 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86UW9","text":"E3 ubiquitin ligase that conjugates ubiquitin to ADP-ribosylated cysteine residues, independently of lysine side chains or free N-termini (PubMed:40681873). For example, PARP7 generates an ADP-ribosyl degron within the DNA-binding domain of the androgen receptor (AR), which is recognized by DTX2 and targeted for proteasomal degradation (PubMed:40681873). Functions in genome stability maintenance by acting as an ADP-ribosylation-dependent regulator of DNA double-strand break repair (PubMed:38992439). Mechanistically, recognizes PARylated substrates generated in response to DNA damage and promotes their ubiquitination via its RING and DTC domains (PubMed:38992439). Also regulates additional cellular pathways through ubiquitination of specific substrates. Acts as an E3 ubiquitin ligase for RNA demethylase FTO, promoting its ubiquitination and proteasomal degradation (PubMed:39661064). In turn, regulates antitumor immune responses (PubMed:39661064). Promotes 'Lys-27'-linked ubiquitination of TFRC, thereby modulating iron metabolism and inhibiting ferroptosis (PubMed:41772062). In addition, promotes transcription of telomerase reverse transcriptase by mediating 'Lys-63'-linked ubiquitination of nuclear factor 1 C-type (NFIC) that stabilizes its binding on hTERT promoter (PubMed:35198878)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}