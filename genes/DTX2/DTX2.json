r_test":"not significant","donor_padj":0.958135,"donor_log2fc":-0.0175734,"donor_lfcse":0.0805409,"donor_log2fc_shrunk":-0.00121079},{"cell_type":"Mic","gene_symbol":"DTX2","gene_symbol_current":"DTX2","gene_id":"ENSG00000091073","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.749946,"nucleus_log2fc":-0.0282459,"nucleus_score":-0.412707,"pct_ad":0.192758,"pct_control":0.194816,"donor_test":"not significant","donor_padj":0.842158,"donor_log2fc":-0.0631061,"donor_lfcse":0.081333,"donor_log2fc_shrunk":-0.0158768},{"cell_type":"OPC","gene_symbol":"DTX2","gene_symbol_current":"DTX2","gene_id":"ENSG00000091073","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.587574,"nucleus_log2fc":-0.0564727,"nucleus_score":-0.78225,"pct_ad":0.153594,"pct_control":0.15851,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0371819,"donor_lfcse":0.102463,"donor_log2fc_shrunk":-3.64205e-06},{"cell_type":"Oli","gene_symbol":"DTX2","gene_symbol_current":"DTX2","gene_id":"ENSG00000091073","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.615914,"donor_log2fc":0.167293,"donor_lfcse":0.0854184,"donor_log2fc_shrunk":0.0292308}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000091073","entrez_id":["113878"],"uniprot":["Q86UW9"],"ncbi_summary":"DTX2 functions as an E3 ubiquitin ligase (Takeyama et al., 2003 [PubMed 12670957]).[supplied by OMIM, Nov 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86UW9","text":"E3 ubiquitin ligase that conjugates ubiquitin to ADP-ribosylated cysteine residues, independently of lysine side chains or free N-termini (PubMed:40681873). For example, PARP7 generates an ADP-ribosyl degron within the DNA-binding domain of the androgen receptor (AR), which is recognized by DTX2 and targeted for proteasomal degradation (PubMed:40681873). Functions in genome stability maintenance by acting as an ADP-ribosylation-dependent regulator of DNA double-strand break repair (PubMed:38992439). Mechanistically, recognizes PARylated substrates generated in response to DNA damage and promotes their ubiquitination via its RING and DTC domains (PubMed:38992439). Also regulates additional cellular pathways through ubiquitination of specific substrates. Acts as an E3 ubiquitin ligase for RNA demethylase FTO, promoting its ubiquitination and proteasomal degradation (PubMed:39661064). In turn, regulates antitumor immune responses (PubMed:39661064). Promotes 'Lys-27'-linked ubiquitination of TFRC, thereby modulating iron metabolism and inhibiting ferroptosis (PubMed:41772062). In addition, promotes transcription of telomerase reverse transcriptase by mediating 'Lys-63'-linked ubiquitination of nuclear factor 1 C-type (NFIC) that stabilizes its binding on hTERT promoter (PubMed:35198878)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}