19","gene_ids":["ENSG00000233608"],"dataset_symbols":["TWIST2"],"explorer":"explorer.html?dataset=mathys2019#gene/TWIST2","cell_types":[{"cell_type":"Ex","gene_symbol":"TWIST2","gene_symbol_current":"TWIST2","gene_id":"ENSG00000233608","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.346678,"donor_lfcse":0.202401,"donor_log2fc_shrunk":-8.86631e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000233608","entrez_id":["117581"],"uniprot":["Q8WVJ9"],"ncbi_summary":"The protein encoded by this gene is a basic helix-loop-helix type transcription factor and shares similarity with Twist. This protein may inhibit osteoblast maturation and maintain cells in a preosteoblast phenotype during osteoblast development. This gene may be upregulated in certain cancers. Mutations in this gene cause focal facial dermal dysplasia 3, Setleis type. Two transcript variants encoding the same protein have been found. [provided by RefSeq, Apr 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WVJ9","text":"Binds to the E-box consensus sequence 5'-CANNTG-3' as a heterodimer and inhibits transcriptional activation by MYOD1, MYOG, MEF2A and MEF2C. Also represses expression of pro-inflammatory cytokines such as TNFA and IL1B. Involved in postnatal glycogen storage and energy metabolism (By similarity). Inhibits the premature or ectopic differentiation of preosteoblast cells during osteogenesis, possibly by changing the internal signal transduction response of osteoblasts to external growth factors."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}