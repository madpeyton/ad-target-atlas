911065,"donor_log2fc":0.101475,"donor_lfcse":0.149027,"donor_log2fc_shrunk":0.00436951}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000140307","module":"turquoise","kme":0.226207,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000140307","module":"turquoise","kme":0.28013,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000140307","module":"turquoise","kme":0.0984405,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000140307","entrez_id":["2958"],"uniprot":["P52657"],"ncbi_summary":"Accurate transcription initiation on TATA-containing class II genes involves the ordered assembly of RNA polymerase II (POLR2A; MIM 180660) and the general initiation factors TFIIA, TFIIB (MIM 189963), TFIID (MIM 313650), TFIIE (MIM 189962), TFIIF (MIM 189968), TFIIG/TFIIJ, and TFIIH (MIM 189972). The first step involves recognition of the TATA element by the TATA-binding subunit (TBP; MIM 600075) and may be regulated by TFIIA, a factor that interacts with both TBP and a TBP-associated factor (TAF; MIM 600475) in TFIID. TFIIA has 2 subunits (43 and 12 kD) in yeast and 3 subunits in higher eukaryotes. In HeLa extracts, it consists of a 35-kD alpha subunit and a 19-kD beta subunit encoded by the N- and C-terminal regions of GTF2A1 (MIM 600520), respectively, and a 12-kD gamma subunit encoded by GTF2A2 (DeJong et al., 1995 [PubMed 7724559]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P52657","text":"TFIIA is a component of the transcription machinery of RNA polymerase II and plays an important role in transcriptional activation. TFIIA in a complex with TBP mediates transcriptional activity."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}