BI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96EF6","text":"Substrate-recognition component of the SCF (SKP1-CUL1-F-box protein)-type E3 ubiquitin ligase complex. Able to recognize and bind denatured glycoproteins, which are modified with complex-type oligosaccharides. Also recognizes sulfated glycans. Does not bind high-mannose glycoproteins."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}