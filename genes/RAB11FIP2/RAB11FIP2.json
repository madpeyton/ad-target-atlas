ficant","donor_padj":0.767337,"donor_log2fc":0.121158,"donor_lfcse":0.088806,"donor_log2fc_shrunk":0.017795,"degas_log2fc":-0.180629,"degas_padj":5.04545e-22}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000107560","module":"blue","kme":0.164808,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000107560","entrez_id":["22841"],"uniprot":["Q7L804"],"ncbi_summary":"Enables protein homodimerization activity and protein kinase binding activity. Involved in several processes, including TRAM-dependent toll-like receptor 4 signaling pathway; phagocytosis; and positive regulation of GTPase activity. Located in endosome; nucleoplasm; and phagocytic cup. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q7L804","text":"A Rab11 effector binding preferentially phosphatidylinositol 3,4,5-trisphosphate (PtdInsP3) and phosphatidic acid (PA) and acting in the regulation of the transport of vesicles from the endosomal recycling compartment (ERC) to the plasma membrane. Involved in insulin granule exocytosis. Also involved in receptor-mediated endocytosis and membrane trafficking of recycling endosomes, probably originating from clathrin-coated vesicles. Required in a complex with MYO5B and RAB11 for the transport of NPC1L1 to the plasma membrane. Also acts as a regulator of cell polarity. Plays an essential role in phagocytosis through a mechanism involving TICAM2, RAC1 and CDC42 Rho GTPases for controlling actin-dynamics."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}