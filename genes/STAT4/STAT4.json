donor_log2fc_shrunk":-0.0151609},{"cell_type":"In","gene_symbol":"STAT4","gene_symbol_current":"STAT4","gene_id":"ENSG00000138378","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":4.59615e-51,"nucleus_log2fc":-0.144946,"nucleus_score":-15.1564,"pct_ad":0.486645,"pct_control":0.52111,"donor_test":"not significant","donor_padj":0.768128,"donor_log2fc":-0.0718659,"donor_lfcse":0.0617933,"donor_log2fc_shrunk":-0.0177431},{"cell_type":"Mic","gene_symbol":"STAT4","gene_symbol_current":"STAT4","gene_id":"ENSG00000138378","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.917944,"donor_log2fc":0.137659,"donor_lfcse":0.27998,"donor_log2fc_shrunk":0.00366815},{"cell_type":"OPC","gene_symbol":"STAT4","gene_symbol_current":"STAT4","gene_id":"ENSG00000138378","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.456165,"donor_lfcse":0.24369,"donor_log2fc_shrunk":-7.93028e-06},{"cell_type":"Oli","gene_symbol":"STAT4","gene_symbol_current":"STAT4","gene_id":"ENSG00000138378","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.572042,"donor_log2fc":-0.455197,"donor_lfcse":0.216348,"donor_log2fc_shrunk":-0.0115513}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000138378","module":"blue","kme":0.12253,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000138378","module":"turquoise","kme":0.165522,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000138378","entrez_id":["6775"],"uniprot":["Q14765"],"ncbi_summary":"The protein encoded by this gene is a member of the STAT family of transcription factors. In response to cytokines and growth factors, STAT family members are phosphorylated by the receptor associated kinases, and then form homo- or heterodimers that translocate to the cell nucleus where they act as transcription activators. This protein is essential for mediating responses to IL12 in lymphocytes, and regulating the differentiation of T helper cells. Mutations in this gene may be associated with systemic lupus erythematosus and rheumatoid arthritis. Alternate splicing results in multiple transcript variants that encode the same protein. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q14765","text":"Transcriptional regulator mainly expressed in hematopoietic cells that plays a critical role in cellular growth, differentiation and immune response (PubMed:10961885, PubMed:37256972, PubMed:8943379). Plays a key role in the differentiation of T-helper 1 cells and the production of interferon-gamma (PubMed:12213961, PubMed:35614130). Also participates in multiple neutrophil functions including chemotaxis and production of the neutrophil extracellular traps (By similarity). After IL12 binding to its receptor IL12RB2, STAT4 interacts with the intracellular domain of IL12RB2 and becomes tyrosine phosphorylated (PubMed:10415122, PubMed:7638186). Phosphorylated STAT4 then homodimerizes and migrates to the nucleus where it can recognize STAT target sequences present in IL12 responsive genes. Although IL12 appears to be the predominant activating signal, STAT4 can also be phosphorylated and activated in response to IFN-gamma stimulation via JAK1 and TYK2 and in response to different interleukins including IL23, IL2 and IL35 (PubMed:11114383, PubMed:34508746). Transcription activation of IFN-gamma gene is mediated by interaction with JUN that forms a complex that efficiently interacts with the AP-1-related sequence of the IFN-gamma promoter (By similarity). In response to IFN-alpha/beta signaling, acts as a transcriptional repressor and suppresses IL5 and IL13 mRNA expression during response to T-cell receptor (TCR) activation (PubMed:26990433)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}