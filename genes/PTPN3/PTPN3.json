67,"nucleus_log2fc":-0.087019,"nucleus_score":-3.2108,"pct_ad":0.229785,"pct_control":0.24996,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.095918,"donor_lfcse":0.0884357,"donor_log2fc_shrunk":-2.81168e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000070159","entrez_id":["5774"],"uniprot":["P26045"],"ncbi_summary":"The protein encoded by this gene is a member of the protein tyrosine phosphatase (PTP) family. PTPs are known to be signaling molecules that regulate a variety of cellular processes including cell growth, differentiation, mitotic cycle, and oncogenic transformation. This protein contains a C-terminal PTP domain and an N-terminal domain homologous to the band 4.1 superfamily of cytoskeletal-associated proteins. P97, a cell cycle regulator involved in a variety of membrane related functions, has been shown to be a substrate of this PTP. This PTP was also found to interact with, and be regulated by adaptor protein 14-3-3 beta. Several alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Feb 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P26045","text":"May act at junctions between the membrane and the cytoskeleton. Possesses tyrosine phosphatase activity."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}