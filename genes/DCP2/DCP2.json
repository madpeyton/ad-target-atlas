nor_log2fc":0.0400725,"donor_lfcse":0.0842922,"donor_log2fc_shrunk":5.45193e-06},{"cell_type":"Oli","gene_symbol":"DCP2","gene_symbol_current":"DCP2","gene_id":"ENSG00000172795","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0252469,"nucleus_log2fc":-0.0570045,"nucleus_score":-2.36965,"pct_ad":0.194489,"pct_control":0.201501,"donor_test":"not significant","donor_padj":0.937042,"donor_log2fc":-0.037544,"donor_lfcse":0.0731807,"donor_log2fc_shrunk":-0.00624083}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000172795","module":"red","kme":0.169023,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000172795","entrez_id":["167227"],"uniprot":["Q8IU60"],"ncbi_summary":"The protein encoded by this gene is a key component of an mRNA-decapping complex required for degradation of mRNAs, both in normal mRNA turnover, and in nonsense-mediated mRNA decay (NMD). It removes the 7-methyl guanine cap structure from mRNA, prior to its degradation from the 5' end. Alternatively spliced transcript variants encoding different isoforms have been noted for this gene.[provided by RefSeq, Jun 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IU60","text":"Decapping metalloenzyme that catalyzes the cleavage of the cap structure on mRNAs (PubMed:12218187, PubMed:12417715, PubMed:12923261, PubMed:21070968, PubMed:28002401, PubMed:31875550). Removes the 7-methyl guanine cap structure from mRNA molecules, yielding a 5'-phosphorylated mRNA fragment and 7m-GDP (PubMed:12486012, PubMed:12923261, PubMed:21070968, PubMed:28002401, PubMed:31875550). Necessary for the degradation of mRNAs, both in normal mRNA turnover and in nonsense-mediated mRNA decay (PubMed:14527413). Plays a role in replication-dependent histone mRNA degradation (PubMed:18172165). Has higher activity towards mRNAs that lack a poly(A) tail (PubMed:21070968). Has no activity towards a cap structure lacking an RNA moiety (PubMed:21070968). The presence of a N(6)-methyladenosine methylation at the second transcribed position of mRNAs (N(6),2'-O-dimethyladenosine cap; m6A(m)) provides resistance to DCP2-mediated decapping (PubMed:28002401). Blocks autophagy in nutrient-rich conditions by repressing the expression of ATG-related genes through degradation of their transcripts (PubMed:26098573)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}