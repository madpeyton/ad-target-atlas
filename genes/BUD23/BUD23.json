,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000071462"],"dataset_symbols":["WBSCR22"],"explorer":"explorer.html?dataset=mathys2019#gene/WBSCR22","cell_types":[{"cell_type":"Ex","gene_symbol":"WBSCR22","gene_symbol_current":"BUD23","gene_id":"ENSG00000071462","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000123932,"nucleus_log2fc":-0.154343,"nucleus_score":-4.13275,"pct_ad":0.205506,"pct_control":0.228426,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0735446,"donor_lfcse":0.108944,"donor_log2fc_shrunk":-6.47681e-06},{"cell_type":"In","gene_symbol":"WBSCR22","gene_symbol_current":"BUD23","gene_id":"ENSG00000071462","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.66933,"nucleus_log2fc":0.0300689,"nucleus_score":1.06383,"pct_ad":0.140639,"pct_control":0.12854,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.00958546,"donor_lfcse":0.1805,"donor_log2fc_shrunk":3.18659e-07},{"cell_type":"Oli","gene_symbol":"WBSCR22","gene_symbol_current":"BUD23","gene_id":"ENSG00000071462","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.98616,"donor_log2fc":-0.0118685,"donor_lfcse":0.122795,"donor_log2fc_shrunk":-0.000721322}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000071462","module":"turquoise","kme":0.182656,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000071462","module":"turquoise","kme":0.211526,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000071462","module":"turquoise","kme":0.143907,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000071462","entrez_id":["114049"],"uniprot":["O43709"],"ncbi_summary":"This gene encodes a protein containing a nuclear localization signal and an S-adenosyl-L-methionine binding motif typical of methyltransferases, suggesting that the encoded protein may act on DNA methylation. This gene is deleted in Williams syndrome, a multisystem developmental disorder caused by the deletion of contiguous genes at 7q11.23. Alternatively spliced transcript variants have been found. [provided by RefSeq, Feb 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43709","text":"S-adenosyl-L-methionine-dependent methyltransferase that specifically methylates the N(7) position of a guanine in 18S rRNA (PubMed:25851604). Requires the methyltransferase adapter protein TRM112 for full rRNA methyltransferase activity (PubMed:25851604). Involved in the pre-rRNA processing steps leading to small-subunit rRNA production independently of its RNA-modifying catalytic activity (PubMed:25851604). Important for biogenesis end export of the 40S ribosomal subunit independent on its methyltransferase activity (PubMed:24086612). Locus-specific steroid receptor coactivator. Potentiates transactivation by glucocorticoid (NR3C1), mineralocorticoid (NR3C2), androgen (AR) and progesterone (PGR) receptors (PubMed:24488492). Required for the maintenance of open chromatin at the TSC22D3/GILZ locus to facilitate NR3C1 loading on the response elements (PubMed:24488492). Required for maintenance of dimethylation on histone H3 'Lys-79' (H3K79me2), although direct histone methyltransferase activity is not observed in vitro (PubMed:24488492)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}