ntrol":0.140469,"donor_test":"not significant","donor_padj":0.720724,"donor_log2fc":0.105781,"donor_lfcse":0.0689735,"donor_log2fc_shrunk":0.0248567,"degas_log2fc":-0.0100378,"degas_padj":0.76218}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000071462","module":"turquoise","kme":0.0547398,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000071462","module":"turquoise","kme":0.037553,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000071462","entrez_id":["114049"],"uniprot":["O43709"],"ncbi_summary":"This gene encodes a protein containing a nuclear localization signal and an S-adenosyl-L-methionine binding motif typical of methyltransferases, suggesting that the encoded protein may act on DNA methylation. This gene is deleted in Williams syndrome, a multisystem developmental disorder caused by the deletion of contiguous genes at 7q11.23. Alternatively spliced transcript variants have been found. [provided by RefSeq, Feb 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43709","text":"S-adenosyl-L-methionine-dependent methyltransferase that specifically methylates the N(7) position of a guanine in 18S rRNA (PubMed:25851604). Requires the methyltransferase adapter protein TRM112 for full rRNA methyltransferase activity (PubMed:25851604). Involved in the pre-rRNA processing steps leading to small-subunit rRNA production independently of its RNA-modifying catalytic activity (PubMed:25851604). Important for biogenesis end export of the 40S ribosomal subunit independent on its methyltransferase activity (PubMed:24086612). Locus-specific steroid receptor coactivator. Potentiates transactivation by glucocorticoid (NR3C1), mineralocorticoid (NR3C2), androgen (AR) and progesterone (PGR) receptors (PubMed:24488492). Required for the maintenance of open chromatin at the TSC22D3/GILZ locus to facilitate NR3C1 loading on the response elements (PubMed:24488492). Required for maintenance of dimethylation on histone H3 'Lys-79' (H3K79me2), although direct histone methyltransferase activity is not observed in vitro (PubMed:24488492)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}