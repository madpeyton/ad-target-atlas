nucleus_padj":1.64211e-05,"nucleus_log2fc":-0.257254,"nucleus_score":-4.62285,"pct_ad":0.121597,"pct_control":0.142208,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.11733,"donor_lfcse":0.137685,"donor_log2fc_shrunk":-6.47167e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000221838","module":"magenta","kme":0.15712,"hub":false,"module_direction":"higher in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000221838","module":"turquoise","kme":0.131084,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000221838","entrez_id":["9179"],"uniprot":["O00189"],"ncbi_summary":"This gene encodes a subunit of the heterotetrameric AP-4 complex. The encoded protein belongs to the adaptor complexes medium subunits family. This AP-4 complex is involved in the recognition and sorting of cargo proteins with tyrosine-based motifs from the trans-golgi network to the endosomal-lysosomal system. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00189","text":"Component of the adaptor protein complex 4 (AP-4). Adaptor protein complexes are vesicle coat components involved both in vesicle formation and cargo selection. They control the vesicular transport of proteins in different trafficking pathways (PubMed:10066790, PubMed:10436028, PubMed:11139587, PubMed:11802162, PubMed:20230749). AP-4 forms a non clathrin-associated coat on vesicles departing the trans-Golgi network (TGN) and may be involved in the targeting of proteins from the trans-Golgi network (TGN) to the endosomal-lysosomal system (PubMed:11139587, PubMed:20230749). It is also involved in protein sorting to the basolateral membrane in epithelial cells and the proper asymmetric localization of somatodendritic proteins in neurons (By similarity). Within AP-4, the mu-type subunit AP4M1 is directly involved in the recognition and binding of tyrosine-based sorting signals found in the cytoplasmic part of cargos (PubMed:10436028, PubMed:11139587, PubMed:20230749, PubMed:26544806). The adaptor protein complex 4 (AP-4) may also recognize other types of sorting signal (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}