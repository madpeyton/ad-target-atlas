efSeq), via MyGene.info","uniprot_function":[{"accession":"P14138","text":"Endothelins are endothelium-derived vasoconstrictor peptides."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}