0596,"pct_ad":0.796188,"pct_control":0.788126,"donor_test":"not significant","donor_padj":0.767566,"donor_log2fc":0.112307,"donor_lfcse":0.095902,"donor_log2fc_shrunk":0.00580074},{"cell_type":"Mic","gene_symbol":"TBC1D4","gene_symbol_current":"TBC1D4","gene_id":"ENSG00000136111","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.0432e-15,"nucleus_log2fc":-0.248747,"nucleus_score":-8.33471,"pct_ad":0.576137,"pct_control":0.620507,"donor_test":"not significant","donor_padj":0.659634,"donor_log2fc":-0.20631,"donor_lfcse":0.154033,"donor_log2fc_shrunk":-0.0181601},{"cell_type":"OPC","gene_symbol":"TBC1D4","gene_symbol_current":"TBC1D4","gene_id":"ENSG00000136111","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0270192,"nucleus_log2fc":-0.128035,"nucleus_score":-2.67621,"pct_ad":0.243662,"pct_control":0.265538,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0629663,"donor_lfcse":0.130367,"donor_log2fc_shrunk":-3.89543e-06},{"cell_type":"Oli","gene_symbol":"TBC1D4","gene_symbol_current":"TBC1D4","gene_id":"ENSG00000136111","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.875212,"donor_log2fc":0.180214,"donor_lfcse":0.206711,"donor_log2fc_shrunk":0.00437462}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000136111","module":"green","kme":0.322368,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136111","entrez_id":["9882"],"uniprot":["O60343"],"ncbi_summary":"This gene is a member of the Tre-2/BUB2/CDC16 domain family. The protein encoded by this gene is a Rab-GTPase-activating protein, and contains two phopshotyrosine-binding domains (PTB1 and PTB2), a calmodulin-binding domain (CBD), a Rab-GTPase domain, and multiple AKT phosphomotifs. This protein is thought to play an important role in glucose homeostasis by regulating the insulin-dependent trafficking of the glucose transporter 4 (GLUT4), important for removing glucose from the bloodstream into skeletal muscle and fat tissues. Reduced expression of this gene results in an increase in GLUT4 levels at the plasma membrane, suggesting that this protein is important in intracellular retention of GLUT4 under basal conditions. When exposed to insulin, this protein is phosphorylated, dissociates from GLUT4 vesicles, resulting in increased GLUT4 at the cell surface, and enhanced glucose transport. Phosphorylation of this protein by AKT is required for proper translocation of GLUT4 to the cell surface. Individuals homozygous for a mutation in this gene are at higher risk for type 2 diabetes and have higher levels of circulating glucose and insulin levels after glucose ingestion. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Aug 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60343","text":"May act as a GTPase-activating protein for RAB2A, RAB8A, RAB10 and RAB14. Isoform 2 promotes insulin-induced glucose transporter SLC2A4/GLUT4 translocation at the plasma membrane, thus increasing glucose uptake."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}