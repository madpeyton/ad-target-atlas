cant":false},{"cell_type":"Ex","gene_id":"ENSG00000137962","module":"red","kme":0.265359,"hub":false,"module_direction":"lower in AD","module_padj":0.641133,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000137962","module":"brown","kme":0.211825,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000137962","entrez_id":["9411"],"uniprot":["Q52LW3"],"ncbi_summary":"Rap1 is a small GTPase that, through effectors, regulates Rho GTPase signaling. These effectors- Rasip1, Radil, and the protein encoded by this gene- translocate to the cell membrane, where they form a multiprotein complex. This complex is necessary for Rap1-induced inhibition of Rho signaling. Defects in this gene may be a cause of nonsyndromic cleft lip with or without cleft palate. [provided by RefSeq, Jun 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q52LW3","text":"GTPase activator for the Rho-type GTPases by converting them to an inactive GDP-bound state. Has strong activity toward RHOA, and weaker activity toward RAC1 and CDC42. May act as a specific effector of RAP2A to regulate Rho. In concert with RASIP1, suppresses RhoA signaling and dampens ROCK and MYH9 activities in endothelial cells and plays an essential role in blood vessel tubulogenesis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}