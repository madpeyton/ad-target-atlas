,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.596678,"donor_log2fc":-0.0902116,"donor_lfcse":0.0757718,"donor_log2fc_shrunk":-0.0116578}],"modules":[{"cell_type":"CUX2-","gene_id":"ENSG00000106113","module":"purple","kme":0.276832,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000106113"],"dataset_symbols":["CRHR2"],"explorer":"explorer.html?dataset=mathys2019#gene/CRHR2","cell_types":[{"cell_type":"Ex","gene_symbol":"CRHR2","gene_symbol_current":"CRHR2","gene_id":"ENSG00000106113","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.996008,"donor_log2fc":0.0365225,"donor_lfcse":0.215489,"donor_log2fc_shrunk":8.11175e-07}],"modules":[],"degas_bulk_de":false,"drug_target":false},"seaad_pfc":{"dataset_label":"SEA-AD (Gabitto et al. 2024)","gene_ids":["ENSG00000106113"],"dataset_symbols":["CRHR2"],"explorer":"explorer.html?dataset=seaad_pfc#gene/CRHR2","cell_types":[{"cell_type":"Ex","gene_symbol":"CRHR2","gene_symbol_current":"CRHR2","gene_id":"ENSG00000106113","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.53941e-78,"nucleus_log2fc":-0.164338,"nucleus_score":-18.7854,"pct_ad":0.331119,"pct_control":0.36668,"donor_test":"not significant","donor_padj":0.753798,"donor_log2fc":-0.108684,"donor_lfcse":0.111097,"donor_log2fc_shrunk":-0.00796089},{"cell_type":"In","gene_symbol":"CRHR2","gene_symbol_current":"CRHR2","gene_id":"ENSG00000106113","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":9.54458e-23,"nucleus_log2fc":-0.238848,"nucleus_score":-9.92809,"pct_ad":0.102039,"pct_control":0.116321,"donor_test":"not significant","donor_padj":0.716506,"donor_log2fc":-0.157474,"donor_lfcse":0.0894713,"donor_log2fc_shrunk":-0.00978474},{"cell_type":"Oli","gene_symbol":"CRHR2","gene_symbol_current":"CRHR2","gene_id":"ENSG00000106113","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.975371,"donor_log2fc":-0.0457127,"donor_lfcse":0.227632,"donor_log2fc_shrunk":-0.000968829}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000106113","module":"blue","kme":0.125039,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000106113","entrez_id":["1395"],"uniprot":["Q13324"],"ncbi_summary":"The protein encoded by this gene belongs to the G-protein coupled receptor 2 family, and the subfamily of corticotropin releasing hormone receptor. This receptor shows high affinity for corticotropin releasing hormone (CRH), and also binds CRH-related peptides such as urocortin. CRH is synthesized in the hypothalamus, and plays an important role in coordinating the endocrine, autonomic, and behavioral responses to stress and immune challenge. Studies in mice suggest that this receptor maybe involved in mediating cardiovascular homeostasis. Alternatively spliced transcript variants encoding different isoforms have been described for this gene.[provided by RefSeq, Jan 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13324","text":"G protein-coupled receptor for CRH, UCN, UCN2 and UCN3 stress hormones, which plays a central role in whole body adaptation to stress (PubMed:11329063, PubMed:11416224, PubMed:20966082, PubMed:22689579, PubMed:32004470, PubMed:36335102). Has highest affinity for UCN, and much lower affinity for CRH, UNC2 and UCN3 (PubMed:20966082, PubMed:22689579, PubMed:32004470, PubMed:36335102). Ligand binding causes a conformation change that triggers signaling via guanine nucleotide-binding proteins (G proteins) and downstream effectors, such as adenylate cyclase (PubMed:32004470, PubMed:36335102). CRHR2 is coupled to G(s) G protein (GNAS), mediating activation of adenylate cyclase activity and production of cAMP (PubMed:32004470, PubMed:36335102). CRHR2-dependent signaling is a primary mediator of the neuroendocrine, autonomic (fight-or-flight) and behavioral responses to stress, acting as a key regulator of adaptation by activating the hypothalamus-pituitary-adrenal axis, leading to corticotropin hormone (ACTH) production (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}