":-6.52639e-06,"degas_log2fc":0.252726,"degas_padj":5.17817e-06},{"cell_type":"Oli","gene_symbol":"ZIC1","gene_symbol_current":"ZIC1","gene_id":"ENSG00000152977","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.70535e-11,"nucleus_log2fc":-0.112183,"nucleus_score":-6.82081,"pct_ad":0.444525,"pct_control":0.469344,"donor_test":"not significant","donor_padj":0.915968,"donor_log2fc":-0.0820769,"donor_lfcse":0.122581,"donor_log2fc_shrunk":-0.00589247,"degas_log2fc":-0.0126078,"degas_padj":0.484665}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000152977","module":"turquoise","kme":0.139938,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000152977","module":"turquoise","kme":0.104242,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000152977","module":"turquoise","kme":0.0960687,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000152977","entrez_id":["7545"],"uniprot":["Q15915"],"ncbi_summary":"This gene encodes a member of the ZIC family of C2H2-type zinc finger proteins. Members of this family are important during development. Aberrant expression of this gene is seen in medulloblastoma, a childhood brain tumor. This gene is closely linked to the gene encoding zinc finger protein of the cerebellum 4, a related family member on chromosome 3. This gene encodes a transcription factor that can bind and transactivate the apolipoprotein E gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15915","text":"Acts as a transcriptional activator. Involved in neurogenesis. Plays important roles in the early stage of organogenesis of the CNS, as well as during dorsal spinal cord development and maturation of the cerebellum. Involved in the spatial distribution of mossy fiber (MF) neurons within the pontine gray nucleus (PGN). Plays a role in the regulation of MF axon pathway choice. Promotes MF migration towards ipsilaterally-located cerebellar territories. May have a role in shear flow mechanotransduction in osteocytes. Retains nuclear GLI1 and GLI3 in the cytoplasm. Binds to the minimal GLI-consensus sequence 5'-TGGGTGGTC-3' (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}