onor_log2fc":0.0263681,"donor_lfcse":0.0503937,"donor_log2fc_shrunk":1.07987e-05},{"cell_type":"Mic","gene_symbol":"SRPK2","gene_symbol_current":"SRPK2","gene_id":"ENSG00000135250","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.748891,"nucleus_log2fc":0.1129,"nucleus_score":0.731645,"pct_ad":0.172202,"pct_control":0.154806,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"SRPK2","gene_symbol_current":"SRPK2","gene_id":"ENSG00000135250","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.765704,"nucleus_log2fc":0.078426,"nucleus_score":0.650812,"pct_ad":0.368132,"pct_control":0.36092,"donor_test":"not significant","donor_padj":0.977919,"donor_log2fc":0.128101,"donor_lfcse":0.0983801,"donor_log2fc_shrunk":0.00320972},{"cell_type":"Oli","gene_symbol":"SRPK2","gene_symbol_current":"SRPK2","gene_id":"ENSG00000135250","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0893475,"nucleus_log2fc":0.0916344,"nucleus_score":1.99847,"pct_ad":0.412116,"pct_control":0.392952,"donor_test":"not significant","donor_padj":0.958934,"donor_log2fc":0.0148537,"donor_lfcse":0.0478082,"donor_log2fc_shrunk":0.00449762}],"modules":[{"cell_type":"In","gene_id":"ENSG00000135250","module":"brown","kme":0.248938,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000135250","entrez_id":["6733"],"uniprot":["P78362"],"ncbi_summary":"Enables ATP binding activity; magnesium ion binding activity; and protein serine/threonine kinase activity. Involved in several processes, including nucleic acid metabolic process; peptidyl-serine phosphorylation; and regulation of viral genome replication. Located in chromatin; cytosol; and nuclear lumen. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P78362","text":"Serine/arginine-rich protein-specific kinase which specifically phosphorylates its substrates at serine residues located in regions rich in arginine/serine dipeptides, known as RS domains and is involved in the phosphorylation of SR splicing factors and the regulation of splicing (PubMed:18559500, PubMed:21056976, PubMed:9472028). Promotes neuronal apoptosis by up-regulating cyclin-D1 (CCND1) expression (PubMed:19592491). This is done by the phosphorylation of SRSF2, leading to the suppression of p53/TP53 phosphorylation thereby relieving the repressive effect of p53/TP53 on cyclin-D1 (CCND1) expression (PubMed:21205200). Phosphorylates ACIN1, and redistributes it from the nuclear speckles to the nucleoplasm, resulting in cyclin A1 but not cyclin A2 up-regulation (PubMed:18559500). Plays an essential role in spliceosomal B complex formation via the phosphorylation of DDX23/PRP28 (PubMed:18425142). Probably by phosphorylating DDX23, leads to the suppression of incorrect R-loops formed during transcription; R-loops are composed of a DNA:RNA hybrid and the associated non-template single-stranded DNA (PubMed:28076779). Can mediate hepatitis B virus (HBV) core protein phosphorylation (PubMed:12134018). Plays a negative role in the regulation of HBV replication through a mechanism not involving the phosphorylation of the core protein but by reducing the packaging efficiency of the pregenomic RNA (pgRNA) without affecting the formation of the viral core particles (PubMed:16122776). Phosphorylates the N-terminus of ERC1 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}