cleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.331597,"nucleus_log2fc":-0.0277733,"nucleus_score":-1.1719,"pct_ad":0.595729,"pct_control":0.606221,"donor_test":"not significant","donor_padj":0.999223,"donor_log2fc":0.000783918,"donor_lfcse":0.159634,"donor_log2fc_shrunk":0.000103095,"degas_log2fc":0.7377,"degas_padj":1.16681e-142},{"cell_type":"OPC","gene_symbol":"CIITA","gene_symbol_current":"CIITA","gene_id":"ENSG00000179583","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.245593,"donor_lfcse":0.236054,"donor_log2fc_shrunk":4.45335e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"CIITA","gene_symbol_current":"CIITA","gene_id":"ENSG00000179583","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.970491,"donor_log2fc":-0.0474257,"donor_lfcse":0.170678,"donor_log2fc_shrunk":-0.00177016,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000179583","module":"black","kme":0.197583,"hub":false,"module_direction":"lower in AD","module_padj":1.0,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000179583","module":"turquoise","kme":0.142168,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000179583","module":"green","kme":0.33998,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000179583","entrez_id":["4261"],"uniprot":["P33076"],"ncbi_summary":"This gene encodes a protein with an acidic transcriptional activation domain, 4 LRRs (leucine-rich repeats) and a GTP binding domain. The protein is located in the nucleus and acts as a positive regulator of class II major histocompatibility complex gene transcription, and is referred to as the 'master control factor' for the expression of these genes. The protein also binds GTP and uses GTP binding to facilitate its own transport into the nucleus. Once in the nucleus it does not bind DNA but rather uses an intrinsic acetyltransferase (AT) activity to act in a coactivator-like fashion. Mutations in this gene have been associated with bare lymphocyte syndrome type II (also known as hereditary MHC class II deficiency or HLA class II-deficient combined immunodeficiency), increased susceptibility to rheumatoid arthritis, multiple sclerosis, and possibly myocardial infarction. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Nov 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P33076","text":"Essential for transcriptional activity of the HLA class II promoter; activation is via the proximal promoter (PubMed:16600381, PubMed:17493635, PubMed:7749984, PubMed:8402893, PubMed:40608405). Does not bind DNA (PubMed:16600381, PubMed:17493635, PubMed:7749984, PubMed:8402893). May act in a coactivator-like fashion through protein-protein interactions by contacting factors binding to the proximal MHC class II promoter, to elements of the transcription machinery, or both PubMed:8402893, PubMed:7749984, (PubMed:16600381, PubMed:17493635). Alternatively it may activate HLA class II transcription by modifying proteins that bind to the MHC class II promoter (PubMed:16600381, PubMed:17493635, PubMed:7749984, PubMed:8402893). Also mediates enhanced MHC class I transcription; the promoter element requirements for CIITA-mediated transcription are distinct from those of constitutive MHC class I transcription, and CIITA can functionally replace TAF1 at these genes. Activates CD74 transcription (PubMed:32855215). Exhibits intrinsic GTP-stimulated acetyltransferase activity (PubMed:11172716). Exhibits serine/threonine protein kinase activity: can phosphorylate the TFIID component TAF7, the RAP74 subunit of the general transcription factor TFIIF, histone H2B at 'Ser-37' and other histones (in vitro) (PubMed:24036077). Has antiviral activity against Ebola virus and coronaviruses, including SARS-CoV-2 (PubMed:32855215). Induces resistance by up-regulation of the p41 isoform of CD74, which blocks cathepsin-mediated cleavage of viral glycoproteins, thereby preventing viral fusion (PubMed:32855215). [Isoform 3]: Exhibits dominant-negative suppression of MHC class II gene expression."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}