":[{"cell_type":"CUX2-","gene_id":"ENSG00000104341","module":"turquoise","kme":0.163931,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000104341"],"dataset_symbols":["LAPTM4B"],"explorer":"explorer.html?dataset=mathys2019#gene/LAPTM4B","cell_types":[{"cell_type":"Ex","gene_symbol":"LAPTM4B","gene_symbol_current":"LAPTM4B","gene_id":"ENSG00000104341","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.891147,"nucleus_log2fc":0.0312273,"nucleus_score":-0.176597,"pct_ad":0.171069,"pct_control":0.172675,"donor_test":"not significant","donor_padj":0.994258,"donor_log2fc":0.0250171,"donor_lfcse":0.101256,"donor_log2fc_shrunk":2.5564e-06},{"cell_type":"In","gene_symbol":"LAPTM4B","gene_symbol_current":"LAPTM4B","gene_id":"ENSG00000104341","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.905075,"nucleus_log2fc":-0.101352,"nucleus_score":-0.36979,"pct_ad":0.209849,"pct_control":0.208217,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.111876,"donor_lfcse":0.153335,"donor_log2fc_shrunk":-4.44528e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000104341","module":"turquoise","kme":0.260934,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000104341","entrez_id":["55353"],"uniprot":["Q86VI4"],"ncbi_summary":"Enables ceramide binding activity; enzyme binding activity; and phosphatidylinositol bisphosphate binding activity. Involved in several processes, including negative regulation of macromolecule metabolic process; regulation of lysosomal membrane permeability; and regulation of lysosome organization. Located in several cellular components, including endosome; lysosomal membrane; and plasma membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86VI4","text":"Required for optimal lysosomal function (PubMed:21224396). Blocks EGF-stimulated EGFR intraluminal sorting and degradation. Conversely by binding with the phosphatidylinositol 4,5-bisphosphate, regulates its PIP5K1C interaction, inhibits HGS ubiquitination and relieves LAPTM4B inhibition of EGFR degradation (PubMed:25588945). Recruits SLC3A2 and SLC7A5 (the Leu transporter) to the lysosome, promoting entry of leucine and other essential amino acid (EAA) into the lysosome, stimulating activation of proton-transporting vacuolar (V)-ATPase protein pump (V-ATPase) and hence mTORC1 activation (PubMed:25998567). Plays a role as negative regulator of TGFB1 production in regulatory T cells (PubMed:26126825). Binds ceramide and facilitates its exit from late endosome in order to control cell death pathways (PubMed:26280656)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}