log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.712269,"donor_log2fc":0.218498,"donor_lfcse":0.139447,"donor_log2fc_shrunk":0.0124003,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000160408","module":"magenta","kme":0.177976,"hub":false,"module_direction":"higher in AD","module_padj":0.456482,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000160408","module":"red","kme":0.150955,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000160408","entrez_id":["30815"],"uniprot":["Q969X2"],"ncbi_summary":"ST6GALNAC6 belongs to a family of sialyltransferases that modify proteins and ceramides on the cell surface to alter cell-cell or cell-extracellular matrix interactions (Tsuchida et al., 2003 [PubMed 12668675]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q969X2","text":"Transfers the sialyl group (N-acetyl-alpha-neuraminyl or NeuAc) from CMP-NeuAc onto glycoproteins and glycolipids, forming an alpha-2,6-linkage. Produces branched type disialyl structures by transfer of a sialyl group onto the GalNAc or GlcNAc residue inside backbone core chains having a terminal sialic acid with an alpha-2,3-linkage on Gal. ST6GalNAcVI prefers glycolipids to glycoproteins, predominantly catalyzing the biosynthesis of ganglioside GD1alpha from GM1b (PubMed:12668675, PubMed:17123352). Besides GMb1, MSGG and other glycolipids, it shows activity towards sialyl Lc4Cer generating disialyl Lc4Cer, which can lead to the synthesis of disialyl Lewis a (Le(a)), suggested to be a cancer-associated antigen (PubMed:12668675). Also has activity toward GD1a and GT1b, and can generate DSGG (disialylgalactosylgloboside) from MSGG (monosialylgalactosylgloboside) (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}