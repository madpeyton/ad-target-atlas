eus_direction":"lower in AD","nucleus_padj":0.471575,"nucleus_log2fc":-0.21106,"nucleus_score":-1.35299,"pct_ad":0.0989011,"pct_control":0.116475,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"TSEN2","gene_symbol_current":"TSEN2","gene_id":"ENSG00000154743","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.955709,"donor_log2fc":-0.0531161,"donor_lfcse":0.145099,"donor_log2fc_shrunk":-0.00236741}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000154743","module":"tan","kme":0.17653,"hub":false,"module_direction":"lower in AD","module_padj":0.333899,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000154743","module":"black","kme":0.222868,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000154743","entrez_id":["80746"],"uniprot":["Q8NCE0"],"ncbi_summary":"This gene encodes one of the subunits of the tRNA splicing endonuclease. This endonuclease catalyzes the first step in RNA splicing which is the removal of introns. Mutations in this gene have been associated with pontocerebellar hypoplasia type 2. A pseudogene has been identified on chromosome 4. Multiple transcript variants encoding different isoforms have been found for this gene.[provided by RefSeq, Feb 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8NCE0","text":"Constitutes one of the two catalytic subunit of the tRNA-splicing endonuclease complex, a complex responsible for identification and cleavage of the splice sites in pre-tRNA. It cleaves pre-tRNA at the 5'- and 3'-splice sites to release the intron. The products are an intron and two tRNA half-molecules bearing 2',3'-cyclic phosphate and 5'-OH termini. There are no conserved sequences at the splice sites, but the intron is invariably located at the same site in the gene, placing the splice sites an invariant distance from the constant structural features of the tRNA body. Isoform 1 probably carries the active site for 5'-splice site cleavage. The tRNA splicing endonuclease is also involved in mRNA processing via its association with pre-mRNA 3'-end processing factors, establishing a link between pre-tRNA splicing and pre-mRNA 3'-end formation, suggesting that the endonuclease subunits function in multiple RNA-processing events. Isoform 2 is responsible for processing a yet unknown RNA substrate. The complex containing isoform 2 is not able to cleave pre-tRNAs properly, although it retains endonucleolytic activity."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}