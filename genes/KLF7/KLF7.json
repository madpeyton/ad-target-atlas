4,"donor_test":"not significant","donor_padj":0.940074,"donor_log2fc":-0.0426621,"donor_lfcse":0.0879166,"donor_log2fc_shrunk":-0.00547153}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000118263","module":"purple","kme":0.278251,"hub":false,"module_direction":"lower in AD","module_padj":0.900878,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000118263","module":"blue","kme":0.195709,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000118263","entrez_id":["8609"],"uniprot":["O75840"],"ncbi_summary":"The protein encoded by this gene is a member of the Kruppel-like transcriptional regulator family. Members in this family regulate cell proliferation, differentiation and survival and contain three C2H2 zinc fingers at the C-terminus that mediate binding to GC-rich sites. This protein may contribute to the progression of type 2 diabetes by inhibiting insulin expression and secretion in pancreatic beta-cells and by deregulating adipocytokine secretion in adipocytes. A pseudogene of this gene is located on the long arm of chromosome 3. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75840","text":"Transcriptional factor (PubMed:16339272, PubMed:9774444). Plays a critical role in neuronal morphogenesis and survival of sensory neurons (By similarity). Represses the corneal epithelium differentiation (PubMed:28916725). Also acts as a metabolic regulator, by modulating insulin sensitivity in pancreatic beta cells and skeletal muscle cells (PubMed:16339272). Inhibits transcriptional inducers of adipogenesis and has a repressive role in the expression of several adipokines, including leptin (PubMed:16339272)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}