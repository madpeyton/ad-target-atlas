ule_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000163875","module":"turquoise","kme":0.0636007,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000163875","module":"turquoise","kme":0.0495576,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163875","entrez_id":["64769"],"uniprot":["Q9HAF1"],"ncbi_summary":"This gene encodes a nuclear protein involved in transcriptional activation. The encoded protein may form a component of several different histone acetyltransferase complexes. There is a pseudogene for this gene on chromosome 2. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9HAF1","text":"Component of the NuA4 histone acetyltransferase complex which is involved in transcriptional activation of select genes principally by acetylation of nucleosomal histone H4 and H2A (PubMed:14966270). This modification may both alter nucleosome - DNA interactions and promote interaction of the modified histones with other proteins which positively regulate transcription (PubMed:14966270). Component of HBO1 complexes, which specifically mediate acetylation of histone H3 at 'Lys-14' (H3K14ac), and have reduced activity toward histone H4 (PubMed:16387653, PubMed:24065767). Component of the MOZ/MORF complex which has a histone H3 acetyltransferase activity (PubMed:18794358)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}