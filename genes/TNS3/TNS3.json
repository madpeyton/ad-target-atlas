ction":"higher in AD","nucleus_padj":0.796005,"nucleus_log2fc":0.0252861,"nucleus_score":0.407756,"pct_ad":0.736654,"pct_control":0.737511,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.131132,"donor_lfcse":0.183692,"donor_log2fc_shrunk":4.05758e-06,"degas_log2fc":-0.643245,"degas_padj":1.64427e-97},{"cell_type":"Oli","gene_symbol":"TNS3","gene_symbol_current":"TNS3","gene_id":"ENSG00000136205","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.977429,"donor_log2fc":-0.0464507,"donor_lfcse":0.254749,"donor_log2fc_shrunk":-0.000674685,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000136205","module":"pink","kme":0.369339,"hub":false,"module_direction":"lower in AD","module_padj":0.531952,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000136205","module":"blue","kme":0.136247,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000136205","module":"blue","kme":0.289614,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000136205","module":"blue","kme":0.342066,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000136205","module":"yellow","kme":0.303481,"hub":false,"module_direction":"higher in AD","module_padj":0.663532,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136205","entrez_id":["64759"],"uniprot":["Q68CZ2"],"ncbi_summary":"Predicted to enable phosphatase activity. Predicted to be involved in dephosphorylation and intracellular signal transduction. Predicted to act upstream of or within cell migration; lung alveolus development; and positive regulation of cell population proliferation. Located in cytosol and focal adhesion. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q68CZ2","text":"May act as a protein phosphatase and/or a lipid phosphatase (Probable). Involved in the dissociation of the integrin-tensin-actin complex (PubMed:17643115). EGF activates TNS4 and down-regulates TNS3 which results in capping the tail of ITGB1 (PubMed:17643115). Increases DOCK5 guanine nucleotide exchange activity towards Rac and plays a role in osteoclast podosome organization (By similarity). Enhances RHOA activation in the presence of DLC1 (PubMed:26427649). Required for growth factor-induced epithelial cell migration; growth factor stimulation induces TNS3 phosphorylation which changes its binding preference from DLC1 to the p85 regulatory subunit of the PI3K kinase complex, displacing PI3K inhibitor PTEN and resulting in translocation of the TNS3-p85 complex to the leading edge of migrating cells to promote RAC1 activation (PubMed:26166433). Meanwhile, PTEN switches binding preference from p85 to DLC1 and the PTEN-DLC1 complex translocates to the posterior of migrating cells to activate RHOA (PubMed:26166433). Acts as an adapter protein by bridging the association of scaffolding protein PEAK1 with integrins ITGB1, ITGB3 and ITGB5 which contributes to the promotion of cell migration (PubMed:35687021). Controls tonsil-derived mesenchymal stem cell proliferation and differentiation by regulating the activity of integrin ITGB1 (PubMed:31905841)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}