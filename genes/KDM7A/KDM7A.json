t_ad":0.169033,"pct_control":0.157796,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.00720059,"donor_lfcse":0.143991,"donor_log2fc_shrunk":-1.93315e-07}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000006459","module":"black","kme":0.0774558,"hub":false,"module_direction":"higher in AD","module_padj":0.56571,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000006459","module":"brown","kme":0.155902,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000006459","module":"brown","kme":0.165445,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000006459","entrez_id":["80853"],"uniprot":["Q6ZMT4"],"ncbi_summary":"Enables histone demethylase activity; methylated histone binding activity; and transition metal ion binding activity. Involved in histone lysine demethylation. Located in nucleolus and nucleoplasm. Implicated in melanoma. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6ZMT4","text":"Histone demethylase required for brain development. Specifically demethylates dimethylated 'Lys-9', 'Lys-27' and 'Lys-36' (H3K9me2, H3K27me2, H3K36me2, respectively) of histone H3 and monomethylated histone H4 'Lys-20' residue (H4K20Me1), thereby playing a central role in histone code (PubMed:20023638, PubMed:20622853). Specifically binds trimethylated 'Lys-4' of histone H3 (H3K4me3), affecting histone demethylase specificity: in presence of H3K4me3, it has no demethylase activity toward H3K9me2, while it has high activity toward H3K27me2. Demethylates H3K9me2 in absence of H3K4me3 (PubMed:20023638). Has activity toward H4K20Me1 only when nucleosome is used as a substrate and when not histone octamer is used as substrate (PubMed:20622853)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}