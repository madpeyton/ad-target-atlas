0.974963,"donor_log2fc":0.0241538,"donor_lfcse":0.145639,"donor_log2fc_shrunk":0.00106177}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000100220","module":"turquoise","kme":0.232743,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000100220","module":"turquoise","kme":0.244296,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000100220","module":"turquoise","kme":0.145102,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000100220","module":"turquoise","kme":0.0976847,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100220","entrez_id":["51493"],"uniprot":["Q9Y3I0"],"ncbi_summary":"Enables RNA ligase (ATP) activity and vinculin binding activity. Involved in tRNA splicing, via endonucleolytic cleavage and ligation. Located in cytosol and nucleoplasm. Part of tRNA-splicing ligase complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y3I0","text":"3'-5' RNA ligase, catalytic subunit of the tRNA-splicing ligase complex (tRNA-LC), which is involved in the enzyme-dependent maturation of intron-containing pre-tRNAs. Functions downstream of the tRNA-splicing endonuclease that removes introns, ligating the two generated halves via phosphodiester bond formation (PubMed:40069351). The ligation reaction, which requires guanosine triphosphate (GTP) and Mn(2+), proceeds through three metal-dependent steps. The first step requires ZBTB8OS/Archease and involves the guanylylation of RTCB at its active site histidine, forming a covalent GMP-histidine intermediate. Before the second step, RTCB also hydrolyzes the 2',3'-cyclic phosphate (cP) at the 3' end of the 5' tRNA exon, typically generated by the tRNA-splicing endonuclease, producing a 3' phosphate. The covalently bound GMP is then transferred to this 3' phosphate to form an RNA(3')-P-P-(5')G intermediate. In the final step, the 5'-OH of the 3' exon attacks the activated 3' end of the 5' exon, forming a 3'-5' phosphodiester bond and releasing GMP (PubMed:24870230, PubMed:38493148). RTCB also functions in non-canonical, spliceosome-independent, cytoplasmic splicing of XBP1 mRNAs during the unfolded protein response (UPR). Upon endoplasmic reticulum (ER) stress, the endoribonuclease IRE1/ERN1 excises a short intron, generating free exon ends that are aligned by RNA-intrinsic, zipper-like stem-loop structures. These exon ends are then recognized and ligated by RTCB. This splicing event yields the active XBP1s transcription factor, which induces genes required to resolve protein folding defects in the endoplasmic reticulum (PubMed:25378478, PubMed:26483401, PubMed:38493148)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}