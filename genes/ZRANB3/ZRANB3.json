ion":"lower in AD","nucleus_padj":0.000496389,"nucleus_log2fc":-0.179495,"nucleus_score":-3.9893,"pct_ad":0.337608,"pct_control":0.370195,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.123316,"donor_lfcse":0.0791538,"donor_log2fc_shrunk":-2.04344e-05},{"cell_type":"Oli","gene_symbol":"ZRANB3","gene_symbol_current":"ZRANB3","gene_id":"ENSG00000121988","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.77203e-37,"nucleus_log2fc":-0.227789,"nucleus_score":-12.9551,"pct_ad":0.374708,"pct_control":0.423289,"donor_test":"not significant","donor_padj":0.738418,"donor_log2fc":-0.116414,"donor_lfcse":0.080133,"donor_log2fc_shrunk":-0.0283305}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000121988","module":"turquoise","kme":0.144406,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000121988","module":"turquoise","kme":0.0615618,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000121988","entrez_id":["84083"],"uniprot":["Q5FWF4"],"ncbi_summary":"Enables ATP-dependent DNA/DNA annealing activity; K63-linked polyubiquitin modification-dependent protein binding activity; and endodeoxyribonuclease activity. Involved in several processes, including DNA metabolic process; DNA rewinding; and negative regulation of DNA recombination. Located in nuclear replication fork and nucleoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5FWF4","text":"DNA annealing helicase and endonuclease required to maintain genome stability at stalled or collapsed replication forks by facilitating fork restart and limiting inappropriate recombination that could occur during template switching events (PubMed:21078962, PubMed:22704558, PubMed:22705370, PubMed:22759634, PubMed:26884333). Recruited to the sites of stalled DNA replication by polyubiquitinated PCNA and acts as a structure-specific endonuclease that cleaves the replication fork D-loop intermediate, generating an accessible 3'-OH group in the template of the leading strand, which is amenable to extension by DNA polymerase (PubMed:22759634, PubMed:28621305). In addition to endonuclease activity, also catalyzes the fork regression via annealing helicase activity in order to prevent disintegration of the replication fork and the formation of double-strand breaks (PubMed:22704558, PubMed:22705370)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}