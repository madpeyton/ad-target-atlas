s":[{"cell_type":"Ast","gene_id":"ENSG00000134056","module":"turquoise","kme":0.0956494,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000134056","module":"brown","kme":0.220156,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000134056","module":"turquoise","kme":0.0799032,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000134056","module":"turquoise","kme":0.0759138,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000134056","entrez_id":["92259"],"uniprot":["P82909"],"ncbi_summary":"Mammalian mitochondrial ribosomal proteins are encoded by nuclear genes and help in protein synthesis within the mitochondrion. The mitochondrial ribosome (mitoribosome) consists of a small 28S subunit and a large 39S subunit. They have an estimated 75% protein to rRNA composition compared to prokaryotic ribosomes, where this ratio is reversed. Another difference between mammalian mitoribosomes and prokaryotic ribosomes is that the latter contain a 5S rRNA. Among different species, the proteins comprising the mitoribosome differ greatly in sequence, and sometimes in biochemical properties, which prevents easy recognition by sequence homology. This gene encodes a 28S subunit protein. Pseudogenes corresponding to this gene are found on chromosomes 3p, 4q, 8p, 11q, 12q, and 20p. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P82909","text":"Molecular adapter that is necessary to form a stable 2-oxoglutarate dehydrogenase enzyme complex (OGDHC). Enables the specific recruitment of E3 subunit to E2 subunit in the 2-oxoglutarate dehydrogenase complex (OGDHC)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}