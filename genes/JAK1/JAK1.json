significant","donor_padj":0.724514,"donor_log2fc":-0.157223,"donor_lfcse":0.0953794,"donor_log2fc_shrunk":-0.00848746,"degas_log2fc":0.115264,"degas_padj":2.33924e-85},{"cell_type":"Mic","gene_symbol":"JAK1","gene_symbol_current":"JAK1","gene_id":"ENSG00000162434","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.912863,"nucleus_log2fc":-0.000401862,"nucleus_score":0.149625,"pct_ad":0.609378,"pct_control":0.611982,"donor_test":"not significant","donor_padj":0.961725,"donor_log2fc":0.0275082,"donor_lfcse":0.104866,"donor_log2fc_shrunk":0.00471933,"degas_log2fc":0.407462,"degas_padj":1.28973e-45},{"cell_type":"OPC","gene_symbol":"JAK1","gene_symbol_current":"JAK1","gene_id":"ENSG00000162434","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00108436,"nucleus_log2fc":-0.110218,"nucleus_score":-3.77537,"pct_ad":0.807784,"pct_control":0.831329,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.100023,"donor_lfcse":0.0893715,"donor_log2fc_shrunk":-1.31006e-05,"degas_log2fc":-0.202348,"degas_padj":2.44999e-14},{"cell_type":"Oli","gene_symbol":"JAK1","gene_symbol_current":"JAK1","gene_id":"ENSG00000162434","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":6.9468e-31,"nucleus_log2fc":-0.151168,"nucleus_score":-11.7169,"pct_ad":0.719518,"pct_control":0.749522,"donor_test":"not significant","donor_padj":0.873308,"donor_log2fc":-0.102813,"donor_lfcse":0.116738,"donor_log2fc_shrunk":-0.00791935,"degas_log2fc":-0.0952708,"degas_padj":2.61859e-13}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000162434","module":"pink","kme":0.333161,"hub":false,"module_direction":"lower in AD","module_padj":0.531952,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000162434","module":"tan","kme":0.29696,"hub":false,"module_direction":"lower in AD","module_padj":0.0131545,"module_significant":true},{"cell_type":"Mic","gene_id":"ENSG00000162434","module":"turquoise","kme":0.0599201,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000162434","entrez_id":["3716"],"uniprot":["P23458"],"ncbi_summary":"This gene encodes a membrane protein that is a member of a class of protein-tyrosine kinases (PTK) characterized by the presence of a second phosphotransferase-related domain immediately N-terminal to the PTK domain. The encoded kinase phosphorylates STAT proteins (signal transducers and activators of transcription) and plays a key role in interferon-alpha/beta, interferon-gamma, and cytokine signal transduction. This gene plays a crucial role in effecting the expression of genes that mediate inflammation, epithelial remodeling, and metastatic cancer progression. This gene is a key component of the interleukin-6 (IL-6)/JAK1/STAT3 immune and inflammation response and is a therapeutic target for alleviating cytokine storms. The kinase activity of this gene is directly inhibited by the suppressor of cytokine signalling 1 (SOCS1) protein. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jul 2020].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P23458","text":"Non-membrane spanning protein tyrosine kinase that phosphorylates signal-transducing subunits of cytokine receptor complexes like IL2RB, IL10RA, IFNAR2, IL6ST, LIFR, OSMR and IL31RA (PubMed:11909529, PubMed:12133952, PubMed:15194700, PubMed:16239216, PubMed:28111307, PubMed:32750333, PubMed:7615558, PubMed:8232552, PubMed:9188471). Functionally, is involved in the IFN-alpha/beta/gamma signal pathway (PubMed:16239216, PubMed:28111307, PubMed:32750333, PubMed:7615558, PubMed:8232552). Mechanistically, in response to interferon-binding to IFNAR1-IFNAR2 heterodimer, phosphorylates and activates its binding partner IFNAR2, creating docking sites for STAT proteins (PubMed:7759950). Directly phosphorylates STAT proteins but also activates STAT signaling through the transactivation of other JAK kinases associated with signaling receptors (PubMed:16239216, PubMed:32750333, PubMed:8232552). Involved in the MT-RNR2/humanin-mediated signaling pathway leading to STAT3 phosphorylation (PubMed:27384491). Binding of CNTF or the CLCF1/CLF heterodimer to CNTFR leads to IL6ST/gp130-LIFR dimerization followed by activation of JAK1 and JAK2 which in turns phosphorylate IL6ST/gp130 and LIFR (PubMed:11294841). The tyrosine phosphorylated signaling receptors serve in turn as docking proteins for STAT3 (PubMed:11294841). Involved in the oncostatin-M-mediated signaling pathway through both type I OSM receptor complex (heterodimers composed of LIFR and IL6ST) and type II OSM receptor complex (heterodimers composed of OSMR and IL6ST) (PubMed:9188471). Involved in the oncostatin-M-mediated signaling pathway through both type I OSM receptor complex (heterodimers composed of LIFR and IL6ST) and type II OSM receptor complex (heterodimers composed of OSMR and IL6ST) (PubMed:9188471). Involved in the Interleukin-31-mediated signaling pathway through the IL31 receptor complex (heterodimers composed of OSMR and IL31RA) (PubMed:15194700)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}