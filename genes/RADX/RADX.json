,"description":[{"gene_id":"ENSG00000147231","entrez_id":["55086"],"uniprot":["Q6NSI4"],"ncbi_summary":"Enables single-stranded DNA binding activity. Involved in negative regulation of double-strand break repair via homologous recombination. Located in nuclear speck and replication fork. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6NSI4","text":"Single-stranded DNA-binding protein recruited to replication forks to maintain genome stability (PubMed:28735897). Prevents fork collapse by antagonizing the accumulation of RAD51 at forks to ensure the proper balance of fork remodeling and protection without interfering with the capacity of cells to complete homologous recombination of double-strand breaks (PubMed:28735897)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}