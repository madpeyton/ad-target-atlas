ia MyGene.info","uniprot_function":[{"accession":"Q9H0Q3","text":"Associates with and regulates the activity of the sodium/potassium-transporting ATPase (NKA) which catalyzes the hydrolysis of ATP coupled with the exchange of Na(+) and K(+) ions across the plasma membrane. Reduces the apparent affinity for intracellular Na(+) with no change in the apparent affinity for extracellular K(+) (PubMed:33231612). In addition to modulating NKA kinetics, may also function as a regulator of NKA localization to the plasma membrane (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}