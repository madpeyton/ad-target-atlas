symbol":"PUM2","gene_symbol_current":"PUM2","gene_id":"ENSG00000055917","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.488118,"nucleus_log2fc":0.0233181,"nucleus_score":0.971033,"pct_ad":0.748583,"pct_control":0.746825,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0117182,"donor_lfcse":0.0774318,"donor_log2fc_shrunk":-2.02029e-06,"degas_log2fc":-0.414652,"degas_padj":1.31145e-52},{"cell_type":"Oli","gene_symbol":"PUM2","gene_symbol_current":"PUM2","gene_id":"ENSG00000055917","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.07763e-07,"nucleus_log2fc":0.0623488,"nucleus_score":5.34932,"pct_ad":0.698258,"pct_control":0.695768,"donor_test":"not significant","donor_padj":0.965675,"donor_log2fc":0.0267995,"donor_lfcse":0.0786284,"donor_log2fc_shrunk":0.0043448,"degas_log2fc":-0.230087,"degas_padj":5.90392e-71}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000055917","module":"purple","kme":0.208915,"hub":false,"module_direction":"higher in AD","module_padj":0.0131545,"module_significant":true},{"cell_type":"Mic","gene_id":"ENSG00000055917","module":"blue","kme":0.235024,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000055917","module":"blue","kme":0.209314,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000055917","entrez_id":["23369"],"uniprot":["Q8TB72"],"ncbi_summary":"This gene encodes a protein that belongs to a family of RNA-binding proteins. The encoded protein functions as a translational repressor during embryonic development and cell differentiation. This protein is also thought to be a positive regulator of cell proliferation in adipose-derived stem cells. Alternate splicing results in multiple transcript variants. [provided by RefSeq, Sep 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TB72","text":"Sequence-specific RNA-binding protein that acts as a post-transcriptional repressor by binding the 3'-UTR of mRNA targets. Binds to an RNA consensus sequence, the Pumilio Response Element (PRE), 5'-UGUANAUA-3', that is related to the Nanos Response Element (NRE) (, PubMed:21397187). Mediates post-transcriptional repression of transcripts via different mechanisms: acts via direct recruitment of the CCR4-POP2-NOT deadenylase leading to translational inhibition and mRNA degradation (PubMed:22955276). Also mediates deadenylation-independent repression by promoting accessibility of miRNAs (PubMed:18776931, PubMed:22345517). Acts as a post-transcriptional repressor of E2F3 mRNAs by binding to its 3'-UTR and facilitating miRNA regulation (PubMed:22345517). Plays a role in cytoplasmic sensing of viral infection (PubMed:25340845). Represses a program of genes necessary to maintain genomic stability such as key mitotic, DNA repair and DNA replication factors. Its ability to repress those target mRNAs is regulated by the lncRNA NORAD (non-coding RNA activated by DNA damage) which, due to its high abundance and multitude of PUMILIO binding sites, is able to sequester a significant fraction of PUM1 and PUM2 in the cytoplasm (PubMed:26724866). May regulate DCUN1D3 mRNA levels (PubMed:25349211). May support proliferation and self-renewal of stem cells. Binds specifically to miRNA MIR199A precursor, with PUM1, regulates miRNA MIR199A expression at a postranscriptional level (PubMed:28431233)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}