:0.0802977,"donor_log2fc_shrunk":-0.00732793},{"cell_type":"In","gene_symbol":"HSCB","gene_symbol_current":"HSCB","gene_id":"ENSG00000100209","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.66129e-24,"nucleus_log2fc":-0.128333,"nucleus_score":-10.3302,"pct_ad":0.2574,"pct_control":0.279726,"donor_test":"not significant","donor_padj":0.759631,"donor_log2fc":-0.0705722,"donor_lfcse":0.0570329,"donor_log2fc_shrunk":-0.00973566},{"cell_type":"Mic","gene_symbol":"HSCB","gene_symbol_current":"HSCB","gene_id":"ENSG00000100209","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.70356,"nucleus_log2fc":0.0372845,"nucleus_score":0.492006,"pct_ad":0.176787,"pct_control":0.174309,"donor_test":"not significant","donor_padj":0.960662,"donor_log2fc":-0.0302644,"donor_lfcse":0.114388,"donor_log2fc_shrunk":-0.00430504},{"cell_type":"OPC","gene_symbol":"HSCB","gene_symbol_current":"HSCB","gene_id":"ENSG00000100209","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.860787,"nucleus_log2fc":-0.0142782,"nucleus_score":-0.280636,"pct_ad":0.207575,"pct_control":0.209145,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0174746,"donor_lfcse":0.0983205,"donor_log2fc_shrunk":1.93949e-06},{"cell_type":"Oli","gene_symbol":"HSCB","gene_symbol_current":"HSCB","gene_id":"ENSG00000100209","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00126115,"nucleus_log2fc":0.101218,"nucleus_score":3.36751,"pct_ad":0.147318,"pct_control":0.138446,"donor_test":"not significant","donor_padj":0.912834,"donor_log2fc":0.090958,"donor_lfcse":0.132342,"donor_log2fc_shrunk":0.00556068}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000100209","module":"yellow","kme":0.138259,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000100209","module":"blue","kme":0.126233,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000100209","module":"blue","kme":0.09594,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100209","entrez_id":["150274"],"uniprot":["Q8IWL3"],"ncbi_summary":"This gene encodes a DnaJ-type co-chaperone and member of the heat shock cognate B (HscB) family of proteins. The encoded protein plays a role in the synthesis of iron-sulfur clusters, protein cofactors that are involved in the redox reactions of mitochondrial electron transport and other processes. Cells in which this gene is knocked down exhibit reduced activity of iron-sulfur cluster-dependent enzymes including succinate dehydrogenase and aconitase. The encoded protein may stimulate the ATPase activity of the mitochondrial stress-70 protein. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Dec 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IWL3","text":"[Iron-sulfur cluster co-chaperone protein HscB, mitochondrial]: Acts as a co-chaperone in iron-sulfur cluster assembly in mitochondria (PubMed:20668094). Required for incorporation of iron-sulfur clusters into SDHB, the iron-sulfur protein subunit of succinate dehydrogenase that is involved in complex II of the mitochondrial electron transport chain (PubMed:26749241). Recruited to SDHB by interaction with SDHAF1 which first binds SDHB and then recruits the iron-sulfur transfer complex formed by HSC20, HSPA9 and ISCU through direct binding to HSC20 (PubMed:26749241). Plays an essential role in hematopoiesis (By similarity). [Iron-sulfur cluster co-chaperone protein HscB, cytoplasmic]: Acts as a co-chaperone in iron-sulfur cluster assembly in the cytoplasm (PubMed:29309586). Also mediates complex formation between components of the cytosolic iron-sulfur biogenesis pathway and the CIA targeting complex composed of CIAO1, DIPK1B/FAM69B and MMS19 by binding directly to the scaffold protein ISCU and to CIAO1 (PubMed:29309586). This facilitates iron-sulfur cluster insertion into a number of cytoplasmic and nuclear proteins including POLD1, ELP3, DPYD and PPAT (PubMed:29309586)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}