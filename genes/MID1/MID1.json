_shrunk":null},{"cell_type":"Oli","gene_symbol":"MID1","gene_symbol_current":"MID1","gene_id":"ENSG00000101871","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.991604,"donor_log2fc":-0.0119869,"donor_lfcse":0.195287,"donor_log2fc_shrunk":-0.000297004}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000101871","module":"red","kme":0.19929,"hub":false,"module_direction":"lower in AD","module_padj":0.641133,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000101871","module":"blue","kme":0.0603275,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101871","entrez_id":["4281"],"uniprot":["O15344"],"ncbi_summary":"The protein encoded by this gene is a member of the tripartite motif (TRIM) family, also known as the 'RING-B box-coiled coil' (RBCC) subgroup of RING finger proteins. The TRIM motif includes three zinc-binding domains, a RING, a B-box type 1 and a B-box type 2, and a coiled-coil region. This protein forms homodimers which associate with microtubules in the cytoplasm. The protein is likely involved in the formation of multiprotein structures acting as anchor points to microtubules. Mutations in this gene have been associated with the X-linked form of Opitz syndrome, which is characterized by midline abnormalities such as cleft lip, laryngeal cleft, heart defects, hypospadias, and agenesis of the corpus callosum. This gene was also the first example of a gene subject to X inactivation in human while escaping it in mouse. Alternative promoter use, alternative splicing and alternative polyadenylation result in multiple transcript variants that have different tissue specificities. [provided by RefSeq, Dec 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O15344","text":"E3 ubiquitin-protein ligase that promotes the monoubiquitination of IGBP1, which results in deprotection of the catalytic subunit of protein phosphatase PP2A, and its subsequent degradation by polyubiquitination (PubMed:11685209, PubMed:22613722)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}