us_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.816242,"nucleus_log2fc":-0.000507418,"nucleus_score":0.271546,"pct_ad":0.182125,"pct_control":0.18096,"donor_test":"not significant","donor_padj":0.931213,"donor_log2fc":-0.0416956,"donor_lfcse":0.0759742,"donor_log2fc_shrunk":-0.00731504,"degas_log2fc":-0.153326,"degas_padj":3.81915e-08}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000118705","module":"blue","kme":0.140291,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000118705","module":"blue","kme":0.18787,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000118705","module":"turquoise","kme":0.0228216,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000118705","entrez_id":["6185"],"uniprot":["P04844"],"ncbi_summary":"This gene encodes a type I integral membrane protein found only in the rough endoplasmic reticulum. The encoded protein is part of an N-oligosaccharyl transferase complex that links high mannose oligosaccharides to asparagine residues found in the Asn-X-Ser/Thr consensus motif of nascent polypeptide chains. This protein is similar in sequence to the yeast oligosaccharyl transferase subunit SWP1. Alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Oct 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P04844","text":"Subunit of the oligosaccharyl transferase (OST) complex that catalyzes the initial transfer of a defined glycan (Glc(3)Man(9)GlcNAc(2) in eukaryotes) from the lipid carrier dolichol-pyrophosphate to an asparagine residue within an Asn-X-Ser/Thr consensus motif in nascent polypeptide chains, the first step in protein N-glycosylation (PubMed:31831667). N-glycosylation occurs cotranslationally and the complex associates with the Sec61 complex at the channel-forming translocon complex that mediates protein translocation across the endoplasmic reticulum (ER). All subunits are required for a maximal enzyme activity."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}