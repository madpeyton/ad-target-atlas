nificant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0199947,"nucleus_log2fc":0.127954,"nucleus_score":2.80087,"pct_ad":0.341038,"pct_control":0.318036,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.101323,"donor_lfcse":0.0739648,"donor_log2fc_shrunk":1.93e-05},{"cell_type":"Oli","gene_symbol":"GNAI3","gene_symbol_current":"GNAI3","gene_id":"ENSG00000065135","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.78429e-09,"nucleus_log2fc":0.160135,"nucleus_score":6.10238,"pct_ad":0.220601,"pct_control":0.202315,"donor_test":"not significant","donor_padj":0.895874,"donor_log2fc":0.0648466,"donor_lfcse":0.0839716,"donor_log2fc_shrunk":0.00835755}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000065135","entrez_id":["2773"],"uniprot":["P08754"],"ncbi_summary":"Guanine nucleotide-binding proteins (G proteins) are involved as modulators or transducers in various transmembrane signaling pathways. G proteins are composed of 3 units: alpha, beta and gamma. This gene encodes an alpha subunit and belongs to the G-alpha family. Mutation in this gene, resulting in a gly40-to-arg substitution, is associated with auriculocondylar syndrome, and shown to affect downstream targets in the G protein-coupled endothelin receptor pathway. [provided by RefSeq, Jun 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P08754","text":"Heterotrimeric guanine nucleotide-binding proteins (G proteins) function as transducers downstream of G protein-coupled receptors (GPCRs) in numerous signaling cascades. The alpha chain contains the guanine nucleotide binding site and alternates between an active, GTP-bound state and an inactive, GDP-bound state. Signaling by an activated GPCR promotes GDP release and GTP binding. The alpha subunit has a low GTPase activity that converts bound GTP to GDP, thereby terminating the signal (By similarity). Both GDP release and GTP hydrolysis are modulated by numerous regulatory proteins (PubMed:18434541, PubMed:19478087, PubMed:8774883). Signaling is mediated via effector proteins, such as adenylate cyclase. Inhibits adenylate cyclase activity, leading to decreased intracellular cAMP levels (PubMed:19478087). Stimulates the activity of receptor-regulated K(+) channels (PubMed:2535845). The active GTP-bound form prevents the association of RGS14 with centrosomes and is required for the translocation of RGS14 from the cytoplasm to the plasma membrane. May play a role in cell division (PubMed:17635935). The active GTP-bound form activates the calcium permeant TRPC5 ion channels (PubMed:37137991)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}