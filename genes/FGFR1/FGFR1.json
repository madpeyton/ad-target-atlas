":"Astrocytes","gene_id":"ENSG00000077782","module":"blue","kme":0.145833,"hub":false,"module_direction":"higher in AD","module_padj":0.903036,"module_significant":false},{"cell_type":"CUX2+","gene_id":"ENSG00000077782","module":"magenta","kme":0.293464,"hub":false,"module_direction":"lower in AD","module_padj":0.923266,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000077782","module":"turquoise","kme":0.620646,"hub":false,"module_direction":"lower in AD","module_padj":0.773167,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000077782","module":"green","kme":0.212879,"hub":false,"module_direction":"higher in AD","module_padj":0.979936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000077782"],"dataset_symbols":["FGFR1"],"explorer":"explorer.html?dataset=mathys2019#gene/FGFR1","cell_types":[{"cell_type":"Ast","gene_symbol":"FGFR1","gene_symbol_current":"FGFR1","gene_id":"ENSG00000077782","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.930772,"nucleus_log2fc":0.0114324,"nucleus_score":-0.12719,"pct_ad":0.223947,"pct_control":0.230969,"donor_test":"not significant","donor_padj":0.848887,"donor_log2fc":0.12764,"donor_lfcse":0.154002,"donor_log2fc_shrunk":0.0112123},{"cell_type":"Ex","gene_symbol":"FGFR1","gene_symbol_current":"FGFR1","gene_id":"ENSG00000077782","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.328633,"nucleus_log2fc":0.0904848,"nucleus_score":1.13,"pct_ad":0.164161,"pct_control":0.159515,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.166219,"donor_lfcse":0.146808,"donor_log2fc_shrunk":8.05702e-06},{"cell_type":"In","gene_symbol":"FGFR1","gene_symbol_current":"FGFR1","gene_id":"ENSG00000077782","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.662473,"nucleus_log2fc":0.116105,"nucleus_score":1.07731,"pct_ad":0.113576,"pct_control":0.104264,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0213048,"donor_lfcse":0.19752,"donor_log2fc_shrunk":5.66585e-07},{"cell_type":"OPC","gene_symbol":"FGFR1","gene_symbol_current":"FGFR1","gene_id":"ENSG00000077782","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.216376,"nucleus_log2fc":-0.200328,"nucleus_score":-2.10297,"pct_ad":0.456044,"pct_control":0.493487,"donor_test":"not significant","donor_padj":0.986209,"donor_log2fc":-0.0831287,"donor_lfcse":0.11154,"donor_log2fc_shrunk":-0.00136729}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000077782","module":"magenta","kme":0.219931,"hub":false,"module_direction":"higher in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000077782","module":"red","kme":0.307189,"hub":false,"module_direction":"lower in AD","module_padj":0.641133,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000077782","module":"tan","kme":0.280707,"hub":true,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000077782","entrez_id":["2260"],"uniprot":["P11362"],"ncbi_summary":"The protein encoded by this gene is a member of the fibroblast growth factor receptor (FGFR) family, where amino acid sequence is highly conserved between members and throughout evolution. FGFR family members differ from one another in their ligand affinities and tissue distribution. A full-length representative protein consists of an extracellular region, composed of three immunoglobulin-like domains, a single hydrophobic membrane-spanning segment and a cytoplasmic tyrosine kinase domain. The extracellular portion of the protein interacts with fibroblast growth factors, setting in motion a cascade of downstream signals, ultimately influencing mitogenesis and differentiation. This particular family member binds both acidic and basic fibroblast growth factors and is involved in limb induction. Mutations in this gene have been associated with Pfeiffer syndrome, Jackson-Weiss syndrome, Antley-Bixler syndrome, osteoglophonic dysplasia, and autosomal dominant Kallmann syndrome 2. Chromosomal aberrations involving this gene are associated with stem cell myeloproliferative disorder and stem cell leukemia lymphoma syndrome. Alternatively spliced variants which encode different protein isoforms have been described; however, not all variants have been fully characterized. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P11362","text":"Tyrosine-protein kinase that acts as a cell-surface receptor for fibroblast growth factors and plays an essential role in the regulation of embryonic development, cell proliferation, differentiation and migration. Required for normal mesoderm patterning and correct axial organization during embryonic development, normal skeletogenesis and normal development of the gonadotropin-releasing hormone (GnRH) neuronal system. Phosphorylates PLCG1, FRS2, GAB1 and SHB. Ligand binding leads to the activation of several signaling cascades. Activation of PLCG1 leads to the production of the cellular signaling molecules diacylglycerol and inositol 1,4,5-trisphosphate. Phosphorylation of FRS2 triggers recruitment of GRB2, GAB1, PIK3R1 and SOS1, and mediates activation of RAS, MAPK1/ERK2, MAPK3/ERK1 and the MAP kinase signaling pathway, as well as of the AKT1 signaling pathway. Promotes phosphorylation of SHC1, STAT1 and PTPN11/SHP2. In the nucleus, enhances RPS6KA1 and CREB1 activity and contributes to the regulation of transcription. FGFR1 signaling is down-regulated by IL17RD/SEF, and by FGFR1 ubiquitination, internalization and degradation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}