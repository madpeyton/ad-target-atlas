ion":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.780549,"donor_log2fc":0.166589,"donor_lfcse":0.120913,"donor_log2fc_shrunk":0.0111132}],"modules":[{"cell_type":"In","gene_id":"ENSG00000197329","module":"blue","kme":0.0846839,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000197329","module":"blue","kme":0.121967,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000197329","entrez_id":["57162"],"uniprot":["Q96FA3"],"ncbi_summary":"Enables ubiquitin protein ligase activity. Involved in several processes, including negative regulation of necroptotic process; protein polyubiquitination; and response to lipopolysaccharide. Predicted to be located in cytosol. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96FA3","text":"E3 ubiquitin ligase catalyzing the covalent attachment of ubiquitin moieties onto substrate proteins (PubMed:12496252, PubMed:17675297, PubMed:29883609, PubMed:30952868). Involved in the TLR and IL-1 signaling pathways via interaction with the complex containing IRAK kinases and TRAF6 (PubMed:12496252, PubMed:17675297). Acts as a positive regulator of inflammatory response in microglia through activation of NF-kappa-B and MAP kinase (By similarity). Mediates 'Lys-63'-linked polyubiquitination of IRAK1 allowing subsequent NF-kappa-B activation (PubMed:12496252, PubMed:17675297). Conjugates 'Lys-63'-linked ubiquitin chains to the adapter protein ASC/PYCARD, which in turn is crucial for NLRP3 inflammasome activation (PubMed:34706239). Mediates 'Lys-48'-linked polyubiquitination of RIPK3 leading to its subsequent proteasome-dependent degradation; preferentially recognizes and mediates the degradation of the 'Thr-182' phosphorylated form of RIPK3 (PubMed:29883609). Negatively regulates necroptosis by reducing RIPK3 expression (PubMed:29883609). Mediates 'Lys-63'-linked ubiquitination of RIPK1 (PubMed:29883609). Following phosphorylation by ATM, catalyzes 'Lys-63'-linked ubiquitination of NBN, promoting DNA repair via homologous recombination (PubMed:30952868). Negatively regulates activation of the metabolic mTORC1 signaling pathway by mediating 'Lys-63'-linked ubiquitination of mTORC1-inhibitory protein TSC1 and thereby promoting TSC1/TSC2 complex stability (PubMed:33215753)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}