n AD","nucleus_padj":0.0304038,"nucleus_log2fc":-0.0815624,"nucleus_score":-2.43582,"pct_ad":0.529805,"pct_control":0.543088,"donor_test":"not significant","donor_padj":0.57914,"donor_log2fc":-0.121677,"donor_lfcse":0.0774675,"donor_log2fc_shrunk":-0.0400653,"degas_log2fc":0.0427311,"degas_padj":0.213676},{"cell_type":"OPC","gene_symbol":"TRPC4AP","gene_symbol_current":"TRPC4AP","gene_id":"ENSG00000100991","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000872935,"nucleus_log2fc":-0.133809,"nucleus_score":-3.83652,"pct_ad":0.565911,"pct_control":0.591194,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0567465,"donor_lfcse":0.0693559,"donor_log2fc_shrunk":-1.21537e-05,"degas_log2fc":-0.352153,"degas_padj":1.55348e-25},{"cell_type":"Oli","gene_symbol":"TRPC4AP","gene_symbol_current":"TRPC4AP","gene_id":"ENSG00000100991","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.57971e-38,"nucleus_log2fc":-0.16745,"nucleus_score":-13.1417,"pct_ad":0.692712,"pct_control":0.731876,"donor_test":"not significant","donor_padj":0.767311,"donor_log2fc":-0.10664,"donor_lfcse":0.0780993,"donor_log2fc_shrunk":-0.0169326,"degas_log2fc":-0.22867,"degas_padj":5.1374e-72}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000100991","module":"blue","kme":0.169871,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000100991","module":"blue","kme":0.214649,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100991","entrez_id":["26133"],"uniprot":["Q8TEL6"],"ncbi_summary":"Enables phosphatase binding activity and ubiquitin ligase-substrate adaptor activity. Involved in protein ubiquitination and ubiquitin-dependent protein catabolic process via the C-end degron rule pathway. Part of Cul4A-RING E3 ubiquitin ligase complex. Is active in Cul4-RING E3 ubiquitin ligase complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TEL6","text":"Substrate-recognition component of a DCX (DDB1-CUL4-X-box) E3 ubiquitin-protein ligase complex required for cell cycle control (PubMed:20551172, PubMed:29779948). The DCX(TRPC4AP) complex specifically mediates the polyubiquitination and subsequent degradation of MYC as part of the DesCEND (destruction via C-end degrons) pathway (PubMed:20551172, PubMed:29779948). The DesCEND (destruction via C-end degrons) pathway recognizes a C-degron located at the extreme C terminus of target proteins, leading to their ubiquitination and degradation (PubMed:29779948). The DCX(TRPC4AP) complex specifically recognizes proteins with an arginine at the minus 3 position (R-3 motif) at the C-terminus, such as MYC, leading to their ubiquitination and degradation (PubMed:29779948). Also participates in the activation of NFKB1 in response to ligation of TNFRSF1A, possibly by linking TNFRSF1A to the IKK signalosome (By similarity). Involved in JNK activation via its interaction with TRAF2 (By similarity). Also involved in elevation of endoplasmic reticulum Ca(2+) storage reduction in response to CHRM1 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}