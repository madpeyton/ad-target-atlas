dj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.115533,"donor_lfcse":0.183039,"donor_log2fc_shrunk":3.59365e-06},{"cell_type":"Oli","gene_symbol":"THAP1","gene_symbol_current":"THAP1","gene_id":"ENSG00000131931","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.605274,"donor_log2fc":0.273604,"donor_lfcse":0.136277,"donor_log2fc_shrunk":0.017617}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000131931","entrez_id":["55145"],"uniprot":["Q9NVV9"],"ncbi_summary":"The protein encoded by this gene contains a THAP domain, a conserved DNA-binding domain. This protein colocalizes with the apoptosis response protein PAWR/PAR-4 in promyelocytic leukemia (PML) nuclear bodies, and functions as a proapoptotic factor that links PAWR to PML nuclear bodies. Alternatively spliced transcript variants encoding distinct isoforms have been observed. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NVV9","text":"DNA-binding transcription regulator that regulates endothelial cell proliferation and G1/S cell-cycle progression. Specifically binds the 5'-[AT]NTNN[GT]GGCA[AGT]-3' core DNA sequence and acts by modulating expression of pRB-E2F cell-cycle target genes, including RRM1. Component of a THAP1/THAP3-HCFC1-OGT complex that is required for the regulation of the transcriptional activity of RRM1. May also have pro-apoptotic activity by potentiating both serum-withdrawal and TNF-induced apoptosis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}