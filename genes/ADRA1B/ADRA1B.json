":4.24339,"pct_ad":0.226324,"pct_control":0.213495,"donor_test":"not significant","donor_padj":0.968186,"donor_log2fc":0.00987247,"donor_lfcse":0.0907358,"donor_log2fc_shrunk":0.00191388},{"cell_type":"Inhibitory","gene_symbol":"ADRA1B","gene_symbol_current":"ADRA1B","gene_id":"ENSG00000170214","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0959881,"nucleus_log2fc":0.040631,"nucleus_score":1.93193,"pct_ad":0.214197,"pct_control":0.208878,"donor_test":"not significant","donor_padj":0.836051,"donor_log2fc":0.0428969,"donor_lfcse":0.074895,"donor_log2fc_shrunk":0.00541984},{"cell_type":"Oligodendroglia","gene_symbol":"ADRA1B","gene_symbol_current":"ADRA1B","gene_id":"ENSG00000170214","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"significant","donor_padj":0.022165,"donor_log2fc":0.391671,"donor_lfcse":0.107497,"donor_log2fc_shrunk":0.321665}],"modules":[{"cell_type":"Astrocytes","gene_id":"ENSG00000170214","module":"blue","kme":0.0924982,"hub":false,"module_direction":"higher in AD","module_padj":0.903036,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000170214","module":"green","kme":0.307816,"hub":false,"module_direction":"lower in AD","module_padj":0.91549,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000170214","module":"blue","kme":0.519994,"hub":false,"module_direction":"higher in AD","module_padj":0.851077,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000170214"],"dataset_symbols":["ADRA1B"],"explorer":"explorer.html?dataset=mathys2019#gene/ADRA1B","cell_types":[{"cell_type":"Ex","gene_symbol":"ADRA1B","gene_symbol_current":"ADRA1B","gene_id":"ENSG00000170214","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.986262,"donor_log2fc":0.0983273,"donor_lfcse":0.219753,"donor_log2fc_shrunk":-3.37507e-07},{"cell_type":"In","gene_symbol":"ADRA1B","gene_symbol_current":"ADRA1B","gene_id":"ENSG00000170214","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.243414,"donor_lfcse":0.170631,"donor_log2fc_shrunk":8.55958e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000170214","module":"blue","kme":0.277259,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000170214","entrez_id":["147"],"uniprot":["P35368"],"ncbi_summary":"Alpha-1-adrenergic receptors (alpha-1-ARs) are members of the G protein-coupled receptor superfamily. They activate mitogenic responses and regulate growth and proliferation of many cells. There are 3 alpha-1-AR subtypes: alpha-1A, -1B and -1D, all of which signal through the Gq/11 family of G-proteins and different subtypes show different patterns of activation. This gene encodes alpha-1B-adrenergic receptor, which induces neoplastic transformation when transfected into NIH 3T3 fibroblasts and other cell lines. Thus, this normal cellular gene is identified as a protooncogene. This gene comprises 2 exons and a single large intron of at least 20 kb that interrupts the coding region. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P35368","text":"Alpha-1 adrenergic receptors are G protein-coupled receptors for catecholamines that signal through the G(q) family of G proteins, including G(q) and G(11). Upon activation, they stimulate the phosphatidylinositol-calcium second messenger pathway, leading to calcium release from intracellular stores and activation of protein kinase C (By similarity). ADRA1B binds the catecholamine ligands norepinephrine and epinephrine (PubMed:7815325, PubMed:8183249). Can also couple to G(14) and G(16) proteins (By similarity). Nuclear ADRA1B forms heterooligomers with ADRA1A to regulate phenylephrine(PE)-stimulated ERK signaling in cardiac myocytes (PubMed:18802028, PubMed:22120526). At the plasma membrane, ADRA1B interacts with CAVIN4/MURC to regulates ERK activation in cardiomyocytes, contributing to the regulation of cardiac hypertrophy (PubMed:24567387)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}