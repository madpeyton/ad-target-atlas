eus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.435979,"nucleus_log2fc":0.0174539,"nucleus_score":-0.81142,"pct_ad":0.40159,"pct_control":0.408306,"donor_test":"not significant","donor_padj":0.933445,"donor_log2fc":0.0465333,"donor_lfcse":0.166031,"donor_log2fc_shrunk":0.00196106,"degas_log2fc":-0.0444656,"degas_padj":1.59894e-06},{"cell_type":"In","gene_symbol":"ADRA1B","gene_symbol_current":"ADRA1B","gene_id":"ENSG00000170214","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.30263e-38,"nucleus_log2fc":-0.167034,"nucleus_score":-13.0727,"pct_ad":0.27528,"pct_control":0.303486,"donor_test":"not significant","donor_padj":0.943078,"donor_log2fc":-0.0391984,"donor_lfcse":0.132505,"donor_log2fc_shrunk":-0.00119686,"degas_log2fc":0.34083,"degas_padj":3.35842e-122},{"cell_type":"Mic","gene_symbol":"ADRA1B","gene_symbol_current":"ADRA1B","gene_id":"ENSG00000170214","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.725894,"donor_log2fc":-0.310412,"donor_lfcse":0.272221,"donor_log2fc_shrunk":-0.0089228,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"ADRA1B","gene_symbol_current":"ADRA1B","gene_id":"ENSG00000170214","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.995512,"donor_log2fc":0.00667992,"donor_lfcse":0.201834,"donor_log2fc_shrunk":0.000189597,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000170214","module":"blue","kme":0.137884,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000170214","module":"blue","kme":0.632272,"hub":true,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000170214","entrez_id":["147"],"uniprot":["P35368"],"ncbi_summary":"Alpha-1-adrenergic receptors (alpha-1-ARs) are members of the G protein-coupled receptor superfamily. They activate mitogenic responses and regulate growth and proliferation of many cells. There are 3 alpha-1-AR subtypes: alpha-1A, -1B and -1D, all of which signal through the Gq/11 family of G-proteins and different subtypes show different patterns of activation. This gene encodes alpha-1B-adrenergic receptor, which induces neoplastic transformation when transfected into NIH 3T3 fibroblasts and other cell lines. Thus, this normal cellular gene is identified as a protooncogene. This gene comprises 2 exons and a single large intron of at least 20 kb that interrupts the coding region. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P35368","text":"Alpha-1 adrenergic receptors are G protein-coupled receptors for catecholamines that signal through the G(q) family of G proteins, including G(q) and G(11). Upon activation, they stimulate the phosphatidylinositol-calcium second messenger pathway, leading to calcium release from intracellular stores and activation of protein kinase C (By similarity). ADRA1B binds the catecholamine ligands norepinephrine and epinephrine (PubMed:7815325, PubMed:8183249). Can also couple to G(14) and G(16) proteins (By similarity). Nuclear ADRA1B forms heterooligomers with ADRA1A to regulate phenylephrine(PE)-stimulated ERK signaling in cardiac myocytes (PubMed:18802028, PubMed:22120526). At the plasma membrane, ADRA1B interacts with CAVIN4/MURC to regulates ERK activation in cardiomyocytes, contributing to the regulation of cardiac hypertrophy (PubMed:24567387)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}