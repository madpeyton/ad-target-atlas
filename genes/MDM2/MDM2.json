0220734,"degas_padj":0.0105531},{"cell_type":"Mic","gene_symbol":"MDM2","gene_symbol_current":"MDM2","gene_id":"ENSG00000135679","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.710237,"nucleus_log2fc":0.00510858,"nucleus_score":0.481646,"pct_ad":0.450604,"pct_control":0.443203,"donor_test":"not significant","donor_padj":0.958725,"donor_log2fc":0.0277712,"donor_lfcse":0.101021,"donor_log2fc_shrunk":0.00490616,"degas_log2fc":0.36994,"degas_padj":7.01022e-27},{"cell_type":"OPC","gene_symbol":"MDM2","gene_symbol_current":"MDM2","gene_id":"ENSG00000135679","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.387187,"nucleus_log2fc":0.0323008,"nucleus_score":1.17895,"pct_ad":0.425738,"pct_control":0.413887,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0112986,"donor_lfcse":0.070507,"donor_log2fc_shrunk":-2.34878e-06,"degas_log2fc":-0.198231,"degas_padj":2.6622e-06},{"cell_type":"Oli","gene_symbol":"MDM2","gene_symbol_current":"MDM2","gene_id":"ENSG00000135679","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.827302,"nucleus_log2fc":0.00572227,"nucleus_score":-0.254756,"pct_ad":0.418123,"pct_control":0.421828,"donor_test":"not significant","donor_padj":0.921559,"donor_log2fc":0.0437874,"donor_lfcse":0.068227,"donor_log2fc_shrunk":0.00863992,"degas_log2fc":-0.143538,"degas_padj":8.76856e-16}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000135679","entrez_id":["4193"],"uniprot":["Q00987"],"ncbi_summary":"This gene encodes a nuclear-localized E3 ubiquitin ligase. The encoded protein can promote tumor formation by targeting tumor suppressor proteins, such as p53, for proteasomal degradation. This gene is itself transcriptionally-regulated by p53. Overexpression or amplification of this locus is detected in a variety of different cancers. There is a pseudogene for this gene on chromosome 2. Alternative splicing results in a multitude of transcript variants, many of which may be expressed only in tumor cells. [provided by RefSeq, Jun 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q00987","text":"E3 ubiquitin-protein ligase that mediates ubiquitination of p53/TP53, leading to its degradation by the proteasome (PubMed:29681526, PubMed:21317885). Inhibits p53/TP53- and p73/TP73-mediated cell cycle arrest and apoptosis by binding its transcriptional activation domain. Also acts as a ubiquitin ligase E3 toward itself and ARRB1. Permits the nuclear export of p53/TP53. Promotes proteasome-dependent ubiquitin-independent degradation of retinoblastoma RB1 protein. Inhibits DAXX-mediated apoptosis by inducing its ubiquitination and degradation. Component of the TRIM28/KAP1-MDM2-p53/TP53 complex involved in stabilizing p53/TP53. Also a component of the TRIM28/KAP1-ERBB4-MDM2 complex which links growth factor and DNA damage response pathways. Mediates ubiquitination and subsequent proteasome degradation of DYRK2 in nucleus. Ubiquitinates IGF1R and SNAI1 and promotes them to proteasomal degradation (PubMed:12821780, PubMed:15053880, PubMed:15195100, PubMed:15632057, PubMed:16337594, PubMed:17290220, PubMed:19098711, PubMed:19219073, PubMed:19837670, PubMed:19965871, PubMed:20173098, PubMed:20385133, PubMed:20858735, PubMed:22128911). Ubiquitinates DCX, leading to DCX degradation and reduction of the dendritic spine density of olfactory bulb granule cells (By similarity). Ubiquitinates DLG4, leading to proteasomal degradation of DLG4 which is required for AMPA receptor endocytosis (By similarity). Negatively regulates NDUFS1, leading to decreased mitochondrial respiration, marked oxidative stress, and commitment to the mitochondrial pathway of apoptosis (PubMed:30879903). Binds NDUFS1 leading to its cytosolic retention rather than mitochondrial localization resulting in decreased supercomplex assembly (interactions between complex I and complex III), decreased complex I activity, ROS production, and apoptosis (PubMed:30879903)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}