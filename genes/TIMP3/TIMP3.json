7,"donor_lfcse":0.302957,"donor_log2fc_shrunk":-0.00233348},{"cell_type":"In","gene_symbol":"TIMP3","gene_symbol_current":"TIMP3","gene_id":"ENSG00000100234","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.08951e-73,"nucleus_log2fc":-0.248448,"nucleus_score":-18.2531,"pct_ad":0.255024,"pct_control":0.292423,"donor_test":"not significant","donor_padj":0.829915,"donor_log2fc":-0.175928,"donor_lfcse":0.218433,"donor_log2fc_shrunk":-0.00184647},{"cell_type":"Mic","gene_symbol":"TIMP3","gene_symbol_current":"TIMP3","gene_id":"ENSG00000100234","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.411394,"donor_log2fc":-0.585694,"donor_lfcse":0.276428,"donor_log2fc_shrunk":-0.0166781},{"cell_type":"OPC","gene_symbol":"TIMP3","gene_symbol_current":"TIMP3","gene_id":"ENSG00000100234","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.194257,"nucleus_log2fc":0.0847668,"nucleus_score":1.68938,"pct_ad":0.543692,"pct_control":0.53243,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.142863,"donor_lfcse":0.219723,"donor_log2fc_shrunk":2.86289e-06},{"cell_type":"Oli","gene_symbol":"TIMP3","gene_symbol_current":"TIMP3","gene_id":"ENSG00000100234","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.783318,"donor_log2fc":-0.33535,"donor_lfcse":0.255672,"donor_log2fc_shrunk":-0.00584945}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000100234","module":"turquoise","kme":0.586084,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000100234","module":"turquoise","kme":0.434366,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000100234","module":"blue","kme":0.125477,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100234","entrez_id":["7078"],"uniprot":["P35625"],"ncbi_summary":"This gene belongs to the TIMP gene family. The proteins encoded by this gene family are inhibitors of the matrix metalloproteinases, a group of peptidases involved in degradation of the extracellular matrix (ECM). Expression of this gene is induced in response to mitogenic stimulation and this netrin domain-containing protein is localized to the ECM. Mutations in this gene have been associated with the autosomal dominant disorder Sorsby's fundus dystrophy. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P35625","text":"Mediates a variety of processes including matrix regulation and turnover, inflammation, and angiogenesis, through reversible inhibition of zinc protease superfamily enzymes, primarily matrix metalloproteinases (MMPs). Regulates extracellular matrix (ECM) remodeling through inhibition of matrix metalloproteinases (MMP) including MMP-1, MMP-2, MMP-3, MMP-7, MMP-9, MMP-13, MMP-14 and MMP-15. Additionally, modulates the processing of amyloid precursor protein (APP) and apolipoprotein E receptor ApoER2 by inhibiting two alpha-secretases ADAM10 and ADAM17 (PubMed:17913923). Functions as a tumor suppressor and a potent inhibitor of angiogenesis. Exerts its anti-angiogenic effect by directly interacting with vascular endothelial growth factor (VEGF) receptor-2/KDR, preventing its binding to the VEGFA ligand (PubMed:12652295). Selectively induces apoptosis in angiogenic endothelial cells through a caspase-independent cell death pathway (PubMed:25558000). Mechanistically, inhibits matrix-induced focal adhesion kinase PTK2 tyrosine phosphorylation and association with paxillin/PXN and disrupts the incorporation of ITGB3, PTK2 and PXN into focal adhesion contacts on the matrix (PubMed:25558000)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}