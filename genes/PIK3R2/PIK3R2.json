fc_shrunk":0.0114281},{"cell_type":"Mic","gene_symbol":"PIK3R2","gene_symbol_current":"PIK3R2","gene_id":"ENSG00000105647","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.997529,"donor_log2fc":0.00144367,"donor_lfcse":0.108073,"donor_log2fc_shrunk":0.000172945},{"cell_type":"OPC","gene_symbol":"PIK3R2","gene_symbol_current":"PIK3R2","gene_id":"ENSG00000105647","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.839895,"nucleus_log2fc":0.0235421,"nucleus_score":0.320545,"pct_ad":0.155383,"pct_control":0.152752,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0553543,"donor_lfcse":0.089597,"donor_log2fc_shrunk":-4.51112e-05},{"cell_type":"Oli","gene_symbol":"PIK3R2","gene_symbol_current":"PIK3R2","gene_id":"ENSG00000105647","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.572042,"donor_log2fc":0.143587,"donor_lfcse":0.0684011,"donor_log2fc_shrunk":0.0440334}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000105647","module":"red","kme":0.168411,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000105647","entrez_id":["5296"],"uniprot":["O00459"],"ncbi_summary":"Phosphatidylinositol 3-kinase (PI3K) is a lipid kinase that phosphorylates phosphatidylinositol and similar compounds, creating second messengers important in growth signaling pathways. PI3K functions as a heterodimer of a regulatory and a catalytic subunit. The protein encoded by this gene is a regulatory component of PI3K. Three transcript variants, one protein coding and the other two non-protein coding, have been found for this gene. [provided by RefSeq, Apr 2019].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00459","text":"Regulatory subunit of phosphoinositide-3-kinase (PI3K), a kinase that phosphorylates PtdIns(4,5)P2 (Phosphatidylinositol 4,5-bisphosphate) to generate phosphatidylinositol 3,4,5-trisphosphate (PIP3). PIP3 plays a key role by recruiting PH domain-containing proteins to the membrane, including AKT1 and PDPK1, activating signaling cascades involved in cell growth, survival, proliferation, motility and morphology. Binds to activated (phosphorylated) protein-tyrosine kinases, through its SH2 domain, and acts as an adapter, mediating the association of the p110 catalytic unit to the plasma membrane. Indirectly regulates autophagy (PubMed:23604317). Promotes nuclear translocation of XBP1 isoform 2 in a ER stress- and/or insulin-dependent manner during metabolic overloading in the liver and hence plays a role in glucose tolerance improvement (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}