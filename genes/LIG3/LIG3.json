cleus_direction":"lower in AD","nucleus_padj":0.175729,"nucleus_log2fc":-0.156295,"nucleus_score":-1.75335,"pct_ad":0.104086,"pct_control":0.113463,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.165993,"donor_lfcse":0.138329,"donor_log2fc_shrunk":-8.95437e-06},{"cell_type":"Oli","gene_symbol":"LIG3","gene_symbol_current":"LIG3","gene_id":"ENSG00000005156","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.941143,"donor_log2fc":0.0408713,"donor_lfcse":0.0849321,"donor_log2fc_shrunk":0.00557774}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000005156","module":"turquoise","kme":0.0540128,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000005156","entrez_id":["3980"],"uniprot":["P49916"],"ncbi_summary":"This gene is a member of the DNA ligase family. Each member of this family encodes a protein that catalyzes the joining of DNA ends but they each have a distinct role in DNA metabolism. The protein encoded by this gene is involved in excision repair and is located in both the mitochondria and nucleus, with translation initiation from the upstream start codon allowing for transport to the mitochondria and translation initiation from a downstream start codon allowing for transport to the nucleus. Additionally, alternate transcriptional splice variants, encoding different isoforms, have been characterized. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49916","text":"Isoform 3 functions as a heterodimer with DNA-repair protein XRCC1 in the nucleus and can correct defective DNA strand-break repair and sister chromatid exchange following treatment with ionizing radiation and alkylating agents. Isoform 1 is targeted to mitochondria, where it functions as a DNA ligase in mitochondrial base-excision DNA repair (PubMed:10207110, PubMed:24674627)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}