0.476235,"nucleus_log2fc":-0.0709091,"nucleus_score":-0.993655,"pct_ad":0.185356,"pct_control":0.191363,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0314353,"donor_lfcse":0.0764545,"donor_log2fc_shrunk":-5.53606e-06,"degas_log2fc":-0.0730194,"degas_padj":0.291094},{"cell_type":"Oli","gene_symbol":"OAZ2","gene_symbol_current":"OAZ2","gene_id":"ENSG00000180304","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.901317,"nucleus_log2fc":-0.00975852,"nucleus_score":0.146235,"pct_ad":0.216731,"pct_control":0.215325,"donor_test":"not significant","donor_padj":0.979827,"donor_log2fc":0.011245,"donor_lfcse":0.0663303,"donor_log2fc_shrunk":0.00241298,"degas_log2fc":-0.138822,"degas_padj":4.97031e-08}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000180304","module":"brown","kme":0.189379,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000180304","module":"turquoise","kme":0.0114361,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000180304","entrez_id":["4947"],"uniprot":["O95190"],"ncbi_summary":"The protein encoded by this gene belongs to the ornithine decarboxylase antizyme family, which plays a role in cell growth and proliferation by regulating intracellular polyamines. Expression of antizymes requires +1 ribosomal frameshifting, which is enhanced by high levels of polyamines. Antizymes in turn bind to and inhibit ornithine decarboxylase (ODC), the key enzyme in polyamine biosynthesis; thus, completing the auto-regulatory circuit. This gene encodes antizyme 2, the second member of the antizyme family. Like antizyme 1, antizyme 2 has broad tissue distribution, inhibits ODC activity and polyamine uptake, and stimulates ODC degradation in vivo; however, it fails to promote ODC degradation in vitro. Antizyme 2 is expressed at lower levels than antizyme 1, but is evolutionary more conserved, suggesting it likely has an important biological role. Studies also show different subcellular localization of antizymes 1 and 2, indicating specific function for each antizyme in discrete compartments of the cell. Alternatively spliced transcript variants have been found for this gene. [provided by RefSeq, Dec 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95190","text":"Ornithine decarboxylase (ODC) antizyme protein that negatively regulates ODC activity and intracellular polyamine biosynthesis and uptake in response to increased intracellular polyamine levels. Binds to ODC monomers, inhibiting the assembly of the functional ODC homodimers. Does not target the ODC monomers for degradation, which allows a protein synthesis-independent restoration of ODC activity (PubMed:17900240). Involved in the translocation of AZIN2 from ER-Golgi intermediate compartment (ERGIC) to the cytosol (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}