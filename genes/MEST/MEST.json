ignificant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.1075e-18,"nucleus_log2fc":-0.324845,"nucleus_score":-9.14283,"pct_ad":0.284132,"pct_control":0.339528,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.160885,"donor_lfcse":0.118582,"donor_log2fc_shrunk":-1.19367e-05},{"cell_type":"In","gene_symbol":"MEST","gene_symbol_current":"MEST","gene_id":"ENSG00000106484","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.92028,"nucleus_log2fc":-0.0193697,"nucleus_score":0.326888,"pct_ad":0.152174,"pct_control":0.146903,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.00659162,"donor_lfcse":0.13982,"donor_log2fc_shrunk":-2.13694e-07}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000106484","module":"turquoise","kme":0.133108,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000106484","entrez_id":["4232"],"uniprot":["Q5EB52"],"ncbi_summary":"This gene encodes a member of the alpha/beta hydrolase superfamily. It is imprinted, exhibiting preferential expression from the paternal allele in fetal tissues, and isoform-specific imprinting in lymphocytes. The loss of imprinting of this gene has been linked to certain types of cancer and may be due to promotor switching. The encoded protein may play a role in development. Alternatively spliced transcript variants encoding multiple isoforms have been identified for this gene. Pseudogenes of this gene are located on the short arm of chromosomes 3 and 4, and the long arm of chromosomes 6 and 15. [provided by RefSeq, Dec 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5EB52","text":"Plays an important role in enabling neurons to transition from bipolar to multipolar shapes, a process essential for their correct migration toward the cortical plate during brain development. This function is likely achieved through the regulation of N-cadherin-dependent cell adhesion and the modulation of Akt and canonical Wnt signaling pathways. Essential for the development and maintenance of meso-diencephalic dopaminergic (mdDA) neurons during development. Negatively regulates the canonical Wnt signaling pathway during adipogenic differentiation by reducing the glycosylation, maturation, and cell membrane localization of the Wnt coreceptor LRP6."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}