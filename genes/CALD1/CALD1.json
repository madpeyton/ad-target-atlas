"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.16637e-12,"nucleus_log2fc":0.103611,"nucleus_score":7.18318,"pct_ad":0.609694,"pct_control":0.59742,"donor_test":"not significant","donor_padj":0.941995,"donor_log2fc":0.0376714,"donor_lfcse":0.0797471,"donor_log2fc_shrunk":0.00584966}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000122786","module":"turquoise","kme":0.0692705,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000122786","module":"cyan","kme":0.222753,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000122786","module":"turquoise","kme":0.00680373,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000122786","entrez_id":["800"],"uniprot":["Q05682"],"ncbi_summary":"This gene encodes a calmodulin- and actin-binding protein that plays an essential role in the regulation of smooth muscle and nonmuscle contraction. The conserved domain of this protein possesses the binding activities to Ca(2+)-calmodulin, actin, tropomyosin, myosin, and phospholipids. This protein is a potent inhibitor of the actin-tropomyosin activated myosin MgATPase, and serves as a mediating factor for Ca(2+)-dependent inhibition of smooth muscle contraction. Alternative splicing of this gene results in multiple transcript variants encoding distinct isoforms. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q05682","text":"Actin- and myosin-binding protein implicated in the regulation of actomyosin interactions in smooth muscle and nonmuscle cells (could act as a bridge between myosin and actin filaments). Stimulates actin binding of tropomyosin which increases the stabilization of actin filament structure. In muscle tissues, inhibits the actomyosin ATPase by binding to F-actin. This inhibition is attenuated by calcium-calmodulin and is potentiated by tropomyosin. Interacts with actin, myosin, two molecules of tropomyosin and with calmodulin. Also plays an essential role during cellular mitosis and receptor capping. Involved in Schwann cell migration during peripheral nerve regeneration (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}