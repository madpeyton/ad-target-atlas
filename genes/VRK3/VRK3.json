0.0434496,"donor_log2fc_shrunk":-0.0338202,"degas_log2fc":-0.0451762,"degas_padj":0.000929917},{"cell_type":"Mic","gene_symbol":"VRK3","gene_symbol_current":"VRK3","gene_id":"ENSG00000105053","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.73532,"nucleus_log2fc":0.0100071,"nucleus_score":0.438507,"pct_ad":0.140297,"pct_control":0.137788,"donor_test":"not significant","donor_padj":0.981381,"donor_log2fc":0.011429,"donor_lfcse":0.0845204,"donor_log2fc_shrunk":0.00244075,"degas_log2fc":0.152016,"degas_padj":0.0210388},{"cell_type":"OPC","gene_symbol":"VRK3","gene_symbol_current":"VRK3","gene_id":"ENSG00000105053","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.49959,"nucleus_log2fc":-0.100877,"nucleus_score":-0.947605,"pct_ad":0.154787,"pct_control":0.159356,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0669338,"donor_lfcse":0.0941361,"donor_log2fc_shrunk":-7.84938e-06,"degas_log2fc":-0.401634,"degas_padj":3.35842e-08},{"cell_type":"Oli","gene_symbol":"VRK3","gene_symbol_current":"VRK3","gene_id":"ENSG00000105053","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0837782,"nucleus_log2fc":0.040084,"nucleus_score":1.85298,"pct_ad":0.166094,"pct_control":0.160223,"donor_test":"not significant","donor_padj":0.867386,"donor_log2fc":0.0853442,"donor_lfcse":0.0921404,"donor_log2fc_shrunk":0.00999039,"degas_log2fc":-0.186489,"degas_padj":2.20588e-10}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000105053","module":"blue","kme":0.0945059,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000105053","entrez_id":["51231"],"uniprot":["Q8IV63"],"ncbi_summary":"This gene encodes a member of the vaccinia-related kinase (VRK) family of serine/threonine protein kinases. In both human and mouse, this gene has substitutions at several residues within the ATP binding motifs that in other kinases have been shown to be required for catalysis. In vitro assays indicate the protein lacks phosphorylation activity. The protein, however, likely retains its substrate binding capability. This gene is widely expressed in human tissues and its protein localizes to the nucleus. Alternative splicing results in multiple transcripts encoding different isoforms. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IV63","text":"Plays a role in the regulation of the cell cycle by phosphorylating the nuclear envelope protein barrier-to-autointegration factor/BAF that is required for disassembly and reassembly, respectively, of the nuclear envelope during mitosis (PubMed:25899223). Under normal physiological conditions, negatively regulates ERK activity along with VHR/DUSP3 phosphatase in the nucleus, causing timely and transient action of ERK. Stress conditions activate CDK5 which phosphorylates VRK3 to increase VHR phosphatase activity and suppress prolonged ERK activation that causes cell death (PubMed:27346674). For example, upon glutamate induction, promotes nuclear localization of HSP70/HSPA1A to inhibit ERK activation via VHR/DUSP3 phosphatase (PubMed:27941812)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}