,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000204356","module":"turquoise","kme":0.0888072,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000204356","module":"black","kme":0.186245,"hub":false,"module_direction":"higher in AD","module_padj":0.104801,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000204356"],"dataset_symbols":["NELFE"],"explorer":"explorer.html?dataset=mathys2019#gene/NELFE","cell_types":[{"cell_type":"Ex","gene_symbol":"NELFE","gene_symbol_current":"NELFE","gene_id":"ENSG00000204356","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.356146,"nucleus_log2fc":-0.0823936,"nucleus_score":-1.07177,"pct_ad":0.119057,"pct_control":0.122827,"donor_test":"not significant","donor_padj":0.998051,"donor_log2fc":0.0103177,"donor_lfcse":0.102403,"donor_log2fc_shrunk":1.03952e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000204356","entrez_id":["7936"],"uniprot":["P18615"],"ncbi_summary":"The protein encoded by this gene is part of a complex termed negative elongation factor (NELF) which represses RNA polymerase II transcript elongation. This protein bears similarity to nuclear RNA-binding proteins; however, it has not been demonstrated that this protein binds RNA. The protein contains a tract of alternating basic and acidic residues, largely arginine (R) and aspartic acid (D). The gene localizes to the major histocompatibility complex (MHC) class III region on chromosome 6. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P18615","text":"Essential component of the NELF complex, a complex that negatively regulates the elongation of transcription by RNA polymerase II (PubMed:10199401, PubMed:27256882). The NELF complex, which acts via an association with the DSIF complex and causes transcriptional pausing, is counteracted by the P-TEFb kinase complex (PubMed:11940650, PubMed:12612062, PubMed:27256882). Provides the strongest RNA binding activity of the NELF complex and may initially recruit the NELF complex to RNA (PubMed:18303858, PubMed:27256882, PubMed:27282391). (Microbial infection) The NELF complex is involved in HIV-1 latency possibly involving recruitment of PCF11 to paused RNA polymerase II."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}