g2fc":-0.0395223,"nucleus_score":-6.37341,"pct_ad":0.447462,"pct_control":0.466832,"donor_test":"not significant","donor_padj":0.947484,"donor_log2fc":0.00914823,"donor_lfcse":0.040176,"donor_log2fc_shrunk":0.0038262,"degas_log2fc":0.0394734,"degas_padj":2.62808e-06},{"cell_type":"In","gene_symbol":"SELENON","gene_symbol_current":"SELENON","gene_id":"ENSG00000162430","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":7.62998e-32,"nucleus_log2fc":-0.141723,"nucleus_score":-11.8611,"pct_ad":0.234808,"pct_control":0.259719,"donor_test":"not significant","donor_padj":0.70069,"donor_log2fc":-0.0819319,"donor_lfcse":0.0440677,"donor_log2fc_shrunk":-0.0221457,"degas_log2fc":0.0759075,"degas_padj":6.12713e-07},{"cell_type":"Mic","gene_symbol":"SELENON","gene_symbol_current":"SELENON","gene_id":"ENSG00000162430","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.534319,"nucleus_log2fc":0.0359008,"nucleus_score":0.774421,"pct_ad":0.110214,"pct_control":0.106567,"donor_test":"not significant","donor_padj":0.968275,"donor_log2fc":-0.0210666,"donor_lfcse":0.0925345,"donor_log2fc_shrunk":-0.0046546,"degas_log2fc":-0.00810514,"degas_padj":0.930456},{"cell_type":"OPC","gene_symbol":"SELENON","gene_symbol_current":"SELENON","gene_id":"ENSG00000162430","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.550338,"nucleus_log2fc":-0.0387429,"nucleus_score":-0.850532,"pct_ad":0.196988,"pct_control":0.20271,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0378817,"donor_lfcse":0.111325,"donor_log2fc_shrunk":-3.15498e-06,"degas_log2fc":0.102586,"degas_padj":0.12384},{"cell_type":"Oli","gene_symbol":"SELENON","gene_symbol_current":"SELENON","gene_id":"ENSG00000162430","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.77604,"donor_log2fc":0.117125,"donor_lfcse":0.0878239,"donor_log2fc_shrunk":0.0161052,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000162430","module":"red","kme":0.0952749,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000162430","module":"turquoise","kme":0.0433554,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000162430","entrez_id":["57190"],"uniprot":["Q9NZV5"],"ncbi_summary":"This gene encodes a glycoprotein that is localized in the endoplasmic reticulum. It plays an important role in cell protection against oxidative stress, and in the regulation of redox-related calcium homeostasis. Mutations in this gene are associated with early onset muscle disorders, referred to as SEPN1-related myopathy. SEPN1-related myopathy consists of 4 autosomal recessive disorders, originally thought to be separate entities: rigid spine muscular dystrophy (RSMD1), the classical form of multiminicore disease, desmin related myopathy with Mallory-body like inclusions, and congenital fiber-type disproportion (CFTD). This protein is a selenoprotein, containing the rare amino acid selenocysteine (Sec). Sec is encoded by the UGA codon, which normally signals translation termination. The 3' UTRs of selenoprotein mRNAs contain a conserved stem-loop structure, designated the Sec insertion sequence (SECIS) element, that is necessary for the recognition of UGA as a Sec codon, rather than as a stop signal. A second stop-codon redefinition element (SRE) adjacent to the UGA codon has been identified in this gene (PMID:15791204). SRE is a phylogenetically conserved stem-loop structure that stimulates readthrough at the UGA codon, and augments the Sec insertion efficiency by SECIS. Alternatively spliced transcript variants have been found for this gene. [provided by RefSeq, Dec 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NZV5","text":"[Isoform 2]: Plays an important role in cell protection against oxidative stress and in the regulation of redox-related calcium homeostasis. Regulates the calcium level of the ER by protecting the calcium pump ATP2A2 against the oxidoreductase ERO1A-mediated oxidative damage. Within the ER, ERO1A activity increases the concentration of H(2)O(2), which attacks the luminal thiols in ATP2A2 and thus leads to cysteinyl sulfenic acid formation (-SOH) and SEPN1 reduces the SOH back to free thiol (-SH), thus restoring ATP2A2 activity (PubMed:25452428). Acts as a modulator of ryanodine receptor (RyR) activity: protects RyR from oxidation due to increased oxidative stress, or directly controls the RyR redox state, regulating the RyR-mediated calcium mobilization required for normal muscle development and differentiation (PubMed:18713863, PubMed:19557870). Essential for muscle regeneration and satellite cell maintenance in skeletal muscle (PubMed:21131290)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}