cleus_score":-3.3255,"pct_ad":0.0808477,"pct_control":0.121073,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000008394","module":"pink","kme":0.332458,"hub":true,"module_direction":"lower in AD","module_padj":0.923706,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000008394","module":"black","kme":0.284845,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000008394","module":"turquoise","kme":0.142712,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000008394","entrez_id":["4257"],"uniprot":["P10620"],"ncbi_summary":"The MAPEG (Membrane Associated Proteins in Eicosanoid and Glutathione metabolism) family consists of six human proteins, two of which are involved in the production of leukotrienes and prostaglandin E, important mediators of inflammation. Other family members, demonstrating glutathione S-transferase and peroxidase activities, are involved in cellular defense against toxic, carcinogenic, and pharmacologically active electrophilic compounds. This gene encodes a protein that catalyzes the conjugation of glutathione to electrophiles and the reduction of lipid hydroperoxides. This protein is localized to the endoplasmic reticulum and outer mitochondrial membrane where it is thought to protect these membranes from oxidative stress. Several transcript variants, some non-protein coding and some protein coding, have been found for this gene. [provided by RefSeq, May 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P10620","text":"Conjugation of reduced glutathione to a wide number of exogenous and endogenous hydrophobic electrophiles."}],"uniprot_source":"UniProtKB/Swiss-Prot Func