dule_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000244038"],"dataset_symbols":["DDOST"],"explorer":"explorer.html?dataset=mathys2019#gene/DDOST","cell_types":[{"cell_type":"Ex","gene_symbol":"DDOST","gene_symbol_current":"DDOST","gene_id":"ENSG00000244038","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000415388,"nucleus_log2fc":-0.232671,"nucleus_score":-3.81273,"pct_ad":0.143133,"pct_control":0.159994,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.104193,"donor_lfcse":0.14,"donor_log2fc_shrunk":-5.21551e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000244038","module":"turquoise","kme":0.18585,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000244038","module":"turquoise","kme":0.130421,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000244038","entrez_id":["1650"],"uniprot":["P39656"],"ncbi_summary":"This gene encodes a component of the oligosaccharyltransferase complex which catalyzes the transfer of high-mannose oligosaccharides to asparagine residues on nascent polypeptides in the lumen of the rough endoplasmic reticulum. The protein complex co-purifies with ribosomes. The product of this gene is also implicated in the processing of advanced glycation endproducts (AGEs), which form from non-enzymatic reactions between sugars and proteins or lipids and are associated with aging and hyperglycemia. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P39656","text":"Subunit of the oligosaccharyl transferase (OST) complex that catalyzes the initial transfer of a defined glycan (Glc(3)Man(9)GlcNAc(2) in eukaryotes) from the lipid carrier dolichol-pyrophosphate to an asparagine residue within an Asn-X-Ser/Thr consensus motif in nascent polypeptide chains, the first step in protein N-glycosylation (PubMed:31831667). N-glycosylation occurs cotranslationally and the complex associates with the Sec61 complex at the channel-forming translocon complex that mediates protein translocation across the endoplasmic reticulum (ER). All subunits are required for a maximal enzyme activity (By similarity). Required for the assembly of both SST3A- and SS3B-containing OST complexes (PubMed:22467853)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}