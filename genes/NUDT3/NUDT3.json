d":0.345961,"pct_control":0.354724,"donor_test":"not significant","donor_padj":0.970703,"donor_log2fc":-0.0246465,"donor_lfcse":0.115271,"donor_log2fc_shrunk":-0.00276639},{"cell_type":"OPC","gene_symbol":"NUDT3","gene_symbol_current":"NUDT3","gene_id":"ENSG00000272325","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.56144,"nucleus_log2fc":-0.040529,"nucleus_score":-0.829778,"pct_ad":0.255443,"pct_control":0.261304,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0288632,"donor_lfcse":0.0852754,"donor_log2fc_shrunk":-4.08582e-06},{"cell_type":"Oli","gene_symbol":"NUDT3","gene_symbol_current":"NUDT3","gene_id":"ENSG00000272325","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.166095,"nucleus_log2fc":0.0691748,"nucleus_score":1.4966,"pct_ad":0.172969,"pct_control":0.169467,"donor_test":"not significant","donor_padj":0.712269,"donor_log2fc":0.138942,"donor_lfcse":0.0891492,"donor_log2fc_shrunk":0.019399}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000272325","module":"brown","kme":0.321634,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000272325","module":"blue","kme":0.093245,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000272325","entrez_id":["11165"],"uniprot":["O95989"],"ncbi_summary":"NUDT3 belongs to the MutT, or Nudix, protein family. Nudix proteins act as homeostatic checkpoints at important stages in nucleoside phosphate metabolic pathways, guarding against elevated levels of potentially dangerous intermediates, like 8-oxo-dGTP, which promotes AT-to-CG transversions (Safrany et al., 1998 [PubMed 9822604]).[supplied by OMIM, Feb 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95989","text":"Cleaves a beta-phosphate from the diphosphate groups in PP-InsP5 (diphosphoinositol pentakisphosphate) and [PP]2-InsP4 (bisdiphosphoinositol tetrakisphosphate), suggesting that it may play a role in signal transduction (PubMed:10585413, PubMed:12370170, PubMed:9822604). InsP6 (inositol hexakisphosphate) is not a substrate (PubMed:9822604). Acts as a negative regulator of the ERK1/2 pathway (By similarity). Also able to catalyze the hydrolysis of dinucleoside oligophosphates, with diadenosine 5',5'''-P1,P6-hexaphosphate (Ap6A) and diadenosine 5',5'''- P1,P5-pentaphosphate (Ap5A) being the preferred substrates (PubMed:10419486, PubMed:12370170). The major reaction products are ADP and p4a from Ap6A and ADP and ATP from Ap5A (PubMed:12370170). Also able to hydrolyze 5-phosphoribose 1-diphosphate (PubMed:12370170). Acts as a decapping enzyme that modulates the stability of a subset of mRNAs implicated in cell motility (PubMed:26932476). Hydrolyzes monomethylated capped RNA after both the alpha- and beta-phosphates generating m7GMP + ppRNA and m7GDP + pRNA (PubMed:32727897). Can hydrolyze unmethylated capped RNAs (By similarity). Divalent cations zinc, magnesium and manganese determine its substrate specificity (PubMed:34788624). Exhibits diphosphoinositol polyphosphate phosphohydrolase in the presence of magnesium ions, diadenosine hexaphosphate hydrolase activity in the presence of manganese ions and endopolyphosphatase activity in the presence of zinc ions (PubMed:34788624). Plays an important role in limiting DNA damage and maintaining cell survival upon oxidative stress via its endopolyphosphatase activity (PubMed:34788624)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}