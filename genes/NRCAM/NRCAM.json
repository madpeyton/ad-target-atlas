,"nucleus_log2fc":0.0842586,"nucleus_score":6.76649,"pct_ad":0.994035,"pct_control":0.992549,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.00725148,"donor_lfcse":0.0937355,"donor_log2fc_shrunk":-8.39875e-07},{"cell_type":"Oli","gene_symbol":"NRCAM","gene_symbol_current":"NRCAM","gene_id":"ENSG00000091129","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.30806e-89,"nucleus_log2fc":-0.399724,"nucleus_score":-20.1937,"pct_ad":0.30258,"pct_control":0.372064,"donor_test":"not significant","donor_padj":0.79112,"donor_log2fc":-0.205049,"donor_lfcse":0.160433,"donor_log2fc_shrunk":-0.00868517}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000091129","module":"purple","kme":0.361458,"hub":true,"module_direction":"lower in AD","module_padj":0.900878,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000091129","module":"yellow","kme":0.39764,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000091129","module":"yellow","kme":0.314695,"hub":false,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000091129","module":"turquoise","kme":0.281466,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000091129","module":"brown","kme":0.379942,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000091129","module":"brown","kme":0.275061,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000091129","entrez_id":["4897"],"uniprot":["Q92823"],"ncbi_summary":"Cell adhesion molecules (CAMs) are members of the immunoglobulin superfamily. This gene encodes a neuronal cell adhesion molecule with multiple immunoglobulin-like C2-type domains and fibronectin type-III domains. This ankyrin-binding protein is involved in neuron-neuron adhesion and promotes directional signaling during axonal cone growth. This gene is also expressed in non-neural tissues and may play a general role in cell-cell communication via signaling from its intracellular domain to the actin cytoskeleton during directional cell migration. Allelic variants of this gene have been associated with autism and addiction vulnerability. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92823","text":"Cell adhesion protein that is required for normal responses to cell-cell contacts in brain and in the peripheral nervous system. Plays a role in neurite outgrowth in response to contactin binding. Plays a role in mediating cell-cell contacts between Schwann cells and axons. Plays a role in the formation and maintenance of the nodes of Ranvier on myelinated axons. Nodes of Ranvier contain clustered sodium channels that are crucial for the saltatory propagation of action potentials along myelinated axons. During development, nodes of Ranvier are formed by the fusion of two heminodes. Required for normal clustering of sodium channels at heminodes; not required for the formation of mature nodes with normal sodium channel clusters. Required, together with GLDN, for maintaining NFASC and sodium channel clusters at mature nodes of Ranvier."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}