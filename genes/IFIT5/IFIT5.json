1,"nucleus_score":8.75604,"pct_ad":0.148055,"pct_control":0.134119,"donor_test":"not significant","donor_padj":0.536158,"donor_log2fc":0.257456,"donor_lfcse":0.0828478,"donor_log2fc_shrunk":0.186463,"degas_log2fc":0.259217,"degas_padj":4.97645e-37},{"cell_type":"Mic","gene_symbol":"IFIT5","gene_symbol_current":"IFIT5","gene_id":"ENSG00000152778","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.623865,"donor_log2fc":0.236257,"donor_lfcse":0.164208,"donor_log2fc_shrunk":0.018307,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"IFIT5","gene_symbol_current":"IFIT5","gene_id":"ENSG00000152778","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.134711,"donor_lfcse":0.154414,"donor_log2fc_shrunk":5.95116e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"IFIT5","gene_symbol_current":"IFIT5","gene_id":"ENSG00000152778","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.0731557,"donor_log2fc":0.40863,"donor_lfcse":0.0999337,"donor_log2fc_shrunk":0.353019,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000152778","module":"turquoise","kme":0.0608224,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000152778","module":"turquoise","kme":0.0555499,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000152778","entrez_id":["24138"],"uniprot":["Q13325"],"ncbi_summary":"Enables nucleic acid binding activity. Involved in defense response to virus; negative regulation of viral genome replication; and positive regulation of I-kappaB kinase/NF-kappaB signaling. Located in actin cytoskeleton; apical part of cell; and ruffle membrane. Colocalizes with IkappaB kinase complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13325","text":"Interferon-induced RNA-binding protein involved in the human innate immune response. Has a broad and adaptable RNA structure recognition important for RNA recognition specificity in antiviral defense. Binds precursor and processed tRNAs as well as poly-U-tailed tRNA fragments (PubMed:23317505, PubMed:23774268, PubMed:25092312). Specifically binds single-stranded RNA bearing a 5'-triphosphate group (PPP-RNA), thereby acting as a sensor of viral single-stranded RNAs. Single-stranded PPP-RNAs, which lack 2'-O-methylation of the 5' cap and bear a 5'-triphosphate group instead, are specific from viruses, providing a molecular signature to distinguish between self and non-self mRNAs by the host during viral infection. Directly binds PPP-RNA in a non-sequence-specific manner (PubMed:23334420). Also recognizes and selectively binds AT-rich dsDNA (PubMed:23774268). Additionally, as a mediator in innate immunity, positively regulates IKK-NFKB signaling by sinergizing the recruitment of IKK to MAP3K7 (PubMed:26334375)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}