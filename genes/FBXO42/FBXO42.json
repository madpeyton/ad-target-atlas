7","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.900966,"nucleus_log2fc":0.07105,"nucleus_score":0.321947,"pct_ad":0.100861,"pct_control":0.0961298,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"FBXO42","gene_symbol_current":"FBXO42","gene_id":"ENSG00000037637","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.660282,"nucleus_log2fc":-0.10366,"nucleus_score":-0.892764,"pct_ad":0.1719,"pct_control":0.186973,"donor_test":"not significant","donor_padj":0.993604,"donor_log2fc":-0.0495057,"donor_lfcse":0.145263,"donor_log2fc_shrunk":-0.000378939},{"cell_type":"Oli","gene_symbol":"FBXO42","gene_symbol_current":"FBXO42","gene_id":"ENSG00000037637","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.754681,"donor_log2fc":-0.189975,"donor_lfcse":0.11246,"donor_log2fc_shrunk":-0.0152161}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000037637","module":"blue","kme":0.157491,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000037637","module":"yellow","kme":0.200674,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000037637","module":"blue","kme":0.100539,"hub":false,"module_direction":"lower in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000037637","entrez_id":["54455"],"uniprot":["Q6P3S6"],"ncbi_summary":"Members of the F-box protein family, such as FBXO42, are characterized by an approximately 40-amino acid F-box motif. SCF complexes, formed by SKP1 (SKP1A; MIM 601434), cullin (see CUL1; MIM 603134), and F-box proteins, act as protein-ubiquitin ligases. F-box proteins interact with SKP1 through the F box, and they interact with ubiquitination targets through other protein interaction domains (Jin et al., 2004 [PubMed 15520277]).[supplied by OMIM, Dec 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6P3S6","text":"Substrate-recognition component of the SCF (SKP1-CUL1-F-box protein)-type E3 ubiquitin ligase complex. Required for bipolar spindle formation during mitosis (PubMed:33539788). Recognizes p53/TP53 phosphorylated by CSN-associated kinase, promoting its polyubiquitination and proteasomal degradation (PubMed:19509332, PubMed:21127074, PubMed:39134694). Positively regulates the Notch signaling pathway through 'Lys-63'-linked polyubiquitination of the transcriptional effector RBPJ, stabilizing its chromatin association and potentiating transcriptional activation of Notch target genes (PubMed:36129980). Mediates 'Lys-48'-linked polyubiquitination and proteasomal degradation of components of the PP4 phosphatase complex, including PP4C, PP4R2, PP4R3A and PP4R3B, thereby restraining PP4 phosphatase activity and ensuring proper DNA damage response signaling (PubMed:41484364). Collaborates with CCDC6 to promote polyubiquitination and proteasomal degradation of the catalytic subunit PP2AC (PubMed:41986709). Recognizes ACAA2, promoting its ubiquitination and proteasomal degradation in hepatocytes, thereby attenuating fatty acid beta-oxidation; this activity is negatively regulated by CAND1, which prevents assembly of the SCF(FBXO42)-ACAA2 degradation complex (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}