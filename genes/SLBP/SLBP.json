or_padj":0.878176,"donor_log2fc":-0.0657914,"donor_lfcse":0.104519,"donor_log2fc_shrunk":-0.0110852},{"cell_type":"OPC","gene_symbol":"SLBP","gene_symbol_current":"SLBP","gene_id":"ENSG00000163950","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.323647,"nucleus_log2fc":0.0907516,"nucleus_score":1.32569,"pct_ad":0.104384,"pct_control":0.0970364,"donor_test":"not significant","donor_padj":0.999841,"donor_log2fc":0.000269312,"donor_lfcse":0.125703,"donor_log2fc_shrunk":2.40701e-08},{"cell_type":"Oli","gene_symbol":"SLBP","gene_symbol_current":"SLBP","gene_id":"ENSG00000163950","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.899992,"donor_log2fc":-0.0492922,"donor_lfcse":0.0656823,"donor_log2fc_shrunk":-0.0101373}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000163950","module":"brown","kme":0.174345,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163950","entrez_id":["7884"],"uniprot":["Q14493"],"ncbi_summary":"This gene encodes a protein that binds to the stem-loop structure in replication-dependent histone mRNAs. Histone mRNAs do not contain introns or polyadenylation signals, and are processed by endonucleolytic cleavage. The stem-loop structure is essential for efficient processing but this structure also controls the transport, translation and stability of histone mRNAs. Expression of the protein is regulated during the cell cycle, increasing more than 10-fold during the latter part of G1. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q14493","text":"RNA-binding protein involved in the histone pre-mRNA processing (PubMed:12588979, PubMed:19155325, PubMed:8957003, PubMed:9049306). Binds the stem-loop structure of replication-dependent histone pre-mRNAs and contributes to efficient 3'-end processing by stabilizing the complex between histone pre-mRNA and U7 small nuclear ribonucleoprotein (snRNP), via the histone downstream element (HDE) (PubMed:12588979, PubMed:19155325, PubMed:8957003, PubMed:9049306). Plays an important role in targeting mature histone mRNA from the nucleus to the cytoplasm and to the translation machinery (PubMed:12588979, PubMed:19155325, PubMed:8957003, PubMed:9049306). Stabilizes mature histone mRNA and could be involved in cell-cycle regulation of histone gene expression (PubMed:12588979, PubMed:19155325, PubMed:8957003, PubMed:9049306). Involved in the mechanism by which growing oocytes accumulate histone proteins that support early embryogenesis (By similarity). Binds to the 5' side of the stem-loop structure of histone pre-mRNAs (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}