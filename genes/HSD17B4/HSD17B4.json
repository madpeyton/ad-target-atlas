7B4","gene_symbol_current":"HSD17B4","gene_id":"ENSG00000133835","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0344028,"nucleus_log2fc":-0.0892524,"nucleus_score":-2.57768,"pct_ad":0.525947,"pct_control":0.545809,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0714179,"donor_lfcse":0.0580512,"donor_log2fc_shrunk":-2.21874e-05,"degas_log2fc":-0.288379,"degas_padj":9.10439e-16},{"cell_type":"Oli","gene_symbol":"HSD17B4","gene_symbol_current":"HSD17B4","gene_id":"ENSG00000133835","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.861371,"nucleus_log2fc":-0.000400874,"nucleus_score":-0.205735,"pct_ad":0.587914,"pct_control":0.601551,"donor_test":"not significant","donor_padj":0.919976,"donor_log2fc":0.0725119,"donor_lfcse":0.111785,"donor_log2fc_shrunk":0.00649483,"degas_log2fc":-0.268776,"degas_padj":1.63234e-74}],"modules":[{"cell_type":"In","gene_id":"ENSG00000133835","module":"yellow","kme":0.189293,"hub":false,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000133835","entrez_id":["3295"],"uniprot":["P51659"],"ncbi_summary":"The protein encoded by this gene is a bifunctional enzyme that is involved in the peroxisomal beta-oxidation pathway for fatty acids. It also acts as a catalyst for the formation of 3-ketoacyl-CoA intermediates from both straight-chain and 2-methyl-branched-chain fatty acids. Defects in this gene that affect the peroxisomal fatty acid beta-oxidation activity are a cause of D-bifunctional protein deficiency (DBPD). An apparent pseudogene of this gene is present on chromosome 8. Multiple alternatively spliced transcript variants encoding distinct isoforms have been found for this gene. [provided by RefSeq, May 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P51659","text":"Bifunctional enzyme acting on the peroxisomal fatty acid beta-oxidation pathway. Catalyzes two of the four reactions in fatty acid degradation: hydration of 2-enoyl-CoA (trans-2-enoyl-CoA) to produce (3R)-3-hydroxyacyl-CoA, and dehydrogenation of (3R)-3-hydroxyacyl-CoA to produce 3-ketoacyl-CoA (3-oxoacyl-CoA), which is further metabolized by SCPx. Can use straight-chain and branched-chain fatty acids, as well as bile acid intermediates as substrates. May play a role in peroxisomal beta-oxidation step in polyunsaturated fatty acids (PUFAs) biosynthesis. Possibly regulates systemic levels of docosahexaenoic acid (DHA, C22:6n-3) through a process involving endoplasmic reticulum desaturation and elongation of alpha-linolenic acid (ALA, C18:3n-3) to form tetracosahexaenoic acid (THA, C24:6n-3), which is then beta-oxidized to DHA in peroxisomes."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}