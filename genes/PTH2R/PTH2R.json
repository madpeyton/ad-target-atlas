bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000144407"],"dataset_symbols":["PTH2R"],"explorer":"explorer.html?dataset=mathys2019#gene/PTH2R","cell_types":[{"cell_type":"Ex","gene_symbol":"PTH2R","gene_symbol_current":"PTH2R","gene_id":"ENSG00000144407","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000119566,"nucleus_log2fc":-0.118849,"nucleus_score":-4.14186,"pct_ad":0.264019,"pct_control":0.291354,"donor_test":"not significant","donor_padj":0.990685,"donor_log2fc":-0.0400951,"donor_lfcse":0.119173,"donor_log2fc_shrunk":-2.90278e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000144407","module":"blue","kme":0.232064,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000144407","module":"blue","kme":0.115237,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000144407","entrez_id":["5746"],"uniprot":["P49190"],"ncbi_summary":"The protein encoded by this gene is a member of the G-protein coupled receptor 2 family. This protein is a receptor for parathyroid hormone (PTH). This receptor is more selective in ligand recognition and has a more specific tissue distribution compared to parathyroid hormone receptor 1 (PTHR1). It is activated only by PTH and not by parathyroid hormone-like hormone (PTHLH) and is particularly abundant in brain and pancreas. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jan 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49190","text":"This is a specific receptor for parathyroid hormone. The activity of this receptor is mediated by G proteins which activate adenylyl cyclase. PTH2R may be responsible for PTH effects in a number of physiological systems. It may play a significant role in pancreatic function. PTH2R presence in neurons indicates that it may function as a neurotransmitter receptor (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}