icant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.949687,"donor_log2fc":0.126309,"donor_lfcse":0.304112,"donor_log2fc_shrunk":0.00154276}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163273","entrez_id":["4880"],"uniprot":["P23582"],"ncbi_summary":"This gene encodes a preproprotein that is proteolytically processed to generate multiple protein products. These products include the cardiac natriuretic peptides CNP-53, CNP-29 and CNP-22, which belong to the natriuretic family of peptides. The encoded peptides exhibit vasorelaxation activity in laboratory animals and elevated levels of CNP-22 have been observed in the plasma of chronic heart failure patients. [provided by RefSeq, Oct 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P23582","text":"[CNP-22]: Hormone which plays a role in endochondral ossification through regulation of cartilaginous growth plate chondrocytes proliferation and differentiation (By similarity). May also be vasoactive and natriuretic (PubMed:1672777). Acts by specifically binding and stimulating NPR2 to produce cGMP (PubMed:1672777, PubMed:21098034). Binds the clearance receptor NPR3 (PubMed:11533490)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}