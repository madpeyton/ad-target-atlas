lower in AD","nucleus_padj":0.988622,"nucleus_log2fc":-0.0296174,"nucleus_score":-0.0235599,"pct_ad":0.212645,"pct_control":0.211177,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0135246,"donor_lfcse":0.074697,"donor_log2fc_shrunk":2.52584e-06},{"cell_type":"Oli","gene_symbol":"EIF4ENIF1","gene_symbol_current":"EIF4ENIF1","gene_id":"ENSG00000184708","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.204956,"nucleus_log2fc":-0.0286142,"nucleus_score":-1.3759,"pct_ad":0.161992,"pct_control":0.166067,"donor_test":"not significant","donor_padj":0.997732,"donor_log2fc":-0.00116396,"donor_lfcse":0.0714168,"donor_log2fc_shrunk":-0.000194968}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000184708","module":"turquoise","kme":0.0632835,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000184708","module":"turquoise","kme":0.00195301,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000184708","module":"turquoise","kme":0.0648722,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000184708","entrez_id":["56478"],"uniprot":["Q9NRA8"],"ncbi_summary":"The protein encoded by this gene is a nucleocytoplasmic shuttle protein for the translation initiation factor eIF4E. This shuttle protein interacts with the importin alpha-beta complex to mediate nuclear import of eIF4E. It is predominantly cytoplasmic; its own nuclear import is regulated by a nuclear localization signal and nuclear export signals. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Aug 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NRA8","text":"EIF4E-binding protein that regulates translation and stability of mRNAs in processing bodies (P-bodies) (PubMed:16157702, PubMed:24335285, PubMed:27342281, PubMed:32354837). Plays a key role in P-bodies to coordinate the storage of translationally inactive mRNAs in the cytoplasm and prevent their degradation (PubMed:24335285, PubMed:32354837). Acts as a binding platform for multiple RNA-binding proteins: promotes deadenylation of mRNAs via its interaction with the CCR4-NOT complex, and blocks decapping via interaction with eIF4E (EIF4E and EIF4E2), thereby protecting deadenylated and repressed mRNAs from degradation (PubMed:27342281, PubMed:32354837). Component of a multiprotein complex that sequesters and represses translation of proneurogenic factors during neurogenesis (By similarity). Promotes miRNA-mediated translational repression (PubMed:24335285, PubMed:27342281, PubMed:28487484). Required for the formation of P-bodies (PubMed:16157702, PubMed:22966201, PubMed:27342281, PubMed:32354837). Involved in mRNA translational repression mediated by the miRNA effector TNRC6B by protecting TNRC6B-targeted mRNAs from decapping and subsequent decay (PubMed:32354837). Also acts as a nucleoplasmic shuttling protein, which mediates the nuclear import of EIF4E and DDX6 by a piggy-back mechanism (PubMed:10856257, PubMed:28216671)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}