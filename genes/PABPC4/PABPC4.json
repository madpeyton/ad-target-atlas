nor_log2fc":-0.054299,"donor_lfcse":0.150443,"donor_log2fc_shrunk":-2.4958e-06},{"cell_type":"Oli","gene_symbol":"PABPC4","gene_symbol_current":"PABPC4","gene_id":"ENSG00000090621","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":6.91738e-28,"nucleus_log2fc":-0.280528,"nucleus_score":-11.1083,"pct_ad":0.190907,"pct_control":0.224401,"donor_test":"not significant","donor_padj":0.785339,"donor_log2fc":-0.19198,"donor_lfcse":0.147746,"donor_log2fc_shrunk":-0.00989611}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000090621","module":"turquoise","kme":0.0791044,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000090621","module":"turquoise","kme":0.0638548,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000090621","module":"turquoise","kme":0.0862603,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000090621","entrez_id":["8761"],"uniprot":["Q13310"],"ncbi_summary":"Poly(A)-binding proteins (PABPs) bind to the poly(A) tail present at the 3-prime ends of most eukaryotic mRNAs. PABPC4 or IPABP (inducible PABP) was isolated as an activation-induced T-cell mRNA encoding a protein. Activation of T cells increased PABPC4 mRNA levels in T cells approximately 5-fold. PABPC4 contains 4 RNA-binding domains and proline-rich C terminus. PABPC4 is localized primarily to the cytoplasm. It is suggested that PABPC4 might be necessary for regulation of stability of labile mRNA species in activated T cells. PABPC4 was also identified as an antigen, APP1 (activated-platelet protein-1), expressed on thrombin-activated rabbit platelets. PABPC4 may also be involved in the regulation of protein translation in platelets and megakaryocytes or may participate in the binding or stabilization of polyadenylates in platelet dense granules. Alternatively spliced transcript variants encoding different isoforms have been found for this gene. This protein has also been found to interact with coronavirus nucleocapsid proteins and is thought to inhibit coronavirus replication. [provided by RefSeq, Nov 2021].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13310","text":"Binds the poly(A) tail of mRNA (PubMed:8524242). Binds to SMIM26 mRNA and plays a role in its post-transcriptional regulation (PubMed:37009826). May be involved in cytoplasmic regulatory processes of mRNA metabolism. Can probably bind to cytoplasmic RNA sequences other than poly(A) in vivo (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}