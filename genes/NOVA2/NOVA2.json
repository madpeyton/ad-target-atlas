l":null,"donor_test":"not significant","donor_padj":0.564859,"donor_log2fc":-0.330885,"donor_lfcse":0.204828,"donor_log2fc_shrunk":-0.0169434},{"cell_type":"OPC","gene_symbol":"NOVA2","gene_symbol_current":"NOVA2","gene_id":"ENSG00000104967","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.939811,"nucleus_log2fc":-0.0146772,"nucleus_score":0.121532,"pct_ad":0.230391,"pct_control":0.227942,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0270293,"donor_lfcse":0.106834,"donor_log2fc_shrunk":-2.45164e-06},{"cell_type":"Oli","gene_symbol":"NOVA2","gene_symbol_current":"NOVA2","gene_id":"ENSG00000104967","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00100366,"nucleus_log2fc":0.123265,"nucleus_score":3.43248,"pct_ad":0.122274,"pct_control":0.113943,"donor_test":"not significant","donor_padj":0.636238,"donor_log2fc":0.18987,"donor_lfcse":0.101094,"donor_log2fc_shrunk":0.0217133}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000104967","module":"blue","kme":0.0689512,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000104967","entrez_id":["4858"],"uniprot":["Q9UNW9"],"ncbi_summary":"Enables sequence-specific mRNA binding activity. Involved in neuron differentiation and regulation of alternative mRNA splicing, via spliceosome. Predicted to be active in cytoplasm and nucleus. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UNW9","text":"Functions to regulate alternative splicing in neurons by binding pre-mRNA in a sequence-specific manner to activate exon inclusion or exclusion (PubMed:32197073). It binds specifically to the sequences 5'-YCAY-3' and regulates splicing in only a subset of regulated exons (PubMed:10811881). Binding to an exonic 5'-YCAY-3' cluster changes the protein complexes assembled on pre-mRNA, blocking U1 snRNP binding and exon inclusion, whereas binding to an intronic 5'-YCAY-3' cluster enhances spliceosome assembly and exon inclusion. With NOVA1, they perform unique biological functions in different brain areas and cell types. Uniquely regulates alternative splicing events of a series of axon guidance related genes during cortical development, being essential for central nervous system development by regulating neural networks wiring. Regulates differentially alternative splicing on the same transcripts expressed in different neurons. This includes functional differences in transcripts expressed in cortical and cerebellar excitatory versus inhibitory neurons where is required for, respectively, development of laminar structure and motor coordination and synapse formation. Also the regulation the regulation of intron retention can sequester the trans-acting splicing factor PTBP2, acting as a variable cis-acting scaffolding platform for PTBP2 across various natural conditions (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}