ucleus_score":0.069352,"pct_ad":0.329248,"pct_control":0.327995,"donor_test":"not significant","donor_padj":0.988163,"donor_log2fc":-0.00704051,"donor_lfcse":0.0880093,"donor_log2fc_shrunk":-0.00124581,"degas_log2fc":0.0189102,"degas_padj":0.704465},{"cell_type":"OPC","gene_symbol":"ARHGEF1","gene_symbol_current":"ARHGEF1","gene_id":"ENSG00000076928","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000618106,"nucleus_log2fc":-0.254075,"nucleus_score":-3.93056,"pct_ad":0.19669,"pct_control":0.22337,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.194826,"donor_lfcse":0.0950049,"donor_log2fc_shrunk":-2.23221e-05,"degas_log2fc":-0.1691,"degas_padj":0.00719509},{"cell_type":"Oli","gene_symbol":"ARHGEF1","gene_symbol_current":"ARHGEF1","gene_id":"ENSG00000076928","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.73632e-15,"nucleus_log2fc":-0.195437,"nucleus_score":-8.02619,"pct_ad":0.214738,"pct_control":0.238985,"donor_test":"not significant","donor_padj":0.791599,"donor_log2fc":-0.104477,"donor_lfcse":0.0820051,"donor_log2fc_shrunk":-0.0262426,"degas_log2fc":-0.136149,"degas_padj":4.07975e-08}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000076928","module":"red","kme":0.121272,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000076928","entrez_id":["9138"],"uniprot":["Q92888"],"ncbi_summary":"Rho GTPases play a fundamental role in numerous cellular processes that are initiated by extracellular stimuli that work through G protein coupled receptors. The encoded protein may form complex with G proteins and stimulate Rho-dependent signals. Multiple alternatively spliced transcript variants have been found for this gene, but the full-length nature of some variants has not been defined. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92888","text":"Seems to play a role in the regulation of RhoA GTPase by guanine nucleotide-binding alpha-12 (GNA12) and alpha-13 (GNA13) subunits (PubMed:9641915, PubMed:9641916). Acts as a GTPase-activating protein (GAP) for GNA12 and GNA13, and as guanine nucleotide exchange factor (GEF) for RhoA GTPase (PubMed:30521495, PubMed:8810315, PubMed:9641915, PubMed:9641916). Activated G alpha 13/GNA13 stimulates the RhoGEF activity through interaction with the RGS-like domain (PubMed:9641916). This GEF activity is inhibited by binding to activated GNA12 (PubMed:9641916). Mediates angiotensin-2-induced RhoA activation (PubMed:20098430). In lymphoid follicles, may trigger activation of GNA13 as part of S1PR2-dependent signaling pathway that leads to inhibition of germinal center (GC) B cell growth and migration outside the GC niche."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}