ll_type":"CUX2+","gene_id":"ENSG00000076928","module":"blue","kme":0.0481345,"hub":false,"module_direction":"lower in AD","module_padj":0.642666,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000076928","module":"blue","kme":0.0374775,"hub":false,"module_direction":"lower in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000076928"],"dataset_symbols":["ARHGEF1"],"explorer":"explorer.html?dataset=mathys2019#gene/ARHGEF1","cell_types":[{"cell_type":"Ex","gene_symbol":"ARHGEF1","gene_symbol_current":"ARHGEF1","gene_id":"ENSG00000076928","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.998051,"donor_log2fc":0.00770104,"donor_lfcse":0.120425,"donor_log2fc_shrunk":5.59284e-07},{"cell_type":"Oli","gene_symbol":"ARHGEF1","gene_symbol_current":"ARHGEF1","gene_id":"ENSG00000076928","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.903597,"donor_log2fc":-0.112626,"donor_lfcse":0.159208,"donor_log2fc_shrunk":-0.00412377}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000076928","module":"turquoise","kme":0.101049,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000076928","entrez_id":["9138"],"uniprot":["Q92888"],"ncbi_summary":"Rho GTPases play a fundamental role in numerous cellular processes that are initiated by extracellular stimuli that work through G protein coupled receptors. The encoded protein may form complex with G proteins and stimulate Rho-dependent signals. Multiple alternatively spliced transcript variants have been found for this gene, but the full-length nature of some variants has not been defined. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92888","text":"Seems to play a role in the regulation of RhoA GTPase by guanine nucleotide-binding alpha-12 (GNA12) and alpha-13 (GNA13) subunits (PubMed:9641915, PubMed:9641916). Acts as a GTPase-activating protein (GAP) for GNA12 and GNA13, and as guanine nucleotide exchange factor (GEF) for RhoA GTPase (PubMed:30521495, PubMed:8810315, PubMed:9641915, PubMed:9641916). Activated G alpha 13/GNA13 stimulates the RhoGEF activity through interaction with the RGS-like domain (PubMed:9641916). This GEF activity is inhibited by binding to activated GNA12 (PubMed:9641916). Mediates angiotensin-2-induced RhoA activation (PubMed:20098430). In lymphoid follicles, may trigger activation of GNA13 as part of S1PR2-dependent signaling pathway that leads to inhibition of germinal center (GC) B cell growth and migration outside the GC niche."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}