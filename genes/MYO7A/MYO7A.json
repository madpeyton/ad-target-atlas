cleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.680625,"nucleus_log2fc":0.0198538,"nucleus_score":0.529502,"pct_ad":0.197307,"pct_control":0.19447,"donor_test":"not significant","donor_padj":0.956284,"donor_log2fc":-0.0434579,"donor_lfcse":0.147853,"donor_log2fc_shrunk":-0.00380016,"degas_log2fc":-0.253372,"degas_padj":1.68461e-06},{"cell_type":"OPC","gene_symbol":"MYO7A","gene_symbol_current":"MYO7A","gene_id":"ENSG00000137474","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.20828e-07,"nucleus_log2fc":0.360663,"nucleus_score":5.46663,"pct_ad":0.121533,"pct_control":0.0906012,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.304834,"donor_lfcse":0.285788,"donor_log2fc_shrunk":3.83867e-06,"degas_log2fc":-0.624028,"degas_padj":2.08511e-12}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000137474","module":"blue","kme":0.182802,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000137474","module":"yellow","kme":0.10032,"hub":false,"module_direction":"higher in AD","module_padj":0.663532,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000137474","entrez_id":["4647"],"uniprot":["Q13402"],"ncbi_summary":"This gene is a member of the myosin gene family. Myosins are mechanochemical proteins characterized by the presence of a motor domain, an actin-binding domain, a neck domain that interacts with other proteins, and a tail domain that serves as an anchor. This gene encodes an unconventional myosin with a very short tail. Defects in this gene are associated with the mouse shaker-1 phenotype and the human Usher syndrome 1B which are characterized by deafness, reduced vestibular function, and (in human) retinal degeneration. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13402","text":"Myosins are actin-based motor molecules with ATPase activity. Unconventional myosins serve in intracellular movements. Their highly divergent tails bind to membranous compartments, which are then moved relative to actin filaments. In the retina, plays an important role in the renewal of the outer photoreceptor disks. Plays an important role in the distribution and migration of retinal pigment epithelial (RPE) melanosomes and phagosomes, and in the regulation of opsin transport in retinal photoreceptors. In the inner ear, plays an important role in differentiation, morphogenesis and organization of cochlear hair cell bundles. Involved in hair-cell vesicle trafficking of aminoglycosides, which are known to induce ototoxicity (By similarity). Motor protein that is a part of the functional network formed by USH1C, USH1G, CDH23 and MYO7A that mediates mechanotransduction in cochlear hair cells. Required for normal hearing."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}