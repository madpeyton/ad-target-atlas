irection":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.833143,"donor_log2fc":0.162936,"donor_lfcse":0.149617,"donor_log2fc_shrunk":0.00700046}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000115484","module":"greenyellow","kme":0.158229,"hub":false,"module_direction":"higher in AD","module_padj":0.56571,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000115484","module":"turquoise","kme":0.321889,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000115484","module":"turquoise","kme":0.301207,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000115484","module":"turquoise","kme":0.155877,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000115484","module":"turquoise","kme":0.124421,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000115484","entrez_id":["10575"],"uniprot":["P50991"],"ncbi_summary":"The chaperonin containing TCP1 (MIM 186980) complex (CCT), also called the TCP1 ring complex, consists of 2 back-to-back rings, each containing 8 unique but homologous subunits, such as CCT4. CCT assists the folding of newly translated polypeptide substrates through multiple rounds of ATP-driven release and rebinding of partially folded intermediate forms. Substrates of CCT include the cytoskeletal proteins actin (see MIM 102560) and tubulin (see MIM 191130), as well as alpha-transducin (MIM 139330) (Won et al., 1998 [PubMed 9819444]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P50991","text":"Component of the chaperonin-containing T-complex (TRiC), a molecular chaperone complex that assists the folding of actin, tubulin and other proteins upon ATP hydrolysis (PubMed:25467444, PubMed:36493755, PubMed:35449234, PubMed:37193829). The TRiC complex mediates the folding of WRAP53/TCAB1, thereby regulating telomere maintenance (PubMed:25467444). As part of the TRiC complex may play a role in the assembly of BBSome, a complex involved in ciliogenesis regulating transports vesicles to the cilia (PubMed:20080638)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}