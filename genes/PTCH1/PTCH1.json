G00000185920","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.014084,"nucleus_log2fc":0.114341,"nucleus_score":2.93683,"pct_ad":0.528184,"pct_control":0.51177,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.095434,"donor_lfcse":0.139348,"donor_log2fc_shrunk":5.1526e-06},{"cell_type":"Oli","gene_symbol":"PTCH1","gene_symbol_current":"PTCH1","gene_id":"ENSG00000185920","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.9637e-15,"nucleus_log2fc":0.198084,"nucleus_score":8.10586,"pct_ad":0.262024,"pct_control":0.236765,"donor_test":"not significant","donor_padj":0.620314,"donor_log2fc":0.176965,"donor_lfcse":0.0907393,"donor_log2fc_shrunk":0.0268446}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000185920","module":"greenyellow","kme":0.368113,"hub":false,"module_direction":"higher in AD","module_padj":0.866421,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000185920","module":"blue","kme":0.31945,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000185920","module":"yellow","kme":0.203059,"hub":false,"module_direction":"higher in AD","module_padj":0.663532,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000185920","entrez_id":["5727"],"uniprot":["Q13635"],"ncbi_summary":"This gene encodes a member of the patched family of proteins and a component of the hedgehog signaling pathway. Hedgehog signaling is important in embryonic development and tumorigenesis. The encoded protein is the receptor for the secreted hedgehog ligands, which include sonic hedgehog, indian hedgehog and desert hedgehog. Following binding by one of the hedgehog ligands, the encoded protein is trafficked away from the primary cilium, relieving inhibition of the G-protein-coupled receptor smoothened, which results in activation of downstream signaling. Mutations of this gene have been associated with basal cell nevus syndrome and holoprosencephaly. [provided by RefSeq, Aug 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13635","text":"Negative regulator of the smoothened signaling pathway, which acts as a receptor for hedgehog (SHH, IHH and DHH) morphogens (PubMed:21537345, PubMed:29954986, PubMed:29995851, PubMed:30139912, PubMed:31127104, PubMed:31555730, PubMed:37611095, PubMed:40128518, PubMed:9811851). In absence of hedgehog, acts as an inhibitor of smoothened protein (SMO) by preventing SMO access to cholesterol: mechanistically, acts as a cholesterol transporter, which depeletes cholesterol from the outer leaflet of plasma membrane, thereby preventing cholesterol-binding to the extracellular CRD region of SMO (PubMed:31555730, PubMed:37611095). Hedgehog-binding inhibits PTCH1 cholesterol transporter activity, promoting SMO activation by cholesterol and transduction of the smoothened signaling pathway (PubMed:31548691). Molecular mechanism governing cholesterol transport are still unclear: may move cholesterol from the outer to the inner leaflet of the membrane in exchange for potassium or sodium ion export in the opposite direction (PubMed:37611095). Seems to have a tumor suppressor function, as inactivation of this protein is probably a necessary, if not sufficient step for tumorigenesis (PubMed:8658145)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}