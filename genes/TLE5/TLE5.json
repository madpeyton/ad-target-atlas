:[{"accession":"Q08117","text":"Transcriptional corepressor. Acts as a dominant repressor towards other family members. Inhibits NF-kappa-B-regulated gene expression. May be required for the initiation and maintenance of the differentiated state. Essential for the transcriptional repressor activity of SIX3 during retina and lens development."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}