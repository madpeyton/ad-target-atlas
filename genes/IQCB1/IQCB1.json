rue,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.964935,"nucleus_log2fc":-0.0156105,"nucleus_score":-0.117565,"pct_ad":0.107011,"pct_control":0.108614,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"IQCB1","gene_symbol_current":"IQCB1","gene_id":"ENSG00000173226","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.905757,"nucleus_log2fc":0.0656627,"nucleus_score":0.289869,"pct_ad":0.127159,"pct_control":0.124138,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"IQCB1","gene_symbol_current":"IQCB1","gene_id":"ENSG00000173226","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.942097,"donor_log2fc":-0.0532151,"donor_lfcse":0.10934,"donor_log2fc_shrunk":-0.00407481}],"modules":[{"cell_type":"In","gene_id":"ENSG00000173226","module":"brown","kme":0.236255,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000173226","module":"lightcyan","kme":0.177302,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000173226","entrez_id":["9657"],"uniprot":["Q15051"],"ncbi_summary":"This gene encodes a nephrocystin protein that interacts with calmodulin and the retinitis pigmentosa GTPase regulator protein. The encoded protein has a central coiled-coil region and two calmodulin-binding IQ domains. It is localized to the primary cilia of renal epithelial cells and connecting cilia of photoreceptor cells. The protein is thought to play a role in ciliary function. Defects in this gene result in Senior-Loken syndrome type 5. Alternative splicing results in multiple transcript variants. A pseudogene of this gene is found on chromosome 6. [provided by RefSeq, Jan 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15051","text":"Involved in ciliogenesis. The function in an early step in cilia formation depends on its association with CEP290/NPHP6 (PubMed:21565611, PubMed:23446637). Involved in regulation of the BBSome complex integrity, specifically for presence of BBS2 and BBS5 in the complex, and in ciliary targeting of selected BBSome cargos. May play a role in controlling entry of the BBSome complex to cilia possibly implicating CEP290/NPHP6 (PubMed:25552655)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}