.0912517,"donor_log2fc_shrunk":5.43826e-06},{"cell_type":"Oli","gene_symbol":"ATP1A1","gene_symbol_current":"ATP1A1","gene_id":"ENSG00000163399","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00169416,"nucleus_log2fc":-0.0450898,"nucleus_score":-3.28037,"pct_ad":0.379156,"pct_control":0.394262,"donor_test":"not significant","donor_padj":0.984184,"donor_log2fc":-0.0124844,"donor_lfcse":0.0932559,"donor_log2fc_shrunk":-0.00148964}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000163399","module":"turquoise","kme":0.0402059,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000163399","module":"brown","kme":0.40236,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000163399","module":"turquoise","kme":0.0535624,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000163399","module":"turquoise","kme":0.159858,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000163399","module":"turquoise","kme":0.0906583,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163399","entrez_id":["476"],"uniprot":["P05023"],"ncbi_summary":"The protein encoded by this gene belongs to the family of P-type cation transport ATPases, and to the subfamily of Na+/K+ -ATPases. Na+/K+ -ATPase is an integral membrane protein responsible for establishing and maintaining the electrochemical gradients of Na and K ions across the plasma membrane. These gradients are essential for osmoregulation, for sodium-coupled transport of a variety of organic and inorganic molecules, and for electrical excitability of nerve and muscle. This enzyme is composed of two subunits, a large catalytic subunit (alpha) and a smaller glycoprotein subunit (beta). The catalytic subunit of Na+/K+ -ATPase is encoded by multiple genes. This gene encodes an alpha 1 subunit. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, May 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P05023","text":"Catalytic subunit of the Na(+)/K(+)-ATPase pump that hydrolyzes ATP to exchange ions across the plasma membrane, exporting 3 Na(+) and importing 2 K(+) per cycle against electrochemical gradients (PubMed:29499166, PubMed:30388404, PubMed:35803952). It undergoes ATP-driven conformational changes that allow alternating binding and release of Na(+) and K(+) ions across the membrane (PubMed:35803952). This process maintains essential Na(+) and K(+) gradients for membrane potential and cellular function. Could also be part of an osmosensory signaling pathway that senses body-fluid sodium levels and controls salt intake behavior as well as voluntary water intake to regulate sodium homeostasis (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}