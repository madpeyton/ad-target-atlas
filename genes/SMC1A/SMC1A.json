6158e-06},{"cell_type":"Mic","gene_symbol":"SMC1A","gene_symbol_current":"SMC1A","gene_id":"ENSG00000072501","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.24401e-09,"nucleus_log2fc":0.327118,"nucleus_score":6.39305,"pct_ad":0.225348,"pct_control":0.189516,"donor_test":"not significant","donor_padj":0.322911,"donor_log2fc":0.230201,"donor_lfcse":0.0944774,"donor_log2fc_shrunk":0.109881,"degas_log2fc":-0.232929,"degas_padj":6.42357e-06},{"cell_type":"OPC","gene_symbol":"SMC1A","gene_symbol_current":"SMC1A","gene_id":"ENSG00000072501","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.815481,"nucleus_log2fc":-0.0273462,"nucleus_score":0.367019,"pct_ad":0.1864,"pct_control":0.18171,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.00438602,"donor_lfcse":0.097168,"donor_log2fc_shrunk":1.39172e-05,"degas_log2fc":-0.260329,"degas_padj":9.27207e-05},{"cell_type":"Oli","gene_symbol":"SMC1A","gene_symbol_current":"SMC1A","gene_id":"ENSG00000072501","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.1513e-16,"nucleus_log2fc":0.194514,"nucleus_score":8.23001,"pct_ad":0.226841,"pct_control":0.200686,"donor_test":"not significant","donor_padj":0.388155,"donor_log2fc":0.16232,"donor_lfcse":0.0556771,"donor_log2fc_shrunk":0.115155,"degas_log2fc":-0.0286695,"degas_padj":0.275485}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000072501","module":"purple","kme":0.138336,"hub":false,"module_direction":"higher in AD","module_padj":0.0131545,"module_significant":true}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000072501","entrez_id":["8243"],"uniprot":["Q14683"],"ncbi_summary":"Proper cohesion of sister chromatids is a prerequisite for the correct segregation of chromosomes during cell division. The cohesin multiprotein complex is required for sister chromatid cohesion. This complex is composed partly of two structural maintenance of chromosomes (SMC) proteins, SMC3 and either SMC1B or the protein encoded by this gene. Most of the cohesin complexes dissociate from the chromosomes before mitosis, although those complexes at the kinetochore remain. Therefore, the encoded protein is thought to be an important part of functional kinetochores. In addition, this protein interacts with BRCA1 and is phosphorylated by ATM, indicating a potential role for this protein in DNA repair. This gene, which belongs to the SMC gene family, is located in an area of the X-chromosome that escapes X inactivation. Mutations in this gene result in Cornelia de Lange syndrome. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Jul 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q14683","text":"Involved in chromosome cohesion during cell cycle and in DNA repair. Central component of cohesin complex. The cohesin complex is required for the cohesion of sister chromatids after DNA replication. The cohesin complex apparently forms a large proteinaceous ring within which sister chromatids can be trapped. At anaphase, the complex is cleaved and dissociates from chromatin, allowing sister chromatids to segregate. The cohesin complex may also play a role in spindle pole assembly during mitosis. Involved in DNA repair via its interaction with BRCA1 and its related phosphorylation by ATM, or via its phosphorylation by ATR. Works as a downstream effector both in the ATM/NBS1 branch and in the ATR/MSH2 branch of S-phase checkpoint."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}