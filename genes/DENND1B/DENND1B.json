igher in AD","nucleus_padj":0.174528,"nucleus_log2fc":0.0649673,"nucleus_score":1.75693,"pct_ad":0.469729,"pct_control":0.456393,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0156195,"donor_lfcse":0.067596,"donor_log2fc_shrunk":3.5734e-06},{"cell_type":"Oli","gene_symbol":"DENND1B","gene_symbol_current":"DENND1B","gene_id":"ENSG00000213047","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.816684,"donor_log2fc":-0.170818,"donor_lfcse":0.146897,"donor_log2fc_shrunk":-0.00892314}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000213047","module":"turquoise","kme":0.212831,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000213047","module":"yellow","kme":0.245196,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000213047","module":"black","kme":0.140703,"hub":false,"module_direction":"higher in AD","module_padj":0.169392,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000213047","module":"turquoise","kme":0.0585175,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000213047","module":"brown","kme":0.106732,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000213047","entrez_id":["163486"],"uniprot":["Q6P3S1"],"ncbi_summary":"Clathrin (see MIM 118955)-mediated endocytosis is a major mechanism for internalization of proteins and lipids. Members of the connecdenn family, such as DENND1B, function as guanine nucleotide exchange factors (GEFs) for the early endosomal small GTPase RAB35 (MIM 604199) and bind to clathrin and clathrin adaptor protein-2 (AP2; see MIM 601024). Thus, connecdenns link RAB35 activation with the clathrin machinery (Marat and McPherson, 2010 [PubMed 20154091]).[supplied by OMIM, Nov 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6P3S1","text":"Guanine nucleotide exchange factor (GEF) for RAB35 that acts as a regulator of T-cell receptor (TCR) internalization in TH2 cells (PubMed:20154091, PubMed:20937701, PubMed:24520163, PubMed:26774822). Acts by promoting the exchange of GDP to GTP, converting inactive GDP-bound RAB35 into its active GTP-bound form (PubMed:20154091, PubMed:20937701). Plays a role in clathrin-mediated endocytosis (PubMed:20154091). Controls cytokine production in TH2 lymphocytes by controlling the rate of TCR internalization and routing to endosomes: acts by mediating clathrin-mediated endocytosis of TCR via its interaction with the adapter protein complex 2 (AP-2) and GEF activity (PubMed:26774822). Dysregulation leads to impaired TCR down-modulation and recycling, affecting cytokine production in TH2 cells (PubMed:26774822)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}