cleus_padj":0.00680802,"nucleus_log2fc":-0.150604,"nucleus_score":-2.99064,"pct_ad":0.205385,"pct_control":0.222581,"donor_test":"not significant","donor_padj":0.441373,"donor_log2fc":-0.147743,"donor_lfcse":0.0729128,"donor_log2fc_shrunk":-0.0668679},{"cell_type":"OPC","gene_symbol":"INTS9","gene_symbol_current":"INTS9","gene_id":"ENSG00000104299","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.753056,"nucleus_log2fc":-0.0309664,"nucleus_score":-0.485666,"pct_ad":0.326126,"pct_control":0.32735,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0279827,"donor_lfcse":0.0770779,"donor_log2fc_shrunk":-4.86104e-06},{"cell_type":"Oli","gene_symbol":"INTS9","gene_symbol_current":"INTS9","gene_id":"ENSG00000104299","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.505928,"nucleus_log2fc":0.0375749,"nucleus_score":0.742772,"pct_ad":0.212889,"pct_control":0.211588,"donor_test":"not significant","donor_padj":0.927014,"donor_log2fc":0.0495556,"donor_lfcse":0.082994,"donor_log2fc_shrunk":0.00767824}],"modules":[{"cell_type":"In","gene_id":"ENSG00000104299","module":"red","kme":0.151652,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000104299","module":"blue","kme":0.10389,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000104299","entrez_id":["55756"],"uniprot":["Q9NV88"],"ncbi_summary":"This gene encodes a subunit of the Integrator complex. This protein complex binds the C-terminal domain of RNA polymerase II and likely plays a role in small nuclear RNA processing. The encoded protein has similarities to the subunits of the cleavage and polyadenylation specificity factor complex. Alternatively spliced transcript variants have been described.[provided by RefSeq, Feb 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NV88","text":"Component of the integrator complex, a multiprotein complex that terminates RNA polymerase II (Pol II) transcription in the promoter-proximal region of genes (PubMed:25201415, PubMed:33243860, PubMed:33548203, PubMed:38570683). The integrator complex provides a quality checkpoint during transcription elongation by driving premature transcription termination of transcripts that are unfavorably configured for transcriptional elongation: the complex terminates transcription by (1) catalyzing dephosphorylation of the C-terminal domain (CTD) of Pol II subunit POLR2A/RPB1 and SUPT5H/SPT5, (2) degrading the exiting nascent RNA transcript via endonuclease activity and (3) promoting the release of Pol II from bound DNA (PubMed:33243860, PubMed:38570683). The integrator complex is also involved in terminating the synthesis of non-coding Pol II transcripts, such as enhancer RNAs (eRNAs), small nuclear RNAs (snRNAs), telomerase RNAs and long non-coding RNAs (lncRNAs) (PubMed:16239144, PubMed:22252320, PubMed:26308897, PubMed:30737432). Mediates recruitment of cytoplasmic dynein to the nuclear envelope, probably as component of the integrator complex (PubMed:23904267)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}