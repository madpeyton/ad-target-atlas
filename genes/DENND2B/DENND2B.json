on":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.868586,"donor_log2fc":-0.0818626,"donor_lfcse":0.0909749,"donor_log2fc_shrunk":-0.0100194}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000166444","module":"brown","kme":0.167381,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000166444","module":"yellow","kme":0.406209,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000166444","module":"midnightblue","kme":0.427808,"hub":false,"module_direction":"higher in AD","module_padj":0.698612,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000166444","entrez_id":["6764"],"uniprot":["P78524"],"ncbi_summary":"This gene was identified by its ability to suppress the tumorigenicity of Hela cells in nude mice. The protein encoded by this gene contains a C-terminal region that shares similarity with the Rab 3 family of small GTP binding proteins. This protein preferentially binds to the SH3 domain of c-Abl kinase, and acts as a regulator of MAPK1/ERK2 kinase, which may contribute to its ability to reduce the tumorigenic phenotype in cells. Three alternatively spliced transcript variants of this gene encoding distinct isoforms are identified. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P78524","text":"[Isoform 1]: May be involved in cytoskeletal organization and tumorogenicity. Seems to be involved in a signaling transduction pathway leading to activation of MAPK1/ERK2. Plays a role in EGFR trafficking from recycling endosomes back to the cell membrane (PubMed:29030480). [Isoform 2]: Guanine nucleotide exchange factor (GEF) which may activate RAB9A and RAB9B. Promotes the exchange of GDP to GTP, converting inactive GDP-bound Rab proteins into their active GTP-bound form. [Isoform 3]: May block ERK2 activation stimulated by ABL1 (Probable). May alter cell morphology and cell growth (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}