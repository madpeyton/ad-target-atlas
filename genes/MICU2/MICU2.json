leus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.41186,"nucleus_log2fc":0.33933,"nucleus_score":1.49655,"pct_ad":0.110701,"pct_control":0.0873908,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"MICU2","gene_symbol_current":"MICU2","gene_id":"ENSG00000165487","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.299633,"nucleus_log2fc":-0.263058,"nucleus_score":-1.83365,"pct_ad":0.198587,"pct_control":0.227586,"donor_test":"not significant","donor_padj":0.976536,"donor_log2fc":-0.202255,"donor_lfcse":0.150699,"donor_log2fc_shrunk":-0.00191934},{"cell_type":"Oli","gene_symbol":"MICU2","gene_symbol_current":"MICU2","gene_id":"ENSG00000165487","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.310514,"nucleus_log2fc":0.0665234,"nucleus_score":1.25039,"pct_ad":0.148182,"pct_control":0.141174,"donor_test":"not significant","donor_padj":0.963644,"donor_log2fc":0.0177549,"donor_lfcse":0.0733166,"donor_log2fc_shrunk":0.0026314}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000165487","module":"greenyellow","kme":0.291349,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000165487","module":"blue","kme":0.125702,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000165487","module":"turquoise","kme":0.140555,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165487","entrez_id":["221154"],"uniprot":["Q8IYU8"],"ncbi_summary":"Enables protein heterodimerization activity. Involved in calcium import into the mitochondrion and negative regulation of mitochondrial calcium ion concentration. Located in mitochondrial inner membrane and mitochondrial intermembrane space. Part of uniplex complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IYU8","text":"Calcium sensor of the mitochondrial calcium uniporter (MCU) channel, which senses calcium level via its EF-hand domains (PubMed:24503055, PubMed:24560927, PubMed:26903221, PubMed:28615291, PubMed:30699349, PubMed:31397067, PubMed:32494073, PubMed:32667285, PubMed:32762847, PubMed:32790952). MICU1 and MICU2 form a disulfide-linked heterodimer that stimulates and inhibits MCU activity, depending on the concentration of calcium (PubMed:24560927, PubMed:26903221, PubMed:28615291, PubMed:30699349, PubMed:31397067, PubMed:32148862, PubMed:32494073, PubMed:32667285, PubMed:32762847, PubMed:32790952). At low calcium levels, MICU1 occludes the pore of the MCU channel, preventing mitochondrial calcium uptake (PubMed:32494073, PubMed:32667285, PubMed:32762847). At higher calcium levels, calcium-binding to MICU1 and MICU2 induces a conformational change that weakens MCU-MICU1 interactions and moves the MICU1-MICU2 heterodimer away from the pore, allowing calcium permeation through the MCU channel (PubMed:32494073, PubMed:32667285, PubMed:32762847)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}