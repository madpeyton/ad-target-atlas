l":0.211329,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0337908,"donor_lfcse":0.113553,"donor_log2fc_shrunk":2.73741e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000183654","module":"brown","kme":0.194778,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000183654","entrez_id":["441061"],"uniprot":["A6NNE9"],"ncbi_summary":"MARCH11 is a member of the MARCH family of membrane-bound E3 ubiquitin ligases (EC 6.3.2.19). These enzymes add ubiquitin (see MIM 191339) to target lysines in substrate proteins, thereby signaling their intracellular transport. March11 appears to have a role in ubiquitin-mediated protein sorting in the trans-Golgi network (TGN)-multivesicular body (MVB) transport pathway (Morokuma et al., 2007 [PubMed 17604280]).[supplied by OMIM, Apr 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"A6NNE9","text":"E3 ubiquitin-protein ligase that mediates polyubiquitination of CD4. E3 ubiquitin ligases accept ubiquitin from an E2 ubiquitin-conjugating enzyme in the form of a thioester and then directly transfer the ubiquitin to targeted substrates. May play a role in ubuquitin-dependent protein sorting in developmenting spermatids."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}