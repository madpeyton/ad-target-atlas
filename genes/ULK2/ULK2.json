_type":"OPC","gene_symbol":"ULK2","gene_symbol_current":"ULK2","gene_id":"ENSG00000083290","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.817877,"nucleus_log2fc":-0.0978686,"nucleus_score":-0.516727,"pct_ad":0.101256,"pct_control":0.10728,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"ULK2","gene_symbol_current":"ULK2","gene_id":"ENSG00000083290","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.758006,"donor_log2fc":-0.149548,"donor_lfcse":0.0933324,"donor_log2fc_shrunk":-0.017375}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000083290","module":"blue","kme":0.137991,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000083290","module":"blue","kme":0.178002,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000083290","module":"blue","kme":0.159203,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000083290","module":"blue","kme":0.127043,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000083290","module":"blue","kme":0.118232,"hub":false,"module_direction":"lower in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000083290","entrez_id":["9706"],"uniprot":["Q8IYT8"],"ncbi_summary":"This gene encodes a protein that is similar to a serine/threonine kinase in C. elegans which is involved in axonal elongation. The structure of this protein is similar to the C. elegans protein in that both proteins have an N-terminal kinase domain, a central proline/serine rich (PS) domain, and a C-terminal (C) domain. The gene is located within the Smith-Magenis syndrome region on chromosome 17. Alternatively spliced transcript variants encoding the same protein have been identified. [provided by RefSeq, Dec 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IYT8","text":"Serine/threonine-protein kinase involved in autophagy in response to starvation. Acts upstream of phosphatidylinositol 3-kinase PIK3C3 to regulate the formation of autophagophores, the precursors of autophagosomes. Part of regulatory feedback loops in autophagy: acts both as a downstream effector and a negative regulator of mammalian target of rapamycin complex 1 (mTORC1) via interaction with RPTOR. Activated via phosphorylation by AMPK, also acts as a negative regulator of AMPK through phosphorylation of the AMPK subunits PRKAA1, PRKAB2 and PRKAG1. May phosphorylate ATG13/KIAA0652, FRS2, FRS3 and RPTOR; however such data need additional evidence. Not involved in ammonia-induced autophagy or in autophagic response of cerebellar granule neurons (CGN) to low potassium concentration. Plays a role early in neuronal differentiation and is required for granule cell axon formation: may govern axon formation via Ras-like GTPase signaling and through regulation of the Rab5-mediated endocytic pathways within developing axons."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}