:"ULK2","gene_symbol_current":"ULK2","gene_id":"ENSG00000083290","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":4.87321e-32,"nucleus_log2fc":-0.419505,"nucleus_score":-12.0759,"pct_ad":0.391922,"pct_control":0.469124,"donor_test":"not significant","donor_padj":0.0693826,"donor_log2fc":-0.379002,"donor_lfcse":0.105005,"donor_log2fc_shrunk":-0.312609,"degas_log2fc":0.284485,"degas_padj":9.02272e-16},{"cell_type":"OPC","gene_symbol":"ULK2","gene_symbol_current":"ULK2","gene_id":"ENSG00000083290","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0911673,"nucleus_log2fc":-0.096136,"nucleus_score":-2.12357,"pct_ad":0.387414,"pct_control":0.404572,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0814799,"donor_lfcse":0.058788,"donor_log2fc_shrunk":-2.4661e-05,"degas_log2fc":-0.125595,"degas_padj":0.00492328},{"cell_type":"Oli","gene_symbol":"ULK2","gene_symbol_current":"ULK2","gene_id":"ENSG00000083290","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":8.95364e-54,"nucleus_log2fc":-0.260027,"nucleus_score":-15.5989,"pct_ad":0.447269,"pct_control":0.503007,"donor_test":"not significant","donor_padj":0.519643,"donor_log2fc":-0.172204,"donor_lfcse":0.0729893,"donor_log2fc_shrunk":-0.0651085,"degas_log2fc":-0.203046,"degas_padj":1.91052e-33}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000083290","module":"green","kme":0.17286,"hub":false,"module_direction":"lower in AD","module_padj":0.299526,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000083290","module":"turquoise","kme":0.0473038,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000083290","entrez_id":["9706"],"uniprot":["Q8IYT8"],"ncbi_summary":"This gene encodes a protein that is similar to a serine/threonine kinase in C. elegans which is involved in axonal elongation. The structure of this protein is similar to the C. elegans protein in that both proteins have an N-terminal kinase domain, a central proline/serine rich (PS) domain, and a C-terminal (C) domain. The gene is located within the Smith-Magenis syndrome region on chromosome 17. Alternatively spliced transcript variants encoding the same protein have been identified. [provided by RefSeq, Dec 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IYT8","text":"Serine/threonine-protein kinase involved in autophagy in response to starvation. Acts upstream of phosphatidylinositol 3-kinase PIK3C3 to regulate the formation of autophagophores, the precursors of autophagosomes. Part of regulatory feedback loops in autophagy: acts both as a downstream effector and a negative regulator of mammalian target of rapamycin complex 1 (mTORC1) via interaction with RPTOR. Activated via phosphorylation by AMPK, also acts as a negative regulator of AMPK through phosphorylation of the AMPK subunits PRKAA1, PRKAB2 and PRKAG1. May phosphorylate ATG13/KIAA0652, FRS2, FRS3 and RPTOR; however such data need additional evidence. Not involved in ammonia-induced autophagy or in autophagic response of cerebellar granule neurons (CGN) to low potassium concentration. Plays a role early in neuronal differentiation and is required for granule cell axon formation: may govern axon formation via Ras-like GTPase signaling and through regulation of the Rab5-mediated endocytic pathways within developing axons."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}