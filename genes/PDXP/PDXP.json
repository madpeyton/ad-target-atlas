47491}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000241360","module":"brown","kme":0.367627,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000241360","module":"brown","kme":0.310281,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000241360","module":"turquoise","kme":0.0620557,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000241360","entrez_id":["57026"],"uniprot":["Q96GD0"],"ncbi_summary":"Pyridoxal 5-prime-phosphate (PLP) is the active form of vitamin B6 that acts as a coenzyme in maintaining biochemical homeostasis. The preferred degradation route from PLP to 4-pyridoxic acid involves the dephosphorylation of PLP by PDXP (Jang et al., 2003 [PubMed 14522954]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96GD0","text":"Functions as a pyridoxal phosphate (PLP) phosphatase, which also catalyzes the dephosphorylation of pyridoxine 5'-phosphate (PNP) and pyridoxamine 5'-phosphate (PMP), with order of substrate preference PLP > PNP > PMP and therefore plays a role in vitamin B6 metabolism (PubMed:14522954, PubMed:8132548). Also functions as a protein serine phosphatase that specifically dephosphorylates 'Ser-3' in proteins of the actin-depolymerizing factor (ADF)/cofilin family like CFL1 and DSTN. Thereby, regulates cofilin-dependent actin cytoskeleton reorganization, being required for normal progress through mitosis and normal cytokinesis. Does not dephosphorylate phosphothreonines in LIMK1. Does not dephosphorylate peptides containing phosphotyrosine (PubMed:15580268)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}