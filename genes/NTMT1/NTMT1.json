c":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.662522,"donor_log2fc":0.149565,"donor_lfcse":0.112243,"donor_log2fc_shrunk":0.024253},{"cell_type":"OPC","gene_symbol":"NTMT1","gene_symbol_current":"NTMT1","gene_id":"ENSG00000148335","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.159289,"donor_lfcse":0.14566,"donor_log2fc_shrunk":-7.69612e-06},{"cell_type":"Oli","gene_symbol":"NTMT1","gene_symbol_current":"NTMT1","gene_id":"ENSG00000148335","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.600838,"donor_log2fc":0.176224,"donor_lfcse":0.0872902,"donor_log2fc_shrunk":0.0298826}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000148335","module":"turquoise","kme":0.0730032,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000148335","module":"turquoise","kme":0.0574089,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000148335","entrez_id":["28989"],"uniprot":["Q9BV86"],"ncbi_summary":"The METTL11A gene encodes an N-terminal methyltransferase for the RAN (MIM 601179) guanine nucleotide exchange factor regulator of chromosome condensation 1 (RCC1; MIM 179710). METTL11A enzyme alpha-N-methylates other protein targets such as SET (MIM 600960) and RB (MIM 180200).[supplied by OMIM, Nov 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BV86","text":"Distributive alpha-N-methyltransferase that methylates the N-terminus of target proteins containing the N-terminal motif [Ala/Gly/Pro/Ser]-Pro-Lys when the initiator Met is cleaved. Specifically catalyzes mono-, di- or tri-methylation of the exposed alpha-amino group of the Ala, Gly or Ser residue in the [Ala/Gly/Ser]-Pro-Lys motif and mono- or di-methylation of Pro in the Pro-Pro-Lys motif. Some of the substrates may be primed by NTMT2-mediated monomethylation (PubMed:24090352). Catalyzes the trimethylation of the N-terminal Gly in CENPA (after removal of Met-1). Responsible for the N-terminal methylation of KLHL31, MYL2, MYL3, RB1, RCC1, RPL23A and SET. Required during mitosis for normal bipolar spindle formation and chromosome segregation via its action on RCC1."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}