:0.374761,"donor_test":"not significant","donor_padj":0.847348,"donor_log2fc":-0.0506035,"donor_lfcse":0.0489174,"donor_log2fc_shrunk":-0.0172571}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000111530","module":"turquoise","kme":0.129663,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000111530","module":"brown","kme":0.215963,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000111530","module":"turquoise","kme":0.0374978,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000111530","module":"turquoise","kme":0.0505953,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000111530","entrez_id":["55832"],"uniprot":["Q86VP6"],"ncbi_summary":"This gene encodes an essential regulator of Cullin-RING ubiquitin ligases, which are in involved in ubiquitinylation of proteins degraded by the Ub proteasome system. The encoded protein binds to unneddylated cullin-RING box protein complexes and acts as an inhibitor of cullin neddylation and of Skp1, cullin, and F box ubiquitin ligase complex assembly and activity. In mammalian cell culture, this protein predominantly localizes to the cytoplasm. Knockdown of this gene in preadipocytes results in blocked adipogenesis. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jul 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86VP6","text":"Key assembly factor of SCF (SKP1-CUL1-F-box protein) E3 ubiquitin ligase complexes that promotes the exchange of the substrate-recognition F-box subunit in SCF complexes, thereby playing a key role in the cellular repertoire of SCF complexes. Acts as a F-box protein exchange factor. The exchange activity of CAND1 is coupled with cycles of neddylation conjugation: in the deneddylated state, cullin-binding CAND1 binds CUL1-RBX1, increasing dissociation of the SCF complex and promoting exchange of the F-box protein. Probably plays a similar role in other cullin-RING E3 ubiquitin ligase complexes."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}