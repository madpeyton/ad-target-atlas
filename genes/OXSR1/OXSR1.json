dules":[],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000172939"],"dataset_symbols":["OXSR1"],"explorer":"explorer.html?dataset=mathys2019#gene/OXSR1","cell_types":[{"cell_type":"Ast","gene_symbol":"OXSR1","gene_symbol_current":"OXSR1","gene_id":"ENSG00000172939","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.942681,"nucleus_log2fc":0.0771411,"nucleus_score":0.107438,"pct_ad":0.101996,"pct_control":0.102147,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Ex","gene_symbol":"OXSR1","gene_symbol_current":"OXSR1","gene_id":"ENSG00000172939","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000357129,"nucleus_log2fc":-0.0971665,"nucleus_score":-3.85418,"pct_ad":0.341934,"pct_control":0.37167,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0820204,"donor_lfcse":0.0512477,"donor_log2fc_shrunk":-3.32362e-05},{"cell_type":"In","gene_symbol":"OXSR1","gene_symbol_current":"OXSR1","gene_id":"ENSG00000172939","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.555296,"nucleus_log2fc":-0.141616,"nucleus_score":-1.33312,"pct_ad":0.181899,"pct_control":0.194522,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.170232,"donor_lfcse":0.110636,"donor_log2fc_shrunk":-1.46675e-05},{"cell_type":"OPC","gene_symbol":"OXSR1","gene_symbol_current":"OXSR1","gene_id":"ENSG00000172939","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.478112,"nucleus_log2fc":-0.179711,"nucleus_score":-1.32845,"pct_ad":0.10675,"pct_control":0.124904,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"OXSR1","gene_symbol_current":"OXSR1","gene_id":"ENSG00000172939","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.777566,"donor_log2fc":-0.192299,"donor_lfcse":0.136837,"donor_log2fc_shrunk":-0.0101066}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000172939","module":"blue","kme":0.137533,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000172939","entrez_id":["9943"],"uniprot":["O95747"],"ncbi_summary":"The product of this gene belongs to the Ser/Thr protein kinase family of proteins. It regulates downstream kinases in response to environmental stress, and may play a role in regulating the actin cytoskeleton. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95747","text":"Effector serine/threonine-protein kinase component of the WNK-SPAK/OSR1 kinase cascade, which is involved in various processes, such as ion transport, response to hypertonic stress and blood pressure (PubMed:16669787, PubMed:18270262, PubMed:21321328, PubMed:34289367). Specifically recognizes and binds proteins with a RFXV motif (PubMed:16669787, PubMed:17721439, PubMed:21321328). Acts downstream of WNK kinases (WNK1, WNK2, WNK3 or WNK4): following activation by WNK kinases, catalyzes phosphorylation of ion cotransporters, such as SLC12A1/NKCC2, SLC12A2/NKCC1, SLC12A3/NCC, SLC12A5/KCC2 or SLC12A6/KCC3, regulating their activity (PubMed:17721439). Mediates regulatory volume increase in response to hyperosmotic stress by catalyzing phosphorylation of ion cotransporters SLC12A1/NKCC2, SLC12A2/NKCC1 and SLC12A6/KCC3 downstream of WNK1 and WNK3 kinases (PubMed:16669787, PubMed:21321328). Phosphorylation of Na-K-Cl cotransporters SLC12A2/NKCC1 and SLC12A2/NKCC1 promote their activation and ion influx; simultaneously, phosphorylation of K-Cl cotransporters SLC12A5/KCC2 and SLC12A6/KCC3 inhibit their activity, blocking ion efflux (PubMed:16669787, PubMed:19665974, PubMed:21321328). Acts as a regulator of NaCl reabsorption in the distal nephron by mediating phosphorylation and activation of the thiazide-sensitive Na-Cl cotransporter SLC12A3/NCC in distal convoluted tubule cells of kidney downstream of WNK4 (PubMed:18270262). Also acts as a regulator of angiogenesis in endothelial cells downstream of WNK1 (PubMed:23386621, PubMed:25362046). Acts as an activator of inward rectifier potassium channels KCNJ2/Kir2.1 and KCNJ4/Kir2.3 downstream of WNK1: recognizes and binds the RXFXV/I variant motif on KCNJ2/Kir2.1 and KCNJ4/Kir2.3 and regulates their localization to the cell membrane without mediating their phosphorylation (PubMed:29581290). Phosphorylates RELL1, RELL2 and RELT (PubMed:16389068, PubMed:28688764). Phosphorylates PAK1 (PubMed:14707132). Phosphorylates PLSCR1 in the presence of RELT (PubMed:22052202)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}