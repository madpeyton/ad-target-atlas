rection":"higher in AD","nucleus_padj":0.812593,"nucleus_log2fc":0.00292888,"nucleus_score":0.251416,"pct_ad":0.828331,"pct_control":0.826439,"donor_test":"not significant","donor_padj":0.952107,"donor_log2fc":0.0173588,"donor_lfcse":0.082468,"donor_log2fc_shrunk":0.00211247,"degas_log2fc":-0.155824,"degas_padj":7.46937e-256},{"cell_type":"In","gene_symbol":"OXSR1","gene_symbol_current":"OXSR1","gene_id":"ENSG00000172939","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.53281e-07,"nucleus_log2fc":-0.0442638,"nucleus_score":-5.34019,"pct_ad":0.595456,"pct_control":0.608294,"donor_test":"not significant","donor_padj":0.94052,"donor_log2fc":0.0241364,"donor_lfcse":0.0781215,"donor_log2fc_shrunk":0.00201551,"degas_log2fc":-0.202781,"degas_padj":1.00705e-134},{"cell_type":"Mic","gene_symbol":"OXSR1","gene_symbol_current":"OXSR1","gene_id":"ENSG00000172939","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000127717,"nucleus_log2fc":0.160049,"nucleus_score":4.13765,"pct_ad":0.37688,"pct_control":0.351728,"donor_test":"not significant","donor_padj":0.551331,"donor_log2fc":0.18222,"donor_lfcse":0.109593,"donor_log2fc_shrunk":0.0338886,"degas_log2fc":-0.04946,"degas_padj":0.246175},{"cell_type":"OPC","gene_symbol":"OXSR1","gene_symbol_current":"OXSR1","gene_id":"ENSG00000172939","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.221045,"nucleus_log2fc":-0.0855502,"nucleus_score":-1.60439,"pct_ad":0.382493,"pct_control":0.391363,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0912988,"donor_lfcse":0.100014,"donor_log2fc_shrunk":7.21064e-05,"degas_log2fc":-0.544775,"degas_padj":4.26411e-36},{"cell_type":"Oli","gene_symbol":"OXSR1","gene_symbol_current":"OXSR1","gene_id":"ENSG00000172939","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.87079,"nucleus_log2fc":0.0100177,"nucleus_score":-0.191892,"pct_ad":0.243075,"pct_control":0.244436,"donor_test":"not significant","donor_padj":0.990047,"donor_log2fc":0.0096942,"donor_lfcse":0.111013,"donor_log2fc_shrunk":0.000812133,"degas_log2fc":-0.266362,"degas_padj":6.29072e-29}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000172939","module":"blue","kme":0.132959,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000172939","module":"blue","kme":0.13331,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000172939","entrez_id":["9943"],"uniprot":["O95747"],"ncbi_summary":"The product of this gene belongs to the Ser/Thr protein kinase family of proteins. It regulates downstream kinases in response to environmental stress, and may play a role in regulating the actin cytoskeleton. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95747","text":"Effector serine/threonine-protein kinase component of the WNK-SPAK/OSR1 kinase cascade, which is involved in various processes, such as ion transport, response to hypertonic stress and blood pressure (PubMed:16669787, PubMed:18270262, PubMed:21321328, PubMed:34289367). Specifically recognizes and binds proteins with a RFXV motif (PubMed:16669787, PubMed:17721439, PubMed:21321328). Acts downstream of WNK kinases (WNK1, WNK2, WNK3 or WNK4): following activation by WNK kinases, catalyzes phosphorylation of ion cotransporters, such as SLC12A1/NKCC2, SLC12A2/NKCC1, SLC12A3/NCC, SLC12A5/KCC2 or SLC12A6/KCC3, regulating their activity (PubMed:17721439). Mediates regulatory volume increase in response to hyperosmotic stress by catalyzing phosphorylation of ion cotransporters SLC12A1/NKCC2, SLC12A2/NKCC1 and SLC12A6/KCC3 downstream of WNK1 and WNK3 kinases (PubMed:16669787, PubMed:21321328). Phosphorylation of Na-K-Cl cotransporters SLC12A2/NKCC1 and SLC12A2/NKCC1 promote their activation and ion influx; simultaneously, phosphorylation of K-Cl cotransporters SLC12A5/KCC2 and SLC12A6/KCC3 inhibit their activity, blocking ion efflux (PubMed:16669787, PubMed:19665974, PubMed:21321328). Acts as a regulator of NaCl reabsorption in the distal nephron by mediating phosphorylation and activation of the thiazide-sensitive Na-Cl cotransporter SLC12A3/NCC in distal convoluted tubule cells of kidney downstream of WNK4 (PubMed:18270262). Also acts as a regulator of angiogenesis in endothelial cells downstream of WNK1 (PubMed:23386621, PubMed:25362046). Acts as an activator of inward rectifier potassium channels KCNJ2/Kir2.1 and KCNJ4/Kir2.3 downstream of WNK1: recognizes and binds the RXFXV/I variant motif on KCNJ2/Kir2.1 and KCNJ4/Kir2.3 and regulates their localization to the cell membrane without mediating their phosphorylation (PubMed:29581290). Phosphorylates RELL1, RELL2 and RELT (PubMed:16389068, PubMed:28688764). Phosphorylates PAK1 (PubMed:14707132). Phosphorylates PLSCR1 in the presence of RELT (PubMed:22052202)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}