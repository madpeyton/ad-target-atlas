fcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"NRDE2","gene_symbol_current":"NRDE2","gene_id":"ENSG00000119720","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.942097,"donor_log2fc":-0.0635858,"donor_lfcse":0.130144,"donor_log2fc_shrunk":-0.00348918}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000119720","module":"blue","kme":0.131756,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000119720","module":"green","kme":0.0507386,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000119720","module":"red","kme":0.173872,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000119720","entrez_id":["55051"],"uniprot":["Q9H7Z3"],"ncbi_summary":"Involved in several processes, including RNA splicing; negative regulation of RNA catabolic process; and positive regulation of RNA export from nucleus. Located in nuclear speck and nucleolus. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H7Z3","text":"Protein of the nuclear speckles that regulates RNA degradation and export from the nucleus through its interaction with MTREX an essential factor directing various RNAs to exosomal degradation (PubMed:30842217). Changes the conformation of MTREX, precluding its association with the nuclear exosome and interaction with proteins required for its function in RNA exosomal degradation (PubMed:30842217). Negatively regulates, for instance, the degradation of mRNAs and lncRNAs by inhibiting their MTREX-mediated recruitment to nuclear exosome (PubMed:30842217). By preventing the degradation of RNAs in the nucleus, it promotes their export to the cytoplasm (PubMed:30842217). U5 snRNP-associated RNA splicing factor which is required for efficient splicing of CEP131 pre-mRNA and plays an important role in centrosome maturation, integrity and function during mitosis (PubMed:30538148). Suppresses intron retention in a subset of pre-mRNAs containing short, GC-rich introns with relatively weak 5' and 3' splice sites (PubMed:30538148). Plays a role in DNA damage response (PubMed:29902117)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}