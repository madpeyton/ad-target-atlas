cant","donor_padj":0.720722,"donor_log2fc":0.194858,"donor_lfcse":0.168327,"donor_log2fc_shrunk":0.0139567,"degas_log2fc":0.775805,"degas_padj":1.70507e-107},{"cell_type":"OPC","gene_symbol":"PILRA","gene_symbol_current":"PILRA","gene_id":"ENSG00000085514","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0301203,"donor_lfcse":0.154244,"donor_log2fc_shrunk":-1.31476e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"PILRA","gene_symbol_current":"PILRA","gene_id":"ENSG00000085514","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0689912,"nucleus_log2fc":-0.0385272,"nucleus_score":-1.94456,"pct_ad":0.111904,"pct_control":0.116725,"donor_test":"not significant","donor_padj":0.997243,"donor_log2fc":-0.00239224,"donor_lfcse":0.107614,"donor_log2fc_shrunk":-0.000194027,"degas_log2fc":-0.187419,"degas_padj":1.24199e-07}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000085514","module":"brown","kme":0.106021,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000085514","module":"pink","kme":0.173465,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000085514","module":"green","kme":0.189491,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000085514","entrez_id":["29992"],"uniprot":["Q9UKJ1"],"ncbi_summary":"Cell signaling pathways rely on a dynamic interaction between activating and inhibiting processes. SHP-1-mediated dephosphorylation of protein tyrosine residues is central to the regulation of several cell signaling pathways. Two types of inhibitory receptor superfamily members are immunoreceptor tyrosine-based inhibitory motif (ITIM)-bearing receptors and their non-ITIM-bearing, activating counterparts. Control of cell signaling via SHP-1 is thought to occur through a balance between PILRalpha-mediated inhibition and PILRbeta-mediated activation. These paired immunoglobulin-like receptor genes are located in a tandem head-to-tail orientation on chromosome 7. This particular gene encodes the ITIM-bearing member of the receptor pair, which functions in the inhibitory role. Alternative splicing has been observed at this locus and three variants, each encoding a distinct isoform, are described. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UKJ1","text":"Paired receptors consist of highly related activating and inhibitory receptors and are widely involved in the regulation of the immune system. PILRA is thought to act as a cellular signaling inhibitory receptor by recruiting cytoplasmic phosphatases like PTPN6/SHP-1 and PTPN11/SHP-2 via their SH2 domains that block signal transduction through dephosphorylation of signaling molecules. Receptor for PIANP. (Microbial infection) Acts as an entry co-receptor for herpes simplex virus 1."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}