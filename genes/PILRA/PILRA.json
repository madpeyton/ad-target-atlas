ILRA"],"explorer":"explorer.html?dataset=mathys2019#gene/PILRA","cell_types":[{"cell_type":"Ex","gene_symbol":"PILRA","gene_symbol_current":"PILRA","gene_id":"ENSG00000085514","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.338836,"nucleus_log2fc":0.130281,"nucleus_score":1.10841,"pct_ad":0.205912,"pct_control":0.203302,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":0.0731648,"donor_lfcse":0.146109,"donor_log2fc_shrunk":3.56259e-06},{"cell_type":"In","gene_symbol":"PILRA","gene_symbol_current":"PILRA","gene_id":"ENSG00000085514","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.404251,"nucleus_log2fc":0.232105,"nucleus_score":1.72284,"pct_ad":0.12866,"pct_control":0.113601,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.268879,"donor_lfcse":0.193554,"donor_log2fc_shrunk":7.26942e-06},{"cell_type":"Mic","gene_symbol":"PILRA","gene_symbol_current":"PILRA","gene_id":"ENSG00000085514","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.120882,"nucleus_log2fc":0.536091,"nucleus_score":2.42091,"pct_ad":0.145141,"pct_control":0.104869,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"In","gene_id":"ENSG00000085514","module":"yellow","kme":0.0805656,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000085514","entrez_id":["29992"],"uniprot":["Q9UKJ1"],"ncbi_summary":"Cell signaling pathways rely on a dynamic interaction between activating and inhibiting processes. SHP-1-mediated dephosphorylation of protein tyrosine residues is central to the regulation of several cell signaling pathways. Two types of inhibitory receptor superfamily members are immunoreceptor tyrosine-based inhibitory motif (ITIM)-bearing receptors and their non-ITIM-bearing, activating counterparts. Control of cell signaling via SHP-1 is thought to occur through a balance between PILRalpha-mediated inhibition and PILRbeta-mediated activation. These paired immunoglobulin-like receptor genes are located in a tandem head-to-tail orientation on chromosome 7. This particular gene encodes the ITIM-bearing member of the receptor pair, which functions in the inhibitory role. Alternative splicing has been observed at this locus and three variants, each encoding a distinct isoform, are described. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UKJ1","text":"Paired receptors consist of highly related activating and inhibitory receptors and are widely involved in the regulation of the immune system. PILRA is thought to act as a cellular signaling inhibitory receptor by recruiting cytoplasmic phosphatases like PTPN6/SHP-1 and PTPN11/SHP-2 via their SH2 domains that block signal transduction through dephosphorylation of signaling molecules. Receptor for PIANP. (Microbial infection) Acts as an entry co-receptor for herpes simplex virus 1."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}