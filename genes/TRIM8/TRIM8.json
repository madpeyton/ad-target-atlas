:[{"cell_type":"Astrocytes","gene_id":"ENSG00000171206","module":"turquoise","kme":0.0658476,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000171206","module":"turquoise","kme":0.153061,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000171206"],"dataset_symbols":["TRIM8"],"explorer":"explorer.html?dataset=mathys2019#gene/TRIM8","cell_types":[{"cell_type":"Ast","gene_symbol":"TRIM8","gene_symbol_current":"TRIM8","gene_id":"ENSG00000171206","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.509409,"nucleus_log2fc":0.124938,"nucleus_score":0.872672,"pct_ad":0.105322,"pct_control":0.0962915,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Ex","gene_symbol":"TRIM8","gene_symbol_current":"TRIM8","gene_id":"ENSG00000171206","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000994583,"nucleus_log2fc":0.252809,"nucleus_score":3.56725,"pct_ad":0.1218,"pct_control":0.107035,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.261492,"donor_lfcse":0.120854,"donor_log2fc_shrunk":1.8263e-05},{"cell_type":"In","gene_symbol":"TRIM8","gene_symbol_current":"TRIM8","gene_id":"ENSG00000171206","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0789201,"donor_lfcse":0.188909,"donor_log2fc_shrunk":-2.27268e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000171206","module":"turquoise","kme":0.130838,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000171206","entrez_id":["81603"],"uniprot":["Q9BZR9"],"ncbi_summary":"This gene encodes a member of the tripartite motif (TRIM) protein family. Based on similarities to other proteins, the encoded protein is suspected to be an E3 ubiquitin-protein ligase. Regulation of this gene may be altered in some cancers. Mutations resulting in a truncated protein product have been observed in early-onset epileptic encephalopathy (EOEE). [provided by RefSeq, Sep 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BZR9","text":"E3 ubiquitin-protein ligase that participates in multiple biological processes including cell survival, differentiation, apoptosis, and in particular, the innate immune response (PubMed:27981609, PubMed:28747347). Participates in the activation of interferon-gamma signaling by promoting proteasomal degradation of the repressor SOCS1 (PubMed:12163497). Plays a positive role in the TNFalpha and IL-1beta signaling pathways. Mechanistically, induces the 'Lys-63'-linked polyubiquitination of MAP3K7/TAK1 component leading to the activation of NF-kappa-B (PubMed:22084099, PubMed:23152791, PubMed:27981609, PubMed:34871740). Also modulates STAT3 activity through negative regulation of PIAS3, either by degradation of PIAS3 through the ubiquitin-proteasome pathway or exclusion of PIAS3 from the nucleus (PubMed:20516148). Negatively regulates TLR3/4-mediated innate immune response by catalyzing 'Lys-6'- and 'Lys-33'-linked polyubiquitination of TICAM1 and thereby disrupting the TICAM1-TBK1 interaction (PubMed:28747347)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}