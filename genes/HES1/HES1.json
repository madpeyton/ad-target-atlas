0.0917089,"pct_control":0.102117,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0821886,"donor_lfcse":0.372187,"donor_log2fc_shrunk":-6.00286e-07}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000114315","module":"turquoise","kme":0.270463,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000114315","module":"turquoise","kme":0.138736,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000114315","entrez_id":["3280"],"uniprot":["Q14469"],"ncbi_summary":"This protein belongs to the basic helix-loop-helix family of transcription factors. It is a transcriptional repressor of genes that require a bHLH protein for their transcription. The protein has a particular type of basic domain that contains a helix interrupting protein that binds to the N-box rather than the canonical E-box. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q14469","text":"Transcriptional repressor of genes that require a bHLH protein for their transcription. May act as a negative regulator of myogenesis by inhibiting the functions of MYOD1 and ASH1. Binds DNA on N-box motifs: 5'-CACNAG-3' with high affinity and on E-box motifs: 5'-CANNTG-3' with low affinity (By similarity). May play a role in a functional FA core complex response to DNA cross-link damage, being required for the stability and nuclear localization of FA core complex proteins, as well as for FANCD2 monoubiquitination in response to DNA damage."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}