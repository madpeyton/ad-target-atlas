t","donor_padj":0.883287,"donor_log2fc":0.0367428,"donor_lfcse":0.0805349,"donor_log2fc_shrunk":0.0046851},{"cell_type":"In","gene_symbol":"BICD2","gene_symbol_current":"BICD2","gene_id":"ENSG00000185963","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0175803,"nucleus_log2fc":-0.022999,"nucleus_score":-2.44789,"pct_ad":0.29012,"pct_control":0.29619,"donor_test":"not significant","donor_padj":0.84653,"donor_log2fc":0.0400436,"donor_lfcse":0.0556183,"donor_log2fc_shrunk":0.00357241},{"cell_type":"Mic","gene_symbol":"BICD2","gene_symbol_current":"BICD2","gene_id":"ENSG00000185963","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.072441,"nucleus_log2fc":0.0966599,"nucleus_score":2.05248,"pct_ad":0.274466,"pct_control":0.261636,"donor_test":"not significant","donor_padj":0.993144,"donor_log2fc":0.0038005,"donor_lfcse":0.09467,"donor_log2fc_shrunk":0.00062134},{"cell_type":"OPC","gene_symbol":"BICD2","gene_symbol_current":"BICD2","gene_id":"ENSG00000185963","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.528183,"nucleus_log2fc":0.0420231,"nucleus_score":0.890769,"pct_ad":0.175216,"pct_control":0.168501,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0283552,"donor_lfcse":0.0983908,"donor_log2fc_shrunk":3.04387e-06},{"cell_type":"Oli","gene_symbol":"BICD2","gene_symbol_current":"BICD2","gene_id":"ENSG00000185963","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":5.95131e-06,"nucleus_log2fc":0.144356,"nucleus_score":4.68342,"pct_ad":0.135013,"pct_control":0.123019,"donor_test":"not significant","donor_padj":0.698967,"donor_log2fc":0.182539,"donor_lfcse":0.113314,"donor_log2fc_shrunk":0.0155932}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000185963","module":"blue","kme":0.155478,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000185963","entrez_id":["23299"],"uniprot":["Q8TD16"],"ncbi_summary":"This gene is one of two human homologs of Drosophila bicaudal-D and a member of the Bicoid family. It has been implicated in dynein-mediated, minus end-directed motility along microtubules. It has also been reported to be a phosphorylation target of NIMA related kinase 8. Two alternative splice variants have been described. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TD16","text":"Acts as an adapter protein linking the dynein motor complex to various cargos and converts dynein from a non-processive to a highly processive motor in the presence of dynactin. Facilitates and stabilizes the interaction between dynein and dynactin and activates dynein processivity (the ability to move along a microtubule for a long distance without falling off the track) (PubMed:25814576). Facilitates the binding of RAB6A to the Golgi by stabilizing its GTP-bound form. Regulates coat complex coatomer protein I (COPI)-independent Golgi-endoplasmic reticulum transport via its interaction with RAB6A and recruitment of the dynein-dynactin motor complex (PubMed:25962623). Contributes to nuclear and centrosomal positioning prior to mitotic entry through regulation of both dynein and kinesin-1. During G2 phase of the cell cycle, associates with RANBP2 at the nuclear pores and recruits dynein and dynactin to the nuclear envelope to ensure proper positioning of the nucleus relative to centrosomes prior to the onset of mitosis (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}