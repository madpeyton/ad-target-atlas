9},{"cell_type":"In","gene_symbol":"CEP63","gene_symbol_current":"CEP63","gene_id":"ENSG00000182923","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":6.91584e-16,"nucleus_log2fc":0.0785331,"nucleus_score":8.17788,"pct_ad":0.592288,"pct_control":0.583012,"donor_test":"not significant","donor_padj":0.671743,"donor_log2fc":0.138201,"donor_lfcse":0.0602555,"donor_log2fc_shrunk":0.0244308},{"cell_type":"Mic","gene_symbol":"CEP63","gene_symbol_current":"CEP63","gene_id":"ENSG00000182923","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.150364,"nucleus_log2fc":-0.0453646,"nucleus_score":-1.6719,"pct_ad":0.300743,"pct_control":0.314862,"donor_test":"not significant","donor_padj":0.798766,"donor_log2fc":-0.0654948,"donor_lfcse":0.0728741,"donor_log2fc_shrunk":-0.0201853},{"cell_type":"OPC","gene_symbol":"CEP63","gene_symbol_current":"CEP63","gene_id":"ENSG00000182923","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.161104,"nucleus_log2fc":0.0725766,"nucleus_score":1.80724,"pct_ad":0.425589,"pct_control":0.411008,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0635375,"donor_lfcse":0.0616111,"donor_log2fc_shrunk":1.74739e-05},{"cell_type":"Oli","gene_symbol":"CEP63","gene_symbol_current":"CEP63","gene_id":"ENSG00000182923","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0457993,"nucleus_log2fc":0.0593805,"nucleus_score":2.12715,"pct_ad":0.32254,"pct_control":0.317438,"donor_test":"not significant","donor_padj":0.858161,"donor_log2fc":0.0667819,"donor_lfcse":0.0680559,"donor_log2fc_shrunk":0.0130003}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000182923","entrez_id":["80254"],"uniprot":["Q96MT8"],"ncbi_summary":"This gene encodes a protein with six coiled-coil domains. The protein is localized to the centrosome, a non-membraneous organelle that functions as the major microtubule-organizing center in animal cells. Several alternatively spliced transcript variants have been found, but their biological validity has not been determined. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96MT8","text":"Required for normal spindle assembly (PubMed:21406398, PubMed:21983783, PubMed:26297806, PubMed:35793002). Plays a key role in mother-centriole-dependent centriole duplication; the function seems also to involve CEP152, CDK5RAP2 and WDR62 through a stepwise assembled complex at the centrosome that recruits CDK2 required for centriole duplication (PubMed:21983783, PubMed:26297806). Reported to be required for centrosomal recruitment of CEP152; however, this function has been questioned (PubMed:21983783, PubMed:26297806). Also recruits CDK1 to centrosomes (PubMed:21406398). Plays a role in DNA damage response (PubMed:21406398). Following DNA damage, such as double-strand breaks (DSBs), is removed from centrosomes; this leads to the inactivation of spindle assembly and delay in mitotic progression (PubMed:21406398). Promotes stabilization of FXR1 protein by inhibiting FXR1 ubiquitination (PubMed:35989368)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}