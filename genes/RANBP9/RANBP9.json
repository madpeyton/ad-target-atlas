ne_id":"ENSG00000010017","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.765152,"nucleus_log2fc":-0.175555,"nucleus_score":-0.65795,"pct_ad":0.123001,"pct_control":0.132335,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"RANBP9","gene_symbol_current":"RANBP9","gene_id":"ENSG00000010017","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.594201,"nucleus_log2fc":-0.137588,"nucleus_score":-1.05184,"pct_ad":0.160126,"pct_control":0.177011,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":-0.127312,"donor_lfcse":0.164146,"donor_log2fc_shrunk":-0.000967622},{"cell_type":"Oli","gene_symbol":"RANBP9","gene_symbol_current":"RANBP9","gene_id":"ENSG00000010017","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.986774,"donor_log2fc":0.0090198,"donor_lfcse":0.0980762,"donor_log2fc_shrunk":0.000832127}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000010017","module":"purple","kme":0.263039,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000010017","entrez_id":["10048"],"uniprot":["Q96S59"],"ncbi_summary":"This gene encodes a protein that binds RAN, a small GTP binding protein belonging to the RAS superfamily that is essential for the translocation of RNA and proteins through the nuclear pore complex. The protein encoded by this gene has also been shown to interact with several other proteins, including met proto-oncogene, homeodomain interacting protein kinase 2, androgen receptor, and cyclin-dependent kinase 11. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96S59","text":"May act as scaffolding protein, and as adapter protein to couple membrane receptors to intracellular signaling pathways (Probable). Acts as a mediator of cell spreading and actin cytoskeleton rearrangement (PubMed:18710924). Core component of the CTLH E3 ubiquitin-protein ligase complex that selectively accepts ubiquitin from UBE2H and mediates ubiquitination and subsequent proteasomal degradation of the transcription factor HBP1 (PubMed:29911972). May be involved in signaling of ITGB2/LFA-1 and other integrins (PubMed:14722085). Enhances HGF-MET signaling by recruiting Sos and activating the Ras pathway (PubMed:12147692). Enhances dihydrotestosterone-induced transactivation activity of AR, as well as dexamethasone-induced transactivation activity of NR3C1, but not affect estrogen-induced transactivation (PubMed:12361945, PubMed:18222118). Stabilizes TP73 isoform Alpha, probably by inhibiting its ubiquitination, and increases its proapoptotic activity (PubMed:15558019). Inhibits the kinase activity of DYRK1A and DYRK1B. Inhibits FMR1 binding to RNA."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}