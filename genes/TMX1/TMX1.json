sted":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0390438,"nucleus_log2fc":-0.0210443,"nucleus_score":-2.13391,"pct_ad":0.171993,"pct_control":0.176302,"donor_test":"not significant","donor_padj":0.856249,"donor_log2fc":0.050708,"donor_lfcse":0.0754865,"donor_log2fc_shrunk":0.00151113},{"cell_type":"Mic","gene_symbol":"TMX1","gene_symbol_current":"TMX1","gene_id":"ENSG00000139921","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.569632,"nucleus_log2fc":0.039774,"nucleus_score":0.715014,"pct_ad":0.245218,"pct_control":0.241935,"donor_test":"not significant","donor_padj":0.980121,"donor_log2fc":-0.012549,"donor_lfcse":0.0861644,"donor_log2fc_shrunk":-0.00281723},{"cell_type":"OPC","gene_symbol":"TMX1","gene_symbol_current":"TMX1","gene_id":"ENSG00000139921","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.86095,"nucleus_log2fc":0.00531263,"nucleus_score":0.27987,"pct_ad":0.210856,"pct_control":0.207282,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0403819,"donor_lfcse":0.0907916,"donor_log2fc_shrunk":1.25109e-05},{"cell_type":"Oli","gene_symbol":"TMX1","gene_symbol_current":"TMX1","gene_id":"ENSG00000139921","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":3.15358e-11,"nucleus_log2fc":0.195224,"nucleus_score":6.79793,"pct_ad":0.153528,"pct_control":0.135298,"donor_test":"not significant","donor_padj":0.785657,"donor_log2fc":0.147535,"donor_lfcse":0.113949,"donor_log2fc_shrunk":0.0124136}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000139921","module":"turquoise","kme":0.0493509,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000139921","entrez_id":["81542"],"uniprot":["Q9H3N1"],"ncbi_summary":"This gene encodes a member of the disulfide isomerase (PDI) family of endoplasmic reticulum (ER) proteins that catalyze protein folding and thiol-disulfide interchange reactions. The encoded protein has an N-terminal ER-signal sequence, a catalytically active thioredoxin domain, and one transmembrane domain. Unlike most members of this gene family, it lacks a C-terminal ER-retention sequence. The mature membrane-bound protein can both oxidize and reduce disulfide bonds and acts selectively on membrane-associated polypeptides. [provided by RefSeq, Jan 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H3N1","text":"Thioredoxin domain-containing protein that participates in various redox reactions through the reversible oxidation of its active center dithiol to a disulfide and catalyze dithiol-disulfide exchange reactions (PubMed:11152479, PubMed:37648867). Acts as a key inhibitor of the alternative triglyceride biosynthesis pathway by inhibiting the activity of TMEM68/DIESL at the endoplasmic reticulum, thereby restricting accumulation of triacylglycerol (PubMed:37648867). The alternative triglyceride biosynthesis pathway mediates formation of triacylglycerol from diacylglycerol and membrane phospholipids (PubMed:37648867). Acts as a protein disulfide isomerase by catalyzing formation or reduction of disulfide bonds (PubMed:22228764, PubMed:29932915). Specifically mediates formation of disulfide bonds of transmembrane proteins at the endoplasmic reticulum membrane (PubMed:22228764). Involved in endoplasmic reticulum-associated degradation (ERAD) via its protein disulfide isomerase activity by acting on folding-defective polypeptides at the endoplasmic reticulum membrane (PubMed:29932915). Acts as a negative regulator of platelet aggregation following secretion in the extracellular space (PubMed:30425049). Acts as a regulator of endoplasmic reticulum-mitochondria contact sites via its ability to regulate redox signals (PubMed:27502484, PubMed:31304984). Regulates endoplasmic reticulum-mitochondria Ca(2+) flux (PubMed:27502484)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}