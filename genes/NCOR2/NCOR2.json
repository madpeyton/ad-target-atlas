us_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.960321,"nucleus_log2fc":-0.0750556,"nucleus_score":-0.136597,"pct_ad":0.157442,"pct_control":0.153558,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"NCOR2","gene_symbol_current":"NCOR2","gene_id":"ENSG00000196498","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.528451,"nucleus_log2fc":-0.140689,"nucleus_score":-1.2103,"pct_ad":0.225275,"pct_control":0.249042,"donor_test":"not significant","donor_padj":0.99097,"donor_log2fc":-0.0743516,"donor_lfcse":0.148063,"donor_log2fc_shrunk":-0.000666653},{"cell_type":"Oli","gene_symbol":"NCOR2","gene_symbol_current":"NCOR2","gene_id":"ENSG00000196498","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.997467,"nucleus_log2fc":-0.027731,"nucleus_score":-0.00791316,"pct_ad":0.109898,"pct_control":0.10933,"donor_test":"not significant","donor_padj":0.842299,"donor_log2fc":-0.100072,"donor_lfcse":0.0959943,"donor_log2fc_shrunk":-0.00969021}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000196498","entrez_id":["9612"],"uniprot":["Q9Y618"],"ncbi_summary":"This gene encodes a nuclear receptor co-repressor that mediates transcriptional silencing of certain target genes. The encoded protein is a member of a family of thyroid hormone- and retinoic acid receptor-associated co-repressors. This protein acts as part of a multisubunit complex which includes histone deacetylases to modify chromatin structure that prevents basal transcriptional activity of target genes. Aberrant expression of this gene is associated with certain cancers. Alternate splicing results in multiple transcript variants encoding different isoforms.[provided by RefSeq, Apr 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y618","text":"Transcriptional corepressor that mediates the transcriptional repression activity of some nuclear receptors by promoting chromatin condensation, thus preventing access of the basal transcription (PubMed:10077563, PubMed:10097068, PubMed:18212045, PubMed:20812024, PubMed:22230954, PubMed:23911289). Acts by recruiting chromatin modifiers, such as histone deacetylases HDAC1, HDAC2 and HDAC3 (PubMed:22230954). Required to activate the histone deacetylase activity of HDAC3 (PubMed:22230954). Involved in the regulation BCL6-dependent of the germinal center (GC) reactions, mainly through the control of the GC B-cells proliferation and survival (PubMed:18212045, PubMed:23911289). Recruited by ZBTB7A to the androgen response elements/ARE on target genes, negatively regulates androgen receptor signaling and androgen-induced cell proliferation (PubMed:20812024). [Isoform 1]: Isoform 1 and isoform 4 have different affinities for different nuclear receptors. [Isoform 4]: Isoform 1 and isoform 4 have different affinities for different nuclear receptors."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}