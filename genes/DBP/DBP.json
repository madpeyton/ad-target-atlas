P","gene_symbol_current":"DBP","gene_id":"ENSG00000105516","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.92201,"donor_log2fc":0.0873521,"donor_lfcse":0.136775,"donor_log2fc_shrunk":0.00494967,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000105516","module":"turquoise","kme":0.0664488,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000105516","entrez_id":["1628"],"uniprot":["Q10586"],"ncbi_summary":"The protein encoded by this gene is a member of the PAR bZIP transcription factor family and binds to specific sequences in the promoters of several genes, such as albumin, CYP2A4, and CYP2A5. The encoded protein can bind DNA as a homo- or heterodimer and is involved in the regulation of some circadian rhythm genes. [provided by RefSeq, Jul 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q10586","text":"This transcriptional activator recognizes and binds to the sequence 5'-RTTAYGTAAY-3' found in the promoter of genes such as albumin, CYP2A4 and CYP2A5. It is not essential for circadian rhythm generation, but modulates important clock output genes. May be a direct target for regulation by the circadian pacemaker component clock. May affect circadian period and sleep regulation. Activates transcription of coagulation factors F8 and F9; transactivation activity is enhanced by formation of a heterodimer with HLF (PubMed:10073576)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}