":0.0821537,"donor_log2fc_shrunk":0.000873621,"degas_log2fc":-0.227278,"degas_padj":0.0},{"cell_type":"In","gene_symbol":"ATG5","gene_symbol_current":"ATG5","gene_id":"ENSG00000057663","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0504367,"nucleus_log2fc":-0.0151322,"nucleus_score":-2.02536,"pct_ad":0.713058,"pct_control":0.717456,"donor_test":"not significant","donor_padj":0.881776,"donor_log2fc":0.0322455,"donor_lfcse":0.0577483,"donor_log2fc_shrunk":0.00415008,"degas_log2fc":-0.256107,"degas_padj":2.60365e-279},{"cell_type":"Mic","gene_symbol":"ATG5","gene_symbol_current":"ATG5","gene_id":"ENSG00000057663","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.972344,"nucleus_log2fc":0.000186339,"nucleus_score":-0.0472748,"pct_ad":0.436862,"pct_control":0.439401,"donor_test":"not significant","donor_padj":0.92926,"donor_log2fc":0.035758,"donor_lfcse":0.0812581,"donor_log2fc_shrunk":0.00875966,"degas_log2fc":0.0105833,"degas_padj":0.807785},{"cell_type":"OPC","gene_symbol":"ATG5","gene_symbol_current":"ATG5","gene_id":"ENSG00000057663","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.597071,"nucleus_log2fc":0.0211311,"nucleus_score":0.764846,"pct_ad":0.382941,"pct_control":0.373074,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0307656,"donor_lfcse":0.0767534,"donor_log2fc_shrunk":-5.37009e-06,"degas_log2fc":-0.303934,"degas_padj":9.6917e-12},{"cell_type":"Oli","gene_symbol":"ATG5","gene_symbol_current":"ATG5","gene_id":"ENSG00000057663","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.587856,"nucleus_log2fc":0.0186881,"nucleus_score":0.610023,"pct_ad":0.285132,"pct_control":0.283466,"donor_test":"not significant","donor_padj":0.968093,"donor_log2fc":0.0270466,"donor_lfcse":0.0862264,"donor_log2fc_shrunk":0.00460031,"degas_log2fc":-0.206543,"degas_padj":1.38568e-20}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000057663","module":"blue","kme":0.172815,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000057663","module":"green","kme":0.351195,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000057663","module":"blue","kme":0.116824,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000057663","entrez_id":["9474"],"uniprot":["Q9H1Y0"],"ncbi_summary":"The protein encoded by this gene, in combination with autophagy protein 12, functions as an E1-like activating enzyme in a ubiquitin-like conjugating system. The encoded protein is involved in several cellular processes, including autophagic vesicle formation, mitochondrial quality control after oxidative damage, negative regulation of the innate antiviral immune response, lymphocyte development and proliferation, MHC II antigen presentation, adipocyte differentiation, and apoptosis. Several transcript variants encoding different protein isoforms have been found for this gene. [provided by RefSeq, Sep 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H1Y0","text":"Involved in autophagic vesicle formation. Conjugation with ATG12, through a ubiquitin-like conjugating system involving ATG7 as an E1-like activating enzyme and ATG10 as an E2-like conjugating enzyme, is essential for its function. The ATG12-ATG5 conjugate acts as an E3-like enzyme which is required for lipidation of ATG8 family proteins and their association to the vesicle membranes. Involved in mitochondrial quality control after oxidative damage, and in subsequent cellular longevity. Plays a critical role in multiple aspects of lymphocyte development and is essential for both B and T lymphocyte survival and proliferation. Required for optimal processing and presentation of antigens for MHC II. Involved in the maintenance of axon morphology and membrane structures, as well as in normal adipocyte differentiation. Promotes primary ciliogenesis through removal of OFD1 from centriolar satellites and degradation of IFT20 via the autophagic pathway. As part of the ATG8 conjugation system with ATG12 and ATG16L1, required for recruitment of LRRK2 to stressed lysosomes and induction of LRRK2 kinase activity in response to lysosomal stress (By similarity). May play an important role in the apoptotic process, possibly within the modified cytoskeleton. Its expression is a relatively late event in the apoptotic process, occurring downstream of caspase activity. Plays a crucial role in IFN-gamma-induced autophagic cell death by interacting with FADD. (Microbial infection) May act as a proviral factor. In association with ATG12, negatively regulates the innate antiviral immune response by impairing the type I IFN production pathway upon vesicular stomatitis virus (VSV) infection (PubMed:17709747). Required for the translation of incoming hepatitis C virus (HCV) RNA and, thereby, for initiation of HCV replication, but not required once infection is established (PubMed:19666601)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}