leus_log2fc":0.108396,"nucleus_score":2.5509,"pct_ad":0.236676,"pct_control":0.220622,"donor_test":"not significant","donor_padj":0.732365,"donor_log2fc":0.0781514,"donor_lfcse":0.0701589,"donor_log2fc_shrunk":0.0261334},{"cell_type":"OPC","gene_symbol":"XPA","gene_symbol_current":"XPA","gene_id":"ENSG00000136936","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000103558,"nucleus_log2fc":0.178312,"nucleus_score":4.38583,"pct_ad":0.41187,"pct_control":0.373582,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0894059,"donor_lfcse":0.064713,"donor_log2fc_shrunk":2.23141e-05},{"cell_type":"Oli","gene_symbol":"XPA","gene_symbol_current":"XPA","gene_id":"ENSG00000136936","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00331915,"nucleus_log2fc":-0.0623749,"nucleus_score":-3.07654,"pct_ad":0.300962,"pct_control":0.310891,"donor_test":"not significant","donor_padj":0.930178,"donor_log2fc":-0.0315601,"donor_lfcse":0.0565806,"donor_log2fc_shrunk":-0.00810207}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000136936","module":"turquoise","kme":0.133113,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000136936","module":"turquoise","kme":0.0613366,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000136936","module":"turquoise","kme":0.0519372,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136936","entrez_id":["7507"],"uniprot":["P23025"],"ncbi_summary":"This gene encodes a zinc finger protein plays a central role in nucleotide excision repair (NER), a specialized type of DNA repair. NER is responsible for repair of UV radiation-induced photoproducts and DNA adducts induced by chemical carcinogens and chemotherapeutic drugs. The encoded protein interacts with DNA and several NER proteins, acting as a scaffold to assemble the NER incision complex at sites of DNA damage. Mutations in this gene cause Xeroderma pigmentosum complementation group A (XP-A), an autosomal recessive skin disorder featuring hypersensitivity to sunlight and increased risk for skin cancer. [provided by RefSeq, Aug 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P23025","text":"Involved in DNA nucleotide excision repair (NER). Initiates repair by binding to damaged sites with various affinities, depending on the photoproduct and the transcriptional state of the region. Required for UV-induced CHEK1 phosphorylation and the recruitment of CEP164 to cyclobutane pyrimidine dimmers (CPD), sites of DNA damage after UV irradiation (PubMed:19197159). During NER stimulates the 5'-3' helicase activity of XPD/ERCC2 and the DNA translocase activity of XPB/ERCC3 (PubMed:31253769). Connects XPD/ERCC2 and XPB/ERCC3 during NER, retaining DNA near the XPB/ERCC3 active site, and stabilizing the complex in a different conformation than in transcribing TFIIH (PubMed:31253769)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}