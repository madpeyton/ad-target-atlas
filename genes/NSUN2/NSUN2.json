nificant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.94041,"nucleus_log2fc":-0.0202585,"nucleus_score":-0.102236,"pct_ad":0.247075,"pct_control":0.246313,"donor_test":"not significant","donor_padj":0.944212,"donor_log2fc":-0.0457347,"donor_lfcse":0.122671,"donor_log2fc_shrunk":-0.00574592,"degas_log2fc":-0.0115303,"degas_padj":0.844463},{"cell_type":"OPC","gene_symbol":"NSUN2","gene_symbol_current":"NSUN2","gene_id":"ENSG00000037474","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.84008e-05,"nucleus_log2fc":-0.242277,"nucleus_score":-4.62091,"pct_ad":0.249478,"pct_control":0.284505,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.178848,"donor_lfcse":0.123076,"donor_log2fc_shrunk":-1.24221e-05,"degas_log2fc":-0.277272,"degas_padj":3.60453e-07},{"cell_type":"Oli","gene_symbol":"NSUN2","gene_symbol_current":"NSUN2","gene_id":"ENSG00000037474","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.07001e-94,"nucleus_log2fc":-0.520552,"nucleus_score":-20.7446,"pct_ad":0.192842,"pct_control":0.255507,"donor_test":"not significant","donor_padj":0.507347,"donor_log2fc":-0.329971,"donor_lfcse":0.138134,"donor_log2fc_shrunk":-0.0224313,"degas_log2fc":-0.314498,"degas_padj":1.08264e-36}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000037474","module":"blue","kme":0.108206,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000037474","entrez_id":["54888"],"uniprot":["Q08J23"],"ncbi_summary":"This gene encodes a methyltransferase that catalyzes the methylation of cytosine to 5-methylcytosine (m5C) at position 34 of intron-containing tRNA(Leu)(CAA) precursors. This modification is necessary to stabilize the anticodon-codon pairing and correctly translate the mRNA. Alternatively spliced transcript variants encoding different isoforms have been noted for this gene.[provided by RefSeq, Mar 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q08J23","text":"RNA cytosine C(5)-methyltransferase that methylates cytosine to 5-methylcytosine (m5C) in various RNAs, such as tRNAs, mRNAs and some long non-coding RNAs (lncRNAs) (PubMed:17071714, PubMed:22995836, PubMed:31199786, PubMed:31358969). Involved in various processes, such as epidermal stem cell differentiation, testis differentiation and maternal to zygotic transition during early development: acts by increasing protein synthesis; cytosine C(5)-methylation promoting tRNA stability and preventing mRNA decay (PubMed:31199786). Methylates cytosine to 5-methylcytosine (m5C) at positions 34 and 48 of intron-containing tRNA(Leu)(CAA) precursors, and at positions 48, 49 and 50 of tRNA(Gly)(GCC) precursors (PubMed:17071714, PubMed:22995836, PubMed:31199786). tRNA methylation is required generation of RNA fragments derived from tRNAs (tRFs) (PubMed:31199786). Also mediates C(5)-methylation of mitochondrial tRNAs (PubMed:31276587). Catalyzes cytosine C(5)-methylation of mRNAs, leading to stabilize them and prevent mRNA decay: mRNA stabilization involves YBX1 that specifically recognizes and binds m5C-modified transcripts (PubMed:22395603, PubMed:31358969, PubMed:34556860). Cytosine C(5)-methylation of mRNAs also regulates mRNA export: methylated transcripts are specifically recognized by THOC4/ALYREF, which mediates mRNA nucleo-cytoplasmic shuttling (PubMed:28418038). Also mediates cytosine C(5)-methylation of non-coding RNAs, such as vault RNAs (vtRNAs), promoting their processing into regulatory small RNAs (PubMed:23871666). Cytosine C(5)-methylation of vtRNA VTRNA1.1 promotes its processing into small-vault RNA4 (svRNA4) and regulates epidermal differentiation (PubMed:31186410). May act downstream of Myc to regulate epidermal cell growth and proliferation (By similarity). Required for proper spindle assembly and chromosome segregation, independently of its methyltransferase activity (PubMed:19596847)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}