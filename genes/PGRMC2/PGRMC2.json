nor_log2fc":0.26177,"donor_lfcse":0.154182,"donor_log2fc_shrunk":0.0110846}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164040","entrez_id":["10424"],"uniprot":["O15173"],"ncbi_summary":"Enables heme binding activity. Involved in adipose tissue development. Located in endoplasmic reticulum and nuclear envelope. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O15173","text":"Required for the maintenance of uterine histoarchitecture and normal female reproductive lifespan (By similarity). May serve as a universal non-classical progesterone receptor in the uterus (Probable). Intracellular heme chaperone required for delivery of labile, or signaling heme, to the nucleus (By similarity). Plays a role in adipocyte function and systemic glucose homeostasis (PubMed:28111073). In brown fat, which has a high demand for heme, delivery of labile heme in the nucleus regulates the activity of heme-responsive transcriptional repressors such as NR1D1 and BACH1 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}