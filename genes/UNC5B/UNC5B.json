or_log2fc":0.0461017,"donor_lfcse":0.13962,"donor_log2fc_shrunk":0.00453495,"degas_log2fc":0.274498,"degas_padj":1.56951e-08},{"cell_type":"OPC","gene_symbol":"UNC5B","gene_symbol_current":"UNC5B","gene_id":"ENSG00000107731","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0886189,"donor_lfcse":0.196856,"donor_log2fc_shrunk":2.23687e-06,"degas_log2fc":-0.185143,"degas_padj":0.0675305},{"cell_type":"Oli","gene_symbol":"UNC5B","gene_symbol_current":"UNC5B","gene_id":"ENSG00000107731","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00609192,"nucleus_log2fc":-0.0348898,"nucleus_score":-2.88026,"pct_ad":0.434155,"pct_control":0.450601,"donor_test":"not significant","donor_padj":0.948105,"donor_log2fc":-0.0375736,"donor_lfcse":0.0879225,"donor_log2fc_shrunk":-0.00476708,"degas_log2fc":-0.116753,"degas_padj":2.07234e-11}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000107731","module":"blue","kme":0.246019,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000107731","module":"yellow","kme":0.298362,"hub":false,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000107731","module":"blue","kme":0.0944765,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000107731","entrez_id":["219699"],"uniprot":["Q8IZJ1"],"ncbi_summary":"This gene encodes a member of the netrin family of receptors. This particular protein mediates the repulsive effect of netrin-1 and is a vascular netrin receptor. This encoded protein is also in a group of proteins called dependence receptors (DpRs) which are involved in pro- and anti-apoptotic processes. Many DpRs are involved in embryogenesis and in cancer progression. Two alternatively spliced transcript variants have been described for this gene. [provided by RefSeq, Oct 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IZJ1","text":"Receptor for netrin required for axon guidance. Mediates axon repulsion of neuronal growth cones in the developing nervous system upon ligand binding. Axon repulsion in growth cones may be caused by its association with DCC that may trigger signaling for repulsion (By similarity). Functions as a netrin receptor that negatively regulates vascular branching during angiogenesis. Mediates retraction of tip cell filopodia on endothelial growth cones in response to netrin (By similarity). It also acts as a dependence receptor required for apoptosis induction when not associated with netrin ligand (PubMed:12598906). Mediates apoptosis by activating DAPK1. In the absence of NTN1, activates DAPK1 by reducing its autoinhibitory phosphorylation at Ser-308 thereby increasing its catalytic activity (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}