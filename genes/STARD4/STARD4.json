t tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.691689,"donor_log2fc":0.301803,"donor_lfcse":0.184037,"donor_log2fc_shrunk":0.0100998,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000164211","module":"yellow","kme":0.197799,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164211","entrez_id":["134429"],"uniprot":["Q96DR4"],"ncbi_summary":"Cholesterol homeostasis is regulated, at least in part, by sterol regulatory element (SRE)-binding proteins (e.g., SREBP1; MIM 184756) and by liver X receptors (e.g., LXRA; MIM 602423). Upon sterol depletion, LXRs are inactive and SREBPs are cleaved, after which they bind promoter SREs and activate genes involved in cholesterol biosynthesis and uptake. Sterol transport is mediated by vesicles or by soluble protein carriers, such as steroidogenic acute regulatory protein (STAR; MIM 600617). STAR is homologous to a family of proteins containing a 200- to 210-amino acid STAR-related lipid transfer (START) domain, including STARD4 (Soccio et al., 2002 [PubMed 12011452]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96DR4","text":"Involved in the intracellular transport of cholesterol. Binds cholesterol or other sterols."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}