9446,"pct_ad":0.127255,"pct_control":0.12323,"donor_test":"not significant","donor_padj":0.78541,"donor_log2fc":0.166937,"donor_lfcse":0.161144,"donor_log2fc_shrunk":0.00299404,"degas_log2fc":-0.225312,"degas_padj":1.66007e-25},{"cell_type":"Mic","gene_symbol":"BLM","gene_symbol_current":"BLM","gene_id":"ENSG00000197299","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.538389,"donor_log2fc":-0.414621,"donor_lfcse":0.242887,"donor_log2fc_shrunk":-0.0152988,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"BLM","gene_symbol_current":"BLM","gene_id":"ENSG00000197299","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.167096,"nucleus_log2fc":-0.0629345,"nucleus_score":-1.78426,"pct_ad":0.536982,"pct_control":0.550889,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0438338,"donor_lfcse":0.0876156,"donor_log2fc_shrunk":-7.99545e-06,"degas_log2fc":-0.326182,"degas_padj":6.38108e-20},{"cell_type":"Oli","gene_symbol":"BLM","gene_symbol_current":"BLM","gene_id":"ENSG00000197299","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.474626,"donor_log2fc":0.559739,"donor_lfcse":0.225895,"donor_log2fc_shrunk":0.0125287,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"In","gene_id":"ENSG00000197299","module":"magenta","kme":0.32968,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000197299","entrez_id":["641"],"uniprot":["P54132"],"ncbi_summary":"The Bloom syndrome is an autosomal recessive disorder characterized by growth deficiency, microcephaly and immunodeficiency among others. It is caused by homozygous or compound heterozygous mutation in the gene encoding DNA helicase RecQ protein on chromosome 15q26. This Bloom-associated helicase unwinds a variety of DNA substrates including Holliday junction, and is involved in several pathways contributing to the maintenance of genome stability. Identification of pathogenic Bloom variants is required for heterozygote testing in at-risk families. [provided by RefSeq, May 2020].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P54132","text":"ATP-dependent DNA helicase that unwinds double-stranded (ds)DNA in a 3'-5' direction (PubMed:24816114, PubMed:25901030, PubMed:9388193, PubMed:9765292). Participates in DNA replication and repair (PubMed:12019152, PubMed:21325134, PubMed:23509288, PubMed:34606619). Involved in 5'-end resection of DNA during double-strand break (DSB) repair: unwinds DNA and recruits DNA2 which mediates the cleavage of 5'-ssDNA (PubMed:21325134). Stimulates DNA 4-way junction branch migration and DNA Holliday junction dissolution (PubMed:25901030). Binds single-stranded DNA (ssDNA), forked duplex DNA and Holliday junction DNA (PubMed:20639533, PubMed:24257077, PubMed:25901030). Unwinds G-quadruplex DNA; unwinding occurs in the 3'-5' direction and requires a 3' single-stranded end of at least 7 nucleotides (PubMed:18426915, PubMed:9765292). Helicase activity is higher on G-quadruplex substrates than on duplex DNA substrates (PubMed:9765292). Telomeres, immunoglobulin heavy chain switch regions and rDNA are notably G-rich; formation of G-quadruplex DNA would block DNA replication and transcription (PubMed:18426915, PubMed:9765292). Negatively regulates sister chromatid exchange (SCE) (PubMed:25901030). Recruited by the KHDC3L-OOEP scaffold to DNA replication forks where it is retained by TRIM25 ubiquitination, it thereby promotes the restart of stalled replication forks (By similarity). (Microbial infection) Eliminates nuclear HIV-1 cDNA, thereby suppressing immune sensing and proviral hyper-integration."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}