3,"pct_ad":0.134315,"pct_control":0.126535,"donor_test":"not significant","donor_padj":0.506876,"donor_log2fc":0.0455739,"donor_lfcse":0.0356023,"donor_log2fc_shrunk":0.0253634},{"cell_type":"Inhibitory","gene_symbol":"MED12","gene_symbol_current":"MED12","gene_id":"ENSG00000184634","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.938364,"donor_log2fc":0.010511,"donor_lfcse":0.0441926,"donor_log2fc_shrunk":0.0027018},{"cell_type":"Microglia","gene_symbol":"MED12","gene_symbol_current":"MED12","gene_id":"ENSG00000184634","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"filtered (low counts, not tested at FDR)","donor_padj":null,"donor_log2fc":-0.120647,"donor_lfcse":0.0953311,"donor_log2fc_shrunk":-0.0156048},{"cell_type":"Oligodendroglia","gene_symbol":"MED12","gene_symbol_current":"MED12","gene_id":"ENSG00000184634","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.541195,"donor_log2fc":0.0501119,"donor_lfcse":0.0485998,"donor_log2fc_shrunk":0.0242529}],"modules":[],"degas_bulk_de":true,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000184634"],"dataset_symbols":["MED12"],"explorer":"explorer.html?dataset=mathys2019#gene/MED12","cell_types":[{"cell_type":"Ex","gene_symbol":"MED12","gene_symbol_current":"MED12","gene_id":"ENSG00000184634","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0813356,"donor_lfcse":0.123532,"donor_log2fc_shrunk":5.4948e-06}],"modules":[],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000184634","entrez_id":["9968"],"uniprot":["Q93074"],"ncbi_summary":"The initiation of transcription is controlled in part by a large protein assembly known as the preinitiation complex. A component of this preinitiation complex is a 1.2 MDa protein aggregate called Mediator. This Mediator component binds with a CDK8 subcomplex which contains the protein encoded by this gene, mediator complex subunit 12 (MED12), along with MED13, CDK8 kinase, and cyclin C. The CDK8 subcomplex modulates Mediator-polymerase II interactions and thereby regulates transcription initiation and reinitation rates. The MED12 protein is essential for activating CDK8 kinase. Defects in this gene cause X-linked Opitz-Kaveggia syndrome, also known as FG syndrome, and Lujan-Fryns syndrome. [provided by RefSeq, Aug 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q93074","text":"Component of the Mediator complex, a coactivator involved in the regulated transcription of nearly all RNA polymerase II-dependent genes. Mediator functions as a bridge to convey information from gene-specific regulatory proteins to the basal RNA polymerase II transcription machinery. Mediator is recruited to promoters by direct interactions with regulatory proteins and serves as a scaffold for the assembly of a functional pre-initiation complex with RNA polymerase II and the general transcription factors. This subunit may specifically regulate transcription of targets of the Wnt signaling pathway and SHH signaling pathway."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}