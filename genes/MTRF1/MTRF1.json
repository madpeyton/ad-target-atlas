ct_ad":0.227111,"pct_control":0.219529,"donor_test":"not significant","donor_padj":0.82476,"donor_log2fc":-0.0283302,"donor_lfcse":0.0550893,"donor_log2fc_shrunk":-0.00835515},{"cell_type":"Inhibitory","gene_symbol":"MTRF1","gene_symbol_current":"MTRF1","gene_id":"ENSG00000120662","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.95617,"nucleus_log2fc":-0.0484862,"nucleus_score":0.0740875,"pct_ad":0.120634,"pct_control":0.119603,"donor_test":"not significant","donor_padj":0.966612,"donor_log2fc":0.00911758,"donor_lfcse":0.0674252,"donor_log2fc_shrunk":0.0013245},{"cell_type":"Microglia","gene_symbol":"MTRF1","gene_symbol_current":"MTRF1","gene_id":"ENSG00000120662","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"filtered (low counts, not tested at FDR)","donor_padj":null,"donor_log2fc":-0.194376,"donor_lfcse":0.083169,"donor_log2fc_shrunk":-0.0536422},{"cell_type":"Oligodendroglia","gene_symbol":"MTRF1","gene_symbol_current":"MTRF1","gene_id":"ENSG00000120662","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.90925,"donor_log2fc":-0.0110925,"donor_lfcse":0.0466573,"donor_log2fc_shrunk":-0.00496658}],"modules":[],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000120662"],"dataset_symbols":["MTRF1"],"explorer":"explorer.html?dataset=mathys2019#gene/MTRF1","cell_types":[{"cell_type":"Ex","gene_symbol":"MTRF1","gene_symbol_current":"MTRF1","gene_id":"ENSG00000120662","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0648417,"donor_lfcse":0.103928,"donor_log2fc_shrunk":6.25506e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000120662","entrez_id":["9617"],"uniprot":["O75570"],"ncbi_summary":"The protein encoded by this gene was determined by in silico methods to be a mitochondrial protein with similarity to the peptide chain release factors (RFs) discovered in bacteria and yeast. The peptide chain release factors direct the termination of translation in response to the peptide chain termination codons. Initially thought to have a role in the termination of mitochondria protein synthesis, a recent publication found no mitochondrial translation release functionality. Multiple alternatively spliced transcript variants have been suggested by mRNA and EST data; however, their full-length natures are not clear. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75570","text":"Mitochondrial peptide chain release factor that directs the termination of translation in response to the peptide chain non-canonical stop codons AGG and AGA (PubMed:36302763, PubMed:36596788, PubMed:37141370). Non-canonical termination codons AGG and AGA are found at the end of MT-CO1/COX1 and MT-ND6/ND6 open reading frames, respectively (PubMed:37141370). Recognizes non-canonical stop codons via a network of interactions between the codon, MTRF1 and the ribosomal RNA (rRNA): in contrast to other translation release factors, which identify the codon in the A-site via direct interactions of amino acid side chains with the bases, MTRF1 repositions the first 2 bases of the stop codon to use an intricate network of interactions that includes residues of the release factor, the rRNA of the small ribosomal subunit, as well as neighboring bases of the mRNA (PubMed:37141370)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}