"turquoise","kme":0.157638,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000138613","module":"turquoise","kme":0.198427,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000138613","module":"turquoise","kme":0.115048,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000138613","module":"turquoise","kme":0.0922135,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000138613","entrez_id":["83464"],"uniprot":["Q8WW43"],"ncbi_summary":"This gene encodes a multi-pass transmembrane protein that is a functional component of the gamma-secretase complex, which also contains presenilin and nicastrin. This protein represents a stabilizing cofactor for the presenilin holoprotein in the complex. The gamma-secretase complex catalyzes the cleavage of integral proteins such as notch receptors and beta-amyloid precursor protein. [provided by RefSeq, Sep 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WW43","text":"Probable subunit of the gamma-secretase complex, an endoprotease complex that catalyzes the intramembrane cleavage of integral proteins such as Notch receptors and APP (amyloid-beta precursor protein). It probably represents a stabilizing cofactor for the presenilin homodimer that promotes the formation of a stable complex. Probably present in a minority of gamma-secretase complexes compared to APH1A."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}