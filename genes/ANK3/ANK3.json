e_id":"ENSG00000151150","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":6.7288e-09,"nucleus_log2fc":-0.119823,"nucleus_score":-6.30696,"pct_ad":0.936922,"pct_control":0.943776,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0827533,"donor_lfcse":0.103399,"donor_log2fc_shrunk":-8.08203e-06},{"cell_type":"Oli","gene_symbol":"ANK3","gene_symbol_current":"ANK3","gene_id":"ENSG00000151150","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.21125e-127,"nucleus_log2fc":-0.187784,"nucleus_score":-24.1826,"pct_ad":0.980444,"pct_control":0.986456,"donor_test":"not significant","donor_padj":0.865534,"donor_log2fc":-0.101604,"donor_lfcse":0.107844,"donor_log2fc_shrunk":-0.00920907}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000151150","module":"blue","kme":0.395373,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000151150","module":"blue","kme":0.160651,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000151150","module":"turquoise","kme":0.342988,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000151150","entrez_id":["288"],"uniprot":["Q12955"],"ncbi_summary":"Ankyrins are a family of proteins that are believed to link the integral membrane proteins to the underlying spectrin-actin cytoskeleton and play key roles in activities such as cell motility, activation, proliferation, contact, and the maintenance of specialized membrane domains. Multiple isoforms of ankyrin with different affinities for various target proteins are expressed in a tissue-specific, developmentally regulated manner. Most ankyrins are typically composed of three structural domains: an amino-terminal domain containing multiple ankyrin repeats; a central region with a highly conserved spectrin binding domain; and a carboxy-terminal regulatory domain which is the least conserved and subject to variation. Ankyrin 3 is an immunologically distinct gene product from ankyrins 1 and 2, and was originally found at the axonal initial segment and nodes of Ranvier of neurons in the central and peripheral nervous systems. Multiple transcript variants encoding different isoforms have been found for this gene.[provided by RefSeq, Feb 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q12955","text":"Required for the organization of specialized membrane domains by linking the membrane to the cytoskeleton (PubMed:7836469). In neurons, participates in the maintenance/targeting of ion channels and cell adhesion molecules at the nodes of Ranvier and axonal initial segments (PubMed:7836469). In skeletal muscle, required for the localization of dystrophin (DMD) and beta-dystroglycan (betaDAG1) to costameres (By similarity). In rod photoreceptors, required for the transport of cyclic nucleotide-gated (CNG) channel subunits from the inner segment to the sensory cilium outer segment, which is critical for phototransduction and outer segment morphogenesis (PubMed:19299621). Regulates the activity of the potassium channel KCNA1 in response to dietary Mg(2+) levels, contributing to renal Mg(2+) reabsorption (PubMed:23903368). Promotes intracellular adhesion and junctional conductance in myocytes by stabilizing GJA1/CX43 protein abundance and facilitating the localization of PKP2, GJA1/CX43, and SCN5A/Nav1.5 to cell-cell junctions (By similarity). [Isoform 5]: May be part of a Golgi-specific membrane cytoskeleton in association with beta-spectrin."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}