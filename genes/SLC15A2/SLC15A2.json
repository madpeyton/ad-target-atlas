b":false,"module_direction":"higher in AD","module_padj":0.554841,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000163406"],"dataset_symbols":["SLC15A2"],"explorer":"explorer.html?dataset=mathys2019#gene/SLC15A2","cell_types":[{"cell_type":"Ast","gene_symbol":"SLC15A2","gene_symbol_current":"SLC15A2","gene_id":"ENSG00000163406","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00148743,"nucleus_log2fc":-0.399621,"nucleus_score":-3.83709,"pct_ad":0.255543,"pct_control":0.321405,"donor_test":"not significant","donor_padj":0.68292,"donor_log2fc":-0.183417,"donor_lfcse":0.123556,"donor_log2fc_shrunk":-0.0258881},{"cell_type":"Ex","gene_symbol":"SLC15A2","gene_symbol_current":"SLC15A2","gene_id":"ENSG00000163406","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.129615,"donor_lfcse":0.112733,"donor_log2fc_shrunk":-1.17189e-05},{"cell_type":"Mic","gene_symbol":"SLC15A2","gene_symbol_current":"SLC15A2","gene_id":"ENSG00000163406","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.677131,"nucleus_log2fc":-0.24564,"nucleus_score":-0.911505,"pct_ad":0.098401,"pct_control":0.11236,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"In","gene_id":"ENSG00000163406","module":"brown","kme":0.18,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163406","entrez_id":["6565"],"uniprot":["Q16348"],"ncbi_summary":"The mammalian kidney expresses a proton-coupled peptide transporter that is responsible for the absorption of small peptides, as well as beta-lactam antibiotics and other peptide-like drugs, from the tubular filtrate. This transporter, SLC15A2, belongs to the same gene family as SLC15A1 (MIM 600544), the proton-coupled peptide transporter found in the small intestine (Liu et al, 1995 [PubMed 7756356]).[supplied by OMIM, Feb 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q16348","text":"Proton-coupled amino-acid transporter that transports oligopeptides of 2 to 4 amino acids with a preference for dipeptides (PubMed:16434549, PubMed:18367661, PubMed:7756356). Transports neutral and anionic dipeptides with a proton to peptide stoichiometry of 2:1 or 3:1 (By similarity). In kidney, involved in the absorption of circulating di- and tripeptides from the glomerular filtrate (PubMed:7756356). Can also transport beta-lactam antibiotics, such as the aminocephalosporin cefadroxil, and other antiviral and anticancer drugs (PubMed:16434549). Transports the dipeptide-like aminopeptidase inhibitor bestatin (By similarity). Also able to transport carnosine (PubMed:31073693). Involved in innate immunity by promoting the detection of microbial pathogens by NOD-like receptors (NLRs) (By similarity). Mediates transport of bacterial peptidoglycans across the plasma membrane or, in macrophages, the phagosome membrane: catalyzes the transport of certain bacterial peptidoglycans, such as muramyl dipeptide (MDP), the NOD2 ligand (PubMed:20406817)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}