icant":false},{"cell_type":"In","gene_id":"ENSG00000198947","module":"purple","kme":0.518874,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000198947","module":"turquoise","kme":0.324532,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000198947","module":"pink","kme":0.438641,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000198947","module":"yellow","kme":0.298961,"hub":false,"module_direction":"lower in AD","module_padj":0.0240838,"module_significant":true}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198947","entrez_id":["1756"],"uniprot":["P11532"],"ncbi_summary":"This gene spans a genomic range of greater than 2 Mb and encodes a large protein containing an N-terminal actin-binding domain and multiple spectrin repeats. The encoded protein forms a component of the dystrophin-glycoprotein complex (DGC), which bridges the inner cytoskeleton and the extracellular matrix. Deletions, duplications, and point mutations at this gene locus may cause Duchenne muscular dystrophy (DMD), Becker muscular dystrophy (BMD), or cardiomyopathy. Alternative promoter usage and alternative splicing result in numerous distinct transcript variants and protein isoforms for this gene. [provided by RefSeq, Dec 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P11532","text":"Anchors the extracellular matrix to the cytoskeleton via F-actin. Ligand for dystroglycan. Component of the dystrophin-associated glycoprotein complex which accumulates at the neuromuscular junction (NMJ) and at a variety of synapses in the peripheral and central nervous systems and has a structural function in stabilizing the sarcolemma. Also implicated in signaling events and synaptic transmission."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}