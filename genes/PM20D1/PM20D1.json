ucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.724514,"donor_log2fc":-0.791304,"donor_lfcse":0.479601,"donor_log2fc_shrunk":-0.00167522}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000162877","module":"turquoise","kme":0.267348,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000162877","module":"turquoise","kme":0.25699,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000162877","entrez_id":["148811"],"uniprot":["Q6GTS8"],"ncbi_summary":"Enables hydrolase activity, acting on carbon-nitrogen (but not peptide) bonds, in linear amides. Involved in several processes, including amide biosynthetic process; cellular amide catabolic process; and negative regulation of neuron death. Located in extracellular exosome. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6GTS8","text":"Secreted enzyme that regulates the endogenous N-fatty acyl amino acid (NAAs) tissue and circulating levels by functioning as a bidirectional NAA synthase/hydrolase (PubMed:27374330). It condenses free fatty acids and free amino acids to generate NAAs and bidirectionally catalyzes the reverse hydrolysis reaction (PubMed:27374330). Some of these NAAs stimulate oxidative metabolism via mitochondrial uncoupling, increasing energy expenditure in a UPC1-independent manner. Thereby, this secreted protein may indirectly regulate whole body energy expenditure. PM20D1 circulates in tight association with both low- and high-density (LDL and HDL,respectively) lipoprotein particles (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-