ll,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0127954,"donor_lfcse":0.179474,"donor_log2fc_shrunk":4.13674e-07},{"cell_type":"Oli","gene_symbol":"MRPL12","gene_symbol_current":"MRPL12","gene_id":"ENSG00000262814","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.914057,"donor_log2fc":-0.136256,"donor_lfcse":0.200986,"donor_log2fc_shrunk":-0.00374386}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000262814","module":"brown","kme":0.141201,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000262814","entrez_id":["6182"],"uniprot":["P52815"],"ncbi_summary":"Mammalian mitochondrial ribosomal proteins are encoded by nuclear genes and help in protein synthesis within the mitochondrion. Mitochondrial ribosomes (mitoribosomes) consist of a small 28S subunit and a large 39S subunit. They have an estimated 75% protein to rRNA composition compared to prokaryotic ribosomes, where this ratio is reversed. Another difference between mammalian mitoribosomes and prokaryotic ribosomes is that the latter contain a 5S rRNA. Among different species, the proteins comprising the mitoribosome differ greatly in sequence, and sometimes in biochemical properties, which prevents easy recognition by sequence homology. This gene encodes a 39S subunit protein which forms homodimers. In prokaryotic ribosomes, two L7/L12 dimers and one L10 protein form the L8 protein complex. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P52815","text":"As a component of the mitochondrial large ribosomal subunit, plays a role in mitochondrial translation (PubMed:23603806). When present in mitochondria as a free protein not associated with the ribosome, associates with mitochondrial RNA polymerase POLRMT to activate transcription (PubMed:22003127). Required for POLRMT stability (PubMed:26586915)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}