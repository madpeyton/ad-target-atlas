st":"not significant","donor_padj":0.953872,"donor_log2fc":0.0400777,"donor_lfcse":0.17043,"donor_log2fc_shrunk":0.000695538},{"cell_type":"Mic","gene_symbol":"MRPS12","gene_symbol_current":"MRPS12","gene_id":"ENSG00000128626","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.620253,"donor_log2fc":0.374568,"donor_lfcse":0.258728,"donor_log2fc_shrunk":0.0117218},{"cell_type":"OPC","gene_symbol":"MRPS12","gene_symbol_current":"MRPS12","gene_id":"ENSG00000128626","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.15822,"donor_lfcse":0.290186,"donor_log2fc_shrunk":1.96532e-06},{"cell_type":"Oli","gene_symbol":"MRPS12","gene_symbol_current":"MRPS12","gene_id":"ENSG00000128626","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.965675,"donor_log2fc":-0.0777056,"donor_lfcse":0.229832,"donor_log2fc_shrunk":-0.0016412}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000128626","module":"brown","kme":0.216271,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000128626","entrez_id":["6183"],"uniprot":["O15235"],"ncbi_summary":"Mammalian mitochondrial ribosomal proteins are encoded by nuclear genes and help in protein synthesis within the mitochondrion. Mitochondrial ribosomes (mitoribosomes) consist of a small 28S subunit and a large 39S subunit. They have an estimated 75% protein to rRNA composition compared to prokaryotic ribosomes, where this ratio is reversed. Another difference between mammalian mitoribosomes and prokaryotic ribosomes is that the latter contain a 5S rRNA. Among different species, the proteins comprising the mitoribosome differ greatly in sequence, and sometimes in biochemical properties, which prevents easy recognition by sequence homology. This gene encodes a 28S subunit protein that belongs to the ribosomal protein S12P family. The encoded protein is a key component of the ribosomal small subunit and controls the decoding fidelity and susceptibility to aminoglycoside antibiotics. The gene for mitochondrial seryl-tRNA synthetase is located upstream and adjacent to this gene, and both genes are possible candidates for the autosomal dominant deafness gene (DFNA4). Splice variants that differ in the 5' UTR have been found for this gene; all three variants encode the same protein. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}