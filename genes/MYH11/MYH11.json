n":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.958934,"donor_log2fc":-0.0737496,"donor_lfcse":0.235511,"donor_log2fc_shrunk":-0.00127637}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000133392","entrez_id":["4629"],"uniprot":["P35749"],"ncbi_summary":"The protein encoded by this gene is a smooth muscle myosin belonging to the myosin heavy chain family. The gene product is a subunit of a hexameric protein that consists of two heavy chain subunits and two pairs of non-identical light chain subunits. It functions as a major contractile protein, converting chemical energy into mechanical energy through the hydrolysis of ATP. A chromosomal rearrangement involving this gene is associated with acute myeloid leukemia of the M4Eo subtype. Mutations in this gene are associated with visceral myopathy, megacystis-microcolon-intestinal hypoperistalsis syndrome 2, and familial thoracic aortic aneurysm 4. [provided by RefSeq, May 2022].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P35749","text":"Muscle contraction."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}