i_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P12034","text":"Plays an important role in the regulation of cell proliferation and cell differentiation. Required for normal regulation of the hair growth cycle. Functions as an inhibitor of hair elongation by promoting progression from anagen, the growth phase of the hair follicle, into catagen the apoptosis-induced regression phase (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}