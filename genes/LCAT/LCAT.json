or_log2fc":-0.268316,"donor_lfcse":0.18884,"donor_log2fc_shrunk":-0.0158986},{"cell_type":"OPC","gene_symbol":"LCAT","gene_symbol_current":"LCAT","gene_id":"ENSG00000213398","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0347832,"donor_lfcse":0.183842,"donor_log2fc_shrunk":1.0578e-06},{"cell_type":"Oli","gene_symbol":"LCAT","gene_symbol_current":"LCAT","gene_id":"ENSG00000213398","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.634306,"donor_log2fc":-0.350097,"donor_lfcse":0.184015,"donor_log2fc_shrunk":-0.0118854}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000213398","module":"brown","kme":0.110141,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000213398","entrez_id":["3931"],"uniprot":["P04180"],"ncbi_summary":"This gene encodes the extracellular cholesterol esterifying enzyme, lecithin-cholesterol acyltransferase. The esterification of cholesterol is required for cholesterol transport. Mutations in this gene have been found to cause fish-eye disease as well as LCAT deficiency. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P04180","text":"Central enzyme in the extracellular metabolism of plasma lipoproteins. Synthesized mainly in the liver and secreted into plasma where it converts cholesterol and phosphatidylcholines (lecithins) to cholesteryl esters and lysophosphatidylcholines on the surface of high and low density lipoproteins (HDLs and LDLs) (PubMed:10329423, PubMed:19065001, PubMed:26195816). The cholesterol ester is then transported back to the liver. Has a preference for plasma 16:0-18:2 or 18:O-18:2 phosphatidylcholines (PubMed:8820107). Also produced in the brain by primary astrocytes, and esterifies free cholesterol on nascent APOE-containing lipoproteins secreted from glia and influences cerebral spinal fluid (CSF) APOE- and APOA1 levels. Together with APOE and the cholesterol transporter ABCA1, plays a key role in the maturation of glial-derived, nascent lipoproteins. Required for remodeling high-density lipoprotein particles into their spherical forms (PubMed:10722751). Catalyzes the hydrolysis of 1-O-alkyl-2-acetyl-sn-glycero-3-phosphocholine (platelet-activating factor or PAF) to 1-O-alkyl-sn-glycero-3-phosphocholine (lyso-PAF) (PubMed:8016111). Also catalyzes the transfer of the acetate group from PAF to 1-hexadecanoyl-sn-glycero-3-phosphocholine forming lyso-PAF (PubMed:8016111). Catalyzes the esterification of (24S)-hydroxycholesterol (24(S)OH-C), also known as cerebrosterol to produce 24(S)OH-C monoesters (PubMed:24620755)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}