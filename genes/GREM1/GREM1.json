or_padj":0.805768,"donor_log2fc":0.127382,"donor_lfcse":0.171146,"donor_log2fc_shrunk":0.00400798},{"cell_type":"In","gene_symbol":"GREM1","gene_symbol_current":"GREM1","gene_id":"ENSG00000166923","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.945243,"donor_log2fc":-0.0488454,"donor_lfcse":0.171395,"donor_log2fc_shrunk":-0.000789585},{"cell_type":"Mic","gene_symbol":"GREM1","gene_symbol_current":"GREM1","gene_id":"ENSG00000166923","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.844596,"donor_log2fc":-0.264379,"donor_lfcse":0.344341,"donor_log2fc_shrunk":-0.00468772},{"cell_type":"Oli","gene_symbol":"GREM1","gene_symbol_current":"GREM1","gene_id":"ENSG00000166923","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.244824,"nucleus_log2fc":-0.0105339,"nucleus_score":-1.26777,"pct_ad":0.35752,"pct_control":0.36546,"donor_test":"not significant","donor_padj":0.969495,"donor_log2fc":0.0575982,"donor_lfcse":0.201093,"donor_log2fc_shrunk":0.00151822}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000166923","entrez_id":["26585"],"uniprot":["O60565"],"ncbi_summary":"This gene encodes a member of the BMP (bone morphogenic protein) antagonist family. Like BMPs, BMP antagonists contain cystine knots and typically form homo- and heterodimers. The CAN (cerberus and dan) subfamily of BMP antagonists, to which this gene belongs, is characterized by a C-terminal cystine knot with an eight-membered ring. The antagonistic effect of the secreted glycosylated protein encoded by this gene is likely due to its direct binding to BMP proteins. As an antagonist of BMP, this gene may play a role in regulating organogenesis, body patterning, and tissue differentiation. In mouse, this protein has been shown to relay the sonic hedgehog (SHH) signal from the polarizing region to the apical ectodermal ridge during limb bud outgrowth. Alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60565","text":"Cytokine that may play an important role during carcinogenesis and metanephric kidney organogenesis, as a BMP antagonist required for early limb outgrowth and patterning in maintaining the FGF4-SHH feedback loop. Down-regulates the BMP4 signaling in a dose-dependent manner (By similarity). Antagonist of BMP2; inhibits BMP2-mediated differentiation of osteoblasts (in vitro) (PubMed:27036124). Acts as inhibitor of monocyte chemotaxis. Can inhibit the growth or viability of normal cells but not transformed cells when is overexpressed (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}