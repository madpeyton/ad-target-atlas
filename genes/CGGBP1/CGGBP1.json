le":"brown","kme":0.29188,"hub":false,"module_direction":"higher in AD","module_padj":0.939268,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000163320","module":"turquoise","kme":0.292737,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000163320","module":"turquoise","kme":0.208041,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163320","entrez_id":["8545"],"uniprot":["Q9UFW8"],"ncbi_summary":"This gene encodes a CGG repeat-binding protein that primarily localizes to the nucleus. CGG trinucleotide repeats are implicated in many disorders as they often act as transcription- and translation-regulatory elements, can produce hairpin structures which cause DNA replication errors, and form regions prone to chromosomal breakage. CGG repeats are also targets for CpG methylation. In addition to its ability to bind CGG repeats and regulate transcription, this gene is believed to play a role in DNA damage repair and telomere protection. In vitro studies indicate this protein does not bind to methylated CpG sequences. [provided by RefSeq, Jul 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UFW8","text":"Binds to nonmethylated 5'-d(CGG)(n)-3' trinucleotide repeats in the FMR1 promoter. May play a role in regulating FMR1 promoter."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}