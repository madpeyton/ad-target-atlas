[{"gene_id":"ENSG00000103021","entrez_id":["29070"],"uniprot":["Q9H0I3"],"ncbi_summary":"Involved in cilium assembly. Located in centriolar satellite and ciliary basal body. Part of protein-containing complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H0I3","text":"Component of centriolar satellites contributing to primary cilium formation (PubMed:25074808). In complex with CFAP263, acts as a regulator of ciliary beating that connects radial spoke 3 (RS3) to the inner dynein arm (IDA) and the nexin-dynein regulatory complex (N-DRC). The complex is positioned parallel to N-DRC and forms a connection between the arch at the base of RS3, the IDA tail and N-DRC (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}