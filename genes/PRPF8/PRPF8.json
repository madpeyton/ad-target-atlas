D","nucleus_padj":0.0580382,"nucleus_log2fc":-0.0978797,"nucleus_score":-2.34706,"pct_ad":0.36952,"pct_control":0.386622,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0889326,"donor_lfcse":0.0921601,"donor_log2fc_shrunk":1.04366e-05,"degas_log2fc":0.212579,"degas_padj":3.36194e-06},{"cell_type":"Oli","gene_symbol":"PRPF8","gene_symbol_current":"PRPF8","gene_id":"ENSG00000174231","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.828354,"nucleus_log2fc":-0.00783938,"nucleus_score":-0.253311,"pct_ad":0.237297,"pct_control":0.237608,"donor_test":"not significant","donor_padj":0.982552,"donor_log2fc":0.00932632,"donor_lfcse":0.0606143,"donor_log2fc_shrunk":0.00221565,"degas_log2fc":-0.0527187,"degas_padj":0.0321799}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000174231","module":"turquoise","kme":0.0586306,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000174231","module":"brown","kme":0.262002,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000174231","module":"turquoise","kme":0.0616859,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000174231","module":"turquoise","kme":0.0449959,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000174231","entrez_id":["10594"],"uniprot":["Q6P2Q9"],"ncbi_summary":"Pre-mRNA splicing occurs in 2 sequential transesterification steps. The protein encoded by this gene is a component of both U2- and U12-dependent spliceosomes, and found to be essential for the catalytic step II in pre-mRNA splicing process. It contains several WD repeats, which function in protein-protein interactions. This protein has a sequence similarity to yeast Prp8 protein. This gene is a candidate gene for autosomal dominant retinitis pigmentosa. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6P2Q9","text":"Plays a role in pre-mRNA splicing as core component of precatalytic, catalytic and postcatalytic spliceosomal complexes, both of the predominant U2-type spliceosome and the minor U12-type spliceosome (PubMed:10411133, PubMed:11971955, PubMed:28076346, PubMed:28502770, PubMed:28781166, PubMed:29301961, PubMed:29360106, PubMed:29361316, PubMed:30315277, PubMed:30705154, PubMed:30728453). Functions as a scaffold that mediates the ordered assembly of spliceosomal proteins and snRNAs. Required for the assembly of the U4/U6-U5 tri-snRNP complex, a building block of the spliceosome. Functions as a scaffold that positions spliceosomal U2, U5 and U6 snRNAs at splice sites on pre-mRNA substrates, so that splicing can occur. Interacts with both the 5' and the 3' splice site."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}