eaad_pfc#gene/SLC5A8","cell_types":[{"cell_type":"Ex","gene_symbol":"SLC5A8","gene_symbol_current":"SLC5A8","gene_id":"ENSG00000256870","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.0783934,"nucleus_log2fc":0.0100112,"nucleus_score":-1.80614,"pct_ad":0.117916,"pct_control":0.120668,"donor_test":"not significant","donor_padj":0.860851,"donor_log2fc":0.0602789,"donor_lfcse":0.111757,"donor_log2fc_shrunk":0.00416649},{"cell_type":"In","gene_symbol":"SLC5A8","gene_symbol_current":"SLC5A8","gene_id":"ENSG00000256870","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":9.83658e-15,"nucleus_log2fc":-0.109055,"nucleus_score":-7.84594,"pct_ad":0.21684,"pct_control":0.232417,"donor_test":"not significant","donor_padj":0.915959,"donor_log2fc":-0.0361576,"donor_lfcse":0.0872727,"donor_log2fc_shrunk":-0.00197647},{"cell_type":"Oli","gene_symbol":"SLC5A8","gene_symbol_current":"SLC5A8","gene_id":"ENSG00000256870","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.971521,"donor_log2fc":-0.0676569,"donor_lfcse":0.25522,"donor_log2fc_shrunk":-0.00105457}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000256870","module":"greenyellow","kme":0.433353,"hub":false,"module_direction":"lower in AD","module_padj":0.398964,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000256870","module":"blue","kme":0.411883,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000256870","entrez_id":["160728"],"uniprot":["Q8N695"],"ncbi_summary":"SLC5A8 has been shown to transport iodide by a passive mechanism (Rodriguez et al., 2002 [PubMed 12107270]) and monocarboxylates and short-chain fatty acids by a sodium-coupled mechanism (Gopal et al., 2004 [PubMed 15322102]). In kidney, SLC5A8 functions as a high-affinity sodium-coupled lactate transporter involved in reabsorption of lactate and maintenance of blood lactate levels (Thangaraju et al., 2006 [PubMed 16873376]).[supplied by OMIM, Dec 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8N695","text":"Acts as an electrogenic sodium (Na(+)) and chloride (Cl-)-dependent sodium-coupled solute transporter, including transport of monocarboxylates (short-chain fatty acids including L-lactate, D-lactate, pyruvate, acetate, propionate, valerate and butyrate), mocarboxylate drugs (nicotinate, benzoate, salicylate and 5-aminosalicylate) and ketone bodies (beta-D-hydroxybutyrate, acetoacetate and alpha-ketoisocaproate), with a Na(+):substrate stoichiometry of between 4:1 and 2:1 (PubMed:14966140, PubMed:15090606, PubMed:16729224, PubMed:16805814, PubMed:17178845, PubMed:17245649, PubMed:17526579, PubMed:20211600, PubMed:30604288). Catalyzes passive carrier mediated diffusion of iodide (PubMed:12107270). Mediates iodide transport from the thyrocyte into the colloid lumen through the apical membrane (PubMed:12107270). May be responsible for the absorption of D-lactate and monocarboxylate drugs from the intestinal tract (PubMed:17245649). Acts as a tumor suppressor, suppressing colony formation in colon cancer, prostate cancer and glioma cell lines (PubMed:12829793, PubMed:15867356, PubMed:18037591). May play a critical role in the entry of L-lactate and ketone bodies into neurons by a process driven by an electrochemical Na(+) gradient and hence contribute to the maintenance of the energy status and function of neurons (PubMed:16805814). Mediates sodium-coupled electrogenic transport of pyroglutamate (5-oxo-L-proline) (PubMed:20211600). Can mediate the transport of chloride, bromide, iodide and nitrate ions when the external concentration of sodium ions is reduced (PubMed:19864324). Part of D-serine transport systems. May contribute to D-serine reabsorption at the brush border of renal proximal tubules thus modulating the dynamics of urinary versus blood D-serine levels."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}