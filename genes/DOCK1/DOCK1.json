l_type":"In","gene_id":"ENSG00000150760","module":"blue","kme":0.142374,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000150760","module":"turquoise","kme":0.0330307,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000150760","module":"brown","kme":0.376657,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000150760","module":"blue","kme":0.335791,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000150760","entrez_id":["1793"],"uniprot":["Q14185"],"ncbi_summary":"This gene encodes a member of the dedicator of cytokinesis protein family. Dedicator of cytokinesis proteins act as guanine nucleotide exchange factors for small Rho family G proteins. The encoded protein regulates the small GTPase Rac, thereby influencing several biological processes, including phagocytosis and cell migration. Overexpression of this gene has also been associated with certain cancers. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Mar 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q14185","text":"Involved in cytoskeletal rearrangements required for phagocytosis of apoptotic cells and cell motility. Along with DOCK1, mediates CRK/CRKL regulation of epithelial and endothelial cell spreading and migration on type IV collagen (PubMed:19004829). Functions as a guanine nucleotide exchange factor (GEF), which activates Rac Rho small GTPases by exchanging bound GDP for free GTP. Its GEF activity may be enhanced by ELMO1 (PubMed:8657152)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}