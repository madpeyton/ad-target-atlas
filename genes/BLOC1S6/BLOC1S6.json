4","module":"turquoise","kme":0.0730877,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000104164","module":"red","kme":0.228654,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000104164","module":"turquoise","kme":0.0586271,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000104164","entrez_id":["26258"],"uniprot":["Q9UL45"],"ncbi_summary":"The protein encoded by this gene may play a role in intracellular vesicle trafficking. It interacts with Syntaxin 13 which mediates intracellular membrane fusion. Mutations in this gene cause symptoms associated with Hermansky-Pudlak syndrome-9. Alternative splicing results in multiple transcript variants. A pseudogene related to this gene is located on the X chromosome. [provided by RefSeq, Aug 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UL45","text":"Component of the BLOC-1 complex, a complex that is required for normal biogenesis of lysosome-related organelles (LRO), such as platelet dense granules and melanosomes. In concert with the AP-3 complex, the BLOC-1 complex is required to target membrane protein cargos into vesicles assembled at cell bodies for delivery into neurites and nerve terminals. The BLOC-1 complex, in association with SNARE proteins, is also proposed to be involved in neurite extension. May play a role in intracellular vesicle trafficking, particularly in the vesicle-docking and fusion process."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}