direction":"higher in AD","nucleus_padj":0.528988,"nucleus_log2fc":0.0377384,"nucleus_score":0.67022,"pct_ad":0.238095,"pct_control":0.238528,"donor_test":"not significant","donor_padj":0.73532,"donor_log2fc":0.113903,"donor_lfcse":0.0734042,"donor_log2fc_shrunk":0.0122798},{"cell_type":"Mic","gene_symbol":"ELOA","gene_symbol_current":"ELOA","gene_id":"ENSG00000011007","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.172824,"nucleus_log2fc":0.0773105,"nucleus_score":1.59372,"pct_ad":0.103064,"pct_control":0.0959677,"donor_test":"not significant","donor_padj":0.999083,"donor_log2fc":-0.000594052,"donor_lfcse":0.107747,"donor_log2fc_shrunk":0.0037666},{"cell_type":"OPC","gene_symbol":"ELOA","gene_symbol_current":"ELOA","gene_id":"ENSG00000011007","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0716652,"nucleus_log2fc":0.125786,"nucleus_score":2.24431,"pct_ad":0.149269,"pct_control":0.134632,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.182803,"donor_lfcse":0.0869756,"donor_log2fc_shrunk":2.50943e-05},{"cell_type":"Oli","gene_symbol":"ELOA","gene_symbol_current":"ELOA","gene_id":"ENSG00000011007","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00586513,"nucleus_log2fc":0.105451,"nucleus_score":2.89307,"pct_ad":0.112799,"pct_control":0.105991,"donor_test":"not significant","donor_padj":0.792112,"donor_log2fc":0.107806,"donor_lfcse":0.0849001,"donor_log2fc_shrunk":0.0157804}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000011007","entrez_id":["6924"],"uniprot":["Q14241"],"ncbi_summary":"This gene encodes the protein elongin A, which is a subunit of the transcription factor B (SIII) complex. The SIII complex is composed of elongins A/A2, B and C. It activates elongation by RNA polymerase II by suppressing transient pausing of the polymerase at many sites within transcription units. Elongin A functions as the transcriptionally active component of the SIII complex, whereas elongins B and C are regulatory subunits. Elongin A2 is specifically expressed in the testis, and capable of forming a stable complex with elongins B and C. The von Hippel-Lindau tumor suppressor protein binds to elongins B and C, and thereby inhibits transcription elongation. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q14241","text":"SIII, also known as elongin, is a general transcription elongation factor that increases the RNA polymerase II transcription elongation past template-encoded arresting sites. Subunit A is transcriptionally active and its transcription activity is strongly enhanced by binding to the dimeric complex of the SIII regulatory subunits B and C (elongin BC complex). As part of a multisubunit complex composed of elongin BC complex (ELOB and ELOC), elongin A/ELOA, RBX1 and CUL5; polyubiquitinates monoubiquitinated POLR2A."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}