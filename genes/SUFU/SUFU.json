us_direction":"higher in AD","nucleus_padj":0.000300217,"nucleus_log2fc":0.0958786,"nucleus_score":3.76253,"pct_ad":0.196164,"pct_control":0.184922,"donor_test":"not significant","donor_padj":0.944117,"donor_log2fc":0.0569216,"donor_lfcse":0.12257,"donor_log2fc_shrunk":0.00384859,"degas_log2fc":-0.265141,"degas_padj":2.16411e-22}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000107882","module":"yellow","kme":0.191832,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000107882","module":"pink","kme":0.219222,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000107882","module":"blue","kme":0.114281,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000107882","entrez_id":["51684"],"uniprot":["Q9UMX1"],"ncbi_summary":"The Hedgehog signaling pathway plays an important role in early human development. The pathway is a signaling cascade that plays a role in pattern formation and cellular proliferation during development. This gene encodes a negative regulator of the hedgehog signaling pathway. Defects in this gene are a cause of medulloblastoma. Alternative splicing results in multiple transcript variants.[provided by RefSeq, May 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UMX1","text":"Negative regulator in the hedgehog/smoothened signaling pathway that acts by sequestering the GLI (GI1, GLI2 and GLI3) transcription factors in the cytoplasm (PubMed:10559945, PubMed:10564661, PubMed:10806483, PubMed:12068298, PubMed:12975309, PubMed:15367681, PubMed:22365972, PubMed:24217340, PubMed:24311597, PubMed:27234298, PubMed:28965847, PubMed:35831023). When smoothened signaling is initiated, GLI transcription factors dissociate from SUFU, translocate to the nucleus and activate expression of target genes (PubMed:24311597, PubMed:28965847, PubMed:35831023). In absence of smoothened signaling, the SUFU-GLI3 complex is recruited to cilia, leading to the efficient processing of full-length GLI3 into transcription repressor GLI3R: SUFU participates to GLI3 processing by promoting recruitment of GSK3B to GLI3 (PubMed:24311597, PubMed:28965847). May also act as a negative regulator of beta-catenin signaling (By similarity). Required for normal embryonic development (By similarity). Required for the proper formation of hair follicles and the control of epidermal differentiation (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}