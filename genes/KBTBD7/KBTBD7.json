ENSG00000120696","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.867581,"donor_log2fc":0.0961048,"donor_lfcse":0.105108,"donor_log2fc_shrunk":0.00935715,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000120696","module":"turquoise","kme":0.0707461,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000120696","module":"turquoise","kme":0.0600318,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000120696","entrez_id":["84078"],"uniprot":["Q8WVZ9"],"ncbi_summary":"The protein encoded by this gene is a transcriptional activator, having been shown to increase the transcription of activator protein-1 and serum response element. The encoded protein can also form a complex with KBTBD6 and CUL3, which regulates the ubiquitylation and degradation of TIAM1, which is a regulator of RAC1. [provided by RefSeq, Jul 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WVZ9","text":"As part of the CUL3(KBTBD6/7) E3 ubiquitin ligase complex functions as a substrate adapter for the RAC1 guanine exchange factor (GEF) TIAM1, mediating its 'Lys-48' ubiquitination and proteasomal degradation (PubMed:25684205). By controlling this ubiquitination, regulates RAC1 signal transduction and downstream biological processes including the organization of the cytoskeleton, cell migration and cell proliferation (PubMed:25684205). Ubiquitination of TIAM1 requires the membrane-associated protein GABARAP which may restrict locally the activity of the complex (PubMed:25684205)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}