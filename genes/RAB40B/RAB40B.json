ll_type":"Oli","gene_symbol":"RAB40B","gene_symbol_current":"RAB40B","gene_id":"ENSG00000141542","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0142736,"nucleus_log2fc":0.136599,"nucleus_score":2.7948,"pct_ad":0.230154,"pct_control":0.2107,"donor_test":"not significant","donor_padj":0.895523,"donor_log2fc":0.058563,"donor_lfcse":0.0785094,"donor_log2fc_shrunk":0.00831379}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000141542","module":"tan","kme":0.104421,"hub":false,"module_direction":"lower in AD","module_padj":0.333899,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000141542","module":"pink","kme":0.366422,"hub":false,"module_direction":"higher in AD","module_padj":1.0,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000141542","module":"turquoise","kme":0.133504,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000141542","entrez_id":["10966"],"uniprot":["Q12829"],"ncbi_summary":"The protein encoded by this gene has similarity to a yeast protein which suggests a role of the gene product in regulating secretory vesicles. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q12829","text":"RAB40B small GTPase acts as substrate-recognition components of the ECS(RAB40B) E3 ubiquitin ligase complex which mediates the ubiquitination of target proteins (PubMed:33999101, PubMed:35293963). The Rab40 subfamily belongs to the Rab family that are key regulators of intracellular membrane trafficking, from the formation of transport vesicles to their fusion with membranes. Rabs cycle between an inactive GDP-bound form and an active GTP-bound form that is able to recruit to membranes different sets of downstream effectors directly responsible for vesicle formation, movement, tethering and fusion (PubMed:27789576). As part of the ECS(RAB40B) complex, GTP-bound RAB40B promotes LIMA1/EPLIN ubiquitination and degradation, thereby regulating leading-edge actin dynamics during cell migration (PubMed:33999101). As part of the ECS(RAB40B) complex, GTP-bound RAB40B also ubiquitinates RAP2A GTPase which promotes its localization to lamellipodia and activation to drive cell migration. The ECS(RAB40B) complex does not mediate canonical ubiquitin-dependent degradation of RAP2 (PubMed:35293963). RAB40B also binds TKS5/SH3PXD2A effector independently from ECS complex to promote invadopodia-mediated extracellular matrix degradation (PubMed:27789576)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}