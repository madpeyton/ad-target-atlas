ne_symbol":"DGKB","gene_symbol_current":"DGKB","gene_id":"ENSG00000136267","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0135367,"nucleus_log2fc":-0.215531,"nucleus_score":-3.66387,"pct_ad":0.580302,"pct_control":0.608777,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.130605,"donor_lfcse":0.105355,"donor_log2fc_shrunk":-1.20851e-05},{"cell_type":"OPC","gene_symbol":"DGKB","gene_symbol_current":"DGKB","gene_id":"ENSG00000136267","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.583806,"nucleus_log2fc":-0.110412,"nucleus_score":-1.0758,"pct_ad":0.324961,"pct_control":0.351724,"donor_test":"not significant","donor_padj":0.999878,"donor_log2fc":0.0116462,"donor_lfcse":0.198664,"donor_log2fc_shrunk":5.6246e-05}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000136267","module":"black","kme":0.272486,"hub":false,"module_direction":"higher in AD","module_padj":0.56571,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000136267","module":"blue","kme":0.593248,"hub":true,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000136267","module":"blue","kme":0.342513,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000136267","module":"red","kme":0.198892,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136267","entrez_id":["1607"],"uniprot":["Q9Y6T7"],"ncbi_summary":"Diacylglycerol kinases (DGKs) are regulators of the intracellular concentration of the second messenger diacylglycerol (DAG) and thus play a key role in cellular processes. Nine mammalian isotypes have been identified, which are encoded by separate genes. Mammalian DGK isozymes contain a conserved catalytic (kinase) domain and a cysteine-rich domain (CRD). The protein encoded by this gene is a diacylglycerol kinase, beta isotype. Several alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Apr 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y6T7","text":"Diacylglycerol kinase that converts diacylglycerol/DAG into phosphatidic acid/phosphatidate/PA and regulates the respective levels of these two bioactive lipids (PubMed:11719522). Thereby, acts as a central switch between the signaling pathways activated by these second messengers with different cellular targets and opposite effects in numerous biological processes (Probable). Has a higher activity with long-chain diacylglycerols like 1,2-di-(9Z-octadecenoyl)-sn-glycerol compared to 1,2-didecanoyl-sn-glycerol (By similarity). Specifically expressed in brain, it regulates neuron-specific morphological changes including neurite branching and neurite spine formation (By similarity). [Isoform 2]: Does not associate with membranes but has a diacylglycerol kinase activity."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}