-3.1019e-05}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000169230","module":"turquoise","kme":0.463801,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000169230","module":"turquoise","kme":0.398755,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000169230","module":"turquoise","kme":0.115784,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000169230","entrez_id":["27166"],"uniprot":["Q9Y255"],"ncbi_summary":"This gene encodes a member of the late embryogenesis abundant motif-containing protein family. The encoded protein is localized to mitochondria and may function as a cytoprotectant by regulating cell death and differentiation. Alternative splicing results in multiple transcript variants encoding different isoforms. Several related pseudogenes have been identified. [provided by RefSeq, Nov 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y255","text":"Involved in the modulation of the mitochondrial apoptotic pathway by ensuring the accumulation of cardiolipin (CL) in mitochondrial membranes. In vitro, the TRIAP1:PRELID1 complex mediates the transfer of phosphatidic acid (PA) between liposomes and probably functions as a PA transporter across the mitochondrion intermembrane space to provide PA for CL synthesis in the inner membrane. Regulates the mitochondrial apoptotic pathway in primary Th cells. Regulates Th cell differentiation by down-regulating STAT6 thereby reducing IL-4-induced Th2 cell number. May be important for the development of vital and immunocompetent organs."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}