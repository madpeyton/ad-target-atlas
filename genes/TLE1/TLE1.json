se}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000196781","entrez_id":["7088"],"uniprot":["Q04724"],"ncbi_summary":"Enables identical protein binding activity and transcription corepressor activity. Involved in negative regulation of I-kappaB kinase/NF-kappaB signaling; negative regulation of anoikis; and regulation of gene expression. Located in cytosol and nucleoplasm. Part of beta-catenin-TCF complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q04724","text":"Transcriptional corepressor that binds to a number of transcription factors. Inhibits NF-kappa-B-regulated gene expression. Inhibits the transcriptional activation mediated by FOXA2, and by CTNNB1 and TCF family members in Wnt signaling. Enhances FOXG1/BF-1- and HES1-mediated transcriptional repression (By similarity). The effects of full-length TLE family members may be modulated by association with dominant-negative AES. Unusual function as coactivator for ESRRG."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}