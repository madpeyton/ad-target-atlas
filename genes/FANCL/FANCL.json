dule_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000115392","module":"pink","kme":0.265638,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000115392","module":"magenta","kme":0.202797,"hub":false,"module_direction":"higher in AD","module_padj":0.939268,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000115392","module":"yellow","kme":0.217988,"hub":false,"module_direction":"lower in AD","module_padj":0.0240838,"module_significant":true}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000115392","entrez_id":["55120"],"uniprot":["Q9NW38"],"ncbi_summary":"This gene encodes a ubiquitin ligase that is a member of the Fanconi anemia complementation group (FANC). Members of this group are related by their assembly into a common nuclear protein complex rather than by sequence similarity. This gene encodes the protein for complementation group L that mediates monoubiquitination of FANCD2 as well as FANCI. Fanconi anemia is a genetically heterogeneous recessive disorder characterized by cytogenetic instability, hypersensitivity to DNA crosslinking agents, increased chromosomal breakage, and defective DNA repair. Alternative splicing results in multiple transcript variants. [provided by RefSeq, May 2018].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NW38","text":"Ubiquitin ligase protein that mediates monoubiquitination of FANCD2 in the presence of UBE2T, a key step in the DNA damage pathway (PubMed:12973351, PubMed:16916645, PubMed:17938197, PubMed:19111657, PubMed:24389026). Also mediates monoubiquitination of FANCI (PubMed:19589784). May stimulate the ubiquitin release from UBE2W. May be required for proper primordial germ cell proliferation in the embryonic stage, whereas it is probably not needed for spermatogonial proliferation after birth."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}