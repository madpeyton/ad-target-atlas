G00000109270","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.624179,"donor_log2fc":0.149906,"donor_lfcse":0.104446,"donor_log2fc_shrunk":0.0295616},{"cell_type":"OPC","gene_symbol":"LAMTOR3","gene_symbol_current":"LAMTOR3","gene_id":"ENSG00000109270","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00804143,"nucleus_log2fc":0.273203,"nucleus_score":3.14582,"pct_ad":0.115866,"pct_control":0.0987299,"donor_test":"not significant","donor_padj":0.991471,"donor_log2fc":0.26896,"donor_lfcse":0.0986722,"donor_log2fc_shrunk":2.88925e-05},{"cell_type":"Oli","gene_symbol":"LAMTOR3","gene_symbol_current":"LAMTOR3","gene_id":"ENSG00000109270","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.768859,"donor_log2fc":0.100748,"donor_lfcse":0.0741046,"donor_log2fc_shrunk":0.0193979}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000109270","module":"brown","kme":0.163389,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000109270","entrez_id":["8649"],"uniprot":["Q9UHA4"],"ncbi_summary":"This gene encodes a scaffold protein that functions in the extracellular signal-regulated kinase (ERK) cascade. The protein is localized to late endosomes by the mitogen-activated protein-binding protein-interacting protein, and binds specifically to MAP kinase kinase MAP2K1/MEK1, MAP kinase MAPK3/ERK1, and MAP kinase MAPK1/ERK2. Studies of the orthologous gene in mouse indicate that it regulates late endosomal traffic and cell proliferation. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene. A pseudogene of this gene is located on the long arm of chromosome 13. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UHA4","text":"As part of the Ragulator complex it is involved in amino acid sensing and activation of mTORC1, a signaling complex promoting cell growth in response to growth factors, energy levels, and amino acids (PubMed:20381137, PubMed:22980980, PubMed:28935770, PubMed:29107538, PubMed:29123114, PubMed:29158492, PubMed:30181260). Activated by amino acids through a mechanism involving the lysosomal V-ATPase, the Ragulator plays a dual role for the small GTPases Rag (RagA/RRAGA, RagB/RRAGB, RagC/RRAGC and/or RagD/RRAGD): it (1) acts as a guanine nucleotide exchange factor (GEF), activating the small GTPases Rag and (2) mediates recruitment of Rag GTPases to the lysosome membrane (PubMed:22053050, PubMed:22980980, PubMed:28935770, PubMed:29107538, PubMed:29123114, PubMed:29158492, PubMed:30181260). Activated Ragulator and Rag GTPases function as a scaffold recruiting mTORC1 to lysosomes where it is in turn activated (PubMed:22980980, PubMed:28935770, PubMed:29107538, PubMed:29123114, PubMed:29158492, PubMed:30181260). Adapter protein that enhances the efficiency of the MAP kinase cascade facilitating the activation of MAPK2 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}