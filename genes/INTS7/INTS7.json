.0588267,"nucleus_score":1.18955,"pct_ad":0.296898,"pct_control":0.287045,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0918598,"donor_lfcse":0.10932,"donor_log2fc_shrunk":7.85582e-06},{"cell_type":"Oli","gene_symbol":"INTS7","gene_symbol_current":"INTS7","gene_id":"ENSG00000143493","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000148538,"nucleus_log2fc":0.106276,"nucleus_score":3.94247,"pct_ad":0.278749,"pct_control":0.268236,"donor_test":"not significant","donor_padj":0.929122,"donor_log2fc":0.0638627,"donor_lfcse":0.112689,"donor_log2fc_shrunk":0.00557496}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000143493","module":"yellow","kme":0.152064,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000143493","module":"blue","kme":0.145138,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000143493","module":"blue","kme":0.153299,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000143493","entrez_id":["25896"],"uniprot":["Q9NVH2"],"ncbi_summary":"This gene encodes a subunit of the integrator complex. The integrator complex associates with the C-terminal domain of RNA polymerase II and mediates 3'-end processing of the small nuclear RNAs U1 and U2. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene. [provided by RefSeq, Dec 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NVH2","text":"Component of the integrator complex, a multiprotein complex that terminates RNA polymerase II (Pol II) transcription in the promoter-proximal region of genes (PubMed:33243860, PubMed:38570683). The integrator complex provides a quality checkpoint during transcription elongation by driving premature transcription termination of transcripts that are unfavorably configured for transcriptional elongation: the complex terminates transcription by (1) catalyzing dephosphorylation of the C-terminal domain (CTD) of Pol II subunit POLR2A/RPB1 and SUPT5H/SPT5, (2) degrading the exiting nascent RNA transcript via endonuclease activity and (3) promoting the release of Pol II from bound DNA (PubMed:33243860, PubMed:38570683). The integrator complex is also involved in terminating the synthesis of non-coding Pol II transcripts, such as enhancer RNAs (eRNAs), small nuclear RNAs (snRNAs), telomerase RNAs and long non-coding RNAs (lncRNAs) (PubMed:16239144). May be not involved in the recruitment of cytoplasmic dynein to the nuclear envelope by different components of the INT complex (PubMed:23904267). Plays a role in DNA damage response (DDR) signaling during the S phase (PubMed:21659603)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}