"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.993006,"nucleus_log2fc":-0.0438904,"nucleus_score":0.0302003,"pct_ad":0.168589,"pct_control":0.1662,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0801401,"donor_lfcse":0.11506,"donor_log2fc_shrunk":-5.60672e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000064309","module":"blue","kme":0.147488,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000064309","module":"brown","kme":0.137469,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000064309","entrez_id":["50937"],"uniprot":["Q4KMG0"],"ncbi_summary":"This gene encodes a cell surface receptor that is a member of the immunoglobulin superfamily. The encoded protein contains three fibronectin type III domains and five immunoglobulin-like C2-type domains. This protein is a member of a cell-surface receptor complex that mediates cell-cell interactions between muscle precursor cells and positively regulates myogenesis. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q4KMG0","text":"Together with BOC, forms a coreceptor required for sonic hedgehog (SHH) handoff to its patched receptor (PTCH1 or PTCH2), thereby allowing activation of the smoothened signaling pathway (By similarity). Binds to the dually lipid-modified Sonic hedgehog protein N-product (ShhN) downstream of SCUBE2 carrier and promotes its release to GAS1 (By similarity). ShhN is then directly transferred to patched receptor by GAS1 (By similarity). May also mediate cell-cell interactions between muscle precursor cells, promoting differentiation of myogenic cells (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}