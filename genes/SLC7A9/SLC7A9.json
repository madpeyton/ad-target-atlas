t","donor_padj":0.95799,"donor_log2fc":-0.0447637,"donor_lfcse":0.23981,"donor_log2fc_shrunk":-0.000697491,"degas_log2fc":-0.206061,"degas_padj":6.95661e-35},{"cell_type":"In","gene_symbol":"SLC7A9","gene_symbol_current":"SLC7A9","gene_id":"ENSG00000021488","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.966912,"donor_log2fc":0.0374168,"donor_lfcse":0.210525,"donor_log2fc_shrunk":0.000429509,"degas_log2fc":-0.28932,"degas_padj":1.30774e-27},{"cell_type":"Oli","gene_symbol":"SLC7A9","gene_symbol_current":"SLC7A9","gene_id":"ENSG00000021488","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999341,"donor_log2fc":-0.00171694,"donor_lfcse":0.235123,"donor_log2fc_shrunk":-2.58613e-05,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000021488","entrez_id":["11136"],"uniprot":["P82251"],"ncbi_summary":"This gene encodes a protein that belongs to a family of light subunits of amino acid transporters. This protein plays a role in the high-affinity and sodium-independent transport of cystine and neutral and dibasic amino acids, and appears to function in the reabsorption of cystine in the kidney tubule. Mutations in this gene cause non-type I cystinuria, a disease that leads to cystine stones in the urinary system due to impaired transport of cystine and dibasic amino acids. Alternate transcript variants, which encode the same protein, have been found for this gene. [provided by RefSeq, Jul 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P82251","text":"Associates with SLC3A1 to form a functional transporter complex that mediates the electrogenic exchange between cationic amino acids and neutral amino acids, with a stoichiometry of 1:1 (PubMed:16825196, PubMed:32494597, PubMed:32817565, PubMed:8663357). Has system b(0,+)-like activity with high affinity for extracellular cationic amino acids and L-cystine and lower affinity for intracellular neutral amino acids (PubMed:16825196, PubMed:32494597, PubMed:8663357). Substrate exchange is driven by high concentration of intracellular neutral amino acids and the intracellular reduction of L-cystine to L-cysteine (PubMed:8663357). Required for reabsorption of L-cystine and dibasic amino acids across the brush border membrane in renal proximal tubules."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}