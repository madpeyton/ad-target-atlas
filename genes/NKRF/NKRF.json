gnificant","donor_padj":0.889805,"donor_log2fc":-0.0745042,"donor_lfcse":0.0946623,"donor_log2fc_shrunk":-0.00855529}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000186416","module":"brown","kme":0.172828,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000186416","entrez_id":["55922"],"uniprot":["O15226"],"ncbi_summary":"This gene encodes a transcriptional repressor that interacts with specific negative regulatory elements to mediate transcriptional repression of certain nuclear factor kappa B responsive genes. The protein localizes predominantly to the nucleolus with a small fraction found in the nucleoplasm and cytoplasm. Alternate splicing results in multiple transcript variants. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O15226","text":"Enhances the ATPase activity of DHX15 by acting like a brace that tethers mobile sections of DHX15 together, stabilizing a functional conformation with high RNA affinity of DHX15 (PubMed:12381793). Involved in the constitutive silencing of the interferon beta promoter, independently of the virus-induced signals, and in the inhibition of the basal and cytokine-induced iNOS promoter activity (PubMed:12381793). Also involved in the regulation of IL-8 transcription (PubMed:12381793). May also act as a DNA-binding transcription regulator: interacts with a specific negative regulatory element (NRE) 5'-AATTCCTCTGA-3' to mediate transcriptional repression of certain NK-kappa-B responsive genes (PubMed:10562553)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}