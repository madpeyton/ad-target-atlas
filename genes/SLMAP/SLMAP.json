t_function":[{"accession":"Q14BN4","text":"Associates with the striatin-interacting phosphatase and kinase (STRIPAK) core complex, forming the extended (SIKE1:SLMAP)STRIPAK complex (PubMed:29063833, PubMed:30622739). The (SIKE1:SLMAP)STRIPAK complex dephosphorylates STK3 leading to the inhibition of Hippo signaling and the control of cell growth (PubMed:29063833, PubMed:30622739). May play a role during myoblast fusion (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}