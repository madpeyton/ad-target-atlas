ection":"higher in AD","nucleus_padj":0.000367666,"nucleus_log2fc":0.108977,"nucleus_score":3.86293,"pct_ad":0.605014,"pct_control":0.586866,"donor_test":"not significant","donor_padj":0.690746,"donor_log2fc":0.087037,"donor_lfcse":0.0697532,"donor_log2fc_shrunk":0.0312847,"degas_log2fc":0.159138,"degas_padj":6.34725e-08},{"cell_type":"OPC","gene_symbol":"PHKB","gene_symbol_current":"PHKB","gene_id":"ENSG00000102893","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.506909,"nucleus_log2fc":0.0252271,"nucleus_score":0.9332,"pct_ad":0.671637,"pct_control":0.663167,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.00819266,"donor_lfcse":0.0667894,"donor_log2fc_shrunk":5.8828e-06,"degas_log2fc":-0.278447,"degas_padj":2.1657e-19},{"cell_type":"Oli","gene_symbol":"PHKB","gene_symbol_current":"PHKB","gene_id":"ENSG00000102893","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.520469,"nucleus_log2fc":0.0173507,"nucleus_score":0.718984,"pct_ad":0.516855,"pct_control":0.522367,"donor_test":"not significant","donor_padj":0.971483,"donor_log2fc":0.0232467,"donor_lfcse":0.0874391,"donor_log2fc_shrunk":0.00334305,"degas_log2fc":-0.264588,"degas_padj":2.41899e-61}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000102893","module":"yellow","kme":0.301004,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000102893","module":"yellow","kme":0.257206,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000102893","module":"blue","kme":0.1833,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000102893","entrez_id":["5257"],"uniprot":["Q93100"],"ncbi_summary":"Phosphorylase kinase is a polymer of 16 subunits, four each of alpha, beta, gamma and delta. The alpha subunit includes the skeletal muscle and hepatic isoforms, encoded by two different genes. The beta subunit is the same in both the muscle and hepatic isoforms, encoded by this gene, which is a member of the phosphorylase b kinase regulatory subunit family. The gamma subunit also includes the skeletal muscle and hepatic isoforms, encoded by two different genes. The delta subunit is a calmodulin and can be encoded by three different genes. The gamma subunits contain the active site of the enzyme, whereas the alpha and beta subunits have regulatory functions controlled by phosphorylation. The delta subunit mediates the dependence of the enzyme on calcium concentration. Mutations in this gene cause glycogen storage disease type 9B, also known as phosphorylase kinase deficiency of liver and muscle. Alternatively spliced transcript variants encoding different isoforms have been identified in this gene. Two pseudogenes have been found on chromosomes 14 and 20, respectively.[provided by RefSeq, Feb 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q93100","text":"Phosphorylase b kinase catalyzes the phosphorylation of serine in certain substrates, including troponin I. The beta chain acts as a regulatory unit and modulates the activity of the holoenzyme in response to phosphorylation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}