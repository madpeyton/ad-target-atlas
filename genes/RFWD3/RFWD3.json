5,"pct_ad":0.213742,"pct_control":0.21947,"donor_test":"not significant","donor_padj":0.999745,"donor_log2fc":-0.000218389,"donor_lfcse":0.0919865,"donor_log2fc_shrunk":-3.16522e-05},{"cell_type":"OPC","gene_symbol":"RFWD3","gene_symbol_current":"RFWD3","gene_id":"ENSG00000168411","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.848681,"nucleus_log2fc":0.0150287,"nucleus_score":0.305241,"pct_ad":0.104384,"pct_control":0.102456,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0587847,"donor_lfcse":0.143938,"donor_log2fc_shrunk":2.9363e-06},{"cell_type":"Oli","gene_symbol":"RFWD3","gene_symbol_current":"RFWD3","gene_id":"ENSG00000168411","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.911974,"nucleus_log2fc":-0.00409612,"nucleus_score":-0.130928,"pct_ad":0.140645,"pct_control":0.140918,"donor_test":"not significant","donor_padj":0.955965,"donor_log2fc":-0.0380181,"donor_lfcse":0.0977835,"donor_log2fc_shrunk":-0.00393963}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000168411","module":"blue","kme":0.0772354,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000168411","entrez_id":["55159"],"uniprot":["Q6PCD5"],"ncbi_summary":"Enables MDM2/MDM4 family protein binding activity; p53 binding activity; and ubiquitin protein ligase activity. Involved in several processes, including DNA metabolic process; regulation of cell cycle phase transition; and response to ionizing radiation. Located in nucleoplasm and site of DNA damage. Colocalizes with site of double-strand break. Implicated in Fanconi anemia. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6PCD5","text":"E3 ubiquitin-protein ligase required for the repair of DNA interstrand cross-links (ICL) in response to DNA damage (PubMed:21504906, PubMed:21558276, PubMed:26474068, PubMed:28575657, PubMed:28575658, PubMed:33321094). Plays a key role in RPA-mediated DNA damage signaling and repair (PubMed:21504906, PubMed:21558276, PubMed:26474068, PubMed:28575657, PubMed:28575658, PubMed:28691929). Acts by mediating ubiquitination of the RPA complex (RPA1, RPA2 and RPA3 subunits) and RAD51 at stalled replication forks, leading to remove them from DNA damage sites and promote homologous recombination (PubMed:26474068, PubMed:28575657, PubMed:28575658). Also mediates the ubiquitination of p53/TP53 in the late response to DNA damage, and acts as a positive regulator of p53/TP53 stability, thereby regulating the G1/S DNA damage checkpoint (PubMed:20173098). May act by catalyzing the formation of short polyubiquitin chains on p53/TP53 that are not targeted to the proteasome (PubMed:20173098). In response to ionizing radiation, interacts with MDM2 and enhances p53/TP53 ubiquitination, possibly by restricting MDM2 from extending polyubiquitin chains on ubiquitinated p53/TP53 (PubMed:20173098). Required to translesion DNA synthesis across DNA-protein cross-link adducts by catalyzing ubiquitination of proteins on single-stranded DNA (ssDNA) (PubMed:33321094)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}