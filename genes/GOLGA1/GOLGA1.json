dj":4.5662e-07},{"cell_type":"OPC","gene_symbol":"GOLGA1","gene_symbol_current":"GOLGA1","gene_id":"ENSG00000136935","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.108293,"nucleus_log2fc":-0.109704,"nucleus_score":-2.03509,"pct_ad":0.323442,"pct_control":0.337172,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0882099,"donor_lfcse":0.0788145,"donor_log2fc_shrunk":-1.4839e-05,"degas_log2fc":0.0527599,"degas_padj":0.302382},{"cell_type":"Oli","gene_symbol":"GOLGA1","gene_symbol_current":"GOLGA1","gene_id":"ENSG00000136935","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":5.59315e-36,"nucleus_log2fc":-0.284781,"nucleus_score":-12.6847,"pct_ad":0.23568,"pct_control":0.276751,"donor_test":"not significant","donor_padj":0.455843,"donor_log2fc":-0.201829,"donor_lfcse":0.0747344,"donor_log2fc_shrunk":-0.129514,"degas_log2fc":-0.103278,"degas_padj":1.02209e-05}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000136935","module":"turquoise","kme":0.122298,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000136935","module":"turquoise","kme":0.0441809,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000136935","module":"turquoise","kme":0.0561995,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136935","entrez_id":["2800"],"uniprot":["Q92805"],"ncbi_summary":"The Golgi apparatus, which participates in glycosylation and transport of proteins and lipids in the secretory pathway, consists of a series of stacked cisternae (flattened membrane sacs). Interactions between the Golgi and microtubules are thought to be important for the reorganization of the Golgi after it fragments during mitosis. This gene encodes one of the golgins, a family of proteins localized to the Golgi. This encoded protein is associated with Sjogren's syndrome. [provided by RefSeq, Feb 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92805","text":"Involved in vesicular trafficking at the Golgi apparatus level. Involved in endosome-to-Golgi trafficking. Mechanistically, captures transport vesicles arriving from endosomes via the protein TBC1D23 (PubMed:29084197, PubMed:38552021). Recognized vesicles are then tethered to the trans-Golgi before subsequent SNARE engagement and vesicle fusion. Selectively regulates E-cadherin transport from the trans-Golgi network in tubulovesicular carriers (PubMed:34969853). (Microbial infection) Plays an important role in poxvirus morphogenesis. Translocates into the viral factories where it may transport the membrane fragments and associated protein factors important for virus maturation to the sites of virion assembly."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}