"gene_id":"ENSG00000065150","module":"turquoise","kme":0.219486,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000065150","module":"turquoise","kme":0.108421,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000065150"],"dataset_symbols":["IPO5"],"explorer":"explorer.html?dataset=mathys2019#gene/IPO5","cell_types":[{"cell_type":"Ex","gene_symbol":"IPO5","gene_symbol_current":"IPO5","gene_id":"ENSG00000065150","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":6.24628e-08,"nucleus_log2fc":-0.161879,"nucleus_score":-5.75674,"pct_ad":0.40959,"pct_control":0.452943,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.109688,"donor_lfcse":0.0845169,"donor_log2fc_shrunk":-1.59464e-05},{"cell_type":"In","gene_symbol":"IPO5","gene_symbol_current":"IPO5","gene_id":"ENSG00000065150","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.817106,"nucleus_log2fc":0.0168385,"nucleus_score":0.633795,"pct_ad":0.228483,"pct_control":0.217242,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0538272,"donor_lfcse":0.119149,"donor_log2fc_shrunk":3.97228e-06},{"cell_type":"Oli","gene_symbol":"IPO5","gene_symbol_current":"IPO5","gene_id":"ENSG00000065150","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.842299,"donor_log2fc":0.142832,"donor_lfcse":0.136865,"donor_log2fc_shrunk":0.00738717}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000065150","module":"pink","kme":0.253733,"hub":false,"module_direction":"higher in AD","module_padj":1.0,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000065150","entrez_id":["3843"],"uniprot":["O00410"],"ncbi_summary":"Nucleocytoplasmic transport, a signal- and energy-dependent process, takes place through nuclear pore complexes embedded in the nuclear envelope. The import of proteins containing a nuclear localization signal (NLS) requires the NLS import receptor, a heterodimer of importin alpha and beta subunits also known as karyopherins. Importin alpha binds the NLS-containing cargo in the cytoplasm and importin beta docks the complex at the cytoplasmic side of the nuclear pore complex. In the presence of nucleoside triphosphates and the small GTP binding protein Ran, the complex moves into the nuclear pore complex and the importin subunits dissociate. Importin alpha enters the nucleoplasm with its passenger protein and importin beta remains at the pore. Interactions between importin beta and the FG repeats of nucleoporins are essential in translocation through the pore complex. The protein encoded by this gene is a member of the importin beta family. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00410","text":"Functions in nuclear protein import as nuclear transport receptor. Serves as receptor for nuclear localization signals (NLS) in cargo substrates. Is thought to mediate docking of the importin/substrate complex to the nuclear pore complex (NPC) through binding to nucleoporin and the complex is subsequently translocated through the pore by an energy requiring, Ran-dependent mechanism. At the nucleoplasmic side of the NPC, Ran binds to the importin, the importin/substrate complex dissociates and importin is re-exported from the nucleus to the cytoplasm where GTP hydrolysis releases Ran. The directionality of nuclear import is thought to be conferred by an asymmetric distribution of the GTP- and GDP-bound forms of Ran between the cytoplasm and nucleus (By similarity). Mediates the nuclear import of ribosomal proteins RPL23A, RPS7 and RPL5 (PubMed:11682607, PubMed:9687515). In vitro, mediates nuclear import of H2A, H2B, H3 and H4 histones. Binds to CPEB3 and mediates its nuclear import following neuronal stimulation (By similarity). In case of HIV-1 infection, binds and mediates the nuclear import of HIV-1 Rev."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}