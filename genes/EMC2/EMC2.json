or_log2fc_shrunk":-6.18854e-06},{"cell_type":"OPC","gene_symbol":"EMC2","gene_symbol_current":"EMC2","gene_id":"ENSG00000104412","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.471575,"nucleus_log2fc":-0.258554,"nucleus_score":-1.35338,"pct_ad":0.0973312,"pct_control":0.11341,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"EMC2","gene_symbol_current":"EMC2","gene_id":"ENSG00000104412","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.75812e-06,"nucleus_log2fc":0.327685,"nucleus_score":4.88842,"pct_ad":0.116316,"pct_control":0.0937268,"donor_test":"not significant","donor_padj":0.732555,"donor_log2fc":0.233125,"donor_lfcse":0.112816,"donor_log2fc_shrunk":0.0195022}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000104412","module":"blue","kme":0.127196,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000104412","module":"turquoise","kme":0.206067,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000104412","module":"purple","kme":0.167921,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000104412","module":"turquoise","kme":0.145572,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000104412","entrez_id":["9694"],"uniprot":["Q15006"],"ncbi_summary":"Contributes to membrane insertase activity. Involved in protein insertion into ER membrane by stop-transfer membrane-anchor sequence and tail-anchored membrane protein insertion into ER membrane. Located in endoplasmic reticulum membrane. Is extrinsic component of endoplasmic reticulum membrane. Part of EMC complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15006","text":"Part of the endoplasmic reticulum membrane protein complex (EMC) that enables the energy-independent insertion into endoplasmic reticulum membranes of newly synthesized membrane proteins (PubMed:29242231, PubMed:29809151, PubMed:30415835, PubMed:32439656, PubMed:32459176, PubMed:33964204). Preferentially accommodates proteins with transmembrane domains that are weakly hydrophobic or contain destabilizing features such as charged and aromatic residues (PubMed:29242231, PubMed:29809151, PubMed:30415835). Involved in the cotranslational insertion of multi-pass membrane proteins in which stop-transfer membrane-anchor sequences become ER membrane spanning helices (PubMed:29809151, PubMed:30415835). It is also required for the post-translational insertion of tail-anchored/TA proteins in endoplasmic reticulum membranes (PubMed:29242231, PubMed:29809151). By mediating the proper cotranslational insertion of N-terminal transmembrane domains in an N-exo topology, with translocated N-terminus in the lumen of the ER, controls the topology of multi-pass membrane proteins like the G protein-coupled receptors (PubMed:30415835). By regulating the insertion of various proteins in membranes, it is indirectly involved in many cellular processes (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}