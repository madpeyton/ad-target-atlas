_id":"ENSG00000153879","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.578746,"donor_log2fc":0.341704,"donor_lfcse":0.164509,"donor_log2fc_shrunk":0.0145185,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000153879","module":"magenta","kme":0.109177,"hub":false,"module_direction":"higher in AD","module_padj":0.456482,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000153879","module":"turquoise","kme":0.0248867,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000153879","entrez_id":["1054"],"uniprot":["P53567"],"ncbi_summary":"The C/EBP family of transcription factors regulates viral and cellular CCAAT/enhancer element-mediated transcription. C/EBP proteins contain the bZIP region, which is characterized by two motifs in the C-terminal half of the protein: a basic region involved in DNA binding and a leucine zipper motif involved in dimerization. The C/EBP family consist of several related proteins, C/EBP alpha, C/EBP beta, C/EBP gamma, and C/EBP delta, that form homodimers and that form heterodimers with each other. CCAAT/enhancer binding protein gamma may cooperate with Fos to bind PRE-I enhancer elements. Two transcript variants encoding the same protein have been found for this gene. [provided by RefSeq, Nov 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P53567","text":"Transcription factor that binds to the promoter and the enhancer regions of target genes. Binds to the enhancer element PRE-I (positive regulatory element-I) of the IL-4 gene (PubMed:7665092). Binds to the promoter and the enhancer of the immunoglobulin heavy chain. Binds to GPE1, a cis-acting element in the G-CSF gene promoter."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}