,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.580522,"donor_log2fc":0.309187,"donor_lfcse":0.19751,"donor_log2fc_shrunk":0.0175725,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"GRPEL2","gene_symbol_current":"GRPEL2","gene_id":"ENSG00000164284","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0774323,"donor_lfcse":0.1798,"donor_log2fc_shrunk":2.49568e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"GRPEL2","gene_symbol_current":"GRPEL2","gene_id":"ENSG00000164284","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.86925,"donor_log2fc":0.106937,"donor_lfcse":0.119455,"donor_log2fc_shrunk":0.00776446,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164284","entrez_id":["134266"],"uniprot":["Q8TAA5"],"ncbi_summary":"Predicted to enable adenyl-nucleotide exchange factor activity and unfolded protein binding activity. Predicted to be involved in protein import into mitochondrial matrix. Located in mitochondrion. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TAA5","text":"[Isoform 1]: Nucleotide exchange factor (NEF) for mitochondrial HSP70 (mt-HSP70/HSPA9), facilitating the release of ADP from HSPA9 to allow ATP rebinding, which is essential for the chaperone cycle (PubMed:28848044). Functions as a component of the presequence translocase-associated motor (PAM) complex, which drives ATP-dependent import of proteins into the mitochondrial matrix (PubMed:28848044). In the PAM complex, supports the HSPA9-driven pulling mechanism that translocates polypeptides through the TIM23 complex (PubMed:28848044). Functions as a redox-regulated component of the mitochondrial protein import and folding machinery, with its activity modulated by oxidative stress (PubMed:30098457). May control the nucleotide-dependent binding of HSPA9 to substrate proteins (By similarity). [Isoform 2]: NERCLIN functions as a negative regulator of cardiolipin homeostasis and mitochondrial ultrastructure, contributing to the stress-induced adaptation of mitochondrial dynamics. Responds to heat stress by ensuring OPA1 processing and cell survival (PubMed:37463214). Lacks nucleotide exchange factor (NEF) activity (PubMed:37463214). This isoform is specifically expressed in human and some non-human primates (PubMed:37463214)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}