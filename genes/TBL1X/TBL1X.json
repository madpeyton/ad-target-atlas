c":0.00685302,"nucleus_score":0.313324,"pct_ad":0.368029,"pct_control":0.364776,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0160907,"donor_lfcse":0.112222,"donor_log2fc_shrunk":-1.28733e-06},{"cell_type":"Oli","gene_symbol":"TBL1X","gene_symbol_current":"TBL1X","gene_id":"ENSG00000101849","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.289851,"nucleus_log2fc":0.0263602,"nucleus_score":1.15888,"pct_ad":0.434848,"pct_control":0.432674,"donor_test":"not significant","donor_padj":0.865534,"donor_log2fc":0.0972658,"donor_lfcse":0.102298,"donor_log2fc_shrunk":0.010186}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000101849","module":"purple","kme":0.251962,"hub":false,"module_direction":"lower in AD","module_padj":0.900878,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000101849","module":"yellow","kme":0.313583,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000101849","module":"blue","kme":0.346766,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000101849","module":"turquoise","kme":0.042295,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000101849","module":"brown","kme":0.18692,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000101849","module":"blue","kme":0.207385,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101849","entrez_id":["6907"],"uniprot":["O60907"],"ncbi_summary":"The protein encoded by this gene has sequence similarity with members of the WD40 repeat-containing protein family. The WD40 group is a large family of proteins, which appear to have a regulatory function. It is believed that the WD40 repeats mediate protein-protein interactions and members of the family are involved in signal transduction, RNA processing, gene regulation, vesicular trafficking, cytoskeletal assembly and may play a role in the control of cytotypic differentiation. This encoded protein is found as a subunit in corepressor SMRT (silencing mediator for retinoid and thyroid receptors) complex along with histone deacetylase 3 protein. This gene is located adjacent to the ocular albinism gene and it is thought to be involved in the pathogenesis of the ocular albinism with late-onset sensorineural deafness phenotype. Four transcript variants encoding two different isoforms have been found for this gene. This gene is highly similar to the Y chromosome TBL1Y gene. [provided by RefSeq, Nov 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60907","text":"F-box-like protein involved in the recruitment of the ubiquitin/19S proteasome complex to nuclear receptor-regulated transcription units (PubMed:14980219). Plays an essential role in transcription activation mediated by nuclear receptors. Probably acts as integral component of corepressor complexes that mediates the recruitment of the 19S proteasome complex, leading to the subsequent proteasomal degradation of transcription repressor complexes, thereby allowing cofactor exchange (PubMed:21240272)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}