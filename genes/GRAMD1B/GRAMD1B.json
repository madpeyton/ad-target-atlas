 significant","donor_padj":0.999889,"donor_log2fc":-0.00214969,"donor_lfcse":0.0864647,"donor_log2fc_shrunk":2.44344e-05},{"cell_type":"Mic","gene_symbol":"GRAMD1B","gene_symbol_current":"GRAMD1B","gene_id":"ENSG00000023171","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.742462,"nucleus_log2fc":0.192956,"nucleus_score":0.743608,"pct_ad":0.102091,"pct_control":0.0911361,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"GRAMD1B","gene_symbol_current":"GRAMD1B","gene_id":"ENSG00000023171","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.63724,"nucleus_log2fc":-0.161074,"nucleus_score":-0.954069,"pct_ad":0.157771,"pct_control":0.171648,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":-0.136262,"donor_lfcse":0.178458,"donor_log2fc_shrunk":-0.000880313}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000023171","module":"yellow","kme":0.173169,"hub":false,"module_direction":"lower in AD","module_padj":0.56571,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000023171","module":"green","kme":0.15687,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000023171","entrez_id":["57476"],"uniprot":["Q3KR37"],"ncbi_summary":"Predicted to enable cholesterol binding activity; cholesterol transfer activity; and phospholipid binding activity. Predicted to be involved in cellular response to cholesterol and cholesterol homeostasis. Located in endoplasmic reticulum membrane; endoplasmic reticulum-plasma membrane contact site; and plasma membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q3KR37","text":"Cholesterol transporter that mediates non-vesicular transport of cholesterol from the plasma membrane (PM) to the endoplasmic reticulum (ER) (By similarity). Contains unique domains for binding cholesterol and the PM, thereby serving as a molecular bridge for the transfer of cholesterol from the PM to the ER (By similarity). Plays a crucial role in cholesterol homeostasis in the adrenal gland and has the unique ability to localize to the PM based on the level of membrane cholesterol (By similarity). In lipid-poor conditions localizes to the ER membrane and in response to excess cholesterol in the PM is recruited to the endoplasmic reticulum-plasma membrane contact sites (EPCS) which is mediated by the GRAM domain (By similarity). At the EPCS, the sterol-binding VASt/ASTER domain binds to the cholesterol in the PM and facilitates its transport from the PM to ER (By similarity). Also mediates cholesterol transfer from lysosomes to endoplasmic reticulum through interaction with NPC1 (PubMed:31537798)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}