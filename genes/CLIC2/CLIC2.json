on":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000155962"],"dataset_symbols":["CLIC2"],"explorer":"explorer.html?dataset=mathys2019#gene/CLIC2","cell_types":[{"cell_type":"Ex","gene_symbol":"CLIC2","gene_symbol_current":"CLIC2","gene_id":"ENSG00000155962","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":-0.0638021,"donor_lfcse":0.131312,"donor_log2fc_shrunk":-3.77477e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000155962","entrez_id":["1193"],"uniprot":["O15247"],"ncbi_summary":"This gene encodes a chloride intracellular channel protein. Chloride channels are a diverse group of proteins that regulate fundamental cellular processes including stabilization of cell membrane potential, transepithelial transport, maintenance of intracellular pH, and regulation of cell volume. This protein plays a role in inhibiting the function of ryanodine receptor 2. A mutation in this gene is the cause of an X-linked form of cognitive disability. [provided by RefSeq, Jul 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O15247","text":"In the soluble state, catalyzes glutaredoxin-like thiol disulfide exchange reactions with reduced glutathione as electron donor. Displays weak glutathione peroxidase activity (Probable) (PubMed:25581026). Can insert into membranes and form chloride ion channels. Membrane insertion seems to be redox-regulated and may occur only under oxidizing conditions. Modulates the activity of RYR2 and inhibits calcium influx."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],