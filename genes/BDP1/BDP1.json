g_target":false}},"description":[{"gene_id":"ENSG00000145734","entrez_id":["55814"],"uniprot":["A6H8Y1"],"ncbi_summary":"The product of this gene is a subunit of the TFIIIB transcription initiation complex, which recruits RNA polymerase III to target promoters in order to initiate transcription. The encoded protein localizes to concentrated aggregates in the nucleus, and is required for transcription from all three types of polymerase III promoters. It is phosphorylated by casein kinase II during mitosis, resulting in its release from chromatin and suppression of polymerase III transcription. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"A6H8Y1","text":"General activator of RNA polymerase III transcription. Requires for transcription from all three types of polymerase III promoters. Requires for transcription of genes with internal promoter elements and with promoter elements upstream of the initiation site."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}