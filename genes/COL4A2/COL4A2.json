null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.947683,"donor_log2fc":-0.0824529,"donor_lfcse":0.19061,"donor_log2fc_shrunk":-0.00246328}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000134871","module":"brown","kme":0.229931,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000134871","module":"magenta","kme":0.345528,"hub":false,"module_direction":"lower in AD","module_padj":0.209344,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000134871","module":"red","kme":0.601109,"hub":true,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000134871","entrez_id":["1284"],"uniprot":["P08572"],"ncbi_summary":"This gene encodes one of the six subunits of type IV collagen, the major structural component of basement membranes. The C-terminal portion of the protein, known as canstatin, is an inhibitor of angiogenesis and tumor growth. Like the other members of the type IV collagen gene family, this gene is organized in a head-to-head conformation with another type IV collagen gene so that each gene pair shares a common promoter. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P08572","text":"Type IV collagen is the major structural component of glomerular basement membranes (GBM), forming a 'chicken-wire' meshwork together with laminins, proteoglycans and entactin/nidogen. Canstatin, a cleavage product corresponding to the collagen alpha 2(IV) NC1 domain, possesses both anti-angiogenic and anti-tumor cell activity. It inhibits proliferation and migration of endothelial cells, reduces mitochondrial membrane potential, and induces apoptosis. Specifically induces Fas-dependent apoptosis and activates procaspase-8 and -9 activity. Ligand for alphavbeta3 and alphavbeta5 integrins."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}