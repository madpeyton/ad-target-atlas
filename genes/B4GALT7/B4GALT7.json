g2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.869369,"donor_log2fc":0.0954754,"donor_lfcse":0.145241,"donor_log2fc_shrunk":0.00876156},{"cell_type":"OPC","gene_symbol":"B4GALT7","gene_symbol_current":"B4GALT7","gene_id":"ENSG00000027847","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0427736,"donor_lfcse":0.211238,"donor_log2fc_shrunk":-1.00177e-06},{"cell_type":"Oli","gene_symbol":"B4GALT7","gene_symbol_current":"B4GALT7","gene_id":"ENSG00000027847","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.919976,"donor_log2fc":-0.10653,"donor_lfcse":0.164189,"donor_log2fc_shrunk":-0.00431406}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000027847","module":"turquoise","kme":0.125133,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000027847","module":"turquoise","kme":0.0788277,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000027847","entrez_id":["11285"],"uniprot":["Q9UBV7"],"ncbi_summary":"This gene is a member of the beta-1,4-galactosyltransferase (beta4GalT) family. Family members encode type II membrane-bound glycoproteins that appear to have exclusive specificity for the donor substrate UDP-galactose. Each beta4GalT member has a distinct function in the biosynthesis of different glycoconjugates and saccharide structures. As type II membrane proteins, they have an N-terminal hydrophobic signal sequence that directs the protein to the Golgi apparatus which then remains uncleaved to function as a transmembrane anchor. The enzyme encoded by this gene attaches the first galactose in the common carbohydrate-protein linkage (GlcA-beta1,3-Gal-beta1,3-Gal-beta1,4-Xyl-beta1-O-Ser) found in proteoglycans. This enzyme differs from other beta4GalTs because it lacks the conserved Cys residues found in beta4GalT1-beta4GalT6 and it is located in cis-Golgi instead of trans-Golgi. Mutations in this gene have been associated with the progeroid form of Ehlers-Danlos syndrome. [provided by RefSeq, Oct 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UBV7","text":"Required for the biosynthesis of the tetrasaccharide linkage region of proteoglycans, especially for small proteoglycans in skin fibroblasts."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}