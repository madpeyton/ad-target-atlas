e,"nucleus_direction":"higher in AD","nucleus_padj":0.0898943,"nucleus_log2fc":0.0458634,"nucleus_score":1.9488,"pct_ad":0.702786,"pct_control":0.671429,"donor_test":"not significant","donor_padj":0.928757,"donor_log2fc":-0.129862,"donor_lfcse":0.294142,"donor_log2fc_shrunk":-0.00313285},{"cell_type":"Oli","gene_symbol":"SLC11A1","gene_symbol_current":"SLC11A1","gene_id":"ENSG00000018280","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.949622,"donor_log2fc":-0.0975292,"donor_lfcse":0.234699,"donor_log2fc_shrunk":-0.0019859}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000018280","module":"blue","kme":0.272812,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000018280","entrez_id":["6556"],"uniprot":["P49279"],"ncbi_summary":"This gene is a member of the solute carrier family 11 (proton-coupled divalent metal ion transporters) family and encodes a multi-pass membrane protein. The protein functions as a divalent transition metal (iron and manganese) transporter involved in iron metabolism and host resistance to certain pathogens. Mutations in this gene have been associated with susceptibility to infectious diseases such as tuberculosis and leprosy, and inflammatory diseases such as rheumatoid arthritis and Crohn disease. Alternatively spliced variants that encode different protein isoforms have been described but the full-length nature of only one has been determined. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49279","text":"Antiporter that transports metal ions against a proton gradient, and which promotes host resistance to infection against intracellular parasites, such as M.bovis, S.typhimurium and L.donovani (PubMed:11237855, PubMed:16103355, PubMed:16395392, PubMed:39824808). Plays a key role in pathogen resistance in macrophages by mediating the export of metal ions from the phagosomal compartment, thereby limiting the nutrients available to intracellular pathogens and restricting their growth (By similarity). Also promotes antimicrobial activity in neutrophils against pathogens that survive within phagocytic cells (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}