0.972354,"donor_log2fc":-0.0249676,"donor_lfcse":0.193734,"donor_log2fc_shrunk":-0.000594891,"degas_log2fc":-0.138373,"degas_padj":7.77776e-20},{"cell_type":"In","gene_symbol":"ABO","gene_symbol_current":"ABO","gene_id":"ENSG00000175164","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.978535,"donor_log2fc":0.0236511,"donor_lfcse":0.194533,"donor_log2fc_shrunk":0.000370433,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000175164","entrez_id":["28"],"uniprot":["P16442"],"ncbi_summary":"This gene encodes proteins related to the first discovered blood group system, ABO. Variation in the ABO gene (chromosome 9q34.2) is the basis of the ABO blood group, thus the presence of an allele determines the blood group in an individual. The 'O' blood group is caused by a deletion of guanine-258 near the N-terminus of the protein which results in a frameshift and translation of an almost entirely different protein. Individuals with the A, B, and AB alleles express glycosyltransferase activities that convert the H antigen into the A or B antigen. Other minor alleles have been found for this gene. [provided by RefSeq, Apr 2022].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P16442","text":"This protein is the basis of the ABO blood group system. The histo-blood group ABO involves three carbohydrate antigens: A, B, and H. A, B, and AB individuals express a glycosyltransferase activity that converts the H antigen to the A antigen (by addition of N-acetyl-alpha-D-galactosamine (GalNAc)) or to the B antigen (by addition of galactose (Gal)), whereas O individuals lack such activity and express the H antigen precursor unmodified. Catalyzes the transfer of GalNAc or Gal in an alpha1,3 linkage to the terminal Gal of all five types of naturally occurring H antigens, forming the antigenic structures of the A and B blood groups."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}