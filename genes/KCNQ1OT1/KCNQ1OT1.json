0.999342,"donor_log2fc":-0.0906417,"donor_lfcse":0.118874,"donor_log2fc_shrunk":-6.57608e-06,"degas_log2fc":-0.114392,"degas_padj":0.000145457},{"cell_type":"Oli","gene_symbol":"KCNQ1OT1","gene_symbol_current":"KCNQ1OT1","gene_id":"ENSG00000269821","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.00569e-08,"nucleus_log2fc":0.0877059,"nucleus_score":5.88759,"pct_ad":0.609203,"pct_control":0.600315,"donor_test":"not significant","donor_padj":0.9558,"donor_log2fc":0.0430508,"donor_lfcse":0.110353,"donor_log2fc_shrunk":0.00781392,"degas_log2fc":-0.250883,"degas_padj":4.51262e-62}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000269821","module":"yellow","kme":0.317413,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000269821","module":"brown","kme":0.464377,"hub":false,"module_direction":"higher in AD","module_padj":0.939268,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000269821","module":"blue","kme":0.286278,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000269821","entrez_id":["10984"],"uniprot":[],"ncbi_summary":"Human chromosomal region 11p15.5 contains two clusters of epigenetically-regulated genes that are expressed from only one chromosome in a parent-of-origin manner. Each cluster, or imprinted domain, is regulated by a functionally independent imprinting control region (ICR). The human CDKN1C/KCNQ1OT1 domain is regulated by an ICR located in an intron of KCNQ1, and contains at least eight genes that are expressed exclusively or preferentially from the maternally-inherited allele. The DNA of the ICR is specifically methylated on the maternally-inherited chromosome, and unmethylated on the paternally-inherited chromosome. The ICR contains the promoter of the KCNQ1OT1 gene that is exclusively expressed from the paternal allele. The KCNQ1OT1 transcript is the antisense to the KCNQ1 gene and is a unspliced long non-coding RNA. It interacts with chromatin and regulates transcription of multiple target genes through epigenetic modifications. The transcript is abnormally expressed from both chromosomes in most patients with Beckwith-Wiedemann syndrome, and the transcript also plays an important role in colorectal carcinogenesis. [provided by RefSeq, Apr 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}