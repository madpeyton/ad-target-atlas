type":"Ex","gene_id":"ENSG00000114554","module":"blue","kme":0.10996,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000114554","entrez_id":["5361"],"uniprot":["Q9UIW2"],"ncbi_summary":"Predicted to enable semaphorin receptor activity. Predicted to be involved in several processes, including generation of neurons; regulation of GTPase activity; and regulation of cell shape. Predicted to act upstream of or within dichotomous subdivision of terminal units involved in salivary gland branching; neuron projection morphogenesis; and regulation of smooth muscle cell migration. Located in cytosol and nucleoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UIW2","text":"Coreceptor for SEMA3A, SEMA3C, SEMA3F and SEMA6D. Necessary for signaling by class 3 semaphorins and subsequent remodeling of the cytoskeleton. Plays a role in axon guidance, invasive growth and cell migration. Class 3 semaphorins bind to a complex composed of a neuropilin and a plexin. The plexin modulates the affinity of the complex for specific semaphorins, and its cytoplasmic domain is required for the activation of down-stream signaling events in the cytoplasm. Acts as coreceptor of TREM2 for SEMA6D in dendritic cells and is involved in the generation of immune responses and skeletal homeostasis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}