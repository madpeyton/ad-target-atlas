1},{"cell_type":"OPC","gene_symbol":"YWHAZ","gene_symbol_current":"YWHAZ","gene_id":"ENSG00000164924","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.351309,"nucleus_log2fc":-0.0555895,"nucleus_score":-1.26106,"pct_ad":0.42708,"pct_control":0.435902,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0199327,"donor_lfcse":0.0768006,"donor_log2fc_shrunk":-3.50063e-06},{"cell_type":"Oli","gene_symbol":"YWHAZ","gene_symbol_current":"YWHAZ","gene_id":"ENSG00000164924","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00218987,"nucleus_log2fc":0.06033,"nucleus_score":3.204,"pct_ad":0.479765,"pct_control":0.474542,"donor_test":"not significant","donor_padj":0.744281,"donor_log2fc":0.0997709,"donor_lfcse":0.0690587,"donor_log2fc_shrunk":0.0210679}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000164924","module":"blue","kme":0.0671922,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000164924","module":"red","kme":0.367372,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000164924","module":"blue","kme":0.121391,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000164924","module":"turquoise","kme":0.0375285,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164924","entrez_id":["7534"],"uniprot":["P63104"],"ncbi_summary":"This gene product belongs to the 14-3-3 family of proteins which mediate signal transduction by binding to phosphoserine-containing proteins. This highly conserved protein family is found in both plants and mammals, and this protein is 99% identical to the mouse, rat and sheep orthologs. The encoded protein interacts with IRS1 protein, suggesting a role in regulating insulin sensitivity. Several transcript variants that differ in the 5' UTR but that encode the same protein have been identified for this gene. [provided by RefSeq, Oct 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P63104","text":"Adapter protein implicated in the regulation of a large spectrum of both general and specialized signaling pathways (PubMed:14578935, PubMed:15071501, PubMed:15644438, PubMed:16376338, PubMed:16959763, PubMed:31024343, PubMed:9360956). Binds to a large number of partners, usually by recognition of a phosphoserine or phosphothreonine motif (PubMed:35662396). Binding generally results in the modulation of the activity of the binding partner (PubMed:35662396). Promotes cytosolic retention and inactivation of TFEB transcription factor by binding to phosphorylated TFEB (PubMed:35662396). Induces ARHGEF7 activity on RAC1 as well as lamellipodia and membrane ruffle formation (PubMed:16959763). In neurons, regulates spine maturation through the modulation of ARHGEF7 activity (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}