s_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0011845,"nucleus_log2fc":0.347865,"nucleus_score":3.74968,"pct_ad":0.115866,"pct_control":0.0956816,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.294639,"donor_lfcse":0.135366,"donor_log2fc_shrunk":1.6689e-05,"degas_log2fc":0.116494,"degas_padj":0.211665},{"cell_type":"Oli","gene_symbol":"TMEM120A","gene_symbol_current":"TMEM120A","gene_id":"ENSG00000189077","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.698967,"donor_log2fc":0.184595,"donor_lfcse":0.114378,"donor_log2fc_shrunk":0.0158487,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000189077","module":"red","kme":0.101772,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000189077","module":"turquoise","kme":0.0486686,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000189077","entrez_id":["83862"],"uniprot":["Q9BXJ8"],"ncbi_summary":"Predicted to enable ion channel activity. Involved in fat cell differentiation; protein heterooligomerization; and protein homooligomerization. Predicted to be located in plasma membrane. Predicted to be active in membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BXJ8","text":"Multifunctional protein involved in mechanosensation, and plays an essential role in lipid metabolism and adipocyte differentiation (PubMed:26024229, PubMed:36420836). May function as a potential ion channel involved in sensing mechanical stimuli (PubMed:35235791). Mediates the mechanosensitivity of the PKD2-TMEM120A channel complex through direct physical interaction (PubMed:36420836). TMEM120A seems to affect mechanosensation by inhibiting PIEZO2 channels, possibly by altering cellular lipid content (By similarity). TMEM120A is structurally similar to a lipid-modifying enzyme, ELOVL7, and contains a bound coenzyme A molecule, which suggests it might function as an enzyme in lipid metabolism (PubMed:34374645, PubMed:34409941, PubMed:34465718). Additionally, implicated in innate immune response against Zika virus. Acts as a key activator of the antiviral signaling involving STING1 (PubMed:35013224)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}