ted":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.591748,"nucleus_log2fc":0.0202021,"nucleus_score":0.774224,"pct_ad":0.656874,"pct_control":0.645893,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0337179,"donor_lfcse":0.0868146,"donor_log2fc_shrunk":4.62736e-06,"degas_log2fc":-0.332493,"degas_padj":2.45803e-26},{"cell_type":"Oli","gene_symbol":"STAT5B","gene_symbol_current":"STAT5B","gene_id":"ENSG00000173757","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000722576,"nucleus_log2fc":0.0769358,"nucleus_score":3.52535,"pct_ad":0.410757,"pct_control":0.401961,"donor_test":"not significant","donor_padj":0.893692,"donor_log2fc":0.0698066,"donor_lfcse":0.0895574,"donor_log2fc_shrunk":0.00874403,"degas_log2fc":-0.169711,"degas_padj":3.67197e-20}],"modules":[{"cell_type":"In","gene_id":"ENSG00000173757","module":"pink","kme":0.177011,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000173757","module":"blue","kme":0.148347,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000173757","entrez_id":["6777"],"uniprot":["P51692"],"ncbi_summary":"The protein encoded by this gene is a member of the STAT family of transcription factors. In response to cytokines and growth factors, STAT family members are phosphorylated by the receptor associated kinases, and then form homo- or heterodimers that translocate to the cell nucleus where they act as transcription activators. This protein mediates the signal transduction triggered by various cell ligands, such as IL2, IL4, CSF1, and different growth hormones. It has been shown to be involved in diverse biological processes, such as TCR signaling, apoptosis, adult mammary gland development, and sexual dimorphism of liver gene expression. This gene was found to fuse to retinoic acid receptor-alpha (RARA) gene in a small subset of acute promyelocytic leukemias (APLL). The dysregulation of the signaling pathways mediated by this protein may be the cause of the APLL. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P51692","text":"Signal transducer and transcription activator that mediates cellular responses to cytokines, hormones and growth factors (PubMed:29844444, PubMed:9188471). Binds to the GAS element and activates PRL-induced transcription. Positively regulates hematopoietic/erythroid differentiation. Involved in the oncostatin-M-mediated signaling pathway through type II OSM receptor complex (heterodimers composed of OSMR and IL6ST) (PubMed:9188471)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}