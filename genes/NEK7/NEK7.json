c_shrunk":-6.3605e-06},{"cell_type":"Mic","gene_symbol":"NEK7","gene_symbol_current":"NEK7","gene_id":"ENSG00000151414","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.970084,"nucleus_log2fc":-0.0730788,"nucleus_score":-0.0945844,"pct_ad":0.100861,"pct_control":0.101124,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"NEK7","gene_symbol_current":"NEK7","gene_id":"ENSG00000151414","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.936434,"nucleus_log2fc":0.0430057,"nucleus_score":0.204382,"pct_ad":0.212716,"pct_control":0.209962,"donor_test":"not significant","donor_padj":0.986209,"donor_log2fc":0.0894788,"donor_lfcse":0.146252,"donor_log2fc_shrunk":0.000850267},{"cell_type":"Oli","gene_symbol":"NEK7","gene_symbol_current":"NEK7","gene_id":"ENSG00000151414","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00318583,"nucleus_log2fc":0.202456,"nucleus_score":3.31359,"pct_ad":0.129828,"pct_control":0.113045,"donor_test":"not significant","donor_padj":0.788457,"donor_log2fc":0.120365,"donor_lfcse":0.0921399,"donor_log2fc_shrunk":0.0135309}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000151414","module":"blue","kme":0.151439,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000151414","module":"red","kme":0.142418,"hub":false,"module_direction":"lower in AD","module_padj":0.737188,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000151414","entrez_id":["140609"],"uniprot":["Q8TDX7"],"ncbi_summary":"NIMA-related kinases share high amino acid sequence identity with the gene product of the Aspergillus nidulans 'never in mitosis A' gene, which controls initiation of mitosis.[supplied by OMIM, Jul 2002].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TDX7","text":"Protein kinase which plays an important role in mitotic cell cycle progression (PubMed:17101132, PubMed:19941817, PubMed:31409757). Required for microtubule nucleation activity of the centrosome, robust mitotic spindle formation and cytokinesis (PubMed:17586473, PubMed:19414596, PubMed:19941817, PubMed:26522158, PubMed:31409757). Phosphorylates EML4 at 'Ser-146', promoting its dissociation from microtubules during mitosis which is required for efficient chromosome congression (PubMed:31409757). Phosphorylates RPS6KB1 (By similarity). Acts as an essential activator of the NLRP3 inflammasome assembly independently of its kinase activity (PubMed:26642356, PubMed:36442502, PubMed:39173637). Acts by unlocking NLRP3 following NLRP3 tranlocation into the microtubule organizing center (MTOC), relieving NLRP3 autoinhibition and promoting formation of the NLRP3:PYCARD complex, and activation of CASP1 (PubMed:26642356, PubMed:31189953, PubMed:36442502, PubMed:39173637, PubMed:40450990). Serves as a cellular switch that enforces mutual exclusivity of the inflammasome response and cell division: interaction with NEK9 prevents interaction with NLRP3 and activation of the inflammasome during mitosis (PubMed:26642356, PubMed:31189953)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}