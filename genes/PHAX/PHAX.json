ificant","donor_padj":0.999342,"donor_log2fc":0.0890244,"donor_lfcse":0.0899051,"donor_log2fc_shrunk":-6.23294e-06,"degas_log2fc":-0.10638,"degas_padj":0.199358},{"cell_type":"Oli","gene_symbol":"PHAX","gene_symbol_current":"PHAX","gene_id":"ENSG00000164902","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":8.27677e-05,"nucleus_log2fc":0.157249,"nucleus_score":4.0862,"pct_ad":0.118317,"pct_control":0.108829,"donor_test":"not significant","donor_padj":0.519906,"donor_log2fc":0.178592,"donor_lfcse":0.0757487,"donor_log2fc_shrunk":0.0619318,"degas_log2fc":-0.118426,"degas_padj":0.000880346}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000164902","module":"brown","kme":0.25246,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000164902","module":"turquoise","kme":0.0472874,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000164902","module":"turquoise","kme":0.05041,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164902","entrez_id":["51808"],"uniprot":["Q9H814"],"ncbi_summary":"Enables mRNA cap binding complex binding activity. Involved in RNA stabilization. Located in centrosome and nucleoplasm. Part of ribonucleoprotein complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H814","text":"A phosphoprotein adapter involved in the XPO1-mediated U snRNA export from the nucleus (PubMed:39011894). Bridge components required for U snRNA export, the cap binding complex (CBC)-bound snRNA on the one hand and the GTPase Ran in its active GTP-bound form together with the export receptor XPO1 on the other. Its phosphorylation in the nucleus is required for U snRNA export complex assembly and export, while its dephosphorylation in the cytoplasm causes export complex disassembly. It is recycled back to the nucleus via the importin alpha/beta heterodimeric import receptor. The directionality of nuclear export is thought to be conferred by an asymmetric distribution of the GTP- and GDP-bound forms of Ran between the cytoplasm and nucleus. Its compartmentalized phosphorylation cycle may also contribute to the directionality of export. Binds strongly to m7G-capped U1 and U5 small nuclear RNAs (snRNAs) in a sequence-unspecific manner and phosphorylation-independent manner (By similarity). Also plays a role in the biogenesis of U3 small nucleolar RNA (snoRNA). Involved in the U3 snoRNA transport from nucleoplasm to Cajal bodies. Binds strongly to m7G-capped U3, U8 and U13 precursor snoRNAs and weakly to trimethylated (TMG)-capped U3, U8 and U13 snoRNAs. Also binds to telomerase RNA."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}