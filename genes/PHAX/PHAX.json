t significant","donor_padj":0.999889,"donor_log2fc":0.0262004,"donor_lfcse":0.180335,"donor_log2fc_shrunk":8.57879e-07},{"cell_type":"Oli","gene_symbol":"PHAX","gene_symbol_current":"PHAX","gene_id":"ENSG00000164902","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.989752,"donor_log2fc":-0.0132755,"donor_lfcse":0.168546,"donor_log2fc_shrunk":-0.00043925}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000164902","module":"turquoise","kme":0.274496,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000164902","module":"turquoise","kme":0.253304,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000164902","module":"turquoise","kme":0.0761541,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164902","entrez_id":["51808"],"uniprot":["Q9H814"],"ncbi_summary":"Enables mRNA cap binding complex binding activity. Involved in RNA stabilization. Located in centrosome and nucleoplasm. Part of ribonucleoprotein complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H814","text":"A phosphoprotein adapter involved in the XPO1-mediated U snRNA export from the nucleus (PubMed:39011894). Bridge components required for U snRNA export, the cap binding complex (CBC)-bound snRNA on the one hand and the GTPase Ran in its active GTP-bound form together with the export receptor XPO1 on the other. Its phosphorylation in the nucleus is required for U snRNA export complex assembly and export, while its dephosphorylation in the cytoplasm causes export complex disassembly. It is recycled back to the nucleus via the importin alpha/beta heterodimeric import receptor. The directionality of nuclear export is thought to be conferred by an asymmetric distribution of the GTP- and GDP-bound forms of Ran between the cytoplasm and nucleus. Its compartmentalized phosphorylation cycle may also contribute to the directionality of export. Binds strongly to m7G-capped U1 and U5 small nuclear RNAs (snRNAs) in a sequence-unspecific manner and phosphorylation-independent manner (By similarity). Also plays a role in the biogenesis of U3 small nucleolar RNA (snoRNA). Involved in the U3 snoRNA transport from nucleoplasm to Cajal bodies. Binds strongly to m7G-capped U3, U8 and U13 precursor snoRNAs and weakly to trimethylated (TMG)-capped U3, U8 and U13 snoRNAs. Also binds to telomerase RNA."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}