r_padj":0.993604,"donor_log2fc":-0.056157,"donor_lfcse":0.146154,"donor_log2fc_shrunk":-0.000558525},{"cell_type":"Oli","gene_symbol":"URI1","gene_symbol_current":"URI1","gene_id":"ENSG00000105176","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000274814,"nucleus_log2fc":0.24986,"nucleus_score":4.03181,"pct_ad":0.125099,"pct_control":0.105509,"donor_test":"not significant","donor_padj":0.868589,"donor_log2fc":0.089214,"donor_lfcse":0.0966929,"donor_log2fc_shrunk":0.00887697}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000105176","module":"blue","kme":0.131372,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000105176","module":"green","kme":0.164105,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000105176","entrez_id":["8725"],"uniprot":["O94763"],"ncbi_summary":"This gene encodes member of the prefoldin family of molecular chaperones. The encoded protein functions as a scaffolding protein and plays roles in ubiquitination and transcription, in part though interactions with the RNA polymerase II subunit RPB5. This gene may play a role in multiple malignancies including ovarian cancer and hepatocellular carcinoma. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene, and a pseudogene of this gene is located on the long arm of chromosome 22. [provided by RefSeq, Nov 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O94763","text":"Involved in gene transcription regulation. Acts as a transcriptional repressor in concert with the corepressor UXT to regulate androgen receptor (AR) transcription. May act as a tumor suppressor to repress AR-mediated gene transcription and to inhibit anchorage-independent growth in prostate cancer cells. Required for cell survival in ovarian cancer cells. Together with UXT, associates with chromatin to the NKX3-1 promoter region. Antagonizes transcriptional modulation via hepatitis B virus X protein. Plays a central role in maintaining S6K1 signaling and BAD phosphorylation under normal growth conditions thereby protecting cells from potential deleterious effects of sustained S6K1 signaling. The URI1-PPP1CC complex acts as a central component of a negative feedback mechanism that counteracts excessive S6K1 survival signaling to BAD in response to growth factors. Mediates inhibition of PPP1CC phosphatase activity in mitochondria. Coordinates the regulation of nutrient-sensitive gene expression availability in a mTOR-dependent manner. Seems to be a scaffolding protein able to assemble a prefoldin-like complex that contains PFDs and proteins with roles in transcription and ubiquitination."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}