 by RefSeq, Mar 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}