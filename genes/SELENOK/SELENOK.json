{"cell_type":"Oli","gene_symbol":"SELENOK","gene_symbol_current":"SELENOK","gene_id":"ENSG00000113811","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":4.85371e-09,"nucleus_log2fc":0.237734,"nucleus_score":6.01036,"pct_ad":0.11459,"pct_control":0.100933,"donor_test":"not significant","donor_padj":0.741071,"donor_log2fc":0.262198,"donor_lfcse":0.180858,"donor_log2fc_shrunk":0.00902656}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000113811","module":"turquoise","kme":0.191173,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000113811","module":"brown","kme":0.341801,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000113811","module":"brown","kme":0.338626,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000113811","module":"turquoise","kme":0.248307,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000113811","module":"turquoise","kme":0.196049,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000113811","entrez_id":["58515"],"uniprot":["Q9Y6D0"],"ncbi_summary":"The protein encoded by this gene belongs to the selenoprotein K family. It is a transmembrane protein that is localized in the endoplasmic reticulum (ER), and is involved in ER-associated degradation (ERAD) of misfolded, glycosylated proteins. It also has a role in the protection of cells from ER stress-induced apoptosis. Knockout studies in mice show the importance of this gene in promoting Ca(2+) flux in immune cells and mounting effective immune response. This protein is a selenoprotein, containing the rare amino acid selenocysteine (Sec). Sec is encoded by the UGA codon, which normally signals translation termination. The 3' UTRs of selenoprotein mRNAs contain a conserved stem-loop structure, designated the Sec insertion sequence (SECIS) element, that is necessary for the recognition of UGA as a Sec codon, rather than as a stop signal. Pseudogenes of this locus have been identified on chromosomes 6 and 19.[provided by RefSeq, Aug 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y6D0","text":"Required for Ca(2+) flux in immune cells and plays a role in T-cell proliferation and in T-cell and neutrophil migration (By similarity). Involved in endoplasmic reticulum-associated degradation (ERAD) of soluble glycosylated proteins (PubMed:22016385). Required for palmitoylation and cell surface expression of CD36 and involved in macrophage uptake of low-density lipoprotein and in foam cell formation (By similarity). Together with ZDHHC6, required for palmitoylation of ITPR1 in immune cells, leading to regulate ITPR1 stability and function (PubMed:25368151). Plays a role in protection of cells from ER stress-induced apoptosis (PubMed:20692228). Protects cells from oxidative stress when overexpressed in cardiomyocytes (PubMed:16962588)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}