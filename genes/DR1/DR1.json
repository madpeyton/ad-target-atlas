id":"ENSG00000117505","module":"turquoise","kme":0.178898,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000117505"],"dataset_symbols":["DR1"],"explorer":"explorer.html?dataset=mathys2019#gene/DR1","cell_types":[{"cell_type":"Ex","gene_symbol":"DR1","gene_symbol_current":"DR1","gene_id":"ENSG00000117505","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0342288,"nucleus_log2fc":-0.0859432,"nucleus_score":-2.34067,"pct_ad":0.104023,"pct_control":0.114213,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0606052,"donor_lfcse":0.0981699,"donor_log2fc_shrunk":-6.49793e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000117505","entrez_id":["1810"],"uniprot":["Q01658"],"ncbi_summary":"This gene encodes a TBP- (TATA box-binding protein) associated phosphoprotein that represses both basal and activated levels of transcription. The encoded protein is phosphorylated in vivo and this phosphorylation affects its interaction with TBP. This protein contains a histone fold motif at the amino terminus, a TBP-binding domain, and a glutamine- and alanine-rich region. The binding of DR1 repressor complexes to TBP-promoter complexes may establish a mechanism in which an altered DNA conformation, together with the formation of higher order complexes, inhibits the assembly of the preinitiation complex and controls the rate of RNA polymerase II transcription. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q01658","text":"The association of the DR1/DRAP1 heterodimer with TBP results in a functional repression of both activated and basal transcription of class II genes. This interaction precludes the formation of a transcription-competent complex by inhibiting the association of TFIIA and/or TFIIB with TBP. Can bind to DNA on its own. Component of the ATAC complex, a complex with histone acetyltransferase activity on histones H3 and H4."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}