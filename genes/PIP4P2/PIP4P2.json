99","module":"yellow","kme":0.174078,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000155099","entrez_id":["55529"],"uniprot":["Q8N4L2"],"ncbi_summary":"TMEM55A catalyzes the degradation of phosphatidylinositol 4,5-bisphosphate (PtdIns-4,5-P2) by removing the 4-phosphate (Ungewickell et al., 2005 [PubMed 16365287]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8N4L2","text":"Catalyzes the hydrolysis of phosphatidylinositol-4,5-bisphosphate (PtdIns-4,5-P2) to phosphatidylinositol-4-phosphate (PtdIns-4-P) (PubMed:16365287). Does not hydrolyze phosphatidylinositol 3,4,5-trisphosphate, phosphatidylinositol 3,4-bisphosphate, inositol 3,5-bisphosphate, inositol 3,4-bisphosphate, phosphatidylinositol 5-monophosphate, phosphatidylinositol 4-monophosphate and phosphatidylinositol 3-monophosphate (PubMed:16365287). Negatively regulates the phagocytosis of large particles by reducing phagosomal phosphatidylinositol 4,5-bisphosphate accumulation during cup formation (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}