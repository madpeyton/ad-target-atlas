"cell_type":"Ast","gene_id":"ENSG00000144485","module":"turquoise","kme":0.175079,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000144485","module":"yellow","kme":0.190738,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000144485","module":"turquoise","kme":0.170841,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000144485","module":"turquoise","kme":0.125893,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000144485","entrez_id":["55502"],"uniprot":["Q96HZ4"],"ncbi_summary":"This gene encodes a member of a subfamily of basic helix-loop-helix transcription repressors that have homology to the Drosophila enhancer of split genes. Members of this gene family regulate cell differentiation in numerous cell types. The protein encoded by this gene functions as a cofactor, interacting with other transcription factors through a tetrapeptide domain in its C-terminus. Alternatively spliced transcript variants encoding different isoforms have been described.[provided by RefSeq, Dec 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96HZ4","text":"Does not bind DNA itself but suppresses both HES1-mediated N box-dependent transcriptional repression and binding of HES1 to E box sequences. Also suppresses HES1-mediated inhibition of the heterodimer formed by ASCL1/MASH1 and TCF3/E47, allowing ASCL1 and TCF3 to up-regulate transcription in its presence. Promotes cell differentiation (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}