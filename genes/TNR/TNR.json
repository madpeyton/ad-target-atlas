rol":0.998307,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0336175,"donor_lfcse":0.10579,"donor_log2fc_shrunk":-3.09148e-06,"degas_log2fc":-0.368047,"degas_padj":4.28853e-225},{"cell_type":"Oli","gene_symbol":"TNR","gene_symbol_current":"TNR","gene_id":"ENSG00000116147","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.25311e-19,"nucleus_log2fc":-0.26624,"nucleus_score":-9.16193,"pct_ad":0.134522,"pct_control":0.158733,"donor_test":"not significant","donor_padj":0.868586,"donor_log2fc":-0.161242,"donor_lfcse":0.179591,"donor_log2fc_shrunk":-0.00551705,"degas_log2fc":-0.306194,"degas_padj":7.48854e-23}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000116147","module":"blue","kme":0.166384,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000116147","module":"blue","kme":0.221165,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000116147","module":"turquoise","kme":0.203725,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000116147","module":"pink","kme":0.488963,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000116147","module":"brown","kme":0.18865,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000116147","entrez_id":["7143"],"uniprot":["Q92752"],"ncbi_summary":"This gene encodes a member of the tenascin family of extracellular matrix glycoproteins. The encoded protein is restricted to the central nervous system. The protein may play a role in neurite outgrowth, neural cell adhesion and modulation of sodium channel function. It is a constituent of perineuronal nets. [provided by RefSeq, Aug 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92752","text":"Neural extracellular matrix (ECM) protein involved in interactions with different cells and matrix components. These interactions can influence cellular behavior by either evoking a stable adhesion and differentiation, or repulsion and inhibition of neurite growth. Binding to cell surface gangliosides inhibits RGD-dependent integrin-mediated cell adhesion and results in an inhibition of PTK2/FAK1 (FAK) phosphorylation and cell detachment. Binding to membrane surface sulfatides results in a oligodendrocyte adhesion and differentiation. Interaction with CNTN1 induces a repulsion of neurons and an inhibition of neurite outgrowth. Interacts with SCN2B may play a crucial role in clustering and regulation of activity of sodium channels at nodes of Ranvier. TNR-linked chondroitin sulfate glycosaminoglycans are involved in the interaction with FN1 and mediate inhibition of cell adhesion and neurite outgrowth. The highly regulated addition of sulfated carbohydrate structure may modulate the adhesive properties of TNR over the course of development and during synapse maintenance (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}