rol":0.157581,"donor_test":"not significant","donor_padj":0.93392,"donor_log2fc":-0.0536259,"donor_lfcse":0.102155,"donor_log2fc_shrunk":-0.0051804}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000121350","module":"turquoise","kme":0.0365823,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000121350","entrez_id":["79912"],"uniprot":["Q8WU10"],"ncbi_summary":"This gene encodes a nuclear-cytoplasmic pyridine nucleotide-disulphide reductase (PNDR). PNDRs are flavoproteins that catalyze the pyridine nucleotide-dependent reduction of thiol residues in other proteins. The encoded protein belongs to the class I pyridine nucleotide-disulphide oxidoreductase family but lacks the C-terminal dimerization domain found in other family members and instead has a C-terminal nitrile reductase domain. It localizes to the nucleus and to striated sarcomeric compartments. Naturally occurring mutations in this gene cause early-onset myopathy with internalized nuclei and myofibrillar disorganization. A pseudogene of this gene has been defined on chromosome 11. [provided by RefSeq, Apr 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WU10","text":"Flavoprotein whose role is to protect RTCB, the catalytic subunit of the tRNA ligase complex (tRNA-LC) involved in tRNA splicing and unfolded protein response, from oxidative inactivation (PubMed:33930333). It directly binds and shields the catalytic center of RTCB, prior to guanylylation, when it is inactive and its active site is vulnerable to oxidation under aerobic conditions. The interaction of PYROXD1 with RTCB is allosterically regulated by NAD(P)H binding and reduction of its FAD cofactor, while reoxidation of PYROXD1 thanks to its NADPH dehydrogenase activity triggers the timed release of RTCB, enabling its subsequent activation. Thereby, this protective mechanism may also function as a molecular timer, regulating RTCB activation through controlled release (PubMed:40069351)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}