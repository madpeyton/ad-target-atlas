"hub":false,"module_direction":"higher in AD","module_padj":0.939268,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000102409","module":"turquoise","kme":0.273932,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000102409","module":"turquoise","kme":0.289063,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000102409","entrez_id":["56271"],"uniprot":["Q9NWD9"],"ncbi_summary":"This gene is a member of the brain expressed X-linked gene family. The proteins encoded by some of the other members of this family act as transcription elongation factors which allow RNA polymerase II to escape pausing during elongation. Multiple alternatively spliced variants, encoding the same protein, have been identified. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NWD9","text":"May play a role in microtubule deacetylation by negatively regulating the SIRT2 deacetylase activity toward alpha-tubulin and thereby participate in the control of cell cycle progression and genomic stability (PubMed:27512957). In absence of reductive stress, acts as a pseudosubstrate for the CRL2(FEM1B) complex: associates with FEM1B via zinc, thereby preventing association between FEM1B and its substrates (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}