significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.25203,"donor_lfcse":0.204882,"donor_log2fc_shrunk":6.13501e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000146674","module":"brown","kme":0.0241512,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000146674","entrez_id":["3486"],"uniprot":["P17936"],"ncbi_summary":"This gene is a member of the insulin-like growth factor binding protein (IGFBP) family and encodes a protein with an IGFBP domain and a thyroglobulin type-I domain. The protein forms a ternary complex with insulin-like growth factor acid-labile subunit (IGFALS) and either insulin-like growth factor (IGF) I or II. In this form, it circulates in the plasma, prolonging the half-life of IGFs and altering their interaction with cell surface receptors. Alternate transcriptional splice variants, encoding different isoforms, have been characterized. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P17936","text":"Multifunctional protein that plays a critical role in regulating the availability of IGFs such as IGF1 and IGF2 to their receptors and thereby regulates IGF-mediated cellular processes including proliferation, differentiation, and apoptosis in a cell-type specific manner (PubMed:10874028, PubMed:19556345). Also exhibits IGF-independent antiproliferative and apoptotic effects mediated by its receptor TMEM219/IGFBP-3R (PubMed:20353938). Inhibits the positive effect of humanin on insulin sensitivity (PubMed:19623253). Promotes testicular germ cell apoptosis (PubMed:19952275). Acts via LRP-1/alpha2M receptor, also known as TGF-beta type V receptor, to mediate cell growth inhibition independent of IGF1 (PubMed:9252371). Mechanistically, induces serine-specific dephosphorylation of IRS1 or IRS2 upon ligation to its receptor, leading to the inhibitory cascade (PubMed:15371331). In the nucleus, interacts with transcription factors such as retinoid X receptor-alpha/RXRA to regulate transcriptional signaling and apoptosis (PubMed:10874028)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}