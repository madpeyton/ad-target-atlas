ene_ids":["ENSG00000137822"],"dataset_symbols":["TUBGCP4"],"explorer":"explorer.html?dataset=mathys2019#gene/TUBGCP4","cell_types":[{"cell_type":"Ex","gene_symbol":"TUBGCP4","gene_symbol_current":"TUBGCP4","gene_id":"ENSG00000137822","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00155869,"nucleus_log2fc":-0.128102,"nucleus_score":-3.43284,"pct_ad":0.21028,"pct_control":0.229143,"donor_test":"not significant","donor_padj":0.991846,"donor_log2fc":-0.0280813,"donor_lfcse":0.0851062,"donor_log2fc_shrunk":-3.71602e-06},{"cell_type":"In","gene_symbol":"TUBGCP4","gene_symbol_current":"TUBGCP4","gene_id":"ENSG00000137822","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.968848,"nucleus_log2fc":-0.0549583,"nucleus_score":0.124306,"pct_ad":0.128217,"pct_control":0.125428,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0123059,"donor_lfcse":0.16674,"donor_log2fc_shrunk":-4.70004e-07}],"modules":[{"cell_type":"In","gene_id":"ENSG00000137822","module":"turquoise","kme":0.206054,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000137822","entrez_id":["27229"],"uniprot":["Q9UGJ1"],"ncbi_summary":"This gene encodes a component of the gamma-tubulin ring complex, which is required for microtubule nucleation. In mammalian cells, the protein localizes to centrosomes in association with gamma-tubulin. Crystal structure analysis revealed a structure composed of five helical bundles arranged around conserved hydrophobic cores. An exposed surface area located in the C-terminal domain is essential and sufficient for direct binding to gamma-tubulin. Mutations in this gene that alter microtubule organization are associated with microcephaly and chorioretinopathy. Alternative splicing results in multiple transcript variants. [provided by RefSeq, May 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UGJ1","text":"Component of the gamma-tubulin ring complex (gTuRC) which mediates microtubule nucleation (PubMed:38305685, PubMed:38609661, PubMed:39321809). The gTuRC regulates the minus-end nucleation of alpha-beta tubulin heterodimers that grow into microtubule protafilaments, a critical step in centrosome duplication and spindle formation (PubMed:38305685, PubMed:38609661, PubMed:39321809)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}