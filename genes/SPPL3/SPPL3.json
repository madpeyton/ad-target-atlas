,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0190506,"nucleus_log2fc":-0.0726633,"nucleus_score":-2.62197,"pct_ad":0.648282,"pct_control":0.661406,"donor_test":"not significant","donor_padj":0.765468,"donor_log2fc":-0.059933,"donor_lfcse":0.0593694,"donor_log2fc_shrunk":-0.024763,"degas_log2fc":0.318998,"degas_padj":4.35864e-31},{"cell_type":"OPC","gene_symbol":"SPPL3","gene_symbol_current":"SPPL3","gene_id":"ENSG00000157837","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00123884,"nucleus_log2fc":-0.114715,"nucleus_score":-3.73613,"pct_ad":0.706084,"pct_control":0.733446,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0648311,"donor_lfcse":0.0838975,"donor_log2fc_shrunk":-9.54785e-06,"degas_log2fc":-0.389034,"degas_padj":1.85945e-41},{"cell_type":"Oli","gene_symbol":"SPPL3","gene_symbol_current":"SPPL3","gene_id":"ENSG00000157837","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.38813e-31,"nucleus_log2fc":-0.156227,"nucleus_score":-11.8547,"pct_ad":0.691874,"pct_control":0.729881,"donor_test":"not significant","donor_padj":0.834591,"donor_log2fc":-0.0852363,"donor_lfcse":0.0790285,"donor_log2fc_shrunk":-0.0132423,"degas_log2fc":-0.23488,"degas_padj":5.07497e-72}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000157837","module":"blue","kme":0.208403,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000157837","entrez_id":["121665"],"uniprot":["Q8TCT6"],"ncbi_summary":"Enables aspartic endopeptidase activity, intramembrane cleaving and protein homodimerization activity. Involved in several processes, including T cell receptor signaling pathway; positive regulation of calcineurin-NFAT signaling cascade; and positive regulation of protein dephosphorylation. Located in Golgi-associated vesicle membrane; plasma membrane; and rough endoplasmic reticulum. Is integral component of cytoplasmic side of endoplasmic reticulum membrane and integral component of lumenal side of endoplasmic reticulum membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TCT6","text":"Intramembrane-cleaving aspartic protease (I-CLiP) that cleaves type II membrane protein substrates in or close to their luminal transmembrane domain boundaries (PubMed:16873890, PubMed:25354954, PubMed:25827571). Acts like a sheddase by mediating the proteolytic release and secretion of active site-containing ectodomains of glycan-modifiying glycosidase and glycosyltransferase enzymes such as MGAT5, B4GAT1 and B4GALT1 (PubMed:25354954, PubMed:25827571). Catalyzes the intramembrane cleavage of the envelope glycoprotein gp130 and/or the leader peptide gp18LP of the simian foamy virus independent of prior ectodomain shedding by furin or furin-like proprotein convertase (PC)-mediated cleavage proteolysis (PubMed:23132852). May also have the ability to serve as a shedding protease for subsequent intramembrane proteolysis by SPPL2A and SPPL2B of the envelope glycoprotein gp130 (PubMed:23132852). Plays a role in the regulation of cellular glycosylation processes (PubMed:25354954). Required to link T-cell antigen receptor (TCR) and calcineurin-NFAT signaling cascades in lymphocytes by promoting the association of STIM1 and ORAI1 during store-operated calcium entry (SOCE) in a protease-independent manner (PubMed:25384971)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}