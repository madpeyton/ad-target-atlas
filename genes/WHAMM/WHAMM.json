000156232","module":"turquoise","kme":0.0639942,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000156232"],"dataset_symbols":["WHAMM"],"explorer":"explorer.html?dataset=mathys2019#gene/WHAMM","cell_types":[{"cell_type":"Ex","gene_symbol":"WHAMM","gene_symbol_current":"WHAMM","gene_id":"ENSG00000156232","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.852993,"nucleus_log2fc":0.036661,"nucleus_score":0.237318,"pct_ad":0.11154,"pct_control":0.110703,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0932141,"donor_lfcse":0.0836106,"donor_log2fc_shrunk":1.44103e-05},{"cell_type":"Oli","gene_symbol":"WHAMM","gene_symbol_current":"WHAMM","gene_id":"ENSG00000156232","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.855932,"donor_log2fc":0.158325,"donor_lfcse":0.162203,"donor_log2fc_shrunk":0.00581231}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000156232","entrez_id":["123720"],"uniprot":["Q8TF30"],"ncbi_summary":"This gene encodes a protein that plays a role in actin nucleation, Golgi membrane association and microtubule binding. The encoded protein is a nucleation-promoting factor that regulates the Actin-related protein 2/3 complex. The activated complex initiates growth of new actin filaments by binding to existing actin filaments. The encoded protein also functions in regulation of transport from the endoplasmic reticulum to the Golgi complex and in maintenance of the Golgi complex near the centrosome. Four pseudogenes of this gene are present on the same arm of chromosome 15 as this gene. [provided by RefSeq, Aug 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TF30","text":"Acts as a nucleation-promoting factor (NPF) that stimulates Arp2/3-mediated actin polymerization both at the Golgi apparatus and along tubular membranes. Its activity in membrane tubulation requires F-actin and interaction with microtubules. Proposed to use coordinated actin-nucleating and microtubule-binding activities of distinct WHAMM molecules to drive membrane tubule elongation; when MT-bound can recruit and remodel membrane vesicles but is prevented to activate the Arp2/3 complex. Involved as a regulator of Golgi positioning and morphology. Participates in vesicle transport between the reticulum endoplasmic and the Golgi complex. Required for RhoD-dependent actin reorganization such as in cell adhesion and cell migration."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}