ol":0.674787,"donor_test":"not significant","donor_padj":0.678132,"donor_log2fc":0.11792,"donor_lfcse":0.0846624,"donor_log2fc_shrunk":0.01511},{"cell_type":"In","gene_symbol":"UBA5","gene_symbol_current":"UBA5","gene_id":"ENSG00000081307","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.011424,"nucleus_log2fc":0.0283599,"nucleus_score":2.6052,"pct_ad":0.481556,"pct_control":0.480486,"donor_test":"not significant","donor_padj":0.73713,"donor_log2fc":0.106369,"donor_lfcse":0.0699075,"donor_log2fc_shrunk":0.0106539},{"cell_type":"Mic","gene_symbol":"UBA5","gene_symbol_current":"UBA5","gene_id":"ENSG00000081307","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.183126,"nucleus_log2fc":-0.0628328,"nucleus_score":-1.55919,"pct_ad":0.135747,"pct_control":0.144355,"donor_test":"not significant","donor_padj":0.856861,"donor_log2fc":-0.0621131,"donor_lfcse":0.087627,"donor_log2fc_shrunk":-0.014113},{"cell_type":"OPC","gene_symbol":"UBA5","gene_symbol_current":"UBA5","gene_id":"ENSG00000081307","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.478842,"nucleus_log2fc":-0.0277482,"nucleus_score":-0.988328,"pct_ad":0.339398,"pct_control":0.34818,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0520877,"donor_lfcse":0.0685084,"donor_log2fc_shrunk":-1.16408e-05},{"cell_type":"Oli","gene_symbol":"UBA5","gene_symbol_current":"UBA5","gene_id":"ENSG00000081307","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000182525,"nucleus_log2fc":-0.103128,"nucleus_score":-3.89044,"pct_ad":0.171438,"pct_control":0.182618,"donor_test":"not significant","donor_padj":0.959599,"donor_log2fc":-0.0270304,"donor_lfcse":0.0732176,"donor_log2fc_shrunk":-0.00529604}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000081307","entrez_id":["79876"],"uniprot":["Q9GZZ9"],"ncbi_summary":"This gene encodes a member of the E1-like ubiquitin-activating enzyme family. This protein activates ubiquitin-fold modifier 1, a ubiquitin-like post-translational modifier protein, via the formation of a high-energy thioester bond. Alternative splicing results in multiple transcript variants. A pseudogene of this gene has been identified on chromosome 1. [provided by RefSeq, Feb 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9GZZ9","text":"E1-like enzyme which specifically catalyzes the first step in ufmylation (PubMed:15071506, PubMed:18442052, PubMed:20368332, PubMed:25219498, PubMed:26929408, PubMed:27545674, PubMed:27545681, PubMed:27653677, PubMed:30412706, PubMed:30626644, PubMed:34588452). Activates UFM1 by first adenylating its C-terminal glycine residue with ATP, and thereafter linking this residue to the side chain of a cysteine residue in E1, yielding a UFM1-E1 thioester and free AMP (PubMed:20368332, PubMed:26929408, PubMed:27653677, PubMed:30412706). Activates UFM1 via a trans-binding mechanism, in which UFM1 interacts with distinct sites in both subunits of the UBA5 homodimer (PubMed:27653677). Trans-binding also promotes stabilization of the UBA5 homodimer, and enhances ATP-binding (PubMed:29295865). Transfer of UFM1 from UBA5 to the E2-like enzyme UFC1 also takes place using a trans mechanism (PubMed:27653677, PubMed:34588452). Ufmylation plays a key role in various processes, such as ribosome recycling, response to DNA damage, interferon response or reticulophagy (also called ER-phagy) (PubMed:30412706, PubMed:32160526, PubMed:35394863). Ufmylation is essential for erythroid differentiation of both megakaryocytes and erythrocytes (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}