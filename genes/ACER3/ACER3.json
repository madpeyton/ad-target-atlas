donor_log2fc":-0.133466,"donor_lfcse":0.107959,"donor_log2fc_shrunk":-1.18495e-05},{"cell_type":"Mic","gene_symbol":"ACER3","gene_symbol_current":"ACER3","gene_id":"ENSG00000078124","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.413423,"nucleus_log2fc":0.302635,"nucleus_score":1.4888,"pct_ad":0.168512,"pct_control":0.141074,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"ACER3","gene_symbol_current":"ACER3","gene_id":"ENSG00000078124","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.422609,"nucleus_log2fc":-0.158617,"nucleus_score":-1.48316,"pct_ad":0.321821,"pct_control":0.350958,"donor_test":"not significant","donor_padj":0.966485,"donor_log2fc":-0.160155,"donor_lfcse":0.116171,"donor_log2fc_shrunk":-0.00246344},{"cell_type":"Oli","gene_symbol":"ACER3","gene_symbol_current":"ACER3","gene_id":"ENSG00000078124","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.83513e-07,"nucleus_log2fc":0.2608,"nucleus_score":5.54546,"pct_ad":0.320122,"pct_control":0.280543,"donor_test":"not significant","donor_padj":0.833602,"donor_log2fc":0.0992336,"donor_lfcse":0.0912194,"donor_log2fc_shrunk":0.011042}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000078124","module":"magenta","kme":0.223968,"hub":false,"module_direction":"higher in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000078124","module":"brown","kme":0.171217,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000078124","entrez_id":["55331"],"uniprot":["Q9NUN7"],"ncbi_summary":"Enables N-acylsphingosine amidohydrolase activity and metal ion binding activity. Involved in several processes, including myelination; positive regulation of cell population proliferation; and sphingolipid metabolic process. Is integral component of Golgi membrane and integral component of endoplasmic reticulum membrane. Biomarker of hepatocellular carcinoma and non-alcoholic steatohepatitis. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NUN7","text":"Endoplasmic reticulum and Golgi ceramidase that catalyzes the hydrolysis of unsaturated long-chain C18:1-, C20:1- and C20:4-ceramides, dihydroceramides and phytoceramides into sphingoid bases like sphingosine and free fatty acids at alkaline pH (PubMed:11356846, PubMed:20068046, PubMed:20207939, PubMed:26792856, PubMed:30575723). Ceramides, sphingosine, and its phosphorylated form sphingosine-1-phosphate are bioactive lipids that mediate cellular signaling pathways regulating several biological processes including cell proliferation, apoptosis and differentiation (PubMed:20068046). Controls the generation of sphingosine in erythrocytes, and thereby sphingosine-1-phosphate in plasma (PubMed:20207939). Through the regulation of ceramides and sphingosine-1-phosphate homeostasis in the brain may play a role in neurons survival and function (By similarity). By regulating the levels of pro-inflammatory ceramides in immune cells and tissues, may modulate the inflammatory response (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}