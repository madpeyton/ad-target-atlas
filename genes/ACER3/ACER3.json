k":0.00442321,"degas_log2fc":-0.202252,"degas_padj":3.59733e-134},{"cell_type":"Mic","gene_symbol":"ACER3","gene_symbol_current":"ACER3","gene_id":"ENSG00000078124","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":4.03897e-11,"nucleus_log2fc":0.201676,"nucleus_score":6.9218,"pct_ad":0.641597,"pct_control":0.605991,"donor_test":"not significant","donor_padj":0.84982,"donor_log2fc":0.141115,"donor_lfcse":0.191044,"donor_log2fc_shrunk":0.00744555,"degas_log2fc":-0.269378,"degas_padj":7.64657e-20},{"cell_type":"OPC","gene_symbol":"ACER3","gene_symbol_current":"ACER3","gene_id":"ENSG00000078124","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":6.56967e-17,"nucleus_log2fc":0.248699,"nucleus_score":8.83956,"pct_ad":0.740531,"pct_control":0.701101,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.191921,"donor_lfcse":0.0913973,"donor_log2fc_shrunk":2.14889e-05,"degas_log2fc":-0.393474,"degas_padj":6.48913e-42},{"cell_type":"Oli","gene_symbol":"ACER3","gene_symbol_current":"ACER3","gene_id":"ENSG00000078124","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":5.01684e-52,"nucleus_log2fc":0.178553,"nucleus_score":15.3374,"pct_ad":0.760854,"pct_control":0.741542,"donor_test":"not significant","donor_padj":0.853001,"donor_log2fc":0.109406,"donor_lfcse":0.108947,"donor_log2fc_shrunk":0.00983382,"degas_log2fc":-0.22152,"degas_padj":7.58642e-69}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000078124","module":"blue","kme":0.365586,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000078124","module":"blue","kme":0.22227,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000078124","entrez_id":["55331"],"uniprot":["Q9NUN7"],"ncbi_summary":"Enables N-acylsphingosine amidohydrolase activity and metal ion binding activity. Involved in several processes, including myelination; positive regulation of cell population proliferation; and sphingolipid metabolic process. Is integral component of Golgi membrane and integral component of endoplasmic reticulum membrane. Biomarker of hepatocellular carcinoma and non-alcoholic steatohepatitis. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NUN7","text":"Endoplasmic reticulum and Golgi ceramidase that catalyzes the hydrolysis of unsaturated long-chain C18:1-, C20:1- and C20:4-ceramides, dihydroceramides and phytoceramides into sphingoid bases like sphingosine and free fatty acids at alkaline pH (PubMed:11356846, PubMed:20068046, PubMed:20207939, PubMed:26792856, PubMed:30575723). Ceramides, sphingosine, and its phosphorylated form sphingosine-1-phosphate are bioactive lipids that mediate cellular signaling pathways regulating several biological processes including cell proliferation, apoptosis and differentiation (PubMed:20068046). Controls the generation of sphingosine in erythrocytes, and thereby sphingosine-1-phosphate in plasma (PubMed:20207939). Through the regulation of ceramides and sphingosine-1-phosphate homeostasis in the brain may play a role in neurons survival and function (By similarity). By regulating the levels of pro-inflammatory ceramides in immune cells and tissues, may modulate the inflammatory response (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}