,"nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.996763,"donor_log2fc":0.0249202,"donor_lfcse":0.161446,"donor_log2fc_shrunk":9.95977e-07}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000103995","module":"blue","kme":0.0688917,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000103995","entrez_id":["22995"],"uniprot":["O94986"],"ncbi_summary":"This gene encodes a protein that is thought to be involved with centrosome function. Mutations in this gene have been associated with primary microcephaly (MCPH4). Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O94986","text":"Necessary for centrosome duplication; the function also seems to involve CEP63, CDK5RAP2 and WDR62 through a stepwise assembled complex at the centrosome that recruits CDK2 required for centriole duplication (PubMed:26297806). Acts as a molecular scaffold facilitating the interaction of PLK4 and CPAP, 2 molecules involved in centriole formation (PubMed:20852615, PubMed:21059844). Proposed to snatch PLK4 away from PLK4:CEP92 complexes in early G1 daughter centriole and to reposition PLK4 at the outer boundary of a newly forming CEP152 ring structure (PubMed:24997597). Also plays a key role in deuterosome-mediated centriole amplification in multiciliated that can generate more than 100 centrioles (By similarity). Overexpression of CEP152 can drive amplification of centrioles (PubMed:20852615)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}