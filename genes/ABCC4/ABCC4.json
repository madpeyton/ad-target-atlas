85,"donor_lfcse":0.107761,"donor_log2fc_shrunk":-0.00778238},{"cell_type":"Mic","gene_symbol":"ABCC4","gene_symbol_current":"ABCC4","gene_id":"ENSG00000125257","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.62455e-60,"nucleus_log2fc":-0.396222,"nucleus_score":-16.6859,"pct_ad":0.782544,"pct_control":0.84735,"donor_test":"not significant","donor_padj":0.485509,"donor_log2fc":-0.262412,"donor_lfcse":0.140279,"donor_log2fc_shrunk":-0.0286699},{"cell_type":"OPC","gene_symbol":"ABCC4","gene_symbol_current":"ABCC4","gene_id":"ENSG00000125257","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000450848,"nucleus_log2fc":-0.231397,"nucleus_score":-4.01484,"pct_ad":0.173278,"pct_control":0.200677,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.171909,"donor_lfcse":0.148918,"donor_log2fc_shrunk":-7.98771e-06},{"cell_type":"Oli","gene_symbol":"ABCC4","gene_symbol_current":"ABCC4","gene_id":"ENSG00000125257","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.989133,"donor_log2fc":0.0409285,"donor_lfcse":0.444541,"donor_log2fc_shrunk":0.000217329}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000125257","module":"brown","kme":0.402453,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000125257","module":"greenyellow","kme":0.208135,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000125257","module":"green","kme":0.504605,"hub":true,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000125257","module":"blue","kme":0.13061,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000125257","entrez_id":["10257"],"uniprot":["O15439"],"ncbi_summary":"The protein encoded by this gene is a member of the superfamily of ATP-binding cassette (ABC) transporters. ABC proteins transport various molecules across extra- and intra-cellular membranes. ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, White). This protein is a member of the MRP subfamily which is involved in multi-drug resistance. This family member plays a role in cellular detoxification as a pump for its substrate, organic anions. It may also function in prostaglandin-mediated cAMP signaling in ciliogenesis. Alternative splicing of this gene results in multiple transcript variants. [provided by RefSeq, Sep 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O15439","text":"ATP-dependent transporter of the ATP-binding cassette (ABC) family that actively extrudes physiological compounds and xenobiotics from cells (PubMed:11856762, PubMed:12523936, PubMed:15364914, PubMed:38886124, PubMed:40138312). Transports a range of endogenous molecules that have a key role in cellular communication and signaling, including cyclic nucleotides such as cyclic AMP (cAMP) and cyclic GMP (cGMP), bile acids, steroid conjugates, urate, and prostaglandins (PubMed:11856762, PubMed:12523936, PubMed:12835412, PubMed:12883481, PubMed:15364914, PubMed:15454390, PubMed:16282361, PubMed:17959747, PubMed:18300232, PubMed:26721430, PubMed:38886124, PubMed:40138312). Mediates the ATP-dependent efflux of glutathione conjugates such as leukotriene C4 (LTC4) and leukotriene B4 (LTB4) too. The presence of GSH is necessary for the ATP-dependent transport of LTB4, whereas GSH is not required for the transport of LTC4 (PubMed:17959747). Mediates the cotransport of bile acids with reduced glutathione (GSH) (PubMed:12523936, PubMed:12883481, PubMed:16282361). May contribute to hepatic, intestinal and renal excretion of steroid conjugates. Selectively transports steroid glucuronates and sulfates. Mediates the efflux of estrogens glucuronated at C-16 and C-17 positions, but has no transporter activity toward estrogens glucuronated at C-3. Has high affinity for dehydroepiandrosterone-3-sulfate and can also transport testosterone-17-sulfate, but has no transporter activity toward androsterone and etiocholanolone sulfate conjugates. Does not transport estrone 3-sulfate (PubMed:29175180, PubMed:39993711). Displays low affinity and high transport velocity for folates (PubMed:12036927). Transports a wide range of drugs and their metabolites. including anticancer, antiviral and antibiotic molecules (PubMed:11856762, PubMed:12105214, PubMed:15454390, PubMed:17344354, PubMed:18300232). May confer resistance to anticancer agents. Can mediate the efflux of methotrexate but is inactive toward polyglutaminated methotrexate, which is the predominant intracellular form (PubMed:11106685, PubMed:12036927)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}