leus_score":34.2625,"pct_ad":0.796268,"pct_control":0.72783,"donor_test":"not significant","donor_padj":0.483949,"donor_log2fc":0.397512,"donor_lfcse":0.161524,"donor_log2fc_shrunk":0.01842,"degas_log2fc":0.109904,"degas_padj":1.25602e-15}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000135643","module":"blue","kme":0.130782,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000135643","module":"turquoise","kme":0.086752,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000135643","module":"blue","kme":0.205566,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000135643","entrez_id":["27345"],"uniprot":["Q86W47"],"ncbi_summary":"MaxiK channels are large conductance, voltage and calcium-sensitive potassium channels which are fundamental to the control of smooth muscle tone and neuronal excitability. MaxiK channels can be formed by 2 subunits: the pore-forming alpha subunit and the modulatory beta subunit. The protein encoded by this gene is an auxiliary beta subunit which slows activation kinetics, leads to steeper calcium sensitivity, and shifts the voltage range of current activation to more negative potentials than does the beta 1 subunit. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86W47","text":"Regulatory subunit of the calcium activated potassium KCNMA1 (maxiK) channel. Modulates the calcium sensitivity and gating kinetics of KCNMA1, thereby contributing to KCNMA1 channel diversity. Decreases the gating kinetics and calcium sensitivity of the KCNMA1 channel, but with fast deactivation kinetics. May decrease KCNMA1 channel openings at low calcium concentrations but increases channel openings at high calcium concentrations. Makes KCNMA1 channel resistant to 100 nM charybdotoxin (CTX) toxin concentrations."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}