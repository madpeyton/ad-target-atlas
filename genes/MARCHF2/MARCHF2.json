hrunk":0.00346879}],"modules":[{"cell_type":"Astrocytes","gene_id":"ENSG00000099785","module":"turquoise","kme":0.107406,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000099785","module":"turquoise","kme":0.19755,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000099785"],"dataset_symbols":["MARCH2"],"explorer":"explorer.html?dataset=mathys2019#gene/MARCH2","cell_types":[{"cell_type":"Ex","gene_symbol":"MARCH2","gene_symbol_current":"MARCHF2","gene_id":"ENSG00000099785","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.401933,"nucleus_log2fc":-0.00203563,"nucleus_score":-0.980349,"pct_ad":0.206928,"pct_control":0.213192,"donor_test":"not significant","donor_padj":0.996763,"donor_log2fc":-0.0124174,"donor_lfcse":0.0930684,"donor_log2fc_shrunk":-3.57089e-05},{"cell_type":"In","gene_symbol":"MARCH2","gene_symbol_current":"MARCHF2","gene_id":"ENSG00000099785","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.286867,"donor_lfcse":0.155073,"donor_log2fc_shrunk":1.22579e-05},{"cell_type":"Oli","gene_symbol":"MARCH2","gene_symbol_current":"MARCHF2","gene_id":"ENSG00000099785","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.946545,"donor_log2fc":-0.0777409,"donor_lfcse":0.175057,"donor_log2fc_shrunk":-0.00240122}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000099785","entrez_id":["51257"],"uniprot":["Q9P0N8"],"ncbi_summary":"MARCH2 is a member of the MARCH family of membrane-bound E3 ubiquitin ligases (EC 6.3.2.19). MARCH enzymes add ubiquitin (see MIM 191339) to target lysines in substrate proteins, thereby signaling their vesicular transport between membrane compartments. MARCH2 reduces surface accumulation of several glycoproteins and appears to regulate early endosome-to-trans-Golgi network (TGN) trafficking (Bartee et al., 2004 [PubMed 14722266]; Nakamura et al., 2005 [PubMed 15689499]).[supplied by OMIM, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9P0N8","text":"E3 ubiquitin-protein ligase that may mediate ubiquitination of TFRC and CD86, and promote their subsequent endocytosis and sorting to lysosomes via multivesicular bodies. E3 ubiquitin ligases accept ubiquitin from an E2 ubiquitin-conjugating enzyme in the form of a thioester and then directly transfer the ubiquitin to targeted substrates (PubMed:14722266, PubMed:16428329). Together with GOPC/CAL mediates the ubiquitination and lysosomal degradation of CFTR (PubMed:23818989). Ubiquitinates and therefore mediates the degradation of DLG1 (PubMed:17980554). Regulates the intracellular trafficking and secretion of alpha1-antitrypsin/SERPINA1 and HP/haptoglobin via ubiquitination and degradation of the cargo receptor ERGIC3 (PubMed:31142615). Negatively regulates the antiviral and antibacterial immune response by repression of the NF-kB and type 1 IFN signaling pathways, via MARCHF2-mediated K48-linked polyubiquitination of IKBKG/NEMO, resulting in its proteasomal degradation (PubMed:32935379). May be involved in endosomal trafficking through interaction with STX6 (PubMed:15689499). (Microbial infection) Positively regulates the degradation of Vesicular stomatitis virus (VSV) G protein via the lysosomal degradation pathway (PubMed:29573664). Represses HIV-1 viral production and may inhibit the translocation of HIV-1 env to the cell surface, resulting in decreased viral cell-cell transmission (PubMed:29573664)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}