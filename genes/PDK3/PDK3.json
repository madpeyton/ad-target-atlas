:[{"cell_type":"CUX2+","gene_id":"ENSG00000067992","module":"brown","kme":0.336537,"hub":false,"module_direction":"lower in AD","module_padj":0.923266,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000067992","module":"turquoise","kme":0.173548,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000067992"],"dataset_symbols":["PDK3"],"explorer":"explorer.html?dataset=mathys2019#gene/PDK3","cell_types":[{"cell_type":"Ex","gene_symbol":"PDK3","gene_symbol_current":"PDK3","gene_id":"ENSG00000067992","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.10186e-17,"nucleus_log2fc":-0.273458,"nucleus_score":-8.8761,"pct_ad":0.372308,"pct_control":0.43101,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.181378,"donor_lfcse":0.0968905,"donor_log2fc_shrunk":-2.0159e-05},{"cell_type":"In","gene_symbol":"PDK3","gene_symbol_current":"PDK3","gene_id":"ENSG00000067992","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.707145,"nucleus_log2fc":-0.103379,"nucleus_score":-0.952209,"pct_ad":0.231588,"pct_control":0.239029,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.102647,"donor_lfcse":0.144373,"donor_log2fc_shrunk":-6.93461e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000067992","module":"brown","kme":0.210077,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000067992","module":"turquoise","kme":0.0991629,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000067992","entrez_id":["5165"],"uniprot":["Q15120"],"ncbi_summary":"The pyruvate dehydrogenase (PDH) complex is a nuclear-encoded mitochondrial multienzyme complex that catalyzes the overall conversion of pyruvate to acetyl-CoA and CO(2). It provides the primary link between glycolysis and the tricarboxylic acid (TCA) cycle, and thus is one of the major enzymes responsible for the regulation of glucose metabolism. The enzymatic activity of PDH is regulated by a phosphorylation/dephosphorylation cycle, and phosphorylation results in inactivation of PDH. The protein encoded by this gene is one of the three pyruvate dehydrogenase kinases that inhibits the PDH complex by phosphorylation of the E1 alpha subunit. This gene is predominantly expressed in the heart and skeletal muscles. Alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15120","text":"Inhibits pyruvate dehydrogenase activity by phosphorylation of the E1 subunit PDHA1, and thereby regulates glucose metabolism and aerobic respiration. Can also phosphorylate PDHA2. Decreases glucose utilization and increases fat metabolism in response to prolonged fasting, and as adaptation to a high-fat diet. Plays a role in glucose homeostasis and in maintaining normal blood glucose levels in function of nutrient levels and under starvation. Plays a role in the generation of reactive oxygen species."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}