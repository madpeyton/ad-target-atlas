,"nucleus_score":-14.4344,"pct_ad":0.575906,"pct_control":0.608515,"donor_test":"not significant","donor_padj":0.849489,"donor_log2fc":-0.0404987,"donor_lfcse":0.0704499,"donor_log2fc_shrunk":-0.00548907,"degas_log2fc":0.192829,"degas_padj":1.489e-170},{"cell_type":"In","gene_symbol":"TSC2","gene_symbol_current":"TSC2","gene_id":"ENSG00000103197","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.19295e-58,"nucleus_log2fc":-0.166281,"nucleus_score":-16.2126,"pct_ad":0.381546,"pct_control":0.418572,"donor_test":"not significant","donor_padj":0.760536,"donor_log2fc":-0.0767066,"donor_lfcse":0.0624151,"donor_log2fc_shrunk":-0.00907194,"degas_log2fc":0.16653,"degas_padj":2.46252e-48},{"cell_type":"Mic","gene_symbol":"TSC2","gene_symbol_current":"TSC2","gene_id":"ENSG00000103197","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.407077,"nucleus_log2fc":-0.0820993,"nucleus_score":-1.01116,"pct_ad":0.163603,"pct_control":0.168203,"donor_test":"not significant","donor_padj":0.637347,"donor_log2fc":-0.13677,"donor_lfcse":0.097533,"donor_log2fc_shrunk":-0.0288702,"degas_log2fc":0.120548,"degas_padj":0.0497088},{"cell_type":"OPC","gene_symbol":"TSC2","gene_symbol_current":"TSC2","gene_id":"ENSG00000103197","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.321464,"nucleus_log2fc":-0.0967145,"nucleus_score":-1.33104,"pct_ad":0.27289,"pct_control":0.280948,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0697434,"donor_lfcse":0.11101,"donor_log2fc_shrunk":-5.83832e-06,"degas_log2fc":-0.242379,"degas_padj":7.19492e-06},{"cell_type":"Oli","gene_symbol":"TSC2","gene_symbol_current":"TSC2","gene_id":"ENSG00000103197","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00014435,"nucleus_log2fc":-0.0952833,"nucleus_score":-3.94991,"pct_ad":0.256275,"pct_control":0.267984,"donor_test":"not significant","donor_padj":0.940724,"donor_log2fc":-0.0407888,"donor_lfcse":0.0844278,"donor_log2fc_shrunk":-0.00576562,"degas_log2fc":-0.159734,"degas_padj":3.98695e-12}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000103197","module":"red","kme":0.157095,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000103197","module":"turquoise","kme":0.0482687,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000103197","module":"blue","kme":0.0660283,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000103197","module":"blue","kme":0.0972612,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000103197","entrez_id":["7249"],"uniprot":["P49815"],"ncbi_summary":"This gene is a tumor suppressor gene that encodes the growth inhibitory protein tuberin. Tuberin interacts with hamartin to form the TSC protein complex which functions in the control of cell growth. This TSC protein complex negatively regulates mammalian target of rapamycin complex 1 (mTORC1) signaling which is a major regulator of anabolic cell growth. Mutations in this gene have been associated with tuberous sclerosis and lymphangioleiomyomatosis. [provided by RefSeq, May 2022].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49815","text":"Catalytic component of the TSC-TBC complex, a multiprotein complex that acts as a negative regulator of the canonical mTORC1 complex, an evolutionarily conserved central nutrient sensor that stimulates anabolic reactions and macromolecule biosynthesis to promote cellular biomass generation and growth (PubMed:12172553, PubMed:12271141, PubMed:12842888, PubMed:12906785, PubMed:15340059, PubMed:22819219, PubMed:24529379, PubMed:28215400, PubMed:33436626, PubMed:35772404). Within the TSC-TBC complex, TSC2 acts as a GTPase-activating protein (GAP) for the small GTPase RHEB, a direct activator of the protein kinase activity of mTORC1 (PubMed:12172553, PubMed:12820960, PubMed:12842888, PubMed:12906785, PubMed:15340059, PubMed:22819219, PubMed:24529379, PubMed:33436626). In absence of nutrients, the TSC-TBC complex inhibits mTORC1, thereby preventing phosphorylation of ribosomal protein S6 kinase (RPS6KB1 and RPS6KB2) and EIF4EBP1 (4E-BP1) by the mTORC1 signaling (PubMed:12172553, PubMed:12271141, PubMed:12842888, PubMed:12906785, PubMed:22819219, PubMed:24529379, PubMed:28215400, PubMed:35772404). The TSC-TBC complex is inactivated in response to nutrients, relieving inhibition of mTORC1 (PubMed:12172553, PubMed:24529379). Involved in microtubule-mediated protein transport via its ability to regulate mTORC1 signaling (By similarity). Also stimulates the intrinsic GTPase activity of the Ras-related proteins RAP1A and RAB5 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}