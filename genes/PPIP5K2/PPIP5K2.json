,"donor_padj":0.999889,"donor_log2fc":0.063334,"donor_lfcse":0.0851063,"donor_log2fc_shrunk":9.16907e-06},{"cell_type":"OPC","gene_symbol":"PPIP5K2","gene_symbol_current":"PPIP5K2","gene_id":"ENSG00000145725","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.644416,"nucleus_log2fc":0.234183,"nucleus_score":0.938473,"pct_ad":0.169545,"pct_control":0.160153,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":0.184852,"donor_lfcse":0.160493,"donor_log2fc_shrunk":0.00147431},{"cell_type":"Oli","gene_symbol":"PPIP5K2","gene_symbol_current":"PPIP5K2","gene_id":"ENSG00000145725","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.944582,"donor_log2fc":-0.0477134,"donor_lfcse":0.105025,"donor_log2fc_shrunk":-0.00394586}],"modules":[{"cell_type":"In","gene_id":"ENSG00000145725","module":"brown","kme":0.30133,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000145725","entrez_id":["23262"],"uniprot":["O43314"],"ncbi_summary":"This gene encodes a member of the histidine acid phosphatase family of proteins. Despite containing a histidine acid phosphatase domain, the encoded protein functions as an inositol pyrophosphate kinase, and is thought to lack phosphatase activity. This kinase activity is the mechanism by which the encoded protein synthesizes high-energy inositol pyrophosphates, which act as signaling molecules that regulate cellular homeostasis and other processes. This gene may be associated with autism spectrum disorder in human patients. [provided by RefSeq, Sep 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43314","text":"Bifunctional inositol kinase that acts in concert with the IP6K kinases IP6K1, IP6K2 and IP6K3 to synthesize the diphosphate group-containing inositol pyrophosphates diphosphoinositol pentakisphosphate, PP-InsP5, and bis-diphosphoinositol tetrakisphosphate, (PP)2-InsP4 (PubMed:17690096, PubMed:17702752, PubMed:21222653, PubMed:29590114). PP-InsP5 and (PP)2-InsP4, also respectively called InsP7 and InsP8, regulate a variety of cellular processes, including apoptosis, vesicle trafficking, cytoskeletal dynamics, exocytosis, insulin signaling and neutrophil activation (PubMed:17690096, PubMed:17702752, PubMed:21222653, PubMed:29590114). Phosphorylates inositol hexakisphosphate (InsP6) at position 1 to produce PP-InsP5 which is in turn phosphorylated by IP6Ks to produce (PP)2-InsP4 (PubMed:17690096, PubMed:17702752). Alternatively, phosphorylates PP-InsP5 at position 1, produced by IP6Ks from InsP6, to produce (PP)2-InsP4 (PubMed:17690096, PubMed:17702752). Required for normal hearing (PubMed:29590114)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}