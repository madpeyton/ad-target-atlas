nor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"ST3GAL6","gene_symbol_current":"ST3GAL6","gene_id":"ENSG00000064225","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.216376,"nucleus_log2fc":-0.232771,"nucleus_score":-2.10304,"pct_ad":0.28022,"pct_control":0.321839,"donor_test":"not significant","donor_padj":0.986209,"donor_log2fc":-0.101535,"donor_lfcse":0.141126,"donor_log2fc_shrunk":-0.00106695},{"cell_type":"Oli","gene_symbol":"ST3GAL6","gene_symbol_current":"ST3GAL6","gene_id":"ENSG00000064225","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.0205e-05,"nucleus_log2fc":0.305156,"nucleus_score":4.82848,"pct_ad":0.115753,"pct_control":0.0928776,"donor_test":"not significant","donor_padj":0.81145,"donor_log2fc":0.185371,"donor_lfcse":0.160892,"donor_log2fc_shrunk":0.00695036}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000064225","module":"brown","kme":0.274237,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000064225","module":"brown","kme":0.198556,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000064225","module":"black","kme":0.20555,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000064225","module":"turquoise","kme":0.139208,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000064225","entrez_id":["10402"],"uniprot":["Q9Y274"],"ncbi_summary":"The protein encoded by this gene is a member of the sialyltransferase family. Members of this family are enzymes that transfer sialic acid from the activated cytidine 5'-monophospho-N-acetylneuraminic acid to terminal positions on sialylated glycolipids (gangliosides) or to the N- or O-linked sugar chains of glycoproteins. This protein has high specificity for neolactotetraosylceramide and neolactohexaosylceramide as glycolipid substrates and may contribute to the formation of selectin ligands and sialyl Lewis X, a carbohydrate important for cell-to-cell recognition and a blood group antigen. [provided by RefSeq, Apr 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y274","text":"Transfers the sialyl residue from CMP-N-acetyl-beta-neuraminate to the terminal galactose residue on sugar chains of glycoproteins and glycolipids (PubMed:10206952, PubMed:26692484). Its alpha-2,3-sialyltransferase activity is specific toward type II glycan chains (Galbeta1-4GlcNAc) on glycoproteins and glycolipids such as neolactosides nLc4Cer and nLc6Cer, whose sialyl-products serve as precursors for the Lewis X antigen (PubMed:10206952, PubMed:26692484). Critically involved in the synthesis of functional selectin ligands needed for neutrophil recruitment during inflammation and lymphocyte homing to the lymph nodes (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}