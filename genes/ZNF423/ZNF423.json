:"higher in AD","module_padj":0.851077,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000102935","module":"turquoise","kme":0.398436,"hub":false,"module_direction":"lower in AD","module_padj":0.773167,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000102935","module":"brown","kme":0.2509,"hub":false,"module_direction":"lower in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000102935"],"dataset_symbols":["ZNF423"],"explorer":"explorer.html?dataset=mathys2019#gene/ZNF423","cell_types":[{"cell_type":"Ast","gene_symbol":"ZNF423","gene_symbol_current":"ZNF423","gene_id":"ENSG00000102935","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000134048,"nucleus_log2fc":-0.521831,"nucleus_score":-4.54734,"pct_ad":0.170177,"pct_control":0.237476,"donor_test":"not significant","donor_padj":0.370861,"donor_log2fc":-0.359868,"donor_lfcse":0.130966,"donor_log2fc_shrunk":-0.213728},{"cell_type":"Ex","gene_symbol":"ZNF423","gene_symbol_current":"ZNF423","gene_id":"ENSG00000102935","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":-0.0661467,"donor_lfcse":0.122573,"donor_log2fc_shrunk":-4.22848e-06},{"cell_type":"OPC","gene_symbol":"ZNF423","gene_symbol_current":"ZNF423","gene_id":"ENSG00000102935","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.538635,"nucleus_log2fc":-0.197925,"nucleus_score":-1.18504,"pct_ad":0.11146,"pct_control":0.126437,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000102935","module":"green","kme":0.152216,"hub":false,"module_direction":"lower in AD","module_padj":0.32433,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000102935","entrez_id":["23090"],"uniprot":["Q2M1K9"],"ncbi_summary":"The protein encoded by this gene is a nuclear protein that belongs to the family of Kruppel-like C2H2 zinc finger proteins. It functions as a DNA-binding transcription factor by using distinct zinc fingers in different signaling pathways. Thus, it is thought that this gene may have multiple roles in signal transduction during development. Mutations in this gene are associated with nephronophthisis-14 and Joubert syndrome-19. Alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Oct 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q2M1K9","text":"Transcription factor that can both act as an activator or a repressor depending on the context. Plays a central role in BMP signaling and olfactory neurogenesis. Associates with SMADs in response to BMP2 leading to activate transcription of BMP target genes. Acts as a transcriptional repressor via its interaction with EBF1, a transcription factor involved in terminal olfactory receptor neurons differentiation; this interaction preventing EBF1 to bind DNA and activate olfactory-specific genes. Involved in olfactory neurogenesis by participating in a developmental switch that regulates the transition from differentiation to maturation in olfactory receptor neurons. Controls proliferation and differentiation of neural precursors in cerebellar vermis formation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}