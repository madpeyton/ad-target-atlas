:[{"cell_type":"Ast","rank":7}],"approved_drugs_status":"not tested","approved_drugs_reason":"no structure with a usable bound ligand (drug-sized, not an additive, on this protein)","screening_hits_status":"not tested","screening_hits_reason":"not in GenomeScreenDB","approved_drugs":[],"n_screening_hits":0,"top_screening_hits":[],"notes":[]}},"description":[{"gene_id":"ENSG00000078114","entrez_id":["10529"],"uniprot":["O76041"],"ncbi_summary":"This gene encodes a nebulin like protein that is abundantly expressed in cardiac muscle. The encoded protein binds actin and interacts with thin filaments and Z-line associated proteins in striated muscle. This protein may be involved in cardiac myofibril assembly. A shorter isoform of this protein termed LIM nebulette is expressed in non-muscle cells and may function as a component of focal adhesion complexes. Alternate splicing results in multiple transcript variants. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O76041","text":"Binds to actin and plays an important role in the assembly of the Z-disk. May functionally link sarcomeric actin to the desmin intermediate filaments in the heart muscle sarcomeres (PubMed:27733623). [Isoform 2]: May play a role in the assembly of focal adhesions."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":["O76041"]}