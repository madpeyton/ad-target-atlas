module":"blue","kme":0.0856707,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000167680","entrez_id":["10501"],"uniprot":["Q9H3T3"],"ncbi_summary":"This gene encodes a member of the semaphorin family, a group of proteins characterized by the presence of a conserved semaphorin (sema) domain. Whereas some semaphorins are transmembrane proteins, others are secreted. Semaphorins play a major role in axon guidance. The protein encoded by this gene may be involved in both peripheral and central nervous system development. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H3T3","text":"Functions as a cell surface repellent for mossy fibers of developing neurons in the hippocampus where it plays a role in axon guidance. May function through the PLXNA4 receptor expressed by mossy cell axons. (Microbial infection) Acts as a receptor for P.sordellii toxin TcsL in the in the vascular endothelium."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}