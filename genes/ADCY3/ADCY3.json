k":1.78702e-05},{"cell_type":"Oli","gene_symbol":"ADCY3","gene_symbol_current":"ADCY3","gene_id":"ENSG00000138031","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.766556,"donor_log2fc":-0.247114,"donor_lfcse":0.165503,"donor_log2fc_shrunk":-0.00874348}],"modules":[{"cell_type":"In","gene_id":"ENSG00000138031","module":"blue","kme":0.129586,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000138031","entrez_id":["109"],"uniprot":["O60266"],"ncbi_summary":"This gene encodes adenylyl cyclase 3 which is a membrane-associated enzyme and catalyzes the formation of the secondary messenger cyclic adenosine monophosphate (cAMP). This protein appears to be widely expressed in various human tissues and may be involved in a number of physiological and pathophysiological metabolic processes. Two transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Feb 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60266","text":"Catalyzes the formation of the signaling molecule cAMP in response to G protein signaling (PubMed:29311635). Participates in signaling cascades triggered by odorant receptors via its function in cAMP biosynthesis: specifically activated by G alpha protein GNAL/G(olf) in olfactory epithelium (By similarity). Mediates signaling cascades in primary cilia: specifically activated by G alpha protein GNAS/G(s) in primary cilia (PubMed:29311635). Plays a role in regulating food intake and body fat accumulation in the paraventricular nucleus of the hypothalamus (PVH) by acting downstream of MC4R activation (PubMed:29311635). Required for normal sperm motility and normal male fertility (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}