NSG00000183955","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":5.2532e-08,"nucleus_log2fc":0.0687886,"nucleus_score":5.49809,"pct_ad":0.454195,"pct_control":0.454656,"donor_test":"not significant","donor_padj":0.69474,"donor_log2fc":0.0877842,"donor_lfcse":0.0683815,"donor_log2fc_shrunk":0.0176746,"degas_log2fc":-0.0232705,"degas_padj":0.00565818},{"cell_type":"In","gene_symbol":"KMT5A","gene_symbol_current":"KMT5A","gene_id":"ENSG00000183955","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.840695,"nucleus_log2fc":0.0292619,"nucleus_score":0.216886,"pct_ad":0.223255,"pct_control":0.22421,"donor_test":"not significant","donor_padj":0.764982,"donor_log2fc":0.0735729,"donor_lfcse":0.0616665,"donor_log2fc_shrunk":0.0102168,"degas_log2fc":0.0214304,"degas_padj":0.187567},{"cell_type":"Mic","gene_symbol":"KMT5A","gene_symbol_current":"KMT5A","gene_id":"ENSG00000183955","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.244916,"nucleus_log2fc":0.0761858,"nucleus_score":1.37916,"pct_ad":0.188487,"pct_control":0.181106,"donor_test":"not significant","donor_padj":0.985164,"donor_log2fc":0.00859448,"donor_lfcse":0.0880213,"donor_log2fc_shrunk":0.00189683,"degas_log2fc":0.0394978,"degas_padj":0.535946},{"cell_type":"OPC","gene_symbol":"KMT5A","gene_symbol_current":"KMT5A","gene_id":"ENSG00000183955","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.406785,"nucleus_log2fc":0.0993524,"nucleus_score":1.13686,"pct_ad":0.195944,"pct_control":0.188992,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0198939,"donor_lfcse":0.0695159,"donor_log2fc_shrunk":4.30352e-06,"degas_log2fc":-0.155429,"degas_padj":0.0194681},{"cell_type":"Oli","gene_symbol":"KMT5A","gene_symbol_current":"KMT5A","gene_id":"ENSG00000183955","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.00101e-05,"nucleus_log2fc":0.147381,"nucleus_score":4.57153,"pct_ad":0.148156,"pct_control":0.136254,"donor_test":"not significant","donor_padj":0.690954,"donor_log2fc":0.112961,"donor_lfcse":0.0686175,"donor_log2fc_shrunk":0.026933,"degas_log2fc":-0.0307755,"degas_padj":0.342607}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000183955","module":"turquoise","kme":0.0170059,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000183955","entrez_id":["387893"],"uniprot":["Q9NQR1"],"ncbi_summary":"The protein encoded by this gene is a protein-lysine N-methyltransferase that can monomethylate Lys-20 of histone H4 to effect transcriptional repression of some genes. The encoded protein is required for cell proliferation and plays a role in chromatin condensation. [provided by RefSeq, May 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NQR1","text":"Protein-lysine N-methyltransferase that monomethylates both histones and non-histone proteins (PubMed:12086618, PubMed:12121615, PubMed:15964846, PubMed:17707234, PubMed:27338793). Specifically monomethylates 'Lys-20' of histone H4 (H4K20me1) (PubMed:12086618, PubMed:12121615, PubMed:15200950, PubMed:15933069, PubMed:15933070, PubMed:15964846, PubMed:16517599, PubMed:27338793). H4K20me1 is enriched during mitosis and represents a specific tag for epigenetic transcriptional repression (PubMed:12086618, PubMed:12121615, PubMed:15200950, PubMed:15933069, PubMed:15933070, PubMed:15964846, PubMed:16517599). Mainly functions in euchromatin regions, thereby playing a central role in the silencing of euchromatic genes (PubMed:12086618, PubMed:12121615, PubMed:15200950, PubMed:15933069, PubMed:15933070, PubMed:15964846, PubMed:16517599). Required for cell proliferation, probably by contributing to the maintenance of proper higher-order structure of DNA during mitosis (PubMed:12086618, PubMed:12121615, PubMed:15200950, PubMed:15933069, PubMed:15933070, PubMed:15964846, PubMed:16517599). Involved in chromosome condensation and proper cytokinesis (PubMed:12086618, PubMed:12121615, PubMed:15200950, PubMed:15933069, PubMed:15933070, PubMed:15964846, PubMed:16517599). Nucleosomes are preferred as substrate compared to free histones (PubMed:12086618, PubMed:12121615, PubMed:15200950, PubMed:15933069, PubMed:15933070, PubMed:15964846, PubMed:16517599). Mediates monomethylation of p53/TP53 at 'Lys-382', leading to repress p53/TP53-target genes (PubMed:17707234). Plays a negative role in TGF-beta response regulation and a positive role in cell migration (PubMed:23478445)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}