s_score":2.89241,"pct_ad":0.498691,"pct_control":0.482137,"donor_test":"not significant","donor_padj":0.919824,"donor_log2fc":0.00988968,"donor_lfcse":0.0388693,"donor_log2fc_shrunk":0.00465781},{"cell_type":"Inhibitory","gene_symbol":"HEXA","gene_symbol_current":"HEXA","gene_id":"ENSG00000213614","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.130167,"nucleus_log2fc":0.00231036,"nucleus_score":1.76836,"pct_ad":0.349462,"pct_control":0.339387,"donor_test":"not significant","donor_padj":0.924068,"donor_log2fc":-0.010249,"donor_lfcse":0.0358196,"donor_log2fc_shrunk":-0.00406047},{"cell_type":"Microglia","gene_symbol":"HEXA","gene_symbol_current":"HEXA","gene_id":"ENSG00000213614","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":4.39808e-19,"nucleus_log2fc":0.310524,"nucleus_score":9.28138,"pct_ad":0.28203,"pct_control":0.230502,"donor_test":"not significant","donor_padj":0.120851,"donor_log2fc":0.191481,"donor_lfcse":0.0625467,"donor_log2fc_shrunk":0.142342},{"cell_type":"Oligodendroglia","gene_symbol":"HEXA","gene_symbol_current":"HEXA","gene_id":"ENSG00000213614","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000130631,"nucleus_log2fc":0.0345684,"nucleus_score":3.89914,"pct_ad":0.14987,"pct_control":0.141428,"donor_test":"not significant","donor_padj":0.963416,"donor_log2fc":-0.00329498,"donor_lfcse":0.0347693,"donor_log2fc_shrunk":-0.00213603},{"cell_type":"Vascular.niche","gene_symbol":"HEXA","gene_symbol_current":"HEXA","gene_id":"ENSG00000213614","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.482343,"nucleus_log2fc":0.124757,"nucleus_score":1.1552,"pct_ad":0.156351,"pct_control":0.146758,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"Microglia","gene_id":"ENSG00000213614","module":"blue","kme":0.127965,"hub":false,"module_direction":"higher in AD","module_padj":0.554841,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000213614","entrez_id":["3073"],"uniprot":["P06865"],"ncbi_summary":"This gene encodes a member of the glycosyl hydrolase 20 family of proteins. The encoded preproprotein is proteolytically processed to generate the alpha subunit of the lysosomal enzyme beta-hexosaminidase. This enzyme, together with the cofactor GM2 activator protein, catalyzes the degradation of the ganglioside GM2, and other molecules containing terminal N-acetyl hexosamines. Mutations in this gene lead to an accumulation of GM2 ganglioside in neurons, the underlying cause of neurodegenerative disorders termed the GM2 gangliosidoses, including Tay-Sachs disease (GM2-gangliosidosis type I). Alternative splicing results in multiple transcript variants, at least one of which encodes a preproprotein that is proteolytically processed. [provided by RefSeq, Jan 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P06865","text":"Hydrolyzes the non-reducing end N-acetyl-D-hexosamine and/or sulfated N-acetyl-D-hexosamine of glycoconjugates, such as the oligosaccharide moieties from proteins and neutral glycolipids, or from certain mucopolysaccharides (PubMed:11707436, PubMed:16698036, PubMed:8123671, PubMed:8672428, PubMed:9694901). The isozyme S is as active as the isozyme A on the anionic bis-sulfated glycans, the chondroitin-6-sulfate trisaccharide (C6S-3), and the dermatan sulfate pentasaccharide, and the sulfated glycosphingolipid SM2 (PubMed:11707436). The isozyme B does not hydrolyze each of these substrates, however hydrolyzes efficiently neutral oligosaccharide (PubMed:11707436). Only the isozyme A is responsible for the degradation of GM2 gangliosides in the presence of GM2A (PubMed:8123671, PubMed:8672428, PubMed:9694901)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}