st":"not significant","donor_padj":0.703098,"donor_log2fc":0.118522,"donor_lfcse":0.098355,"donor_log2fc_shrunk":0.0237073},{"cell_type":"OPC","gene_symbol":"HEXA","gene_symbol_current":"HEXA","gene_id":"ENSG00000213614","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.166743,"nucleus_log2fc":-0.0971372,"nucleus_score":-1.78583,"pct_ad":0.327617,"pct_control":0.338527,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0470083,"donor_lfcse":0.0693751,"donor_log2fc_shrunk":-1.00617e-05},{"cell_type":"Oli","gene_symbol":"HEXA","gene_symbol_current":"HEXA","gene_id":"ENSG00000213614","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":8.66657e-13,"nucleus_log2fc":-0.15351,"nucleus_score":-7.31052,"pct_ad":0.268523,"pct_control":0.292514,"donor_test":"not significant","donor_padj":0.718735,"donor_log2fc":-0.125493,"donor_lfcse":0.0816541,"donor_log2fc_shrunk":-0.0209019}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000213614","module":"blue","kme":0.12508,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000213614","entrez_id":["3073"],"uniprot":["P06865"],"ncbi_summary":"This gene encodes a member of the glycosyl hydrolase 20 family of proteins. The encoded preproprotein is proteolytically processed to generate the alpha subunit of the lysosomal enzyme beta-hexosaminidase. This enzyme, together with the cofactor GM2 activator protein, catalyzes the degradation of the ganglioside GM2, and other molecules containing terminal N-acetyl hexosamines. Mutations in this gene lead to an accumulation of GM2 ganglioside in neurons, the underlying cause of neurodegenerative disorders termed the GM2 gangliosidoses, including Tay-Sachs disease (GM2-gangliosidosis type I). Alternative splicing results in multiple transcript variants, at least one of which encodes a preproprotein that is proteolytically processed. [provided by RefSeq, Jan 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P06865","text":"Hydrolyzes the non-reducing end N-acetyl-D-hexosamine and/or sulfated N-acetyl-D-hexosamine of glycoconjugates, such as the oligosaccharide moieties from proteins and neutral glycolipids, or from certain mucopolysaccharides (PubMed:11707436, PubMed:16698036, PubMed:8123671, PubMed:8672428, PubMed:9694901). The isozyme S is as active as the isozyme A on the anionic bis-sulfated glycans, the chondroitin-6-sulfate trisaccharide (C6S-3), and the dermatan sulfate pentasaccharide, and the sulfated glycosphingolipid SM2 (PubMed:11707436). The isozyme B does not hydrolyze each of these substrates, however hydrolyzes efficiently neutral oligosaccharide (PubMed:11707436). Only the isozyme A is responsible for the degradation of GM2 gangliosides in the presence of GM2A (PubMed:8123671, PubMed:8672428, PubMed:9694901)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}