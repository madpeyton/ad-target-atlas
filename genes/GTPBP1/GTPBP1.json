rquoise","kme":0.128201,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000100226"],"dataset_symbols":["GTPBP1"],"explorer":"explorer.html?dataset=mathys2019#gene/GTPBP1","cell_types":[{"cell_type":"Ex","gene_symbol":"GTPBP1","gene_symbol_current":"GTPBP1","gene_id":"ENSG00000100226","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0421583,"nucleus_log2fc":-0.103658,"nucleus_score":-2.25194,"pct_ad":0.121191,"pct_control":0.131281,"donor_test":"not significant","donor_padj":0.999956,"donor_log2fc":0.00016966,"donor_lfcse":0.126767,"donor_log2fc_shrunk":1.74977e-08},{"cell_type":"Oli","gene_symbol":"GTPBP1","gene_symbol_current":"GTPBP1","gene_id":"ENSG00000100226","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.864182,"donor_log2fc":0.132554,"donor_lfcse":0.138828,"donor_log2fc_shrunk":0.00656361}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100226","entrez_id":["9567"],"uniprot":["O00178"],"ncbi_summary":"This gene is upregulated by interferon-gamma and encodes a protein that is a member of the AGP11/GTPBP1 family of GTP-binding proteins. A structurally similar protein has been found in mouse, where disruption of the gene for that protein had no observable phenotype. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00178","text":"GTPase that plays a role in the elongation phase of protein synthesis by forming ternary complexes with GTP and aminoacyl-transfer RNAs (aa-tRNAs), and delivering aa-tRNAs to the ribosomal A site in a GTP-dependent manner (PubMed:30108131). Is also able to deliver deacylated tRNA to the A site (PubMed:30108131). Additionally, it is involved in RNA quality control; after GTP hydrolysis, which is not immediately followed by rapid peptide bond formation, GTPBP1 likely retains aa-tRNA in the A site and promotes exosomal degradation of faulty mRNAs engaged in 80S elongation complexes (PubMed:30108131). Plays a role in the regulation of circadian mRNA stability (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}