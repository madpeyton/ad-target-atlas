":0.104215,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"AGPAT3","gene_symbol_current":"AGPAT3","gene_id":"ENSG00000160216","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.829491,"donor_log2fc":0.127451,"donor_lfcse":0.115441,"donor_log2fc_shrunk":0.0091554}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000160216","module":"yellow","kme":0.123367,"hub":false,"module_direction":"lower in AD","module_padj":0.56571,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000160216","module":"brown","kme":0.151323,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000160216","module":"red","kme":0.103644,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000160216","entrez_id":["56894"],"uniprot":["Q9NRZ7"],"ncbi_summary":"The protein encoded by this gene is an acyltransferase that converts lysophosphatidic acid into phosphatidic acid, which is the second step in the de novo phospholipid biosynthetic pathway. The encoded protein may be an integral membrane protein. Two transcript variants encoding the same protein have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NRZ7","text":"Converts 1-acyl-sn-glycerol-3-phosphate (lysophosphatidic acid or LPA) into 1,2-diacyl-sn-glycerol-3-phosphate (phosphatidic acid or PA) by incorporating an acyl moiety at the sn-2 position of the glycerol backbone (PubMed:21173190). Acts on LPA containing saturated or unsaturated fatty acids C16:0-C20:4 at the sn-1 position using C18:1, C20:4 or C18:2-CoA as the acyl donor (PubMed:21173190). Also acts on lysophosphatidylcholine, lysophosphatidylinositol and lysophosphatidylserine using C18:1 or C20:4-CoA (PubMed:21173190). Has a preference for arachidonoyl-CoA as a donor (By similarity). Also has a modest lysophosphatidylinositol acyltransferase (LPIAT) activity, converts lysophosphatidylinositol (LPI) into phosphatidylinositol (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}