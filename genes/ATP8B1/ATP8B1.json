rocytes","gene_id":"ENSG00000081923","module":"brown","kme":0.197655,"hub":false,"module_direction":"lower in AD","module_padj":0.833818,"module_significant":false},{"cell_type":"CUX2+","gene_id":"ENSG00000081923","module":"brown","kme":0.390843,"hub":false,"module_direction":"lower in AD","module_padj":0.923266,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000081923","module":"yellow","kme":0.161327,"hub":false,"module_direction":"lower in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000081923","module":"brown","kme":0.148555,"hub":false,"module_direction":"lower in AD","module_padj":0.199655,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000081923"],"dataset_symbols":["ATP8B1"],"explorer":"explorer.html?dataset=mathys2019#gene/ATP8B1","cell_types":[{"cell_type":"Ex","gene_symbol":"ATP8B1","gene_symbol_current":"ATP8B1","gene_id":"ENSG00000081923","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":4.4045e-06,"nucleus_log2fc":-0.146866,"nucleus_score":-4.91559,"pct_ad":0.318163,"pct_control":0.352528,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.124382,"donor_lfcse":0.106974,"donor_log2fc_shrunk":-1.12953e-05},{"cell_type":"OPC","gene_symbol":"ATP8B1","gene_symbol_current":"ATP8B1","gene_id":"ENSG00000081923","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.065049,"nucleus_log2fc":-0.577212,"nucleus_score":-2.94732,"pct_ad":0.0698587,"pct_control":0.102682,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000081923","module":"tan","kme":0.190221,"hub":false,"module_direction":"lower in AD","module_padj":0.333899,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000081923","module":"brown","kme":0.300133,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000081923","module":"turquoise","kme":0.152064,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000081923","entrez_id":["5205"],"uniprot":["O43520"],"ncbi_summary":"This gene encodes a member of the P-type cation transport ATPase family, which belongs to the subfamily of aminophospholipid-transporting ATPases. The aminophospholipid translocases transport phosphatidylserine and phosphatidylethanolamine from one side of a bilayer to another. Mutations in this gene may result in progressive familial intrahepatic cholestasis type 1 and in benign recurrent intrahepatic cholestasis. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43520","text":"Catalytic component of a P4-ATPase flippase complex which catalyzes the hydrolysis of ATP coupled to the transport of phospholipids, in particular phosphatidylcholines (PC), from the outer to the inner leaflet of the plasma membrane (PubMed:17948906, PubMed:25315773). May participate in the establishment of the canalicular membrane integrity by ensuring asymmetric distribution of phospholipids in the canicular membrane (By similarity). Thus may have a role in the regulation of bile acids transport into the canaliculus, uptake of bile acids from intestinal contents into intestinal mucosa or both and protect hepatocytes from bile salts (By similarity). Involved in the microvillus formation in polarized epithelial cells; the function seems to be independent from its flippase activity (PubMed:20512993). Participates in correct apical membrane localization of CDC42, CFTR and SLC10A2 (PubMed:25239307, PubMed:27301931). Enables CDC42 clustering at the apical membrane during enterocyte polarization through the interaction between CDC42 polybasic region and negatively charged membrane lipids provided by ATP8B1 (By similarity). Together with CDC50A is involved in uptake of the synthetic drug alkylphospholipid perifosine (PubMed:20510206). Required for the preservation of cochlear hair cells in the inner ear (By similarity). May act as cardiolipin transporter during inflammatory injury (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}