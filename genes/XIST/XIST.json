pes":[{"cell_type":"Astrocytes","rank":4},{"cell_type":"CUX2+","rank":1},{"cell_type":"CUX2-","rank":1},{"cell_type":"Inhibitory","rank":1},{"cell_type":"Microglia","rank":8},{"cell_type":"Oligodendroglia","rank":1},{"cell_type":"Vascular.niche","rank":3}],"approved_drugs_status":"not tested","approved_drugs_reason":"gene encodes no protein (non-coding RNA); not a structure-based target","screening_hits_status":"not tested","screening_hits_reason":"gene encodes no protein (non-coding RNA); not a structure-based target","approved_drugs":[],"n_screening_hits":0,"top_screening_hits":[],"notes":[]}},"description":[{"gene_id":"ENSG00000229807","entrez_id":["7503"],"uniprot":[],"ncbi_summary":"X inactivation is an early developmental process in mammalian females that transcriptionally silences one of the pair of X chromosomes, thus providing dosage equivalence between males and females. The process is regulated by several factors, including a region of chromosome X called the X inactivation center (XIC). The XIC comprises several non-coding and protein-coding genes, and this gene was the first non-coding gene identified within the XIC. This gene is expressed exclusively from the XIC of the inactive X chromosome, and is essential for the initiation and spread of X-inactivation. The transcript is a spliced RNA. Alternatively spliced transcript variants have been identified, but their full length sequences have not been determined. Mutations in the XIST promoter cause familial skewed X inactivation. [provided by RefSeq, Apr 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}