e":-13.0767,"pct_ad":0.713444,"pct_control":0.733683,"donor_test":"not significant","donor_padj":0.900975,"donor_log2fc":-0.0264225,"donor_lfcse":0.0558216,"donor_log2fc_shrunk":-0.00681566},{"cell_type":"Mic","gene_symbol":"KLHDC10","gene_symbol_current":"KLHDC10","gene_id":"ENSG00000128607","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.244059,"nucleus_log2fc":0.0506092,"nucleus_score":1.38173,"pct_ad":0.360724,"pct_control":0.351728,"donor_test":"not significant","donor_padj":0.977962,"donor_log2fc":0.01219,"donor_lfcse":0.0750931,"donor_log2fc_shrunk":0.00338061},{"cell_type":"OPC","gene_symbol":"KLHDC10","gene_symbol_current":"KLHDC10","gene_id":"ENSG00000128607","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00705292,"nucleus_log2fc":-0.12719,"nucleus_score":-3.19099,"pct_ad":0.488369,"pct_control":0.510415,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.146043,"donor_lfcse":0.0740829,"donor_log2fc_shrunk":-2.77854e-05},{"cell_type":"Oli","gene_symbol":"KLHDC10","gene_symbol_current":"KLHDC10","gene_id":"ENSG00000128607","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":4.31451e-06,"nucleus_log2fc":-0.0742024,"nucleus_score":-4.75101,"pct_ad":0.283775,"pct_control":0.303389,"donor_test":"not significant","donor_padj":0.867581,"donor_log2fc":-0.0657008,"donor_lfcse":0.0718113,"donor_log2fc_shrunk":-0.0117472}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000128607","module":"blue","kme":0.11256,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000128607","entrez_id":["23008"],"uniprot":["Q6PID8"],"ncbi_summary":"Enables ubiquitin ligase-substrate adaptor activity. Involved in ubiquitin-dependent protein catabolic process via the C-end degron rule pathway. Located in nucleoplasm. Is active in Cul2-RING ubiquitin ligase complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6PID8","text":"Substrate-recognition component of a Cul2-RING (CRL2) E3 ubiquitin-protein ligase complex of the DesCEND (destruction via C-end degrons) pathway, which recognizes a C-degron located at the extreme C-terminus of target proteins, leading to their ubiquitination and degradation (PubMed:29779948, PubMed:33909987). The C-degron recognized by the DesCEND pathway is usually a motif of less than ten residues and can be present in full-length proteins, truncated proteins or proteolytically cleaved forms (PubMed:29779948, PubMed:33909987, PubMed:39548056). The CRL2(KLHDC10) complex specifically recognizes proteins with a proline-glycine (Pro-Gly) or an alanine tail (CAT tail) at the C-terminus, leading to their ubiquitination and degradation (PubMed:29779948, PubMed:33909987). The CRL2(KLHDC10) complex is involved in the ribosome-associated quality control (RQC) pathway, which mediates the extraction of incompletely synthesized nascent chains from stalled ribosomes: CRL2(KLHDC10) acts downstream of NEMF and recognizes CAT tails associated with stalled nascent chains, leading to their ubiquitination and degradation (PubMed:33909987). Participates in the oxidative stress-induced cell death through MAP3K5 activation (PubMed:23102700). Inhibits PPP5C phosphatase activity on MAP3K5 (PubMed:23102700). Acts as a regulator of necroptosis (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}