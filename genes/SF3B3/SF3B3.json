alse,"nucleus_direction":"lower in AD","nucleus_padj":0.914961,"nucleus_log2fc":-0.00377924,"nucleus_score":-0.146142,"pct_ad":0.287094,"pct_control":0.288479,"donor_test":"not significant","donor_padj":0.991976,"donor_log2fc":-0.00534406,"donor_lfcse":0.0906415,"donor_log2fc_shrunk":-0.00107792},{"cell_type":"OPC","gene_symbol":"SF3B3","gene_symbol_current":"SF3B3","gene_id":"ENSG00000189091","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.561272,"nucleus_log2fc":-0.0567391,"nucleus_score":-0.830091,"pct_ad":0.315538,"pct_control":0.318374,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0468549,"donor_lfcse":0.0655684,"donor_log2fc_shrunk":-1.13047e-05},{"cell_type":"Oli","gene_symbol":"SF3B3","gene_symbol_current":"SF3B3","gene_id":"ENSG00000189091","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.47367,"nucleus_log2fc":-0.00621151,"nucleus_score":-0.797841,"pct_ad":0.222335,"pct_control":0.225413,"donor_test":"not significant","donor_padj":0.986258,"donor_log2fc":-0.00625149,"donor_lfcse":0.058345,"donor_log2fc_shrunk":-0.00158535}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000189091","module":"blue","kme":0.152112,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000189091","entrez_id":["23450"],"uniprot":["Q15393"],"ncbi_summary":"This gene encodes subunit 3 of the splicing factor 3b protein complex. Splicing factor 3b, together with splicing factor 3a and a 12S RNA unit, forms the U2 small nuclear ribonucleoproteins complex (U2 snRNP). The splicing factor 3b/3a complex binds pre-mRNA upstream of the intron's branch site in a sequence independent manner and may anchor the U2 snRNP to the pre-mRNA. Splicing factor 3b is also a component of the minor U12-type spliceosome. Subunit 3 has also been identified as a component of the STAGA (SPT3-TAF(II)31-GCN5L acetylase) transcription coactivator-HAT (histone acetyltransferase) complex, and the TFTC (TATA-binding-protein-free TAF(II)-containing complex). These complexes may function in chromatin modification, transcription, splicing, and DNA repair. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15393","text":"Component of the 17S U2 SnRNP complex of the spliceosome, a large ribonucleoprotein complex that removes introns from transcribed pre-mRNAs (PubMed:10490618, PubMed:10882114, PubMed:12234937, PubMed:27720643, PubMed:28781166, PubMed:32494006, PubMed:34822310). The 17S U2 SnRNP complex (1) directly participates in early spliceosome assembly and (2) mediates recognition of the intron branch site during pre-mRNA splicing by promoting the selection of the pre-mRNA branch-site adenosine, the nucleophile for the first step of splicing (PubMed:12234937, PubMed:32494006, PubMed:34822310). Within the 17S U2 SnRNP complex, SF3B3 is part of the SF3B subcomplex, which is required for 'A' complex assembly formed by the stable binding of U2 snRNP to the branchpoint sequence in pre-mRNA (PubMed:12234937, PubMed:27720643). Sequence independent binding of SF3A and SF3B subcomplexes upstream of the branch site is essential, it may anchor U2 snRNP to the pre-mRNA (PubMed:12234937). May also be involved in the assembly of the 'E' complex (PubMed:10882114). Also acts as a component of the minor spliceosome, which is involved in the splicing of U12-type introns in pre-mRNAs (PubMed:15146077, PubMed:33509932)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}