ys et al. 2019","gene_ids":["ENSG00000172172"],"dataset_symbols":["MRPL13"],"explorer":"explorer.html?dataset=mathys2019#gene/MRPL13","cell_types":[{"cell_type":"Ex","gene_symbol":"MRPL13","gene_symbol_current":"MRPL13","gene_id":"ENSG00000172172","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0482576,"nucleus_log2fc":-0.0816977,"nucleus_score":-2.19221,"pct_ad":0.127387,"pct_control":0.137582,"donor_test":"not significant","donor_padj":0.998051,"donor_log2fc":0.00820037,"donor_lfcse":0.109871,"donor_log2fc_shrunk":7.1991e-07}],"modules":[{"cell_type":"In","gene_id":"ENSG00000172172","module":"turquoise","kme":0.161178,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000172172","entrez_id":["28998"],"uniprot":["Q9BYD1"],"ncbi_summary":"Mammalian mitochondrial ribosomal proteins are encoded by nuclear genes and help in protein synthesis within the mitochondrion. Mitochondrial ribosomes (mitoribosomes) consist of a small 28S subunit and a large 39S subunit. They have an estimated 75% protein to rRNA composition compared to prokaryotic ribosomes, where this ratio is reversed. Another difference between mammalian mitoribosomes and prokaryotic ribosomes is that the latter contain a 5S rRNA. Among different species, the proteins comprising the mitoribosome differ greatly in sequence, and sometimes in biochemical properties, which prevents easy recognition by sequence homology. This gene encodes a 39S subunit protein. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}