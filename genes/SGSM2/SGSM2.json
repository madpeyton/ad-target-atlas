ule_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000141258","entrez_id":["9905"],"uniprot":["O43147"],"ncbi_summary":"The protein encoded by this gene is a GTPase activator with activity towards RAB32 and RAB33B, which are regulators of membrane trafficking. The encoded protein inactivates RAB32 and can bind RAB9A-GTP, a protein required for RAB32 activation. [provided by RefSeq, Oct 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43147","text":"Possesses GTPase activator activity towards RAB32, RAB33B and RAB38 (PubMed:21808068, PubMed:26620560). Regulates the trafficking of melanogenic enzymes TYR, TYRP1 and DCT/TYRP2 to melanosomes in melanocytes by inactivating RAB32 and RAB38. Inhibits RAB32 and RAB38 activation both directly by promoting their GTPase activity and indirectly by disrupting the RAB9A-HPS4 interaction which is required for RAB32/38 activation (PubMed:26620560)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}