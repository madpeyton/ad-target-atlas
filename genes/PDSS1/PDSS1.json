mbols":["PDSS1"],"explorer":"explorer.html?dataset=mathys2019#gene/PDSS1","cell_types":[{"cell_type":"Ex","gene_symbol":"PDSS1","gene_symbol_current":"PDSS1","gene_id":"ENSG00000148459","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.36972e-06,"nucleus_log2fc":-0.251837,"nucleus_score":-5.16038,"pct_ad":0.128708,"pct_control":0.152895,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.165084,"donor_lfcse":0.118587,"donor_log2fc_shrunk":-1.23057e-05},{"cell_type":"In","gene_symbol":"PDSS1","gene_symbol_current":"PDSS1","gene_id":"ENSG00000148459","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.460414,"nucleus_log2fc":-0.18466,"nucleus_score":-1.5851,"pct_ad":0.140639,"pct_control":0.154995,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0885896,"donor_lfcse":0.148238,"donor_log2fc_shrunk":-4.20316e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000148459","module":"black","kme":0.216832,"hub":false,"module_direction":"lower in AD","module_padj":0.234072,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000148459","entrez_id":["23590"],"uniprot":["Q5T2R2"],"ncbi_summary":"The protein encoded by this gene is an enzyme that elongates the prenyl side-chain of coenzyme Q, or ubiquinone, one of the key elements in the respiratory chain. The gene product catalyzes the formation of all trans-polyprenyl pyrophosphates from isopentyl diphosphate in the assembly of polyisoprenoid side chains, the first step in coenzyme Q biosynthesis. The protein may be peripherally associated with the inner mitochondrial membrane, though no transit peptide has been definitively identified to date. Defects in this gene are a cause of coenzyme Q10 deficiency. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5T2R2","text":"Heterotetrameric enzyme that catalyzes the condensation of farnesyl diphosphate (FPP), which acts as a primer, and isopentenyl diphosphate (IPP) to produce prenyl diphosphates of varying chain lengths and participates in the determination of the side chain of ubiquinone (PubMed:16262699). Supplies nona and decaprenyl diphosphate, the precursors for the side chain of the isoprenoid quinones ubiquinone-9 (Q9)and ubiquinone-10 (Q10) respectively (PubMed:16262699). The enzyme adds isopentenyl diphosphate molecules sequentially to farnesyl diphosphate with trans stereochemistry (PubMed:16262699)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}