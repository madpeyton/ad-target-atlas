,"pct_control":0.0955069,"donor_test":"not significant","donor_padj":0.58144,"donor_log2fc":0.182891,"donor_lfcse":0.117296,"donor_log2fc_shrunk":0.0289466,"degas_log2fc":-0.0603017,"degas_padj":0.474789},{"cell_type":"OPC","gene_symbol":"TRUB1","gene_symbol_current":"TRUB1","gene_id":"ENSG00000165832","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0148494,"nucleus_log2fc":0.199893,"nucleus_score":2.9173,"pct_ad":0.248583,"pct_control":0.229467,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0901521,"donor_lfcse":0.0825368,"donor_log2fc_shrunk":1.38177e-05,"degas_log2fc":-0.338136,"degas_padj":4.42993e-09},{"cell_type":"Oli","gene_symbol":"TRUB1","gene_symbol_current":"TRUB1","gene_id":"ENSG00000165832","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.779912,"nucleus_log2fc":0.0352297,"nucleus_score":0.324275,"pct_ad":0.114417,"pct_control":0.113943,"donor_test":"not significant","donor_padj":0.973523,"donor_log2fc":0.0200794,"donor_lfcse":0.0918438,"donor_log2fc_shrunk":0.00231632,"degas_log2fc":-0.194254,"degas_padj":3.50572e-08}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165832","entrez_id":["142940"],"uniprot":["Q8WWH5"],"ncbi_summary":"Pseudouridine is an abundant component of rRNAs and tRNAs and is enzymatically generated by isomerization of uridine by pseudouridine synthase (Zucchini et al., 2003 [PubMed 12736709]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WWH5","text":"Pseudouridine synthase that catalyzes pseudouridylation of mRNAs and tRNAs (PubMed:28073919, PubMed:31477916, PubMed:32926445). Mediates pseudouridylation of mRNAs with the consensus sequence 5'-GUUCNANNC-3', harboring a stem-loop structure (PubMed:28073919, PubMed:31477916). Constitutes the major pseudouridine synthase acting on mRNAs (PubMed:28073919). Also catalyzes pseudouridylation of some tRNAs, including synthesis of pseudouridine(55) from uracil-55, in the psi GC loop of a subset of tRNAs (PubMed:32926445, PubMed:33023933). Promotes the processing of pri-let-7 microRNAs (pri-miRNAs) independently of its RNA pseudouridylate synthase activity (PubMed:32926445). Acts by binding to the stem-loop structure on pri-let-7, preventing LIN28-binding (LIN28A and/or LIN28B), thereby enhancing the interaction between pri-let-7 and the microprocessor DGCR8, which mediates miRNA maturation (PubMed:32926445)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}