_padj":0.779353,"donor_log2fc":0.178718,"donor_lfcse":0.184901,"donor_log2fc_shrunk":0.010875,"degas_log2fc":-0.0779624,"degas_padj":0.338055},{"cell_type":"OPC","gene_symbol":"GPSM2","gene_symbol_current":"GPSM2","gene_id":"ENSG00000121957","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.167844,"nucleus_log2fc":-0.0451419,"nucleus_score":-1.78182,"pct_ad":0.796898,"pct_control":0.800677,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0478534,"donor_lfcse":0.0612103,"donor_log2fc_shrunk":-1.3427e-05,"degas_log2fc":0.00575062,"degas_padj":0.846039},{"cell_type":"Oli","gene_symbol":"GPSM2","gene_symbol_current":"GPSM2","gene_id":"ENSG00000121957","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.507943,"nucleus_log2fc":-0.0115944,"nucleus_score":-0.739464,"pct_ad":0.590832,"pct_control":0.596774,"donor_test":"not significant","donor_padj":0.984245,"donor_log2fc":-0.00834393,"donor_lfcse":0.0638717,"donor_log2fc_shrunk":-0.00164336,"degas_log2fc":-0.0498542,"degas_padj":0.000956116}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000121957","module":"turquoise","kme":0.258427,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000121957","module":"turquoise","kme":0.483134,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000121957","module":"turquoise","kme":0.440233,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000121957","module":"turquoise","kme":0.0502931,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000121957","module":"turquoise","kme":0.0961267,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000121957","entrez_id":["29899"],"uniprot":["P81274"],"ncbi_summary":"The protein encoded by this gene belongs to a family of proteins that modulate activation of G proteins, which transduce extracellular signals received by cell surface receptors into integrated cellular responses. The N-terminal half of this protein contains 10 copies of leu-gly-asn (LGN) repeat, and the C-terminal half contains 4 GoLoco motifs, which are involved in guanine nucleotide exchange. This protein may play a role in neuroblast division and in the development of normal hearing. Mutations in this gene are associated with autosomal recessive nonsyndromic deafness (DFNB82). Alternative splicing results in multiple transcript variants. [provided by RefSeq, Mar 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P81274","text":"Plays an important role in mitotic spindle pole organization via its interaction with NUMA1 (PubMed:11781568, PubMed:15632202, PubMed:21816348). Required for cortical dynein-dynactin complex recruitment during metaphase (PubMed:22327364). Plays a role in metaphase spindle orientation (PubMed:22327364). Also plays an important role in asymmetric cell divisions (PubMed:21816348). Has guanine nucleotide dissociation inhibitor (GDI) activity towards G(i) alpha proteins, such as GNAI1 and GNAI3, and thereby regulates their activity (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}