se","kme":0.11727,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000056050"],"dataset_symbols":["C4orf27"],"explorer":"explorer.html?dataset=mathys2019#gene/C4orf27","cell_types":[{"cell_type":"Ex","gene_symbol":"C4orf27","gene_symbol_current":"HPF1","gene_id":"ENSG00000056050","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.146147,"nucleus_log2fc":-0.0292207,"nucleus_score":-1.64098,"pct_ad":0.223791,"pct_control":0.234328,"donor_test":"not significant","donor_padj":0.992535,"donor_log2fc":0.0353359,"donor_lfcse":0.111703,"donor_log2fc_shrunk":2.9786e-06},{"cell_type":"In","gene_symbol":"C4orf27","gene_symbol_current":"HPF1","gene_id":"ENSG00000056050","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.257424,"nucleus_log2fc":-0.297239,"nucleus_score":-2.13884,"pct_ad":0.139752,"pct_control":0.158108,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.214834,"donor_lfcse":0.191008,"donor_log2fc_shrunk":-6.26075e-06},{"cell_type":"Oli","gene_symbol":"C4orf27","gene_symbol_current":"HPF1","gene_id":"ENSG00000056050","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.942097,"donor_log2fc":-0.0589177,"donor_lfcse":0.118752,"donor_log2fc_shrunk":-0.0038317}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000056050","module":"turquoise","kme":0.225241,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000056050","module":"turquoise","kme":0.206739,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000056050","module":"brown","kme":0.118642,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000056050","entrez_id":["54969"],"uniprot":["Q9NWY4"],"ncbi_summary":"Enables chromatin binding activity and histone binding activity. Involved in double-strand break repair; peptidyl-serine ADP-ribosylation; and regulation of protein modification process. Located in chromatin; nucleus; and site of DNA damage. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NWY4","text":"Cofactor for serine ADP-ribosylation that confers serine specificity on PARP1 and PARP2 and plays a key role in DNA damage response (PubMed:28190768, PubMed:29480802, PubMed:29954836, PubMed:32028527, PubMed:32939087, PubMed:33186521, PubMed:33589610, PubMed:33683197, PubMed:34108479, PubMed:34210965, PubMed:34486521, PubMed:34625544, PubMed:34732825, PubMed:34795260, PubMed:34874266). Initiates the repair of double-strand DNA breaks: recruited to DNA damage sites by PARP1 and PARP2 and switches the amino acid specificity of PARP1 and PARP2 from aspartate or glutamate to serine residues, licensing serine ADP-ribosylation of target proteins (PubMed:28190768, PubMed:29480802, PubMed:29954836, PubMed:32028527, PubMed:32939087, PubMed:33589610, PubMed:33683197, PubMed:34486521, PubMed:34625544, PubMed:34732825, PubMed:34795260, PubMed:34874266). Serine ADP-ribosylation of target proteins, such as histones, promotes decompaction of chromatin and the recruitment of repair factors leading to the reparation of DNA strand breaks (PubMed:27067600, PubMed:28190768, PubMed:32939087, PubMed:33589610). Serine ADP-ribosylation of proteins constitutes the primary form of ADP-ribosylation of proteins in response to DNA damage (PubMed:29480802). HPF1 acts by completing the active site of PARP1 and PARP2: forms a composite active site composed of residues from HPF1 and PARP1 or PARP2 (PubMed:32028527, PubMed:33589610). While HPF1 promotes the initiation of serine ADP-ribosylation, it restricts the polymerase activity of PARP1 and PARP2 in order to limit the length of poly-ADP-ribose chains (PubMed:33683197, PubMed:34732825, PubMed:34795260). HPF1 also promotes tyrosine ADP-ribosylation, probably by conferring tyrosine specificity on PARP1 (PubMed:29954836, PubMed:30257210)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}