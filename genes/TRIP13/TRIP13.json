ene_symbol":"TRIP13","gene_symbol_current":"TRIP13","gene_id":"ENSG00000071539","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999956,"donor_log2fc":-0.000351547,"donor_lfcse":0.160082,"donor_log2fc_shrunk":-1.0465e-08}],"modules":[],"degas_bulk_de":false,"drug_target":false},"seaad_pfc":{"dataset_label":"SEA-AD (Gabitto et al. 2024)","gene_ids":["ENSG00000071539"],"dataset_symbols":["TRIP13"],"explorer":"explorer.html?dataset=seaad_pfc#gene/TRIP13","cell_types":[{"cell_type":"Ex","gene_symbol":"TRIP13","gene_symbol_current":"TRIP13","gene_id":"ENSG00000071539","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.741202,"donor_log2fc":0.118757,"donor_lfcse":0.113946,"donor_log2fc_shrunk":0.00807951},{"cell_type":"In","gene_symbol":"TRIP13","gene_symbol_current":"TRIP13","gene_id":"ENSG00000071539","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.82879,"donor_log2fc":-0.0878424,"donor_lfcse":0.108437,"donor_log2fc_shrunk":-0.00334499}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000071539","entrez_id":["9319"],"uniprot":["Q15645"],"ncbi_summary":"This gene encodes a protein that interacts with thyroid hormone receptors, also known as hormone-dependent transcription factors. The gene product interacts specifically with the ligand binding domain. This gene is one of several that may play a role in early-stage non-small cell lung cancer. [provided by RefSeq, Oct 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15645","text":"Plays a key role in chromosome recombination and chromosome structure development during meiosis. Required at early steps in meiotic recombination that leads to non-crossovers pathways. Also needed for efficient completion of homologous synapsis by influencing crossover distribution along the chromosomes affecting both crossovers and non-crossovers pathways. Also required for development of higher-order chromosome structures and is needed for synaptonemal-complex formation. In males, required for efficient synapsis of the sex chromosomes and for sex body formation. Promotes early steps of the DNA double-strand breaks (DSBs) repair process upstream of the assembly of RAD51 complexes. Required for depletion of HORMAD1 and HORMAD2 from synapsed chromosomes (By similarity). Plays a role in mitotic spindle assembly checkpoint (SAC) activation (PubMed:28553959)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}