86267,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"THOC2","gene_symbol_current":"THOC2","gene_id":"ENSG00000125676","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.204349,"nucleus_log2fc":-0.273236,"nucleus_score":-2.15477,"pct_ad":0.239403,"pct_control":0.275862,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":-0.127511,"donor_lfcse":0.129798,"donor_log2fc_shrunk":-0.00156089},{"cell_type":"Oli","gene_symbol":"THOC2","gene_symbol_current":"THOC2","gene_id":"ENSG00000125676","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.866153,"nucleus_log2fc":-0.0155244,"nucleus_score":0.251787,"pct_ad":0.147956,"pct_control":0.14542,"donor_test":"not significant","donor_padj":0.780549,"donor_log2fc":-0.0933635,"donor_lfcse":0.0682939,"donor_log2fc_shrunk":-0.0186215}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000125676","module":"turquoise","kme":0.153401,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000125676","entrez_id":["57187"],"uniprot":["Q8NI27"],"ncbi_summary":"The TREX multiprotein complex binds specifically to spliced mRNAs to facilitate mRNA export. The protein encoded by this gene is a member of the THO complex, a subset of the TREX complex. The encoded protein interacts with the THOC1 protein.[provided by RefSeq, Jun 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8NI27","text":"Component of the THO subcomplex of the TREX complex which is thought to couple mRNA transcription, processing and nuclear export, and which specifically associates with spliced mRNA and not with unspliced pre-mRNA (PubMed:15833825, PubMed:15998806, PubMed:17190602). Required for efficient export of polyadenylated RNA and spliced mRNA (PubMed:23222130). The THOC1-THOC2-THOC3 core complex alone is sufficient to bind export factor NXF1-NXT1 and promote ATPase activity of DDX39B; in the complex THOC2 is the only component that directly interacts with DDX39B (PubMed:33191911). TREX is recruited to spliced mRNAs by a transcription-independent mechanism, binds to mRNA upstream of the exon-junction complex (EJC) and is recruited in a splicing- and cap-dependent manner to a region near the 5' end of the mRNA where it functions in mRNA export to the cytoplasm via the TAP/NXF1 pathway (PubMed:15833825, PubMed:15998806, PubMed:17190602). Required for NXF1 localization to the nuclear rim (PubMed:22893130). THOC2 (and probably the THO complex) is involved in releasing mRNA from nuclear speckle domains. (Microbial infection) The TREX complex is essential for the export of Kaposi's sarcoma-associated herpesvirus (KSHV) intronless mRNAs and infectious virus production."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}