t_function":[{"accession":"Q5GLZ8","text":"Probable E3 ubiquitin-protein ligase involved in either protein trafficking or in the distribution of cellular structures. Required for spermatozoon maturation and fertility, and for the removal of the cytoplasmic droplet of the spermatozoon. E3 ubiquitin-protein ligases accept ubiquitin from an E2 ubiquitin-conjugating enzyme in the form of a thioester and then directly transfer it to targeted substrates."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}