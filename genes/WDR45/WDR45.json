":"turquoise","kme":0.115905,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000196998"],"dataset_symbols":["WDR45"],"explorer":"explorer.html?dataset=mathys2019#gene/WDR45","cell_types":[{"cell_type":"Ex","gene_symbol":"WDR45","gene_symbol_current":"WDR45","gene_id":"ENSG00000196998","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00522754,"nucleus_log2fc":-0.13959,"nucleus_score":-3.04387,"pct_ad":0.182345,"pct_control":0.198118,"donor_test":"not significant","donor_padj":0.994734,"donor_log2fc":-0.0215569,"donor_lfcse":0.120078,"donor_log2fc_shrunk":-1.56527e-06},{"cell_type":"In","gene_symbol":"WDR45","gene_symbol_current":"WDR45","gene_id":"ENSG00000196998","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.608972,"nucleus_log2fc":0.0197364,"nucleus_score":1.19815,"pct_ad":0.127329,"pct_control":0.114223,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0440519,"donor_lfcse":0.164977,"donor_log2fc_shrunk":1.71944e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000196998","module":"turquoise","kme":0.0970163,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000196998","module":"turquoise","kme":0.22482,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000196998","module":"turquoise","kme":0.207085,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000196998","entrez_id":["11152"],"uniprot":["Q9Y484"],"ncbi_summary":"This gene encodes a member of the WD repeat protein family. WD repeats are minimally conserved regions of approximately 40 amino acids typically bracketed by gly-his and trp-asp (GH-WD), which may facilitate formation of heterotrimeric or multiprotein complexes. Members of this family are involved in a variety of cellular processes, including cell cycle progression, signal transduction, apoptosis, and gene regulation. This gene has a pseudogene at chromosome 4q31.3. Multiple alternatively spliced transcript variants encoding distinct isoforms have been found for this gene, but the biological validity and full-length nature of some variants have not been determined. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y484","text":"Component of the autophagy machinery that controls the major intracellular degradation process by which cytoplasmic materials are packaged into autophagosomes and delivered to lysosomes for degradation (PubMed:23435086, PubMed:28561066). Binds phosphatidylinositol 3-phosphate (PtdIns3P) (PubMed:28561066). Activated by the STK11/AMPK signaling pathway upon starvation, WDR45 is involved in autophagosome assembly downstream of WIPI2, regulating the size of forming autophagosomes (PubMed:28561066). Together with WIPI1, promotes ATG2 (ATG2A or ATG2B)-mediated lipid transfer by enhancing ATG2-association with phosphatidylinositol 3-monophosphate (PI3P)-containing membranes (PubMed:31271352). Probably recruited to membranes through its PtdIns3P activity (PubMed:28561066)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}