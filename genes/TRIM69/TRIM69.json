"cell_type":"Oli","gene_symbol":"TRIM69","gene_symbol_current":"TRIM69","gene_id":"ENSG00000185880","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.553131,"donor_log2fc":0.237615,"donor_lfcse":0.108866,"donor_log2fc_shrunk":0.0253791}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000185880","module":"purple","kme":0.143085,"hub":false,"module_direction":"lower in AD","module_padj":0.900878,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000185880","module":"blue","kme":0.119986,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000185880","entrez_id":["140691"],"uniprot":["Q86WT6"],"ncbi_summary":"This gene encodes a member of the RING-B-box-coiled-coil (RBCC) family and encodes a protein with an N-terminal RING finger motif, a PRY domain and a C-terminal SPRY domain. The mouse ortholog of this gene is specifically expressed in germ cells at the round spermatid stages during spermatogenesis and, when overexpressed, induces apoptosis. Alternatively spliced transcript variants encoding distinct isoforms have been described. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86WT6","text":"E3 ubiquitin-protein ligase that plays an important role in antiviral immunity by restricting different viral infections including dengue virus or vesicular stomatitis indiana virus (PubMed:23131556, PubMed:30142214, PubMed:31375575, PubMed:31578292). Ubiquitinates viral proteins such as dengue virus NS3 thereby limiting infection (PubMed:30844644). Also involved in antiviral immunity by mediating 'Lys-63'-linked ubiquitination of STING1, thereby promoting STING1 dimerization and downstream activation of cGAS-STING signaling (PubMed:41865946). In addition, acts as a key mediator of type I interferon induced microtubule stabilization by directly associating to microtubules independently of its E3 ligase activity (PubMed:36251989). Also plays a role in cataract formation together with TP53 (PubMed:30844644). Mechanistically, inhibits UVB-induced cell apoptosis and reactive oxygen species (ROS) production by inducing TP53 ubiquitination (PubMed:30844644). Regulates centrosome dynamics and mitotic progression by ubiquitinating STK3/MST2; leading to its redistribution to the perinuclear cytoskeleton and subsequent phosphorylation by PLK1 (PubMed:37739411)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}