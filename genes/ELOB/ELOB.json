cleus_padj":7.29963e-23,"nucleus_log2fc":-0.084758,"nucleus_score":-9.90458,"pct_ad":0.401437,"pct_control":0.422833,"donor_test":"not significant","donor_padj":0.888768,"donor_log2fc":-0.106818,"donor_lfcse":0.244839,"donor_log2fc_shrunk":-0.00166451},{"cell_type":"In","gene_symbol":"ELOB","gene_symbol_current":"ELOB","gene_id":"ENSG00000103363","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.24812e-41,"nucleus_log2fc":-0.152364,"nucleus_score":-13.6394,"pct_ad":0.256004,"pct_control":0.28575,"donor_test":"not significant","donor_padj":0.927965,"donor_log2fc":-0.0673519,"donor_lfcse":0.186317,"donor_log2fc_shrunk":-0.000897902},{"cell_type":"Mic","gene_symbol":"ELOB","gene_symbol_current":"ELOB","gene_id":"ENSG00000103363","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.833552,"nucleus_log2fc":-0.011705,"nucleus_score":-0.276054,"pct_ad":0.118756,"pct_control":0.120392,"donor_test":"not significant","donor_padj":0.942348,"donor_log2fc":-0.0716954,"donor_lfcse":0.18341,"donor_log2fc_shrunk":-0.00435208},{"cell_type":"OPC","gene_symbol":"ELOB","gene_symbol_current":"ELOB","gene_id":"ENSG00000103363","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.226659,"nucleus_log2fc":0.0822625,"nucleus_score":1.58729,"pct_ad":0.205786,"pct_control":0.194581,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.138047,"donor_lfcse":0.209187,"donor_log2fc_shrunk":3.32465e-06},{"cell_type":"Oli","gene_symbol":"ELOB","gene_symbol_current":"ELOB","gene_id":"ENSG00000103363","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":9.00952e-50,"nucleus_log2fc":-0.35559,"nucleus_score":-14.9939,"pct_ad":0.191889,"pct_control":0.23921,"donor_test":"not significant","donor_padj":0.905443,"donor_log2fc":-0.174883,"donor_lfcse":0.242327,"donor_log2fc_shrunk":-0.00335028}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000103363","module":"turquoise","kme":0.170497,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000103363","module":"brown","kme":0.501589,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000103363","module":"brown","kme":0.416185,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000103363","module":"red","kme":0.22163,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000103363","module":"turquoise","kme":0.206445,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000103363","module":"turquoise","kme":0.312492,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000103363","entrez_id":["6923"],"uniprot":["Q15370"],"ncbi_summary":"This gene encodes the protein elongin B, which is a subunit of the transcription factor B (SIII) complex. The SIII complex is composed of elongins A/A2, B and C. It activates elongation by RNA polymerase II by suppressing transient pausing of the polymerase at many sites within transcription units. Elongin A functions as the transcriptionally active component of the SIII complex, whereas elongins B and C are regulatory subunits. Elongin A2 is specifically expressed in the testis, and capable of forming a stable complex with elongins B and C. The von Hippel-Lindau tumor suppressor protein binds to elongins B and C, and thereby inhibits transcription elongation. Two alternatively spliced transcript variants encoding different isoforms have been described for this gene. Pseudogenes have been identified on chromosomes 11 and 13. [provided by RefSeq, Aug 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15370","text":"SIII, also known as elongin, is a general transcription elongation factor that increases the RNA polymerase II transcription elongation past template-encoded arresting sites. Subunit A is transcriptionally active and its transcription activity is strongly enhanced by binding to the dimeric complex of the SIII regulatory subunits B and C (elongin BC complex) (PubMed:7638163). In embryonic stem cells, the elongin BC complex is recruited by EPOP to Polycomb group (PcG) target genes in order generate genomic region that display both active and repressive chromatin properties, an important feature of pluripotent stem cells (By similarity). Core component of multiple cullin-2 and cullin-5-RING E3 ubiquitin-protein ligase complexes (ECS complexes), which mediate the ubiquitination of target proteins (PubMed:10205047, PubMed:12004076, PubMed:12050673, PubMed:15590694, PubMed:26138980, PubMed:29775578, PubMed:29779948, PubMed:33268465, PubMed:37844242, PubMed:38326650, PubMed:39039081, PubMed:35512830, PubMed:39039081, PubMed:40440427, PubMed:40963025). By binding to BC-box motifs it seems to link target recruitment subunits, like VHL and members of the SOCS box family, to Cullin/RBX1 modules that activate E2 ubiquitination enzymes (PubMed:10205047, PubMed:12004076, PubMed:12050673, PubMed:15590694). Component the von Hippel-Lindau ubiquitination complex CBC(VHL) (PubMed:10205047, PubMed:12004076, PubMed:12050673, PubMed:15590694). A number of ECS complexes (containing either KLHDC2, KLHDC3, KLHDC10, APPBP2, FEM1A, FEM1B or FEM1C as substrate-recognition component) are part of the DesCEND (destruction via C-end degrons) pathway, which recognizes a C-degron located at the extreme C terminus of target proteins, leading to their ubiquitination and degradation (PubMed:26138980, PubMed:29775578, PubMed:29779948, PubMed:36805027, PubMed:37844242, PubMed:38177675). The ECS(ASB9) complex mediates ubiquitination and degradation of CKB (PubMed:33268465). As part of a multisubunit ubiquitin ligase complex, polyubiquitinates monoubiquitinated POLR2A (PubMed:19920177). ECS(LRR1) ubiquitinates MCM7 and promotes CMG replisome disassembly by VCP and chromatin extraction during S-phase (By similarity). As part of the ECS(RAB40C) complex, mediates ANKRD28 ubiquitination and degradation, thereby inhibiting protein phosphatase 6 (PP6) complex activity and focal adhesion assembly during cell migration (PubMed:35512830). The ECS(ASB7) complex acts a negative regulator of H3K9me3 histone mark by mediating ubiquitination and degradation of SUV39H1 (PubMed:40440427). As part of the ECS(LRRC58) complex, mediates CDO1 ubiquitination and degradation, regulating cysteine catabolism (PubMed:40963025). (Microbial infection) Following infection by HIV-1 virus, component of a cullin-5-RING E3 ubiquitin-protein ligase complex (ECS complex) hijacked by the HIV-1 Vif protein, which catalyzes ubiquitination and degradation of APOBEC3F and APOBEC3G (PubMed:18562529, PubMed:20532212, PubMed:22190037, PubMed:24225024, PubMed:24402281, PubMed:36754086). The complex can also ubiquitinate APOBEC3H to some extent (PubMed:37640699)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}