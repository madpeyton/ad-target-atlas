cell_type":"CUX2+","gene_id":"ENSG00000186298","module":"turquoise","kme":0.260125,"hub":false,"module_direction":"higher in AD","module_padj":0.789273,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000186298","module":"turquoise","kme":0.275694,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000186298","module":"turquoise","kme":0.205451,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000186298"],"dataset_symbols":["PPP1CC"],"explorer":"explorer.html?dataset=mathys2019#gene/PPP1CC","cell_types":[{"cell_type":"Ex","gene_symbol":"PPP1CC","gene_symbol_current":"PPP1CC","gene_id":"ENSG00000186298","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.109301,"nucleus_log2fc":0.137855,"nucleus_score":1.80008,"pct_ad":0.197684,"pct_control":0.189903,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.109178,"donor_lfcse":0.142504,"donor_log2fc_shrunk":3.39466e-06},{"cell_type":"In","gene_symbol":"PPP1CC","gene_symbol_current":"PPP1CC","gene_id":"ENSG00000186298","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0464968,"nucleus_log2fc":0.215988,"nucleus_score":3.15665,"pct_ad":0.202751,"pct_control":0.1662,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.265079,"donor_lfcse":0.174247,"donor_log2fc_shrunk":9.11229e-06},{"cell_type":"Oli","gene_symbol":"PPP1CC","gene_symbol_current":"PPP1CC","gene_id":"ENSG00000186298","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.758006,"donor_log2fc":0.269913,"donor_lfcse":0.167271,"donor_log2fc_shrunk":0.00934651}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000186298","module":"turquoise","kme":0.204542,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000186298","module":"turquoise","kme":0.231837,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000186298","module":"turquoise","kme":0.11396,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000186298","entrez_id":["5501"],"uniprot":["P36873"],"ncbi_summary":"The protein encoded by this gene belongs to the protein phosphatase family, PP1 subfamily. PP1 is an ubiquitous serine/threonine phosphatase that regulates many cellular processes, including cell division. It is expressed in mammalian cells as three closely related isoforms, alpha, beta/delta and gamma, which have distinct localization patterns. This gene encodes the gamma isozyme. Alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Oct 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P36873","text":"Protein phosphatase that associates with over 200 regulatory proteins to form highly specific holoenzymes which dephosphorylate hundreds of biological targets (PubMed:17936702, PubMed:25012651). Protein phosphatase 1 (PP1) is essential for cell division, and participates in the regulation of glycogen metabolism, muscle contractility and protein synthesis. Dephosphorylates RPS6KB1 (PubMed:17936702). Involved in regulation of ionic conductances and long-term synaptic plasticity. May play an important role in dephosphorylating substrates such as the postsynaptic density-associated Ca(2+)/calmodulin dependent protein kinase II. Component of the PTW/PP1 phosphatase complex, which plays a role in the control of chromatin structure and cell cycle progression during the transition from mitosis into interphase (PubMed:20516061). In balance with CSNK1D and CSNK1E, determines the circadian period length, through the regulation of the speed and rhythmicity of PER1 and PER2 phosphorylation (PubMed:21712997). May dephosphorylate CSNK1D and CSNK1E (By similarity). Regulates the recruitment of the SKA complex to kinetochores (PubMed:28982702). Dephosphorylates the 'Ser-418' residue of FOXP3 in regulatory T-cells (Treg) from patients with rheumatoid arthritis, thereby inactivating FOXP3 and rendering Treg cells functionally defective (PubMed:23396208). Together with PPP1CA (PP1-alpha subunit), dephosphorylates IFIH1/MDA5 and RIG-I leading to their activation and a functional innate immune response (PubMed:23499489). Core component of the SHOC2-MRAS-PP1c (SMP) holophosphatase complex that regulates the MAPK pathway activation (PubMed:35768504, PubMed:35831509). The SMP complex specifically dephosphorylates the inhibitory phosphorylation at 'Ser-259' of RAF1 kinase, 'Ser-365' of BRAF kinase and 'Ser-214' of ARAF kinase, stimulating their kinase activities (PubMed:35768504, PubMed:35831509). Dephosphorylates MKI67 at the onset of anaphase (PubMed:25012651). The SMP complex enhances the dephosphorylation activity and substrate specificity of PP1c (PubMed:35768504, PubMed:35831509)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}