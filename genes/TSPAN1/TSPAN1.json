lorer.html?dataset=seaad_pfc#gene/TSPAN1","cell_types":[{"cell_type":"Ex","gene_symbol":"TSPAN1","gene_symbol_current":"TSPAN1","gene_id":"ENSG00000117472","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.618486,"donor_log2fc":0.370106,"donor_lfcse":0.201042,"donor_log2fc_shrunk":0.00868837,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"TSPAN1","gene_symbol_current":"TSPAN1","gene_id":"ENSG00000117472","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.694045,"donor_log2fc":0.352085,"donor_lfcse":0.18305,"donor_log2fc_shrunk":0.00514425,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"TSPAN1","gene_symbol_current":"TSPAN1","gene_id":"ENSG00000117472","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985401,"donor_log2fc":-0.0366217,"donor_lfcse":0.320505,"donor_log2fc_shrunk":-0.000347354,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000117472","entrez_id":["10103"],"uniprot":["O60635"],"ncbi_summary":"The protein encoded by this gene is a member of the transmembrane 4 superfamily, also known as the tetraspanin family. Most of these members are cell-surface proteins that are characterized by the presence of four hydrophobic domains. The proteins mediate signal transduction events that play a role in the regulation of cell development, activation, growth and motility. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60635","text":"Structural component of specialized membrane microdomains known as tetraspanin-enriched microdomains (TERMs), which act as platforms for receptor clustering and signaling. Participates thereby in diverse biological functions such as cell signal transduction, adhesion, migration and protein trafficking (PubMed:30066932, PubMed:30291375). Regulates neuronal differentiation in response to NGF by facilitating NGF-mediated activation of NTRK1/TRKA receptor tyrosine kinase and subsequent downstream signaling pathways (By similarity). Plays a role in the inhibition of TNFalpha-induced apoptosis. Mechanistically, inhibits the NF-kappa-B signaling pathway by blocking phosphorylation of CHUK (PubMed:30291375). Also promotes the stability of the thiamine transporter 1/SLC19A2 in intestinal epithelial cells leading to an increase of thiamine uptake process (PubMed:21836059)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}