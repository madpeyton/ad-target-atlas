l_current":"OSBPL3","gene_id":"ENSG00000070882","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.232602,"nucleus_log2fc":0.148137,"nucleus_score":2.22567,"pct_ad":0.412156,"pct_control":0.376284,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0704665,"donor_lfcse":0.0966651,"donor_log2fc_shrunk":7.16024e-06},{"cell_type":"Mic","gene_symbol":"OSBPL3","gene_symbol_current":"OSBPL3","gene_id":"ENSG00000070882","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.185033,"nucleus_log2fc":0.408634,"nucleus_score":2.15478,"pct_ad":0.194342,"pct_control":0.15231,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000070882","module":"green","kme":0.0928364,"hub":false,"module_direction":"lower in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000070882","module":"brown","kme":0.193233,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000070882","module":"brown","kme":0.309606,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000070882","module":"turquoise","kme":0.075567,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000070882","entrez_id":["26031"],"uniprot":["Q9H4L5"],"ncbi_summary":"This gene encodes a member of the oxysterol-binding protein (OSBP) family, a group of intracellular lipid receptors. Most members contain an N-terminal pleckstrin homology domain and a highly conserved C-terminal OSBP-like sterol-binding domain. The encoded protein is involved in the regulation of cell adhesion and organization of the actin cytoskeleton. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H4L5","text":"Lipid transfer protein that mediates the non-vesicular transport of phosphoinositide 4-phosphate (1,2-diacyl-sn-glycero-3-phospho-(1D-myo-inositol 4-phosphate), or PI(4)P) at the plasma membrane (PM)/ endoplasmic reticulum (ER) contact sites (PubMed:16143324, PubMed:32041906, PubMed:32234213). Extracts PI4P from the PM, in exchange for phosphatidylcholine (PubMed:32234213). Can bind to the ER membrane protein VAPA and recruit VAPA to PM sites, thus linking these intracellular compartments (PubMed:25447204). The ORP3-VAPA complex stimulates RRAS signaling which in turn attenuates integrin beta-1 (ITGB1) activation at the cell surface (PubMed:18270267, PubMed:25447204). With VAPA, may regulate ER morphology (PubMed:16143324). Has a role in regulation of the actin cytoskeleton, cell polarity and cell adhesion (PubMed:18270267). Binds to phosphoinositides with preference for PI(3,4)P2 and PI(3,4,5)P3 (PubMed:16143324). Also binds 25-hydroxycholesterol and cholesterol (PubMed:17428193)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}