alse,"nucleus_direction":"lower in AD","nucleus_padj":0.750493,"nucleus_log2fc":-0.0594698,"nucleus_score":-0.411781,"pct_ad":0.128041,"pct_control":0.129608,"donor_test":"not significant","donor_padj":0.955438,"donor_log2fc":-0.0366427,"donor_lfcse":0.122523,"donor_log2fc_shrunk":-0.00453899,"degas_log2fc":-0.235042,"degas_padj":0.000418538},{"cell_type":"OPC","gene_symbol":"LONP1","gene_symbol_current":"LONP1","gene_id":"ENSG00000196365","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0728428,"nucleus_log2fc":-0.179164,"nucleus_score":-2.23682,"pct_ad":0.141366,"pct_control":0.154953,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.133784,"donor_lfcse":0.099508,"donor_log2fc_shrunk":-1.0199e-05,"degas_log2fc":0.000551641,"degas_padj":0.994644},{"cell_type":"Oli","gene_symbol":"LONP1","gene_symbol_current":"LONP1","gene_id":"ENSG00000196365","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00121269,"nucleus_log2fc":-0.0968639,"nucleus_score":-3.37863,"pct_ad":0.130477,"pct_control":0.13912,"donor_test":"not significant","donor_padj":0.931213,"donor_log2fc":-0.0372545,"donor_lfcse":0.0679937,"donor_log2fc_shrunk":-0.00683174,"degas_log2fc":-0.0513462,"degas_padj":0.119824}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000196365","module":"red","kme":0.0992613,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000196365","entrez_id":["9361"],"uniprot":["P36776"],"ncbi_summary":"This gene encodes a mitochondrial matrix protein that belongs to the Lon family of ATP-dependent proteases. This protein mediates the selective degradation of misfolded, unassembled or oxidatively damaged polypeptides in the mitochondrial matrix. It may also have a chaperone function in the assembly of inner membrane protein complexes, and participate in the regulation of mitochondrial gene expression and maintenance of the integrity of the mitochondrial genome. Decreased expression of this gene has been noted in a patient with hereditary spastic paraplegia (PMID:18378094). Alternatively spliced transcript variants have been found for this gene. [provided by RefSeq, Feb 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P36776","text":"ATP-dependent serine protease that mediates the selective degradation of misfolded, unassembled or oxidatively damaged polypeptides as well as certain short-lived regulatory proteins in the mitochondrial matrix (PubMed:12198491, PubMed:15870080, PubMed:17579211, PubMed:37327776, PubMed:8248235, PubMed:35870450, PubMed:38688959). Endogenous substrates include mitochondrial steroidogenic acute regulatory (StAR) protein, DELE1, helicase Twinkle (TWNK) and the large ribosomal subunit protein MRPL32/bL32m (PubMed:17579211, PubMed:28377575, PubMed:37327776). MRPL32/bL32m is protected from degradation by LONP1 when it is bound to a nucleic acid (RNA), but TWNK is not (PubMed:17579211, PubMed:28377575). In addtion to its protease activity, has also an ATP-dependent protein folding chaperone activity and functions in mitochondrial protein folding (PubMed:33431889). Participates in the regulation of mitochondrial gene expression and in the maintenance of the integrity of the mitochondrial genome (PubMed:17420247). Binds to mitochondrial promoters and RNA in a single-stranded, site-specific, and strand-specific manner (PubMed:17420247). May regulate mitochondrial DNA replication and/or gene expression using site-specific, single-stranded DNA binding to target the degradation of regulatory proteins binding to adjacent sites in mitochondrial promoters (PubMed:14739292, PubMed:17420247)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}