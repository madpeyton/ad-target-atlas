t":"not significant","donor_padj":0.999342,"donor_log2fc":0.130556,"donor_lfcse":0.115253,"donor_log2fc_shrunk":1.02935e-05},{"cell_type":"Oli","gene_symbol":"ADI1","gene_symbol_current":"ADI1","gene_id":"ENSG00000182551","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.50131e-18,"nucleus_log2fc":-0.260211,"nucleus_score":-8.95149,"pct_ad":0.119356,"pct_control":0.142464,"donor_test":"not significant","donor_padj":0.795577,"donor_log2fc":-0.186904,"donor_lfcse":0.149052,"donor_log2fc_shrunk":-0.009408}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000182551","module":"turquoise","kme":0.146625,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000182551","module":"turquoise","kme":0.0100327,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000182551","module":"turquoise","kme":0.113736,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000182551","module":"turquoise","kme":0.135838,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000182551","entrez_id":["55256"],"uniprot":["Q9BV57"],"ncbi_summary":"This gene encodes an enzyme that belongs to the aci-reductone dioxygenase family of metal-binding enzymes, which are involved in methionine salvage. This enzyme may regulate mRNA processing in the nucleus, and may carry out different functions depending on its localization. Related pseudogenes have been defined on chromosomes 8 and 20. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Apr 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BV57","text":"Catalyzes 2 different reactions between oxygen and the acireductone 1,2-dihydroxy-3-keto-5-methylthiopentene (DHK-MTPene) depending upon the metal bound in the active site (By similarity). Fe-containing acireductone dioxygenase (Fe-ARD) produces formate and 2-keto-4-methylthiobutyrate (KMTB), the alpha-ketoacid precursor of methionine in the methionine recycle pathway (PubMed:15938715). Ni-containing acireductone dioxygenase (Ni-ARD) produces methylthiopropionate, carbon monoxide and formate, and does not lie on the methionine recycle pathway (By similarity). Also down-regulates cell migration mediated by MMP14 (PubMed:14718544). Necessary for hepatitis C virus replication in an otherwise non-permissive cell line (PubMed:11602742)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}