49e-56}],"modules":[],"degas_bulk_de":true,"drug_target":false},"seaad_pfc":{"dataset_label":"SEA-AD (Gabitto et al. 2024)","gene_ids":["ENSG00000141433"],"dataset_symbols":["ADCYAP1"],"explorer":"explorer.html?dataset=seaad_pfc#gene/ADCYAP1","cell_types":[{"cell_type":"Ex","gene_symbol":"ADCYAP1","gene_symbol_current":"ADCYAP1","gene_id":"ENSG00000141433","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":4.84041e-140,"nucleus_log2fc":-0.266032,"nucleus_score":-25.2614,"pct_ad":0.161713,"pct_control":0.20047,"donor_test":"not significant","donor_padj":0.762156,"donor_log2fc":-0.180946,"donor_lfcse":0.192445,"donor_log2fc_shrunk":-0.00418922,"degas_log2fc":-0.323575,"degas_padj":1.22787e-101},{"cell_type":"In","gene_symbol":"ADCYAP1","gene_symbol_current":"ADCYAP1","gene_id":"ENSG00000141433","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.856249,"donor_log2fc":-0.172115,"donor_lfcse":0.256496,"donor_log2fc_shrunk":-0.00127757,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000141433","entrez_id":["116"],"uniprot":["P18509"],"ncbi_summary":"This gene encodes a secreted proprotein that is further processed into multiple mature peptides. These peptides stimulate adenylate cyclase and increase cyclic adenosine monophosphate (cAMP) levels, resulting in the transcriptional activation of target genes. The products of this gene are key mediators of neuroendocrine stress responses. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Feb 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P18509","text":"PACAP is a neuropeptide involved in diverse array of physiological processes through activating the PACAP subfamily of class B1 G protein-coupled receptors: VIP receptor 1 (VIPR1), VIP receptor 2 (VIPR2), and PACAP type I receptor (ADCYAP1R1) (PubMed:11175907, PubMed:23800469, PubMed:32047270, PubMed:32004469, PubMed:36385145). Exerts neuroprotective and general cytoprotective effects due to anti-apoptotic, anti-inflammatory, and antioxidant actions (PubMed:23800469). Promotes neuron projection development through the RAPGEF2/Rap1/B-Raf/ERK pathway (PubMed:23800469). In chromaffin cells, induces long-lasting increase of intracellular calcium concentrations and neuroendocrine secretion (By similarity). Involved in the control of glucose homeostasis, induces insulin secretion by pancreatic beta cells (By similarity). PACAP exists in two bioactive forms from proteolysis of the same precursor protein, PACAP27 and PACAP38, which differ by eleven amino acid residues in the C-terminus (PubMed:32047270, PubMed:32004469)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}