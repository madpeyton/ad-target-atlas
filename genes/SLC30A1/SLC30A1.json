,"module":"turquoise","kme":0.0825853,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000170385","module":"turquoise","kme":0.148539,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000170385","module":"blue","kme":0.579567,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000170385"],"dataset_symbols":["SLC30A1"],"explorer":"explorer.html?dataset=mathys2019#gene/SLC30A1","cell_types":[{"cell_type":"Ast","gene_symbol":"SLC30A1","gene_symbol_current":"SLC30A1","gene_id":"ENSG00000170385","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0249285,"nucleus_log2fc":0.546786,"nucleus_score":2.75243,"pct_ad":0.108647,"pct_control":0.0819779,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Ex","gene_symbol":"SLC30A1","gene_symbol_current":"SLC30A1","gene_id":"ENSG00000170385","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.159436,"donor_lfcse":0.14827,"donor_log2fc_shrunk":7.51129e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000170385","module":"turquoise","kme":0.172661,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000170385","entrez_id":["7779"],"uniprot":["Q9Y6M5"],"ncbi_summary":"Predicted to enable calcium channel inhibitor activity and zinc ion transmembrane transporter activity. Predicted to be involved in several processes, including cellular divalent inorganic cation homeostasis; inorganic cation transmembrane transport; and negative regulation of transport. Predicted to act upstream of or within in utero embryonic development. Located in several cellular components, including Golgi apparatus; endoplasmic reticulum; and nuclear membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y6M5","text":"Zinc ion:proton antiporter that could function at the plasma membrane mediating zinc efflux from cells against its electrochemical gradient protecting them from intracellular zinc accumulation and toxicity (PubMed:31471319, PubMed:33996761, PubMed:39422023, PubMed:39111308, PubMed:39390258). Alternatively, could prevent the transport to the plasma membrane of CACNB2, the L-type calcium channels regulatory subunit, through a yet to be defined mechanism. By modulating the expression of these channels at the plasma membrane, could prevent calcium and zinc influx into cells. By the same mechanism, could also prevent L-type calcium channels-mediated heavy metal influx into cells (By similarity). In some cells, could also function as a zinc ion:proton antiporter mediating zinc entry into the lumen of cytoplasmic vesicles. In macrophages, can increase zinc ions concentration into the lumen of cytoplasmic vesicles containing engulfed bacteria and could help inactivate them (PubMed:32441444). Forms a complex with TMC6/EVER1 and TMC8/EVER2 at the ER membrane of keratynocytes which facilitates zinc uptake into the ER (PubMed:18158319). Down-regulates the activity of transcription factors induced by zinc and cytokines (PubMed:18158319). Also functions as a copper transporter, facilitating the entry of copper into cells, which is crucial for copper-induced cell death (cuproptosis) (PubMed:39111308). Acts as a Zn(2+)/Ca(2+) exchanger, exporting zinc in exchange for calcium influx (PubMed:38669333)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}