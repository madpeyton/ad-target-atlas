er":"explorer.html?dataset=mathys2019#gene/ABCC9","cell_types":[{"cell_type":"Ast","gene_symbol":"ABCC9","gene_symbol_current":"ABCC9","gene_id":"ENSG00000069431","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.167871,"nucleus_log2fc":0.309966,"nucleus_score":1.73064,"pct_ad":0.166297,"pct_control":0.148992,"donor_test":"not significant","donor_padj":0.636625,"donor_log2fc":0.330149,"donor_lfcse":0.184136,"donor_log2fc_shrunk":0.0219713},{"cell_type":"Ex","gene_symbol":"ABCC9","gene_symbol_current":"ABCC9","gene_id":"ENSG00000069431","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.105869,"donor_lfcse":0.159611,"donor_log2fc_shrunk":-3.13083e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000069431","module":"turquoise","kme":0.148907,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000069431","module":"red","kme":0.229476,"hub":false,"module_direction":"lower in AD","module_padj":0.641133,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000069431","entrez_id":["10060"],"uniprot":["O60706"],"ncbi_summary":"The protein encoded by this gene is a member of the superfamily of ATP-binding cassette (ABC) transporters. ABC proteins transport various molecules across extra- and intra-cellular membranes. ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, White). This protein is a member of the MRP subfamily which is involved in multi-drug resistance. This protein is thought to form ATP-sensitive potassium channels in cardiac, skeletal, and vascular and non-vascular smooth muscle. Protein structure suggests a role as the drug-binding channel-modulating subunit of the extra-pancreatic ATP-sensitive potassium channels. Mutations in this gene are associated with cardiomyopathy dilated type 1O. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Apr 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60706","text":"Subunit of ATP-sensitive potassium channels (KATP). Can form cardiac and smooth muscle-type KATP channels with KCNJ11. KCNJ11 forms the channel pore while ABCC9 is required for activation and regulation (PubMed:9831708). Can form a sulfonylurea-sensitive but ATP-insensitive potassium channel with KCNJ8 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}