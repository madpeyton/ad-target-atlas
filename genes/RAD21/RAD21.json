og2fc_shrunk":0.0585706,"degas_log2fc":0.128951,"degas_padj":0.007565},{"cell_type":"OPC","gene_symbol":"RAD21","gene_symbol_current":"RAD21","gene_id":"ENSG00000164754","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.042399,"nucleus_log2fc":0.112979,"nucleus_score":2.48929,"pct_ad":0.341933,"pct_control":0.320745,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0923759,"donor_lfcse":0.0835295,"donor_log2fc_shrunk":1.39761e-05,"degas_log2fc":-0.160423,"degas_padj":0.00104084},{"cell_type":"Oli","gene_symbol":"RAD21","gene_symbol_current":"RAD21","gene_id":"ENSG00000164754","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.08611e-51,"nucleus_log2fc":0.311354,"nucleus_score":15.2867,"pct_ad":0.377481,"pct_control":0.327582,"donor_test":"not significant","donor_padj":0.487488,"donor_log2fc":0.231924,"donor_lfcse":0.0950392,"donor_log2fc_shrunk":0.0423391,"degas_log2fc":-0.112587,"degas_padj":1.16908e-08}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000164754","module":"turquoise","kme":0.0962845,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000164754","module":"brown","kme":0.24332,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000164754","module":"turquoise","kme":0.0303564,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164754","entrez_id":["5885"],"uniprot":["O60216"],"ncbi_summary":"The protein encoded by this gene is highly similar to the gene product of Schizosaccharomyces pombe rad21, a gene involved in the repair of DNA double-strand breaks, as well as in chromatid cohesion during mitosis. This protein is a nuclear phospho-protein, which becomes hyperphosphorylated in cell cycle M phase. The highly regulated association of this protein with mitotic chromatin specifically at the centromere region suggests its role in sister chromatid cohesion in mitotic cells. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60216","text":"[Double-strand-break repair protein rad21 homolog]: As a member of the cohesin complex, involved in sister chromatid cohesion from the time of DNA replication in S phase to their segregation in mitosis, a function that is essential for proper chromosome segregation, post-replicative DNA repair, and the prevention of inappropriate recombination between repetitive regions (PubMed:11509732). The cohesin complex may also play a role in spindle pole assembly during mitosis (PubMed:11590136). In interphase, cohesins may function in the control of gene expression by binding to numerous sites within the genome (By similarity). May control RUNX1 gene expression (Probable). Binds to and represses APOB gene promoter (PubMed:25575569). May play a role in embryonic gut development, possibly through the regulation of enteric neuron development (By similarity). [64-kDa C-terminal product]: May promote apoptosis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}