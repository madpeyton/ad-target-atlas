7666","module":"turquoise","kme":0.103951,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000177666"],"dataset_symbols":["PNPLA2"],"explorer":"explorer.html?dataset=mathys2019#gene/PNPLA2","cell_types":[{"cell_type":"Ex","gene_symbol":"PNPLA2","gene_symbol_current":"PNPLA2","gene_id":"ENSG00000177666","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.15298,"nucleus_log2fc":-0.0723144,"nucleus_score":-1.61548,"pct_ad":0.117127,"pct_control":0.124502,"donor_test":"not significant","donor_padj":0.986309,"donor_log2fc":0.0579479,"donor_lfcse":0.142721,"donor_log2fc_shrunk":2.94173e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000177666","entrez_id":["57104"],"uniprot":["Q96AD5"],"ncbi_summary":"This gene encodes an enzyme which catalyzes the first step in the hydrolysis of triglycerides in adipose tissue. Mutations in this gene are associated with neutral lipid storage disease with myopathy. [provided by RefSeq, Jul 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96AD5","text":"Catalyzes the initial step in triglyceride hydrolysis in adipocyte and non-adipocyte lipid droplets (PubMed:15364929, PubMed:15550674, PubMed:16150821, PubMed:16239926, PubMed:17603008, PubMed:34903883). Exhibits a strong preference for the hydrolysis of long-chain fatty acid esters at the sn-2 position of the glycerol backbone and acts coordinately with LIPE/HLS and DGAT2 within the lipolytic cascade (By similarity). Also possesses acylglycerol transacylase and phospholipase A2 activities (PubMed:15364929, PubMed:17032652, PubMed:17603008). Transfers fatty acid from triglyceride to retinol, hydrolyzes retinylesters, and generates 1,3-diacylglycerol from triglycerides (PubMed:17603008). Regulates adiposome size and may be involved in the degradation of adiposomes (PubMed:16239926). Catalyzes the formation of an ester bond between hydroxy fatty acids and fatty acids derived from triglycerides or diglycerides to generate fatty acid esters of hydroxy fatty acids (FAHFAs) in adipocytes (PubMed:35676490). Acts antagonistically with LDAH in regulation of cellular lipid stores (PubMed:28578400). Inhibits LDAH-stimulated lipid droplet fusion (PubMed:28578400). May play an important role in energy homeostasis (By similarity). May play a role in the response of the organism to starvation, enhancing hydrolysis of triglycerides and providing free fatty acids to other tissues to be oxidized in situations of energy depletion (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}