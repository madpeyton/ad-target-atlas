2fc":0.378692,"donor_lfcse":0.240866,"donor_log2fc_shrunk":0.00398248,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Ex","gene_symbol":"PIF1","gene_symbol_current":"PIF1","gene_id":"ENSG00000140451","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":7.53312e-73,"nucleus_log2fc":-0.302723,"nucleus_score":-18.1197,"pct_ad":0.0845501,"pct_control":0.105208,"donor_test":"not significant","donor_padj":0.652717,"donor_log2fc":-0.225025,"donor_lfcse":0.13661,"donor_log2fc_shrunk":-0.0114348,"degas_log2fc":0.0914707,"degas_padj":1.31245e-05},{"cell_type":"In","gene_symbol":"PIF1","gene_symbol_current":"PIF1","gene_id":"ENSG00000140451","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.758032,"donor_log2fc":-0.163508,"donor_lfcse":0.130923,"donor_log2fc_shrunk":-0.00449026,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"PIF1","gene_symbol_current":"PIF1","gene_id":"ENSG00000140451","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0210871,"donor_lfcse":0.224609,"donor_log2fc_shrunk":-4.25317e-07,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000140451","entrez_id":["80119"],"uniprot":["Q9H611"],"ncbi_summary":"This gene encodes a DNA-dependent adenosine triphosphate (ATP)-metabolizing enzyme that functions as a 5' to 3' DNA helicase. The encoded protein can resolve G-quadruplex structures and RNA-DNA hybrids at the ends of chromosomes. It also prevents telomere elongation by inhibiting the actions of telomerase. Alternative splicing and the use of alternative start codons results in multiple isoforms that are differentially localized to either the mitochondria or the nucleus. [provided by RefSeq, Nov 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H611","text":"DNA-dependent ATPase and 5'-3' DNA helicase required for the maintenance of both mitochondrial and nuclear genome stability. Efficiently unwinds G-quadruplex (G4) DNA structures and forked RNA-DNA hybrids. Resolves G4 structures, preventing replication pausing and double-strand breaks (DSBs) at G4 motifs. Involved in the maintenance of telomeric DNA. Inhibits telomere elongation, de novo telomere formation and telomere addition to DSBs via catalytic inhibition of telomerase. Reduces the processivity of telomerase by displacing active telomerase from DNA ends. Releases telomerase by unwinding the short telomerase RNA/telomeric DNA hybrid that is the intermediate in the telomerase reaction. Possesses an intrinsic strand annealing activity."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}