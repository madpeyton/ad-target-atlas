cleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0815139,"nucleus_log2fc":-0.167534,"nucleus_score":-2.04309,"pct_ad":0.101002,"pct_control":0.109967,"donor_test":"not significant","donor_padj":0.826286,"donor_log2fc":-0.158844,"donor_lfcse":0.14306,"donor_log2fc_shrunk":-0.00737643}],"modules":[{"cell_type":"In","gene_id":"ENSG00000174705","module":"blue","kme":0.0502119,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000174705","module":"yellow","kme":0.123101,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000174705","entrez_id":["285590"],"uniprot":["A1X283"],"ncbi_summary":"This gene encodes an adapter protein that is characterized by a PX domain and four Src homology 3 domains. The encoded protein is required for podosome formation and is involved in cell adhesion and migration of numerous cell types. Mutations in this gene are the cause of Frank-ter Haar syndrome (FTHS), and also Borrone Dermato-Cardio-Skeletal (BDCS) syndrome. Alternative splicing of this gene results in multiple transcript variants. [provided by RefSeq, Apr 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"A1X283","text":"Adapter protein involved in invadopodia and podosome formation and extracellular matrix degradation. Binds matrix metalloproteinases (ADAMs), NADPH oxidases (NOXs) and phosphoinositides. Acts as an organizer protein that allows NOX1- or NOX3-dependent reactive oxygen species (ROS) generation and ROS localization. Plays a role in mitotic clonal expansion during the immediate early stage of adipocyte differentiation (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}