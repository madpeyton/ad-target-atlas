donor_test":"not significant","donor_padj":0.840973,"donor_log2fc":0.0546612,"donor_lfcse":0.0732312,"donor_log2fc_shrunk":0.00380523,"degas_log2fc":-0.22231,"degas_padj":3.26543e-167},{"cell_type":"Mic","gene_symbol":"TRPM2","gene_symbol_current":"TRPM2","gene_id":"ENSG00000142185","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":6.41554e-12,"nucleus_log2fc":0.17715,"nucleus_score":7.18668,"pct_ad":0.728969,"pct_control":0.695737,"donor_test":"not significant","donor_padj":0.824623,"donor_log2fc":0.0884432,"donor_lfcse":0.107025,"donor_log2fc_shrunk":0.014638,"degas_log2fc":-0.00438684,"degas_padj":0.896969},{"cell_type":"OPC","gene_symbol":"TRPM2","gene_symbol_current":"TRPM2","gene_id":"ENSG00000142185","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.256958,"donor_lfcse":0.25114,"donor_log2fc_shrunk":-4.32472e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"TRPM2","gene_symbol_current":"TRPM2","gene_id":"ENSG00000142185","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.829855,"donor_log2fc":-0.19141,"donor_lfcse":0.173593,"donor_log2fc_shrunk":-0.00700613,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000142185","module":"blue","kme":0.13093,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000142185","module":"yellow","kme":0.224331,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000142185","module":"green","kme":0.36743,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000142185","module":"blue","kme":0.33376,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000142185","module":"brown","kme":0.099124,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000142185","entrez_id":["7226"],"uniprot":["O94759"],"ncbi_summary":"The protein encoded by this gene forms a tetrameric cation channel that is permeable to calcium, sodium, and potassium and is regulated by free intracellular ADP-ribose. The encoded protein is activated by oxidative stress and confers susceptibility to cell death. Alternative splicing results in multiple transcript variants encoding distinct protein isoforms. Additional transcript variants of this gene have been described, but their full-length nature is not known. [provided by RefSeq, Feb 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O94759","text":"[Isoform 1]: Nonselective, voltage-independent cation channel that mediates Na(+) and Ca(2+) influx, leading to increased cytoplasmic Ca(2+) levels (PubMed:11385575, PubMed:11509734, PubMed:11804595, PubMed:12594222, PubMed:15561722, PubMed:16601673, PubMed:19171771, PubMed:20660597, PubMed:25620041, PubMed:27068538, PubMed:27383051, PubMed:28775320, PubMed:29745897, PubMed:30467180, PubMed:31513012, PubMed:34788616). Functions as a ligand-gated ion channel, gated by intracellular adenosine diphosphate ribose (ADP-ribose), Ca(2+), warm temperature, and oxidative stress (PubMed:19171771, PubMed:25620041, PubMed:28775320, PubMed:30467180). The precise physiological activators are under debate; the true, physiological activators may be ADP-ribose and ADP-ribose-2'-phosphate (PubMed:20650899, PubMed:25918360). Binding of ADP-ribose to the cytoplasmic Nudix domain causes a conformation change; the channel is primed but still requires Ca(2+) binding to trigger channel opening (PubMed:19171771, PubMed:25620041, PubMed:28775320, PubMed:29745897, PubMed:30467180). Extracellular Ca(2+) passes through the channel and increases channel activity (PubMed:19171771). Contributes to Ca(2+) release from intracellular stores in response to ADP-ribose (PubMed:19454650). Plays a role in numerous processes that involve signaling via intracellular Ca(2+) levels (Probable). Besides, mediates the release of lysosomal Zn(2+) stores in response to reactive oxygen species, leading to increased cytosolic Zn(2+) levels (PubMed:25562606, PubMed:27068538). Plays a role in mediating behavorial and physiological responses to moderate heat and thereby contributes to body temperature homeostasis. Plays a role in insulin secretion, a process that requires increased cytoplasmic Ca(2+) levels (By similarity). Required for normal IFNG and cytokine secretion and normal innate immune immunity in response to bacterial infection. Required for normal phagocytosis and cytokine release by macrophages exposed to zymosan (in vitro) (PubMed:22493272). Plays a role in dendritic cell differentiation and maturation, and in dendritic cell chemotaxis via its role in regulating cytoplasmic Ca(2+) levels (By similarity). Plays a role in the regulation of the reorganization of the actin cytoskeleton and filopodia formation in response to reactive oxygen species via its role in increasing cytoplasmic Ca(2+) and Zn(2+) levels (PubMed:27068538). Confers susceptibility to cell death following oxidative stress (PubMed:12594222, PubMed:25562606). [Isoform 2]: Lacks cation channel activity. Does not mediate cation transport in response to oxidative stress or ADP-ribose. [Isoform 3]: Lacks cation channel activity and negatively regulates the channel activity of isoform 1. Negatively regulates susceptibility to cell death in reposponse to oxidative stress."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}