8,"donor_test":"not significant","donor_padj":0.833614,"donor_log2fc":-0.250137,"donor_lfcse":0.316999,"donor_log2fc_shrunk":-0.00122793},{"cell_type":"Mic","gene_symbol":"IL7","gene_symbol_current":"IL7","gene_id":"ENSG00000104432","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.986595,"donor_log2fc":-0.0250537,"donor_lfcse":0.283026,"donor_log2fc_shrunk":-0.000574198},{"cell_type":"OPC","gene_symbol":"IL7","gene_symbol_current":"IL7","gene_id":"ENSG00000104432","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.30899,"nucleus_log2fc":-0.0706566,"nucleus_score":-1.36188,"pct_ad":0.327319,"pct_control":0.339712,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.138812,"donor_lfcse":0.289723,"donor_log2fc_shrunk":-1.7384e-06},{"cell_type":"Oli","gene_symbol":"IL7","gene_symbol_current":"IL7","gene_id":"ENSG00000104432","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.973523,"donor_log2fc":0.0705423,"donor_lfcse":0.312605,"donor_log2fc_shrunk":0.000713942}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000104432","module":"turquoise","kme":0.428526,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000104432","module":"turquoise","kme":0.698256,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000104432","module":"turquoise","kme":0.586626,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000104432","module":"turquoise","kme":0.368113,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000104432","module":"turquoise","kme":0.201453,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000104432","entrez_id":["3574"],"uniprot":["P13232"],"ncbi_summary":"The protein encoded by this gene is a cytokine important for B and T cell development. This cytokine and the hepatocyte growth factor (HGF) form a heterodimer that functions as a pre-pro-B cell growth-stimulating factor. IL7 is found to be a cofactor for V(D)J rearrangement of the T cell receptor beta (TCRB) during early T cell development. This cytokine can be produced locally by intestinal epithelial and epithelial goblet cells, and may serve as a regulatory factor for intestinal mucosal lymphocytes. IL7 plays an essential role in lymphoid cell survival, and in the maintenance of naive and memory T cells. Alternative splicing results in multiple transcript variants encoding distinct isoforms. Additional splice variants have been described but their presence in normal tissues has not been confirmed. Severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) infection can be a potent inducer of proinflammatory cytokines and chemokines which may defend against the infection, but may also mediate destructive lung injury. Elevated serum IL7 levels, together with several other circulating cytokines and chemokines, has been found to be associated with the severity of Coronavirus Disease 19 (COVID-19). [provided by RefSeq, Jul 2020].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P13232","text":"Hematopoietic cytokine that plays an essential role in the development, expansion, and survival of naive and memory T-cells and B-cells thereby regulating the number of mature lymphocytes and maintaining lymphoid homeostasis (PubMed:25870237, PubMed:7527823). Mechanistically, exerts its biological effects through a receptor composed of IL7RA subunit and the cytokine receptor common subunit gamma/CSF2RG (PubMed:8128231). Binding to the receptor leads to activation of various kinases including JAK1 or JAK3 depending on the cell type and subsequently propagation of signals through activation of several downstream signaling pathways including the PI3K/Akt/mTOR or the JAK-STAT5 (PubMed:18523275, PubMed:20974963)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}