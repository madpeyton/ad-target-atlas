ct_control":0.0994161,"donor_test":"not significant","donor_padj":0.833363,"donor_log2fc":0.0243025,"donor_lfcse":0.0494418,"donor_log2fc_shrunk":0.00837621},{"cell_type":"Inhibitory","gene_symbol":"ALG12","gene_symbol_current":"ALG12","gene_id":"ENSG00000182858","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.697407,"donor_log2fc":0.0584597,"donor_lfcse":0.0613732,"donor_log2fc_shrunk":0.010589},{"cell_type":"Oligodendroglia","gene_symbol":"ALG12","gene_symbol_current":"ALG12","gene_id":"ENSG00000182858","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.666845,"donor_log2fc":0.0414042,"donor_lfcse":0.0552853,"donor_log2fc_shrunk":0.0182315}],"modules":[],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000182858"],"dataset_symbols":["ALG12"],"explorer":"explorer.html?dataset=mathys2019#gene/ALG12","cell_types":[{"cell_type":"Ex","gene_symbol":"ALG12","gene_symbol_current":"ALG12","gene_id":"ENSG00000182858","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.128407,"donor_lfcse":0.133937,"donor_log2fc_shrunk":-7.50239e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000182858","entrez_id":["79087"],"uniprot":["Q9BV10"],"ncbi_summary":"This gene encodes a member of the glycosyltransferase 22 family. The encoded protein catalyzes the addition of the eighth mannose residue in an alpha-1,6 linkage onto the dolichol-PP-oligosaccharide precursor (dolichol-PP-Man(7)GlcNAc(2)) required for protein glycosylation. Mutations in this gene have been associated with congenital disorder of glycosylation type Ig (CDG-Ig)characterized by abnormal N-glycosylation. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BV10","text":"Mannosyltransferase that operates in the biosynthetic pathway of dolichol-linked oligosaccharides, the glycan precursors employed in protein asparagine (N)-glycosylation. The assembly of dolichol-linked oligosaccharides begins on the cytosolic side of the endoplasmic reticulum membrane and finishes in its lumen. The sequential addition of sugars to dolichol pyrophosphate produces dolichol-linked oligosaccharides containing fourteen sugars, including two GlcNAcs, nine mannoses and three glucoses. Once assembled, the oligosaccharide is transferred from the lipid to nascent proteins by oligosaccharyltransferases. In the lumen of the endoplasmic reticulum, adds the eighth mannose residue in an alpha-1,6 linkage onto Man(7)GlcNAc(2)-PP-dolichol to produce Man(8)GlcNAc(2)-PP-dolichol."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}