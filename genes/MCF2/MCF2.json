ignificant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.785657,"donor_log2fc":-0.185232,"donor_lfcse":0.143053,"donor_log2fc_shrunk":-0.0101685,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"In","gene_id":"ENSG00000101977","module":"red","kme":0.232724,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101977","entrez_id":["4168"],"uniprot":["P10911"],"ncbi_summary":"The oncogenic protein encoded by this gene is a guanine nucleotide exchange factor (GEF) that exerts control over some members of the Rho family of small GTPases. Several transcript variants encoding different isoforms have been found for this gene. These isoforms exhibit different expression patterns and varying levels of GEF activity.[provided by RefSeq, Jan 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P10911","text":"Guanine nucleotide exchange factor (GEF) that modulates the Rho family of GTPases. Promotes the conversion of some member of the Rho family GTPase from the GDP-bound to the GTP-bound form. Isoform 1 exhibits no activity toward RHOA, RAC1 or CDC42. Isoform 2 exhibits decreased GEF activity toward CDC42. Isoform 3 exhibits a weak but significant activity toward RAC1 and CDC42. Isoform 4 exhibits significant activity toward RHOA and CDC42. The truncated DBL oncogene is active toward RHOA, RAC1 and CDC42."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}