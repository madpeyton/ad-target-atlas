_symbol_current":"AK9","gene_id":"ENSG00000155085","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":6.25229e-35,"nucleus_log2fc":0.311623,"nucleus_score":12.4918,"pct_ad":0.256391,"pct_control":0.218613,"donor_test":"not significant","donor_padj":0.524355,"donor_log2fc":0.231233,"donor_lfcse":0.0999003,"donor_log2fc_shrunk":0.0328634,"degas_log2fc":-0.170078,"degas_padj":3.73518e-12}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000155085","module":"yellow","kme":0.194515,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000155085","entrez_id":["221264"],"uniprot":["Q5TCS8"],"ncbi_summary":"The protein encoded by this gene catalyzes the interconversion of nucleosides, possessing both nucleoside monophosphate and diphosphate kinase activities. The encoded protein uses these interconversions to maintain nucleoside homeostasis. [provided by RefSeq, Jul 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5TCS8","text":"Broad-specificity nucleoside phosphate kinase involved in cellular nucleotide homeostasis by catalyzing nucleoside-phosphate interconversions. Similar to other adenylate kinases, preferentially catalyzes the phosphorylation of the nucleoside monophosphate AMP with ATP as phosphate donor to produce ADP. In vitro, can also catalyze the phosphorylation of CMP, dAMP and dCMP and use GTP as an alternate phosphate donor. Moreover, exhibits a diphosphate kinase activity, producing ATP, CTP, GTP, UTP, TTP, dATP, dCTP and dGTP from the corresponding diphosphate substrates with either ATP or GTP as phosphate donors. For this activity shows the following substrate preference CDP > UDP > ADP > TDP."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}