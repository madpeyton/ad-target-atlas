icant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0273661,"nucleus_log2fc":-0.0973218,"nucleus_score":-2.6711,"pct_ad":0.560245,"pct_control":0.570533,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0870414,"donor_lfcse":0.0806091,"donor_log2fc_shrunk":-1.38151e-05,"degas_log2fc":-0.17853,"degas_padj":3.62707e-07},{"cell_type":"Oli","gene_symbol":"SLF2","gene_symbol_current":"SLF2","gene_id":"ENSG00000119906","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":7.25418e-45,"nucleus_log2fc":-0.191732,"nucleus_score":-14.2154,"pct_ad":0.628701,"pct_control":0.671603,"donor_test":"not significant","donor_padj":0.768859,"donor_log2fc":-0.119484,"donor_lfcse":0.0877569,"donor_log2fc_shrunk":-0.0170208,"degas_log2fc":-0.270085,"degas_padj":7.239e-87}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000119906","module":"green","kme":0.191126,"hub":false,"module_direction":"lower in AD","module_padj":0.299526,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000119906","module":"black","kme":0.163806,"hub":false,"module_direction":"lower in AD","module_padj":0.663532,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000119906","module":"yellow","kme":0.245905,"hub":false,"module_direction":"lower in AD","module_padj":0.0240838,"module_significant":true}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000119906","entrez_id":["55719"],"uniprot":["Q8IX21"],"ncbi_summary":"Enables ubiquitin protein ligase binding activity. Involved in several processes, including positive regulation of cellular component organization; positive regulation of double-strand break repair; and protein localization to site of double-strand break. Located in chromatin; nucleoplasm; and site of double-strand break. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IX21","text":"Plays a role in the DNA damage response (DDR) pathway by regulating postreplication repair of UV-damaged DNA and genomic stability maintenance (PubMed:25931565). The SLF1-SLF2 complex acts to link RAD18 with the SMC5-SMC6 complex at replication-coupled interstrand cross-links (ICL) and DNA double-strand breaks (DSBs) sites on chromatin during DNA repair in response to stalled replication forks (PubMed:25931565). Promotes the recruitment of the SMC5-SMC6 complex to DNA lesions (PubMed:25931565). Plays a role in SMC5-SMC6 complex recruitment for viral restriction. Forms a complex with SIMC1 and this complex is required to recruit SMC5-SMC6 complex to PML nuclear bodies and sites of viral replication (PubMed:36373674)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}