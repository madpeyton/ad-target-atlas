nor_log2fc_shrunk":-4.07365e-06},{"cell_type":"OPC","gene_symbol":"SLF2","gene_symbol_current":"SLF2","gene_id":"ENSG00000119906","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.554551,"nucleus_log2fc":-0.122798,"nucleus_score":-1.1488,"pct_ad":0.176609,"pct_control":0.196169,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":-0.116267,"donor_lfcse":0.150189,"donor_log2fc_shrunk":-0.00105137},{"cell_type":"Oli","gene_symbol":"SLF2","gene_symbol_current":"SLF2","gene_id":"ENSG00000119906","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.182669,"nucleus_log2fc":-0.114536,"nucleus_score":-1.60906,"pct_ad":0.163608,"pct_control":0.171532,"donor_test":"not significant","donor_padj":0.944582,"donor_log2fc":-0.0440313,"donor_lfcse":0.0974187,"donor_log2fc_shrunk":-0.00419001}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000119906","module":"blue","kme":0.158417,"hub":false,"module_direction":"lower in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000119906","entrez_id":["55719"],"uniprot":["Q8IX21"],"ncbi_summary":"Enables ubiquitin protein ligase binding activity. Involved in several processes, including positive regulation of cellular component organization; positive regulation of double-strand break repair; and protein localization to site of double-strand break. Located in chromatin; nucleoplasm; and site of double-strand break. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IX21","text":"Plays a role in the DNA damage response (DDR) pathway by regulating postreplication repair of UV-damaged DNA and genomic stability maintenance (PubMed:25931565). The SLF1-SLF2 complex acts to link RAD18 with the SMC5-SMC6 complex at replication-coupled interstrand cross-links (ICL) and DNA double-strand breaks (DSBs) sites on chromatin during DNA repair in response to stalled replication forks (PubMed:25931565). Promotes the recruitment of the SMC5-SMC6 complex to DNA lesions (PubMed:25931565). Plays a role in SMC5-SMC6 complex recruitment for viral restriction. Forms a complex with SIMC1 and this complex is required to recruit SMC5-SMC6 complex to PML nuclear bodies and sites of viral replication (PubMed:36373674)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}