_log2fc_shrunk":-1.20941e-05},{"cell_type":"OPC","gene_symbol":"ATP1A2","gene_symbol_current":"ATP1A2","gene_id":"ENSG00000018625","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.128241,"nucleus_log2fc":0.263911,"nucleus_score":2.51514,"pct_ad":0.441915,"pct_control":0.409195,"donor_test":"not significant","donor_padj":0.890275,"donor_log2fc":0.273138,"donor_lfcse":0.111636,"donor_log2fc_shrunk":0.00469651}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000018625","module":"pink","kme":0.325568,"hub":true,"module_direction":"lower in AD","module_padj":0.923706,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000018625","module":"turquoise","kme":0.207015,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000018625","entrez_id":["477"],"uniprot":["P50993"],"ncbi_summary":"The protein encoded by this gene belongs to the family of P-type cation transport ATPases, and to the subfamily of Na+/K+ -ATPases. Na+/K+ -ATPase is an integral membrane protein responsible for establishing and maintaining the electrochemical gradients of Na and K ions across the plasma membrane. These gradients are essential for osmoregulation, for sodium-coupled transport of a variety of organic and inorganic molecules, and for electrical excitability of nerve and muscle. This enzyme is composed of two subunits, a large catalytic subunit (alpha) and a smaller glycoprotein subunit (beta). The catalytic subunit of Na+/K+ -ATPase is encoded by multiple genes. This gene encodes an alpha 2 subunit. Mutations in this gene result in familial basilar or hemiplegic migraines, and in a rare syndrome known as alternating hemiplegia of childhood. [provided by RefSeq, Oct 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P50993","text":"Catalytic subunit of the Na(+)/K(+)-ATPase that hydrolyzes ATP to exchange ions across the plasma membrane, exporting 3 Na(+) and importing 2 K(+) per cycle (PubMed:33880529). It undergoes ATP-driven conformational changes that allow alternating binding and release of Na(+) and K(+) ions across the membrane (By similarity). This process maintains essential Na(+) and K(+) gradients for membrane potential and cellular function (PubMed:33880529)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}