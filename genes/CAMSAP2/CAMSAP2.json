2","gene_symbol_current":"CAMSAP2","gene_id":"ENSG00000118200","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.77012,"nucleus_log2fc":0.135557,"nucleus_score":0.650606,"pct_ad":0.119311,"pct_control":0.108614,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"CAMSAP2","gene_symbol_current":"CAMSAP2","gene_id":"ENSG00000118200","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.998749,"nucleus_log2fc":-0.00228494,"nucleus_score":-0.00665142,"pct_ad":0.485871,"pct_control":0.489655,"donor_test":"not significant","donor_padj":0.990075,"donor_log2fc":0.0440884,"donor_lfcse":0.0834025,"donor_log2fc_shrunk":0.00128029},{"cell_type":"Oli","gene_symbol":"CAMSAP2","gene_symbol_current":"CAMSAP2","gene_id":"ENSG00000118200","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.889196,"nucleus_log2fc":-0.00252764,"nucleus_score":0.207477,"pct_ad":0.136471,"pct_control":0.134593,"donor_test":"not significant","donor_padj":0.971399,"donor_log2fc":-0.0160124,"donor_lfcse":0.0845014,"donor_log2fc_shrunk":-0.00194341}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000118200","module":"salmon","kme":0.234544,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000118200","entrez_id":["23271"],"uniprot":["Q08AD1"],"ncbi_summary":"Enables microtubule minus-end binding activity. Involved in several processes, including axon development; regulation of dendrite development; and regulation of organelle organization. Located in cytosol and microtubule end. Colocalizes with Golgi apparatus; centrosome; and microtubule minus-end. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q08AD1","text":"Key microtubule-organizing protein that specifically binds the minus-end of non-centrosomal microtubules and regulates their dynamics and organization (PubMed:23169647, PubMed:24486153, PubMed:24706919). Specifically recognizes growing microtubule minus-ends and autonomously decorates and stabilizes microtubule lattice formed by microtubule minus-end polymerization (PubMed:24486153, PubMed:24706919). Acts on free microtubule minus-ends that are not capped by microtubule-nucleating proteins or other factors and protects microtubule minus-ends from depolymerization (PubMed:24486153, PubMed:24706919). In addition, it also reduces the velocity of microtubule polymerization (PubMed:24486153, PubMed:24706919). Through the microtubule cytoskeleton, also regulates the organization of cellular organelles including the Golgi and the early endosomes (PubMed:27666745). Essential for the tethering, but not for nucleation of non-centrosomal microtubules at the Golgi: together with Golgi-associated proteins AKAP9 and PDE4DIP, required to tether non-centrosomal minus-end microtubules to the Golgi, an important step for polarized cell movement (PubMed:27666745). Also acts as a regulator of neuronal polarity and development: localizes to non-centrosomal microtubule minus-ends in neurons and stabilizes non-centrosomal microtubules, which is required for neuronal polarity, axon specification and dendritic branch formation (PubMed:24908486). Through the microtubule cytoskeleton, regulates the autophagosome transport (PubMed:28726242)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}