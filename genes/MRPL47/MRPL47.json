nor_padj":0.999899,"donor_log2fc":-0.00483824,"donor_lfcse":0.185358,"donor_log2fc_shrunk":-1.42801e-07}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000136522","module":"turquoise","kme":0.236266,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000136522","module":"turquoise","kme":0.213262,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136522","entrez_id":["57129"],"uniprot":["Q9HD33"],"ncbi_summary":"Mammalian mitochondrial ribosomal proteins are encoded by nuclear genes and help in protein synthesis within the mitochondrion. Mitochondrial ribosomes (mitoribosomes) consist of a small 28S subunit and a large 39S subunit. They have an estimated 75% protein to rRNA composition compared to prokaryotic ribosomes, where this ratio is reversed. Another difference between mammalian mitoribosomes and prokaryotic ribosomes is that the latter contain a 5S rRNA. Among different species, the proteins comprising the mitoribosome differ greatly in sequence, and sometimes in biochemical properties, which prevents easy recognition by sequence homology. This gene encodes a 39S subunit protein. This gene is immediately adjacent to the gene for BAF complex 53 kDa subunit protein a (BAF53a), in a tail-to-tail orientation. Two transcript variants encoding different protein isoforms have been identified. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}