3,"donor_lfcse":0.0966247,"donor_log2fc_shrunk":1.24201e-05},{"cell_type":"OPC","gene_symbol":"UBA6","gene_symbol_current":"UBA6","gene_id":"ENSG00000033178","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.202059,"nucleus_log2fc":-0.319388,"nucleus_score":-2.16313,"pct_ad":0.176609,"pct_control":0.208429,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":-0.192073,"donor_lfcse":0.168832,"donor_log2fc_shrunk":-0.00138613},{"cell_type":"Oli","gene_symbol":"UBA6","gene_symbol_current":"UBA6","gene_id":"ENSG00000033178","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0243215,"nucleus_log2fc":0.161423,"nucleus_score":2.58384,"pct_ad":0.114176,"pct_control":0.1019,"donor_test":"not significant","donor_padj":0.797653,"donor_log2fc":0.105817,"donor_lfcse":0.0851967,"donor_log2fc_shrunk":0.013549}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000033178","module":"turquoise","kme":0.196004,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000033178","entrez_id":["55236"],"uniprot":["A0AVT1"],"ncbi_summary":"Modification of proteins with ubiquitin (UBB; MIM 191339) or ubiquitin-like proteins controls many signaling networks and requires a ubiquitin-activating enzyme (E1), a ubiquitin conjugating enzyme (E2), and a ubiquitin protein ligase (E3). UBE1L2 is an E1 enzyme that initiates the activation and conjugation of ubiquitin-like proteins (Jin et al., 2007 [PubMed 17597759]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"A0AVT1","text":"Activates ubiquitin by first adenylating its C-terminal glycine residue with ATP, and thereafter linking this residue to the side chain of a cysteine residue in E1, yielding a ubiquitin-E1 thioester and free AMP (PubMed:35970836, PubMed:35986001). Specific for ubiquitin, does not activate ubiquitin-like peptides. Also activates UBD/FAT10 conjugation via adenylation of its C-terminal glycine (PubMed:17889673, PubMed:35970836, PubMed:35986001). Differs from UBE1 in its specificity for substrate E2 charging. Does not charge cell cycle E2s, such as CDC34. Essential for embryonic development. Isoform 2 may play a key role in ubiquitin system and may influence spermatogenesis and male fertility."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}