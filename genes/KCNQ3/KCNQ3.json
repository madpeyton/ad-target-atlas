ll_type":"In","gene_symbol":"KCNQ3","gene_symbol_current":"KCNQ3","gene_id":"ENSG00000184156","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0296558,"nucleus_log2fc":-0.187803,"nucleus_score":-3.34972,"pct_ad":0.687666,"pct_control":0.723934,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.086279,"donor_lfcse":0.0728409,"donor_log2fc_shrunk":-1.05617e-05},{"cell_type":"Mic","gene_symbol":"KCNQ3","gene_symbol_current":"KCNQ3","gene_id":"ENSG00000184156","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0753962,"nucleus_log2fc":-0.382402,"nucleus_score":-2.67866,"pct_ad":0.523985,"pct_control":0.578027,"donor_test":"not significant","donor_padj":0.807697,"donor_log2fc":-0.20458,"donor_lfcse":0.165131,"donor_log2fc_shrunk":-0.00944303},{"cell_type":"OPC","gene_symbol":"KCNQ3","gene_symbol_current":"KCNQ3","gene_id":"ENSG00000184156","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.764736,"nucleus_log2fc":-0.0564934,"nucleus_score":-0.652403,"pct_ad":0.291209,"pct_control":0.30728,"donor_test":"not significant","donor_padj":0.993604,"donor_log2fc":-0.03589,"donor_lfcse":0.137812,"donor_log2fc_shrunk":-0.000186801},{"cell_type":"Oli","gene_symbol":"KCNQ3","gene_symbol_current":"KCNQ3","gene_id":"ENSG00000184156","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.937347,"donor_log2fc":-0.11148,"donor_lfcse":0.21344,"donor_log2fc_shrunk":-0.00233153}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000184156","module":"brown","kme":0.422855,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000184156","module":"blue","kme":0.167284,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000184156","entrez_id":["3786"],"uniprot":["O43525"],"ncbi_summary":"This gene encodes a protein that functions in the regulation of neuronal excitability. The encoded protein forms an M-channel by associating with the products of the related KCNQ2 or KCNQ5 genes, which both encode integral membrane proteins. M-channel currents are inhibited by M1 muscarinic acetylcholine receptors and are activated by retigabine, a novel anti-convulsant drug. Defects in this gene are a cause of benign familial neonatal convulsions type 2 (BFNC2), also known as epilepsy, benign neonatal type 2 (EBN2). Alternative splicing of this gene results in multiple transcript variants. [provided by RefSeq, May 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43525","text":"Pore-forming subunit of the voltage-gated potassium (Kv) M-channel which is responsible for the M-current, a key controller of neuronal excitability (PubMed:16319223, PubMed:27564677, PubMed:28793216, PubMed:9872318). M-channel is composed of pore-forming subunits KCNQ2 and KCNQ3 assembled as heterotetramers (PubMed:14534157, PubMed:16319223, PubMed:27564677, PubMed:9872318). The native M-current has a slowly activating and deactivating potassium conductance which plays a critical role in determining the subthreshold electrical excitability of neurons as well as the responsiveness to synaptic inputs (PubMed:14534157, PubMed:16319223, PubMed:28793216). M-channel is selectively permeable in vitro to other cations besides potassium, in decreasing order of affinity K(+) > Rb(+) > Cs(+) > Na(+) (PubMed:28793216). M-channel association with SLC5A3/SMIT1 alters channel ion selectivity, increasing Na(+) and Cs(+) permeation relative to K(+) (PubMed:28793216). Suppressed by activation of M1 muscarinic acetylcholine receptors (PubMed:10713961). KCNQ3 also associates with KCNQ5 to form a functional channel in vitro and may also contribute to the M-current in brain (PubMed:11159685)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}