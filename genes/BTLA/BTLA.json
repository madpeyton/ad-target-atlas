:null,"donor_test":"not significant","donor_padj":0.945813,"donor_log2fc":0.042425,"donor_lfcse":0.1509,"donor_log2fc_shrunk":0.000851911},{"cell_type":"Oli","gene_symbol":"BTLA","gene_symbol_current":"BTLA","gene_id":"ENSG00000186265","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.927466,"donor_log2fc":-0.161697,"donor_lfcse":0.274682,"donor_log2fc_shrunk":-0.00241418}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000186265","entrez_id":["151888"],"uniprot":["Q7Z6A9"],"ncbi_summary":"This gene encodes a member of the immunoglobulin superfamily. The encoded protein contains a single immunoglobulin (Ig) domain and is a receptor that relays inhibitory signals to suppress the immune response. Alternative splicing results in multiple transcript variants. Polymorphisms in this gene have been associated with an increased risk of rheumatoid arthritis. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q7Z6A9","text":"Inhibitory receptor on lymphocytes that negatively regulates antigen receptor signaling via PTPN6/SHP-1 and PTPN11/SHP-2 (PubMed:12796776, PubMed:14652006, PubMed:15568026, PubMed:18193050). May interact in cis (on the same cell) or in trans (on other cells) with TNFRSF14 (PubMed:19915044). In cis interactions, appears to play an immune regulatory role inhibiting in trans interactions in naive T cells to maintain a resting state. In trans interactions, can predominate during adaptive immune response to provide survival signals to effector T cells (PubMed:19915044)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-11-06"}],"structures":[],"alphafold_accessions":[]}