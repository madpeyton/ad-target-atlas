ent":"BRIP1","gene_id":"ENSG00000136492","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":3.1634e-12,"nucleus_log2fc":0.178465,"nucleus_score":7.07139,"pct_ad":0.118523,"pct_control":0.108388,"donor_test":"not significant","donor_padj":0.603525,"donor_log2fc":0.239987,"donor_lfcse":0.0825774,"donor_log2fc_shrunk":0.152667},{"cell_type":"Mic","gene_symbol":"BRIP1","gene_symbol_current":"BRIP1","gene_id":"ENSG00000136492","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.685911,"donor_log2fc":-0.635106,"donor_lfcse":0.50356,"donor_log2fc_shrunk":-0.00509342},{"cell_type":"Oli","gene_symbol":"BRIP1","gene_symbol_current":"BRIP1","gene_id":"ENSG00000136492","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.826097,"donor_log2fc":0.166736,"donor_lfcse":0.149647,"donor_log2fc_shrunk":0.00818131}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136492","entrez_id":["83990"],"uniprot":["Q9BX63"],"ncbi_summary":"The protein encoded by this gene is a member of the RecQ DEAH helicase family and interacts with the BRCT repeats of breast cancer, type 1 (BRCA1). The bound complex is important in the normal double-strand break repair function of breast cancer, type 1 (BRCA1). This gene may be a target of germline cancer-inducing mutations. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BX63","text":"DNA-dependent ATPase and 5'-3' DNA helicase required for the maintenance of chromosomal stability (PubMed:11301010, PubMed:14983014, PubMed:16116421, PubMed:16153896, PubMed:17596542, PubMed:36608669). Acts late in the Fanconi anemia pathway, after FANCD2 ubiquitination (PubMed:14983014, PubMed:16153896). Involved in the repair of DNA double-strand breaks by homologous recombination in a manner that depends on its association with BRCA1 (PubMed:14983014, PubMed:16153896). Involved in the repair of abasic sites at replication forks by promoting the degradation of DNA-protein cross-links: acts by catalyzing unfolding of HMCES DNA-protein cross-link via its helicase activity, exposing the underlying DNA and enabling cleavage of the DNA-protein adduct by the SPRTN metalloprotease (PubMed:16116421, PubMed:36608669). Can unwind RNA:DNA substrates (PubMed:14983014). Unwinds G-quadruplex DNA; unwinding requires a 5'-single stranded tail (PubMed:18426915, PubMed:20639400)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}