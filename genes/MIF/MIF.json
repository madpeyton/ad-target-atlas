e":"turquoise","kme":0.270757,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2+","gene_id":"ENSG00000240972","module":"turquoise","kme":0.457831,"hub":false,"module_direction":"higher in AD","module_padj":0.789273,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000240972","module":"turquoise","kme":0.397184,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000240972","module":"turquoise","kme":0.325493,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000240972","module":"turquoise","kme":0.230243,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000240972","module":"brown","kme":0.275066,"hub":false,"module_direction":"higher in AD","module_padj":0.137697,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000240972","module":"red","kme":0.357403,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000240972","entrez_id":["4282"],"uniprot":["P14174"],"ncbi_summary":"This gene encodes a lymphokine involved in cell-mediated immunity, immunoregulation, and inflammation. It plays a role in the regulation of macrophage function in host defense through the suppression of anti-inflammatory effects of glucocorticoids. This lymphokine and the JAB1 protein form a complex in the cytosol near the peripheral plasma membrane, which may indicate an additional role in integrin signaling pathways. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P14174","text":"Pro-inflammatory cytokine involved in the innate immune response to bacterial pathogens (PubMed:15908412, PubMed:17443469, PubMed:23776208). The expression of MIF at sites of inflammation suggests a role as mediator in regulating the function of macrophages in host defense (PubMed:15908412, PubMed:17443469, PubMed:23776208). Counteracts the anti-inflammatory activity of glucocorticoids (PubMed:15908412, PubMed:17443469, PubMed:23776208). Has phenylpyruvate tautomerase and dopachrome tautomerase activity (in vitro), but the physiological substrate is not known (PubMed:11439086, PubMed:17526494). It is not clear whether the tautomerase activity has any physiological relevance, and whether it is important for cytokine activity (PubMed:11439086, PubMed:17526494)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}