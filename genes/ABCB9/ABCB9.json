null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.233648,"donor_lfcse":0.158525,"donor_log2fc_shrunk":-9.4709e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"ABCB9","gene_symbol_current":"ABCB9","gene_id":"ENSG00000150967","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0585635,"nucleus_log2fc":-0.056672,"nucleus_score":-2.01968,"pct_ad":0.140356,"pct_control":0.145695,"donor_test":"not significant","donor_padj":0.991636,"donor_log2fc":-0.00670174,"donor_lfcse":0.0849633,"donor_log2fc_shrunk":-0.000837437,"degas_log2fc":-0.0991425,"degas_padj":0.00171714}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000150967","module":"yellow","kme":0.143295,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000150967","module":"blue","kme":0.136369,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000150967","module":"turquoise","kme":0.0776695,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000150967","entrez_id":["23457"],"uniprot":["Q9NP78"],"ncbi_summary":"The membrane-associated protein encoded by this gene is a member of the superfamily of ATP-binding cassette (ABC) transporters. ABC proteins transport various molecules across extra- and intra-cellular membranes. ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, White). This protein is a member of the MDR/TAP subfamily. Members of the MDR/TAP subfamily are involved in multidrug resistance as well as antigen presentation. This family member functions in the translocation of peptides from the cytosol into the lysosomal lumen. Alternative splicing of this gene results in distinct isoforms which are likely to have different substrate specificities. [provided by RefSeq, Jul 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NP78","text":"ATP-dependent low-affinity peptide transporter which translocates a broad spectrum of peptides from the cytosol to the lysosomal lumen for degradation (PubMed:15863492, PubMed:17977821, PubMed:18434309, PubMed:22641697, PubMed:25646430, PubMed:30353140, PubMed:30877195, PubMed:31417173). Displays a broad peptide length specificity from 6-mer up to at least 59-mer peptides with an optimum of 23-mers (PubMed:15863492, PubMed:25646430). Binds and transports smaller and larger peptides with the same affinity (PubMed:31417173). Favors positively charged, aromatic or hydrophobic residues in the N- and C-terminal positions whereas negatively charged residues as well as asparagine and methionine are not favored (PubMed:15863492, PubMed:17977821, PubMed:18434309)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}