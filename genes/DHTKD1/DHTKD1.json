le_padj":0.56571,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000181192","module":"green","kme":0.108222,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000181192","module":"yellow","kme":0.125049,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000181192","entrez_id":["55526"],"uniprot":["Q96HY7"],"ncbi_summary":"This gene encodes a component of a mitochondrial 2-oxoglutarate-dehydrogenase-complex-like protein involved in the degradation pathways of several amino acids, including lysine. Mutations in this gene are associated with 2-aminoadipic 2-oxoadipic aciduria and Charcot-Marie-Tooth Disease Type 2Q. [provided by RefSeq, May 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96HY7","text":"2-oxoadipate dehydrogenase (E1a) component of the 2-oxoadipate dehydrogenase complex (OADHC) (PubMed:29191460, PubMed:29752936, PubMed:32303640, PubMed:32633484, PubMed:32695416). Participates in the first step, rate limiting for the overall conversion of 2-oxoadipate (alpha-ketoadipate) to glutaryl-CoA and CO(2) catalyzed by the whole OADHC (PubMed:29191460, PubMed:32695416). Catalyzes the irreversible decarboxylation of 2-oxoadipate via the thiamine diphosphate (ThDP) cofactor and subsequent transfer of the decarboxylated acyl intermediate on an oxidized dihydrolipoyl group that is covalently amidated to the E2 enzyme (dihydrolipoyllysine-residue succinyltransferase or DLST) (Probable) (PubMed:29752936, PubMed:32303640, PubMed:32633484). Can catalyze the decarboxylation of 2-oxoglutarate in vitro, but at a much lower rate than 2-oxoadipate (PubMed:29191460, PubMed:29752936, PubMed:32633484, PubMed:32695416). Responsible for the last step of L-lysine, L-hydroxylysine and L-tryptophan catabolism with the common product being 2-oxoadipate (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}