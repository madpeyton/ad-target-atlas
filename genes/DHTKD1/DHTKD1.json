s_padj":3.16298e-12},{"cell_type":"Oli","gene_symbol":"DHTKD1","gene_symbol_current":"DHTKD1","gene_id":"ENSG00000181192","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0254188,"nucleus_log2fc":0.0554892,"nucleus_score":2.36702,"pct_ad":0.243623,"pct_control":0.236259,"donor_test":"not significant","donor_padj":0.930178,"donor_log2fc":0.0541181,"donor_lfcse":0.0970247,"donor_log2fc_shrunk":0.00573762,"degas_log2fc":-0.240336,"degas_padj":2.21212e-23}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000181192","module":"yellow","kme":0.155579,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000181192","module":"blue","kme":0.118119,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000181192","entrez_id":["55526"],"uniprot":["Q96HY7"],"ncbi_summary":"This gene encodes a component of a mitochondrial 2-oxoglutarate-dehydrogenase-complex-like protein involved in the degradation pathways of several amino acids, including lysine. Mutations in this gene are associated with 2-aminoadipic 2-oxoadipic aciduria and Charcot-Marie-Tooth Disease Type 2Q. [provided by RefSeq, May 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96HY7","text":"2-oxoadipate dehydrogenase (E1a) component of the 2-oxoadipate dehydrogenase complex (OADHC) (PubMed:29191460, PubMed:29752936, PubMed:32303640, PubMed:32633484, PubMed:32695416). Participates in the first step, rate limiting for the overall conversion of 2-oxoadipate (alpha-ketoadipate) to glutaryl-CoA and CO(2) catalyzed by the whole OADHC (PubMed:29191460, PubMed:32695416). Catalyzes the irreversible decarboxylation of 2-oxoadipate via the thiamine diphosphate (ThDP) cofactor and subsequent transfer of the decarboxylated acyl intermediate on an oxidized dihydrolipoyl group that is covalently amidated to the E2 enzyme (dihydrolipoyllysine-residue succinyltransferase or DLST) (Probable) (PubMed:29752936, PubMed:32303640, PubMed:32633484). Can catalyze the decarboxylation of 2-oxoglutarate in vitro, but at a much lower rate than 2-oxoadipate (PubMed:29191460, PubMed:29752936, PubMed:32633484, PubMed:32695416). Responsible for the last step of L-lysine, L-hydroxylysine and L-tryptophan catabolism with the common product being 2-oxoadipate (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}