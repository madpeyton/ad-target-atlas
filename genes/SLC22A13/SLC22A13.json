core":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.488907,"donor_log2fc":0.115178,"donor_lfcse":0.0790845,"donor_log2fc_shrunk":0.0143496}],"modules":[],"degas_bulk_de":false,"drug_target":false},"seaad_pfc":{"dataset_label":"SEA-AD (Gabitto et al. 2024)","gene_ids":["ENSG00000172940"],"dataset_symbols":["SLC22A13"],"explorer":"explorer.html?dataset=seaad_pfc#gene/SLC22A13","cell_types":[{"cell_type":"Ast","gene_symbol":"SLC22A13","gene_symbol_current":"SLC22A13","gene_id":"ENSG00000172940","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.635561,"donor_log2fc":0.529294,"donor_lfcse":0.239754,"donor_log2fc_shrunk":0.00597001},{"cell_type":"Ex","gene_symbol":"SLC22A13","gene_symbol_current":"SLC22A13","gene_id":"ENSG00000172940","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.0538706,"nucleus_log2fc":0.0376083,"nucleus_score":-1.97507,"pct_ad":0.172818,"pct_control":0.177912,"donor_test":"not significant","donor_padj":0.840543,"donor_log2fc":0.0655091,"donor_lfcse":0.107414,"donor_log2fc_shrunk":0.00488765},{"cell_type":"In","gene_symbol":"SLC22A13","gene_symbol_current":"SLC22A13","gene_id":"ENSG00000172940","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.739207,"donor_log2fc":0.168063,"donor_lfcse":0.11354,"donor_log2fc_shrunk":0.00629124}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000172940","module":"blue","kme":0.0628746,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000172940","entrez_id":["9390"],"uniprot":["Q9Y226"],"ncbi_summary":"This gene encodes a member of the organic-cation transporter family. It is located in a gene cluster with another member of the family, organic cation transporter like 4. The encoded protein is a transmembrane protein involved in the transport of small molecules. This protein can function to mediate urate uptake and is a high affinity nicotinate exchanger in the kidneys and the intestine. [provided by RefSeq, Sep 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y226","text":"Anion antiporter that mediates the transport of urate, orotate and nicotinate in exchange for organic or inorganic anions (PubMed:18411268, PubMed:31780526, PubMed:35144162, PubMed:35462902). Translocates urate and orotate across the apical membrane of proximal tubule epithelial cells and involved in urate renal reabsorption (PubMed:18411268, PubMed:31780526, PubMed:35144162). Possibly involved in orotate renal reabsorption and nicotinate intestinal reabsorption (PubMed:18411268, PubMed:35144162). Mediates urate uptake by an exchange with organic anions such as (S)-lactate, succinate, glutathione and nicotinate (PubMed:18411268). Urate and orotate transports are Cl(-)-dependent (PubMed:35144162, PubMed:35462902). Shows similar transport characteristics as the urate/orotate renal antiporter SLC22A12/URAT1 and may act as a compensator of SLC22A12/URAT1 in certain conditions (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}