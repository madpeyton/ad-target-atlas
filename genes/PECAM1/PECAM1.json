e_id":"ENSG00000261371","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.735075,"donor_log2fc":0.211005,"donor_lfcse":0.133222,"donor_log2fc_shrunk":0.00576091,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Mic","gene_symbol":"PECAM1","gene_symbol_current":"PECAM1","gene_id":"ENSG00000261371","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.958073,"nucleus_log2fc":-0.00277204,"nucleus_score":0.0707115,"pct_ad":0.369359,"pct_control":0.366935,"donor_test":"not significant","donor_padj":0.997976,"donor_log2fc":-0.00170118,"donor_lfcse":0.17742,"donor_log2fc_shrunk":0.000108867,"degas_log2fc":0.700756,"degas_padj":1.5522e-77},{"cell_type":"Oli","gene_symbol":"PECAM1","gene_symbol_current":"PECAM1","gene_id":"ENSG00000261371","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.702196,"donor_log2fc":0.312735,"donor_lfcse":0.194825,"donor_log2fc_shrunk":0.00921619,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000261371","module":"green","kme":0.200054,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000261371","entrez_id":["5175"],"uniprot":["P16284"],"ncbi_summary":"The protein encoded by this gene is found on the surface of platelets, monocytes, neutrophils, and some types of T-cells, and makes up a large portion of endothelial cell intercellular junctions. The encoded protein is a member of the immunoglobulin superfamily and is likely involved in leukocyte migration, angiogenesis, and integrin activation. [provided by RefSeq, May 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P16284","text":"Cell adhesion molecule which is required for leukocyte transendothelial migration (TEM) under most inflammatory conditions (PubMed:17580308, PubMed:19342684). Tyr-690 plays a critical role in TEM and is required for efficient trafficking of PECAM1 to and from the lateral border recycling compartment (LBRC) and is also essential for the LBRC membrane to be targeted around migrating leukocytes (PubMed:19342684). Trans-homophilic interaction may play a role in endothelial cell-cell adhesion via cell junctions (PubMed:27958302). Heterophilic interaction with CD177 plays a role in transendothelial migration of neutrophils (PubMed:17580308). Homophilic ligation of PECAM1 prevents macrophage-mediated phagocytosis of neighboring viable leukocytes by transmitting a detachment signal (PubMed:12110892). Promotes macrophage-mediated phagocytosis of apoptotic leukocytes by tethering them to the phagocytic cells; PECAM1-mediated detachment signal appears to be disabled in apoptotic leukocytes (PubMed:12110892). Modulates bradykinin receptor BDKRB2 activation (PubMed:18672896). Regulates bradykinin- and hyperosmotic shock-induced ERK1/2 activation in endothelial cells (PubMed:18672896). Induces susceptibility to atherosclerosis (By similarity). [Isoform Delta15]: Does not protect against apoptosis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}