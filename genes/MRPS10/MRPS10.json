"gene_id":"ENSG00000048544","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000492013,"nucleus_log2fc":-0.186244,"nucleus_score":-3.76665,"pct_ad":0.154307,"pct_control":0.172276,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.124462,"donor_lfcse":0.132537,"donor_log2fc_shrunk":-3.77243e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000048544","module":"turquoise","kme":0.20022,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000048544","module":"turquoise","kme":0.201208,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000048544","entrez_id":["55173"],"uniprot":["P82664"],"ncbi_summary":"Mammalian mitochondrial ribosomal proteins are encoded by nuclear genes and help in protein synthesis within the mitochondrion. Mitochondrial ribosomes (mitoribosomes) consist of a small 28S subunit and a large 39S subunit. They have an estimated 75% protein to rRNA composition compared to prokaryotic ribosomes, where this ratio is reversed. Another difference between mammalian mitoribosomes and prokaryotic ribosomes is that the latter contain a 5S rRNA. Among different species, the proteins comprising the mitoribosome differ greatly in sequence, and sometimes in biochemical properties, which prevents easy recognition by sequence homology. This gene encodes a 28S subunit protein that belongs to the ribosomal protein S10P family. Pseudogenes corresponding to this gene are found on chromosomes 1q, 3p, and 9p. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}