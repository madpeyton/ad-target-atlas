8944,"donor_log2fc_shrunk":-0.00119524,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Mic","gene_symbol":"CYSLTR1","gene_symbol_current":"CYSLTR1","gene_id":"ENSG00000173198","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":9.32231e-13,"nucleus_log2fc":-0.459736,"nucleus_score":-7.45868,"pct_ad":0.11337,"pct_control":0.149309,"donor_test":"not significant","donor_padj":0.511051,"donor_log2fc":-0.48142,"donor_lfcse":0.266867,"donor_log2fc_shrunk":-0.0151419,"degas_log2fc":0.635449,"degas_padj":1.50908e-22}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000173198","module":"green","kme":0.180931,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000173198","entrez_id":["10800"],"uniprot":["Q9Y271"],"ncbi_summary":"This gene encodes a member of the G-protein coupled receptor 1 family. The encoded protein is a receptor for cysteinyl leukotrienes, and is involved in mediating bronchoconstriction via activation of a phosphatidylinositol-calcium second messenger system. Activation of the encoded receptor results in contraction and proliferation of bronchial smooth muscle cells, eosinophil migration, and damage to the mucus layer in the lung. Upregulation of this gene is associated with asthma and dysregulation may also be implicated in cancer. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y271","text":"Receptor for cysteinyl leukotrienes mediating bronchoconstriction of individuals with and without asthma. Stimulation by LTD4 results in the contraction and proliferation of smooth muscle, edema, eosinophil migration and damage to the mucus layer in the lung. This response is mediated via a G protein that activates a phosphatidylinositol-calcium second messenger system. The rank order of affinities for the leukotrienes is LTD4 >> LTE4 = LTC4 >> LTB4."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}