,"explorer":"explorer.html?dataset=seaad_pfc#gene/PCDHA13","cell_types":[{"cell_type":"Ast","gene_symbol":"PCDHA13","gene_symbol_current":"PCDHA13","gene_id":"ENSG00000239389","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.727559,"donor_log2fc":0.324886,"donor_lfcse":0.196865,"donor_log2fc_shrunk":0.00526154,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Ex","gene_symbol":"PCDHA13","gene_symbol_current":"PCDHA13","gene_id":"ENSG00000239389","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.703387,"donor_log2fc":0.151114,"donor_lfcse":0.121537,"donor_log2fc_shrunk":0.00936638,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"PCDHA13","gene_symbol_current":"PCDHA13","gene_id":"ENSG00000239389","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.692967,"donor_log2fc":0.212341,"donor_lfcse":0.0980146,"donor_log2fc_shrunk":0.0114934,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000239389","entrez_id":["56136"],"uniprot":["Q9Y5I0"],"ncbi_summary":"This gene is a member of the protocadherin alpha gene cluster, one of three related gene clusters tandemly linked on chromosome five that demonstrate an unusual genomic organization similar to that of B-cell and T-cell receptor gene clusters. The alpha gene cluster is composed of 15 cadherin superfamily genes related to the mouse CNR genes and consists of 13 highly similar and 2 more distantly related coding sequences. The tandem array of 15 N-terminal exons, or variable exons, are followed by downstream C-terminal exons, or constant exons, which are shared by all genes in the cluster. The large, uninterrupted N-terminal exons each encode six cadherin ectodomains while the C-terminal exons encode the cytoplasmic domain. These neural cadherin-like cell adhesion proteins are integral plasma membrane proteins that most likely play a critical role in the establishment and function of specific cell-cell connections in the brain. Alternative splicing has been observed and additional variants have been suggested but their full-length nature has yet to be determined. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y5I0","text":"Potential calcium-dependent cell-adhesion protein. May be involved in the establishment and maintenance of specific neuronal connections in the brain."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}