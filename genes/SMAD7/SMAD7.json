:"turquoise","kme":0.0924208,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000101665","module":"blue","kme":0.323779,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000101665"],"dataset_symbols":["SMAD7"],"explorer":"explorer.html?dataset=mathys2019#gene/SMAD7","cell_types":[{"cell_type":"Ex","gene_symbol":"SMAD7","gene_symbol_current":"SMAD7","gene_id":"ENSG00000101665","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.2075,"donor_lfcse":0.147642,"donor_log2fc_shrunk":1.14514e-05}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000101665","module":"brown","kme":0.0821813,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101665","entrez_id":["4092"],"uniprot":["O15105"],"ncbi_summary":"The protein encoded by this gene is a nuclear protein that binds the E3 ubiquitin ligase SMURF2. Upon binding, this complex translocates to the cytoplasm, where it interacts with TGF-beta receptor type-1 (TGFBR1), leading to the degradation of both the encoded protein and TGFBR1. Expression of this gene is induced by TGFBR1. Variations in this gene are a cause of susceptibility to colorectal cancer type 3 (CRCS3). Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jun 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O15105","text":"Antagonist of signaling by TGF-beta (transforming growth factor) type 1 receptor superfamily members; has been shown to inhibit TGF-beta (Transforming growth factor) and activin signaling by associating with their receptors thus preventing SMAD2 access (PubMed:21791611). Functions as an adapter to recruit SMURF2 to the TGF-beta receptor complex. Also acts by recruiting the PPP1R15A-PP1 complex to TGFBR1, which promotes its dephosphorylation. Positively regulates PDPK1 kinase activity by stimulating its dissociation from the 14-3-3 protein YWHAQ which acts as a negative regulator."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}