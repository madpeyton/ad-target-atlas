ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5VWN6","text":"Core component of the HUSH2 complex, a multiprotein complex that mediates epigenetic repression of interferon-stimulated genes (PubMed:39013473, PubMed:39489739). TASOR2 is recruited to interferon-stimulated genes by IRF2, leading to transcriptional silencing by the HUSH2 complex via a H3K9me3-independent mechanism (PubMed:39013473). Within the HUSH2 complex, TASOR2 acts as the central scaffold, which recruits MPHOSPH8 and PPHLN1 (PubMed:39013473)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}