rue,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0157823,"nucleus_log2fc":0.183614,"nucleus_score":2.89163,"pct_ad":0.16448,"pct_control":0.145978,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0925486,"donor_lfcse":0.0942279,"donor_log2fc_shrunk":1.085e-05},{"cell_type":"Oli","gene_symbol":"TP53INP1","gene_symbol_current":"TP53INP1","gene_id":"ENSG00000164938","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000377229,"nucleus_log2fc":0.129772,"nucleus_score":3.70234,"pct_ad":0.110402,"pct_control":0.101748,"donor_test":"not significant","donor_padj":0.867386,"donor_log2fc":0.0929623,"donor_lfcse":0.100803,"donor_log2fc_shrunk":0.00908775}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000164938","module":"turquoise","kme":0.0660102,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000164938","module":"yellow","kme":0.171182,"hub":false,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000164938","module":"turquoise","kme":0.0215052,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164938","entrez_id":["94241"],"uniprot":["Q96A56"],"ncbi_summary":"Predicted to enable antioxidant activity. Involved in autophagic cell death; positive regulation of autophagy; and positive regulation of transcription, DNA-templated. Located in autophagosome; cytosol; and nucleus. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96A56","text":"Antiproliferative and proapoptotic protein involved in cell stress response which acts as a dual regulator of transcription and autophagy. Acts as a positive regulator of autophagy. In response to cellular stress or activation of autophagy, relocates to autophagosomes where it interacts with autophagosome-associated proteins GABARAP, GABARAPL1/L2, MAP1LC3A/B/C and regulates autophagy. Acts as an antioxidant and plays a major role in p53/TP53-driven oxidative stress response. Possesses both a p53/TP53-independent intracellular reactive oxygen species (ROS) regulatory function and a p53/TP53-dependent transcription regulatory function. Positively regulates p53/TP53 and p73/TP73 and stimulates their capacity to induce apoptosis and regulate cell cycle. In response to double-strand DNA breaks, promotes p53/TP53 phosphorylation on 'Ser-46' and subsequent apoptosis. Acts as a tumor suppressor by inducing cell death by an autophagy and caspase-dependent mechanism. Can reduce cell migration by regulating the expression of SPARC."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}