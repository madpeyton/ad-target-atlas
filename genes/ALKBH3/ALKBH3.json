":-0.0627397,"nucleus_score":-6.35692,"pct_ad":0.33564,"pct_control":0.350957,"donor_test":"not significant","donor_padj":0.996403,"donor_log2fc":-0.00119753,"donor_lfcse":0.0500683,"donor_log2fc_shrunk":-0.000164161},{"cell_type":"Mic","gene_symbol":"ALKBH3","gene_symbol_current":"ALKBH3","gene_id":"ENSG00000166199","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.830998,"nucleus_log2fc":-0.00606486,"nucleus_score":-0.280807,"pct_ad":0.124698,"pct_control":0.126152,"donor_test":"not significant","donor_padj":0.921035,"donor_log2fc":-0.0494662,"donor_lfcse":0.103486,"donor_log2fc_shrunk":-0.00888515},{"cell_type":"OPC","gene_symbol":"ALKBH3","gene_symbol_current":"ALKBH3","gene_id":"ENSG00000166199","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.150081,"nucleus_log2fc":-0.139746,"nucleus_score":-1.84766,"pct_ad":0.177006,"pct_control":0.188484,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.129816,"donor_lfcse":0.0871254,"donor_log2fc_shrunk":-1.78136e-05},{"cell_type":"Oli","gene_symbol":"ALKBH3","gene_symbol_current":"ALKBH3","gene_id":"ENSG00000166199","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00235213,"nucleus_log2fc":-0.0754314,"nucleus_score":-3.18235,"pct_ad":0.134435,"pct_control":0.143082,"donor_test":"not significant","donor_padj":0.86925,"donor_log2fc":-0.0619297,"donor_lfcse":0.0691255,"donor_log2fc_shrunk":-0.012474}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000166199","entrez_id":["221120"],"uniprot":["Q96Q83"],"ncbi_summary":"The Escherichia coli AlkB protein protects against the cytotoxicity of methylating agents by repair of the specific DNA lesions generated in single-stranded DNA. ALKBH2 (MIM 610602) and ALKBH3 are E. coli AlkB homologs that catalyze the removal of 1-methyladenine and 3-methylcytosine (Duncan et al., 2002 [PubMed 12486230]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96Q83","text":"Dioxygenase that mediates demethylation of DNA and RNA containing 1-methyladenosine (m1A) (PubMed:12486230, PubMed:12594517, PubMed:16174769, PubMed:26863196, PubMed:26863410). Repairs alkylated DNA containing 1-methyladenosine (m1A) and 3-methylcytosine (m3C) by oxidative demethylation (PubMed:12486230, PubMed:12594517, PubMed:16174769, PubMed:25944111). Has a strong preference for single-stranded DNA (PubMed:12486230, PubMed:12594517, PubMed:16174769, PubMed:20714506). Able to process alkylated m3C within double-stranded regions via its interaction with ASCC3, which promotes DNA unwinding to generate single-stranded substrate needed for ALKBH3 (PubMed:22055184). Can repair exocyclic 3,N4-ethenocytosine adducs in single-stranded DNA (PubMed:25797601). Also acts on RNA (PubMed:12594517, PubMed:16174769, PubMed:16858410, PubMed:26863196, PubMed:26863410). Demethylates N(1)-methyladenosine (m1A) RNA, an epigenetic internal modification of messenger RNAs (mRNAs) highly enriched within 5'-untranslated regions (UTRs) and in the vicinity of start codons (PubMed:26863196, PubMed:26863410). Requires molecular oxygen, alpha-ketoglutarate and iron (PubMed:16858410, PubMed:22055184)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}