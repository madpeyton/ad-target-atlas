ol":0.15072,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.00427842,"donor_lfcse":0.107448,"donor_log2fc_shrunk":3.91532e-07,"degas_log2fc":-0.0558603,"degas_padj":0.480395},{"cell_type":"Oli","gene_symbol":"FSCN1","gene_symbol_current":"FSCN1","gene_id":"ENSG00000075618","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":5.69941e-25,"nucleus_log2fc":0.233065,"nucleus_score":10.4818,"pct_ad":0.33187,"pct_control":0.299005,"donor_test":"not significant","donor_padj":0.507347,"donor_log2fc":0.255879,"donor_lfcse":0.107093,"donor_log2fc_shrunk":0.0312969,"degas_log2fc":0.0198197,"degas_padj":0.363553}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000075618","module":"red","kme":0.199584,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000075618","module":"turquoise","kme":0.0247246,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000075618","module":"turquoise","kme":0.079918,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000075618","entrez_id":["6624"],"uniprot":["Q16658"],"ncbi_summary":"This gene encodes a member of the fascin family of actin-binding proteins. Fascin proteins organize F-actin into parallel bundles, and are required for the formation of actin-based cellular protrusions. The encoded protein plays a critical role in cell migration, motility, adhesion and cellular interactions. Expression of this gene is known to be regulated by several microRNAs, and overexpression of this gene may play a role in the metastasis of multiple types of cancer by increasing cell motility. Expression of this gene is also a marker for Reed-Sternberg cells in Hodgkin's lymphoma. A pseudogene of this gene is located on the long arm of chromosome 15. [provided by RefSeq, Sep 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q16658","text":"Actin-binding protein that contains 2 major actin binding sites (PubMed:21685497, PubMed:23184945). Organizes filamentous actin into parallel bundles (PubMed:20393565, PubMed:21685497, PubMed:23184945). Plays a role in the organization of actin filament bundles and the formation of microspikes, membrane ruffles, and stress fibers (PubMed:22155786). Important for the formation of a diverse set of cell protrusions, such as filopodia, and for cell motility and migration (PubMed:20393565, PubMed:21685497, PubMed:23184945). Mediates reorganization of the actin cytoskeleton and axon growth cone collapse in response to NGF (PubMed:22155786)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}