tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.82607e-06,"nucleus_log2fc":-0.0444757,"nucleus_score":-4.82675,"pct_ad":0.143463,"pct_control":0.150663,"donor_test":"not significant","donor_padj":0.914887,"donor_log2fc":-0.0676104,"donor_lfcse":0.193953,"donor_log2fc_shrunk":-0.00162044},{"cell_type":"In","gene_symbol":"WNT7A","gene_symbol_current":"WNT7A","gene_id":"ENSG00000154764","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.996175,"donor_log2fc":-0.00228283,"donor_lfcse":0.0933802,"donor_log2fc_shrunk":-0.000176919},{"cell_type":"OPC","gene_symbol":"WNT7A","gene_symbol_current":"WNT7A","gene_id":"ENSG00000154764","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0670021,"donor_lfcse":0.185185,"donor_log2fc_shrunk":-1.99631e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000154764","module":"yellow","kme":0.113449,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000154764","module":"cyan","kme":0.309452,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000154764","entrez_id":["7476"],"uniprot":["O00755"],"ncbi_summary":"This gene is a member of the WNT gene family, which consists of structurally related genes that encode secreted signaling proteins. These proteins have been implicated in oncogenesis and in several developmental processes, including regulation of cell fate and patterning during embryogenesis. This gene is involved in the development of the anterior-posterior axis in the female reproductive tract, and also plays a critical role in uterine smooth muscle pattering and maintenance of adult uterine function. Mutations in this gene are associated with Fuhrmann and Al-Awadi/Raas-Rothschild/Schinzel phocomelia syndromes. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00755","text":"Ligand for members of the frizzled family of seven transmembrane receptors that functions in the canonical Wnt/beta-catenin signaling pathway (By similarity). Plays an important role in embryonic development, including dorsal versus ventral patterning during limb development, skeleton development and urogenital tract development (PubMed:16826533). Required for central nervous system (CNS) angiogenesis and blood-brain barrier regulation (PubMed:30026314). Required for normal, sexually dimorphic development of the Mullerian ducts, and for normal fertility in both sexes (By similarity). Required for normal neural stem cell proliferation in the hippocampus dentate gyrus (By similarity). Required for normal progress through the cell cycle in neural progenitor cells, for self-renewal of neural stem cells, and for normal neuronal differentiation and maturation (By similarity). Promotes formation of synapses via its interaction with FZD5 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}