:-0.36583,"degas_padj":6.81392e-19},{"cell_type":"Oli","gene_symbol":"SLC12A6","gene_symbol_current":"SLC12A6","gene_id":"ENSG00000140199","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":5.33665e-07,"nucleus_log2fc":-0.0870943,"nucleus_score":-5.17046,"pct_ad":0.310234,"pct_control":0.330645,"donor_test":"not significant","donor_padj":0.993725,"donor_log2fc":-0.00436678,"donor_lfcse":0.0794773,"donor_log2fc_shrunk":-0.000509031,"degas_log2fc":-0.274453,"degas_padj":9.0663e-39}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000140199","entrez_id":["9990"],"uniprot":["Q9UHW9"],"ncbi_summary":"This gene is a member of the K-Cl cotransporter (KCC) family. K-Cl cotransporters are integral membrane proteins that lower intracellular chloride concentrations below the electrochemical equilibrium potential. The proteins encoded by this gene are activated by cell swelling induced by hypotonic conditions. Alternate splicing results in multiple transcript variants encoding different isoforms. Mutations in this gene are associated with agenesis of the corpus callosum with peripheral neuropathy. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UHW9","text":"[Isoform 1]: Mediates electroneutral potassium-chloride cotransport when activated by cell swelling (PubMed:10600773, PubMed:11551954, PubMed:16048901, PubMed:18566107, PubMed:19665974, PubMed:21628467, PubMed:27485015). May contribute to cell volume homeostasis in single cells (PubMed:16048901, PubMed:27485015). [Isoform 2]: Mediates electroneutral potassium-chloride cotransport when activated by cell swelling (PubMed:16048901, PubMed:33199848, PubMed:34031912). May contribute to cell volume homeostasis in single cells (Probable). [Isoform 3]: Mediates electroneutral potassium-chloride cotransport when activated by cell swelling (PubMed:16048901). May contribute to cell volume homeostasis in single cells (Probable). [Isoform 4]: Mediates electroneutral potassium-chloride cotransport when activated by cell swelling (PubMed:16048901). May contribute to cell volume homeostasis in single cells (Probable). [Isoform 5]: Mediates electroneutral potassium-chloride cotransport when activated by cell swelling (PubMed:16048901). May contribute to cell volume homeostasis in single cells (Probable). [Isoform 6]: Mediates electroneutral potassium-chloride cotransport when activated by cell swelling (PubMed:16048901). May contribute to cell volume homeostasis in single cells (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}