:[{"cell_type":"Astrocytes","gene_id":"ENSG00000205336","module":"turquoise","kme":0.0970034,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2+","gene_id":"ENSG00000205336","module":"magenta","kme":0.217593,"hub":false,"module_direction":"lower in AD","module_padj":0.923266,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000205336","module":"brown","kme":0.202571,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000205336","module":"blue","kme":0.191426,"hub":false,"module_direction":"higher in AD","module_padj":0.851077,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000205336","module":"yellow","kme":0.275981,"hub":false,"module_direction":"lower in AD","module_padj":0.554841,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000205336","module":"turquoise","kme":0.587313,"hub":false,"module_direction":"lower in AD","module_padj":0.773167,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000205336","module":"blue","kme":0.36565,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000205336"],"dataset_symbols":["ADGRG1"],"explorer":"explorer.html?dataset=mathys2019#gene/ADGRG1","cell_types":[{"cell_type":"Ast","gene_symbol":"ADGRG1","gene_symbol_current":"ADGRG1","gene_id":"ENSG00000205336","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0908444,"nucleus_log2fc":0.221291,"nucleus_score":2.10226,"pct_ad":0.403548,"pct_control":0.383865,"donor_test":"not significant","donor_padj":0.636625,"donor_log2fc":0.287647,"donor_lfcse":0.165801,"donor_log2fc_shrunk":0.0236814},{"cell_type":"Ex","gene_symbol":"ADGRG1","gene_symbol_current":"ADGRG1","gene_id":"ENSG00000205336","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.180869,"donor_lfcse":0.164634,"donor_log2fc_shrunk":6.87712e-06},{"cell_type":"Mic","gene_symbol":"ADGRG1","gene_symbol_current":"ADGRG1","gene_id":"ENSG00000205336","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.007004,"nucleus_log2fc":0.67669,"nucleus_score":3.65899,"pct_ad":0.261993,"pct_control":0.183521,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"ADGRG1","gene_symbol_current":"ADGRG1","gene_id":"ENSG00000205336","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.18147,"nucleus_log2fc":0.249399,"nucleus_score":2.24503,"pct_ad":0.427786,"pct_control":0.400766,"donor_test":"not significant","donor_padj":0.940764,"donor_log2fc":0.280422,"donor_lfcse":0.134028,"donor_log2fc_shrunk":0.00325024}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000205336","module":"midnightblue","kme":0.291446,"hub":true,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000205336","entrez_id":["9289"],"uniprot":["Q9Y653"],"ncbi_summary":"This gene encodes a member of the G protein-coupled receptor family and regulates brain cortical patterning. The encoded protein binds specifically to transglutaminase 2, a component of tissue and tumor stroma implicated as an inhibitor of tumor progression. Mutations in this gene are associated with a brain malformation known as bilateral frontoparietal polymicrogyria. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Feb 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y653","text":"Adhesion G protein-coupled receptor (aGPCR) for steroid hormone 17alpha-hydroxypregnenolone (17-OH), which is involved in cell adhesion and cell-cell interactions (PubMed:39389061). Ligand binding causes a conformation change that triggers signaling via guanine nucleotide-binding proteins (G proteins) and modulates the activity of downstream effectors, such as RhoA pathway (PubMed:28874577, PubMed:35418682, PubMed:39389061). ADGRG1 is coupled to G(12) and/or G(13) G proteins (GNA12 and GNA13, respectively) and mediates the activation Rho small GTPases (PubMed:22238662, PubMed:28424266, PubMed:35418682, PubMed:39389061). Acts as a potent suppressor of ferroptosis: binding to 17-OH-binding initiates signaling that down-regulates CD36 and alleviates ferroptosis-induced liver injury (By similarity). Ligand-binding also induces cell adhesion activity via association with proteins such as collagen III/COL3A1 and TGM2 (By similarity). Mediates cell matrix adhesion in developing neurons and hematopoietic stem cells (By similarity). Involved in cortical development, specifically in maintenance of the pial basement membrane integrity and in cortical lamination: association with COL3A1 in the developing brain inhibits neuronal migration via activation of the RhoA pathway (PubMed:24531968). Together with TGM2, acts as a regulator of myelination and myelin repair in oligodendrocyte precursor cells (By similarity). Acts as a hemostatic sensor of shear force: G protein-coupled receptor signaling is activated in response to shear force in platelets, promoting G(13) G protein signaling, and platelet shape change and aggregation in a COL3A1-dependent manner (PubMed:33097663). Acts as an inhibitor of VEGFA production thereby inhibiting angiogenesis through a signaling pathway mediated by PRKCA (PubMed:16757564, PubMed:19572147, PubMed:21724588). Plays a role in the maintenance of hematopoietic stem cells in bone marrow niche (By similarity). Plays an essential role in testis development (By similarity). [Isoform 5]: Adhesion G protein-coupled receptor (aGPCR) for phosphatidylserine, which is involved in microglia-mediated synapse pruning during development (By similarity). Required to maintain appropriate synaptic numbers in several brain regions in a time- and circuit-dependent fashion: phosphatidylserine-binding acts as a 'eat-me' signal for apoptotic cells, leading to microglial engulfment of phosphatidylserine-positive synapses (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}