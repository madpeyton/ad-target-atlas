.00718185},{"cell_type":"Ex","gene_symbol":"VRK1","gene_symbol_current":"VRK1","gene_id":"ENSG00000100749","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":8.44469e-07,"nucleus_log2fc":0.0376763,"nucleus_score":4.97984,"pct_ad":0.683545,"pct_control":0.687795,"donor_test":"not significant","donor_padj":0.764508,"donor_log2fc":0.0851905,"donor_lfcse":0.0914062,"donor_log2fc_shrunk":0.00889925},{"cell_type":"In","gene_symbol":"VRK1","gene_symbol_current":"VRK1","gene_id":"ENSG00000100749","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.801308,"nucleus_log2fc":0.0018908,"nucleus_score":-0.270796,"pct_ad":0.415741,"pct_control":0.418073,"donor_test":"not significant","donor_padj":0.826764,"donor_log2fc":0.0526379,"donor_lfcse":0.0640147,"donor_log2fc_shrunk":0.00552673},{"cell_type":"Mic","gene_symbol":"VRK1","gene_symbol_current":"VRK1","gene_id":"ENSG00000100749","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.738596,"nucleus_log2fc":-0.015171,"nucleus_score":-0.432955,"pct_ad":0.172423,"pct_control":0.175,"donor_test":"not significant","donor_padj":0.989843,"donor_log2fc":-0.00839587,"donor_lfcse":0.122156,"donor_log2fc_shrunk":-0.00131479},{"cell_type":"OPC","gene_symbol":"VRK1","gene_symbol_current":"VRK1","gene_id":"ENSG00000100749","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.444135,"nucleus_log2fc":-0.0939577,"nucleus_score":-1.05761,"pct_ad":0.133313,"pct_control":0.139543,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.00445913,"donor_lfcse":0.103049,"donor_log2fc_shrunk":4.41167e-07},{"cell_type":"Oli","gene_symbol":"VRK1","gene_symbol_current":"VRK1","gene_id":"ENSG00000100749","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0529434,"nucleus_log2fc":-0.0218796,"nucleus_score":-2.06457,"pct_ad":0.169271,"pct_control":0.176323,"donor_test":"not significant","donor_padj":0.937408,"donor_log2fc":0.0417731,"donor_lfcse":0.0821359,"donor_log2fc_shrunk":0.00605004}],"modules":[{"cell_type":"In","gene_id":"ENSG00000100749","module":"yellow","kme":0.269464,"hub":false,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100749","entrez_id":["7443"],"uniprot":["Q99986"],"ncbi_summary":"This gene encodes a member of the vaccinia-related kinase (VRK) family of serine/threonine protein kinases. This gene is widely expressed in human tissues and has increased expression in actively dividing cells, such as those in testis, thymus, fetal liver, and carcinomas. Its protein localizes to the nucleus and has been shown to promote the stability and nuclear accumulation of a transcriptionally active p53 molecule and, in vitro, to phosphorylate Thr18 of p53 and reduce p53 ubiquitination. This gene, therefore, may regulate cell proliferation. This protein also phosphorylates histone, casein, and the transcription factors ATF2 (activating transcription factor 2) and c-JUN. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q99986","text":"Serine/threonine kinase involved in the regulation of key cellular processes including the cell cycle, nuclear condensation, transcription regulation, and DNA damage response (PubMed:14645249, PubMed:18617507, PubMed:19103756, PubMed:33076429). Controls chromatin organization and remodeling by mediating phosphorylation of histone H3 on 'Thr-4' and histone H2AX (H2aXT4ph) (PubMed:31527692, PubMed:37179361). It also phosphorylates KAT5 in response to DNA damage, promoting KAT5 association with chromatin and histone acetyltransferase activity (PubMed:33076429). Is involved in the regulation of cell cycle progression of neural progenitors, and is required for proper cortical neuronal migration (By similarity). Is involved in neurite elongation and branching in motor neurons, and has an essential role in Cajal bodies assembly, acting through COIL phosphorylation and the control of coilin degradation (PubMed:21920476, PubMed:31090908, PubMed:31527692). Involved in Golgi disassembly during the cell cycle: following phosphorylation by PLK3 during mitosis, it is required to induce Golgi fragmentation (PubMed:19103756). Phosphorylates BANF1: disrupts its ability to bind DNA, reduces its binding to LEM domain-containing proteins and causes its relocalization from the nucleus to the cytoplasm (PubMed:16495336). Phosphorylates TP53BP1 and p53/TP53 on 'Thr-18', preventing the interaction between p53/TP53 and MDM2 (PubMed:10951572, PubMed:31527692). Phosphorylates ATF2 which activates its transcriptional activity (PubMed:15105425). Phosphorylates JUN (PubMed:31527692)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}