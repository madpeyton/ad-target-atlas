0.457753,"pct_control":0.397465,"donor_test":"not significant","donor_padj":0.674275,"donor_log2fc":0.260607,"donor_lfcse":0.200788,"donor_log2fc_shrunk":0.0135145},{"cell_type":"OPC","gene_symbol":"CST3","gene_symbol_current":"CST3","gene_id":"ENSG00000101439","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.210695,"nucleus_log2fc":0.0458792,"nucleus_score":1.63627,"pct_ad":0.771548,"pct_control":0.767485,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0762745,"donor_lfcse":0.280619,"donor_log2fc_shrunk":-2.67457e-07},{"cell_type":"Oli","gene_symbol":"CST3","gene_symbol_current":"CST3","gene_id":"ENSG00000101439","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.977935,"donor_log2fc":-0.0471472,"donor_lfcse":0.266459,"donor_log2fc_shrunk":-0.000472882}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000101439","module":"turquoise","kme":0.631658,"hub":true,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000101439","module":"brown","kme":0.406124,"hub":false,"module_direction":"higher in AD","module_padj":0.939268,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000101439","module":"turquoise","kme":0.62393,"hub":true,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000101439","module":"turquoise","kme":0.0878421,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101439","entrez_id":["1471"],"uniprot":["P01034"],"ncbi_summary":"The cystatin superfamily encompasses proteins that contain multiple cystatin-like sequences. Some of the members are active cysteine protease inhibitors, while others have lost or perhaps never acquired this inhibitory activity. There are three inhibitory families in the superfamily, including the type 1 cystatins (stefins), type 2 cystatins and the kininogens. The type 2 cystatin proteins are a class of cysteine proteinase inhibitors found in a variety of human fluids and secretions, where they appear to provide protective functions. The cystatin locus on chromosome 20 contains the majority of the type 2 cystatin genes and pseudogenes. This gene is located in the cystatin locus and encodes the most abundant extracellular inhibitor of cysteine proteases, which is found in high concentrations in biological fluids and is expressed in virtually all organs of the body. A mutation in this gene has been associated with amyloid angiopathy. Expression of this protein in vascular wall smooth muscle cells is severely reduced in both atherosclerotic and aneurysmal aortic lesions, establishing its role in vascular disease. In addition, this protein has been shown to have an antimicrobial function, inhibiting the replication of herpes simplex virus. Alternative splicing results in multiple transcript variants encoding a single protein. [provided by RefSeq, Nov 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P01034","text":"As an inhibitor of cysteine proteinases, this protein is thought to serve an important physiological role as a local regulator of this enzyme activity."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}