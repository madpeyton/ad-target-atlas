j":0.775821},{"cell_type":"Oli","gene_symbol":"OTUD3","gene_symbol_current":"OTUD3","gene_id":"ENSG00000169914","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":6.57681e-05,"nucleus_log2fc":-0.127058,"nucleus_score":-4.14166,"pct_ad":0.115284,"pct_control":0.12552,"donor_test":"not significant","donor_padj":0.669744,"donor_log2fc":-0.138241,"donor_lfcse":0.0804519,"donor_log2fc_shrunk":-0.0255457,"degas_log2fc":-0.165817,"degas_padj":1.33883e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000169914","entrez_id":["23252"],"uniprot":["Q5T2D3"],"ncbi_summary":"Enables thiol-dependent deubiquitinase. Acts upstream of or within negative regulation of protein kinase B signaling; protein deubiquitination; and protein stabilization. Located in cytoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5T2D3","text":"Deubiquitinating enzyme that hydrolyzes 'Lys-6'- and 'Lys-11'-linked polyubiquitin. Also hydrolyzes heterotypic (mixed and branched) and homotypic chains (PubMed:23827681, PubMed:32011234, PubMed:35675826). Important regulator of energy metabolism (PubMed:35675826). Glucose and fatty acids trigger its nuclear translocation by CBP-dependent acetylation (PubMed:35675826). In the nucleus, deubiquitinates and stabilizes the nuclear receptor PPARD regulating the expression of various genes involved in glucose and lipid metabolism and oxidative phosphorylation (PubMed:35675826). Also acts as a negative regulator of the ribosome quality control (RQC) by mediating deubiquitination of 40S ribosomal proteins RPS10/eS10 and RPS20/uS10, thereby antagonizing ZNF598-mediated 40S ubiquitination (PubMed:32011234)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}