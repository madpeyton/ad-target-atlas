fc":0.0614418,"nucleus_score":1.85725,"pct_ad":0.316806,"pct_control":0.304839,"donor_test":"not significant","donor_padj":0.920658,"donor_log2fc":0.0509765,"donor_lfcse":0.105955,"donor_log2fc_shrunk":0.00825351,"degas_log2fc":-0.182747,"degas_padj":1.42984e-05},{"cell_type":"OPC","gene_symbol":"GLUD1","gene_symbol_current":"GLUD1","gene_id":"ENSG00000148672","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0293142,"nucleus_log2fc":0.123264,"nucleus_score":2.64355,"pct_ad":0.41023,"pct_control":0.388315,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0438376,"donor_lfcse":0.080352,"donor_log2fc_shrunk":7.12342e-06,"degas_log2fc":-0.153256,"degas_padj":0.000517315},{"cell_type":"Oli","gene_symbol":"GLUD1","gene_symbol_current":"GLUD1","gene_id":"ENSG00000148672","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":3.56595e-08,"nucleus_log2fc":0.110687,"nucleus_score":5.66901,"pct_ad":0.353852,"pct_control":0.334439,"donor_test":"not significant","donor_padj":0.916528,"donor_log2fc":0.0560757,"donor_lfcse":0.0841878,"donor_log2fc_shrunk":0.00779146,"degas_log2fc":-0.175807,"degas_padj":2.23423e-18}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000148672","module":"turquoise","kme":0.242505,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000148672","module":"blue","kme":0.176777,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000148672","module":"turquoise","kme":0.0193088,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000148672","entrez_id":["2746"],"uniprot":["P00367"],"ncbi_summary":"This gene encodes glutamate dehydrogenase, which is a mitochondrial matrix enzyme that catalyzes the oxidative deamination of glutamate to alpha-ketoglutarate and ammonia. This enzyme has an important role in regulating amino acid-induced insulin secretion. It is allosterically activated by ADP and inhibited by GTP and ATP. Activating mutations in this gene are a common cause of congenital hyperinsulinism. Alternative splicing of this gene results in multiple transcript variants. The related glutamate dehydrogenase 2 gene on the human X-chromosome originated from this gene via retrotransposition and encodes a soluble form of glutamate dehydrogenase. Related pseudogenes have been identified on chromosomes 10, 18 and X. [provided by RefSeq, Jan 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P00367","text":"Mitochondrial glutamate dehydrogenase that catalyzes the conversion of L-glutamate into alpha-ketoglutarate. Plays a key role in glutamine anaplerosis by producing alpha-ketoglutarate, an important intermediate in the tricarboxylic acid cycle (PubMed:11032875, PubMed:11254391, PubMed:16023112, PubMed:16959573). Plays a role in insulin homeostasis (PubMed:11297618, PubMed:9571255). May be involved in learning and memory reactions by increasing the turnover of the excitatory neurotransmitter glutamate (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}