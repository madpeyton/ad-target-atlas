not significant","donor_padj":0.712567,"donor_log2fc":-0.159034,"donor_lfcse":0.135188,"donor_log2fc_shrunk":-0.0175266},{"cell_type":"OPC","gene_symbol":"CHST10","gene_symbol_current":"CHST10","gene_id":"ENSG00000115526","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.780995,"nucleus_log2fc":-0.0540152,"nucleus_score":-0.433549,"pct_ad":0.127647,"pct_control":0.12989,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.122094,"donor_lfcse":0.0884106,"donor_log2fc_shrunk":-1.62443e-05},{"cell_type":"Oli","gene_symbol":"CHST10","gene_symbol_current":"CHST10","gene_id":"ENSG00000115526","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.952773,"donor_log2fc":-0.0331424,"donor_lfcse":0.0816011,"donor_log2fc_shrunk":-0.00484687}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000115526","module":"turquoise","kme":0.01272,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000115526","entrez_id":["9486"],"uniprot":["O43529"],"ncbi_summary":"This protein encoded by this gene transfers sulfate to the C-3 hydroxyl of terminal glucuronic acid of protein- and lipid-linked oligosaccharides. This protein was first identified as a sulfotransferase that acts on the human natural killer-1 (HNK-1) glycan; HNK-1 is a carbohydrate involved in neurodevelopment and synaptic plasticity.[provided by RefSeq, Feb 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43529","text":"Catalyzes the transfer of sulfate from 3'-phosphoadenylyl sulfate (PAPS) to position 3 of terminal glucuronic acid of both protein- and lipid-linked oligosaccharides. Participates in biosynthesis of HNK-1 carbohydrate structure 3-O-sulfo-beta-D-GlcA-(1->3)-beta-D-Gal-(1->4)-D-GlcNAc-R, a sulfated glucuronyl-lactosaminyl residue carried by many neural recognition molecules, which is involved in cell interactions during ontogenetic development and in synaptic plasticity in the adult. May be indirectly involved in synapse plasticity of the hippocampus, via its role in HNK-1 biosynthesis (PubMed:9478973). Sulfates terminal glucuronyl residue of the laminin globular (LG)-domain binding epitope on DAG1/alpha-dystroglycan and prevents further polymerization by LARGE1 glycosyltransferase. Likely defines the chain length of LG epitope, conferring binding specificity to extracellular matrix components (PubMed:32149355). Plays a role in down-regulating the steroid hormones. Sulfates glucuronidated estrogens and androgens with an impact in hormone cycle and fertility. Has a preference for glucuronyl moiety at the 3-hydroxyl group of a sterol ring rather than the 17-hydroxyl group, showing high catalytic efficiency for 17beta-estradiol 3-O-(beta-D-glucuronate) and dehydroepiandrosterone 3-O-(beta-D-glucuronate) hormones (PubMed:23269668)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}