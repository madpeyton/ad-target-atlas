ct_ad":0.353361,"pct_control":0.350483,"donor_test":"not significant","donor_padj":0.73555,"donor_log2fc":0.127678,"donor_lfcse":0.0829286,"donor_log2fc_shrunk":0.00906746},{"cell_type":"Mic","gene_symbol":"METTL4","gene_symbol_current":"METTL4","gene_id":"ENSG00000101574","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.5733e-05,"nucleus_log2fc":0.304364,"nucleus_score":4.52219,"pct_ad":0.116249,"pct_control":0.0963134,"donor_test":"not significant","donor_padj":0.252293,"donor_log2fc":0.264335,"donor_lfcse":0.0970237,"donor_log2fc_shrunk":0.167375},{"cell_type":"OPC","gene_symbol":"METTL4","gene_symbol_current":"METTL4","gene_id":"ENSG00000101574","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0924992,"nucleus_log2fc":0.105609,"nucleus_score":2.11604,"pct_ad":0.199672,"pct_control":0.184251,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0846376,"donor_lfcse":0.0965517,"donor_log2fc_shrunk":9.54601e-06},{"cell_type":"Oli","gene_symbol":"METTL4","gene_symbol_current":"METTL4","gene_id":"ENSG00000101574","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.6748e-12,"nucleus_log2fc":0.222342,"nucleus_score":7.15379,"pct_ad":0.180363,"pct_control":0.160897,"donor_test":"not significant","donor_padj":0.562326,"donor_log2fc":0.195905,"donor_lfcse":0.0915591,"donor_log2fc_shrunk":0.0295236}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000101574","module":"turquoise","kme":0.0934983,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101574","entrez_id":["64863"],"uniprot":["Q8N3J2"],"ncbi_summary":"Enables RNA methyltransferase activity and site-specific DNA-methyltransferase (adenine-specific) activity. Involved in nucleic acid metabolic process; regulation of RNA metabolic process; and regulation of mitochondrial DNA replication. Located in cytosol; mitochondrial matrix; and nucleus. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8N3J2","text":"N(6)-adenine-specific methyltransferase that can methylate both RNAs and DNA (PubMed:31913360, PubMed:32183942). Acts as a N(6)-adenine-specific RNA methyltransferase by catalyzing formation of N6,2'-O-dimethyladenosine (m6A(m)) on internal positions of U2 small nuclear RNA (snRNA): methylates the 6th position of adenine residues with a pre-deposited 2'-O-methylation (PubMed:31913360). Internal m6A(m) methylation of snRNAs regulates RNA splicing (PubMed:31913360). Also able to act as a N(6)-adenine-specific DNA methyltransferase by mediating methylation of DNA on the 6th position of adenine (N(6)-methyladenosine) (PubMed:32183942). The existence of N(6)-methyladenosine (m6A) on DNA is however unclear in mammals, and additional evidence is required to confirm the role of the N(6)-adenine-specific DNA methyltransferase activity of METTL4 in vivo (PubMed:32203414). Acts as a regulator of mitochondrial transcript levels and mitochondrial DNA (mtDNA) copy number by mediating mtDNA N(6)-methylation: m6A on mtDNA reduces transcription by repressing TFAM DNA-binding and bending (PubMed:32183942). N(6)-methyladenosine deposition by METTL4 regulates Polycomb silencing by triggering ubiquitination and degradation of sensor proteins ASXL1 and MPND, leading to inactivation of the PR-DUB complex and subsequent preservation of Polycomb silencing (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}