.110742,"nucleus_score":-6.27668,"pct_ad":0.110593,"pct_control":0.120125,"donor_test":"not significant","donor_padj":0.845699,"donor_log2fc":-0.0314414,"donor_lfcse":0.0434093,"donor_log2fc_shrunk":-0.00660789,"degas_log2fc":0.130257,"degas_padj":1.33634e-08},{"cell_type":"Mic","gene_symbol":"GAR1","gene_symbol_current":"GAR1","gene_id":"ENSG00000109534","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.857603,"donor_log2fc":0.128841,"donor_lfcse":0.182484,"donor_log2fc_shrunk":0.00784303,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"GAR1","gene_symbol_current":"GAR1","gene_id":"ENSG00000109534","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.106925,"donor_lfcse":0.168766,"donor_log2fc_shrunk":-3.89345e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"GAR1","gene_symbol_current":"GAR1","gene_id":"ENSG00000109534","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.97549,"donor_log2fc":0.0210068,"donor_lfcse":0.106429,"donor_log2fc_shrunk":0.00219174,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000109534","entrez_id":["54433"],"uniprot":["Q9NY12"],"ncbi_summary":"This gene is a member of the H/ACA snoRNPs (small nucleolar ribonucleoproteins) gene family. snoRNPs are involved in various aspects of rRNA processing and modification and have been classified into two families: C/D and H/ACA. The H/ACA snoRNPs also include the DKC1, NOLA2 and NOLA3 proteins. These four H/ACA snoRNP proteins localize to the dense fibrillar components of nucleoli and to coiled (Cajal) bodies in the nucleus. Both 18S rRNA production and rRNA pseudouridylation are impaired if any one of the four proteins is depleted. These four H/ACA snoRNP proteins are also components of the telomerase complex. The encoded protein of this gene contains two glycine- and arginine-rich domains and is related to Saccharomyces cerevisiae Gar1p. Two splice variants have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NY12","text":"Required for ribosome biogenesis and telomere maintenance. Part of the H/ACA small nucleolar ribonucleoprotein (H/ACA snoRNP) complex, which catalyzes pseudouridylation of rRNA. This involves the isomerization of uridine such that the ribose is subsequently attached to C5, instead of the normal N1. Each rRNA can contain up to 100 pseudouridine ('psi') residues, which may serve to stabilize the conformation of rRNAs. May also be required for correct processing or intranuclear trafficking of TERC, the RNA component of the telomerase reverse transcriptase (TERT) holoenzyme."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}