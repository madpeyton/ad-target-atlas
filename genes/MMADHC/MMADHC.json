hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":true,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000168288"],"dataset_symbols":["MMADHC"],"explorer":"explorer.html?dataset=mathys2019#gene/MMADHC","cell_types":[{"cell_type":"Ex","gene_symbol":"MMADHC","gene_symbol_current":"MMADHC","gene_id":"ENSG00000168288","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.891889,"nucleus_log2fc":0.0254461,"nucleus_score":-0.17556,"pct_ad":0.157558,"pct_control":0.158797,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":0.0462569,"donor_lfcse":0.100014,"donor_log2fc_shrunk":4.8431e-06},{"cell_type":"In","gene_symbol":"MMADHC","gene_symbol_current":"MMADHC","gene_id":"ENSG00000168288","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.947089,"nucleus_log2fc":-0.0605534,"nucleus_score":-0.221603,"pct_ad":0.12378,"pct_control":0.124805,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0107986,"donor_lfcse":0.178766,"donor_log2fc_shrunk":3.59834e-07}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000168288","module":"turquoise","kme":0.180711,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000168288","module":"turquoise","kme":0.214512,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000168288","entrez_id":["27249"],"uniprot":["Q9H3L0"],"ncbi_summary":"This gene encodes a mitochondrial protein that is involved in an early step of vitamin B12 metabolism. Vitamin B12 (cobalamin) is essential for normal development and survival in humans. Mutations in this gene cause methylmalonic aciduria and homocystinuria type cblD (MMADHC), a disorder of cobalamin metabolism that is characterized by decreased levels of the coenzymes adenosylcobalamin and methylcobalamin. Pseudogenes have been identified on chromosomes 11 and X.[provided by RefSeq, Nov 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H3L0","text":"Involved in cobalamin metabolism and trafficking (PubMed:18385497, PubMed:23415655, PubMed:24722857, PubMed:26364851). Plays a role in regulating the biosynthesis and the proportion of two coenzymes, methylcob(III)alamin (MeCbl) and 5'-deoxyadenosylcobalamin (AdoCbl) (PubMed:18385497, PubMed:23415655, PubMed:24722857). Promotes oxidation of cob(II)alamin bound to MMACHC (PubMed:26364851). The processing of cobalamin in the cytosol occurs in a multiprotein complex composed of at least MMACHC, MMADHC, MTRR (methionine synthase reductase) and MTR (methionine synthase) which may contribute to shuttle safely and efficiently cobalamin towards MTR in order to produce methionine (PubMed:27771510)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}