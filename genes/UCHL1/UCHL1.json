3657,"pct_ad":0.0914311,"pct_control":0.102006,"donor_test":"not significant","donor_padj":0.991869,"donor_log2fc":0.0136348,"donor_lfcse":0.2273,"donor_log2fc_shrunk":0.00025899}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000154277","module":"brown","kme":0.132355,"hub":false,"module_direction":"lower in AD","module_padj":0.652213,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000154277","module":"turquoise","kme":0.530711,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000154277","module":"turquoise","kme":0.472806,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000154277","module":"turquoise","kme":0.187619,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000154277","entrez_id":["7345"],"uniprot":["P09936"],"ncbi_summary":"The protein encoded by this gene belongs to the peptidase C12 family. This enzyme is a thiol protease that hydrolyzes a peptide bond at the C-terminal glycine of ubiquitin. This gene is specifically expressed in the neurons and in cells of the diffuse neuroendocrine system. Mutations in this gene may be associated with Parkinson disease.[provided by RefSeq, Sep 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P09936","text":"Deubiquitinase that plays a role in the regulation of several processes such as maintenance of synaptic function, cardiac function, inflammatory response or osteoclastogenesis (PubMed:22212137, PubMed:23359680). Abrogates the ubiquitination of multiple proteins including WWTR1/TAZ, EGFR, HIF1A and beta-site amyloid precursor protein cleaving enzyme 1/BACE1 (PubMed:22212137, PubMed:25615526). In addition, recognizes and hydrolyzes a peptide bond at the C-terminal glycine of ubiquitin to maintain a stable pool of monoubiquitin that is a key requirement for the ubiquitin-proteasome and the autophagy-lysosome pathways (PubMed:12408865, PubMed:8639624, PubMed:9774100). Regulates amyloid precursor protein/APP processing by promoting BACE1 degradation resulting in decreased amyloid beta production (PubMed:22212137). Plays a role in the immune response by regulating the ability of MHC I molecules to reach cross-presentation compartments competent for generating Ag-MHC I complexes (By similarity). Mediates the 'Lys-48'-linked deubiquitination of the transcriptional coactivator WWTR1/TAZ leading to its stabilization and inhibition of osteoclastogenesis (By similarity). Deubiquitinates and stabilizes epidermal growth factor receptor EGFR to prevent its degradation and to activate its downstream mediators (By similarity). Modulates oxidative activity in skeletal muscle by regulating key mitochondrial oxidative proteins (By similarity). Enhances the activity of hypoxia-inducible factor 1-alpha/HIF1A by abrogateing its VHL E3 ligase-mediated ubiquitination and consequently inhibiting its degradation (PubMed:25615526)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[{"accession":"P09936","pdb_id":"7zm0","het_id":"JMF","resolution":2.24,"method":"X-ray diffraction","ligand_rule":"heaviest non-additive 150-900 Da","datasets":["Green et al. 2024"],"ligand_name":"(3S)-1-(iminomethyl)-N-[1-[4-(pent-4-ynylcarbamoyl)phenyl]imidazol-4-yl]pyrrolidine-3-carboxamide","ligand_class":"drug-like or studied compound","ligand_note":null,"entry_title":"Structure of UCHL1 in complex with GK13S inhibitor","first_author":"Grethe, C.","n_authors":7,"journal":"Nat Commun","year":2022,"doi":"10.1038/s41467-022-33559-4","citation_url":"https://doi.org/10.1038/s41467-022-33559-4"},{"accession":"P09936","pdb_id":"8ede","het_id":"WEU","resolution":1.799,"method":"X-ray diffraction","ligand_rule":"SUBJECT_OF_INVESTIGATION","datasets":["Green et al. 2024"],"ligand_name":"2-[(4-chlorophenyl)-methyl-amino]-~{N}'-ethanoyl-ethanehydrazide","ligand_class":"drug-like or studied compound","ligand_note":null,"entry_title":"Crystal structure of covalent inhibitor 2-chloro-N'-(N-(4-chlorophenyl)-N-methylglycyl)acetohydrazide bound to Ubiquitin C-terminal Hydrolase-L1","first_author":"Imhoff, R.D.","n_authors":13,"journal":"J.Med.Chem.","year":2024,"doi":"10.1021/acs.jmedchem.3c01661","citation_url":"https://doi.org/10.1021/acs.jmedchem.3c01661"},{"accession":"P09936","pdb_id":"8pw1","het_id":"GKO","resolution":2.2,"method":"X-ray diffraction","ligand_rule":"SUBJECT_OF_INVESTIGATION","datasets":["Green et al. 2024"],"ligand_name":"(2~{S})-4-(iminomethyl)-1-methyl-~{N}-[1-[4-(pent-4-ynylcarbamoyl)phenyl]imidazol-4-yl]piperazine-2-carboxamide","ligand_class":"drug-like or studied compound","ligand_note":null,"entry_title":"Structure of human UCHL1 in complex with CG341 inhibitor","first_author":"Schmidt, M.","n_authors":6,"journal":"Angew.Chem.Int.Ed.Engl.","year":2024,"doi":"10.1002/anie.202318849","citation_url":"https://doi.org/10.1002/anie.202318849"}],"alphafold_accessions":["P09936"]}