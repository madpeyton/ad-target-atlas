e.info","uniprot_function":[{"accession":"Q9HBI1","text":"Adapter protein that plays a role in integrin signaling via ILK and in activation of the GTPases CDC42 and RAC1 by guanine exchange factors, such as ARHGEF6. Is involved in the reorganization of the actin cytoskeleton and formation of lamellipodia. Plays a role in cell adhesion, cell spreading, establishment or maintenance of cell polarity, and cell migration."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}