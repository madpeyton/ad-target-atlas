leus_log2fc":0.147191,"nucleus_score":2.84907,"pct_ad":0.210558,"pct_control":0.189162,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0462228,"donor_lfcse":0.139103,"donor_log2fc_shrunk":2.50848e-06},{"cell_type":"Oli","gene_symbol":"CAT","gene_symbol_current":"CAT","gene_id":"ENSG00000121691","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0001051,"nucleus_log2fc":-0.0880373,"nucleus_score":-4.02822,"pct_ad":0.209249,"pct_control":0.22221,"donor_test":"not significant","donor_padj":0.848582,"donor_log2fc":-0.126356,"donor_lfcse":0.123033,"donor_log2fc_shrunk":-0.0089611}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000121691","module":"turquoise","kme":0.119758,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000121691","module":"blue","kme":0.391034,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000121691","module":"turquoise","kme":0.0597455,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000121691","entrez_id":["847"],"uniprot":["P04040"],"ncbi_summary":"This gene encodes catalase, a key antioxidant enzyme in the bodies defense against oxidative stress. Catalase is a heme enzyme that is present in the peroxisome of nearly all aerobic cells. Catalase converts the reactive oxygen species hydrogen peroxide to water and oxygen and thereby mitigates the toxic effects of hydrogen peroxide. Oxidative stress is hypothesized to play a role in the development of many chronic or late-onset diseases such as diabetes, asthma, Alzheimer's disease, systemic lupus erythematosus, rheumatoid arthritis, and cancers. Polymorphisms in this gene have been associated with decreases in catalase activity but, to date, acatalasemia is the only disease known to be caused by this gene. [provided by RefSeq, Oct 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P04040","text":"Catalyzes the degradation of hydrogen peroxide (H(2)O(2)) generated by peroxisomal oxidases to water and oxygen, thereby protecting cells from the toxic effects of hydrogen peroxide (PubMed:7882369). Promotes growth of cells including T-cells, B-cells, myeloid leukemia cells, melanoma cells, mastocytoma cells and normal and transformed fibroblast cells (PubMed:7882369)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}