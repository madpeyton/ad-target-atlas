d":"ENSG00000198721","module":"blue","kme":0.0904432,"hub":false,"module_direction":"higher in AD","module_padj":0.903036,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000198721","module":"blue","kme":0.181345,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000198721"],"dataset_symbols":["ECI2"],"explorer":"explorer.html?dataset=mathys2019#gene/ECI2","cell_types":[{"cell_type":"Ex","gene_symbol":"ECI2","gene_symbol_current":"ECI2","gene_id":"ENSG00000198721","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0283848,"nucleus_log2fc":-0.129466,"nucleus_score":-2.41967,"pct_ad":0.114181,"pct_control":0.124661,"donor_test":"not significant","donor_padj":0.998051,"donor_log2fc":0.00787199,"donor_lfcse":0.113417,"donor_log2fc_shrunk":1.19676e-06},{"cell_type":"In","gene_symbol":"ECI2","gene_symbol_current":"ECI2","gene_id":"ENSG00000198721","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.992433,"nucleus_log2fc":-0.0579214,"nucleus_score":0.0316637,"pct_ad":0.106477,"pct_control":0.104886,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0528029,"donor_lfcse":0.180361,"donor_log2fc_shrunk":-1.33775e-06},{"cell_type":"Oli","gene_symbol":"ECI2","gene_symbol_current":"ECI2","gene_id":"ENSG00000198721","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.868589,"donor_log2fc":-0.140412,"donor_lfcse":0.151649,"donor_log2fc_shrunk":-0.0057915}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198721","entrez_id":["10455"],"uniprot":["O75521"],"ncbi_summary":"This gene encodes a member of the hydratase/isomerase superfamily. The protein encoded is a key mitochondrial enzyme involved in beta-oxidation of unsaturated fatty acids. It catalyzes the transformation of 3-cis and 3-trans-enoyl-CoA esters arising during the stepwise degradation of cis-, mono-, and polyunsaturated fatty acids to the 2-trans-enoyl-CoA intermediates. Alternatively spliced transcript variants have been described. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75521","text":"Auxiliary enzyme in the beta-oxidation of mono- and polyunsaturated fatty acids (PubMed:10419495). Together with the 2,4-dienoyl-CoA reductase (DECR) and the Delta(3,5)-Delta(2,4)-dienoyl-CoA isomerase (ECH), they allow the reentrance of the enoyl-CoA into the beta-oxidation cycle (PubMed:10419495). Able to isomerize both 3-cis (3Z) and 3-trans (3E) double bonds into the 2-trans (2E) form in a range of fatty enoyl-CoA species, with a preference for (3E)-enoyl-CoAs over (3Z)-enoyl-CoAs (PubMed:10419495, PubMed:25515061). Based on its established catalytic mechanism, it is predicted to act also on other fatty acids besides those tested experimentally (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}