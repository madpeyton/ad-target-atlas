_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00438854,"nucleus_log2fc":-0.0400687,"nucleus_score":-2.98835,"pct_ad":0.474017,"pct_control":0.489013,"donor_test":"not significant","donor_padj":0.999075,"donor_log2fc":0.000855531,"donor_lfcse":0.103331,"donor_log2fc_shrunk":0.000132532,"degas_log2fc":-0.150161,"degas_padj":5.90295e-19}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000012660","module":"magenta","kme":0.162471,"hub":false,"module_direction":"higher in AD","module_padj":0.456482,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000012660","module":"blue","kme":0.221772,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000012660","entrez_id":["60481"],"uniprot":["Q9NYP7"],"ncbi_summary":"This gene belongs to the ELO family. It is highly expressed in the adrenal gland and testis, and encodes a multi-pass membrane protein that is localized in the endoplasmic reticulum. This protein is involved in the elongation of long-chain polyunsaturated fatty acids. Mutations in this gene have been associated with spinocerebellar ataxia-38 (SCA38). Alternatively spliced transcript variants have been found for this gene. [provided by RefSeq, Sep 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NYP7","text":"Catalyzes the first and rate-limiting reaction of the four reactions that constitute the long-chain fatty acids elongation cycle. This endoplasmic reticulum-bound enzymatic process allows the addition of 2 carbons to the chain of long- and very long-chain fatty acids (VLCFAs) per cycle. Condensing enzyme that acts specifically toward polyunsaturated acyl-CoA with the higher activity toward C18:3(n-6) acyl-CoA. May participate in the production of monounsaturated and of polyunsaturated VLCFAs of different chain lengths that are involved in multiple biological processes as precursors of membrane lipids and lipid mediators (By similarity) (PubMed:10970790, PubMed:20937905). In conditions where the essential linoleic and alpha linoleic fatty acids are lacking it is also involved in the synthesis of Mead acid from oleic acid (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}