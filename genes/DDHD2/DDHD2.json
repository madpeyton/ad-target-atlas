0.255142,"donor_test":"not significant","donor_padj":0.687939,"donor_log2fc":-0.198874,"donor_lfcse":0.11966,"donor_log2fc_shrunk":-0.0159409,"degas_log2fc":-0.18214,"degas_padj":3.50349e-14}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000085788","module":"turquoise","kme":0.0694723,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000085788","module":"turquoise","kme":0.0234833,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000085788","module":"blue","kme":0.0493092,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000085788","entrez_id":["23259"],"uniprot":["O94830"],"ncbi_summary":"This gene encodes a phospholipase enzyme containing sterile-alpha-motif (SAM), WWE, and DDHD domains. This protein participates in membrane trafficking between the endoplastic reticulum and the Golgi body. Mutations in this gene can cause autosomal recessive spastic paraplegia 54. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Dec 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O94830","text":"Diacylglycerol (DAG) and triacylglycerol (TAG) lipase required for proper lipid homeostasis in the central nervous system (PubMed:29278326, PubMed:37832604). It cooperates with PNPLA2/ATGL in neuronal TAG catabolism and hydrolyzes sn-1,3 DAG downstream of PNPLA2/ATGL (By similarity). In vitro, it also acts as a phospholipase that hydrolyzes preferentially phosphatidic acids, including 1,2-dioleoyl-sn-phosphatidic acid, phosphatidylcholine and phosphatidylethanolamine. Specifically binds to phosphatidylinositol 3-phosphate (PI(3)P), phosphatidylinositol 4-phosphate (PI(4)P), phosphatidylinositol 5-phosphate (PI(5)P) and possibly phosphatidylinositol 4,5-bisphosphate (PI(4,5)P2). May be involved in the maintenance of the endoplasmic reticulum and/or Golgi structures. May regulate the transport between Golgi apparatus and plasma membrane."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}