nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0634188,"donor_lfcse":0.156202,"donor_log2fc_shrunk":2.70847e-06},{"cell_type":"Oli","gene_symbol":"SPRTN","gene_symbol_current":"SPRTN","gene_id":"ENSG00000010072","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.993223,"donor_log2fc":0.00666723,"donor_lfcse":0.102618,"donor_log2fc_shrunk":0.000643134}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000010072","module":"turquoise","kme":0.0674493,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000010072","module":"turquoise","kme":0.129591,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000010072","module":"turquoise","kme":0.0581443,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000010072","module":"turquoise","kme":0.0481713,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000010072","entrez_id":["83932"],"uniprot":["Q9H040"],"ncbi_summary":"The protein encoded by this gene may play a role in DNA repair during replication of damaged DNA. This protein recruits valosin containing protein (p97) to stalled DNA replication forks where it may prevent excessive translesional DNA synthesis and limit the number of DNA-damage induced mutations. It may also be involved in replication-related G2/M-checkpoint regulation. Deficiency of a similar protein in mouse causes chromosomal instability and progeroid phenotypes. Mutations in this gene have been associated with Ruijs-Aalfs syndrome (RJALS). Alternatively spliced transcript variants have been identified. [provided by RefSeq, Mar 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H040","text":"DNA-dependent metalloendopeptidase that mediates the proteolytic cleavage of covalent DNA-protein cross-links (DPCs) during DNA synthesis and mitosis, thereby playing a key role in maintaining genomic integrity (PubMed:27852435, PubMed:27871365, PubMed:27871366, PubMed:30893605, PubMed:32649882, PubMed:36608669, PubMed:41610251). DPCs are highly toxic DNA lesions that interfere with essential chromatin transactions, such as replication and transcription, and which are induced by reactive agents, such as UV light or formaldehyde (PubMed:27852435, PubMed:27871365, PubMed:27871366, PubMed:32649882, PubMed:36608669, PubMed:41610251). Associates with the DNA replication machinery and specifically removes DPCs during DNA synthesis (PubMed:27852435, PubMed:27871365, PubMed:27871366, PubMed:32649882). Catalyzes proteolytic cleavage of the HMCES DNA-protein cross-link following unfolding by the BRIP1/FANCJ helicase (PubMed:36608669). Acts as a pleiotropic protease for DNA-binding proteins cross-linked with DNA, such as TOP1, TOP2A, histones H3 and H4 (PubMed:27871366). Mediates degradation of DPCs that are not ubiquitinated, while it is not able to degrade ubiquitinated DPCs (By similarity). SPRTN activation requires polymerase collision with DPCs followed by helicase bypass of DPCs (By similarity). Involved in recruitment of VCP/p97 to sites of DNA damage (PubMed:22902628, PubMed:23042605, PubMed:23042607, PubMed:32152270). Also acts as an activator of CHEK1 during normal DNA replication by mediating proteolytic cleavage of CHEK1, thereby promoting CHEK1 removal from chromatin and subsequent activation (PubMed:31316063). Does not activate CHEK1 in response to DNA damage (PubMed:31316063). May also act as a 'reader' of ubiquitinated PCNA: recruited to sites of UV damage and interacts with ubiquitinated PCNA and RAD18, the E3 ubiquitin ligase that monoubiquitinates PCNA (PubMed:22681887, PubMed:22894931, PubMed:22902628, PubMed:22987070). Facilitates chromatin association of RAD18 and is required for efficient PCNA monoubiquitination, promoting a feed-forward loop to enhance PCNA ubiquitination and translesion DNA synthesis (PubMed:22681887)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}