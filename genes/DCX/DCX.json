cleus_score":8.99487,"pct_ad":0.772864,"pct_control":0.764241,"donor_test":"not significant","donor_padj":0.753268,"donor_log2fc":0.10008,"donor_lfcse":0.0758483,"donor_log2fc_shrunk":0.00819643},{"cell_type":"Mic","gene_symbol":"DCX","gene_symbol_current":"DCX","gene_id":"ENSG00000077279","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.741961,"donor_log2fc":-0.248875,"donor_lfcse":0.229717,"donor_log2fc_shrunk":-0.00985282},{"cell_type":"OPC","gene_symbol":"DCX","gene_symbol_current":"DCX","gene_id":"ENSG00000077279","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.914377,"nucleus_log2fc":0.0132744,"nucleus_score":0.174983,"pct_ad":0.269311,"pct_control":0.268586,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.00417085,"donor_lfcse":0.115991,"donor_log2fc_shrunk":-3.10779e-07},{"cell_type":"Oli","gene_symbol":"DCX","gene_symbol_current":"DCX","gene_id":"ENSG00000077279","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.832487,"donor_log2fc":-0.18957,"donor_lfcse":0.175017,"donor_log2fc_shrunk":-0.0068119}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000077279","module":"black","kme":0.193194,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000077279","entrez_id":["1641"],"uniprot":["O43602"],"ncbi_summary":"This gene encodes a member of the doublecortin family. The protein encoded by this gene is a cytoplasmic protein and contains two doublecortin domains, which bind microtubules. In the developing cortex, cortical neurons must migrate over long distances to reach the site of their final differentiation. The encoded protein appears to direct neuronal migration by regulating the organization and stability of microtubules. In addition, the encoded protein interacts with LIS1, the regulatory gamma subunit of platelet activating factor acetylhydrolase, and this interaction is important to proper microtubule function in the developing cortex. Mutations in this gene cause abnormal migration of neurons during development and disrupt the layering of the cortex, leading to epilepsy, cognitive disability, subcortical band heterotopia ('double cortex' syndrome) in females and lissencephaly ('smooth brain' syndrome) in males. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Sep 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43602","text":"Microtubule-associated protein required for initial steps of neuronal dispersion and cortex lamination during cerebral cortex development. May act by competing with the putative neuronal protein kinase DCLK1 in binding to a target protein. May in that way participate in a signaling pathway that is crucial for neuronal interaction before and during migration, possibly as part of a calcium ion-dependent signal transduction pathway. May be part with PAFAH1B1/LIS-1 of overlapping, but distinct, signaling pathways that promote neuronal migration."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}