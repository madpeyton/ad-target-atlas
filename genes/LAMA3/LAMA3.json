7","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.567929,"donor_log2fc":-0.355945,"donor_lfcse":0.221559,"donor_log2fc_shrunk":-0.0154898,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"LAMA3","gene_symbol_current":"LAMA3","gene_id":"ENSG00000053747","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.209629,"donor_lfcse":0.223732,"donor_log2fc_shrunk":4.45191e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"LAMA3","gene_symbol_current":"LAMA3","gene_id":"ENSG00000053747","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.981409,"donor_log2fc":-0.0310485,"donor_lfcse":0.191148,"donor_log2fc_shrunk":-0.000932969,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000053747","module":"black","kme":0.250846,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000053747","module":"blue","kme":0.660389,"hub":true,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000053747","entrez_id":["3909"],"uniprot":["Q16787"],"ncbi_summary":"The protein encoded by this gene belongs to the laminin family of secreted molecules. Laminins are heterotrimeric molecules that consist of alpha, beta, and gamma subunits that assemble through a coiled-coil domain. Laminins are essential for formation and function of the basement membrane and have additional functions in regulating cell migration and mechanical signal transduction. This gene encodes an alpha subunit and is responsive to several epithelial-mesenchymal regulators including keratinocyte growth factor, epidermal growth factor and insulin-like growth factor. Mutations in this gene have been identified as the cause of Herlitz type junctional epidermolysis bullosa and laryngoonychocutaneous syndrome. Alternative splicing and alternative promoter usage result in multiple transcript variants. [provided by RefSeq, Dec 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q16787","text":"Binding to cells via a high affinity receptor, laminin is thought to mediate the attachment, migration and organization of cells into tissues during embryonic development by interacting with other extracellular matrix components. Laminin-5 is thought to be involved in (1) cell adhesion via integrin alpha-3/beta-1 in focal adhesion and integrin alpha-6/beta-4 in hemidesmosomes, (2) signal transduction via tyrosine phosphorylation of pp125-FAK and p80, (3) differentiation of keratinocytes."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}