ENSG00000240583","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.96802e-30,"nucleus_log2fc":-0.10117,"nucleus_score":-11.4928,"pct_ad":0.128764,"pct_control":0.145338,"donor_test":"not significant","donor_padj":0.773545,"donor_log2fc":-0.0953125,"donor_lfcse":0.107538,"donor_log2fc_shrunk":-0.00675881,"degas_log2fc":0.00758884,"degas_padj":0.667008},{"cell_type":"In","gene_symbol":"AQP1","gene_symbol_current":"AQP1","gene_id":"ENSG00000240583","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.792714,"donor_log2fc":-0.127259,"donor_lfcse":0.126401,"donor_log2fc_shrunk":-0.00361654,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000240583","module":"brown","kme":0.576435,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000240583","module":"blue","kme":0.0602587,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000240583","entrez_id":["358"],"uniprot":["P29972"],"ncbi_summary":"This gene encodes a small integral membrane protein with six bilayer spanning domains that functions as a water channel protein. This protein permits passive transport of water along an osmotic gradient. This gene is a possible candidate for disorders involving imbalance in ocular fluid movement. [provided by RefSeq, Aug 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P29972","text":"Forms a water channel that facilitates the transport of water across cell membranes, playing a crucial role in water homeostasis in various tissues (PubMed:1373524, PubMed:23219802). Could also be permeable to small solutes including hydrogen peroxide, glycerol and gases such as amonnia (NH3), nitric oxide (NO) and carbon dioxide (CO2) (PubMed:16682607, PubMed:17012249, PubMed:19273840, PubMed:33028705, PubMed:8584435). Recruited to the ankyrin-1 complex, a multiprotein complex of the erythrocyte membrane, it could be part of a CO2 metabolon, linking facilitated diffusion of CO2 across the membrane, anion exchange of Cl(-)/HCO3(-) and interconversion of dissolved CO2 and carbonic acid in the cytosol (PubMed:17012249, PubMed:35835865). In vitro, it shows non-selective gated cation channel activity and may be permeable to cations like K(+) and Na(+) in vivo (PubMed:36949749, PubMed:8703053)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}