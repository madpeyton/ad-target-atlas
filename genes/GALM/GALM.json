ficant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000143891"],"dataset_symbols":["GALM"],"explorer":"explorer.html?dataset=mathys2019#gene/GALM","cell_types":[{"cell_type":"Ex","gene_symbol":"GALM","gene_symbol_current":"GALM","gene_id":"ENSG00000143891","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.384777,"donor_lfcse":0.169613,"donor_log2fc_shrunk":1.39532e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000143891","entrez_id":["130589"],"uniprot":["Q96C23"],"ncbi_summary":"This gene encodes an enzyme that catalyzes the epimerization of hexose sugars such as glucose and galactose. The encoded protein is expressed in the cytoplasm and has a preference for galactose. The encoded protein may be required for normal galactose metabolism by maintaining the equilibrium of alpha and beta anomers of galactose.[provided by RefSeq, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96C23","text":"Mutarotase that catalyzes the interconversion of beta-D-galactose and alpha-D-galactose during galactose metabolism (PubMed:12753898). Beta-D-galactose is metabolized in the liver into glucose 1-phosphate, the primary metabolic fuel, by the action of four enzymes that constitute the Leloir pathway: GALM, GALK1 (galactokinase), GALT (galactose-1-phosphate uridylyltransferase) and GALE (UDP-galactose-4'-epimerase) (PubMed:30451973). Involved in the maintenance of the equilibrium between the beta- and alpha-anomers of galactose, therefore ensuring a sufficient supply of the alpha-anomer for GALK1 (PubMed:12753898). Also active on D-glucose although shows a preference for galactose over glucose (PubMed:12753898)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}