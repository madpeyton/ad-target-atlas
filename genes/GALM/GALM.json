as_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000143891","module":"turquoise","kme":0.168929,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000143891","module":"turquoise","kme":0.0850588,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000143891","module":"turquoise","kme":0.0571964,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000143891","entrez_id":["130589"],"uniprot":["Q96C23"],"ncbi_summary":"This gene encodes an enzyme that catalyzes the epimerization of hexose sugars such as glucose and galactose. The encoded protein is expressed in the cytoplasm and has a preference for galactose. The encoded protein may be required for normal galactose metabolism by maintaining the equilibrium of alpha and beta anomers of galactose.[provided by RefSeq, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96C23","text":"Mutarotase that catalyzes the interconversion of beta-D-galactose and alpha-D-galactose during galactose metabolism (PubMed:12753898). Beta-D-galactose is metabolized in the liver into glucose 1-phosphate, the primary metabolic fuel, by the action of four enzymes that constitute the Leloir pathway: GALM, GALK1 (galactokinase), GALT (galactose-1-phosphate uridylyltransferase) and GALE (UDP-galactose-4'-epimerase) (PubMed:30451973). Involved in the maintenance of the equilibrium between the beta- and alpha-anomers of galactose, therefore ensuring a sufficient supply of the alpha-anomer for GALK1 (PubMed:12753898). Also active on D-glucose although shows a preference for galactose over glucose (PubMed:12753898)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}