t al. 2019","gene_ids":["ENSG00000102524"],"dataset_symbols":["TNFSF13B"],"explorer":"explorer.html?dataset=mathys2019#gene/TNFSF13B","cell_types":[{"cell_type":"Ex","gene_symbol":"TNFSF13B","gene_symbol_current":"TNFSF13B","gene_id":"ENSG00000102524","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.728278,"nucleus_log2fc":0.0850348,"nucleus_score":0.430637,"pct_ad":0.174319,"pct_control":0.173792,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.118985,"donor_lfcse":0.127505,"donor_log2fc_shrunk":7.57544e-06},{"cell_type":"OPC","gene_symbol":"TNFSF13B","gene_symbol_current":"TNFSF13B","gene_id":"ENSG00000102524","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.856647,"nucleus_log2fc":-0.0814535,"nucleus_score":-0.421061,"pct_ad":0.105965,"pct_control":0.111111,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"In","gene_id":"ENSG00000102524","module":"brown","kme":0.107249,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000102524","entrez_id":["10673"],"uniprot":["Q9Y275"],"ncbi_summary":"The protein encoded by this gene is a cytokine that belongs to the tumor necrosis factor (TNF) ligand family. This cytokine is a ligand for receptors TNFRSF13B/TACI, TNFRSF17/BCMA, and TNFRSF13C/BAFFR. This cytokine is expressed in B cell lineage cells, and acts as a potent B cell activator. It has been also shown to play an important role in the proliferation and differentiation of B cells. Alternatively spliced transcript variants encoding distinct isoforms have been identified. [provided by RefSeq, Mar 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y275","text":"Cytokine that binds to TNFRSF13B/TACI and TNFRSF17/BCMA. TNFSF13/APRIL binds to the same 2 receptors. Together, they form a 2 ligands -2 receptors pathway involved in the stimulation of B- and T-cell function and the regulation of humoral immunity. A third B-cell specific BAFF-receptor (BAFFR/BR3) promotes the survival of mature B-cells and the B-cell response. Isoform 2 seems to inhibit isoform 1 secretion and bioactivity. [Isoform 3]: Acts as a transcription factor for its own parent gene, in association with NF-kappa-B p50 subunit, at least in autoimmune and proliferative B-cell diseases. The presence of Delta4BAFF is essential for soluble BAFF release by IFNG/IFN-gamma-stimulated monocytes and for B-cell survival. It can directly or indirectly regulate the differential expression of a large number of genes involved in the innate immune response and the regulation of apoptosis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}