core":0.819218,"pct_ad":0.866903,"pct_control":0.877062,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.026615,"donor_lfcse":0.0625137,"donor_log2fc_shrunk":7.05551e-06},{"cell_type":"OPC","gene_symbol":"MYT1L","gene_symbol_current":"MYT1L","gene_id":"ENSG00000186487","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.74149,"nucleus_log2fc":0.108994,"nucleus_score":0.714018,"pct_ad":0.340659,"pct_control":0.3341,"donor_test":"not significant","donor_padj":0.986209,"donor_log2fc":0.0825352,"donor_lfcse":0.129155,"donor_log2fc_shrunk":0.00101523}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000186487","module":"green","kme":0.292822,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000186487","module":"blue","kme":0.179282,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000186487","module":"salmon","kme":0.151114,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000186487","entrez_id":["23040"],"uniprot":["Q9UL68"],"ncbi_summary":"This gene encodes a member of the zinc finger superfamily of transcription factors whose expression, thus far, has been found only in neuronal tissues. The encoded protein belongs to a novel class of cystein-cystein-histidine-cystein zinc finger proteins that function in the developing mammalian central nervous system. Forced expression of this gene in combination with the basic helix-loop-helix transcription factor NeuroD1 and the transcription factors POU class 3 homeobox 2 and achaete-scute family basic helix-loop-helix transcription factor 1 can convert fetal and postnatal human fibroblasts into induced neuronal cells, which are able to generate action potentials. Mutations in this gene have been associated with an autosomal dominant form of cognitive disability and with autism spectrum disorder. Alternative splicing results in multiple variants. [provided by RefSeq, Jul 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UL68","text":"Transcription factor that plays a key role in neuronal differentiation by specifically repressing expression of non-neuronal genes during neuron differentiation. In contrast to other transcription repressors that inhibit specific lineages, mediates repression of multiple differentiation programs. Also represses expression of negative regulators of neurogenesis, such as members of the Notch signaling pathway, including HES1. The combination of three transcription factors, ASCL1, POU3F2/BRN2 and MYT1L, is sufficient to reprogram fibroblasts and other somatic cells into induced neuronal (iN) cells in vitro. Directly binds the 5'-AAGTT-3' core motif present on the promoter of target genes and represses transcription by recruiting a multiprotein complex containing SIN3B. The 5'-AAGTT-3' core motif is absent from the promoter of neural genes."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}