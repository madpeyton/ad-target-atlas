89","module":"brown","kme":0.0955273,"hub":false,"module_direction":"lower in AD","module_padj":0.833818,"module_significant":false},{"cell_type":"CUX2+","gene_id":"ENSG00000086189","module":"blue","kme":0.10475,"hub":false,"module_direction":"lower in AD","module_padj":0.642666,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000086189","module":"blue","kme":0.115673,"hub":false,"module_direction":"lower in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000086189"],"dataset_symbols":["DIMT1"],"explorer":"explorer.html?dataset=mathys2019#gene/DIMT1","cell_types":[{"cell_type":"Ex","gene_symbol":"DIMT1","gene_symbol_current":"DIMT1","gene_id":"ENSG00000086189","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.263871,"nucleus_log2fc":-0.0565745,"nucleus_score":-1.28065,"pct_ad":0.134193,"pct_control":0.139895,"donor_test":"not significant","donor_padj":0.996763,"donor_log2fc":0.0125927,"donor_lfcse":0.0900434,"donor_log2fc_shrunk":2.09724e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000086189","entrez_id":["27292"],"uniprot":["Q9UNQ2"],"ncbi_summary":"The protein encoded by this gene is a methyltransferase that is responsible for dimethylation of adjacent adenosines near the 18S rRNA decoding site. The encoded protein is essential for ribosome biogenesis, although its catalytic activity is not involved in the process. The yeast ortholog of this protein functions in the cytoplasm while this protein functions in the nucleus. [provided by RefSeq, Jan 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UNQ2","text":"Specifically dimethylates two adjacent adenosines in the loop of a conserved hairpin near the 3'-end of 18S rRNA in the 40S particle (PubMed:25851604). Involved in the pre-rRNA processing steps leading to small-subunit rRNA production independently of its RNA-modifying catalytic activity (PubMed:25851604). Part of the small subunit (SSU) processome, first precursor of the small eukaryotic ribosomal subunit. During the assembly of the SSU processome in the nucleolus, many ribosome biogenesis factors, an RNA chaperone and ribosomal proteins associate with the nascent pre-rRNA and work in concert to generate RNA folding, modifications, rearrangements and cleavage as well as targeted degradation of pre-ribosomal RNA by the RNA exosome (PubMed:34516797)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}