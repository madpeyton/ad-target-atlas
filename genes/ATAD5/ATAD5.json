,"nucleus_padj":3.04907e-40,"nucleus_log2fc":-0.150134,"nucleus_score":-13.4014,"pct_ad":0.305099,"pct_control":0.334992,"donor_test":"not significant","donor_padj":0.870884,"donor_log2fc":-0.0656767,"donor_lfcse":0.107964,"donor_log2fc_shrunk":-3.38311e-05},{"cell_type":"Mic","gene_symbol":"ATAD5","gene_symbol_current":"ATAD5","gene_id":"ENSG00000176208","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00450381,"nucleus_log2fc":-0.191595,"nucleus_score":-3.12616,"pct_ad":0.127391,"pct_control":0.142627,"donor_test":"not significant","donor_padj":0.667383,"donor_log2fc":-0.277866,"donor_lfcse":0.21052,"donor_log2fc_shrunk":-0.0133745},{"cell_type":"OPC","gene_symbol":"ATAD5","gene_symbol_current":"ATAD5","gene_id":"ENSG00000176208","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.539334,"nucleus_log2fc":-0.108917,"nucleus_score":-0.8704,"pct_ad":0.194602,"pct_control":0.198307,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0573313,"donor_lfcse":0.195191,"donor_log2fc_shrunk":-1.57901e-06},{"cell_type":"Oli","gene_symbol":"ATAD5","gene_symbol_current":"ATAD5","gene_id":"ENSG00000176208","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.9092e-06,"nucleus_log2fc":-0.152331,"nucleus_score":-4.77144,"pct_ad":0.130766,"pct_control":0.142885,"donor_test":"not significant","donor_padj":0.929122,"donor_log2fc":-0.0954543,"donor_lfcse":0.168526,"donor_log2fc_shrunk":-0.00320684}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000176208","module":"turquoise","kme":0.184342,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000176208","module":"turquoise","kme":0.329951,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000176208","module":"turquoise","kme":0.162282,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000176208","module":"turquoise","kme":0.10025,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000176208","entrez_id":["79915"],"uniprot":["Q96QE3"],"ncbi_summary":"Enables DNA clamp unloader activity. Involved in DNA clamp unloading; positive regulation of DNA replication; and positive regulation of cell cycle G2/M phase transition. Part of Elg1 RFC-like complex. Biomarker of neurilemmoma. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96QE3","text":"Has an important role in DNA replication and in maintaining genome integrity during replication stress (PubMed:15983387, PubMed:19755857). Involved in a RAD9A-related damage checkpoint, a pathway that is important in determining whether DNA damage is compatible with cell survival or whether it requires cell elimination by apoptosis (PubMed:15983387). Modulates the RAD9A interaction with BCL2 and thereby induces DNA damage-induced apoptosis (PubMed:15983387). Promotes PCNA deubiquitination by recruiting the ubiquitin-specific protease 1 (USP1) and WDR48 thereby down-regulating the error-prone damage bypass pathway (PubMed:20147293). As component of the ATAD5 RFC-like complex, regulates the function of the DNA polymerase processivity factor PCNA by unloading the ring-shaped PCNA homotrimer from DNA after replication during the S phase of the cell cycle (PubMed:23277426, PubMed:23937667). This seems to be dependent on its ATPase activity (PubMed:23277426). Plays important roles in restarting stalled replication forks under replication stress, by unloading the PCNA homotrimer from DNA and recruiting RAD51 possibly through an ATR-dependent manner (PubMed:31844045). Ultimately this enables replication fork regression, breakage, and eventual fork restart (PubMed:31844045). Both the PCNA unloading activity and the interaction with WDR48 are required to efficiently recruit RAD51 to stalled replication forks (PubMed:31844045). Promotes the generation of MUS81-mediated single-stranded DNA-associated breaks in response to replication stress, which is an alternative pathway to restart stalled/regressed replication forks (PubMed:31844045)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}