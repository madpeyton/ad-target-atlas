current":"KDELR1","gene_id":"ENSG00000105438","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.944361,"nucleus_log2fc":-0.0144352,"nucleus_score":0.113226,"pct_ad":0.183567,"pct_control":0.182218,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0121605,"donor_lfcse":0.144837,"donor_log2fc_shrunk":-5.90656e-07},{"cell_type":"Oli","gene_symbol":"KDELR1","gene_symbol_current":"KDELR1","gene_id":"ENSG00000105438","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.969154,"donor_log2fc":-0.0345546,"donor_lfcse":0.116674,"donor_log2fc_shrunk":-0.00263364}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000105438","module":"turquoise","kme":0.102192,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000105438","module":"brown","kme":0.170864,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000105438","module":"turquoise","kme":0.130509,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000105438","module":"turquoise","kme":0.0794074,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000105438","entrez_id":["10945"],"uniprot":["P24390"],"ncbi_summary":"Retention of resident soluble proteins in the lumen of the endoplasmic reticulum (ER) is achieved in both yeast and animal cells by their continual retrieval from the cis-Golgi, or a pre-Golgi compartment. Sorting of these proteins is dependent on a C-terminal tetrapeptide signal, usually lys-asp-glu-leu (KDEL) in animal cells, and his-asp-glu-leu (HDEL) in S. cerevisiae. This process is mediated by a receptor that recognizes, and binds the tetrapeptide-containing protein, and returns it to the ER. In yeast, the sorting receptor encoded by a single gene, ERD2, which is a seven-transmembrane protein. Unlike yeast, several human homologs of the ERD2 gene, constituting the KDEL receptor gene family, have been described. The protein encoded by this gene was the first member of the family to be identified, and it encodes a protein structurally and functionally similar to the yeast ERD2 gene product. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P24390","text":"Receptor for the C-terminal sequence motif K-D-E-L that is present on endoplasmic reticulum resident proteins and that mediates their recycling from the Golgi back to the endoplasmic reticulum."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}