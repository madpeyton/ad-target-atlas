ct_control":0.115668,"donor_test":"not significant","donor_padj":0.864984,"donor_log2fc":0.07325,"donor_lfcse":0.108334,"donor_log2fc_shrunk":0.0115137,"degas_log2fc":-0.0355733,"degas_padj":0.656066},{"cell_type":"OPC","gene_symbol":"SPHK2","gene_symbol_current":"SPHK2","gene_id":"ENSG00000063176","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0281976,"nucleus_log2fc":0.157796,"nucleus_score":2.65974,"pct_ad":0.174322,"pct_control":0.15597,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.118825,"donor_lfcse":0.104394,"donor_log2fc_shrunk":1.14348e-05,"degas_log2fc":0.0223727,"degas_padj":0.772939},{"cell_type":"Oli","gene_symbol":"SPHK2","gene_symbol_current":"SPHK2","gene_id":"ENSG00000063176","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":4.58978e-11,"nucleus_log2fc":0.168968,"nucleus_score":6.74219,"pct_ad":0.172044,"pct_control":0.152608,"donor_test":"not significant","donor_padj":0.847348,"donor_log2fc":0.108197,"donor_lfcse":0.1045,"donor_log2fc_shrunk":0.0105293,"degas_log2fc":0.0386268,"degas_padj":0.201849}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000063176","module":"magenta","kme":0.110364,"hub":false,"module_direction":"higher in AD","module_padj":0.456482,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000063176","module":"turquoise","kme":0.18217,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000063176","module":"turquoise","kme":0.0557013,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000063176","entrez_id":["56848"],"uniprot":["Q9NRA0"],"ncbi_summary":"This gene encodes one of two sphingosine kinase isozymes that catalyze the phosphorylation of sphingosine into sphingosine 1-phosphate. Sphingosine 1-phosphate mediates many cellular processes including migration, proliferation and apoptosis, and also plays a role in several types of cancer by promoting angiogenesis and tumorigenesis. The encoded protein may play a role in breast cancer proliferation and chemoresistance. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NRA0","text":"Catalyzes the phosphorylation of sphingosine to form sphingosine-1-phosphate (SPP), a lipid mediator with both intra- and extracellular functions. Also acts on D-erythro-dihydrosphingosine, D-erythro-sphingosine and L-threo-dihydrosphingosine. Binds phosphoinositides (PubMed:12954646, PubMed:19168031). In contrast to prosurvival SPHK1, has a positive effect on intracellular ceramide levels, inhibits cells growth and enhances apoptosis (PubMed:16118219). In mitochondria, is important for cytochrome-c oxidase assembly and mitochondrial respiration. The SPP produced in mitochondria binds PHB2 and modulates the regulation via PHB2 of complex IV assembly and respiration (PubMed:20959514). In nucleus, plays a role in epigenetic regulation of gene expression. Interacts with HDAC1 and HDAC2 and, through SPP production, inhibits their enzymatic activity, preventing the removal of acetyl groups from lysine residues with histones. Up-regulates acetylation of histone H3-K9, histone H4-K5 and histone H2B-K12 (PubMed:19729656). In nucleus, may have an inhibitory effect on DNA synthesis and cell cycle (PubMed:12954646, PubMed:16103110). In mast cells, is the main regulator of SPP production which mediates calcium influx, NF-kappa-B activation, cytokine production, such as TNF and IL6, and degranulation of mast cells (By similarity). In dopaminergic neurons, is involved in promoting mitochondrial functions regulating ATP and ROS levels (By similarity). Also involved in the regulation of glucose and lipid metabolism (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}