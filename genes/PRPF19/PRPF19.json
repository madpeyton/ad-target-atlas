04}],"modules":[{"cell_type":"Astrocytes","gene_id":"ENSG00000110107","module":"turquoise","kme":0.16878,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2+","gene_id":"ENSG00000110107","module":"turquoise","kme":0.367409,"hub":false,"module_direction":"higher in AD","module_padj":0.789273,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000110107","module":"turquoise","kme":0.362459,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000110107","module":"turquoise","kme":0.203851,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000110107","module":"turquoise","kme":0.140321,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000110107","module":"turquoise","kme":0.18052,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000110107"],"dataset_symbols":["PRPF19"],"explorer":"explorer.html?dataset=mathys2019#gene/PRPF19","cell_types":[{"cell_type":"Ex","gene_symbol":"PRPF19","gene_symbol_current":"PRPF19","gene_id":"ENSG00000110107","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.51221e-06,"nucleus_log2fc":-0.150222,"nucleus_score":-5.0346,"pct_ad":0.359,"pct_control":0.393603,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":-0.0566496,"donor_lfcse":0.121003,"donor_log2fc_shrunk":-4.01602e-06},{"cell_type":"In","gene_symbol":"PRPF19","gene_symbol_current":"PRPF19","gene_id":"ENSG00000110107","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.844173,"nucleus_log2fc":-0.0201634,"nucleus_score":0.559874,"pct_ad":0.239574,"pct_control":0.227513,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0867796,"donor_lfcse":0.151234,"donor_log2fc_shrunk":3.97453e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000110107","module":"turquoise","kme":0.306805,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000110107","module":"turquoise","kme":0.297383,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000110107","entrez_id":["27339"],"uniprot":["Q9UMS4"],"ncbi_summary":"PSO4 is the human homolog of yeast Pso4, a gene essential for cell survival and DNA repair (Beck et al., 2008 [PubMed 18263876]).[supplied by OMIM, Sep 2008]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UMS4","text":"Ubiquitin-protein ligase which is a core component of several complexes mainly involved pre-mRNA splicing and DNA repair. Required for pre-mRNA splicing as component of the spliceosome (PubMed:28076346, PubMed:28502770, PubMed:29301961, PubMed:29360106, PubMed:30705154). Core component of the PRP19C/Prp19 complex/NTC/Nineteen complex which is part of the spliceosome and participates in its assembly, its remodeling and is required for its activity. During assembly of the spliceosome, mediates 'Lys-63'-linked polyubiquitination of the U4 spliceosomal protein PRPF3. Ubiquitination of PRPF3 allows its recognition by the U5 component PRPF8 and stabilizes the U4/U5/U6 tri-snRNP spliceosomal complex (PubMed:20595234). Recruited to RNA polymerase II C-terminal domain (CTD) and the pre-mRNA, it may also couple the transcriptional and spliceosomal machineries (PubMed:21536736). The XAB2 complex, which contains PRPF19, is also involved in pre-mRNA splicing, transcription and transcription-coupled repair (PubMed:17981804). Beside its role in pre-mRNA splicing PRPF19, as part of the PRP19-CDC5L complex, plays a role in the DNA damage response/DDR. It is recruited to the sites of DNA damage by the RPA complex where PRPF19 directly ubiquitinates RPA1 and RPA2. 'Lys-63'-linked polyubiquitination of the RPA complex allows the recruitment of the ATR-ATRIP complex and the activation of ATR, a master regulator of the DNA damage response (PubMed:24332808). May also play a role in DNA double-strand break (DSB) repair by recruiting the repair factor SETMAR to altered DNA (PubMed:18263876). As part of the PSO4 complex may also be involved in the DNA interstrand cross-links/ICLs repair process (PubMed:16223718). In addition, may also mediate 'Lys-48'-linked polyubiquitination of substrates and play a role in proteasomal degradation (PubMed:11435423). May play a role in the biogenesis of lipid droplets (By similarity). May play a role in neural differentiation possibly through its function as part of the spliceosome (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}