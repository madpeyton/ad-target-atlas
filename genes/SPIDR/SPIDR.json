dule":"blue","kme":0.0915723,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000164808","module":"yellow","kme":0.211374,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164808","entrez_id":["23514"],"uniprot":["Q14159"],"ncbi_summary":"Involved in several processes, including cellular response to camptothecin; cellular response to hydroxyurea; and regulation of double-strand break repair. Located in nuclear chromosome and nucleoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q14159","text":"Involved in early stages DNA double-strand break (DSB) repair via homologous recombination (HR) (PubMed:23509288, PubMed:23754376, PubMed:34253720, PubMed:39169038). As part of the Shu complex, promotes HR by regulating replication protein-A (RPA) dynamics on single-stranded DNA, thereby stabilizing RAD51 and DMC1 filaments on DNA (PubMed:34253720, PubMed:39169038). The Shu complex is essential during meiosis by stabilizing DMC1 filaments (PubMed:27967308, PubMed:34697795). In contrast, it is critical for only certain types of homologous-directed DNA repair, such as inter-homolog homologous recombination (IR-HR) (PubMed:34253720). IR-HR is a DNA repair mechanism where a cell repairs a DSB on one chromosome using the matching homologous chromosome as a template, rather than the sister chromatid (PubMed:34253720)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}