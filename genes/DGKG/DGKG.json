ct_control":0.180645,"donor_test":"not significant","donor_padj":0.881479,"donor_log2fc":0.0841208,"donor_lfcse":0.136266,"donor_log2fc_shrunk":0.00886532,"degas_log2fc":-0.0336704,"degas_padj":0.601772},{"cell_type":"OPC","gene_symbol":"DGKG","gene_symbol_current":"DGKG","gene_id":"ENSG00000058866","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.81748e-11,"nucleus_log2fc":0.110905,"nucleus_score":7.22259,"pct_ad":0.981509,"pct_control":0.975953,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0987094,"donor_lfcse":0.116626,"donor_log2fc_shrunk":7.47979e-06,"degas_log2fc":-0.313655,"degas_padj":8.2394e-77},{"cell_type":"Oli","gene_symbol":"DGKG","gene_symbol_current":"DGKG","gene_id":"ENSG00000058866","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.45043e-08,"nucleus_log2fc":0.189453,"nucleus_score":5.82506,"pct_ad":0.137555,"pct_control":0.122963,"donor_test":"not significant","donor_padj":0.562326,"donor_log2fc":0.37159,"donor_lfcse":0.17368,"donor_log2fc_shrunk":0.0141855,"degas_log2fc":0.0952145,"degas_padj":0.00431649}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000058866","module":"blue","kme":0.389793,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000058866","module":"turquoise","kme":0.117167,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000058866","module":"brown","kme":0.13302,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000058866","entrez_id":["1608"],"uniprot":["P49619"],"ncbi_summary":"This gene encodes an enzyme that is a member of the type I subfamily of diacylglycerol kinases, which are involved in lipid metabolism. These enzymes generate phosphatidic acid by catalyzing the phosphorylation of diacylglycerol, a fundamental lipid second messenger that activates numerous proteins, including protein kinase C isoforms, Ras guanyl nucleotide-releasing proteins and some transient receptor potential channels. Diacylglycerol kinase gamma has been implicated in cell cycle regulation and in the negative regulation of macrophage differentiation in leukemia cells. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49619","text":"Diacylglycerol kinase that converts diacylglycerol/DAG into phosphatidic acid/phosphatidate/PA and regulates the respective levels of these two bioactive lipids (PubMed:8034597). Thereby, acts as a central switch between the signaling pathways activated by these second messengers with different cellular targets and opposite effects in numerous biological processes (By similarity). Has no apparent specificity with regard to the acyl compositions of diacylglycerol (PubMed:8034597). Specifically expressed in the cerebellum where it controls the level of diacylglycerol which in turn regulates the activity of protein kinase C gamma. Through protein kinase C gamma, indirectly regulates the dendritic development of Purkinje cells, cerebellar long term depression and ultimately cerebellar motor coordination (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}