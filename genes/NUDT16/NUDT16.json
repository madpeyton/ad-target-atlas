l_type":"In","gene_symbol":"NUDT16","gene_symbol_current":"NUDT16","gene_id":"ENSG00000198585","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.899162,"donor_log2fc":-0.0448982,"donor_lfcse":0.0937224,"donor_log2fc_shrunk":-0.00236204},{"cell_type":"Mic","gene_symbol":"NUDT16","gene_symbol_current":"NUDT16","gene_id":"ENSG00000198585","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":8.91884e-07,"nucleus_log2fc":0.303371,"nucleus_score":5.22894,"pct_ad":0.150696,"pct_control":0.124885,"donor_test":"not significant","donor_padj":0.575913,"donor_log2fc":0.234921,"donor_lfcse":0.148321,"donor_log2fc_shrunk":0.0234546},{"cell_type":"OPC","gene_symbol":"NUDT16","gene_symbol_current":"NUDT16","gene_id":"ENSG00000198585","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0795292,"donor_lfcse":0.144478,"donor_log2fc_shrunk":4.01776e-06},{"cell_type":"Oli","gene_symbol":"NUDT16","gene_symbol_current":"NUDT16","gene_id":"ENSG00000198585","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.972293,"donor_log2fc":0.0251182,"donor_lfcse":0.100227,"donor_log2fc_shrunk":0.00255054}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198585","entrez_id":["131870"],"uniprot":["Q96DE0"],"ncbi_summary":"Enables several functions, including RNA binding activity; metal ion binding activity; and purine ribonucleoside triphosphate binding activity. Involved in IDP catabolic process; RNA metabolic process; and positive regulation of cell cycle process. Located in cytoplasm; nucleolus; and nucleoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96DE0","text":"RNA-binding and decapping enzyme that catalyzes the cleavage of the cap structure of snoRNAs and mRNAs in a metal-dependent manner. Part of the U8 snoRNP complex that is required for the accumulation of mature 5.8S and 28S rRNA. Has diphosphatase activity and removes m7G and/or m227G caps from U8 snoRNA and leaves a 5'monophosphate on the RNA. Also catalyzes the cleavage of the cap structure on mRNAs. Does not hydrolyze cap analog structures like 7-methylguanosine nucleoside triphosphate (m7GpppG). Also hydrolysis m7G- and m227G U3-capped RNAs but with less efficiencies. Has broad substrate specificity with manganese or cobalt as cofactor and can act on various RNA species. Binds to the U8 snoRNA; metal is not required for RNA-binding. May play a role in the regulation of snoRNAs and mRNAs degradation. Also acts as a phosphatase; hydrolyzes the non-canonical purine nucleotides inosine diphosphate (IDP) and deoxyinosine diphosphate (dITP) as well as guanosine diphosphate (GDP), deoxyguanosine diphosphate (dGDP), xanthine diphosphate (XDP), inosine triphosphate (ITP) and deoxyinosine triphosphate (ITP) to their respective monophosphate derivatives and does not distinguish between the deoxy- and ribose forms (PubMed:20385596, PubMed:26121039). The order of activity with different substrates is IDP > dIDP >> GDP = dGDP > XDP = ITP = dITP (PubMed:20385596). Binds strongly to GTP, ITP and XTP. Participates in the hydrolysis of dIDP/IDP and probably excludes non-canonical purines from RNA and DNA precursor pools, thus preventing their incorporation into RNA and DNA and avoiding chromosomal lesions (PubMed:20385596). Exhibits decapping activity towards NAD-capped RNAs and FAD-capped RNAs (PubMed:32432673). Exhibits decapping activity towards dpCoA-capped RNAs in vitro (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}