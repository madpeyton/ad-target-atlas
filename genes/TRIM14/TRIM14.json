ignificant","donor_padj":0.782446,"donor_log2fc":0.0928734,"donor_lfcse":0.0876162,"donor_log2fc_shrunk":0.00567473},{"cell_type":"Mic","gene_symbol":"TRIM14","gene_symbol_current":"TRIM14","gene_id":"ENSG00000106785","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":6.76797e-12,"nucleus_log2fc":0.284738,"nucleus_score":7.17905,"pct_ad":0.358589,"pct_control":0.313249,"donor_test":"not significant","donor_padj":0.357995,"donor_log2fc":0.223337,"donor_lfcse":0.0967098,"donor_log2fc_shrunk":0.0845699},{"cell_type":"OPC","gene_symbol":"TRIM14","gene_symbol_current":"TRIM14","gene_id":"ENSG00000106785","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.125527,"nucleus_log2fc":-0.10507,"nucleus_score":-1.95194,"pct_ad":0.282285,"pct_control":0.295851,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0881971,"donor_lfcse":0.0727928,"donor_log2fc_shrunk":-1.72483e-05},{"cell_type":"Oli","gene_symbol":"TRIM14","gene_symbol_current":"TRIM14","gene_id":"ENSG00000106785","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.969057,"donor_log2fc":0.0404341,"donor_lfcse":0.133075,"donor_log2fc_shrunk":0.00246114}],"modules":[{"cell_type":"In","gene_id":"ENSG00000106785","module":"purple","kme":0.278217,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000106785","entrez_id":["9830"],"uniprot":["Q14142"],"ncbi_summary":"The protein encoded by this gene is a member of the tripartite motif (TRIM) family. The TRIM motif includes three zinc-binding domains, a RING, a B-box type 1 and a B-box type 2, and a coiled-coil region. The protein localizes to cytoplasmic bodies and its function has not been determined. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q14142","text":"Plays an essential role in the innate immune defense against viruses and bacteria (PubMed:30150992, PubMed:32404352). Promotes the 'Lys-48'-linked ubiquitination and subsequent degradation of hepatitis C virus NS5A leading to the inhibition of viral replication (PubMed:27578425). Also plays a role in the inhibition of ebolavirus infection by enhancing IFN-beta and NF-kappa-B activation after binding to the viral protein NP (PubMed:37562033). Facilitates the type I IFN response by interacting with MAVS at the outer mitochondria membrane and thereby recruiting NF-kappa-B essential modulator IKBKG/NEMO to the MAVS signalosome, leading to the activation of both the IFN regulatory factor 3/IRF3 and NF-kappa-B pathways (PubMed:24379373). Positively regulates the CGAS-induced type I interferon signaling pathway by stabilizing CGAS and inhibiting its autophagic degradation (PubMed:27666593). Acts as a scaffold between TBK1 and STAT3 to promote phosphorylation of STAT3 and resolve interferon-stimulated gene (ISG) expression (PubMed:32404352). Inhibits the transcriptional activity of SPI1 in a dose-dependent manner (By similarity). Also inhibits OPTN-mediated selective autophagic degradation of KDM4D and thereby negatively regulates H3K9me2 and H3K9me3. Mechanistically, recruits USP14 to remove the 'Lys-63'-linked ubiquitination of KDM4D, preventing its recognition by OPTN and subsequent degradation (PubMed:35145029)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}