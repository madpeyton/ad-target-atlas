d","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.836039,"donor_log2fc":-0.0722943,"donor_lfcse":0.115538,"donor_log2fc_shrunk":-0.00463522,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"PIEZO1","gene_symbol_current":"PIEZO1","gene_id":"ENSG00000103335","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.967642,"donor_log2fc":-0.0234476,"donor_lfcse":0.136601,"donor_log2fc_shrunk":-0.000588363,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Mic","gene_symbol":"PIEZO1","gene_symbol_current":"PIEZO1","gene_id":"ENSG00000103335","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0929554,"nucleus_log2fc":0.0733092,"nucleus_score":1.9308,"pct_ad":0.277809,"pct_control":0.264631,"donor_test":"not significant","donor_padj":0.9791,"donor_log2fc":0.0147631,"donor_lfcse":0.0949753,"donor_log2fc_shrunk":0.00295869,"degas_log2fc":-0.0320005,"degas_padj":0.544826},{"cell_type":"OPC","gene_symbol":"PIEZO1","gene_symbol_current":"PIEZO1","gene_id":"ENSG00000103335","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.25375,"nucleus_log2fc":0.0807843,"nucleus_score":1.50765,"pct_ad":0.292723,"pct_control":0.280779,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.00971328,"donor_lfcse":0.105715,"donor_log2fc_shrunk":9.09402e-07,"degas_log2fc":-0.121882,"degas_padj":0.0235348},{"cell_type":"Oli","gene_symbol":"PIEZO1","gene_symbol_current":"PIEZO1","gene_id":"ENSG00000103335","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.22898,"donor_log2fc":0.765374,"donor_lfcse":0.224211,"donor_log2fc_shrunk":0.589851,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000103335","module":"blue","kme":0.104139,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000103335","entrez_id":["9780"],"uniprot":["Q92508"],"ncbi_summary":"The protein encoded by this gene is a mechanically-activated ion channel that links mechanical forces to biological signals. The encoded protein contains 36 transmembrane domains and functions as a homotetramer. Defects in this gene have been associated with dehydrated hereditary stomatocytosis. [provided by RefSeq, Jul 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92508","text":"Pore-forming subunit of the mechanosensitive non-specific cation Piezo channel required for rapidly adapting mechanically activated (MA) currents and has a key role in sensing touch and tactile pain (PubMed:23479567, PubMed:23695678, PubMed:25955826, PubMed:37590348). Piezo channels are homotrimeric three-blade propeller-shaped structures that utilize a cap-motion and plug-and-latch mechanism to gate their ion-conducting pathways (PubMed:37590348). Generates currents characterized by a linear current-voltage relationship that are sensitive to ruthenium red and gadolinium (By similarity). Conductance to monovalent alkali ions is highest for K(+), intermediate for Na(+) and lowest for Li(+) (PubMed:25955826). Divalent ions except for Mn(2+) permeate the channel but more slowly than the monovalent ions and they also reduce K(+) currents (PubMed:25955826). Plays a key role in epithelial cell adhesion by maintaining integrin activation through R-Ras recruitment to the ER, most probably in its activated state, and subsequent stimulation of calpain signaling (PubMed:20016066). In inner ear hair cells, PIEZO1/2 subunits may constitute part of the mechanotransducer (MET) non-selective cation channel complex where they may act as pore-forming ion-conducting component in the complex (By similarity). In the kidney, may contribute to the detection of intraluminal pressure changes and to urine flow sensing (By similarity). Acts as a shear-stress sensor that promotes endothelial cell organization and alignment in the direction of blood flow through calpain activation (PubMed:25119035). Plays a key role in blood vessel formation and vascular structure in both development and adult physiology (By similarity). Acts as a sensor of phosphatidylserine (PS) flipping at the plasma membrane and governs morphogenesis of muscle cells (By similarity). In myoblasts, flippase-mediated PS enrichment at the inner leaflet of plasma membrane triggers channel activation and Ca2+ influx followed by Rho GTPases signal transduction, leading to assembly of cortical actomyosin fibers and myotube formation (PubMed:29799007)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}