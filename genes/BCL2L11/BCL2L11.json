t_control":null,"donor_test":"not significant","donor_padj":0.931806,"donor_log2fc":-0.0144948,"donor_lfcse":0.0664404,"donor_log2fc_shrunk":-0.00328231},{"cell_type":"Inhibitory","gene_symbol":"BCL2L11","gene_symbol_current":"BCL2L11","gene_id":"ENSG00000153094","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.938864,"donor_log2fc":0.0134192,"donor_lfcse":0.0571255,"donor_log2fc_shrunk":0.00236224},{"cell_type":"Microglia","gene_symbol":"BCL2L11","gene_symbol_current":"BCL2L11","gene_id":"ENSG00000153094","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.901884,"donor_log2fc":0.0355485,"donor_lfcse":0.113385,"donor_log2fc_shrunk":0.00303582},{"cell_type":"Oligodendroglia","gene_symbol":"BCL2L11","gene_symbol_current":"BCL2L11","gene_id":"ENSG00000153094","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.537042,"donor_log2fc":0.0773489,"donor_lfcse":0.0743465,"donor_log2fc_shrunk":0.0196679}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000153094","entrez_id":["10018"],"uniprot":["O43521"],"ncbi_summary":"The protein encoded by this gene belongs to the BCL-2 protein family. BCL-2 family members form hetero- or homodimers and act as anti- or pro-apoptotic regulators that are involved in a wide variety of cellular activities. The protein encoded by this gene contains a Bcl-2 homology domain 3 (BH3). It has been shown to interact with other members of the BCL-2 protein family and to act as an apoptotic activator. The expression of this gene can be induced by nerve growth factor (NGF), as well as by the forkhead transcription factor FKHR-L1, which suggests a role of this gene in neuronal and lymphocyte apoptosis. Transgenic studies of the mouse counterpart suggested that this gene functions as an essential initiator of apoptosis in thymocyte-negative selection. Several alternatively spliced transcript variants of this gene have been identified. [provided by RefSeq, Jun 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43521","text":"Induces apoptosis and anoikis. Isoform BimL is more potent than isoform BimEL. Isoform Bim-alpha1, isoform Bim-alpha2 and isoform Bim-alpha3 induce apoptosis, although less potent than isoform BimEL, isoform BimL and isoform BimS. Isoform Bim-gamma induces apoptosis. Isoform Bim-alpha3 induces apoptosis possibly through a caspase-mediated pathway. Isoform BimAC and isoform BimABC lack the ability to induce apoptosis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}