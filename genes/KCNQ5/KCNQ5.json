re":-0.526418,"pct_ad":0.759095,"pct_control":0.767818,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0188785,"donor_lfcse":0.0975524,"donor_log2fc_shrunk":2.05415e-06},{"cell_type":"OPC","gene_symbol":"KCNQ5","gene_symbol_current":"KCNQ5","gene_id":"ENSG00000185760","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.101205,"nucleus_log2fc":-0.493706,"nucleus_score":-2.68413,"pct_ad":0.0753532,"pct_control":0.106513,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"KCNQ5","gene_symbol_current":"KCNQ5","gene_id":"ENSG00000185760","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.994454,"donor_log2fc":0.0114894,"donor_lfcse":0.234569,"donor_log2fc_shrunk":0.000203404}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000185760","module":"red","kme":0.329334,"hub":true,"module_direction":"lower in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000185760","module":"blue","kme":0.161264,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000185760","entrez_id":["56479"],"uniprot":["Q9NR82"],"ncbi_summary":"This gene is a member of the KCNQ potassium channel gene family that is differentially expressed in subregions of the brain and in skeletal muscle. The protein encoded by this gene yields currents that activate slowly with depolarization and can form heteromeric channels with the protein encoded by the KCNQ3 gene. Currents expressed from this protein have voltage dependences and inhibitor sensitivities in common with M-currents. They are also inhibited by M1 muscarinic receptor activation. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, May 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NR82","text":"Pore-forming subunit of the voltage-gated potassium (Kv) channel broadly expressed in brain and involved in the regulation of neuronal excitability (PubMed:10787416, PubMed:10816588, PubMed:11159685, PubMed:28669405). Associates with KCNQ3/Kv7.3 pore-forming subunit to form a potassium channel which contributes to M-type current, a slowly activating and deactivating potassium conductance which plays a critical role in determining the subthreshold electrical excitability of neurons (PubMed:10816588, PubMed:11159685). Contributes, with other potassium channels, to the molecular diversity of a heterogeneous population of M-channels, varying in kinetic and pharmacological properties, which underlie this physiologically important current (PubMed:10816588). Also forms a functional channel with KCNQ1/Kv7.1 subunit that may contribute to vasoconstriction and hypertension (PubMed:24855057). Channel may be selectively permeable in vitro to other cations besides potassium, in decreasing order of affinity K(+) = Rb(+) > Cs(+) > Na(+) (PubMed:10816588). Similar to the native M-channel, KCNQ3-KCNQ5 potassium channel is suppressed by activation of the muscarinic acetylcholine receptor CHRM1 (PubMed:10816588)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}