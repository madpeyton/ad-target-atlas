eus_direction":"higher in AD","nucleus_padj":0.796017,"nucleus_log2fc":0.0697496,"nucleus_score":0.573388,"pct_ad":0.144427,"pct_control":0.135632,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"CRBN","gene_symbol_current":"CRBN","gene_id":"ENSG00000113851","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.946545,"donor_log2fc":0.0443961,"donor_lfcse":0.101439,"donor_log2fc_shrunk":0.00392944}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000113851","module":"brown","kme":0.146122,"hub":false,"module_direction":"lower in AD","module_padj":0.652213,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000113851","module":"turquoise","kme":0.245324,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000113851","entrez_id":["51185"],"uniprot":["Q96SW2"],"ncbi_summary":"This gene encodes a protein related to the Lon protease protein family. In rodents and other mammals this gene product is found in the cytoplasm localized with a calcium channel membrane protein, and is thought to play a role in brain development. Mutations in this gene are associated with autosomal recessive nonsyndromic cognitive disability. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96SW2","text":"Substrate recognition component of a DCX (DDB1-CUL4-X-box) E3 protein ligase complex that mediates the ubiquitination and subsequent proteasomal degradation of target proteins, such as MEIS2, ILF2, GLUL, IKZF1 and CSNK1A1 (PubMed:26990986, PubMed:33009960, PubMed:41565821). Normal degradation of key regulatory proteins is required for normal limb outgrowth and expression of the fibroblast growth factor FGF8 (PubMed:20223979, PubMed:24328678, PubMed:25043012, PubMed:25108355). Maintains presynaptic glutamate release and consequently cognitive functions, such as memory and learning, by negatively regulating large-conductance calcium-activated potassium (BK) channels in excitatory neurons (PubMed:18414909, PubMed:29530986). Likely to function by regulating the assembly and neuronal surface expression of BK channels via its interaction with KCNT1 (PubMed:18414909). May also be involved in regulating anxiety-like behaviors via a BK channel-independent mechanism (By similarity). Plays a negative role in TLR4 signaling by interacting with TRAF6 and ECSIT, leading to inhibition of ECSIT ubiquitination, an important step of the signaling (PubMed:31620128)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}