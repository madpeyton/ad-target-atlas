,"nucleus_direction":"higher in AD","nucleus_padj":0.000637896,"nucleus_log2fc":0.0653826,"nucleus_score":3.60584,"pct_ad":0.674404,"pct_control":0.659864,"donor_test":"not significant","donor_padj":0.990984,"donor_log2fc":0.0093127,"donor_lfcse":0.143291,"donor_log2fc_shrunk":0.000257505},{"cell_type":"Ex","gene_symbol":"TGFBR3","gene_symbol_current":"TGFBR3","gene_id":"ENSG00000069702","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.58944e-32,"nucleus_log2fc":0.20207,"nucleus_score":11.8075,"pct_ad":0.284182,"pct_control":0.269211,"donor_test":"not significant","donor_padj":0.617842,"donor_log2fc":0.266342,"donor_lfcse":0.144377,"donor_log2fc_shrunk":0.0122266},{"cell_type":"In","gene_symbol":"TGFBR3","gene_symbol_current":"TGFBR3","gene_id":"ENSG00000069702","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00543218,"nucleus_log2fc":0.0474573,"nucleus_score":2.85747,"pct_ad":0.482467,"pct_control":0.481222,"donor_test":"not significant","donor_padj":0.880541,"donor_log2fc":0.0598249,"donor_lfcse":0.106692,"donor_log2fc_shrunk":0.00243619},{"cell_type":"Mic","gene_symbol":"TGFBR3","gene_symbol_current":"TGFBR3","gene_id":"ENSG00000069702","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.948033,"donor_log2fc":0.0985998,"donor_lfcse":0.28072,"donor_log2fc_shrunk":0.00258535},{"cell_type":"OPC","gene_symbol":"TGFBR3","gene_symbol_current":"TGFBR3","gene_id":"ENSG00000069702","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00804143,"nucleus_log2fc":0.237361,"nucleus_score":3.14576,"pct_ad":0.12705,"pct_control":0.108891,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.210033,"donor_lfcse":0.200201,"donor_log2fc_shrunk":5.28867e-06},{"cell_type":"Oli","gene_symbol":"TGFBR3","gene_symbol_current":"TGFBR3","gene_id":"ENSG00000069702","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.961873,"donor_log2fc":0.0688768,"donor_lfcse":0.192646,"donor_log2fc_shrunk":0.00196683}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000069702","module":"blue","kme":0.196892,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000069702","entrez_id":["7049"],"uniprot":["Q03167"],"ncbi_summary":"This locus encodes the transforming growth factor (TGF)-beta type III receptor. The encoded receptor is a membrane proteoglycan that often functions as a co-receptor with other TGF-beta receptor superfamily members. Ectodomain shedding produces soluble TGFBR3, which may inhibit TGFB signaling. Decreased expression of this receptor has been observed in various cancers. Alternatively spliced transcript variants encoding different isoforms have been identified for this gene.[provided by RefSeq, Sep 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q03167","text":"Cell surface receptor that regulates diverse cellular processes including cell proliferation, differentiation, migration, and apoptosis (PubMed:12958365, PubMed:19416857). Initiates BMP, inhibin, and TGF-beta signaling pathways by interacting with different ligands including TGFB1, BMP2, BMP5, BMP7 or GDF5 (PubMed:18184661). Alternatively, acts as a cell surface coreceptor for BMP ligands, serving to enhance ligand binding by differentially regulating BMPR1A/ALK3 and BMPR1B/ALK6 receptor trafficking (PubMed:19726563). Promotes epithelial cell adhesion, focal adhesion formation and integrin signaling during epithelial cell spreading on fibronectin (PubMed:22562249). By interacting with the scaffolding protein beta-arrestin2/ARRB2, regulates migration or actin cytoskeleton and promotes the activation of CDC42 as well as the inhibition of NF-kappa-B (PubMed:19416857, PubMed:19325136). In gonadotrope cells, acts as an inhibin A coreceptor and regulates follicle-stimulating hormone (FSH) levels and female fertility (By similarity). Plays a role in the inhibition of directed and random cell migration in epithelial cells by altering the actin cytoskeletal organization (PubMed:19416857). Participates in epithelial-mesenchymal transformation (EMT) upon binding to BMP2 or TGFB2, by activating the PAR6/SMURF1/RHOA pathway (By similarity). (Microbial infection) May act as a receptor for human cytomegalovirus in different cell types by interacting with HCMV trimer composed of GO, GH and GL."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}