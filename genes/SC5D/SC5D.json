":"ENSG00000109929","module":"turquoise","kme":0.172623,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000109929","module":"turquoise","kme":0.173864,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000109929","entrez_id":["6309"],"uniprot":["O75845"],"ncbi_summary":"This gene encodes an enzyme of cholesterol biosynthesis. The encoded protein catalyzes the conversion of lathosterol into 7-dehydrocholesterol. Mutations in this gene have been associated with lathosterolosis. Alternatively spliced transcript variants encoding the same protein have been described. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75845","text":"Catalyzes the penultimate step of the biosynthesis of cholesterol, the dehydrogenation of lathosterol into 7-dehydrocholesterol (7-DHC). Cholesterol is the major sterol component in mammalian membranes and a precursor for bile acid and steroid hormone synthesis (PubMed:10786622, PubMed:38297129). In addition to its essential role in cholesterol biosynthesis, it also indirectly regulates ferroptosis through the production of 7-DHC. By diverting the spread of damage caused by peroxyl radicals from the phospholipid components to its sterol nucleus, 7-DHC prevents this form of cell death (PubMed:38297129, PubMed:38297130)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}