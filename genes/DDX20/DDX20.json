,"donor_log2fc":0.044695,"donor_lfcse":0.110525,"donor_log2fc_shrunk":0.00679311},{"cell_type":"OPC","gene_symbol":"DDX20","gene_symbol_current":"DDX20","gene_id":"ENSG00000064703","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00167083,"nucleus_log2fc":0.255619,"nucleus_score":3.64931,"pct_ad":0.124814,"pct_control":0.10381,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.19871,"donor_lfcse":0.166805,"donor_log2fc_shrunk":7.46205e-06},{"cell_type":"Oli","gene_symbol":"DDX20","gene_symbol_current":"DDX20","gene_id":"ENSG00000064703","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.469589,"donor_log2fc":0.261744,"donor_lfcse":0.103923,"donor_log2fc_shrunk":0.0396054}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000064703","module":"turquoise","kme":0.0957819,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000064703","module":"turquoise","kme":0.194741,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000064703","module":"turquoise","kme":0.123262,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000064703","entrez_id":["11218"],"uniprot":["Q9UHI6"],"ncbi_summary":"DEAD box proteins, characterized by the conserved motif Asp-Glu-Ala-Asp (DEAD), are putative RNA helicases. They are implicated in a number of cellular processes involving alteration of RNA secondary structure such as translation initiation, nuclear and mitochondrial splicing, and ribosome and spliceosome assembly. Based on their distribution patterns, some members of this family are believed to be involved in embryogenesis, spermatogenesis, and cellular growth and division. This gene encodes a DEAD box protein, which has an ATPase activity and is a component of the survival of motor neurons (SMN) complex. This protein interacts directly with SMN, the spinal muscular atrophy gene product, and may play a catalytic role in the function of the SMN complex on RNPs. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UHI6","text":"The SMN complex catalyzes the assembly of small nuclear ribonucleoproteins (snRNPs), the building blocks of the spliceosome, and thereby plays an important role in the splicing of cellular pre-mRNAs. Most spliceosomal snRNPs contain a common set of Sm proteins SNRPB, SNRPD1, SNRPD2, SNRPD3, SNRPE, SNRPF and SNRPG that assemble in a heptameric protein ring on the Sm site of the small nuclear RNA to form the core snRNP (Sm core). In the cytosol, the Sm proteins SNRPD1, SNRPD2, SNRPE, SNRPF and SNRPG are trapped in an inactive 6S pICln-Sm complex by the chaperone CLNS1A that controls the assembly of the core snRNP. To assemble core snRNPs, the SMN complex accepts the trapped 5Sm proteins from CLNS1A forming an intermediate. Binding of snRNA inside 5Sm triggers eviction of the SMN complex, thereby allowing binding of SNRPD3 and SNRPB to complete assembly of the core snRNP. May also play a role in the metabolism of small nucleolar ribonucleoprotein (snoRNPs)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}