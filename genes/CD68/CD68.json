x","gene_symbol":"CD68","gene_symbol_current":"CD68","gene_id":"ENSG00000129226","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.756221,"donor_log2fc":0.132897,"donor_lfcse":0.137354,"donor_log2fc_shrunk":0.00634249},{"cell_type":"In","gene_symbol":"CD68","gene_symbol_current":"CD68","gene_id":"ENSG00000129226","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.795281,"donor_log2fc":-0.119466,"donor_lfcse":0.120683,"donor_log2fc_shrunk":-0.00389557},{"cell_type":"Mic","gene_symbol":"CD68","gene_symbol_current":"CD68","gene_id":"ENSG00000129226","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.23783e-11,"nucleus_log2fc":0.334505,"nucleus_score":6.83481,"pct_ad":0.22377,"pct_control":0.184677,"donor_test":"not significant","donor_padj":0.469122,"donor_log2fc":0.290218,"donor_lfcse":0.149428,"donor_log2fc_shrunk":0.0305522}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000129226","module":"red","kme":0.240536,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000129226","entrez_id":["968"],"uniprot":["P34810"],"ncbi_summary":"This gene encodes a 110-kD transmembrane glycoprotein that is highly expressed by human monocytes and tissue macrophages. It is a member of the lysosomal/endosomal-associated membrane glycoprotein (LAMP) family. The protein primarily localizes to lysosomes and endosomes with a smaller fraction circulating to the cell surface. It is a type I integral membrane protein with a heavily glycosylated extracellular domain and binds to tissue- and organ-specific lectins or selectins. The protein is also a member of the scavenger receptor family. Scavenger receptors typically function to clear cellular debris, promote phagocytosis, and mediate the recruitment and activation of macrophages. Alternative splicing results in multiple transcripts encoding different isoforms. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P34810","text":"Could play a role in phagocytic activities of tissue macrophages, both in intracellular lysosomal metabolism and extracellular cell-cell and cell-pathogen interactions. Binds to tissue- and organ-specific lectins or selectins, allowing homing of macrophage subsets to particular sites. Rapid recirculation of CD68 from endosomes and lysosomes to the plasma membrane may allow macrophages to crawl over selectin-bearing substrates or other cells."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}