SG00000132872","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.972959,"nucleus_log2fc":-0.0662976,"nucleus_score":0.107775,"pct_ad":0.218722,"pct_control":0.211329,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.102564,"donor_lfcse":0.163948,"donor_log2fc_shrunk":-3.95743e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000132872","module":"yellow","kme":0.379693,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000132872","entrez_id":["6860"],"uniprot":["Q9H2B2"],"ncbi_summary":"Predicted to enable several functions, including calcium ion binding activity; phospholipid binding activity; and syntaxin binding activity. Involved in negative regulation of catecholamine secretion and positive regulation of dendrite extension. Predicted to be located in several cellular components, including microvesicle; perinuclear region of cytoplasm; and secretory vesicle. Predicted to be active in several cellular components, including axon; exocytic vesicle; and glutamatergic synapse. Predicted to be integral component of neuronal dense core vesicle membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H2B2","text":"Synaptotagmin family member which does not bind Ca(2+) (By similarity) (PubMed:23999003). Involved in neuronal dense core vesicles (DCVs) mobility through its interaction with KIF1A. Upon increased neuronal activity, phosphorylation by MAPK8/JNK1 destabilizes the interaction with KIF1A and captures DCVs to synapses (By similarity). Plays a role in dendrite formation by melanocytes (PubMed:23999003)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}