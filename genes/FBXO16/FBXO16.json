ent":"FBXO16","gene_id":"ENSG00000214050","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.758219,"donor_log2fc":-0.204493,"donor_lfcse":0.146453,"donor_log2fc_shrunk":-0.0105826}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000214050","module":"blue","kme":0.0711644,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000214050","module":"pink","kme":0.219708,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000214050","module":"turquoise","kme":0.104934,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000214050","entrez_id":["157574"],"uniprot":["Q8IX29"],"ncbi_summary":"This gene encodes a member of the F-box protein family, members of which are characterized by an approximately 40 amino acid motif, the F-box. The F-box proteins constitute one of the four subunits of ubiquitin protein ligase complex called SCFs (SKP1-cullin-F-box), which function in phosphorylation-dependent ubiquitination. The F-box proteins are divided into three classes: Fbws containing WD-40 domains, Fbls containing leucine-rich repeats, and Fbxs containing either different protein-protein interaction modules or no recognizable motifs. The protein encoded by this gene belongs to the Fbx class. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Apr 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IX29","text":"Substrate recognition component of an SCF (SKP1-CUL1-F-box protein) E3 ubiquitin-protein ligase complex that mediates the ubiquitination and subsequent proteasomal degradation of target proteins. Functions as a putative tumor suppressor by targeting nuclear beta-catenin/CTNNB1 for degradation independently of upstream activating signals, thereby inhibiting epithelial-to-mesenchymal transition (PubMed:30714168). Controls the ubiquitination and degradation of hnRNPL (PubMed:34333526). Negatively regulates NF-kappa-B signaling by mediating the polyubiquitination and degradation of RELA (PubMed:40529355). Inhibits autophagy by promoting 'Lys-48'-linked polyubiquitination of the serine/threonine-protein kinase ULK1 (PubMed:39384743)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}