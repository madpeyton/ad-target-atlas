j":0.806373,"donor_log2fc":-0.192911,"donor_lfcse":0.163217,"donor_log2fc_shrunk":-0.00696726}],"modules":[{"cell_type":"In","gene_id":"ENSG00000047578","module":"yellow","kme":0.160849,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000047578","entrez_id":["23247"],"uniprot":["O60303"],"ncbi_summary":"This gene encodes a novel, evolutionarily conserved, ciliary protein. In human hTERT-RPE1 cells, the protein is found at the base of cilia, decorating the ciliary axoneme, and enriched at the ciliary tip. The protein binds to microtubules in vitro and regulates their stability when it is overexpressed. A null mutation in this gene has been associated with Joubert syndrome, a recessive disorder that is characterized by a distinctive mid-hindbrain and cerebellar malformation and is also often associated with wider ciliopathy symptoms. Consistently, in a serum-starvation ciliogenesis assay, human fibroblast cells derived from patients with the mutation display a reduced number of ciliated cells with abnormally long cilia. [provided by RefSeq, Feb 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60303","text":"May influence the stability of microtubules (MT), possibly through interaction with the MT-severing katanin complex."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}