87,"pct_control":0.464933,"donor_test":"not significant","donor_padj":0.849519,"donor_log2fc":-0.0385807,"donor_lfcse":0.0546985,"donor_log2fc_shrunk":-0.00592254,"degas_log2fc":-0.208394,"degas_padj":4.37891e-89},{"cell_type":"Mic","gene_symbol":"TRIP4","gene_symbol_current":"TRIP4","gene_id":"ENSG00000103671","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.849748,"nucleus_log2fc":-0.0142855,"nucleus_score":-0.250478,"pct_ad":0.304271,"pct_control":0.30576,"donor_test":"not significant","donor_padj":0.937176,"donor_log2fc":-0.0296151,"donor_lfcse":0.0723186,"donor_log2fc_shrunk":-0.00874122,"degas_log2fc":0.0659603,"degas_padj":0.152022},{"cell_type":"OPC","gene_symbol":"TRIP4","gene_symbol_current":"TRIP4","gene_id":"ENSG00000103671","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.79177e-06,"nucleus_log2fc":-0.342148,"nucleus_score":-5.28652,"pct_ad":0.176558,"pct_control":0.212024,"donor_test":"not significant","donor_padj":0.991471,"donor_log2fc":-0.275232,"donor_lfcse":0.108309,"donor_log2fc_shrunk":-2.43414e-05,"degas_log2fc":-0.265632,"degas_padj":4.68398e-05},{"cell_type":"Oli","gene_symbol":"TRIP4","gene_symbol_current":"TRIP4","gene_id":"ENSG00000103671","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.519992,"nucleus_log2fc":-0.0157454,"nucleus_score":-0.719788,"pct_ad":0.216644,"pct_control":0.21895,"donor_test":"not significant","donor_padj":0.898266,"donor_log2fc":0.0477814,"donor_lfcse":0.0632217,"donor_log2fc_shrunk":0.0119712,"degas_log2fc":-0.156727,"degas_padj":8.29023e-10}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000103671","module":"blue","kme":0.0999752,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000103671","entrez_id":["9325"],"uniprot":["Q15650"],"ncbi_summary":"This gene encodes a subunit of the tetrameric nuclear activating signal cointegrator 1 (ASC-1) complex, which associates with transcriptional coactivators, nuclear receptors and basal transcription factors to facilitate nuclear receptors-mediated transcription. This protein is localized in the nucleus and contains an E1A-type zinc finger domain, which mediates interaction with transcriptional coactivators and ligand-bound nuclear receptors, such as thyroid hormone receptor and retinoid X receptor alpha, but not glucocorticoid receptor. Mutations in this gene are associated with spinal muscular atrophy with congenital bone fractures-1 (SMABF1). [provided by RefSeq, Apr 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15650","text":"Transcription coactivator which associates with nuclear receptors, transcriptional coactivators including EP300, CREBBP and NCOA1, and basal transcription factors like TBP and TFIIA to facilitate nuclear receptors-mediated transcription (PubMed:10454579, PubMed:25219498). May thereby play an important role in establishing distinct coactivator complexes under different cellular conditions (PubMed:10454579, PubMed:25219498). Plays a role in thyroid hormone receptor and estrogen receptor transactivation (PubMed:10454579, PubMed:25219498). Also involved in androgen receptor transactivation (By similarity). Plays a pivotal role in the transactivation of NF-kappa-B, SRF and AP1 (PubMed:12077347). Acts as a mediator of transrepression between nuclear receptor and either AP1 or NF-kappa-B (PubMed:12077347). May play a role in the development of neuromuscular junction (PubMed:26924529). May play a role in late myogenic differentiation (By similarity). Also functions as part of the RQC trigger (RQT) complex that activates the ribosome quality control (RQC) pathway, a pathway that degrades nascent peptide chains during problematic translation (PubMed:32099016, PubMed:32579943, PubMed:36302773)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}