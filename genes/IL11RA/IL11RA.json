":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.500355,"donor_log2fc":-0.325077,"donor_lfcse":0.177726,"donor_log2fc_shrunk":-0.0230745,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"IL11RA","gene_symbol_current":"IL11RA","gene_id":"ENSG00000137070","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.540817,"nucleus_log2fc":-0.0478978,"nucleus_score":-0.868053,"pct_ad":0.0985684,"pct_control":0.103302,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0768504,"donor_lfcse":0.105415,"donor_log2fc_shrunk":-7.19986e-06,"degas_log2fc":-0.219778,"degas_padj":0.0192426},{"cell_type":"Oli","gene_symbol":"IL11RA","gene_symbol_current":"IL11RA","gene_id":"ENSG00000137070","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.965675,"donor_log2fc":-0.0358019,"donor_lfcse":0.105399,"donor_log2fc_shrunk":-0.00331293,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000137070","module":"brown","kme":0.106973,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000137070","module":"turquoise","kme":0.0409339,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000137070","module":"turquoise","kme":0.0398795,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000137070","entrez_id":["3590"],"uniprot":["Q14626"],"ncbi_summary":"Interleukin 11 is a stromal cell-derived cytokine that belongs to a family of pleiotropic and redundant cytokines that use the gp130 transducing subunit in their high affinity receptors. This gene encodes the IL-11 receptor, which is a member of the hematopoietic cytokine receptor family. This particular receptor is very similar to ciliary neurotrophic factor, since both contain an extracellular region with a 2-domain structure composed of an immunoglobulin-like domain and a cytokine receptor-like domain. Multiple alternatively spliced transcript variants have been found for this gene. [provided by RefSeq, Jun 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q14626","text":"Receptor for interleukin-11 (IL11). The receptor systems for IL6, LIF, OSM, CNTF, IL11 and CT1 can utilize IL6ST for initiating signal transmission. The IL11/IL11RA/IL6ST complex may be involved in the control of proliferation and/or differentiation of skeletogenic progenitor or other mesenchymal cells (Probable). Essential for the normal development of craniofacial bones and teeth. Restricts suture fusion and tooth number. [Soluble interleukin-11 receptor subunit alpha]: Soluble form of IL11 receptor (sIL11RA) that acts as an agonist of IL11 activity (PubMed:26876177, PubMed:30279168). The IL11:sIL11RA complex binds to IL6ST/gp130 on cell surfaces and induces signaling also on cells that do not express membrane-bound IL11RA in a process called IL11 trans-signaling (PubMed:26876177, PubMed:30279168). [Isoform HCR2]: Soluble form of IL11 receptor (sIL11RA) that acts as an agonist of IL11 activity (PubMed:26876177, PubMed:30279168). The IL11:sIL11RA complex binds to IL6ST/gp130 on cell surfaces and induces signaling also on cells that do not express membrane-bound IL11RA in a process called IL11 trans-signaling (PubMed:26876177, PubMed:30279168)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}