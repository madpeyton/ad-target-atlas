:false,"nucleus_direction":"lower in AD","nucleus_padj":0.447299,"nucleus_log2fc":-0.0558308,"nucleus_score":-1.05109,"pct_ad":0.33567,"pct_control":0.34293,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0107078,"donor_lfcse":0.0845375,"donor_log2fc_shrunk":-1.5474e-06},{"cell_type":"Oli","gene_symbol":"EIPR1","gene_symbol_current":"EIPR1","gene_id":"ENSG00000032389","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.95057e-05,"nucleus_log2fc":-0.107421,"nucleus_score":-4.32968,"pct_ad":0.176955,"pct_control":0.189755,"donor_test":"not significant","donor_padj":0.944563,"donor_log2fc":-0.0417568,"donor_lfcse":0.0904959,"donor_log2fc_shrunk":-0.0051727}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000032389","module":"blue","kme":0.194804,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000032389","entrez_id":["7260"],"uniprot":["Q53HC9"],"ncbi_summary":"This gene has been reported in PMID 9403053 as one of several tumor-suppressing subtransferable fragments located in the imprinted gene domain of 11p15.5, an important tumor-suppressor gene region. Alterations in this region have been associated with the Beckwith-Wiedemann syndrome, Wilms tumor, rhabdomyosarcoma, adrenocortical carcinoma, and lung, ovarian, and breast cancer. Alignment of this gene to genomic sequence data suggests that this gene resides on chromosome 2 rather than chromosome 11. [provided by RefSeq, Dec 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q53HC9","text":"Acts as a component of endosomal retrieval machinery that is involved in protein transport from early endosomes to either recycling endosomes or the trans-Golgi network (PubMed:27440922). Mediates the recruitment of Golgi-associated retrograde protein (GARP) complex to the trans-Golgi network and controls early endosome-to-Golgi transport of internalized protein (PubMed:27440922). Promotes the recycling of internalized transferrin receptor (TFRC) to the plasma membrane through interaction with endosome-associated recycling protein (EARP) complex (PubMed:27440922). Controls proper insulin distribution and secretion, and retention of cargo in mature dense core vesicles (By similarity). Required for the stability of the endosome-associated retrograde protein (EARP) complex subunits and for proper localization and association of EARP with membranes (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}