as_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000158966","entrez_id":["57685"],"uniprot":["Q5VU97"],"ncbi_summary":"Predicted to enable voltage-gated calcium channel activity. Predicted to be involved in calcium ion transmembrane transport. Predicted to be integral component of membrane. Predicted to be part of voltage-gated calcium channel complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5VU97","text":"Is a regulator of voltage-dependent calcium channels, modulating the activity of T-type calcium channels; it probably forms complexes with Cav3.1 at the cell surface and increases channel open probability (PubMed:30181139). Is also involved in the regulation of Wnt signaling, acting within a ternary complex as scaffold component that bridges FZD5 and LRP6 (By similarity). Plays a role in the regulation of neural progenitor cells proliferation and differentiation (PubMed:38158856)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}