86448","module":"turquoise","kme":0.137323,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000186448","module":"turquoise","kme":0.0335665,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000186448","entrez_id":["10168"],"uniprot":["O14709"],"ncbi_summary":"This gene product belongs to the zinc finger protein superfamily, members of which are regulatory proteins characterized by nucleic acid-binding zinc finger domains. The encoded protein contains 20 tandemly arrayed C2H2-type zinc fingers, a Kruppel-associated box (KRAB) domain, and a SCAN box. This transcript turns over rapidly and contains 3' UTR AUUUA motifs, which are often a hallmark of rapid turnover. It is overexpressed in some thyroid papillary carcinomas. This gene is located in a cluster of zinc finger genes at 3p21. Naturally-occurring readthrough transcription is observed between this gene and the upstream zinc finger protein 660 gene and is represented by GeneID:110354863. [provided by RefSeq, May 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O14709","text":"May be involved in transcriptional regulation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}