ection":"higher in AD","nucleus_padj":0.0367283,"nucleus_log2fc":0.160885,"nucleus_score":2.35711,"pct_ad":0.146797,"pct_control":0.135599,"donor_test":"not significant","donor_padj":0.893025,"donor_log2fc":0.0981024,"donor_lfcse":0.169243,"donor_log2fc_shrunk":0.00681778,"degas_log2fc":-0.37807,"degas_padj":1.16114e-09},{"cell_type":"OPC","gene_symbol":"SENP3","gene_symbol_current":"SENP3","gene_id":"ENSG00000161956","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.743567,"nucleus_log2fc":0.0603812,"nucleus_score":0.502841,"pct_ad":0.128392,"pct_control":0.125656,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.00841077,"donor_lfcse":0.11773,"donor_log2fc_shrunk":-5.7513e-07,"degas_log2fc":-0.413173,"degas_padj":3.65465e-07},{"cell_type":"Oli","gene_symbol":"SENP3","gene_symbol_current":"SENP3","gene_id":"ENSG00000161956","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.993084,"nucleus_log2fc":0.00242594,"nucleus_score":0.0104664,"pct_ad":0.100581,"pct_control":0.100511,"donor_test":"not significant","donor_padj":0.983107,"donor_log2fc":-0.0140801,"donor_lfcse":0.0929164,"donor_log2fc_shrunk":-0.00160489,"degas_log2fc":-0.26776,"degas_padj":1.10864e-12}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000161956","module":"blue","kme":0.141413,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000161956","entrez_id":["26168"],"uniprot":["Q9H4L4"],"ncbi_summary":"The reversible posttranslational modification of proteins by the addition of small ubiquitin-like SUMO proteins (see SUMO1; MIM 601912) is required for numerous biologic processes. SUMO-specific proteases, such as SENP3, are responsible for the initial processing of SUMO precursors to generate a C-terminal diglycine motif required for the conjugation reaction. They also have isopeptidase activity for the removal of SUMO from high molecular mass SUMO conjugates (Di Bacco et al., 2006 [PubMed 16738315]).[supplied by OMIM, Jun 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H4L4","text":"Protease that releases SUMO2 and SUMO3 monomers from sumoylated substrates, but has only weak activity against SUMO1 conjugates (PubMed:16608850, PubMed:32832608, PubMed:36050397). Deconjugates SUMO2 from MEF2D, which increases its transcriptional activation capability (PubMed:15743823). Deconjugates SUMO2 and SUMO3 from CDCA8 (PubMed:18946085). Redox sensor that, when redistributed into nucleoplasm, can act as an effector to enhance HIF1A transcriptional activity by desumoylating EP300 (PubMed:19680224). Required for rRNA processing through deconjugation of SUMO2 and SUMO3 from nucleophosmin, NPM1 (PubMed:19015314). Plays a role in the regulation of sumoylation status of ZNF148 (PubMed:18259216). Functions as a component of the Five Friends of Methylated CHTOP (5FMC) complex; the 5FMC complex is recruited to ZNF148 by methylated CHTOP, leading to desumoylation of ZNF148 and subsequent transactivation of ZNF148 target genes (PubMed:22872859). Deconjugates SUMO2 from KAT5 (PubMed:32832608). Catalyzes desumoylation of MRE11 (PubMed:36050397)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}