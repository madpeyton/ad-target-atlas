9","module":"turquoise","kme":0.0865765,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000112759"],"dataset_symbols":["SLC29A1"],"explorer":"explorer.html?dataset=mathys2019#gene/SLC29A1","cell_types":[{"cell_type":"Ex","gene_symbol":"SLC29A1","gene_symbol_current":"SLC29A1","gene_id":"ENSG00000112759","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.986474,"nucleus_log2fc":0.022361,"nucleus_score":0.0209655,"pct_ad":0.149228,"pct_control":0.149306,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.107371,"donor_lfcse":0.108924,"donor_log2fc_shrunk":9.37259e-06},{"cell_type":"In","gene_symbol":"SLC29A1","gene_symbol_current":"SLC29A1","gene_id":"ENSG00000112759","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.357258,"nucleus_log2fc":0.136595,"nucleus_score":1.84743,"pct_ad":0.127773,"pct_control":0.109866,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0824356,"donor_lfcse":0.177538,"donor_log2fc_shrunk":2.747e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000112759","module":"brown","kme":0.209807,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000112759","entrez_id":["2030"],"uniprot":["Q99808"],"ncbi_summary":"This gene is a member of the equilibrative nucleoside transporter family. The gene encodes a transmembrane glycoprotein that localizes to the plasma and mitochondrial membranes and mediates the cellular uptake of nucleosides from the surrounding medium. The protein is categorized as an equilibrative (as opposed to concentrative) transporter that is sensitive to inhibition by nitrobenzylthioinosine (NBMPR). Nucleoside transporters are required for nucleotide synthesis in cells that lack de novo nucleoside synthesis pathways, and are also necessary for the uptake of cytotoxic nucleosides used for cancer and viral chemotherapies. Multiple alternatively spliced variants, encoding the same protein, have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q99808","text":"Uniporter involved in the facilitative transport of nucleosides and nucleobases, and contributes to maintaining their cellular homeostasis (PubMed:10722669, PubMed:10755314, PubMed:12527552, PubMed:14759222, PubMed:15037197, PubMed:17379602, PubMed:21795683, PubMed:26406980, PubMed:27995448, PubMed:35790189, PubMed:8986748). Functions as a Na(+)-independent transporter (PubMed:8986748). Involved in the transport of nucleosides such as adenosine, guanosine, inosine, uridine, thymidine and cytidine (PubMed:10722669, PubMed:10755314, PubMed:12527552, PubMed:14759222, PubMed:15037197, PubMed:17379602, PubMed:26406980, PubMed:8986748, PubMed:39737929). Also transports purine nucleobases (hypoxanthine, adenine, guanine) and pyrimidine nucleobases (thymine, uracil) (PubMed:21795683, PubMed:27995448). Also mediates the uptake of nicotinamide; contributes to maintaining nicotinamide homeostasis but also regulated nicotinamide biological roles (PubMed:39885119). Mediates basolateral nucleoside uptake into Sertoli cells, thereby regulating the transport of nucleosides in testis across the blood-testis barrier (By similarity). Regulates inosine levels in brown adipocytes tissues (BAT) and extracellular inosine levels, which controls BAT-dependent energy expenditure (PubMed:35790189)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}