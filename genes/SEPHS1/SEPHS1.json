leus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.282346,"nucleus_log2fc":-0.00926264,"nucleus_score":-1.13114,"pct_ad":0.203772,"pct_control":0.206349,"donor_test":"not significant","donor_padj":0.803198,"donor_log2fc":0.0438192,"donor_lfcse":0.0469954,"donor_log2fc_shrunk":0.00876928},{"cell_type":"Mic","gene_symbol":"SEPHS1","gene_symbol_current":"SEPHS1","gene_id":"ENSG00000086475","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0145002,"nucleus_log2fc":0.198474,"nucleus_score":2.72409,"pct_ad":0.104643,"pct_control":0.0930876,"donor_test":"not significant","donor_padj":0.630545,"donor_log2fc":0.114345,"donor_lfcse":0.0806782,"donor_log2fc_shrunk":0.0338313},{"cell_type":"OPC","gene_symbol":"SEPHS1","gene_symbol_current":"SEPHS1","gene_id":"ENSG00000086475","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.701537,"nucleus_log2fc":0.0596413,"nucleus_score":0.576822,"pct_ad":0.145541,"pct_control":0.142252,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0349776,"donor_lfcse":0.0828225,"donor_log2fc_shrunk":5.2934e-06},{"cell_type":"Oli","gene_symbol":"SEPHS1","gene_symbol_current":"SEPHS1","gene_id":"ENSG00000086475","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.251035,"nucleus_log2fc":0.0495476,"nucleus_score":1.25211,"pct_ad":0.113608,"pct_control":0.110655,"donor_test":"not significant","donor_padj":0.971528,"donor_log2fc":0.0186395,"donor_lfcse":0.0704948,"donor_log2fc_shrunk":0.00345598}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000086475","entrez_id":["22929"],"uniprot":["P49903"],"ncbi_summary":"This gene encodes an enzyme that synthesizes selenophosphate from selenide and ATP. Selenophosphate is the selenium donor used to synthesize selenocysteine, which is co-translationally incorporated into selenoproteins at in-frame UGA codons. [provided by RefSeq, Sep 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49903","text":"Core component of the zincore complex, a heterotetramer that acts as a molecular 'grip' to stabilize transcription factors at DNA-binding sites across the genome, thereby controlling gene expression (PubMed:40608935). The zincore complex binds specifically to zinc finger transcription factors, such as ZFP91, ZNF652, ZNF526 and PRDM15, and stabilizes them onto their cognate DNA motif (PubMed:40608935). Within the complex, SEPHS1, recognizes and binds the backbone of zinc fingers of transcription factors in a sequence-independent manner via its arginine clamp, enhancing their DNA-binding stability (PubMed:40608935). Plays an essential role in redox homeostasis (PubMed:31607477). May also be involved in selenocysteine biosynthesis by catalyzing formation of selenophosphate from selenide and ATP (PubMed:7665581). Its role in selenocysteine biosynthesis is however unclear and several studies suggest that it does not act as a selenophosphate synthase in vivo or plays an non-essential role (PubMed:15534230). Required for cardiac differentiation (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}