b":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000086475"],"dataset_symbols":["SEPHS1"],"explorer":"explorer.html?dataset=mathys2019#gene/SEPHS1","cell_types":[{"cell_type":"Ex","gene_symbol":"SEPHS1","gene_symbol_current":"SEPHS1","gene_id":"ENSG00000086475","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.131035,"donor_lfcse":0.100769,"donor_log2fc_shrunk":3.53891e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000086475","entrez_id":["22929"],"uniprot":["P49903"],"ncbi_summary":"This gene encodes an enzyme that synthesizes selenophosphate from selenide and ATP. Selenophosphate is the selenium donor used to synthesize selenocysteine, which is co-translationally incorporated into selenoproteins at in-frame UGA codons. [provided by RefSeq, Sep 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49903","text":"Core component of the zincore complex, a heterotetramer that acts as a molecular 'grip' to stabilize transcription factors at DNA-binding sites across the genome, thereby controlling gene expression (PubMed:40608935). The zincore complex binds specifically to zinc finger transcription factors, such as ZFP91, ZNF652, ZNF526 and PRDM15, and stabilizes them onto their cognate DNA motif (PubMed:40608935). Within the complex, SEPHS1, recognizes and binds the backbone of zinc fingers of transcription factors in a sequence-independent manner via its arginine clamp, enhancing their DNA-binding stability (PubMed:40608935). Plays an essential role in redox homeostasis (PubMed:31607477). May also be involved in selenocysteine biosynthesis by catalyzing formation of selenophosphate from selenide and ATP (PubMed:7665581). Its role in selenocysteine biosynthesis is however unclear and several studies suggest that it does not act as a selenophosphate synthase in vivo or plays an non-essential role (PubMed:15534230). Required for cardiac differentiation (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}