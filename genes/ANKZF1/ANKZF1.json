odule":"red","kme":0.0994337,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000163516","module":"turquoise","kme":0.0362367,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163516","entrez_id":["55139"],"uniprot":["Q9H8Y5"],"ncbi_summary":"Predicted to enable metal ion binding activity. Involved in cellular response to hydrogen peroxide. Located in cytoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H8Y5","text":"Endonuclease that cleaves polypeptidyl-tRNAs downstream of the ribosome-associated quality control (RQC) pathway to release incompletely synthesized polypeptides for degradation (PubMed:29632312, PubMed:30244831, PubMed:31011209). The RQC pathway disassembles aberrantly stalled translation complexes to recycle or degrade the constituent parts (PubMed:29632312, PubMed:30244831, PubMed:31011209). ANKZF1 acts downstream disassembly of stalled ribosomes and specifically cleaves off the terminal 3'-CCA nucleotides universal to all tRNAs from polypeptidyl-tRNAs, releasing (1) ubiquitinated polypeptides from 60S ribosomal subunit for degradation and (2) cleaved tRNAs (PubMed:31011209). ANKZF1-cleaved tRNAs are then repaired and recycled by ELAC1 and TRNT1 (PubMed:31011209, PubMed:32075755). Also plays a role in the cellular response to hydrogen peroxide and in the maintenance of mitochondrial integrity under conditions of cellular stress (PubMed:28302725)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}