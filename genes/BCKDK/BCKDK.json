false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"seaad_pfc":{"dataset_label":"SEA-AD (Gabitto et al. 2024)","gene_ids":["ENSG00000103507"],"dataset_symbols":["BCKDK"],"explorer":"explorer.html?dataset=seaad_pfc#gene/BCKDK","cell_types":[{"cell_type":"Ast","gene_symbol":"BCKDK","gene_symbol_current":"BCKDK","gene_id":"ENSG00000103507","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.95355,"donor_log2fc":0.0445822,"donor_lfcse":0.138839,"donor_log2fc_shrunk":0.00139523},{"cell_type":"Ex","gene_symbol":"BCKDK","gene_symbol_current":"BCKDK","gene_id":"ENSG00000103507","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.24789e-22,"nucleus_log2fc":-0.0975567,"nucleus_score":-9.85046,"pct_ad":0.120799,"pct_control":0.134317,"donor_test":"not significant","donor_padj":0.792125,"donor_log2fc":-0.10204,"donor_lfcse":0.128621,"donor_log2fc_shrunk":-0.0055262},{"cell_type":"In","gene_symbol":"BCKDK","gene_symbol_current":"BCKDK","gene_id":"ENSG00000103507","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.816986,"donor_log2fc":-0.103006,"donor_lfcse":0.117714,"donor_log2fc_shrunk":-0.00350722},{"cell_type":"Mic","gene_symbol":"BCKDK","gene_symbol_current":"BCKDK","gene_id":"ENSG00000103507","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.983445,"donor_log2fc":0.0174782,"donor_lfcse":0.151209,"donor_log2fc_shrunk":0.00149853},{"cell_type":"OPC","gene_symbol":"BCKDK","gene_symbol_current":"BCKDK","gene_id":"ENSG00000103507","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0528254,"donor_lfcse":0.186047,"donor_log2fc_shrunk":1.58409e-06},{"cell_type":"Oli","gene_symbol":"BCKDK","gene_symbol_current":"BCKDK","gene_id":"ENSG00000103507","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999357,"donor_log2fc":0.0007076,"donor_lfcse":0.142633,"donor_log2fc_shrunk":5.31144e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000103507","entrez_id":["10295"],"uniprot":["O14874"],"ncbi_summary":"The branched-chain alpha-ketoacid dehydrogenase complex (BCKD) is an important regulator of the valine, leucine, and isoleucine catabolic pathways. The protein encoded by this gene is found in the mitochondrion, where it phosphorylates and inactivates BCKD. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Dec 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O14874","text":"Serine/threonine-protein kinase component of macronutrients metabolism. Forms a functional kinase and phosphatase pair with PPM1K, serving as a metabolic regulatory node that coordinates branched-chain amino acids (BCAAs) with glucose and lipid metabolism via two distinct phosphoprotein targets: mitochondrial BCKDHA subunit of the branched-chain alpha-ketoacid dehydrogenase (BCKDH) complex and cytosolic ACLY, a lipogenic enzyme of Krebs cycle (PubMed:24449431, PubMed:29779826, PubMed:37558654). Phosphorylates and inactivates mitochondrial BCKDH complex a multisubunit complex consisting of three multimeric components each involved in different steps of BCAA catabolism: E1 composed of BCKDHA and BCKDHB, E2 core composed of DBT monomers, and E3 composed of DLD monomers. Associates with the E2 component of BCKDH complex and phosphorylates BCKDHA on Ser-337, leading to conformational changes that interrupt substrate channeling between E1 and E2 and inactivates the BCKDH complex (PubMed:29779826, PubMed:37558654). Phosphorylates ACLY on Ser-455 in response to changes in cellular carbohydrate abundance such as occurs during fasting to feeding metabolic transition. Refeeding stimulates MLXIPL/ChREBP transcription factor, leading to increased BCKDK to PPM1K expression ratio, phosphorylation and activation of ACLY that ultimately results in the generation of malonyl-CoA and oxaloacetate immediate substrates of de novo lipogenesis and glucogenesis, respectively (PubMed:29779826). Recognizes phosphosites having SxxE/D canonical motif (PubMed:29779826)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}