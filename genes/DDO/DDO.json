nk":-2.05577e-07},{"cell_type":"Oli","gene_symbol":"DDO","gene_symbol_current":"DDO","gene_id":"ENSG00000203797","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.809532,"donor_log2fc":-0.175238,"donor_lfcse":0.146839,"donor_log2fc_shrunk":-0.0088247}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000203797","entrez_id":["8528"],"uniprot":["Q99489"],"ncbi_summary":"The protein encoded by this gene is a peroxisomal flavoprotein that catalyzes the oxidative deamination of D-aspartate and N-methyl D-aspartate. Flavin adenine dinucleotide or 6-hydroxyflavin adenine dinucleotide can serve as the cofactor in this reaction. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jan 2019].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q99489","text":"Selectively catalyzes the oxidative deamination of acidic amino acids (PubMed:1991137, PubMed:20603179, PubMed:23391306, PubMed:25747990, PubMed:28393897, PubMed:28560262, PubMed:28629864, PubMed:29292239, PubMed:31914658, PubMed:32553892, PubMed:9163533). Suppresses the level of D-aspartate in the brain, an amino acid that can act as an agonist for glutamate receptors (PubMed:28560262). Protects the organism from the toxicity of D-amino acids (By similarity). May also function in the intestine (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}