ad":0.113092,"pct_control":0.135599,"donor_test":"not significant","donor_padj":0.48016,"donor_log2fc":-0.234667,"donor_lfcse":0.12365,"donor_log2fc_shrunk":-0.0369732},{"cell_type":"OPC","gene_symbol":"USP49","gene_symbol_current":"USP49","gene_id":"ENSG00000164663","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.28721e-08,"nucleus_log2fc":-0.246649,"nucleus_score":-6.03571,"pct_ad":0.42201,"pct_control":0.465876,"donor_test":"not significant","donor_padj":0.932221,"donor_log2fc":-0.202264,"donor_lfcse":0.0710286,"donor_log2fc_shrunk":-0.117998},{"cell_type":"Oli","gene_symbol":"USP49","gene_symbol_current":"USP49","gene_id":"ENSG00000164663","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.75412e-09,"nucleus_log2fc":-0.115816,"nucleus_score":-6.17778,"pct_ad":0.233687,"pct_control":0.255058,"donor_test":"not significant","donor_padj":0.783318,"donor_log2fc":-0.10426,"donor_lfcse":0.0793357,"donor_log2fc_shrunk":-0.0170791}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000164663","module":"blue","kme":0.0437193,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000164663","module":"blue","kme":0.103902,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164663","entrez_id":["25862"],"uniprot":["Q70CQ1"],"ncbi_summary":"Enables cysteine-type endopeptidase activity; histone binding activity; and thiol-dependent deubiquitinase. Involved in histone H2B conserved C-terminal lysine deubiquitination and mRNA splicing, via spliceosome. Predicted to be located in nucleoplasm. Predicted to be active in cytoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q70CQ1","text":"Deubiquitinase that plays a role in several cellular processes including transcriptional regulation, cell cycle progression or innate immunity. Specifically deubiquitinates histone H2B at 'Lys-120' (H2BK120Ub), a specific tag for epigenetic transcriptional activation and acts as a regulator of mRNA splicing (PubMed:23824326). Antagonizes DNA double-strand break-induced ubiquitination of H2AX thereby participating in the maintenance of genome integrity (PubMed:35598681). Plays a role in the negative regulation of cell proliferation through the AKT pathway by deubiquitinating FKBP51, leading to enhanced AKT1 dephosphorylation by PHLPP1 (PubMed:28363942). Also regulates the mitotic spindle checkpoint and prevents aneuploidy (PubMed:36702832). Negatively regulates cellular antiviral responses via deconjugating 'Lys-63'-linked ubiquitination of STING1 (PubMed:30943264). Significantly enhances the anti-HIV-1 activity of APOBEC3G. Mechanistically, stabilizes APOBEC3G by counteracting HIV-1 Vif-mediated APOBEC3G ubiquitination (PubMed:31397674)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}