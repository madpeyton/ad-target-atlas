ull,"pct_control":null,"donor_test":"not significant","donor_padj":0.499295,"donor_log2fc":-0.132487,"donor_lfcse":0.102023,"donor_log2fc_shrunk":-0.0158141},{"cell_type":"Inhibitory","gene_symbol":"SLC25A15","gene_symbol_current":"SLC25A15","gene_id":"ENSG00000102743","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.393123,"donor_log2fc":-0.142276,"donor_lfcse":0.0829175,"donor_log2fc_shrunk":-0.0170113},{"cell_type":"Oligodendroglia","gene_symbol":"SLC25A15","gene_symbol_current":"SLC25A15","gene_id":"ENSG00000102743","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.487104,"donor_log2fc":-0.0984506,"donor_lfcse":0.0851814,"donor_log2fc_shrunk":-0.021218}],"modules":[{"cell_type":"CUX2+","gene_id":"ENSG00000102743","module":"blue","kme":0.122153,"hub":false,"module_direction":"lower in AD","module_padj":0.642666,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000102743","module":"blue","kme":0.117806,"hub":false,"module_direction":"lower in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000102743","module":"brown","kme":0.147122,"hub":false,"module_direction":"lower in AD","module_padj":0.199655,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000102743","entrez_id":["10166"],"uniprot":["Q9Y619"],"ncbi_summary":"This gene is a member of the mitochondrial carrier family. The encoded protein transports ornithine across the inner mitochondrial membrane from the cytosol to the mitochondrial matrix. The protein is an essential component of the urea cycle, and functions in ammonium detoxification and biosynthesis of the amino acid arginine. Mutations in this gene result in hyperornithinemia-hyperammonemia-homocitrullinuria (HHH) syndrome. There is a pseudogene of this locus on the Y chromosome.[provided by RefSeq, May 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y619","text":"Mitochondrial ornithine-citrulline antiporter (Probable) (PubMed:12807890, PubMed:22262851). Catalyzes the exchange between cytosolic ornithine and mitochondrial citrulline plus an H(+), the proton compensates the positive charge of ornithine thus leading to an electroneutral transport. Plays a crucial role in the urea cycle, by connecting the cytosolic and the intramitochondrial reactions of the urea cycle (Probable) (PubMed:12807890, PubMed:22262851). Lysine and arginine are also transported by the antiport mechanism (Probable) (PubMed:12807890). In addition, catalyzes an electroneutral exchange of ornithine or lysine for H(+), a reaction driven by the pH gradient across the inner membrane (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}