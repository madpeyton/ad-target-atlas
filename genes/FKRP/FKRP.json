,"donor_test":"not significant","donor_padj":0.914057,"donor_log2fc":0.0892636,"donor_lfcse":0.130985,"donor_log2fc_shrunk":0.00529186,"degas_log2fc":-0.181701,"degas_padj":7.15877e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000181027","module":"blue","kme":0.0272129,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000181027","module":"blue","kme":0.0610576,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000181027","entrez_id":["79147"],"uniprot":["Q9H9S5"],"ncbi_summary":"This gene encodes a protein which is targeted to the medial Golgi apparatus and is necessary for posttranslational modification of dystroglycan. Mutations in this gene have been associated with congenital muscular dystrophy, cognitive disability, and cerebellar cysts. Several alternatively spliced transcript variants of this gene have been described, but the full-length nature of some of these variants has not been determined. [provided by RefSeq, Oct 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H9S5","text":"Catalyzes the transfer of a ribitol 5-phosphate from CDP-L-ribitol to the ribitol 5-phosphate previously attached by FKTN/fukutin to the phosphorylated O-mannosyl trisaccharide (N-acetylgalactosamine-beta-3-N-acetylglucosamine-beta-4-(phosphate-6-)mannose), a carbohydrate structure present in alpha-dystroglycan (DAG1) (PubMed:26923585, PubMed:27194101, PubMed:29477842, PubMed:31949166). This constitutes the second step in the formation of the ribose 5-phosphate tandem repeat which links the phosphorylated O-mannosyl trisaccharide to the ligand binding moiety composed of repeats of 3-xylosyl-alpha-1,3-glucuronic acid-beta-1 (PubMed:25279699, PubMed:26923585, PubMed:27194101, PubMed:29477842, PubMed:31949166)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}