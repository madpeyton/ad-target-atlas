":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.970861,"donor_log2fc":-0.0262657,"donor_lfcse":0.0966848,"donor_log2fc_shrunk":-0.00284645,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000139266","module":"turquoise","kme":0.0775997,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000139266","entrez_id":["92979"],"uniprot":["Q86YJ5"],"ncbi_summary":"MARCH9 is a member of the MARCH family of membrane-bound E3 ubiquitin ligases (EC 6.3.2.19). MARCH enzymes add ubiquitin (see MIM 191339) to target lysines in substrate proteins, thereby signaling their vesicular transport between membrane compartments. MARCH9 induces internalization of several membrane glycoproteins and directs them to the endosomal compartment (Bartee et al., 2004 [PubMed 14722266]; Hoer et al., 2007 [PubMed 17174307]).[supplied by OMIM, Apr 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86YJ5","text":"E3 ubiquitin-protein ligase that may mediate ubiquitination of MHC-I, CD4 and ICAM1, and promote their subsequent endocytosis and sorting to lysosomes via multivesicular bodies. E3 ubiquitin ligases accept ubiquitin from an E2 ubiquitin-conjugating enzyme in the form of a thioester and then directly transfer the ubiquitin to targeted substrates."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}