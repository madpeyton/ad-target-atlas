ested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00193344,"nucleus_log2fc":0.144546,"nucleus_score":3.3911,"pct_ad":0.287187,"pct_control":0.266935,"donor_test":"not significant","donor_padj":0.729097,"donor_log2fc":0.107513,"donor_lfcse":0.0955937,"donor_log2fc_shrunk":0.0224619},{"cell_type":"OPC","gene_symbol":"HBS1L","gene_symbol_current":"HBS1L","gene_id":"ENSG00000112339","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.917233,"nucleus_log2fc":-0.0196308,"nucleus_score":-0.169288,"pct_ad":0.395318,"pct_control":0.39475,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0224847,"donor_lfcse":0.0817521,"donor_log2fc_shrunk":-3.51176e-06},{"cell_type":"Oli","gene_symbol":"HBS1L","gene_symbol_current":"HBS1L","gene_id":"ENSG00000112339","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.72872e-32,"nucleus_log2fc":-0.16651,"nucleus_score":-12.03,"pct_ad":0.671625,"pct_control":0.716534,"donor_test":"not significant","donor_padj":0.69496,"donor_log2fc":-0.146669,"donor_lfcse":0.0901289,"donor_log2fc_shrunk":-0.0207923}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000112339","module":"blue","kme":0.110789,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000112339","module":"blue","kme":0.194349,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000112339","entrez_id":["10767"],"uniprot":["Q9Y450"],"ncbi_summary":"This gene encodes a member of the GTP-binding elongation factor family. It is expressed in multiple tissues with the highest expression in heart and skeletal muscle. The intergenic region of this gene and the MYB gene has been identified to be a quantitative trait locus (QTL) controlling fetal hemoglobin level, and this region influnces erythrocyte, platelet, and monocyte counts as well as erythrocyte volume and hemoglobin content. DNA polymorphisms at this region associate with fetal hemoglobin levels and pain crises in sickle cell disease. A single nucleotide polymorphism in exon 1 of this gene is significantly associated with severity in beta-thalassemia/Hemoglobin E. Multiple alternatively spliced transcript variants encoding different protein isoforms have been found for this gene. [provided by RefSeq, May 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y450","text":"GTPase component of the Pelota-HBS1L complex, a complex that recognizes stalled ribosomes and triggers the No-Go Decay (NGD) pathway (PubMed:21448132, PubMed:23667253, PubMed:27863242). The Pelota-HBS1L complex recognizes ribosomes stalled at the 3' end of an mRNA and engages stalled ribosomes by destabilizing mRNA in the mRNA channel (PubMed:27863242). Following mRNA extraction from stalled ribosomes by the SKI complex, the Pelota-HBS1L complex promotes recruitment of ABCE1, which drives the disassembly of stalled ribosomes, followed by degradation of damaged mRNAs as part of the NGD pathway (PubMed:21448132, PubMed:32006463)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}