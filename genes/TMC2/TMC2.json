symbol_current":"TMC2","gene_id":"ENSG00000149488","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.936836,"donor_log2fc":-0.0925494,"donor_lfcse":0.180146,"donor_log2fc_shrunk":-0.0030775}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000149488","module":"blue","kme":0.175438,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000149488","entrez_id":["117532"],"uniprot":["Q8TDI7"],"ncbi_summary":"This gene encodes a transmembrane protein that is necesssary for mechanotransduction in cochlear hair cells of the inner ear. Mutations in this gene may underlie hereditary disorders of balance and hearing. [provided by RefSeq, Aug 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TDI7","text":"Pore-forming subunit of the mechanotransducer (MET) non-selective cation channel complex located at the tips of stereocilia of cochlear hair cells and that mediates sensory transduction in the auditory system (PubMed:11850618). The MET complex is composed of two dimeric pore-forming ion-conducting transmembrane TMC (TMC1 or TMC2) subunits, and aided by several auxiliary proteins including LHFPL5, TMIE, CIB2/3 and TOMT, and the tip-link PCDH15. MET channel is activated by tension in the tip-link extending from the side wall of one stereocilium to the tip of the adjacent shorter stereocilium, where the channel is located (By similarity). TMC2 MET channel is highly permeable to calcium and likely transports monovalent cations. Also involved in vestibular hair cell transduction current of the mammalian inner ear (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"