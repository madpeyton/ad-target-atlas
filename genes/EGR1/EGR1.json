s_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.959602,"donor_log2fc":-0.0651759,"donor_lfcse":0.308673,"donor_log2fc_shrunk":-0.00029541,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"EGR1","gene_symbol_current":"EGR1","gene_id":"ENSG00000120738","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.911827,"donor_log2fc":-0.210139,"donor_lfcse":0.301857,"donor_log2fc_shrunk":-0.00259099,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000120738","module":"red","kme":0.19667,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000120738","entrez_id":["1958"],"uniprot":["P18146"],"ncbi_summary":"The protein encoded by this gene belongs to the EGR family of C2H2-type zinc-finger proteins. It is a nuclear protein and functions as a transcriptional regulator. The products of target genes it activates are required for differentitation and mitogenesis. Studies suggest this is a cancer suppressor gene. [provided by RefSeq, Dec 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P18146","text":"Transcriptional regulator (PubMed:20121949). Recognizes and binds to the DNA sequence 5'-GCG(T/G)GGGCG-3'(EGR-site) in the promoter region of target genes (By similarity). Binds double-stranded target DNA, irrespective of the cytosine methylation status (PubMed:25258363, PubMed:25999311). Regulates the transcription of numerous target genes, and thereby plays an important role in regulating the response to growth factors, DNA damage, and ischemia. Plays a role in the regulation of cell survival, proliferation and cell death. Activates expression of p53/TP53 and TGFB1, and thereby helps prevent tumor formation. Required for normal progress through mitosis and normal proliferation of hepatocytes after partial hepatectomy. Mediates responses to ischemia and hypoxia; regulates the expression of proteins such as IL1B and CXCL2 that are involved in inflammatory processes and development of tissue damage after ischemia. Regulates biosynthesis of luteinizing hormone (LHB) in the pituitary (By similarity). Regulates the amplitude of the expression rhythms of clock genes: BMAL1, PER2 and NR1D1 in the liver via the activation of PER1 (clock repressor) transcription. Regulates the rhythmic expression of core-clock gene BMAL1 in the suprachiasmatic nucleus (SCN) (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}