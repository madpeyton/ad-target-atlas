ct_ad":0.137053,"pct_control":0.12833,"donor_test":"not significant","donor_padj":0.653285,"donor_log2fc":0.0395906,"donor_lfcse":0.0430916,"donor_log2fc_shrunk":0.020143},{"cell_type":"Inhibitory","gene_symbol":"RNF25","gene_symbol_current":"RNF25","gene_id":"ENSG00000163481","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.939311,"donor_log2fc":-0.0111049,"donor_lfcse":0.047749,"donor_log2fc_shrunk":-0.00283276},{"cell_type":"Oligodendroglia","gene_symbol":"RNF25","gene_symbol_current":"RNF25","gene_id":"ENSG00000163481","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.450588,"donor_log2fc":0.073225,"donor_lfcse":0.0583216,"donor_log2fc_shrunk":0.029121}],"modules":[{"cell_type":"CUX2-","gene_id":"ENSG00000163481","module":"turquoise","kme":0.049295,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000163481"],"dataset_symbols":["RNF25"],"explorer":"explorer.html?dataset=mathys2019#gene/RNF25","cell_types":[{"cell_type":"Ex","gene_symbol":"RNF25","gene_symbol_current":"RNF25","gene_id":"ENSG00000163481","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0869188,"donor_lfcse":0.107936,"donor_log2fc_shrunk":-7.76013e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163481","entrez_id":["64320"],"uniprot":["Q96BH1"],"ncbi_summary":"The protein encoded by this gene contains a RING finger motif. The mouse counterpart of this protein has been shown to interact with Rela, the p65 subunit of NF-kappaB (NFKB), and modulate NFKB-mediated transcription activity. The mouse protein also binds ubiquitin-conjugating enzymes (E2s) and is a substrate for E2-dependent ubiquitination. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96BH1","text":"E3 ubiquitin-protein ligase that plays a key role in the RNF14-RNF25 translation quality control pathway, a pathway that takes place when a ribosome has stalled during translation, and which promotes ubiquitination and degradation of translation factors on stalled ribosomes (PubMed:36638793, PubMed:37651229, PubMed:37951216). Catalyzes ubiquitination of RPS27A in response to ribosome collisions, promoting activation of RNF14 (PubMed:36638793). RNF25 catalyzes ubiquitination of other ribosomal proteins on stalled ribosomes, such as RPL0, RPL1, RPL12, RPS13 and RPS17 (PubMed:36638793). Also involved in ubiquitination and degradation of stalled ETF1/eRF1 (PubMed:36638793, PubMed:37651229). Independently of its function in the response to stalled ribosomes, mediates ubiquitination and subsequent proteasomal degradation of NKD2 (By similarity). May also stimulate transcription mediated by NF-kappa-B via its interaction with RELA/p65 (PubMed:12748188)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}