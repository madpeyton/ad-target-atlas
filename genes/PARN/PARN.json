icant","donor_padj":0.967568,"donor_log2fc":-0.0120839,"donor_lfcse":0.0529354,"donor_log2fc_shrunk":-0.00227729},{"cell_type":"Ex","gene_symbol":"PARN","gene_symbol_current":"PARN","gene_id":"ENSG00000140694","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.48183e-99,"nucleus_log2fc":-0.103541,"nucleus_score":-21.2479,"pct_ad":0.777933,"pct_control":0.804285,"donor_test":"not significant","donor_padj":0.784369,"donor_log2fc":-0.0558616,"donor_lfcse":0.0670016,"donor_log2fc_shrunk":-0.0151454},{"cell_type":"In","gene_symbol":"PARN","gene_symbol_current":"PARN","gene_id":"ENSG00000140694","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.50621e-71,"nucleus_log2fc":-0.152227,"nucleus_score":-18.0158,"pct_ad":0.564697,"pct_control":0.60212,"donor_test":"not significant","donor_padj":0.801284,"donor_log2fc":-0.0534124,"donor_lfcse":0.0565236,"donor_log2fc_shrunk":-0.00441804},{"cell_type":"Mic","gene_symbol":"PARN","gene_symbol_current":"PARN","gene_id":"ENSG00000140694","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.443532,"nucleus_log2fc":-0.0318742,"nucleus_score":-0.940081,"pct_ad":0.401486,"pct_control":0.41106,"donor_test":"not significant","donor_padj":0.950646,"donor_log2fc":-0.0257956,"donor_lfcse":0.0803056,"donor_log2fc_shrunk":-0.00635828},{"cell_type":"OPC","gene_symbol":"PARN","gene_symbol_current":"PARN","gene_id":"ENSG00000140694","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0203794,"nucleus_log2fc":-0.131886,"nucleus_score":-2.79295,"pct_ad":0.379958,"pct_control":0.401185,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0891198,"donor_lfcse":0.0672185,"donor_log2fc_shrunk":-2.05795e-05},{"cell_type":"Oli","gene_symbol":"PARN","gene_symbol_current":"PARN","gene_id":"ENSG00000140694","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.11391e-19,"nucleus_log2fc":-0.160057,"nucleus_score":-9.16915,"pct_ad":0.416736,"pct_control":0.449758,"donor_test":"not significant","donor_padj":0.773871,"donor_log2fc":-0.095726,"donor_lfcse":0.0712494,"donor_log2fc_shrunk":-0.0193581}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000140694","module":"tan","kme":0.203859,"hub":false,"module_direction":"lower in AD","module_padj":0.0131545,"module_significant":true}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000140694","entrez_id":["5073"],"uniprot":["O95453"],"ncbi_summary":"The protein encoded by this gene is a 3'-exoribonuclease, with similarity to the RNase D family of 3'-exonucleases. It prefers poly(A) as the substrate, hence, efficiently degrades poly(A) tails of mRNAs. Exonucleolytic degradation of the poly(A) tail is often the first step in the decay of eukaryotic mRNAs. This protein is also involved in silencing of certain maternal mRNAs during oocyte maturation and early embryonic development, as well as in nonsense-mediated decay (NMD) of mRNAs that contain premature stop codons. Alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Aug 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95453","text":"3'-exoribonuclease that has a preference for poly(A) tails of mRNAs, thereby efficiently degrading poly(A) tails. Exonucleolytic degradation of the poly(A) tail is often the first step in the decay of eukaryotic mRNAs and is also used to silence certain maternal mRNAs translationally during oocyte maturation and early embryonic development. Interacts with both the 3'-end poly(A) tail and the 5'-end cap structure during degradation, the interaction with the cap structure being required for an efficient degradation of poly(A) tails. Involved in nonsense-mediated mRNA decay, a critical process of selective degradation of mRNAs that contain premature stop codons. Also involved in degradation of inherently unstable mRNAs that contain AU-rich elements (AREs) in their 3'-UTR, possibly via its interaction with KHSRP. Probably mediates the removal of poly(A) tails of AREs mRNAs, which constitutes the first step of destabilization (PubMed:10882133, PubMed:11359775, PubMed:12748283, PubMed:15175153, PubMed:9736620). Also able to recognize and trim poly(A) tails of microRNAs such as MIR21 and H/ACA box snoRNAs (small nucleolar RNAs) leading to microRNAs degradation or snoRNA increased stability (PubMed:22442037, PubMed:25049417)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}