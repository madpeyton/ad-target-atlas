8,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000168135","module":"greenyellow","kme":0.241586,"hub":false,"module_direction":"higher in AD","module_padj":0.726304,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000168135","module":"turquoise","kme":0.141303,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000168135","module":"turquoise","kme":0.251536,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000168135"],"dataset_symbols":["KCNJ4"],"explorer":"explorer.html?dataset=mathys2019#gene/KCNJ4","cell_types":[{"cell_type":"Ex","gene_symbol":"KCNJ4","gene_symbol_current":"KCNJ4","gene_id":"ENSG00000168135","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.372734,"nucleus_log2fc":0.0750837,"nucleus_score":1.0389,"pct_ad":0.285453,"pct_control":0.282102,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.19837,"donor_lfcse":0.132483,"donor_log2fc_shrunk":1.17049e-05},{"cell_type":"In","gene_symbol":"KCNJ4","gene_symbol_current":"KCNJ4","gene_id":"ENSG00000168135","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.986832,"nucleus_log2fc":-0.0741558,"nucleus_score":-0.0576648,"pct_ad":0.102928,"pct_control":0.102397,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000168135","module":"yellow","kme":0.26376,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000168135","module":"brown","kme":0.202379,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000168135","entrez_id":["3761"],"uniprot":["P48050"],"ncbi_summary":"Several different potassium channels are known to be involved with electrical signaling in the nervous system. One class is activated by depolarization whereas a second class is not. The latter are referred to as inwardly rectifying K+ channels, and they have a greater tendency to allow potassium to flow into the cell rather than out of it. This asymmetry in potassium ion conductance plays a key role in the excitability of muscle cells and neurons. The protein encoded by this gene is an integral membrane protein and member of the inward rectifier potassium channel family. The encoded protein has a small unitary conductance compared to other members of this protein family. Two transcript variants encoding the same protein have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P48050","text":"Inward rectifier potassium channels are characterized by a greater tendency to allow potassium to flow into the cell rather than out of it. Their voltage dependence is regulated by the concentration of extracellular potassium; as external potassium is raised, the voltage range of the channel opening shifts to more positive voltages. The inward rectification is mainly due to the blockage of outward current by internal magnesium. Can be blocked by extracellular barium and cesium."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}