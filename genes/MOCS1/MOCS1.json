ct_ad":0.116415,"pct_control":0.109624,"donor_test":"not significant","donor_padj":0.851866,"donor_log2fc":0.0160977,"donor_lfcse":0.0363666,"donor_log2fc_shrunk":0.00750952},{"cell_type":"Inhibitory","gene_symbol":"MOCS1","gene_symbol_current":"MOCS1","gene_id":"ENSG00000124615","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.951292,"donor_log2fc":0.00960348,"donor_lfcse":0.0494464,"donor_log2fc_shrunk":0.00233943},{"cell_type":"Oligodendroglia","gene_symbol":"MOCS1","gene_symbol_current":"MOCS1","gene_id":"ENSG00000124615","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.42386,"donor_log2fc":0.0645403,"donor_lfcse":0.0482201,"donor_log2fc_shrunk":0.03233}],"modules":[],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000124615"],"dataset_symbols":["MOCS1"],"explorer":"explorer.html?dataset=mathys2019#gene/MOCS1","cell_types":[{"cell_type":"Ex","gene_symbol":"MOCS1","gene_symbol_current":"MOCS1","gene_id":"ENSG00000124615","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.176232,"donor_lfcse":0.134261,"donor_log2fc_shrunk":-1.07609e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000124615","entrez_id":["4337"],"uniprot":["Q9NZB8"],"ncbi_summary":"Molybdenum cofactor biosynthesis is a conserved pathway leading to the biological activation of molybdenum. The protein encoded by this gene is involved in this pathway. This gene was originally thought to produce a bicistronic mRNA with the potential to produce two proteins (MOCS1A and MOCS1B) from adjacent open reading frames. However, only the first open reading frame (MOCS1A) has been found to encode a protein from the putative bicistronic mRNA, whereas additional splice variants are likely to produce a fusion between the two open reading frames. This gene is defective in patients with molybdenum cofactor deficiency, type A. A related pseudogene has been identified on chromosome 16. [provided by RefSeq, Nov 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NZB8","text":"Isoform MOCS1A and isoform MOCS1B probably form a complex that catalyzes the conversion of 5'-GTP to cyclic pyranopterin monophosphate (cPMP) (PubMed:11891227, PubMed:23627491, PubMed:29368224, PubMed:31996372). MOCS1A catalyzes the cyclization of GTP to (8S)-3',8-cyclo-7,8-dihydroguanosine 5'-triphosphate and MOCS1B catalyzes the subsequent conversion of (8S)-3',8-cyclo-7,8-dihydroguanosine 5'-triphosphate to cPMP (PubMed:11891227, PubMed:23627491, PubMed:29368224, PubMed:31996372). [Isoform 9]: Has very weak catalytic activity."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}