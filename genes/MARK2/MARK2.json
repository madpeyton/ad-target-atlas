ucleus_padj":0.87639,"nucleus_log2fc":0.00741112,"nucleus_score":0.167612,"pct_ad":0.583071,"pct_control":0.587702,"donor_test":"not significant","donor_padj":0.831043,"donor_log2fc":0.0690688,"donor_lfcse":0.086533,"donor_log2fc_shrunk":0.00425171},{"cell_type":"Mic","gene_symbol":"MARK2","gene_symbol_current":"MARK2","gene_id":"ENSG00000072518","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.533795,"nucleus_log2fc":0.0245506,"nucleus_score":0.775258,"pct_ad":0.503807,"pct_control":0.497811,"donor_test":"not significant","donor_padj":0.947814,"donor_log2fc":0.0241454,"donor_lfcse":0.0682842,"donor_log2fc_shrunk":0.00763889},{"cell_type":"OPC","gene_symbol":"MARK2","gene_symbol_current":"MARK2","gene_id":"ENSG00000072518","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.818575,"nucleus_log2fc":-0.0201962,"nucleus_score":-0.361469,"pct_ad":0.357441,"pct_control":0.358002,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.00497726,"donor_lfcse":0.0872396,"donor_log2fc_shrunk":9.0905e-08},{"cell_type":"Oli","gene_symbol":"MARK2","gene_symbol_current":"MARK2","gene_id":"ENSG00000072518","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0538549,"nucleus_log2fc":0.0460688,"nucleus_score":2.05721,"pct_ad":0.377712,"pct_control":0.372485,"donor_test":"not significant","donor_padj":0.923175,"donor_log2fc":0.0591634,"donor_lfcse":0.0934281,"donor_log2fc_shrunk":0.00684134}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000072518","module":"yellow","kme":0.178442,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000072518","module":"blue","kme":0.104807,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000072518","module":"blue","kme":0.19438,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000072518","module":"blue","kme":0.119221,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000072518","module":"blue","kme":0.161594,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000072518","entrez_id":["2011"],"uniprot":["Q7KZI7"],"ncbi_summary":"This gene encodes a member of the Par-1 family of serine/threonine protein kinases. The protein is an important regulator of cell polarity in epithelial and neuronal cells, and also controls the stability of microtubules through phosphorylation and inactivation of several microtubule-associating proteins. The protein localizes to cell membranes. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q7KZI7","text":"Serine/threonine-protein kinase (PubMed:23666762). Involved in cell polarity and microtubule dynamics regulation. Phosphorylates CRTC2/TORC2, DCX, HDAC7, KIF13B, MAP2, MAP4 and RAB11FIP2. Phosphorylates the microtubule-associated protein MAPT/TAU (PubMed:23666762). Plays a key role in cell polarity by phosphorylating the microtubule-associated proteins MAP2, MAP4 and MAPT/TAU at KXGS motifs, causing detachment from microtubules, and their disassembly. Regulates epithelial cell polarity by phosphorylating RAB11FIP2. Involved in the regulation of neuronal migration through its dual activities in regulating cellular polarity and microtubule dynamics, possibly by phosphorylating and regulating DCX. Regulates axogenesis by phosphorylating KIF13B, promoting interaction between KIF13B and 14-3-3 and inhibiting microtubule-dependent accumulation of KIF13B. Also required for neurite outgrowth and establishment of neuronal polarity. Regulates localization and activity of some histone deacetylases by mediating phosphorylation of HDAC7, promoting subsequent interaction between HDAC7 and 14-3-3 and export from the nucleus. Also acts as a positive regulator of the Wnt signaling pathway, probably by mediating phosphorylation of disheveled proteins (DVL1, DVL2 and/or DVL3). Modulates the developmental decision to build a columnar versus a hepatic epithelial cell apparently by promoting a switch from a direct to a transcytotic mode of apical protein delivery. Essential for the asymmetric development of membrane domains of polarized epithelial cells. Phosphorylates UBAC2 at 'Ser-223' during ER stress or starvation-induced autophagy, promoting UBAC2 dimerization and interaction with GABARAP to mediate ER-phagy (PubMed:39284914)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}