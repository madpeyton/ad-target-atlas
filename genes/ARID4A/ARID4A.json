219","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.960164,"nucleus_log2fc":-0.049855,"nucleus_score":-0.149287,"pct_ad":0.111931,"pct_control":0.113608,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"ARID4A","gene_symbol_current":"ARID4A","gene_id":"ENSG00000032219","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.797294,"nucleus_log2fc":-0.0502573,"nucleus_score":-0.570859,"pct_ad":0.274725,"pct_control":0.285057,"donor_test":"not significant","donor_padj":0.994057,"donor_log2fc":0.0282125,"donor_lfcse":0.120412,"donor_log2fc_shrunk":0.000400078},{"cell_type":"Oli","gene_symbol":"ARID4A","gene_symbol_current":"ARID4A","gene_id":"ENSG00000032219","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.183629,"nucleus_log2fc":0.0933297,"nucleus_score":1.60602,"pct_ad":0.112262,"pct_control":0.104341,"donor_test":"not significant","donor_padj":0.971399,"donor_log2fc":0.0157974,"donor_lfcse":0.0835848,"donor_log2fc_shrunk":0.00193875}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000032219","module":"turquoise","kme":0.253058,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000032219","module":"turquoise","kme":0.114223,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000032219","entrez_id":["5926"],"uniprot":["P29374"],"ncbi_summary":"The protein encoded by this gene is a ubiquitously expressed nuclear protein. It binds directly, with several other proteins, to retinoblastoma protein (pRB) which regulates cell proliferation. pRB represses transcription by recruiting the encoded protein. This protein, in turn, serves as a bridging molecule to recruit HDACs and, in addition, provides a second HDAC-independent repression function. The encoded protein possesses transcriptional repression activity. Multiple alternatively spliced transcripts have been observed for this gene, although not all transcript variants have been fully described. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P29374","text":"DNA-binding protein which modulates activity of several transcription factors including RB1 (retinoblastoma-associated protein) and AR (androgen receptor) (By similarity). May function as part of an mSin3A repressor complex (PubMed:14581478). Has no intrinsic transcriptional activity (By similarity). Plays a role in the regulation of epigenetic modifications at the PWS/AS imprinting center near the SNRPN promoter, where it might function as part of a complex with RB1 and ARID4B (By similarity). Involved in spermatogenesis, together with ARID4B, where it acts as a transcriptional coactivator for AR and enhances expression of genes required for sperm maturation. Regulates expression of the tight junction protein CLDN3 in the testis, which is important for integrity of the blood-testis barrier (By similarity). Plays a role in myeloid homeostasis where it regulates the histone methylation state of bone marrow cells and expression of various genes involved in hematopoiesis. May function as a leukemia suppressor (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}