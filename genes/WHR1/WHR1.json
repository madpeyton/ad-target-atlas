1","gene_id":"ENSG00000204344","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.934892,"donor_log2fc":0.0504678,"donor_lfcse":0.120801,"donor_log2fc_shrunk":0.00658645},{"cell_type":"OPC","gene_symbol":"STK19","gene_symbol_current":"WHR1","gene_id":"ENSG00000204344","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.618747,"nucleus_log2fc":-0.0943406,"nucleus_score":-0.727398,"pct_ad":0.0982702,"pct_control":0.101778,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.103811,"donor_lfcse":0.126031,"donor_log2fc_shrunk":-6.17245e-06},{"cell_type":"Oli","gene_symbol":"STK19","gene_symbol_current":"WHR1","gene_id":"ENSG00000204344","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.962238,"donor_log2fc":0.0293633,"donor_lfcse":0.0823312,"donor_log2fc_shrunk":0.00419249}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000204344","module":"turquoise","kme":0.0487696,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000204344","module":"turquoise","kme":0.0242679,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000204344","module":"turquoise","kme":0.0259408,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000204344","entrez_id":["8859"],"uniprot":["P49842"],"ncbi_summary":"This gene encodes a serine/threonine kinase which localizes predominantly to the nucleus. Its specific function is unknown; it is possible that phosphorylation of this protein is involved in transcriptional regulation. This gene localizes to the major histocompatibility complex (MHC) class III region on chromosome 6 and expresses two transcript variants. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49842","text":"DNA-binding protein which is required for efficient transcription-coupled nucleotide excision repair (TC-NER) (PubMed:38252411, PubMed:38890355, PubMed:39353615, PubMed:39547223, PubMed:39547228, PubMed:39547229). Acts as part of a TC-NER complex which assembles and interacts with RNA polymerase II (RNAPII) when it stalls at DNA lesions (PubMed:39547223, PubMed:39547228, PubMed:39547229). TC-NER complex subunit UVSSA binds to the GTF2H1/p62 subunit of the TFIIH transcription factor complex, tethering TFIIH to the TC-NER complex (PubMed:39547228). WHR1/STK19 then interacts with the XPD helicase subunit of TFIIH which guides TFIIH to DNA downstream of the stalled RNAPII, ensuring DNA repair (PubMed:39353615, PubMed:39547228, PubMed:39547229). Directly interacts with RNAPII and also binds to downstream DNA (PubMed:39547229). Promotes the timely removal of DNA damage-stalled RNAPII, allowing downstream NER factors to access DNA lesions (PubMed:39547228, PubMed:39547229). Required for monoubiquitination of UVSSA (PubMed:39353615). Regulates repositioning and stabilization of UVSSA within the TC-NER complex (PubMed:39547223). Stimulates ubiquitination of RNAPII complex member RBP1 (PubMed:39547223). Also binds to RNA and regulates the expression levels of many mRNAs (PubMed:38252411, PubMed:38890355)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}