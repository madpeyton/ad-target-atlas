84,"nucleus_log2fc":0.028781,"nucleus_score":0.585877,"pct_ad":0.535492,"pct_control":0.520697,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0508068,"donor_lfcse":0.0767813,"donor_log2fc_shrunk":5.19369e-05},{"cell_type":"Mic","gene_symbol":"GNB1","gene_symbol_current":"GNB1","gene_id":"ENSG00000078369","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.73321,"nucleus_log2fc":-0.170015,"nucleus_score":-0.777466,"pct_ad":0.196802,"pct_control":0.209738,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"GNB1","gene_symbol_current":"GNB1","gene_id":"ENSG00000078369","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.486317,"nucleus_log2fc":-0.15357,"nucleus_score":-1.31011,"pct_ad":0.231554,"pct_control":0.254406,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":-0.0971859,"donor_lfcse":0.128608,"donor_log2fc_shrunk":-0.00119875},{"cell_type":"Oli","gene_symbol":"GNB1","gene_symbol_current":"GNB1","gene_id":"ENSG00000078369","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.889196,"nucleus_log2fc":-0.0205812,"nucleus_score":0.207985,"pct_ad":0.155388,"pct_control":0.152107,"donor_test":"not significant","donor_padj":0.946545,"donor_log2fc":-0.0330982,"donor_lfcse":0.0750762,"donor_log2fc_shrunk":-0.00497279}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000078369","module":"cyan","kme":0.148482,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000078369","entrez_id":["2782"],"uniprot":["P62873"],"ncbi_summary":"Heterotrimeric guanine nucleotide-binding proteins (G proteins), which integrate signals between receptors and effector proteins, are composed of an alpha, a beta, and a gamma subunit. These subunits are encoded by families of related genes. This gene encodes a beta subunit. Beta subunits are important regulators of alpha subunits, as well as of certain signal transduction receptors and effectors. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Sep 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P62873","text":"Guanine nucleotide-binding proteins (G proteins) are involved as a modulator or transducer in various transmembrane signaling systems (PubMed:29925951, PubMed:33762731, PubMed:34239069, PubMed:35610220, PubMed:35714614, PubMed:35835867, PubMed:36087581, PubMed:36989299, PubMed:37327704, PubMed:37935376, PubMed:37935377, PubMed:37963465, PubMed:37991948, PubMed:38168118, PubMed:38552625, PubMed:39103320). The beta and gamma chains are required for the GTPase activity, for replacement of GDP by GTP, and for G protein-effector interaction (PubMed:29925951, PubMed:33762731, PubMed:34239069, PubMed:35610220, PubMed:35714614, PubMed:35835867, PubMed:36087581, PubMed:36989299, PubMed:37327704, PubMed:37935376, PubMed:37935377, PubMed:37963465, PubMed:38168118, PubMed:38552625, PubMed:39103320). Involved in bitter and sweet taste transduction as well as in umami (monosodium glutamate, monopotassium glutamate, and inosine monophosphate) taste transduction (PubMed:40339580, PubMed:38600377, PubMed:38776963)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}