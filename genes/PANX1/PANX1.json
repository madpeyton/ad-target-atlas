"pct_control":null,"donor_test":"not significant","donor_padj":0.990367,"donor_log2fc":0.00266696,"donor_lfcse":0.0551775,"donor_log2fc_shrunk":0.00174991},{"cell_type":"Microglia","gene_symbol":"PANX1","gene_symbol_current":"PANX1","gene_id":"ENSG00000110218","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.998196,"donor_log2fc":-0.0016849,"donor_lfcse":0.132593,"donor_log2fc_shrunk":-0.000167974},{"cell_type":"Oligodendroglia","gene_symbol":"PANX1","gene_symbol_current":"PANX1","gene_id":"ENSG00000110218","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.859544,"donor_log2fc":-0.0282294,"donor_lfcse":0.0816397,"donor_log2fc_shrunk":-0.00577819}],"modules":[],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000110218"],"dataset_symbols":["PANX1"],"explorer":"explorer.html?dataset=mathys2019#gene/PANX1","cell_types":[{"cell_type":"Ex","gene_symbol":"PANX1","gene_symbol_current":"PANX1","gene_id":"ENSG00000110218","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999956,"donor_log2fc":0.000315933,"donor_lfcse":0.156502,"donor_log2fc_shrunk":1.75617e-08}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000110218","entrez_id":["24145"],"uniprot":["Q96RD7"],"ncbi_summary":"The protein encoded by this gene belongs to the innexin family. Innexin family members are the structural components of gap junctions. This protein and pannexin 2 are abundantly expressed in central nerve system (CNS) and are coexpressed in various neuronal populations. Studies in Xenopus oocytes suggest that this protein alone and in combination with pannexin 2 may form cell type-specific gap junctions with distinct properties. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96RD7","text":"Ion channel involved in a variety of physiological functions such as blood pressure regulation, apoptotic cell clearance and oogenesis (PubMed:15304325, PubMed:16908669, PubMed:20829356, PubMed:20944749, PubMed:30918116). Forms anion-selective channels with relatively low conductance and an order of permeabilities: nitrate>iodide>chlroride>>aspartate=glutamate=gluconate (By similarity). Can release ATP upon activation through phosphorylation or cleavage at C-terminus (PubMed:32238926). May play a role as a Ca(2+)-leak channel to regulate ER Ca(2+) homeostasis (PubMed:16908669). [Caspase-activated pannexin-1]: During apoptosis, the C terminal tail is cleaved by caspases, which opens the main pore acting as a large-pore ATP efflux channel with a broad distribution, which allows the regulated release of molecules and ions smaller than 1 kDa, such as nucleotides ATP and UTP, and selective plasma membrane permeability to attract phagocytes that engulf the dying cells."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}