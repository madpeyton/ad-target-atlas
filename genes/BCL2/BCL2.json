:0.116985,"donor_log2fc_shrunk":0.0163122},{"cell_type":"OPC","gene_symbol":"BCL2","gene_symbol_current":"BCL2","gene_id":"ENSG00000171791","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.877614,"nucleus_log2fc":0.00183734,"nucleus_score":0.250189,"pct_ad":0.438115,"pct_control":0.432007,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0220604,"donor_lfcse":0.123581,"donor_log2fc_shrunk":1.49728e-06},{"cell_type":"Oli","gene_symbol":"BCL2","gene_symbol_current":"BCL2","gene_id":"ENSG00000171791","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.70005e-270,"nucleus_log2fc":0.634921,"nucleus_score":35.2373,"pct_ad":0.579942,"pct_control":0.472603,"donor_test":"not significant","donor_padj":0.689277,"donor_log2fc":0.320589,"donor_lfcse":0.193647,"donor_log2fc_shrunk":0.0094473}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000171791","module":"blue","kme":0.0638585,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000171791","module":"yellow","kme":0.344068,"hub":false,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000171791","module":"blue","kme":0.193322,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000171791","entrez_id":["596"],"uniprot":["P10415"],"ncbi_summary":"This gene encodes an integral outer mitochondrial membrane protein that blocks the apoptotic death of some cells such as lymphocytes. Constitutive expression of BCL2, such as in the case of translocation of BCL2 to Ig heavy chain locus, is thought to be the cause of follicular lymphoma. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Feb 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P10415","text":"Suppresses apoptosis in a variety of cell systems including factor-dependent lymphohematopoietic and neural cells (PubMed:1508712, PubMed:8183370). Regulates cell death by controlling the mitochondrial membrane permeability (PubMed:11368354). Appears to function in a feedback loop system with caspases (PubMed:11368354). Inhibits caspase activity either by preventing the release of cytochrome c from the mitochondria and/or by binding to the apoptosis-activating factor (APAF-1) (PubMed:11368354). Also acts as an inhibitor of autophagy: interacts with BECN1 and AMBRA1 during non-starvation conditions and inhibits their autophagy function (PubMed:18570871, PubMed:20889974, PubMed:21358617). May attenuate inflammation by impairing NLRP1-inflammasome activation, hence CASP1 activation and IL1B release (PubMed:17418785)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}