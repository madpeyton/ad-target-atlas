t","donor_padj":0.940189,"donor_log2fc":0.0402565,"donor_lfcse":0.157075,"donor_log2fc_shrunk":0.00147992,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"TNFRSF1B","gene_symbol_current":"TNFRSF1B","gene_id":"ENSG00000028137","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.87639,"donor_log2fc":0.107719,"donor_lfcse":0.186207,"donor_log2fc_shrunk":0.00153916,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Mic","gene_symbol":"TNFRSF1B","gene_symbol_current":"TNFRSF1B","gene_id":"ENSG00000028137","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.523474,"nucleus_log2fc":-0.021721,"nucleus_score":-0.791643,"pct_ad":0.633055,"pct_control":0.626959,"donor_test":"not significant","donor_padj":0.937176,"donor_log2fc":0.0605153,"donor_lfcse":0.148454,"donor_log2fc_shrunk":0.00584896,"degas_log2fc":0.23569,"degas_padj":3.1496e-16}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000028137","module":"blue","kme":0.126903,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000028137","entrez_id":["7133"],"uniprot":["P20333"],"ncbi_summary":"The protein encoded by this gene is a member of the TNF-receptor superfamily. This protein and TNF-receptor 1 form a heterocomplex that mediates the recruitment of two anti-apoptotic proteins, c-IAP1 and c-IAP2, which possess E3 ubiquitin ligase activity. The function of IAPs in TNF-receptor signalling is unknown, however, c-IAP1 is thought to potentiate TNF-induced apoptosis by the ubiquitination and degradation of TNF-receptor-associated factor 2, which mediates anti-apoptotic signals. Knockout studies in mice also suggest a role of this protein in protecting neurons from apoptosis by stimulating antioxidative pathways. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P20333","text":"Receptor with high affinity for TNFSF2/TNF and approximately 5-fold lower affinity for homotrimeric TNFSF1/lymphotoxin-alpha. The TRAF1/TRAF2 complex recruits the apoptotic suppressors BIRC2 and BIRC3 to TNFRSF1B/TNFR2. This receptor mediates most of the metabolic effects of TNF. Isoform 2 blocks TNF-induced apoptosis, which suggests that it regulates TNF function by antagonizing its biological activity."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}