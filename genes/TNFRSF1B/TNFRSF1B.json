r.niche","gene_id":"ENSG00000028137","module":"blue","kme":0.246245,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000028137"],"dataset_symbols":["TNFRSF1B"],"explorer":"explorer.html?dataset=mathys2019#gene/TNFRSF1B","cell_types":[{"cell_type":"Mic","gene_symbol":"TNFRSF1B","gene_symbol_current":"TNFRSF1B","gene_id":"ENSG00000028137","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00141752,"nucleus_log2fc":-0.887889,"nucleus_score":-4.13869,"pct_ad":0.126691,"pct_control":0.200999,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000028137","entrez_id":["7133"],"uniprot":["P20333"],"ncbi_summary":"The protein encoded by this gene is a member of the TNF-receptor superfamily. This protein and TNF-receptor 1 form a heterocomplex that mediates the recruitment of two anti-apoptotic proteins, c-IAP1 and c-IAP2, which possess E3 ubiquitin ligase activity. The function of IAPs in TNF-receptor signalling is unknown, however, c-IAP1 is thought to potentiate TNF-induced apoptosis by the ubiquitination and degradation of TNF-receptor-associated factor 2, which mediates anti-apoptotic signals. Knockout studies in mice also suggest a role of this protein in protecting neurons from apoptosis by stimulating antioxidative pathways. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P20333","text":"Receptor with high affinity for TNFSF2/TNF and approximately 5-fold lower affinity for homotrimeric TNFSF1/lymphotoxin-alpha. The TRAF1/TRAF2 complex recruits the apoptotic suppressors BIRC2 and BIRC3 to TNFRSF1B/TNFR2. This receptor mediates most of the metabolic effects of TNF. Isoform 2 blocks TNF-induced apoptosis, which suggests that it regulates TNF function by antagonizing its biological activity."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}