0000188372","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.14231e-06,"nucleus_log2fc":-0.332912,"nucleus_score":-4.97598,"pct_ad":0.0806871,"pct_control":0.101267,"donor_test":"not significant","donor_padj":0.498601,"donor_log2fc":-0.2899,"donor_lfcse":0.15814,"donor_log2fc_shrunk":-0.0268571,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"ZP3","gene_symbol_current":"ZP3","gene_id":"ENSG00000188372","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.150875,"donor_lfcse":0.37149,"donor_log2fc_shrunk":1.14399e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"ZP3","gene_symbol_current":"ZP3","gene_id":"ENSG00000188372","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.824887,"donor_log2fc":-0.348703,"donor_lfcse":0.310682,"donor_log2fc_shrunk":-0.00476171,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000188372","module":"turquoise","kme":0.0185303,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000188372","entrez_id":["7784"],"uniprot":["P21754"],"ncbi_summary":"The zona pellucida is an extracellular matrix that surrounds the oocyte and early embryo. It is composed primarily of three or four glycoproteins with various functions during fertilization and preimplantation development. The protein encoded by this gene is a structural component of the zona pellucida and functions in primary binding and induction of the sperm acrosome reaction. The nascent protein contains a N-terminal signal peptide sequence, a conserved ZP domain, a C-terminal consensus furin cleavage site, and a transmembrane domain. It is hypothesized that furin cleavage results in release of the mature protein from the plasma membrane for subsequent incorporation into the zona pellucida matrix. However, the requirement for furin cleavage in this process remains controversial based on mouse studies. A variation in the last exon of this gene has previously served as the basis for an additional ZP3 locus; however, sequence and literature review reveals that there is only one full-length ZP3 locus in the human genome. Another locus encoding a bipartite transcript designated POMZP3 contains a duplication of the last four exons of ZP3, including the above described variation, and maps closely to this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P21754","text":"Component of the zona pellucida, an extracellular matrix surrounding oocytes which mediates sperm binding, induction of the acrosome reaction and prevents post-fertilization polyspermy. The zona pellucida is composed of 3 to 4 glycoproteins, ZP1, ZP2, ZP3, and ZP4. ZP3 is essential for sperm binding and zona matrix formation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}