ymbol":"KCNAB2","gene_symbol_current":"KCNAB2","gene_id":"ENSG00000069424","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.60933e-05,"nucleus_log2fc":0.281233,"nucleus_score":4.62775,"pct_ad":0.173166,"pct_control":0.149078,"donor_test":"not significant","donor_padj":0.399234,"donor_log2fc":0.205257,"donor_lfcse":0.0952491,"donor_log2fc_shrunk":0.0656127},{"cell_type":"OPC","gene_symbol":"KCNAB2","gene_symbol_current":"KCNAB2","gene_id":"ENSG00000069424","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00853271,"nucleus_log2fc":-0.194268,"nucleus_score":-3.12272,"pct_ad":0.131822,"pct_control":0.150889,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.103519,"donor_lfcse":0.123807,"donor_log2fc_shrunk":-6.94737e-06},{"cell_type":"Oli","gene_symbol":"KCNAB2","gene_symbol_current":"KCNAB2","gene_id":"ENSG00000069424","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.15037e-05,"nucleus_log2fc":-0.139234,"nucleus_score":-4.54142,"pct_ad":0.0918282,"pct_control":0.102141,"donor_test":"not significant","donor_padj":0.970861,"donor_log2fc":-0.0324961,"donor_lfcse":0.119188,"donor_log2fc_shrunk":-0.00236693}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000069424","module":"blue","kme":0.0833213,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000069424","module":"blue","kme":0.272762,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000069424","module":"turquoise","kme":0.0919749,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000069424","entrez_id":["8514"],"uniprot":["Q13303"],"ncbi_summary":"Voltage-gated potassium (Kv) channels represent the most complex class of voltage-gated ion channels from both functional and structural standpoints. Their diverse functions include regulating neurotransmitter release, heart rate, insulin secretion, neuronal excitability, epithelial electrolyte transport, smooth muscle contraction, and cell volume. Four sequence-related potassium channel genes - shaker, shaw, shab, and shal - have been identified in Drosophila, and each has been shown to have human homolog(s). This gene encodes a member of the potassium channel, voltage-gated, shaker-related subfamily. This member is one of the beta subunits, which are auxiliary proteins associating with functional Kv-alpha subunits. This member alters functional properties of the KCNA4 gene product. Alternative splicing of this gene results in multiple transcript variants encoding distinct isoforms. [provided by RefSeq, Dec 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13303","text":"Regulatory subunit of the voltage-gated potassium (Kv) Shaker channels composed of pore-forming and potassium-conducting alpha subunits and of regulatory beta subunits (PubMed:11825900, PubMed:7649300). The beta-2/KCNAB2 cytoplasmic subunit promotes potassium channel closure via a mechanism that does not involve physical obstruction of the channel pore (PubMed:11825900, PubMed:7649300). Promotes the inactivation of Kv1.4/KCNA4 and Kv1.5/KCNA5 alpha subunit-containing channels (PubMed:11825900, PubMed:7649300). Displays nicotinamide adenine dinucleotide phosphate (NADPH)-dependent aldoketoreductase activity by catalyzing the NADPH-dependent reduction of a wide range of aldehyde and ketone substrates (By similarity). Substrate specificity includes methylglyoxal, 9,10-phenanthrenequinone, prostaglandin J2, 4-nitrobenzaldehyde, 4-nitroacetophenone and 4-oxo-trans-2-nonenal (in vitro, no physiological substrate identified yet) (By similarity). The binding of oxidized and reduced nucleotide alters Kv channel gating and may contribute to dynamic fine tuning of cell excitability (By similarity). Contributes to the regulation of nerve signaling, and prevents neuronal hyperexcitability (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}