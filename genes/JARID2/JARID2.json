nt","donor_padj":0.999889,"donor_log2fc":0.0787802,"donor_lfcse":0.0862651,"donor_log2fc_shrunk":1.22502e-05},{"cell_type":"Mic","gene_symbol":"JARID2","gene_symbol_current":"JARID2","gene_id":"ENSG00000008083","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.984159,"nucleus_log2fc":-0.0307675,"nucleus_score":-0.0553082,"pct_ad":0.134071,"pct_control":0.134831,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"JARID2","gene_symbol_current":"JARID2","gene_id":"ENSG00000008083","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.514782,"nucleus_log2fc":-0.159582,"nucleus_score":-1.24559,"pct_ad":0.215071,"pct_control":0.235249,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":-0.140653,"donor_lfcse":0.134388,"donor_log2fc_shrunk":-0.00161377},{"cell_type":"Oli","gene_symbol":"JARID2","gene_symbol_current":"JARID2","gene_id":"ENSG00000008083","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.131246,"nucleus_log2fc":0.108132,"nucleus_score":1.80103,"pct_ad":0.119469,"pct_control":0.110604,"donor_test":"not significant","donor_padj":0.960295,"donor_log2fc":0.0242786,"donor_lfcse":0.0944706,"donor_log2fc_shrunk":0.00244268}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000008083","module":"tan","kme":0.284741,"hub":true,"module_direction":"lower in AD","module_padj":0.333899,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000008083","module":"brown","kme":0.24401,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000008083","entrez_id":["3720"],"uniprot":["Q92833"],"ncbi_summary":"This gene encodes a Jumonji- and AT-rich interaction domain (ARID)-domain-containing protein. The encoded protein is a DNA-binding protein that functions as a transcriptional repressor. This protein interacts with the Polycomb repressive complex 2 (PRC2) which plays an essential role in regulating gene expression during embryonic development. This protein facilitates the recruitment of the PRC2 complex to target genes. Alternate splicing results in multiple transcript variants. Mutations in this gene are associated with chronic myeloid malignancies. [provided by RefSeq, May 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92833","text":"Regulator of histone methyltransferase complexes that plays an essential role in embryonic development, including heart and liver development, neural tube fusion process and hematopoiesis (PubMed:20075857). Acts as an accessory subunit for the core PRC2 (Polycomb repressive complex 2) complex, which mediates histone H3K27 (H3K27me3) trimethylation on chromatin (PubMed:20075857, PubMed:29499137, PubMed:31959557). Binds DNA and mediates the recruitment of the PRC2 complex to target genes in embryonic stem cells, thereby playing a key role in stem cell differentiation and normal embryonic development (PubMed:20075857). In cardiac cells, it is required to repress expression of cyclin-D1 (CCND1) by activating methylation of 'Lys-9' of histone H3 (H3K9me) by the GLP1/EHMT1 and G9a/EHMT2 histone methyltransferases (By similarity). Also acts as a transcriptional repressor of ANF via its interaction with GATA4 and NKX2-5 (By similarity). Participates in the negative regulation of cell proliferation signaling (By similarity). Does not have histone demethylase activity (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}