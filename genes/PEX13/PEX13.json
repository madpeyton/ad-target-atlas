dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000162928"],"dataset_symbols":["PEX13"],"explorer":"explorer.html?dataset=mathys2019#gene/PEX13","cell_types":[{"cell_type":"Ex","gene_symbol":"PEX13","gene_symbol_current":"PEX13","gene_id":"ENSG00000162928","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.907861,"nucleus_log2fc":0.014412,"nucleus_score":-0.149635,"pct_ad":0.158066,"pct_control":0.159276,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.101526,"donor_lfcse":0.076725,"donor_log2fc_shrunk":1.22001e-05},{"cell_type":"In","gene_symbol":"PEX13","gene_symbol_current":"PEX13","gene_id":"ENSG00000162928","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.129877,"donor_lfcse":0.16071,"donor_log2fc_shrunk":5.5834e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000162928","entrez_id":["5194"],"uniprot":["Q92968"],"ncbi_summary":"This gene encodes a peroxisomal membrane protein that binds the type 1 peroxisomal targeting signal receptor via a SH3 domain located in the cytoplasm. Mutations and deficiencies in peroxisomal protein importing and peroxisome assembly lead to peroxisomal biogenesis disorders, an example of which is Zellweger syndrome. [provided by RefSeq, Oct 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92968","text":"Component of the PEX13-PEX14 docking complex, a translocon channel that specifically mediates the import of peroxisomal cargo proteins bound to PEX5 receptor (PubMed:28765278, PubMed:8858165, PubMed:9653144). The PEX13-PEX14 docking complex forms a large import pore which can be opened to a diameter of about 9 nm (By similarity). Mechanistically, PEX5 receptor along with cargo proteins associates with the PEX14 subunit of the PEX13-PEX14 docking complex in the cytosol, leading to the insertion of the receptor into the organelle membrane with the concomitant translocation of the cargo into the peroxisome matrix (PubMed:28765278, PubMed:8858165, PubMed:9653144). Involved in the import of PTS1- and PTS2-type containing proteins (PubMed:8858165, PubMed:9653144)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}