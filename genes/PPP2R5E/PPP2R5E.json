ontrol":0.474626,"donor_test":"not significant","donor_padj":0.940074,"donor_log2fc":-0.0384426,"donor_lfcse":0.0787556,"donor_log2fc_shrunk":-0.0035153}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000154001","module":"blue","kme":0.142116,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000154001","module":"blue","kme":0.205036,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000154001","module":"blue","kme":0.157351,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000154001","entrez_id":["5529"],"uniprot":["Q16537"],"ncbi_summary":"The protein encoded by this gene belongs to the phosphatase 2A regulatory subunit B family. Protein phosphatase 2A is one of the four major Ser/Thr phosphatases, and it is implicated in the negative control of cell growth and division. It consists of a common heteromeric core enzyme, which is composed of a catalytic subunit and a constant regulatory subunit, that associates with a variety of regulatory subunits. The B regulatory subunit might modulate substrate selectivity and catalytic activity. This gene encodes an epsilon isoform of the regulatory subunit B56 subfamily. Multiple transcript variants encoding several different isoforms have been found for this gene. [provided by RefSeq, Aug 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q16537","text":"The B regulatory subunit might modulate substrate selectivity and catalytic activity, and might also direct the localization of the catalytic enzyme to a particular subcellular compartment."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}