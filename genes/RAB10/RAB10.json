0.238452,"donor_test":"not significant","donor_padj":0.994287,"donor_log2fc":-0.003531,"donor_lfcse":0.170729,"donor_log2fc_shrunk":-0.000173625},{"cell_type":"OPC","gene_symbol":"RAB10","gene_symbol_current":"RAB10","gene_id":"ENSG00000084733","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.762005,"nucleus_log2fc":-0.0640314,"nucleus_score":-0.656997,"pct_ad":0.343014,"pct_control":0.363985,"donor_test":"not significant","donor_padj":0.998161,"donor_log2fc":0.0118221,"donor_lfcse":0.12505,"donor_log2fc_shrunk":0.000154627},{"cell_type":"Oli","gene_symbol":"RAB10","gene_symbol_current":"RAB10","gene_id":"ENSG00000084733","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0465386,"nucleus_log2fc":0.108421,"nucleus_score":2.30818,"pct_ad":0.164396,"pct_control":0.149878,"donor_test":"not significant","donor_padj":0.914929,"donor_log2fc":0.0507652,"donor_lfcse":0.0778294,"donor_log2fc_shrunk":0.00726825}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000084733","module":"greenyellow","kme":0.119377,"hub":false,"module_direction":"higher in AD","module_padj":0.56571,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000084733","module":"brown","kme":0.202901,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000084733","entrez_id":["10890"],"uniprot":["P61026"],"ncbi_summary":"RAB10 belongs to the RAS (see HRAS; MIM 190020) superfamily of small GTPases. RAB proteins localize to exocytic and endocytic compartments and regulate intracellular vesicle trafficking (Bao et al., 1998 [PubMed 9918381]).[supplied by OMIM, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P61026","text":"The small GTPases Rab are key regulators of intracellular membrane trafficking, from the formation of transport vesicles to their fusion with membranes (PubMed:21248164). Rabs cycle between an inactive GDP-bound form and an active GTP-bound form that is able to recruit to membranes different set of downstream effectors directly responsible for vesicle formation, movement, tethering and fusion (PubMed:21248164). RAB10 is mainly involved in the biosynthetic transport of proteins from the Golgi to the plasma membrane (PubMed:21248164). Regulates, for instance, SLC2A4/GLUT4 glucose transporter-enriched vesicles delivery to the plasma membrane (By similarity). In parallel, RAB10 regulates the transport of TLR4, a toll-like receptor to the plasma membrane and therefore may be important for innate immune response (By similarity). Also plays a specific role in asymmetric protein transport to the plasma membrane (PubMed:16641372). In neurons, involved in axonogenesis through regulation of vesicular membrane trafficking toward the axonal plasma membrane (By similarity). In epithelial cells, regulates transport from the Golgi to the basolateral membrane (PubMed:16641372). May play a role in the basolateral recycling pathway and in phagosome maturation (By similarity). May play a role in endoplasmic reticulum dynamics and morphology controlling tubulation along microtubules and tubules fusion (PubMed:23263280). Together with LRRK2, RAB8A, and RILPL1, regulates ciliogenesis (PubMed:30398148). When phosphorylated by LRRK2 on Thr-73, binds RILPL1 and inhibits ciliogenesis (PubMed:30398148). Participates in the export of a subset of neosynthesized proteins through a Rab8-Rab10-Rab11-dependent endososomal export route (PubMed:32344433). Targeted to and stabilized on stressed lysosomes through LRRK2 phosphorylation where it promotes the extracellular release of lysosomal content through EHBP1 and EHNP1L1 effector proteins (PubMed:30209220). (Microbial infection) Upon Legionella pneumophila infection promotes endoplasmic reticulum recruitment and bacterial replication. Plays a role in remodeling the Legionella-containing vacuole (LCV) into an endoplasmic reticulum-like vacuole."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}