_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.28385,"donor_log2fc":0.136883,"donor_lfcse":0.0674907,"donor_log2fc_shrunk":0.0272923},{"cell_type":"Microglia","gene_symbol":"CTSS","gene_symbol_current":"CTSS","gene_id":"ENSG00000163131","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.40662e-06,"nucleus_log2fc":0.125589,"nucleus_score":4.74224,"pct_ad":0.362789,"pct_control":0.326256,"donor_test":"not significant","donor_padj":0.646587,"donor_log2fc":0.0593712,"donor_lfcse":0.0525819,"donor_log2fc_shrunk":0.0200853}],"modules":[],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000163131"],"dataset_symbols":["CTSS"],"explorer":"explorer.html?dataset=mathys2019#gene/CTSS","cell_types":[{"cell_type":"Ex","gene_symbol":"CTSS","gene_symbol_current":"CTSS","gene_id":"ENSG00000163131","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.998657,"donor_log2fc":-0.00732922,"donor_lfcse":0.151435,"donor_log2fc_shrunk":-3.10614e-07},{"cell_type":"Mic","gene_symbol":"CTSS","gene_symbol_current":"CTSS","gene_id":"ENSG00000163131","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.549247,"nucleus_log2fc":0.252409,"nucleus_score":1.1695,"pct_ad":0.148831,"pct_control":0.128589,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163131","entrez_id":["1520"],"uniprot":["P25774"],"ncbi_summary":"The preproprotein encoded by this gene, a member of the peptidase C1 family, is a lysosomal cysteine proteinase that participates in the degradation of antigenic proteins to peptides for presentation on MHC class II molecules. The mature protein cleaves the invariant chain of MHC class II molecules in endolysosomal compartments and enables the formation of antigen-MHC class II complexes and the proper display of extracellular antigenic peptides by MHC-II. The mature protein also functions as an elastase over a broad pH range. When secreted from cells, this protein can remodel components of the extracellular matrix such as elastin, collagen, and fibronectin. This gene is implicated in the pathology of many inflammatory and autoimmune diseases and, given its elastase activity, plays a significant role in some pulmonary diseases. Alternatively spliced transcript variants encoding distinct isoforms have been found for this gene. [provided by RefSeq, May 2020].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P25774","text":"Thiol protease (PubMed:30612035). Key protease responsible for the removal of the invariant chain from MHC class II molecules and MHC class II antigen presentation (PubMed:30612035). The bond-specificity of this proteinase is in part similar to the specificities of cathepsin L (PubMed:30612035). Elicits itch by mediating cleavage and activation of MRGPRX1 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}