:false,"nucleus_direction":"higher in AD","nucleus_padj":0.0676201,"nucleus_log2fc":0.0838698,"nucleus_score":2.27276,"pct_ad":0.444826,"pct_control":0.420322,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0979363,"donor_lfcse":0.0674599,"donor_log2fc_shrunk":2.25072e-05,"degas_log2fc":-0.132262,"degas_padj":0.00162469},{"cell_type":"Oli","gene_symbol":"CBX5","gene_symbol_current":"CBX5","gene_id":"ENSG00000094916","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.26163e-16,"nucleus_log2fc":0.183608,"nucleus_score":8.22795,"pct_ad":0.298131,"pct_control":0.271018,"donor_test":"not significant","donor_padj":0.813403,"donor_log2fc":0.117393,"donor_lfcse":0.100246,"donor_log2fc_shrunk":0.01295,"degas_log2fc":0.0277217,"degas_padj":0.21951}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000094916","module":"red","kme":0.302848,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000094916","module":"turquoise","kme":0.0189664,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000094916","entrez_id":["23468"],"uniprot":["P45973"],"ncbi_summary":"This gene encodes a highly conserved nonhistone protein, which is a member of the heterochromatin protein family. The protein is enriched in the heterochromatin and associated with centromeres. The protein has a single N-terminal chromodomain which can bind to histone proteins via methylated lysine residues, and a C-terminal chromo shadow-domain (CSD) which is responsible for the homodimerization and interaction with a number of chromatin-associated nonhistone proteins. The encoded product is involved in the formation of functional kinetochore through interaction with essential kinetochore proteins. The gene has a pseudogene located on chromosome 3. Multiple alternatively spliced variants, encoding the same protein, have been identified. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P45973","text":"Component of heterochromatin that recognizes and binds histone H3 tails methylated at 'Lys-9' (H3K9me), leading to epigenetic repression (PubMed:40440427). In contrast, it is excluded from chromatin when 'Tyr-41' of histone H3 is phosphorylated (H3Y41ph) (PubMed:19783980). Also recognizes and binds histone H1.4 methylated at 'Lys-26' (H1.4K26me) (PubMed:16127177). Excluded from chromatin when histone H1.4 is Simultaneously methylated at Lys-26 (H1.4K26me) and phosphorylated at Ser-27 (H1.4S27Ph) (PubMed:16127177). May contribute to the association of heterochromatin with the inner nuclear membrane by interactions with the lamin-B receptor (LBR) (PubMed:19783980). Involved in the formation of kinetochore through interaction with the MIS12 complex subunit NSL1 (PubMed:19783980, PubMed:20231385). Required for the formation of the inner centromere (PubMed:20231385)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}