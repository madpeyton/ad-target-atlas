:"ENSG00000174989","module":"red","kme":0.188081,"hub":false,"module_direction":"lower in AD","module_padj":0.685734,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000174989","module":"pink","kme":0.171202,"hub":false,"module_direction":"lower in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000174989","module":"turquoise","kme":0.177944,"hub":false,"module_direction":"lower in AD","module_padj":0.773167,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000174989"],"dataset_symbols":["FBXW8"],"explorer":"explorer.html?dataset=mathys2019#gene/FBXW8","cell_types":[{"cell_type":"Ex","gene_symbol":"FBXW8","gene_symbol_current":"FBXW8","gene_id":"ENSG00000174989","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.127138,"nucleus_log2fc":-0.0535948,"nucleus_score":-1.71883,"pct_ad":0.183462,"pct_control":0.192535,"donor_test":"not significant","donor_padj":0.988831,"donor_log2fc":-0.0390219,"donor_lfcse":0.102502,"donor_log2fc_shrunk":-3.89972e-06},{"cell_type":"In","gene_symbol":"FBXW8","gene_symbol_current":"FBXW8","gene_id":"ENSG00000174989","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.895218,"nucleus_log2fc":0.0294241,"nucleus_score":0.403229,"pct_ad":0.12866,"pct_control":0.124494,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0456149,"donor_lfcse":0.135527,"donor_log2fc_shrunk":2.2126e-05},{"cell_type":"OPC","gene_symbol":"FBXW8","gene_symbol_current":"FBXW8","gene_id":"ENSG00000174989","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.18147,"nucleus_log2fc":-0.390926,"nucleus_score":-2.24513,"pct_ad":0.0902669,"pct_control":0.118008,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000174989","module":"blue","kme":0.105039,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000174989","module":"black","kme":0.148741,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000174989","entrez_id":["26259"],"uniprot":["Q8N3Y1"],"ncbi_summary":"This gene encodes a member of the F-box protein family, members of which are characterized by an approximately 40 amino acid motif, the F-box. The F-box proteins constitute one of the four subunits of ubiquitin protein ligase complex called SCFs (SKP1-cullin-F-box), which function in phosphorylation-dependent ubiquitination. The F-box proteins are divided into three classes: Fbws containing WD-40 domains, Fbls containing leucine-rich repeats, and Fbxs containing either different protein-protein interaction modules or no recognizable motifs. The protein encoded by this gene contains a WD-40 domain, in addition to an F-box motif, so it belongs to the Fbw class. Alternatively spliced transcript variants encoding distinct isoforms have been identified for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8N3Y1","text":"Substrate-recognition component of the Cul7-RING(FBXW8) ubiquitin ligase complex, which mediates the ubiquitination and subsequent proteasomal degradation of target proteins (PubMed:17205132, PubMed:18498745, PubMed:21572988, PubMed:24362026, PubMed:35982156). The Cul7-RING(FBXW8) complex mediates ubiquitination and consequent degradation of GORASP1, acting as a component of the ubiquitin ligase pathway that regulates Golgi morphogenesis and dendrite patterning in brain (PubMed:21572988). Mediates ubiquitination and degradation of IRS1 in a mTOR-dependent manner: the Cul7-RING(FBXW8) complex recognizes and binds IRS1 previously phosphorylated by S6 kinase (RPS6KB1 or RPS6KB2) (PubMed:18498745). The Cul7-RING(FBXW8) complex also mediates ubiquitination of MAP4K1/HPK1: recognizes and binds autophosphorylated MAP4K1/HPK1, leading to its degradation, thereby affecting cell proliferation and differentiation (PubMed:24362026). The Cul7-RING(FBXW8) complex also mediates ubiquitination of phosphorylated cyclin-D1 (CCND1) (PubMed:17205132). The Cul7-RING(FBXW8) complex is however not a major regulator of CCND1 stability during the G1/S transition (By similarity). Associated component of the 3M complex, suggesting that it mediates some of 3M complex functions (PubMed:24793695)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}