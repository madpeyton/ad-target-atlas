_log2fc":-0.131053,"donor_lfcse":0.147548,"donor_log2fc_shrunk":-6.35e-06},{"cell_type":"OPC","gene_symbol":"MGST3","gene_symbol_current":"MGST3","gene_id":"ENSG00000143198","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.180602,"nucleus_log2fc":-0.274373,"nucleus_score":-2.25176,"pct_ad":0.187598,"pct_control":0.226054,"donor_test":"not significant","donor_padj":0.99097,"donor_log2fc":-0.097277,"donor_lfcse":0.189878,"donor_log2fc_shrunk":-0.000561112},{"cell_type":"Oli","gene_symbol":"MGST3","gene_symbol_current":"MGST3","gene_id":"ENSG00000143198","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.989752,"donor_log2fc":0.0117427,"donor_lfcse":0.152858,"donor_log2fc_shrunk":0.000477646}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000143198","module":"brown","kme":0.174157,"hub":false,"module_direction":"lower in AD","module_padj":0.652213,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000143198","module":"turquoise","kme":0.434857,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000143198","module":"turquoise","kme":0.458818,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000143198","module":"turquoise","kme":0.209538,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000143198","module":"turquoise","kme":0.138972,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000143198","entrez_id":["4259"],"uniprot":["O14880"],"ncbi_summary":"This gene encodes a member of the MAPEG (Membrane Associated Proteins in Eicosanoid and Glutathione metabolism) protein family. Members of this family are involved in the production of leukotrienes and prostaglandin E, important mediators of inflammation. This gene encodes an enzyme which catalyzes the conjugation of leukotriene A4 and reduced glutathione to produce leukotriene C4. This enzyme also demonstrates glutathione-dependent peroxidase activity towards lipid hydroperoxides.[provided by RefSeq, May 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O14880","text":"Displays both glutathione S-transferase and glutathione peroxidase activities toward oxyeicosanoids, as part of cellular detoxification as well as synthesis of bioactive metabolites (PubMed:36370807, PubMed:9278457). Catalyzes conjugate addition of reduced glutathione to the alpha, beta-unsaturated C=C carbonyl group of eisosanoids such as leukotriene A4 and 15-deoxy-Delta12,14-prostaglandin J2 to form GSH adducts relevant to the inflammatory response (PubMed:36370807, PubMed:9278457). Catalyzes glutathione-dependent reduction of eicosanoid peroxides to yield the corresponding eicosanoid hydroxides (PubMed:9278457)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}