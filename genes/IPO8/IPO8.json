e,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000133704"],"dataset_symbols":["IPO8"],"explorer":"explorer.html?dataset=mathys2019#gene/IPO8","cell_types":[{"cell_type":"Ex","gene_symbol":"IPO8","gene_symbol_current":"IPO8","gene_id":"ENSG00000133704","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.107719,"nucleus_log2fc":-0.0469408,"nucleus_score":-1.80778,"pct_ad":0.210991,"pct_control":0.221407,"donor_test":"not significant","donor_padj":0.998789,"donor_log2fc":-0.00299602,"donor_lfcse":0.0685493,"donor_log2fc_shrunk":6.75702e-05},{"cell_type":"In","gene_symbol":"IPO8","gene_symbol_current":"IPO8","gene_id":"ENSG00000133704","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.836947,"nucleus_log2fc":0.0970054,"nucleus_score":0.58039,"pct_ad":0.124224,"pct_control":0.119203,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.051276,"donor_lfcse":0.138027,"donor_log2fc_shrunk":2.79157e-06},{"cell_type":"Oli","gene_symbol":"IPO8","gene_symbol_current":"IPO8","gene_id":"ENSG00000133704","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.869731,"donor_log2fc":0.119035,"donor_lfcse":0.136106,"donor_log2fc_shrunk":0.0061224}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000133704","entrez_id":["10526"],"uniprot":["O15397"],"ncbi_summary":"The importin-alpha/beta complex and the GTPase Ran mediate nuclear import of proteins with a classical nuclear localization signal. The protein encoded by this gene is a member of a class of approximately 20 potential Ran targets that share a sequence motif related to the Ran-binding site of importin-beta. This protein binds to the nuclear pore complex and, along with RanGTP and RANBP1, inhibits the GAP stimulation of the Ran GTPase. Alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O15397","text":"Involved in nuclear protein import, either by acting as autonomous nuclear transport receptor or as an adapter-like protein in association with the importin-beta subunit KPNB1. Acting autonomously, may serve as receptor for nuclear localization signals (NLS) and promote translocation of import substrates through the nuclear pore complex (NPC) by an energy requiring, Ran-dependent mechanism. At the nucleoplasmic side of the NPC, Ran binds to importin, the importin/substrate complex dissociates and importin is re-exported from the nucleus to the cytoplasm where GTP hydrolysis releases Ran. The directionality of nuclear import is thought to be conferred by an asymmetric distribution of the GTP- and GDP-bound forms of Ran between the cytoplasm and nucleus (PubMed:9214382). In vitro mediates the nuclear import of the signal recognition particle protein SRP19 (PubMed:11682607). May also be involved in cytoplasm-to-nucleus shuttling of a broad spectrum of other cargos, including Argonaute-microRNAs complexes, the JUN protein, RELA/NF-kappa-B p65 subunit, the translation initiation factor EIF4E and a set of receptor-activated mothers against decapentaplegic homolog (SMAD) transcription factors that play a critical role downstream of the large family of transforming growth factor beta and bone morphogenetic protein (BMP) cytokines (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}