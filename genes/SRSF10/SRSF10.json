:0.236782,"donor_test":"not significant","donor_padj":0.99097,"donor_log2fc":-0.077221,"donor_lfcse":0.154548,"donor_log2fc_shrunk":-0.000656181},{"cell_type":"Oli","gene_symbol":"SRSF10","gene_symbol_current":"SRSF10","gene_id":"ENSG00000188529","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0339333,"nucleus_log2fc":0.161236,"nucleus_score":2.4402,"pct_ad":0.104605,"pct_control":0.0936206,"donor_test":"not significant","donor_padj":0.912791,"donor_log2fc":0.0669732,"donor_lfcse":0.100885,"donor_log2fc_shrunk":0.00600762}],"modules":[{"cell_type":"In","gene_id":"ENSG00000188529","module":"turquoise","kme":0.201178,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000188529","module":"purple","kme":0.249997,"hub":true,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000188529","module":"turquoise","kme":0.127322,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000188529","entrez_id":["10772"],"uniprot":["O75494"],"ncbi_summary":"This gene product is a member of the serine-arginine (SR) family of proteins, which are involved in constitutive and regulated RNA splicing. Members of this family are characterized by N-terminal RNP1 and RNP2 motifs, which are required for binding to RNA, and multiple C-terminal SR/RS repeats, which are important in mediating association with other cellular proteins. This protein interacts with the oncoprotein TLS, and abrogates the influence of TLS on adenovirus E1A pre-mRNA splicing. This gene has pseudogenes on chromosomes 4, 9, 14, 18, and 20. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jul 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75494","text":"Splicing factor that in its dephosphorylated form acts as a general repressor of pre-mRNA splicing (PubMed:11684676, PubMed:12419250, PubMed:14765198). Seems to interfere with the U1 snRNP 5'-splice recognition of SNRNP70 (PubMed:14765198). Required for splicing repression in M-phase cells and after heat shock (PubMed:14765198). Also acts as a splicing factor that specifically promotes exon skipping during alternative splicing (PubMed:26876937). Interaction with YTHDC1, a RNA-binding protein that recognizes and binds N6-methyladenosine (m6A)-containing RNAs, prevents SRSF10 from binding to its mRNA-binding sites close to m6A-containing regions, leading to inhibit exon skipping during alternative splicing (PubMed:26876937). May be involved in regulation of alternative splicing in neurons, with isoform 1 acting as a positive and isoform 3 as a negative regulator (PubMed:12419250)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}