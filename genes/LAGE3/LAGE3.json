ucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.120227,"donor_lfcse":0.258513,"donor_log2fc_shrunk":1.88858e-06},{"cell_type":"Oli","gene_symbol":"LAGE3","gene_symbol_current":"LAGE3","gene_id":"ENSG00000196976","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.990772,"donor_log2fc":-0.0212107,"donor_lfcse":0.256559,"donor_log2fc_shrunk":-0.000437594}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000196976","module":"brown","kme":0.399755,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000196976","module":"brown","kme":0.271598,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000196976","module":"turquoise","kme":0.130998,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000196976","entrez_id":["8270"],"uniprot":["Q14657"],"ncbi_summary":"This gene belongs to the ESO/LAGE gene family, members of which are clustered together on chromosome Xq28, and have similar exon-intron structures. Unlike the other family members which are normally expressed only in testis and activated in a wide range of human tumors, this gene is ubiquitously expressed in somatic tissues. The latter, combined with the finding that it is highly conserved in mouse and rat, suggests that the encoded protein is functionally important. An intronless pseudogene with high sequence similarity to this gene is located on chromosome 9. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q14657","text":"Component of the EKC/KEOPS complex that is required for the formation of a threonylcarbamoyl group on adenosine at position 37 (t(6)A37) in tRNAs that read codons beginning with adenine (PubMed:22912744, PubMed:27903914). The complex is probably involved in the transfer of the threonylcarbamoyl moiety of threonylcarbamoyl-AMP (TC-AMP) to the N6 group of A37 (PubMed:22912744, PubMed:27903914). LAGE3 functions as a dimerization module for the complex (PubMed:22912744, PubMed:27903914)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}