ll_type":"In","gene_id":"ENSG00000115896","module":"green","kme":0.651473,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000115896","module":"green","kme":0.194729,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000115896","module":"yellow","kme":0.232064,"hub":false,"module_direction":"higher in AD","module_padj":0.663532,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000115896","module":"blue","kme":0.380704,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000115896","entrez_id":["5334"],"uniprot":["Q15111"],"ncbi_summary":"Predicted to enable phospholipase C activity. Predicted to be involved in negative regulation of cold-induced thermogenesis and phosphatidylinositol-mediated signaling. Predicted to act upstream of or within several processes, including gamma-aminobutyric acid signaling pathway; regulation of GABAergic synaptic transmission; and regulation of peptidyl-serine phosphorylation. Predicted to be located in cytoplasm and plasma membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15111","text":"Involved in an inositol phospholipid-based intracellular signaling cascade. Shows no PLC activity to phosphatidylinositol 4,5-bisphosphate and phosphatidylinositol. Component in the phospho-dependent endocytosis process of GABA A receptor (By similarity). Regulates the turnover of receptors and thus contributes to the maintenance of GABA-mediated synaptic inhibition. Its aberrant expression could contribute to the genesis and progression of lung carcinoma. Acts as an inhibitor of PPP1C."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}