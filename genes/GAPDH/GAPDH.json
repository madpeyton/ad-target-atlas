padj":4.79937e-13,"nucleus_log2fc":0.282649,"nucleus_score":7.72562,"pct_ad":0.64241,"pct_control":0.591871,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.236562,"donor_lfcse":0.204409,"donor_log2fc_shrunk":5.89423e-06,"degas_log2fc":0.784944,"degas_padj":4.82099e-108},{"cell_type":"Oli","gene_symbol":"GAPDH","gene_symbol_current":"GAPDH","gene_id":"ENSG00000111640","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.34369e-08,"nucleus_log2fc":-0.107502,"nucleus_score":-5.83817,"pct_ad":0.493977,"pct_control":0.512504,"donor_test":"not significant","donor_padj":0.984493,"donor_log2fc":-0.0285093,"donor_lfcse":0.224335,"donor_log2fc_shrunk":-0.000946109,"degas_log2fc":0.271356,"degas_padj":3.66903e-56}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000111640","module":"turquoise","kme":0.264916,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000111640","module":"brown","kme":0.731621,"hub":true,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000111640","module":"brown","kme":0.651031,"hub":true,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000111640","module":"red","kme":0.392457,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000111640","module":"turquoise","kme":0.439295,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000111640","module":"turquoise","kme":0.462221,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000111640","entrez_id":["2597"],"uniprot":["P04406"],"ncbi_summary":"This gene encodes a member of the glyceraldehyde-3-phosphate dehydrogenase protein family. The encoded protein has been identified as a moonlighting protein based on its ability to perform mechanistically distinct functions. The product of this gene catalyzes an important energy-yielding step in carbohydrate metabolism, the reversible oxidative phosphorylation of glyceraldehyde-3-phosphate in the presence of inorganic phosphate and nicotinamide adenine dinucleotide (NAD). The encoded protein has additionally been identified to have uracil DNA glycosylase activity in the nucleus. Also, this protein contains a peptide that has antimicrobial activity against E. coli, P. aeruginosa, and C. albicans. Studies of a similar protein in mouse have assigned a variety of additional functions including nitrosylation of nuclear proteins, the regulation of mRNA stability, and acting as a transferrin receptor on the cell surface of macrophage. Many pseudogenes similar to this locus are present in the human genome. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Nov 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P04406","text":"Catalyzes the conversion of D-glyceraldehyde 3-phosphate (G3P) into 3-phospho-D-glyceroyl phosphate in glycolysis and the reverse reaction in gluconeogenesis (PubMed:11724794, PubMed:3170585). Also shows nitrosylase activity, thereby playing a role in nuclear functions (PubMed:11724794, PubMed:3170585). Modulates the organization and assembly of the cytoskeleton (By similarity). Facilitates the CHP1-dependent microtubule and membrane associations through its ability to stimulate the binding of CHP1 to microtubules (By similarity). Component of the GAIT (gamma interferon-activated inhibitor of translation) complex which mediates interferon-gamma-induced transcript-selective translation inhibition in inflammation processes (PubMed:23071094). Upon interferon-gamma treatment assembles into the GAIT complex which binds to stem loop-containing GAIT elements in the 3'-UTR of diverse inflammatory mRNAs (such as ceruplasmin) and suppresses their translation (PubMed:23071094). Also plays a role in innate immunity by promoting TNF-induced NF-kappa-B activation and type I interferon production, via interaction with TRAF2 and TRAF3, respectively (PubMed:23332158, PubMed:27387501). Participates in nuclear events including transcription, RNA transport, DNA replication and apoptosis (By similarity). Nuclear functions are probably due to the nitrosylase activity that mediates cysteine S-nitrosylation of nuclear target proteins such as SIRT1, HDAC2 and PRKDC (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}