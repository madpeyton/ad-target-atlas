G00000132646","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.921035,"donor_log2fc":-0.103834,"donor_lfcse":0.21695,"donor_log2fc_shrunk":-0.00470621,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"PCNA","gene_symbol_current":"PCNA","gene_id":"ENSG00000132646","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0481644,"donor_lfcse":0.188292,"donor_log2fc_shrunk":1.41707e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"PCNA","gene_symbol_current":"PCNA","gene_id":"ENSG00000132646","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.823481,"donor_log2fc":0.169489,"donor_lfcse":0.150152,"donor_log2fc_shrunk":0.00831447,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000132646","entrez_id":["5111"],"uniprot":["P12004"],"ncbi_summary":"The protein encoded by this gene is found in the nucleus and is a cofactor of DNA polymerase delta. The encoded protein acts as a homotrimer and helps increase the processivity of leading strand synthesis during DNA replication. In response to DNA damage, this protein is ubiquitinated and is involved in the RAD6-dependent DNA repair pathway. Two transcript variants encoding the same protein have been found for this gene. Pseudogenes of this gene have been described on chromosome 4 and on the X chromosome. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P12004","text":"Confers DNA tethering and processivity to DNA polymerases and other proteins (PubMed:24695737, PubMed:24939902, PubMed:35585232). Auxiliary protein of DNA polymerase delta and epsilon, is involved in the control of DNA replication by increasing the polymerases' processivity during elongation of the leading strand (PubMed:35585232). Induces a robust stimulatory effect on the 3'-5' exonuclease and 3'-phosphodiesterase, but not apurinic-apyrimidinic (AP) endonuclease, APEX2 activities. Has to be loaded onto DNA in order to be able to stimulate APEX2. Plays a key role in DNA damage response (DDR) by being conveniently positioned at the replication fork to coordinate DNA replication with DNA repair and DNA damage tolerance pathways (PubMed:24939902). Acts as a loading platform to recruit DDR proteins that allow completion of DNA replication after DNA damage and promote postreplication repair: monoubiquitinated PCNA leads to recruitment of translesion (TLS) polymerases, while 'Lys-63'-linked polyubiquitination of PCNA is involved in error-free pathway and employs recombination mechanisms to synthesize across the lesion (PubMed:24695737)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}