shrunk":0.00367517},{"cell_type":"OPC","gene_symbol":"PAQR3","gene_symbol_current":"PAQR3","gene_id":"ENSG00000163291","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.76666,"nucleus_log2fc":-0.023199,"nucleus_score":-0.459735,"pct_ad":0.170444,"pct_control":0.173582,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0866279,"donor_lfcse":0.110492,"donor_log2fc_shrunk":-9.12338e-06},{"cell_type":"Oli","gene_symbol":"PAQR3","gene_symbol_current":"PAQR3","gene_id":"ENSG00000163291","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00938548,"nucleus_log2fc":0.114176,"nucleus_score":2.73446,"pct_ad":0.146538,"pct_control":0.139907,"donor_test":"not significant","donor_padj":0.848963,"donor_log2fc":0.120587,"donor_lfcse":0.117636,"donor_log2fc_shrunk":0.00942046}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000163291","module":"turquoise","kme":0.321586,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000163291","module":"brown","kme":0.443084,"hub":false,"module_direction":"higher in AD","module_padj":0.939268,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000163291","module":"turquoise","kme":0.0996013,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000163291","module":"turquoise","kme":0.0547344,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163291","entrez_id":["152559"],"uniprot":["Q6TCH7"],"ncbi_summary":"This gene encodes a seven-transmembrane protein localized in the Golgi apparatus in mammalian cells. The encoded protein belongs to the progestin and adipoQ receptor (PAQR) family. This protein functions as a tumor suppressor by inhibiting the Raf/MEK/ERK signaling cascade. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Apr 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6TCH7","text":"Golgi-scaffold protein which modulates its interactors activities by anchoring them to the Golgi apparatus (PubMed:18547165, PubMed:26311497). Functions as a spatial regulator of RAF1 kinase by sequestrating it to the Golgi apparatus (PubMed:18547165). Acts as a positive regulator of cholesterol biosynthesis by mediating the anchoring of the SCAP:SREBP complex in the Golgi apparatus, thereby promoting SCAP:SREBF2 complex formation, potentiating SREBF2 and SREBF1 processing and enhancing lipid synthesis (PubMed:26311497). Also regulates PPARA and PPARG functions by mediating their interaction with E3 ubiquitin ligases, such as STUB1 or HUWE1, leading to their polyubiquitination and proteasome-mediated degradation (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}