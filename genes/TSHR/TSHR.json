:false},{"cell_type":"Inhibitory","gene_id":"ENSG00000165409","module":"brown","kme":0.222608,"hub":false,"module_direction":"lower in AD","module_padj":0.199655,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000165409"],"dataset_symbols":["TSHR"],"explorer":"explorer.html?dataset=mathys2019#gene/TSHR","cell_types":[{"cell_type":"Ex","gene_symbol":"TSHR","gene_symbol_current":"TSHR","gene_id":"ENSG00000165409","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":0.113485,"donor_lfcse":0.227618,"donor_log2fc_shrunk":4.90141e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165409","entrez_id":["7253"],"uniprot":["P16473"],"ncbi_summary":"The protein encoded by this gene is a membrane protein and a major controller of thyroid cell metabolism. The encoded protein is a receptor for thyrothropin and thyrostimulin, and its activity is mediated by adenylate cyclase. Defects in this gene are a cause of several types of hyperthyroidism. Three transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Dec 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P16473","text":"Receptor for the thyroid-stimulating hormone (TSH) or thyrotropin (PubMed:11847099, PubMed:12045258). Also acts as a receptor for the heterodimeric glycoprotein hormone (GPHA2:GPHB5) or thyrostimulin (PubMed:12045258). TSHR is coupled to G(s) proteins and mediates the activation of adenylate cyclase (PubMed:11847099, PubMed:35940205, PubMed:35940204). This leads to the generation of cyclic adenosine monophosphate (cAMP), which in turn activates protein kinase A (PKA). PKA subsequently phosphorylates downstream targets involved in thyroid hormone biosynthesis and secretion, including thyroid peroxidase (TPO) and the sodium/iodide symporter (NIS) (PubMed:27638195). Additionally, plays a central role in controlling thyroid cell metabolism (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}