nucleus_log2fc":-0.428935,"nucleus_score":-11.0569,"pct_ad":0.0838268,"pct_control":0.108183,"donor_test":"not significant","donor_padj":0.90279,"donor_log2fc":-0.232498,"donor_lfcse":0.317126,"donor_log2fc_shrunk":-0.00235069,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000165409","module":"turquoise","kme":0.347943,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000165409","module":"turquoise","kme":0.389289,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000165409","module":"brown","kme":0.313127,"hub":false,"module_direction":"higher in AD","module_padj":0.939268,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000165409","module":"turquoise","kme":0.207549,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000165409","module":"turquoise","kme":0.200139,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165409","entrez_id":["7253"],"uniprot":["P16473"],"ncbi_summary":"The protein encoded by this gene is a membrane protein and a major controller of thyroid cell metabolism. The encoded protein is a receptor for thyrothropin and thyrostimulin, and its activity is mediated by adenylate cyclase. Defects in this gene are a cause of several types of hyperthyroidism. Three transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Dec 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P16473","text":"Receptor for the thyroid-stimulating hormone (TSH) or thyrotropin (PubMed:11847099, PubMed:12045258). Also acts as a receptor for the heterodimeric glycoprotein hormone (GPHA2:GPHB5) or thyrostimulin (PubMed:12045258). TSHR is coupled to G(s) proteins and mediates the activation of adenylate cyclase (PubMed:11847099, PubMed:35940205, PubMed:35940204). This leads to the generation of cyclic adenosine monophosphate (cAMP), which in turn activates protein kinase A (PKA). PKA subsequently phosphorylates downstream targets involved in thyroid hormone biosynthesis and secretion, including thyroid peroxidase (TPO) and the sodium/iodide symporter (NIS) (PubMed:27638195). Additionally, plays a central role in controlling thyroid cell metabolism (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}