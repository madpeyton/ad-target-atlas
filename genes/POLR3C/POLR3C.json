us_padj":0.334026,"nucleus_log2fc":0.0215698,"nucleus_score":1.06213,"pct_ad":0.105549,"pct_control":0.102928,"donor_test":"not significant","donor_padj":0.915968,"donor_log2fc":0.0503799,"donor_lfcse":0.0752368,"donor_log2fc_shrunk":0.00844891,"degas_log2fc":-0.191994,"degas_padj":2.09595e-07}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000186141","entrez_id":["10623"],"uniprot":["Q9BUI4"],"ncbi_summary":"Enables single-stranded DNA binding activity. Involved in positive regulation of innate immune response and positive regulation of interferon-beta production. Located in nucleoplasm. Part of RNA polymerase III complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BUI4","text":"DNA-dependent RNA polymerase catalyzes the transcription of DNA into RNA using the four ribonucleoside triphosphates as substrates (PubMed:20413673, PubMed:33558764, PubMed:33558766, PubMed:34675218, PubMed:35637192). Specific peripheric component of RNA polymerase III (Pol III) which synthesizes small non-coding RNAs including 5S rRNA, snRNAs, tRNAs and miRNAs from at least 500 distinct genomic loci (PubMed:20413673, PubMed:33558764, PubMed:33558766, PubMed:35637192). Part of POLR3C/RPC3-POLR3F/RPC6-POLR3G/RPC7 heterotrimer, coordinates the dynamics of Pol III stalk and clamp modules during the transition from apo to elongation state (PubMed:33558764, PubMed:33558766). Pol III plays a key role in sensing and limiting infection by intracellular bacteria and DNA viruses. Acts as a nuclear and cytosolic DNA sensor involved in innate immune response. Can sense non-self dsDNA that serves as template for transcription into dsRNA. The non-self RNA polymerase III transcripts, such as Epstein-Barr virus-encoded RNAs (EBERs) induce type I interferon and NF-kappa-B through the RIG-I pathway (PubMed:19609254, PubMed:19631370). Preferentially binds single-stranded DNA (ssDNA) in a sequence-independent manner (PubMed:21358628)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}