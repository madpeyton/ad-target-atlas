cleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.769472,"nucleus_log2fc":0.0912135,"nucleus_score":0.366796,"pct_ad":0.119362,"pct_control":0.11852,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.138715,"donor_lfcse":0.0957408,"donor_log2fc_shrunk":2.3421e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000033011","entrez_id":["56052"],"uniprot":["Q9BT22"],"ncbi_summary":"The enzyme encoded by this gene catalyzes the first mannosylation step in the biosynthesis of lipid-linked oligosaccharides. This gene is mutated in congenital disorder of glycosylation type Ik. [provided by RefSeq, Dec 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BT22","text":"Mannosyltransferase that operates in the biosynthetic pathway of dolichol-linked oligosaccharides, the glycan precursors employed in protein asparagine (N)-glycosylation. The assembly of dolichol-linked oligosaccharides begins on the cytosolic side of the endoplasmic reticulum membrane and finishes in its lumen. The sequential addition of sugars to dolichol pyrophosphate produces dolichol-linked oligosaccharides containing fourteen sugars, including two GlcNAcs, nine mannoses and three glucoses. Once assembled, the oligosaccharide is transferred from the lipid to nascent proteins by oligosaccharyltransferases. Catalyzes, on the cytoplasmic face of the endoplasmic reticulum, the addition of the first mannose residues to the dolichol-linked oligosaccharide chain, to produce Man1GlcNAc(2)-PP-dolichol core oligosaccharide. Man1GlcNAc(2)-PP-dolichol is a substrate for ALG2, the following enzyme in the biosynthetic pathway."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}