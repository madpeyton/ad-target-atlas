":0.076447,"donor_log2fc_shrunk":0.000348176},{"cell_type":"Mic","gene_symbol":"HLF","gene_symbol_current":"HLF","gene_id":"ENSG00000108924","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.972442,"donor_log2fc":-0.0392154,"donor_lfcse":0.204437,"donor_log2fc_shrunk":-0.00188558},{"cell_type":"OPC","gene_symbol":"HLF","gene_symbol_current":"HLF","gene_id":"ENSG00000108924","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000847257,"nucleus_log2fc":-0.194877,"nucleus_score":-3.84502,"pct_ad":0.255741,"pct_control":0.284843,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.19225,"donor_lfcse":0.0915315,"donor_log2fc_shrunk":-2.39447e-05},{"cell_type":"Oli","gene_symbol":"HLF","gene_symbol_current":"HLF","gene_id":"ENSG00000108924","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.942045,"donor_log2fc":-0.074069,"donor_lfcse":0.156853,"donor_log2fc_shrunk":-0.00319181}],"modules":[{"cell_type":"In","gene_id":"ENSG00000108924","module":"black","kme":0.34771,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000108924","module":"turquoise","kme":0.137821,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000108924","entrez_id":["3131"],"uniprot":["Q16534"],"ncbi_summary":"This gene encodes a member of the proline and acidic-rich (PAR) protein family, a subset of the bZIP transcription factors. The encoded protein forms homodimers or heterodimers with other PAR family members and binds sequence-specific promoter elements to activate transcription. Chromosomal translocations fusing portions of this gene with the E2A gene cause a subset of childhood B-lineage acute lymphoid leukemias. Alternatively spliced transcript variants have been described, but their biological validity has not been determined. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q16534","text":"Transcription factor which selectively binds with high affinity to the consensus sequence 5'-GTTACGTAAT-3' and to closely related sites (PubMed:8065331, PubMed:8164688, PubMed:8639829). Has transcriptional activator activity (PubMed:10073576, PubMed:8065331, PubMed:8164688, PubMed:8639829). Also has transcriptional repressor activity (By similarity). Binds to multiple sites in the promoter regions of coagulation factors F8 and F9 and activates transcription; transactivation activity is enhanced by formation of a heterodimer with DBP (PubMed:10073576). Binds to the promoter region of IRF2 and activates transcription (By similarity). Maintains quiescence of hematopoietic stem cells under steady-state conditions and protects the stem cell pool from toxic insults (By similarity). Regulates the tissue residency and proinflammatory function of CD4+ tissue-resident memory T (TRM) cells (By similarity). Down-regulates the expression of genes involved in promoting tissue egress of CD4+ TRM cells including S1PR1, KLF2 and TCF7 while up-regulating expression of tissue retention molecules such as CD69 (By similarity). Also up-regulates BHLHE40 expression, promoting proinflammatory cytokine production (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}