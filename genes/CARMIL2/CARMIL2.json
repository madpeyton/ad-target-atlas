nucleus_score":3.39984,"pct_ad":0.221305,"pct_control":0.216165,"donor_test":"not significant","donor_padj":0.740342,"donor_log2fc":0.130277,"donor_lfcse":0.0885988,"donor_log2fc_shrunk":0.00806189,"degas_log2fc":0.176034,"degas_padj":2.39754e-27},{"cell_type":"Mic","gene_symbol":"CARMIL2","gene_symbol_current":"CARMIL2","gene_id":"ENSG00000159753","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.953915,"donor_log2fc":-0.0761346,"donor_lfcse":0.248964,"donor_log2fc_shrunk":-0.00251127,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"CARMIL2","gene_symbol_current":"CARMIL2","gene_id":"ENSG00000159753","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.967796,"donor_log2fc":-0.0668159,"donor_lfcse":0.208276,"donor_log2fc_shrunk":-0.00165121,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000159753","entrez_id":["146206"],"uniprot":["Q6F5E8"],"ncbi_summary":"This gene encodes a member of the CARMIL (capping protein, Arp2/3, myosin-I linker) family of proteins. The encoded protein interacts with and negatively regulates the heterodimeric capping protein and promotes cell migration. Reduced expression of this gene has been observed in human psoriasis patients. Mutations in this gene cause a human immunodeficiency syndrome characterized by smooth muscle tumors and impaired T-cell function. [provided by RefSeq, May 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6F5E8","text":"Cell membrane-cytoskeleton-associated protein that plays a role in the regulation of actin polymerization at the barbed end of actin filaments. Prevents F-actin heterodimeric capping protein (CP) activity at the leading edges of migrating cells, and hence generates uncapped barbed ends and enhances actin polymerization (PubMed:26466680). Plays a role in cell protrusion formations; involved in cell polarity, lamellipodial assembly, membrane ruffling and macropinosome formations (PubMed:19846667, PubMed:26466680, PubMed:26578515). Involved as well in cell migration and invadopodia formation during wound healing (PubMed:19846667, PubMed:26466680, PubMed:26578515). Required for CD28-mediated stimulation of NF-kappa-B signaling, involved in naive T cells activation, maturation into T memory cells, and differentiation into T helper and T regulatory cells (PubMed:27647348, PubMed:27647349, PubMed:28112205)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}