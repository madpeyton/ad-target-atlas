,"module_direction":"lower in AD","module_padj":0.900878,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000174197","module":"green","kme":0.185896,"hub":false,"module_direction":"higher in AD","module_padj":0.232138,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000174197","module":"blue","kme":0.206412,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000174197","entrez_id":["23269"],"uniprot":["Q8IWI9"],"ncbi_summary":"Predicted to enable DNA-binding transcription activator activity, RNA polymerase II-specific and RNA polymerase II cis-regulatory region sequence-specific DNA binding activity. Predicted to be involved in cell fate specification and positive regulation of transcription by RNA polymerase II. Predicted to act upstream of or within cellular response to leukemia inhibitory factor. Part of MLL1 complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IWI9","text":"Functions as a dual-specificity transcription factor, regulating the expression of both MAX-network and T-box family target genes. Functions as a repressor or an activator. Binds to 5'-AATTTCACACCTAGGTGTGAAATT-3' core sequence and seems to regulate MYC-MAX target genes. Suppresses transcriptional activation by MYC and inhibits MYC-dependent cell transformation. Function activated by heterodimerization with MAX. This heterodimerization serves the dual function of both generating an E-box-binding heterodimer and simultaneously blocking interaction of a corepressor (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}