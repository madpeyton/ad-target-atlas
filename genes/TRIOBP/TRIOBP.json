adj":1.16897e-07},{"cell_type":"Oli","gene_symbol":"TRIOBP","gene_symbol_current":"TRIOBP","gene_id":"ENSG00000100106","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00100086,"nucleus_log2fc":-0.0994093,"nucleus_score":-3.43329,"pct_ad":0.140356,"pct_control":0.149236,"donor_test":"not significant","donor_padj":0.967401,"donor_log2fc":-0.0340031,"donor_lfcse":0.105033,"donor_log2fc_shrunk":-0.00322407,"degas_log2fc":-0.268678,"degas_padj":6.87343e-18}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000100106","module":"blue","kme":0.0794125,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000100106","module":"blue","kme":0.0735022,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000100106","module":"blue","kme":0.0922968,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100106","entrez_id":["11078"],"uniprot":["Q9H2D6"],"ncbi_summary":"This gene encodes a protein with an N-terminal pleckstrin homology domain and a C-terminal coiled-coil region. The protein interacts with trio, which is involved with neural tissue development and controlling actin cytoskeleton organization, cell motility and cell growth. The protein also associates with F-actin and stabilizes F-actin structures. Mutations in this gene have been associated with a form of autosomal recessive nonsyndromic deafness. Multiple alternatively spliced transcript variants that would encode different isoforms have been found for this gene, however some transcripts may be subject to nonsense-mediated decay (NMD). [provided by RefSeq, Nov 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H2D6","text":"[Isoform 1]: Regulates actin cytoskeletal organization, cell spreading and cell contraction by directly binding and stabilizing filamentous F-actin and prevents its depolymerization (PubMed:18194665, PubMed:28438837). May also serve as a linker protein to recruit proteins required for F-actin formation and turnover (PubMed:18194665). Essential for correct mitotic progression (PubMed:22820163, PubMed:24692559). [Isoform 5]: Plays a pivotal role in the formation of stereocilia rootlets. [Isoform 4]: Plays a pivotal role in the formation of stereocilia rootlets."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}