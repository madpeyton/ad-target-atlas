.info","uniprot_function":[{"accession":"O43307","text":"Acts as a guanine nucleotide exchange factor (GEF) for CDC42. Promotes formation of GPHN clusters (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}