0.32686,"donor_test":"not significant","donor_padj":0.930154,"donor_log2fc":0.0283179,"donor_lfcse":0.0800251,"donor_log2fc_shrunk":0.0014331,"degas_log2fc":-0.134396,"degas_padj":9.87081e-25},{"cell_type":"Mic","gene_symbol":"TRPV1","gene_symbol_current":"TRPV1","gene_id":"ENSG00000196689","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.11418e-08,"nucleus_log2fc":-0.394789,"nucleus_score":-5.85642,"pct_ad":0.0997214,"pct_control":0.125691,"donor_test":"not significant","donor_padj":0.242417,"donor_log2fc":-0.341711,"donor_lfcse":0.122505,"donor_log2fc_shrunk":-0.207637,"degas_log2fc":0.101996,"degas_padj":0.18608},{"cell_type":"OPC","gene_symbol":"TRPV1","gene_symbol_current":"TRPV1","gene_id":"ENSG00000196689","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0106034,"nucleus_log2fc":-0.239521,"nucleus_score":-3.04432,"pct_ad":0.129436,"pct_control":0.147671,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.167989,"donor_lfcse":0.131781,"donor_log2fc_shrunk":-9.97285e-06,"degas_log2fc":-0.417915,"degas_padj":7.40155e-08},{"cell_type":"Oli","gene_symbol":"TRPV1","gene_symbol_current":"TRPV1","gene_id":"ENSG00000196689","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.33517e-09,"nucleus_log2fc":-0.14772,"nucleus_score":-6.13166,"pct_ad":0.213293,"pct_control":0.232016,"donor_test":"not significant","donor_padj":0.845982,"donor_log2fc":-0.124068,"donor_lfcse":0.118681,"donor_log2fc_shrunk":-0.0092726,"degas_log2fc":-0.328271,"degas_padj":2.73763e-39}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000196689","module":"brown","kme":0.241226,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000196689","module":"pink","kme":0.165067,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000196689","module":"turquoise","kme":0.0319928,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000196689","module":"blue","kme":0.0673678,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000196689","module":"blue","kme":0.12409,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000196689","entrez_id":["7442"],"uniprot":["Q8NER1"],"ncbi_summary":"Capsaicin, the main pungent ingredient in hot chili peppers, elicits a sensation of burning pain by selectively activating sensory neurons that convey information about noxious stimuli to the central nervous system. The protein encoded by this gene is a receptor for capsaicin and is a non-selective cation channel that is structurally related to members of the TRP family of ion channels. This receptor is also activated by increases in temperature in the noxious range, suggesting that it functions as a transducer of painful thermal stimuli in vivo. Four transcript variants encoding the same protein, but with different 5' UTR sequence, have been described for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8NER1","text":"Non-selective calcium permeant cation channel involved in detection of noxious chemical and thermal stimuli (PubMed:11050376, PubMed:11243859, PubMed:11226139, PubMed:12077606). Seems to mediate proton influx and may be involved in intracellular acidosis in nociceptive neurons. Involved in mediation of inflammatory pain and hyperalgesia. Sensitized by a phosphatidylinositol second messenger system activated by receptor tyrosine kinases, which involves PKC isozymes and PCL. Activated by vanilloids, like capsaicin, and temperatures higher than 42 degrees Celsius (PubMed:37117175). Upon activation, exhibits a time- and Ca(2+)-dependent outward rectification, followed by a long-lasting refractory state. Mild extracellular acidic pH (6.5) potentiates channel activation by noxious heat and vanilloids, whereas acidic conditions (pH <6) directly activate the channel. Can be activated by endogenous compounds, including 12-hydroperoxytetraenoic acid and bradykinin. Acts as ionotropic endocannabinoid receptor with central neuromodulatory effects. Triggers a form of long-term depression (TRPV1-LTD) mediated by the endocannabinoid anandamine in the hippocampus and nucleus accumbens by affecting AMPA receptors endocytosis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}