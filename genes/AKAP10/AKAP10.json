"ENSG00000108599","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.11767,"nucleus_log2fc":0.467973,"nucleus_score":2.43709,"pct_ad":0.210332,"pct_control":0.162297,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"AKAP10","gene_symbol_current":"AKAP10","gene_id":"ENSG00000108599","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.961,"nucleus_log2fc":0.0602976,"nucleus_score":0.129059,"pct_ad":0.166405,"pct_control":0.166284,"donor_test":"not significant","donor_padj":0.993604,"donor_log2fc":0.0585744,"donor_lfcse":0.147865,"donor_log2fc_shrunk":0.000549623},{"cell_type":"Oli","gene_symbol":"AKAP10","gene_symbol_current":"AKAP10","gene_id":"ENSG00000108599","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.453451,"nucleus_log2fc":0.0383659,"nucleus_score":0.946861,"pct_ad":0.107533,"pct_control":0.102643,"donor_test":"not significant","donor_padj":0.96601,"donor_log2fc":0.0220342,"donor_lfcse":0.100976,"donor_log2fc_shrunk":0.00193082}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000108599","module":"blue","kme":0.160378,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000108599","module":"red","kme":0.166357,"hub":false,"module_direction":"lower in AD","module_padj":0.737188,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000108599","entrez_id":["11216"],"uniprot":["O43572"],"ncbi_summary":"This gene encodes a member of the A-kinase anchor protein family. A-kinase anchor proteins bind to the regulatory subunits of protein kinase A (PKA) and confine the holoenzyme to discrete locations within the cell. The encoded protein is localized to mitochondria and interacts with both the type I and type II regulatory subunits of PKA. Polymorphisms in this gene may be associated with increased risk of arrhythmias and sudden cardiac death. [provided by RefSeq, May 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43572","text":"Differentially targeted protein that binds to type I and II regulatory subunits of protein kinase A and anchors them to the mitochondria or the plasma membrane. Although the physiological relevance between PKA and AKAPS with mitochondria is not fully understood, one idea is that BAD, a proapoptotic member, is phosphorylated and inactivated by mitochondria-anchored PKA. It cannot be excluded too that it may facilitate PKA as well as G protein signal transduction, by acting as an adapter for assembling multiprotein complexes. With its RGS domain, it could lead to the interaction to G-alpha proteins, providing a link between the signaling machinery and the downstream kinase (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}