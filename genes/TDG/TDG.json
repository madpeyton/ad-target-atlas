464,"hub":false,"module_direction":"lower in AD","module_padj":0.642666,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000139372","module":"blue","kme":0.223727,"hub":false,"module_direction":"lower in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000139372","module":"brown","kme":0.250063,"hub":false,"module_direction":"lower in AD","module_padj":0.199655,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000139372"],"dataset_symbols":["TDG"],"explorer":"explorer.html?dataset=mathys2019#gene/TDG","cell_types":[{"cell_type":"Ex","gene_symbol":"TDG","gene_symbol_current":"TDG","gene_id":"ENSG00000139372","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.53809e-29,"nucleus_log2fc":-0.429565,"nucleus_score":-11.649,"pct_ad":0.252235,"pct_control":0.32222,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.285448,"donor_lfcse":0.152212,"donor_log2fc_shrunk":-1.28492e-05},{"cell_type":"In","gene_symbol":"TDG","gene_symbol_current":"TDG","gene_id":"ENSG00000139372","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.381234,"nucleus_log2fc":-0.195403,"nucleus_score":-1.77879,"pct_ad":0.190328,"pct_control":0.208528,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.105062,"donor_lfcse":0.187504,"donor_log2fc_shrunk":-3.1192e-06},{"cell_type":"OPC","gene_symbol":"TDG","gene_symbol_current":"TDG","gene_id":"ENSG00000139372","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.51479,"nucleus_log2fc":-0.23745,"nucleus_score":-1.24524,"pct_ad":0.10832,"pct_control":0.123372,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"TDG","gene_symbol_current":"TDG","gene_id":"ENSG00000139372","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.966005,"donor_log2fc":-0.0354021,"donor_lfcse":0.156743,"donor_log2fc_shrunk":-0.00135801}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000139372","entrez_id":["6996"],"uniprot":["Q13569"],"ncbi_summary":"The protein encoded by this gene belongs to the TDG/mug DNA glycosylase family. Thymine-DNA glycosylase (TDG) removes thymine moieties from G/T mismatches by hydrolyzing the carbon-nitrogen bond between the sugar-phosphate backbone of DNA and the mispaired thymine. With lower activity, this enzyme also removes thymine from C/T and T/T mispairings. TDG can also remove uracil and 5-bromouracil from mispairings with guanine. This enzyme plays a central role in cellular defense against genetic mutation caused by the spontaneous deamination of 5-methylcytosine and cytosine. This gene may have a pseudogene in the p arm of chromosome 12. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13569","text":"DNA glycosylase that plays a key role in active DNA demethylation: specifically recognizes and binds 5-formylcytosine (5fC) and 5-carboxylcytosine (5caC) in the context of CpG sites and mediates their excision through base-excision repair (BER) to install an unmethylated cytosine. Cannot remove 5-hydroxymethylcytosine (5hmC). According to an alternative model, involved in DNA demethylation by mediating DNA glycolase activity toward 5-hydroxymethyluracil (5hmU) produced by deamination of 5hmC. Also involved in DNA repair by acting as a thymine-DNA glycosylase that mediates correction of G/T mispairs to G/C pairs: in the DNA of higher eukaryotes, hydrolytic deamination of 5-methylcytosine to thymine leads to the formation of G/T mismatches. Its role in the repair of canonical base damage is however minor compared to its role in DNA demethylation. It is capable of hydrolyzing the carbon-nitrogen bond between the sugar-phosphate backbone of the DNA and a mispaired thymine. In addition to the G/T, it can remove thymine also from C/T and T/T mispairs in the order G/T >> C/T > T/T. It has no detectable activity on apyrimidinic sites and does not catalyze the removal of thymine from A/T pairs or from single-stranded DNA. It can also remove uracil and 5-bromouracil from mispairs with guanine."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}