ne_id":"ENSG00000164414","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.798698,"nucleus_log2fc":-0.000309996,"nucleus_score":0.402163,"pct_ad":0.384432,"pct_control":0.37917,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0115195,"donor_lfcse":0.0592578,"donor_log2fc_shrunk":5.92564e-06,"degas_log2fc":-0.0174927,"degas_padj":0.72022},{"cell_type":"Oli","gene_symbol":"SLC35A1","gene_symbol_current":"SLC35A1","gene_id":"ENSG00000164414","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":7.0004e-06,"nucleus_log2fc":-0.0956816,"nucleus_score":-4.64859,"pct_ad":0.19134,"pct_control":0.206221,"donor_test":"not significant","donor_padj":0.86931,"donor_log2fc":-0.0518475,"donor_lfcse":0.0579773,"donor_log2fc_shrunk":-0.0138099,"degas_log2fc":-0.162475,"degas_padj":1.03423e-09}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000164414","module":"turquoise","kme":0.0727506,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000164414","module":"turquoise","kme":0.0422461,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000164414","module":"turquoise","kme":0.0465391,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164414","entrez_id":["10559"],"uniprot":["P78382"],"ncbi_summary":"The protein encoded by this gene is found in the membrane of the Golgi apparatus, where it transports nucleotide sugars into the Golgi. One such nucleotide sugar is CMP-sialic acid, which is imported into the Golgi by the encoded protein and subsequently glycosylated. Defects in this gene are a cause of congenital disorder of glycosylation type 2F (CDG2F). Two transcript variants encoding different isoforms have been found for this gene.[provided by RefSeq, Dec 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P78382","text":"Transports CMP-sialic acid from the cytosol into the Golgi apparatus, functioning as an antiporter that exchanges CMP-sialic acid for CMP (PubMed:12682060, PubMed:15576474, PubMed:23873973). Binds both CMP-sialic acid and free CMP, but has higher affinity for free CMP (By similarity). Also able to exchange CMP-sialic acid for AMP and UMP (PubMed:12682060). Also mediates the transport of CDP-ribitol (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}