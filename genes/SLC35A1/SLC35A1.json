ll}],"modules":[{"cell_type":"CUX2-","gene_id":"ENSG00000164414","module":"yellow","kme":0.16546,"hub":false,"module_direction":"lower in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000164414"],"dataset_symbols":["SLC35A1"],"explorer":"explorer.html?dataset=mathys2019#gene/SLC35A1","cell_types":[{"cell_type":"Ex","gene_symbol":"SLC35A1","gene_symbol_current":"SLC35A1","gene_id":"ENSG00000164414","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00316353,"nucleus_log2fc":-0.14857,"nucleus_score":-3.20982,"pct_ad":0.136631,"pct_control":0.152018,"donor_test":"not significant","donor_padj":0.99429,"donor_log2fc":-0.0214193,"donor_lfcse":0.105736,"donor_log2fc_shrunk":-2.63434e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164414","entrez_id":["10559"],"uniprot":["P78382"],"ncbi_summary":"The protein encoded by this gene is found in the membrane of the Golgi apparatus, where it transports nucleotide sugars into the Golgi. One such nucleotide sugar is CMP-sialic acid, which is imported into the Golgi by the encoded protein and subsequently glycosylated. Defects in this gene are a cause of congenital disorder of glycosylation type 2F (CDG2F). Two transcript variants encoding different isoforms have been found for this gene.[provided by RefSeq, Dec 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P78382","text":"Transports CMP-sialic acid from the cytosol into the Golgi apparatus, functioning as an antiporter that exchanges CMP-sialic acid for CMP (PubMed:12682060, PubMed:15576474, PubMed:23873973). Binds both CMP-sialic acid and free CMP, but has higher affinity for free CMP (By similarity). Also able to exchange CMP-sialic acid for AMP and UMP (PubMed:12682060). Also mediates the transport of CDP-ribitol (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}