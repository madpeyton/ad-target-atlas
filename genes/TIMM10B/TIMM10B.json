it through the aqueous mitochondrial intermembrane space."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"},{"gene_id":"ENSG00000265264","entrez_id":[],"uniprot":[],"ncbi_summary":null,"ncbi_source":null,"uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}