y","gene_id":"ENSG00000115652","module":"yellow","kme":0.227679,"hub":false,"module_direction":"higher in AD","module_padj":0.726304,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000115652"],"dataset_symbols":["UXS1"],"explorer":"explorer.html?dataset=mathys2019#gene/UXS1","cell_types":[{"cell_type":"Ex","gene_symbol":"UXS1","gene_symbol_current":"UXS1","gene_id":"ENSG00000115652","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000862112,"nucleus_log2fc":-0.0904547,"nucleus_score":-3.6082,"pct_ad":0.27885,"pct_control":0.30252,"donor_test":"not significant","donor_padj":0.990685,"donor_log2fc":-0.0322792,"donor_lfcse":0.0911309,"donor_log2fc_shrunk":-3.91913e-06},{"cell_type":"In","gene_symbol":"UXS1","gene_symbol_current":"UXS1","gene_id":"ENSG00000115652","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.744985,"nucleus_log2fc":-0.133661,"nucleus_score":-0.834293,"pct_ad":0.180568,"pct_control":0.18643,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0489237,"donor_lfcse":0.131478,"donor_log2fc_shrunk":-2.97603e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000115652","module":"brown","kme":0.173463,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000115652","entrez_id":["80146"],"uniprot":["Q8NBZ7"],"ncbi_summary":"This gene encodes an enzyme found in the perinuclear Golgi which catalyzes the synthesis of UDP-xylose used in glycosaminoglycan (GAG) synthesis on proteoglycans. The GAG chains are covalently attached to proteoglycans which participate in signaling pathways during development. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Dec 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8NBZ7","text":"Catalyzes the NAD-dependent decarboxylation of UDP-glucuronic acid to UDP-xylose (PubMed:22810237, PubMed:23656592, PubMed:25521717, PubMed:40836090). Necessary for the biosynthesis of the core tetrasaccharide in glycosaminoglycan biosynthesis (PubMed:22810237, PubMed:23656592, PubMed:25521717, PubMed:40836090). Catalyzes the synthesis of UDP-xylose in two steps: the hydroxyl group of UDP-glucuronic acid is first oxidized using an enzyme-bound NAD(+) as electron acceptor, favoring the decarboxylation yielding a UDP-4-ketoxylose reaction intermediate and a reduced cofactor NADH bound to the catalytic pocket (PubMed:22810237, PubMed:40836090). In the second step, the 4-keto group is reduced resulting in UDP-xylose and the restoration of the enzyme to its NAD(+)-bound form (PubMed:22810237, PubMed:40836090)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}