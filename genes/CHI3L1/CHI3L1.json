explorer.html?dataset=mathys2019#gene/CHI3L1","cell_types":[{"cell_type":"Ast","gene_symbol":"CHI3L1","gene_symbol_current":"CHI3L1","gene_id":"ENSG00000133048","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.176025,"nucleus_log2fc":0.401944,"nucleus_score":1.70141,"pct_ad":0.159091,"pct_control":0.143787,"donor_test":"not significant","donor_padj":0.636625,"donor_log2fc":0.862026,"donor_lfcse":0.482884,"donor_log2fc_shrunk":0.00779751},{"cell_type":"Ex","gene_symbol":"CHI3L1","gene_symbol_current":"CHI3L1","gene_id":"ENSG00000133048","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.99429,"donor_log2fc":-0.0479909,"donor_lfcse":0.237917,"donor_log2fc_shrunk":-8.91278e-07}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000133048","module":"turquoise","kme":0.211957,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000133048","entrez_id":["1116"],"uniprot":["P36222"],"ncbi_summary":"Chitinases catalyze the hydrolysis of chitin, which is an abundant glycopolymer found in insect exoskeletons and fungal cell walls. The glycoside hydrolase 18 family of chitinases includes eight human family members. This gene encodes a glycoprotein member of the glycosyl hydrolase 18 family. The protein lacks chitinase activity and is secreted by activated macrophages, chondrocytes, neutrophils and synovial cells. The protein is thought to play a role in the process of inflammation and tissue remodeling. [provided by RefSeq, Sep 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P36222","text":"Carbohydrate-binding lectin with a preference for chitin. Has no chitinase activity. May play a role in tissue remodeling and in the capacity of cells to respond to and cope with changes in their environment. Plays a role in T-helper cell type 2 (Th2) inflammatory response and IL-13-induced inflammation, regulating allergen sensitization, inflammatory cell apoptosis, dendritic cell accumulation and M2 macrophage differentiation. Facilitates invasion of pathogenic enteric bacteria into colonic mucosa and lymphoid organs. Mediates activation of AKT1 signaling pathway and subsequent IL8 production in colonic epithelial cells. Regulates antibacterial responses in lung by contributing to macrophage bacterial killing, controlling bacterial dissemination and augmenting host tolerance. Also regulates hyperoxia-induced injury, inflammation and epithelial apoptosis in lung."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}