or_test":"not significant","donor_padj":0.751245,"donor_log2fc":0.140153,"donor_lfcse":0.101664,"donor_log2fc_shrunk":0.00653946},{"cell_type":"Mic","gene_symbol":"MAFB","gene_symbol_current":"MAFB","gene_id":"ENSG00000204103","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.21189e-38,"nucleus_log2fc":0.607792,"nucleus_score":13.287,"pct_ad":0.330362,"pct_control":0.250115,"donor_test":"not significant","donor_padj":0.441896,"donor_log2fc":0.509209,"donor_lfcse":0.251399,"donor_log2fc_shrunk":0.0166008},{"cell_type":"Oli","gene_symbol":"MAFB","gene_symbol_current":"MAFB","gene_id":"ENSG00000204103","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.692567,"donor_log2fc":0.297854,"donor_lfcse":0.182367,"donor_log2fc_shrunk":0.00996185}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000204103","entrez_id":["9935"],"uniprot":["Q9Y5Q3"],"ncbi_summary":"The protein encoded by this gene is a basic leucine zipper (bZIP) transcription factor that plays an important role in the regulation of lineage-specific hematopoiesis. The encoded nuclear protein represses ETS1-mediated transcription of erythroid-specific genes in myeloid cells. This gene contains no introns. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y5Q3","text":"Acts as a transcriptional activator or repressor (PubMed:27181683). Plays a pivotal role in regulating lineage-specific hematopoiesis by repressing ETS1-mediated transcription of erythroid-specific genes in myeloid cells. Required for monocytic, macrophage, osteoclast, podocyte and islet beta cell differentiation. Involved in renal tubule survival and F4/80 maturation. Activates the insulin and glucagon promoters. Together with PAX6, transactivates weakly the glucagon gene promoter through the G1 element. SUMO modification controls its transcriptional activity and ability to specify macrophage fate. Binds element G1 on the glucagon promoter (By similarity). Involved either as an oncogene or as a tumor suppressor, depending on the cell context. Required for the transcriptional activation of HOXB3 in the rhombomere r5 in the hindbrain (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}