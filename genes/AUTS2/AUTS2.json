_lfcse":0.112361,"donor_log2fc_shrunk":-8.61407e-06,"degas_log2fc":-0.269438,"degas_padj":1.09796e-17},{"cell_type":"Oli","gene_symbol":"AUTS2","gene_symbol_current":"AUTS2","gene_id":"ENSG00000158321","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":7.0132e-20,"nucleus_log2fc":-0.0981601,"nucleus_score":-9.28948,"pct_ad":0.958751,"pct_control":0.967601,"donor_test":"not significant","donor_padj":0.932824,"donor_log2fc":-0.0635076,"donor_lfcse":0.119275,"donor_log2fc_shrunk":-0.0046755,"degas_log2fc":-0.339907,"degas_padj":1.27514e-288}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000158321","module":"yellow","kme":0.325326,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000158321","module":"pink","kme":0.363892,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000158321","module":"turquoise","kme":0.111384,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000158321","module":"blue","kme":0.194437,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000158321","entrez_id":["26053"],"uniprot":["Q8WXX7"],"ncbi_summary":"This gene has been implicated in neurodevelopment and as a candidate gene for numerous neurological disorders, including autism spectrum disorders, intellectual disability, and developmental delay. Mutations in this gene have also been associated with non-neurological disorders, such as acute lymphoblastic leukemia, aging of the skin, early-onset androgenetic alopecia, and certain cancers. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, May 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WXX7","text":"Component of a Polycomb group (PcG) multiprotein PRC1-like complex, a complex class required to maintain the transcriptionally repressive state of many genes, including Hox genes, throughout development. PcG PRC1 complex acts via chromatin remodeling and modification of histones; it mediates monoubiquitination of histone H2A 'Lys-119', rendering chromatin heritably changed in its expressibility (PubMed:25519132). The PRC1-like complex that contains PCGF5, RNF2, CSNK2B, RYBP and AUTS2 has decreased histone H2A ubiquitination activity, due to the phosphorylation of RNF2 by CSNK2B (PubMed:25519132). As a consequence, the complex mediates transcriptional activation (PubMed:25519132). In the cytoplasm, plays a role in axon and dendrite elongation and in neuronal migration during embryonic brain development. Promotes reorganization of the actin cytoskeleton, lamellipodia formation and neurite elongation via its interaction with RAC guanine nucleotide exchange factors, which then leads to the activation of RAC1 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}