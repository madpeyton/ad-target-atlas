86,"nucleus_log2fc":0.122452,"nucleus_score":1.88612,"pct_ad":0.313221,"pct_control":0.285714,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.105859,"donor_lfcse":0.125918,"donor_log2fc_shrunk":6.52599e-06},{"cell_type":"Mic","gene_symbol":"IRS2","gene_symbol_current":"IRS2","gene_id":"ENSG00000185950","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.369974,"nucleus_log2fc":-0.34738,"nucleus_score":-1.61181,"pct_ad":0.141451,"pct_control":0.169788,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"IRS2","gene_symbol_current":"IRS2","gene_id":"ENSG00000185950","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.645297,"nucleus_log2fc":0.134028,"nucleus_score":0.9243,"pct_ad":0.242543,"pct_control":0.229885,"donor_test":"not significant","donor_padj":0.976536,"donor_log2fc":0.228766,"donor_lfcse":0.168675,"donor_log2fc_shrunk":0.00165002},{"cell_type":"Oli","gene_symbol":"IRS2","gene_symbol_current":"IRS2","gene_id":"ENSG00000185950","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.91036e-11,"nucleus_log2fc":0.525813,"nucleus_score":6.91927,"pct_ad":0.10652,"pct_control":0.077168,"donor_test":"not significant","donor_padj":0.447963,"donor_log2fc":0.391689,"donor_lfcse":0.123904,"donor_log2fc_shrunk":0.286759}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000185950","module":"turquoise","kme":0.209823,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000185950","module":"pink","kme":0.303256,"hub":false,"module_direction":"higher in AD","module_padj":1.0,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000185950","module":"yellow","kme":0.190399,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000185950","module":"turquoise","kme":0.108164,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000185950","entrez_id":["8660"],"uniprot":["Q9Y4H2"],"ncbi_summary":"This gene encodes the insulin receptor substrate 2, a cytoplasmic signaling molecule that mediates effects of insulin, insulin-like growth factor 1, and other cytokines by acting as a molecular adaptor between diverse receptor tyrosine kinases and downstream effectors. The product of this gene is phosphorylated by the insulin receptor tyrosine kinase upon receptor stimulation, as well as by an interleukin 4 receptor-associated kinase in response to IL4 treatment. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y4H2","text":"Signaling adapter protein that participates in the signal transduction from two prominent receptor tyrosine kinases, insulin receptor/INSR and insulin-like growth factor I receptor/IGF1R (PubMed:25879670). Plays therefore an important role in development, growth, glucose homeostasis as well as lipid metabolism (PubMed:24616100). Upon phosphorylation by the insulin receptor, functions as a signaling scaffold that propagates insulin action through binding to SH2 domain-containing proteins including the p85 regulatory subunit of PI3K, NCK1, NCK2, GRB2 or SHP2 (PubMed:15316008, PubMed:19109239). Recruitment of GRB2 leads to the activation of the guanine nucleotide exchange factor SOS1 which in turn triggers the Ras/Raf/MEK/MAPK signaling cascade (By similarity). Activation of the PI3K/AKT pathway is responsible for most of insulin metabolic effects in the cell, and the Ras/Raf/MEK/MAPK is involved in the regulation of gene expression and in cooperation with the PI3K pathway regulates cell growth and differentiation. Acts a positive regulator of the Wnt/beta-catenin signaling pathway through suppression of DVL2 autophagy-mediated degradation leading to cell proliferation (PubMed:24616100). Plays a role in cell cycle progression by promoting a robust spindle assembly checkpoint (SAC) during M-phase (PubMed:32554797). In macrophages, IL4-induced tyrosine phosphorylation of IRS2 leads to the recruitment and activation of phosphoinositide 3-kinase (PI3K) (PubMed:19109239)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}