plorer.html?dataset=mathys2019#gene/SLC12A3","cell_types":[{"cell_type":"Ex","gene_symbol":"SLC12A3","gene_symbol_current":"SLC12A3","gene_id":"ENSG00000070915","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.496562,"donor_lfcse":0.212105,"donor_log2fc_shrunk":1.13638e-05,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false},"seaad_pfc":{"dataset_label":"SEA-AD (Gabitto et al. 2024)","gene_ids":["ENSG00000070915"],"dataset_symbols":["SLC12A3"],"explorer":"explorer.html?dataset=seaad_pfc#gene/SLC12A3","cell_types":[{"cell_type":"Ex","gene_symbol":"SLC12A3","gene_symbol_current":"SLC12A3","gene_id":"ENSG00000070915","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.76942,"donor_log2fc":0.312238,"donor_lfcse":0.343218,"donor_log2fc_shrunk":0.00249971,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"SLC12A3","gene_symbol_current":"SLC12A3","gene_id":"ENSG00000070915","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.715803,"donor_log2fc":0.415935,"donor_lfcse":0.235639,"donor_log2fc_shrunk":0.00359638,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000070915","entrez_id":["6559"],"uniprot":["P55017"],"ncbi_summary":"This gene encodes a renal thiazide-sensitive sodium-chloride cotransporter that is important for electrolyte homeostasis. This cotransporter mediates sodium and chloride reabsorption in the distal convoluted tubule. Mutations in this gene cause Gitelman syndrome, a disease similar to Bartter's syndrome, that is characterized by hypokalemic alkalosis combined with hypomagnesemia, low urinary calcium, and increased renin activity associated with normal blood pressure. This cotransporter is the target for thiazide diuretics that are used for treating high blood pressure. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P55017","text":"Electroneutral sodium and chloride ion cotransporter, which acts as a key mediator of sodium and chloride reabsorption in kidney distal convoluted tubules (PubMed:18270262, PubMed:21613606, PubMed:22009145, PubMed:36351028, PubMed:36792826). Also acts as a receptor for the pro-inflammatory cytokine IL18, thereby contributing to IL18-induced cytokine production, including IFNG, IL6, IL18 and CCL2 (By similarity). May act either independently of IL18R1, or in a complex with IL18R1 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}