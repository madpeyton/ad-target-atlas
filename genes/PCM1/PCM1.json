log2fc":-0.108133,"nucleus_score":-1.93352,"pct_ad":0.559894,"pct_control":0.586057,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0304006,"donor_lfcse":0.0516849,"donor_log2fc_shrunk":-5.37857e-06},{"cell_type":"Mic","gene_symbol":"PCM1","gene_symbol_current":"PCM1","gene_id":"ENSG00000078674","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.328384,"nucleus_log2fc":0.297947,"nucleus_score":1.70318,"pct_ad":0.266913,"pct_control":0.229713,"donor_test":"not significant","donor_padj":0.807697,"donor_log2fc":0.221073,"donor_lfcse":0.188971,"donor_log2fc_shrunk":0.0078179},{"cell_type":"OPC","gene_symbol":"PCM1","gene_symbol_current":"PCM1","gene_id":"ENSG00000078674","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.475719,"nucleus_log2fc":0.143329,"nucleus_score":1.33755,"pct_ad":0.411303,"pct_control":0.390805,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":0.104656,"donor_lfcse":0.0975054,"donor_log2fc_shrunk":0.00224087},{"cell_type":"Oli","gene_symbol":"PCM1","gene_symbol_current":"PCM1","gene_id":"ENSG00000078674","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0602968,"nucleus_log2fc":0.108651,"nucleus_score":2.18989,"pct_ad":0.240739,"pct_control":0.225878,"donor_test":"not significant","donor_padj":0.966005,"donor_log2fc":-0.0150924,"donor_lfcse":0.0661311,"donor_log2fc_shrunk":-0.00275884}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000078674","module":"green","kme":0.198618,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000078674","module":"blue","kme":0.200636,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000078674","entrez_id":["5108"],"uniprot":["Q15154"],"ncbi_summary":"The protein encoded by this gene is a component of centriolar satellites, which are electron dense granules scattered around centrosomes. Inhibition studies show that this protein is essential for the correct localization of several centrosomal proteins, and for anchoring microtubules to the centrosome. Chromosomal aberrations involving this gene are associated with papillary thyroid carcinomas and a variety of hematological malignancies, including atypical chronic myeloid leukemia and T-cell lymphoma. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Oct 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15154","text":"Required for centrosome assembly and function (PubMed:12403812, PubMed:15659651, PubMed:16943179). Essential for the correct localization of several centrosomal proteins including CEP250, CETN3, PCNT and NEK2 (PubMed:12403812, PubMed:15659651). Required to anchor microtubules to the centrosome (PubMed:12403812, PubMed:15659651). Also involved in cilium biogenesis by recruiting the BBSome, a ciliary protein complex involved in cilium biogenesis, to the centriolar satellites (PubMed:20551181, PubMed:24121310, PubMed:27979967). Recruits the tubulin polyglutamylase complex (TPGC) to centriolar satellites (PubMed:34782749)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}