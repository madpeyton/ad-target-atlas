ol":0.109217,"donor_test":"not significant","donor_padj":0.712381,"donor_log2fc":0.100044,"donor_lfcse":0.0849758,"donor_log2fc_shrunk":0.0257936},{"cell_type":"OPC","gene_symbol":"EIF2D","gene_symbol_current":"EIF2D","gene_id":"ENSG00000143486","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0838001,"nucleus_log2fc":0.13172,"nucleus_score":2.16609,"pct_ad":0.20847,"pct_control":0.193395,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0865094,"donor_lfcse":0.073557,"donor_log2fc_shrunk":1.67571e-05},{"cell_type":"Oli","gene_symbol":"EIF2D","gene_symbol_current":"EIF2D","gene_id":"ENSG00000143486","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0636598,"nucleus_log2fc":0.0663972,"nucleus_score":1.98132,"pct_ad":0.17759,"pct_control":0.172137,"donor_test":"not significant","donor_padj":0.756003,"donor_log2fc":0.0874983,"donor_lfcse":0.0622283,"donor_log2fc_shrunk":0.0225953}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000143486","entrez_id":["1939"],"uniprot":["P41214"],"ncbi_summary":"This gene encodes a translation initiation factor involved in the recruitment and delivery of aminoacyl-tRNAs to the P-site of the eukaryotic ribosome in a GTP-independent manner. This gene was previously referred to as ligatin, but is now known to localize to the cytoplasm and localize and function with translation factors. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jan 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P41214","text":"Translation initiation factor that is able to deliver tRNA to the P-site of the eukaryotic ribosome in a GTP-independent manner. The binding of Met-tRNA(I) occurs after the AUG codon finds its position in the P-site of 40S ribosomes, the situation that takes place during initiation complex formation on some specific RNAs. Its activity in tRNA binding with 40S subunits does not require the presence of the aminoacyl moiety. Possesses the unique ability to deliver non-Met (elongator) tRNAs into the P-site of the 40S subunit. In addition to its role in initiation, can promote release of deacylated tRNA and mRNA from recycled 40S subunits following ABCE1-mediated dissociation of post-termination ribosomal complexes into subunits."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}