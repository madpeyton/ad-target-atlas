ificant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.34028,"nucleus_log2fc":-0.0888077,"nucleus_score":-1.18235,"pct_ad":0.168562,"pct_control":0.173655,"donor_test":"not significant","donor_padj":0.838489,"donor_log2fc":-0.165354,"donor_lfcse":0.155596,"donor_log2fc_shrunk":-0.00652732}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000184831","module":"brown","kme":0.186806,"hub":false,"module_direction":"lower in AD","module_padj":0.652213,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000184831","module":"turquoise","kme":0.5087,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000184831","module":"turquoise","kme":0.503509,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000184831","module":"turquoise","kme":0.205685,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000184831","module":"turquoise","kme":0.254376,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000184831","entrez_id":["79135"],"uniprot":["Q9BUR5"],"ncbi_summary":"This gene is a member of the apolipoprotein family. Members of this protein family are involved in the transport and metabolism of lipids. The encoded protein associates with HDL, LDL and VLDL lipoproteins and is characterized by chondroitin-sulfate glycosylation. This protein may be involved in preventing lipid accumulation in the myocardium in obese and diabetic patients. Alternative splicing results in multiple transcript variants. Pseudogenes of this gene are found on chromosomes 3, 4, 5, 12 and 16.[provided by RefSeq, Sep 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BUR5","text":"Component of the MICOS complex, a large protein complex of the mitochondrial inner membrane that plays crucial roles in the maintenance of crista junctions, inner membrane architecture, and formation of contact sites to the outer membrane. Plays a crucial role in crista junction formation and mitochondrial function (PubMed:25764979). Can promote cardiac lipotoxicity by enhancing mitochondrial respiration and fatty acid metabolism in cardiac myoblasts (PubMed:24743151). Promotes cholesterol efflux from macrophage cells. Detected in HDL, LDL and VLDL. Secreted by a microsomal triglyceride transfer protein (MTTP)-dependent mechanism, probably as a VLDL-associated protein that is subsequently transferred to HDL (PubMed:16956892)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}