oise","kme":0.0644721,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000162736","module":"turquoise","kme":0.110874,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000162736"],"dataset_symbols":["NCSTN"],"explorer":"explorer.html?dataset=mathys2019#gene/NCSTN","cell_types":[{"cell_type":"Ex","gene_symbol":"NCSTN","gene_symbol_current":"NCSTN","gene_id":"ENSG00000162736","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0424106,"nucleus_log2fc":-0.115475,"nucleus_score":-2.24891,"pct_ad":0.142625,"pct_control":0.153134,"donor_test":"not significant","donor_padj":0.99429,"donor_log2fc":-0.015165,"donor_lfcse":0.0738818,"donor_log2fc_shrunk":-2.87207e-06},{"cell_type":"In","gene_symbol":"NCSTN","gene_symbol_current":"NCSTN","gene_id":"ENSG00000162736","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0691765,"donor_lfcse":0.16904,"donor_log2fc_shrunk":-2.49022e-06},{"cell_type":"Oli","gene_symbol":"NCSTN","gene_symbol_current":"NCSTN","gene_id":"ENSG00000162736","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.815338,"donor_log2fc":0.169434,"donor_lfcse":0.148487,"donor_log2fc_shrunk":0.00738863}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000162736","entrez_id":["23385"],"uniprot":["Q92542"],"ncbi_summary":"This gene encodes a type I transmembrane glycoprotein that is an integral component of the multimeric gamma-secretase complex. The encoded protein cleaves integral membrane proteins, including Notch receptors and beta-amyloid precursor protein, and may be a stabilizing cofactor required for gamma-secretase complex assembly. The cleavage of beta-amyloid precursor protein yields amyloid beta peptide, the main component of the neuritic plaque and the hallmark lesion in the brains of patients with Alzheimer's disease; however, the nature of the encoded protein's role in Alzheimer's disease is not known for certain. Mutations in this gene are associated with familial acne inversa. A pseudogene of this gene is present on chromosome 21. Alternatively spliced transcript variants of this gene have been described, but the full-length nature of some of these variants has not been determined. [provided by RefSeq, Feb 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92542","text":"Essential subunit of the gamma-secretase complex, an endoprotease complex that catalyzes the intramembrane cleavage of integral membrane proteins such as Notch receptors and APP (amyloid-beta precursor protein) (PubMed:10993067, PubMed:12679784, PubMed:25043039, PubMed:26280335, PubMed:30598546, PubMed:30630874). The gamma-secretase complex plays a role in Notch and Wnt signaling cascades and regulation of downstream processes via its role in processing key regulatory proteins, and by regulating cytosolic CTNNB1 levels."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}