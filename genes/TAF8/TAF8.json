n":"higher in AD","nucleus_padj":1.629e-13,"nucleus_log2fc":0.086747,"nucleus_score":7.43433,"pct_ad":0.393486,"pct_control":0.387861,"donor_test":"not significant","donor_padj":0.627686,"donor_log2fc":0.149652,"donor_lfcse":0.0838014,"donor_log2fc_shrunk":0.0211747,"degas_log2fc":0.00374479,"degas_padj":0.689901},{"cell_type":"In","gene_symbol":"TAF8","gene_symbol_current":"TAF8","gene_id":"ENSG00000137413","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0101487,"nucleus_log2fc":-0.028725,"nucleus_score":-2.64675,"pct_ad":0.230482,"pct_control":0.236395,"donor_test":"not significant","donor_padj":0.837392,"donor_log2fc":0.0522929,"donor_lfcse":0.0681654,"donor_log2fc_shrunk":0.00517067,"degas_log2fc":-0.0602694,"degas_padj":0.000115437},{"cell_type":"Mic","gene_symbol":"TAF8","gene_symbol_current":"TAF8","gene_id":"ENSG00000137413","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.443539,"nucleus_log2fc":0.0709606,"nucleus_score":0.939767,"pct_ad":0.162117,"pct_control":0.157834,"donor_test":"not significant","donor_padj":0.810574,"donor_log2fc":0.0799611,"donor_lfcse":0.0927429,"donor_log2fc_shrunk":0.0168963,"degas_log2fc":0.214072,"degas_padj":0.000324581},{"cell_type":"OPC","gene_symbol":"TAF8","gene_symbol_current":"TAF8","gene_id":"ENSG00000137413","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.495424,"nucleus_log2fc":0.0191098,"nucleus_score":0.955943,"pct_ad":0.213093,"pct_control":0.20508,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.042162,"donor_lfcse":0.0790099,"donor_log2fc_shrunk":7.06556e-06,"degas_log2fc":-0.358883,"degas_padj":7.07318e-09},{"cell_type":"Oli","gene_symbol":"TAF8","gene_symbol_current":"TAF8","gene_id":"ENSG00000137413","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":4.44448e-06,"nucleus_log2fc":0.137377,"nucleus_score":4.74485,"pct_ad":0.152373,"pct_control":0.139654,"donor_test":"not significant","donor_padj":0.848074,"donor_log2fc":0.106005,"donor_lfcse":0.102937,"donor_log2fc_shrunk":0.0107014,"degas_log2fc":-0.055028,"degas_padj":0.082029}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000137413","module":"blue","kme":0.0850387,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000137413","entrez_id":["129685"],"uniprot":["Q7Z7C8"],"ncbi_summary":"This gene encodes one of several TATA-binding protein (TBP)-associated factors (TAFs), which are integral subunits of the general transcription factor complex TFIID. TFIID recognizes the core promoter of many genes and nucleates the assembly of a transcription preinitiation complex containing RNA polymerase II and other initiation factors. The protein encoded by this gene contains an H4-like histone fold domain, and interacts with several subunits of TFIID including TBP and the histone-fold protein TAF10. Alternatively spliced transcript variants have been described, but their biological validity has not been determined. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q7Z7C8","text":"The TFIID basal transcription factor complex plays a major role in the initiation of RNA polymerase II (Pol II)-dependent transcription (PubMed:33795473). TFIID recognizes and binds promoters with or without a TATA box via its subunit TBP, a TATA-box-binding protein, and promotes assembly of the pre-initiation complex (PIC) (PubMed:33795473). The TFIID complex consists of TBP and TBP-associated factors (TAFs), including TAF1, TAF2, TAF3, TAF4, TAF5, TAF6, TAF7, TAF8, TAF9, TAF10, TAF11, TAF12 and TAF13 (PubMed:33795473). The TFIID complex structure can be divided into 3 modules TFIID-A, TFIID-B, and TFIID-C (PubMed:33795473). TAF8 is involved in forming the TFIID-B module, together with TAF5 (PubMed:33795473). Mediates both basal and activator-dependent transcription (PubMed:14580349). Plays a role in the differentiation of preadipocyte fibroblasts to adipocytes, however, does not seem to play a role in differentiation of myoblasts (PubMed:14580349). Required for the integration of TAF10 in the TAF complex (PubMed:14580349). May be important for survival of cells of the inner cell mass which constitute the pluripotent cell population of the early embryo (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}