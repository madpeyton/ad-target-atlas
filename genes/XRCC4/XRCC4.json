.111289,"donor_log2fc_shrunk":-0.00433385,"degas_log2fc":-0.347017,"degas_padj":4.5423e-228},{"cell_type":"In","gene_symbol":"XRCC4","gene_symbol_current":"XRCC4","gene_id":"ENSG00000152422","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.85066e-07,"nucleus_log2fc":-0.0361671,"nucleus_score":-5.16676,"pct_ad":0.201871,"pct_control":0.213408,"donor_test":"not significant","donor_padj":0.998467,"donor_log2fc":-0.000810931,"donor_lfcse":0.0743135,"donor_log2fc_shrunk":1.06902e-05,"degas_log2fc":-0.269378,"degas_padj":6.43575e-60},{"cell_type":"Mic","gene_symbol":"XRCC4","gene_symbol_current":"XRCC4","gene_id":"ENSG00000152422","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0185844,"nucleus_log2fc":0.107966,"nucleus_score":2.63139,"pct_ad":0.320056,"pct_control":0.303226,"donor_test":"not significant","donor_padj":0.957715,"donor_log2fc":0.0332851,"donor_lfcse":0.117908,"donor_log2fc_shrunk":0.00451018,"degas_log2fc":-0.233148,"degas_padj":4.20015e-08},{"cell_type":"OPC","gene_symbol":"XRCC4","gene_symbol_current":"XRCC4","gene_id":"ENSG00000152422","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.539032,"nucleus_log2fc":0.059745,"nucleus_score":0.870918,"pct_ad":0.365643,"pct_control":0.362913,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.106422,"donor_lfcse":0.107302,"donor_log2fc_shrunk":9.46213e-06,"degas_log2fc":-0.47946,"degas_padj":6.74417e-25},{"cell_type":"Oli","gene_symbol":"XRCC4","gene_symbol_current":"XRCC4","gene_id":"ENSG00000152422","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.950285,"nucleus_log2fc":0.0309082,"nucleus_score":0.0739924,"pct_ad":0.229614,"pct_control":0.231623,"donor_test":"not significant","donor_padj":0.93178,"donor_log2fc":0.0527629,"donor_lfcse":0.0974109,"donor_log2fc_shrunk":0.00562176,"degas_log2fc":-0.27636,"degas_padj":3.32872e-28}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000152422","module":"blue","kme":0.182836,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000152422","entrez_id":["7518"],"uniprot":["Q13426"],"ncbi_summary":"The protein encoded by this gene functions together with DNA ligase IV and the DNA-dependent protein kinase in the repair of DNA double-strand breaks. This protein plays a role in both non-homologous end joining and the completion of V(D)J recombination. Mutations in this gene can cause short stature, microcephaly, and endocrine dysfunction (SSMED). Alternate transcript variants such as NM_022406 are unlikely to be expressed in some individuals due to a polymorphism (rs1805377) in the last splice acceptor site. [provided by RefSeq, Oct 2019].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13426","text":"[DNA repair protein XRCC4]: DNA non-homologous end joining (NHEJ) core factor, required for double-strand break repair and V(D)J recombination (PubMed:10757784, PubMed:10854421, PubMed:12517771, PubMed:16412978, PubMed:17124166, PubMed:17290226, PubMed:22228831, PubMed:25597996, PubMed:25742519, PubMed:25934149, PubMed:26100018, PubMed:26774286, PubMed:8548796). Acts as a scaffold protein that regulates recruitment of other proteins to DNA double-strand breaks (DSBs) (PubMed:15385968, PubMed:20852255, PubMed:26774286, PubMed:27437582). Associates with NHEJ1/XLF to form alternating helical filaments that bridge DNA and act like a bandage, holding together the broken DNA until it is repaired (PubMed:21768349, PubMed:21775435, PubMed:22287571, PubMed:26100018, PubMed:27437582, PubMed:28500754). The XRCC4-NHEJ1/XLF subcomplex binds to the DNA fragments of a DSB in a highly diffusive manner and robustly bridges two independent DNA molecules, holding the broken DNA fragments in close proximity to one other (PubMed:27437582). The mobility of the bridges ensures that the ends remain accessible for further processing by other repair factors (PubMed:27437582). Plays a key role in the NHEJ ligation step of the broken DNA during DSB repair via direct interaction with DNA ligase IV (LIG4): the LIG4-XRCC4 subcomplex reseals the DNA breaks after the gap filling is completed (PubMed:10757784, PubMed:10854421, PubMed:12517771, PubMed:17290226, PubMed:19837014, PubMed:9242410). XRCC4 stabilizes LIG4, regulates its subcellular localization and enhances LIG4's joining activity (PubMed:10757784, PubMed:10854421, PubMed:12517771, PubMed:17290226, PubMed:21982441, PubMed:22228831, PubMed:9242410). Binding of the LIG4-XRCC4 subcomplex to DNA ends is dependent on the assembly of the DNA-dependent protein kinase complex DNA-PK to these DNA ends (PubMed:10757784, PubMed:10854421). Promotes displacement of PNKP from processed strand break termini (PubMed:20852255, PubMed:28453785). [Protein XRCC4, C-terminus]: Acts as an activator of the phospholipid scramblase activity of XKR4 (PubMed:33725486). This form, which is generated upon caspase-3 (CASP3) cleavage, translocates into the cytoplasm and interacts with XKR4, thereby promoting phosphatidylserine scramblase activity of XKR4 and leading to phosphatidylserine exposure on apoptotic cell surface (PubMed:33725486)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}