ignificant","donor_padj":0.976337,"donor_log2fc":0.0104663,"donor_lfcse":0.0786357,"donor_log2fc_shrunk":0.000954698},{"cell_type":"Mic","gene_symbol":"AGO2","gene_symbol_current":"AGO2","gene_id":"ENSG00000123908","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":3.07647e-06,"nucleus_log2fc":0.214578,"nucleus_score":4.98054,"pct_ad":0.307521,"pct_control":0.277535,"donor_test":"not significant","donor_padj":0.555255,"donor_log2fc":0.19174,"donor_lfcse":0.116063,"donor_log2fc_shrunk":0.0365881},{"cell_type":"OPC","gene_symbol":"AGO2","gene_symbol_current":"AGO2","gene_id":"ENSG00000123908","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.278011,"nucleus_log2fc":0.0451672,"nucleus_score":1.44095,"pct_ad":0.608559,"pct_control":0.602371,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0258179,"donor_lfcse":0.100355,"donor_log2fc_shrunk":2.65534e-06},{"cell_type":"Oli","gene_symbol":"AGO2","gene_symbol_current":"AGO2","gene_id":"ENSG00000123908","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":3.81164e-25,"nucleus_log2fc":0.140998,"nucleus_score":10.5208,"pct_ad":0.643057,"pct_control":0.623806,"donor_test":"not significant","donor_padj":0.862443,"donor_log2fc":0.113618,"donor_lfcse":0.117814,"donor_log2fc_shrunk":0.00819928}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000123908","module":"yellow","kme":0.258646,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000123908","module":"blue","kme":0.106888,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000123908","module":"blue","kme":0.129556,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000123908","module":"brown","kme":0.247743,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000123908","module":"blue","kme":0.283916,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000123908","entrez_id":["27161"],"uniprot":["Q9UKV8"],"ncbi_summary":"This gene encodes a member of the Argonaute family of proteins which play a role in RNA interference. The encoded protein is highly basic, and contains a PAZ domain and a PIWI domain. It may interact with dicer1 and play a role in short-interfering-RNA-mediated gene silencing. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Sep 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UKV8","text":"Required for RNA-mediated gene silencing (RNAi) by the RNA-induced silencing complex (RISC). The 'minimal RISC' appears to include AGO2 bound to a short guide RNA such as a microRNA (miRNA) or short interfering RNA (siRNA). These guide RNAs direct RISC to complementary mRNAs that are targets for RISC-mediated gene silencing. The precise mechanism of gene silencing depends on the degree of complementarity between the miRNA or siRNA and its target. Binding of RISC to a perfectly complementary mRNA generally results in silencing due to endonucleolytic cleavage of the mRNA specifically by AGO2. Binding of RISC to a partially complementary mRNA results in silencing through inhibition of translation, and this is independent of endonuclease activity. May inhibit translation initiation by binding to the 7-methylguanosine cap, thereby preventing the recruitment of the translation initiation factor eIF4-E. May also inhibit translation initiation via interaction with EIF6, which itself binds to the 60S ribosomal subunit and prevents its association with the 40S ribosomal subunit. The inhibition of translational initiation leads to the accumulation of the affected mRNA in cytoplasmic processing bodies (P-bodies), where mRNA degradation may subsequently occur. In some cases RISC-mediated translational repression is also observed for miRNAs that perfectly match the 3' untranslated region (3'-UTR). Can also up-regulate the translation of specific mRNAs under certain growth conditions. Binds to the AU element of the 3'-UTR of the TNF mRNA and up-regulates translation under conditions of serum starvation. Also required for transcriptional gene silencing (TGS), in which short RNAs known as antigene RNAs or agRNAs direct the transcriptional repression of complementary promoter regions. (Microbial infection) Upon Sars-CoV-2 infection, associates with viral miRNA-like small RNA, CoV2-miR-O7a, and may repress mRNAs, such as BATF2, to evade the IFN response."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}