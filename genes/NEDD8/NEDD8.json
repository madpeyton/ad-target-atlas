ype":"Astrocytes","gene_id":"ENSG00000129559","module":"turquoise","kme":0.223652,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2+","gene_id":"ENSG00000129559","module":"turquoise","kme":0.368398,"hub":false,"module_direction":"higher in AD","module_padj":0.789273,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000129559","module":"turquoise","kme":0.394067,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000129559","module":"turquoise","kme":0.257367,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000129559","module":"turquoise","kme":0.183026,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000129559","module":"brown","kme":0.225788,"hub":false,"module_direction":"higher in AD","module_padj":0.137697,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000129559","module":"pink","kme":0.300598,"hub":false,"module_direction":"higher in AD","module_padj":0.104801,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000129559","entrez_id":["4738"],"uniprot":["Q15843"],"ncbi_summary":"Enables ubiquitin protein ligase binding activity. Acts upstream of or within protein neddylation. Located in cytosol and nucleoplasm. Biomarker of Parkinson's disease and malignant astrocytoma. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15843","text":"Ubiquitin-like protein which plays an important role in cell cycle control and embryogenesis via its conjugation to a limited number of cellular proteins, such as cullins or p53/TP53 (PubMed:10318914, PubMed:10597293, PubMed:11953428, PubMed:14690597, PubMed:15242646, PubMed:9694792, PubMed:38605244, PubMed:38316879). Attachment of NEDD8 to cullins is critical for the recruitment of E2 to the cullin-RING-based E3 ubiquitin-protein ligase complex, thus facilitating polyubiquitination and proteasomal degradation of cyclins and other regulatory proteins (PubMed:10318914, PubMed:10597293, PubMed:11953428, PubMed:20688984, PubMed:9694792, PubMed:38605244, PubMed:38316879). Attachment of NEDD8 to p53/TP53 inhibits p53/TP53 transcriptional activity (PubMed:15242646). Covalent attachment to its substrates requires prior activation by the E1 complex UBE1C-APPBP1 and linkage to the E2 enzyme UBE2M (PubMed:14690597). Neddylates EGFR resulting in protein stabilization and translocation to the cell membrane (PubMed:28891468)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}