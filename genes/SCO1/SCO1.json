nt":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00107329,"nucleus_log2fc":-0.242816,"nucleus_score":-3.54508,"pct_ad":0.101585,"pct_control":0.115967,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0858599,"donor_lfcse":0.129176,"donor_log2fc_shrunk":-5.39738e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000133028","module":"turquoise","kme":0.150582,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000133028","module":"turquoise","kme":0.141595,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000133028","entrez_id":["6341"],"uniprot":["O75880"],"ncbi_summary":"Mammalian cytochrome c oxidase (COX) catalyzes the transfer of reducing equivalents from cytochrome c to molecular oxygen and pumps protons across the inner mitochondrial membrane. In yeast, 2 related COX assembly genes, SCO1 and SCO2 (synthesis of cytochrome c oxidase), enable subunits 1 and 2 to be incorporated into the holoprotein. This gene is the human homolog to the yeast SCO1 gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75880","text":"Copper metallochaperone essential for the maturation of cytochrome c oxidase subunit II (MT-CO2/COX2). Together with SCO2, involved in delivering copper to the Cu(A) site on MT-CO2/COX2 (PubMed:15229189, PubMed:15659396, PubMed:16735468, PubMed:17189203, PubMed:19336478). Plays an important role in the regulation of copper homeostasis by controlling the abundance and cell membrane localization of copper transporter CTR1 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}