":"higher in AD","nucleus_padj":9.59868e-06,"nucleus_log2fc":0.334504,"nucleus_score":4.74201,"pct_ad":0.111049,"pct_control":0.090553,"donor_test":"not significant","donor_padj":0.394726,"donor_log2fc":0.273187,"donor_lfcse":0.125741,"donor_log2fc_shrunk":0.0455741,"degas_log2fc":0.111337,"degas_padj":0.16443},{"cell_type":"OPC","gene_symbol":"TRIM65","gene_symbol_current":"TRIM65","gene_id":"ENSG00000141569","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.965973,"nucleus_log2fc":0.0203212,"nucleus_score":0.0727945,"pct_ad":0.114077,"pct_control":0.113633,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0144678,"donor_lfcse":0.108861,"donor_log2fc_shrunk":-1.25244e-06,"degas_log2fc":-0.014578,"degas_padj":0.877927},{"cell_type":"Oli","gene_symbol":"TRIM65","gene_symbol_current":"TRIM65","gene_id":"ENSG00000141569","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000395608,"nucleus_log2fc":0.116778,"nucleus_score":3.68972,"pct_ad":0.125191,"pct_control":0.116078,"donor_test":"not significant","donor_padj":0.79493,"donor_log2fc":0.145062,"donor_lfcse":0.115435,"donor_log2fc_shrunk":0.011651,"degas_log2fc":0.0449019,"degas_padj":0.199497}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000141569","entrez_id":["201292"],"uniprot":["Q6PJ69"],"ncbi_summary":"Predicted to enable zinc ion binding activity. Involved in positive regulation of autophagy. Located in cytosol and nucleoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6PJ69","text":"E3 ubiquitin ligase that plays a role in several processes including innate immnity, autophagy or inflammation (PubMed:28594402, PubMed:34512673). Negatively regulates miRNAs by modulating the ubiquitination and stability of TNRC6A, a protein involved in RNA-mediated gene silencing by both micro-RNAs (miRNAs) and short interfering RNAs (PubMed:24778252). This ubiquitination results in the suppressed expression of miR-138-5p leading to increased autophagy (PubMed:31160576). Upon enteroviral infection, promotes 'Lys-63'-mediated ubiquitination activation of IFIH1/MDA5 leading to innate signaling cascade (PubMed:28594402). Mechanistically, selectively recognizes MDA5 filaments that occur on dsRNAs (PubMed:33373584). Plays also a role in limitation of inflammation through different mechanisms. First, promotes 'Lys-48'-mediated ubiquitination of VCAM1 leading to its degradation and limitation of LPS-induced lung inflammation (PubMed:31310649). In addition, negatively regulates inflammasome activation by promoting 'lys48'-linked ubiquitination of NLRP3 which is critical for the inhibition of NLRP3 inflammasome activation in resting macrophages (PubMed:34512673)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}