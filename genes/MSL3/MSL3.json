odule_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2+","gene_id":"ENSG00000005302","module":"turquoise","kme":0.223515,"hub":false,"module_direction":"higher in AD","module_padj":0.789273,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000005302","module":"turquoise","kme":0.228278,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000005302","module":"turquoise","kme":0.116068,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000005302"],"dataset_symbols":["MSL3"],"explorer":"explorer.html?dataset=mathys2019#gene/MSL3","cell_types":[{"cell_type":"Ex","gene_symbol":"MSL3","gene_symbol_current":"MSL3","gene_id":"ENSG00000005302","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.91543,"nucleus_log2fc":-0.00232386,"nucleus_score":0.137747,"pct_ad":0.146688,"pct_control":0.145637,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.105191,"donor_lfcse":0.128616,"donor_log2fc_shrunk":6.5412e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000005302","module":"turquoise","kme":0.159176,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000005302","entrez_id":["10943"],"uniprot":["Q8N5Y2"],"ncbi_summary":"This gene encodes a nuclear protein that is similar to the product of the Drosophila male-specific lethal-3 gene. The Drosophila protein plays a critical role in a dosage-compensation pathway, which equalizes X-linked gene expression in males and females. Thus, the human protein is thought to play a similar function in chromatin remodeling and transcriptional regulation, and it has been found as part of a complex that is responsible for histone H4 lysine-16 acetylation. This gene can undergo X inactivation. Alternative splicing results in multiple transcript variants. Related pseudogenes have been identified on chromosomes 2, 7 and 8. [provided by RefSeq, Jul 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8N5Y2","text":"Non-catalytic component of the MSL histone acetyltransferase complex, a multiprotein complex that mediates the majority of histone H4 acetylation at 'Lys-16' (H4K16ac), an epigenetic mark that prevents chromatin compaction (PubMed:16227571, PubMed:16543150, PubMed:20018852, PubMed:20657587, PubMed:20943666, PubMed:21217699, PubMed:30224647, PubMed:33837287). The MSL complex is required for chromosome stability and genome integrity by maintaining homeostatic levels of H4K16ac (PubMed:33837287). The MSL complex is also involved in gene dosage by promoting up-regulation of genes expressed by the X chromosome (By similarity). X up-regulation is required to compensate for autosomal biallelic expression (By similarity). The MSL complex also participates in gene dosage compensation by promoting expression of Tsix non-coding RNA (By similarity). Acts as a histone reader that specifically recognizes and binds histone H4 monomethylated at 'Lys-20' (H4K20Me1) in a DNA-dependent manner and is proposed to be involved in chromosomal targeting of the MSL complex (PubMed:20657587, PubMed:20943666). May play a role X inactivation in females (PubMed:21217699)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}