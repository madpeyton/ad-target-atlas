":"lower in AD","nucleus_padj":0.137975,"nucleus_log2fc":-0.0767023,"nucleus_score":-1.5982,"pct_ad":0.100841,"pct_control":0.104164,"donor_test":"not significant","donor_padj":0.867386,"donor_log2fc":-0.065243,"donor_lfcse":0.0706367,"donor_log2fc_shrunk":-0.0126927,"degas_log2fc":-0.221639,"degas_padj":2.51462e-09}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000023041","module":"turquoise","kme":0.0502867,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000023041","entrez_id":["64429"],"uniprot":["Q9H6R6"],"ncbi_summary":"Enables palmitoyltransferase activity. Involved in positive regulation of mitochondrial fusion and protein palmitoylation. Located in endoplasmic reticulum. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H6R6","text":"Endoplasmic reticulum palmitoyl acyltransferase that mediates palmitoylation of proteins such as AMFR, CALX, ITPR1 and TFRC (PubMed:22314232, PubMed:22728137, PubMed:25368151, PubMed:28826475). Palmitoylates calnexin (CALX), which is required for its association with the ribosome-translocon complex and efficient folding of glycosylated proteins (PubMed:22314232). Mediates palmitoylation of AMFR, promoting AMFR distribution to the peripheral endoplasmic reticulum (PubMed:22728137). Together with SELENOK, palmitoylates ITPR1 in immune cells, leading to regulate ITPR1 stability and function (PubMed:25368151). Stearoyltransferase that mediates stearoylation of TFRC to inhibit TFRC-mediated activation of the JNK pathway and mitochondrial fragmentation (PubMed:26214738)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}