leus_direction":"lower in AD","nucleus_padj":0.6314,"nucleus_log2fc":-0.104753,"nucleus_score":-0.966112,"pct_ad":0.22449,"pct_control":0.241379,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":-0.112306,"donor_lfcse":0.129091,"donor_log2fc_shrunk":-0.0013727},{"cell_type":"Oli","gene_symbol":"CTIF","gene_symbol_current":"CTIF","gene_id":"ENSG00000134030","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.495313,"nucleus_log2fc":-0.0670401,"nucleus_score":-0.876417,"pct_ad":0.104493,"pct_control":0.108375,"donor_test":"not significant","donor_padj":0.868589,"donor_log2fc":-0.0931015,"donor_lfcse":0.099582,"donor_log2fc_shrunk":-0.00863418}],"modules":[{"cell_type":"In","gene_id":"ENSG00000134030","module":"red","kme":0.19893,"hub":false,"module_direction":"lower in AD","module_padj":0.737188,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000134030","module":"yellow","kme":0.162025,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000134030","entrez_id":["9811"],"uniprot":["O43310"],"ncbi_summary":"CTIF is a component of the CBP80 (NCBP1; MIM 600469)/CBP20 (NCBP2; MIM 605133) translation initiation complex that binds cotranscriptionally to the cap end of nascent mRNA. The CBP80/CBP20 complex is involved in a simultaneous editing and translation step that recognizes premature termination codons (PTCs) in mRNAs and directs PTC-containing mRNAs toward nonsense-mediated decay (NMD). On mRNAs without PTCs, the CBP80/CBP20 complex is replaced with cytoplasmic mRNA cap-binding proteins, including EIF4G (MIM 600495), and steady-state translation of the mRNAs resumes in the cytoplasm (Kim et al., 2009 [PubMed 19648179]).[supplied by OMIM, Dec 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43310","text":"Specifically required for the pioneer round of mRNA translation mediated by the cap-binding complex (CBC), that takes place during or right after mRNA export via the nuclear pore complex (NPC). Acts via its interaction with the NCBP1/CBP80 component of the CBC complex and recruits the 40S small subunit of the ribosome via eIF3. In contrast, it is not involved in steady state translation, that takes place when the CBC complex is replaced by cytoplasmic cap-binding protein eIF4E. Also required for nonsense-mediated mRNA decay (NMD), the pioneer round of mRNA translation mediated by the cap-binding complex playing a central role in nonsense-mediated mRNA decay (NMD)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}