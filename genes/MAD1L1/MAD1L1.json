r_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0244911,"donor_lfcse":0.114125,"donor_log2fc_shrunk":-1.93149e-06},{"cell_type":"Oli","gene_symbol":"MAD1L1","gene_symbol_current":"MAD1L1","gene_id":"ENSG00000002822","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.471808,"nucleus_log2fc":-6.98471e-06,"nucleus_score":-0.801214,"pct_ad":0.341604,"pct_control":0.34728,"donor_test":"not significant","donor_padj":0.992934,"donor_log2fc":0.00925323,"donor_lfcse":0.130329,"donor_log2fc_shrunk":0.000520085}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000002822","module":"yellow","kme":0.167079,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000002822","module":"blue","kme":0.0929731,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000002822","module":"pink","kme":0.159291,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000002822","module":"blue","kme":0.175735,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000002822","entrez_id":["8379"],"uniprot":["Q9Y6D9"],"ncbi_summary":"MAD1L1 is a component of the mitotic spindle-assembly checkpoint that prevents the onset of anaphase until all chromosome are properly aligned at the metaphase plate. MAD1L1 functions as a homodimer and interacts with MAD2L1. MAD1L1 may play a role in cell cycle control and tumor suppression. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jan 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y6D9","text":"Component of the spindle-assembly checkpoint that prevents the onset of anaphase until all chromosomes are properly aligned at the metaphase plate (PubMed:10049595, PubMed:20133940, PubMed:29162720). Forms a heterotetrameric complex with the closed conformation form of MAD2L1 (C-MAD2) at unattached kinetochores during prometaphase, recruits an open conformation of MAD2L1 (O-MAD2) and promotes the conversion of O-MAD2 to C-MAD2, which ensures mitotic checkpoint signaling (PubMed:29162720). [Isoform 3]: Sequesters MAD2L1 in the cytoplasm preventing its function as an activator of the mitotic spindle assembly checkpoint (SAC) resulting in SAC impairment and chromosomal instability in hepatocellular carcinomas."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}