odule_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000162616","module":"red","kme":0.16595,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000162616","entrez_id":["11080"],"uniprot":["Q9UDY4"],"ncbi_summary":"The protein encoded by this gene is a molecular chaperone, tumor suppressor, and member of the heat shock protein-40 family. The encoded protein binds the cell adhesion protein E-cadherin and targets it to the plasma membrane. This protein also binds incorrectly folded E-cadherin and targets it for endoplasmic reticulum-associated degradation. This gene is a strong tumor suppressor for colorectal carcinoma, and downregulation of it may serve as a good biomarker for predicting patient outcomes. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Nov 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UDY4","text":"Probable chaperone. Stimulates ATP hydrolysis and the folding of unfolded proteins mediated by HSPA1A/B (in vitro) (PubMed:24318877)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}