hrunk":-4.1368e-06},{"cell_type":"Oli","gene_symbol":"EYA2","gene_symbol_current":"EYA2","gene_id":"ENSG00000064655","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.917486,"donor_log2fc":0.136009,"donor_lfcse":0.205718,"donor_log2fc_shrunk":0.00341626}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000064655","module":"yellow","kme":0.396264,"hub":true,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000064655","module":"black","kme":0.409702,"hub":false,"module_direction":"higher in AD","module_padj":0.169392,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000064655","entrez_id":["2139"],"uniprot":["O00167"],"ncbi_summary":"This gene encodes a member of the eyes absent (EYA) family of proteins. The encoded protein may be post-translationally modified and may play a role in eye development. A similar protein in mice can act as a transcriptional activator. Alternative splicing results in multiple transcript variants, but the full-length natures of all of these variants have not yet been determined. [provided by RefSeq, Jul 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00167","text":"Functions both as protein phosphatase and as transcriptional coactivator for SIX1, and probably also for SIX2, SIX4 and SIX5 (PubMed:12500905, PubMed:23435380). Tyrosine phosphatase that dephosphorylates 'Tyr-142' of histone H2AX (H2AXY142ph) and promotes efficient DNA repair via the recruitment of DNA repair complexes containing MDC1. 'Tyr-142' phosphorylation of histone H2AX plays a central role in DNA repair and acts as a mark that distinguishes between apoptotic and repair responses to genotoxic stress (PubMed:19351884). Its function as histone phosphatase may contribute to its function in transcription regulation during organogenesis. Plays an important role in hypaxial muscle development together with SIX1 and DACH2; in this it is functionally redundant with EYA1 (PubMed:12500905)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}