ant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.901907,"nucleus_log2fc":0.0371017,"nucleus_score":0.378654,"pct_ad":0.505324,"pct_control":0.490819,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0452233,"donor_lfcse":0.0694173,"donor_log2fc_shrunk":9.74073e-06},{"cell_type":"OPC","gene_symbol":"MAPRE2","gene_symbol_current":"MAPRE2","gene_id":"ENSG00000166974","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.383559,"nucleus_log2fc":0.227245,"nucleus_score":1.58786,"pct_ad":0.237049,"pct_control":0.212261,"donor_test":"not significant","donor_padj":0.981969,"donor_log2fc":0.171146,"donor_lfcse":0.139627,"donor_log2fc_shrunk":0.00172865},{"cell_type":"Oli","gene_symbol":"MAPRE2","gene_symbol_current":"MAPRE2","gene_id":"ENSG00000166974","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":8.20827e-05,"nucleus_log2fc":0.223684,"nucleus_score":4.34598,"pct_ad":0.247269,"pct_control":0.218448,"donor_test":"not significant","donor_padj":0.754681,"donor_log2fc":0.13829,"donor_lfcse":0.0792402,"donor_log2fc_shrunk":0.0225569}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000166974","module":"turquoise","kme":0.15315,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000166974","module":"yellow","kme":0.245257,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000166974","module":"brown","kme":0.243607,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000166974","entrez_id":["10982"],"uniprot":["Q15555"],"ncbi_summary":"The protein encoded by this gene shares significant homology to the adenomatous polyposis coli (APC) protein-binding EB1 gene family. This protein is a microtubule-associated protein that is necessary for spindle symmetry during mitosis. It is thought to play a role in the tumorigenesis of colorectal cancers and the proliferative control of normal cells. Alternative splicing of this gene results in multiple transcript variants. [provided by RefSeq, Jan 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15555","text":"Adapter protein that is involved in microtubule polymerization, and spindle function by stabilizing microtubules and anchoring them at centrosomes. Therefore, ensures mitotic progression and genome stability (PubMed:27030108). Acts as a central regulator of microtubule reorganization in apico-basal epithelial differentiation (By similarity). Plays a role during oocyte meiosis by regulating microtubule dynamics (By similarity). Participates in neurite growth by interacting with plexin B3/PLXNB3 and microtubule reorganization during apico-basal epithelial differentiation (PubMed:22373814). Also plays an essential role for cell migration and focal adhesion dynamics. Mechanistically, recruits HAX1 to microtubules in order to regulate focal adhesion dynamics (PubMed:26527684)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}