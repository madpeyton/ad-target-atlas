_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.64277e-05,"nucleus_log2fc":-0.207656,"nucleus_score":-4.62257,"pct_ad":0.177164,"pct_control":0.201388,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.106436,"donor_lfcse":0.0992159,"donor_log2fc_shrunk":-1.10921e-05},{"cell_type":"In","gene_symbol":"CINP","gene_symbol_current":"CINP","gene_id":"ENSG00000100865","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.907992,"nucleus_log2fc":-0.168262,"nucleus_score":-0.359561,"pct_ad":0.111801,"pct_control":0.112979,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0756633,"donor_lfcse":0.189072,"donor_log2fc_shrunk":-2.24576e-06},{"cell_type":"Oli","gene_symbol":"CINP","gene_symbol_current":"CINP","gene_id":"ENSG00000100865","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.844933,"donor_log2fc":-0.129881,"donor_lfcse":0.126273,"donor_log2fc_shrunk":-0.00782875}],"modules":[{"cell_type":"In","gene_id":"ENSG00000100865","module":"turquoise","kme":0.194749,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100865","entrez_id":["51550"],"uniprot":["Q9BW66"],"ncbi_summary":"The protein encoded by this gene is reported to be a component of the DNA replication complex as well as a genome-maintenance protein. It may interact with proteins important for replication initiation and has been shown to bind chromatin at the G1 phase of the cell cycle and dissociate from chromatin with replication initiation. It may also serve to regulate checkpoint signaling as part of the DNA damage response. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Feb 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BW66","text":"Component of the DNA replication complex, which interacts with two kinases, CDK2 and CDC7, thereby providing a functional and physical link between CDK2 and CDC7 during firing of the origins of replication (PubMed:16082200, PubMed:19889979). Regulates ATR-mediated checkpoint signaling in response to DNA damage (PubMed:16082200, PubMed:19889979). Part of the 55LCC heterohexameric ATPase complex which is chromatin-associated and promotes replisome proteostasis to maintain replication fork progression and genome stability. Required for replication fork progression, sister chromatid cohesion, and chromosome stability. The ATPase activity is specifically enhanced by replication fork DNA and is coupled to cysteine protease-dependent cleavage of replisome substrates in response to replication fork damage. Uses ATPase activity to process replisome substrates in S-phase, facilitating their proteolytic turnover from chromatin to ensure DNA replication and mitotic fidelity (PubMed:38554706). As part of 55LCC complex, also involved in the cytoplasmic maturation steps of pre-60S ribosomal particles by promoting the release of shuttling protein RSL24D1/RLP24 from the pre-ribosomal particles (PubMed:35354024)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}