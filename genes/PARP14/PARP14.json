,"nucleus_score":-3.4456,"pct_ad":0.592108,"pct_control":0.603917,"donor_test":"not significant","donor_padj":0.847423,"donor_log2fc":-0.110156,"donor_lfcse":0.146756,"donor_log2fc_shrunk":-0.0101942,"degas_log2fc":0.0496975,"degas_padj":0.126856},{"cell_type":"OPC","gene_symbol":"PARP14","gene_symbol_current":"PARP14","gene_id":"ENSG00000173193","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":9.39392e-05,"nucleus_log2fc":-0.236102,"nucleus_score":-4.40928,"pct_ad":0.351775,"pct_control":0.38188,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.191001,"donor_lfcse":0.153941,"donor_log2fc_shrunk":-8.32312e-06,"degas_log2fc":-0.175068,"degas_padj":0.000152982},{"cell_type":"Oli","gene_symbol":"PARP14","gene_symbol_current":"PARP14","gene_id":"ENSG00000173193","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.775505,"donor_log2fc":0.418582,"donor_lfcse":0.312489,"donor_log2fc_shrunk":0.00478736,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000173193","entrez_id":["54625"],"uniprot":["Q460N5"],"ncbi_summary":"This gene encodes a member of the poly(ADP-ribose) polymerase (PARP) protein family. The encoded anti-apoptotic protein may regulate aerobic glycolysis and promote survival of cancer cells. Increased expression of this gene has been reported in a variety of tumor types. [provided by RefSeq, Jul 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q460N5","text":"ADP-ribosyltransferase that mediates mono-ADP-ribosylation of glutamate residues on target proteins (PubMed:16061477, PubMed:18851833, PubMed:25043379, PubMed:27796300). In contrast to PARP1 and PARP2, it is not able to mediate poly-ADP-ribosylation (PubMed:25043379). Has been shown to catalyze the mono-ADP-ribosylation of STAT1 at 'Glu-657' and 'Glu-705', thus decreasing STAT1 phosphorylation which negatively regulates pro-inflammatory cytokine production in macrophages in response to IFNG stimulation (PubMed:27796300). However, the role of ADP-ribosylation in the prevention of STAT1 phosphorylation has been called into question and it has been suggested that the inhibition of phosphorylation may be the result of sumoylation of STAT1 'Lys-703' (PubMed:29858569). Mono-ADP-ribosylates STAT6; enhancing STAT6-dependent transcription (PubMed:27796300). In macrophages, positively regulates MRC1 expression in response to IL4 stimulation by promoting STAT6 phosphorylation (PubMed:27796300). Mono-ADP-ribosylates PARP9 (PubMed:27796300)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}