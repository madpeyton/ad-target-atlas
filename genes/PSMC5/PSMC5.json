":[{"cell_type":"Astrocytes","gene_id":"ENSG00000087191","module":"turquoise","kme":0.134907,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2+","gene_id":"ENSG00000087191","module":"turquoise","kme":0.268841,"hub":false,"module_direction":"higher in AD","module_padj":0.789273,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000087191","module":"turquoise","kme":0.291115,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000087191","module":"turquoise","kme":0.188256,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000087191","module":"turquoise","kme":0.118976,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000087191","module":"pink","kme":0.242397,"hub":false,"module_direction":"higher in AD","module_padj":0.104801,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000087191"],"dataset_symbols":["PSMC5"],"explorer":"explorer.html?dataset=mathys2019#gene/PSMC5","cell_types":[{"cell_type":"Ex","gene_symbol":"PSMC5","gene_symbol_current":"PSMC5","gene_id":"ENSG00000087191","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00263249,"nucleus_log2fc":-0.132737,"nucleus_score":-3.26809,"pct_ad":0.207639,"pct_control":0.225634,"donor_test":"not significant","donor_padj":0.996763,"donor_log2fc":0.023343,"donor_lfcse":0.162991,"donor_log2fc_shrunk":9.29267e-07},{"cell_type":"In","gene_symbol":"PSMC5","gene_symbol_current":"PSMC5","gene_id":"ENSG00000087191","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.358298,"nucleus_log2fc":-0.29691,"nucleus_score":-1.84351,"pct_ad":0.122893,"pct_control":0.137566,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.161273,"donor_lfcse":0.211492,"donor_log2fc_shrunk":-3.7849e-06},{"cell_type":"Oli","gene_symbol":"PSMC5","gene_symbol_current":"PSMC5","gene_id":"ENSG00000087191","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.858119,"donor_log2fc":0.2175,"donor_lfcse":0.224617,"donor_log2fc_shrunk":0.00417613}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000087191","module":"turquoise","kme":0.350488,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000087191","module":"turquoise","kme":0.269185,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000087191","module":"turquoise","kme":0.0871291,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000087191","entrez_id":["5705"],"uniprot":["P62195"],"ncbi_summary":"The 26S proteasome is a multicatalytic proteinase complex with a highly ordered structure composed of 2 complexes, a 20S core and a 19S regulator. The 20S core is composed of 4 rings of 28 non-identical subunits; 2 rings are composed of 7 alpha subunits and 2 rings are composed of 7 beta subunits. The 19S regulator is composed of a base, which contains 6 ATPase subunits and 2 non-ATPase subunits, and a lid, which contains up to 10 non-ATPase subunits. Proteasomes are distributed throughout eukaryotic cells at a high concentration and cleave peptides in an ATP/ubiquitin-dependent process in a non-lysosomal pathway. An essential function of a modified proteasome, the immunoproteasome, is the processing of class I MHC peptides. This gene encodes one of the ATPase subunits, a member of the triple-A family of ATPases which have a chaperone-like activity. In addition to participation in proteasome functions, this subunit may participate in transcriptional regulation since it has been shown to interact with the thyroid hormone receptor and retinoid X receptor-alpha. Two transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Nov 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P62195","text":"Component of the 26S proteasome, a multiprotein complex involved in the ATP-dependent degradation of ubiquitinated proteins (PubMed:38776958, PubMed:41298377). This complex plays a key role in the maintenance of protein homeostasis by removing misfolded or damaged proteins, which could impair cellular functions, and by removing proteins whose functions are no longer required. Therefore, the proteasome participates in numerous cellular processes, including cell cycle progression, apoptosis, or DNA damage repair. PSMC5 belongs to the heterohexameric ring of AAA (ATPases associated with diverse cellular activities) proteins that unfolds ubiquitinated target proteins that are concurrently translocated into a proteolytic chamber and degraded into peptides."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}