:-0.149164,"nucleus_score":-3.38253,"pct_ad":0.382493,"pct_control":0.409992,"donor_test":"not significant","donor_padj":0.932221,"donor_log2fc":-0.179594,"donor_lfcse":0.0608003,"donor_log2fc_shrunk":-0.115842,"degas_log2fc":0.00497871,"degas_padj":0.918535},{"cell_type":"Oli","gene_symbol":"GLMN","gene_symbol_current":"GLMN","gene_id":"ENSG00000174842","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":8.27931e-07,"nucleus_log2fc":-0.12717,"nucleus_score":-5.08519,"pct_ad":0.165574,"pct_control":0.180314,"donor_test":"not significant","donor_padj":0.927821,"donor_log2fc":-0.0409892,"donor_lfcse":0.0711719,"donor_log2fc_shrunk":-0.00742826,"degas_log2fc":-0.157396,"degas_padj":3.91325e-08}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000174842","module":"turquoise","kme":0.0806876,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000174842","entrez_id":["11146"],"uniprot":["Q92990"],"ncbi_summary":"This gene encodes a phosphorylated protein that is a member of a Skp1-Cullin-F-box-like complex. The protein is essential for normal development of the vasculature and mutations in this gene have been associated with glomuvenous malformations, also called glomangiomas. Multiple splice variants encoding different isoforms have been found for this gene. [provided by RefSeq, Feb 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92990","text":"[Isoform 1]: Regulatory component of cullin-RING-based SCF (SKP1-Cullin-F-box protein) E3 ubiquitin-protein ligase complexes (PubMed:22405651, PubMed:22748924). Inhibits E3 ubiquitin ligase activity by binding to RBX1 (via RING domain) and inhibiting its interaction with the E2 ubiquitin-conjugating enzyme CDC34 (PubMed:22405651, PubMed:22748924). Inhibits RBX1-mediated neddylation of CUL1 (PubMed:22405651). Required for normal stability and normal cellular levels of key components of SCF ubiquitin ligase complexes, including FBXW7, RBX1, CUL1, CUL2, CUL3, CUL4A, and thereby contributes to the regulation of CCNE1 and MYC levels (By similarity). Essential for normal development of the vasculature (PubMed:11845407). Contributes to the regulation of RPS6KB1 phosphorylation (PubMed:11571281)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}