not significant","donor_padj":0.999342,"donor_log2fc":0.0617753,"donor_lfcse":0.131125,"donor_log2fc_shrunk":3.78261e-06},{"cell_type":"Oli","gene_symbol":"PSPH","gene_symbol_current":"PSPH","gene_id":"ENSG00000146733","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":9.28461e-06,"nucleus_log2fc":0.120432,"nucleus_score":4.58758,"pct_ad":0.176782,"pct_control":0.163398,"donor_test":"not significant","donor_padj":0.753837,"donor_log2fc":0.147049,"donor_lfcse":0.103807,"donor_log2fc_shrunk":0.0173649}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000146733","entrez_id":["5723"],"uniprot":["P78330"],"ncbi_summary":"The protein encoded by this gene belongs to a subfamily of the phosphotransferases. This encoded enzyme is responsible for the third and last step in L-serine formation. It catalyzes magnesium-dependent hydrolysis of L-phosphoserine and is also involved in an exchange reaction between L-serine and L-phosphoserine. Deficiency of this protein is thought to be linked to Williams syndrome. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P78330","text":"Catalyzes the last irreversible step in the biosynthesis of L-serine from carbohydrates, the dephosphorylation of O-phospho-L-serine to L-serine (PubMed:12213811, PubMed:14673469, PubMed:15291819, PubMed:25080166, PubMed:9222972). L-serine can then be used in protein synthesis, to produce other amino acids, in nucleotide metabolism or in glutathione synthesis, or can be racemized to D-serine, a neuromodulator (PubMed:14673469). May also act on O-phospho-D-serine (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}