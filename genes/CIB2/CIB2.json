ant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.984302,"donor_log2fc":0.00832231,"donor_lfcse":0.11301,"donor_log2fc_shrunk":0.000518828,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"CIB2","gene_symbol_current":"CIB2","gene_id":"ENSG00000136425","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000148466,"nucleus_log2fc":-0.0701571,"nucleus_score":-3.87721,"pct_ad":0.100168,"pct_control":0.105918,"donor_test":"not significant","donor_padj":0.959053,"donor_log2fc":0.0144511,"donor_lfcse":0.0677821,"donor_log2fc_shrunk":0.00136423,"degas_log2fc":0.0272063,"degas_padj":0.273286},{"cell_type":"OPC","gene_symbol":"CIB2","gene_symbol_current":"CIB2","gene_id":"ENSG00000136425","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.156398,"donor_lfcse":0.16754,"donor_log2fc_shrunk":-5.72808e-06,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136425","entrez_id":["10518"],"uniprot":["O75838"],"ncbi_summary":"The protein encoded by this gene is similar to that of KIP/CIB, calcineurin B, and calmodulin. The encoded protein is a calcium-binding regulatory protein that interacts with DNA-dependent protein kinase catalytic subunits (DNA-PKcs), and it is involved in photoreceptor cell maintenance. Mutations in this gene cause deafness, autosomal recessive, 48 (DFNB48), and also Usher syndrome 1J (USH1J). Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jul 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75838","text":"Calcium- and integrin-binding protein that plays a role in intracellular calcium homeostasis (By similarity). Acts as an auxiliary subunit of the sensory mechanoelectrical transduction (MET) channel in hair cells (By similarity). Essential for mechanoelectrical transduction (MET) currents in auditory hair cells and thereby required for hearing (By similarity). Regulates the function of hair cell mechanotransduction by controlling the distribution of transmembrane channel-like proteins TMC1 and TMC2, and by regulating the function of the MET channels in hair cells (By similarity). Required for the maintenance of auditory hair cell stereocilia bundle morphology and function and for hair-cell survival in the cochlea (By similarity). Critical for proper photoreceptor cell maintenance and function (By similarity). Plays a role in intracellular calcium homeostasis by decreasing ATP-induced calcium release (PubMed:23023331, PubMed:26173970, PubMed:26426422)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}