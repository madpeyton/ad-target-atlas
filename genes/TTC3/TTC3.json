e":0.0599096,"donor_log2fc_shrunk":2.37433e-05},{"cell_type":"Mic","gene_symbol":"TTC3","gene_symbol_current":"TTC3","gene_id":"ENSG00000182670","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.287159,"nucleus_log2fc":0.345369,"nucleus_score":1.82446,"pct_ad":0.220172,"pct_control":0.183521,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"TTC3","gene_symbol_current":"TTC3","gene_id":"ENSG00000182670","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.44887,"nucleus_log2fc":0.141599,"nucleus_score":1.41597,"pct_ad":0.517268,"pct_control":0.495019,"donor_test":"not significant","donor_padj":0.986209,"donor_log2fc":0.0567731,"donor_lfcse":0.0827918,"donor_log2fc_shrunk":0.00166884},{"cell_type":"Oli","gene_symbol":"TTC3","gene_symbol_current":"TTC3","gene_id":"ENSG00000182670","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000136828,"nucleus_log2fc":0.218046,"nucleus_score":4.21578,"pct_ad":0.247832,"pct_control":0.220677,"donor_test":"not significant","donor_padj":0.541008,"donor_log2fc":0.223128,"donor_lfcse":0.0746147,"donor_log2fc_shrunk":0.157731}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000182670","module":"blue","kme":0.264622,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000182670","module":"blue","kme":0.116761,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000182670","entrez_id":["7267"],"uniprot":["P53804"],"ncbi_summary":"Enables ubiquitin-protein transferase activity. Involved in protein K48-linked ubiquitination and ubiquitin-dependent protein catabolic process. Located in cytosol; nucleolus; and nucleoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P53804","text":"E3 ubiquitin-protein ligase which catalyzes the formation of 'Lys-48'-polyubiquitin chains (PubMed:20059950, PubMed:30696809). Mediates the ubiquitination and subsequent degradation of phosphorylated Akt (AKT1, AKT2 and AKT3) in the nucleus (PubMed:20059950). Acts as a terminal regulator of Akt signaling after activation; its phosphorylation by Akt, which is a prerequisite for ubiquitin ligase activity, suggests the existence of a regulation mechanism required to control Akt levels after activation (PubMed:20059950). Positively regulates TGFB1-induced epithelial-mesenchymal transition and myofibroblast differentiation by mediating the ubiquitination and subsequent degradation of SMURF2 (PubMed:30696809). Regulates neuronal differentiation by regulating actin remodeling and Golgi organization via a signaling cascade involving RHOA, CIT and ROCK (PubMed:17488780, PubMed:24695496). Inhibits cell proliferation (PubMed:30203323)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}