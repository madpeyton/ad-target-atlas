_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.42022,"donor_log2fc":-0.569867,"donor_lfcse":0.20022,"donor_log2fc_shrunk":-0.0174997}],"modules":[{"cell_type":"In","gene_id":"ENSG00000099957","module":"blue","kme":0.220486,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000099957","module":"blue","kme":0.101523,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000099957","entrez_id":["9127"],"uniprot":["O15547"],"ncbi_summary":"The protein encoded by this gene belongs to the family of P2X receptors, which are ATP-gated ion channels and mediate rapid and selective permeability to cations. This gene is predominantly expressed in skeletal muscle, and regulated by p53. The encoded protein is associated with VE-cadherin at the adherens junctions of human umbilical vein endothelial cells. Alternative splicing results in multiple transcript variants. A related pseudogene, which is also located on chromosome 22, has been identified. [provided by RefSeq, Apr 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O15547","text":"May act as a modulatory subunit rather than a functional channel. Unlike other P2XRs members, P2RX6 does not seem to form functional homotrimers (PubMed:22378790). P2RX6 requires the presence of P2RX4 or P2RX2 to shuttle it to the plasma membrane where it may form functional heterotrimeric receptors at the plasma membrane (PubMed:22378790). P2RX6 can be translocated to the nucleus and functions as a nuclear regulator of post-transcriptional modifications in neurons (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}