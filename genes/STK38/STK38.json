l_type":"In","gene_id":"ENSG00000112079","module":"yellow","kme":0.186701,"hub":false,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000112079","module":"blue","kme":0.13221,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000112079","entrez_id":["11329"],"uniprot":["Q15208"],"ncbi_summary":"This gene encodes a member of the AGC serine/threonine kinase family of proteins. The kinase activity of this protein is regulated by autophosphorylation and phosphorylation by other upstream kinases. This protein has been shown to function in the cell cycle and apoptosis. This protein has also been found to regulate the protein stability and transcriptional activity of the MYC oncogene. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Feb 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15208","text":"Serine/threonine-protein kinase that acts as a negative regulator of MAP3K1/2 signaling (PubMed:12493777, PubMed:15197186, PubMed:17906693, PubMed:7761441). Converts MAP3K2 from its phosphorylated form to its non-phosphorylated form and inhibits autophosphorylation of MAP3K2 (PubMed:12493777, PubMed:15197186, PubMed:17906693, PubMed:7761441). Acts as an ufmylation 'reader' in a kinase-independent manner: specifically recognizes and binds mono-ufmylated histone H4 in response to DNA damage, promoting the recruitment of SUV39H1 to the double-strand breaks, resulting in ATM activation (PubMed:32537488)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}