06,"degas_padj":8.65299e-17}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000166181","module":"red","kme":0.146486,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000166181","entrez_id":["8539"],"uniprot":["Q9BZZ5"],"ncbi_summary":"This gene encodes an apoptosis inhibitory protein whose expression prevents apoptosis after growth factor deprivation. This protein suppresses the transcription factor E2F1-induced apoptosis and also interacts with, and negatively regulates Acinus, a nuclear factor involved in apoptotic DNA fragmentation. Its depletion enhances the cytotoxic action of the chemotherapeutic drugs. Multiple alternatively spliced transcript variants encoding different isoforms have been identified. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BZZ5","text":"Antiapoptotic factor that may have a role in protein assembly. Negatively regulates ACIN1. By binding to ACIN1, it suppresses ACIN1 cleavage from CASP3 and ACIN1-mediated DNA fragmentation. Also known to efficiently suppress E2F1-induced apoptosis. Its depletion enhances the cytotoxic action of the chemotherapeutic drugs."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}