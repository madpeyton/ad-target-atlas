184e-17},{"cell_type":"Mic","gene_symbol":"DGKQ","gene_symbol_current":"DGKQ","gene_id":"ENSG00000145214","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.694387,"donor_log2fc":-0.19195,"donor_lfcse":0.154769,"donor_log2fc_shrunk":-0.0166333,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"DGKQ","gene_symbol_current":"DGKQ","gene_id":"ENSG00000145214","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0129393,"donor_lfcse":0.132109,"donor_log2fc_shrunk":7.6793e-07,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"DGKQ","gene_symbol_current":"DGKQ","gene_id":"ENSG00000145214","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.927886,"donor_log2fc":-0.0638835,"donor_lfcse":0.111987,"donor_log2fc_shrunk":-0.00521382,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000145214","module":"turquoise","kme":0.0067687,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000145214","entrez_id":["1609"],"uniprot":["P52824"],"ncbi_summary":"The protein encoded by this gene contains three cysteine-rich domains, a proline-rich region, and a pleckstrin homology domain with an overlapping Ras-associating domain. It is localized in the speckle domains of the nucleus, and mediates the regeneration of phosphatidylinositol (PI) from diacylglycerol in the PI-cycle during cell signal transduction. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P52824","text":"Diacylglycerol kinase that converts diacylglycerol/DAG into phosphatidic acid/phosphatidate/PA and regulates the respective levels of these two bioactive lipids (PubMed:11309392, PubMed:22627129, PubMed:9099683). Thereby, acts as a central switch between the signaling pathways activated by these second messengers with different cellular targets and opposite effects in numerous biological processes (PubMed:11309392, PubMed:17664281, PubMed:26748701). Within the adrenocorticotropic hormone signaling pathway, produces phosphatidic acid which in turn activates NR5A1 and subsequent steroidogenic gene transcription (PubMed:17664281). Also functions downstream of the nerve growth factor signaling pathway being specifically activated in the nucleus by the growth factor (By similarity). Through its diacylglycerol activity also regulates synaptic vesicle endocytosis (PubMed:26748701)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}