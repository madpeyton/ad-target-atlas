b":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000168924"],"dataset_symbols":["LETM1"],"explorer":"explorer.html?dataset=mathys2019#gene/LETM1","cell_types":[{"cell_type":"Ex","gene_symbol":"LETM1","gene_symbol_current":"LETM1","gene_id":"ENSG00000168924","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.415667,"nucleus_log2fc":0.0199732,"nucleus_score":-0.953879,"pct_ad":0.191182,"pct_control":0.198357,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.115104,"donor_lfcse":0.0949961,"donor_log2fc_shrunk":1.45718e-05},{"cell_type":"In","gene_symbol":"LETM1","gene_symbol_current":"LETM1","gene_id":"ENSG00000168924","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.787592,"nucleus_log2fc":-0.128476,"nucleus_score":-0.722774,"pct_ad":0.0958296,"pct_control":0.101152,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.199453,"donor_lfcse":0.153047,"donor_log2fc_shrunk":-8.96781e-06},{"cell_type":"Oli","gene_symbol":"LETM1","gene_symbol_current":"LETM1","gene_id":"ENSG00000168924","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.910879,"donor_log2fc":-0.104987,"donor_lfcse":0.153642,"donor_log2fc_shrunk":-0.00425742}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000168924","entrez_id":["3954"],"uniprot":["O95202"],"ncbi_summary":"This gene encodes a protein that is localized to the inner mitochondrial membrane. The protein functions to maintain the mitochondrial tubular shapes and is required for normal mitochondrial morphology and cellular viability. Mutations in this gene cause Wolf-Hirschhorn syndrome, a complex malformation syndrome caused by the deletion of parts of the distal short arm of chromosome 4. Related pseudogenes have been identified on chromosomes 8, 15 and 19. [provided by RefSeq, Oct 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95202","text":"Plays an important role in maintenance of mitochondrial morphology and in mediating either calcium or potassium/proton antiport (PubMed:18628306, PubMed:19797662, PubMed:24344246, PubMed:24898248, PubMed:29123128, PubMed:32139798, PubMed:36055214, PubMed:36321428). Mediates proton-dependent calcium efflux from mitochondrion (PubMed:19797662, PubMed:24344246, PubMed:29123128). Also functions as an electroneutral mitochondrial proton/potassium exchanger (PubMed:24898248, PubMed:36055214, PubMed:36321428). Crucial for the maintenance of mitochondrial tubular networks and for the assembly of the supercomplexes of the respiratory chain (PubMed:18628306, PubMed:36055214). Required for the maintenance of the tubular shape and cristae organization (PubMed:18628306, PubMed:32139798)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}