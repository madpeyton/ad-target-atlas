icant","donor_padj":0.999342,"donor_log2fc":-0.0955719,"donor_lfcse":0.110991,"donor_log2fc_shrunk":-8.0771e-06,"degas_log2fc":-0.493001,"degas_padj":3.33696e-65},{"cell_type":"Oli","gene_symbol":"WWP2","gene_symbol_current":"WWP2","gene_id":"ENSG00000198373","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.631683,"nucleus_log2fc":0.0130373,"nucleus_score":0.542916,"pct_ad":0.470897,"pct_control":0.472603,"donor_test":"not significant","donor_padj":0.984184,"donor_log2fc":0.0129584,"donor_lfcse":0.0972474,"donor_log2fc_shrunk":0.00183425,"degas_log2fc":-0.285589,"degas_padj":6.89736e-64}],"modules":[{"cell_type":"In","gene_id":"ENSG00000198373","module":"blue","kme":0.180378,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000198373","module":"blue","kme":0.156623,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198373","entrez_id":["11060"],"uniprot":["O00308"],"ncbi_summary":"This gene encodes a member of the Nedd4 family of E3 ligases, which play an important role in protein ubiquitination. The encoded protein contains four WW domains and may play a role in multiple processes including chondrogenesis and the regulation of oncogenic signaling pathways via interactions with Smad proteins and the tumor suppressor PTEN. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene, and a pseudogene of this gene is located on the long arm of chromosome 10. [provided by RefSeq, Jul 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00308","text":"E3 ubiquitin-protein ligase which accepts ubiquitin from an E2 ubiquitin-conjugating enzyme in the form of a thioester and then directly transfers the ubiquitin to targeted substrates. Polyubiquitinates POU5F1 by 'Lys-63'-linked conjugation and promotes it to proteasomal degradation; in embryonic stem cells (ESCs) the ubiquitination is proposed to regulate POU5F1 protein level. Ubiquitinates EGR2 and promotes it to proteasomal degradation; in T-cells the ubiquitination inhibits activation-induced cell death. Ubiquitinates SLC11A2; the ubiquitination is enhanced by presence of NDFIP1 and NDFIP2. Ubiquitinates RPB1 and promotes it to proteasomal degradation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}