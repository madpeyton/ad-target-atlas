:-0.0847096,"nucleus_score":-7.67896,"pct_ad":0.281794,"pct_control":0.299046,"donor_test":"not significant","donor_padj":0.906319,"donor_log2fc":-0.0191375,"donor_lfcse":0.0422333,"donor_log2fc_shrunk":-0.00146735,"degas_log2fc":-0.0206236,"degas_padj":0.137627},{"cell_type":"Mic","gene_symbol":"ZDHHC15","gene_symbol_current":"ZDHHC15","gene_id":"ENSG00000102383","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.899329,"donor_log2fc":-0.11818,"donor_lfcse":0.210893,"donor_log2fc_shrunk":-0.00540491,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"ZDHHC15","gene_symbol_current":"ZDHHC15","gene_id":"ENSG00000102383","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.735037,"nucleus_log2fc":0.0323075,"nucleus_score":0.517805,"pct_ad":0.227856,"pct_control":0.223539,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0348647,"donor_lfcse":0.0641916,"donor_log2fc_shrunk":8.85088e-06,"degas_log2fc":-0.228733,"degas_padj":0.000139653},{"cell_type":"Oli","gene_symbol":"ZDHHC15","gene_symbol_current":"ZDHHC15","gene_id":"ENSG00000102383","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.991009,"donor_log2fc":0.00916892,"donor_lfcse":0.112619,"donor_log2fc_shrunk":0.00012421,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000102383","entrez_id":["158866"],"uniprot":["Q96MV8"],"ncbi_summary":"The protein encoded by this gene belongs to the DHHC palmitoyltransferase family. Mutations in this gene are associated with mental retardatio X-linked type 91 (MRX91). Alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Sep 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96MV8","text":"Palmitoyltransferase that catalyzes the addition of palmitate onto various protein substrates (PubMed:18817523, PubMed:23034182). Has no stringent fatty acid selectivity and in addition to palmitate can also transfer onto target proteins myristate from tetradecanoyl-CoA and stearate from octadecanoyl-CoA (By similarity). Palmitoylates IGF2R and SORT1, promoting their partitioning to an endosomal membrane subdomain where they can interact with the retromer cargo-selective complex (PubMed:18817523). Thereby, regulates retrograde transport from endosomes to the Golgi apparatus of these lysosomal sorting receptors and plays a role in trafficking of lysosomal proteins (PubMed:18817523). In the nervous system, catalyzes the palmitoylation of DLG4/PSD95 and regulates its synaptic clustering and function in synaptogenesis (By similarity). Could be involved in the differentiation of dopaminergic neurons and the development of the diencephalon (By similarity). Could also catalyze the palmitoylation of GAP43 (By similarity). Could also palmitoylate DNAJC5 and regulate its localization to the Golgi membrane (By similarity). Could also palmitoylate FYN as shown in vitro (PubMed:19956733). May palmitoylate CALHM3 subunit of gustatory voltage-gated ion channels and modulate channel gating and kinetics."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}