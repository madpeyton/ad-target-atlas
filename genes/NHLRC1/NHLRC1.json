orer":"explorer.html?dataset=seaad_pfc#gene/NHLRC1","cell_types":[{"cell_type":"Ex","gene_symbol":"NHLRC1","gene_symbol_current":"NHLRC1","gene_id":"ENSG00000187566","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.919446,"donor_log2fc":0.0390907,"donor_lfcse":0.117723,"donor_log2fc_shrunk":0.00226339,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"NHLRC1","gene_symbol_current":"NHLRC1","gene_id":"ENSG00000187566","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985132,"donor_log2fc":-0.0114049,"donor_lfcse":0.1358,"donor_log2fc_shrunk":-0.000414158,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"NHLRC1","gene_symbol_current":"NHLRC1","gene_id":"ENSG00000187566","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.992934,"donor_log2fc":-0.0127346,"donor_lfcse":0.18683,"donor_log2fc_shrunk":-0.00038504,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000187566","entrez_id":["378884"],"uniprot":["Q6VVB1"],"ncbi_summary":"The protein encoded by this gene is a single subunit E3 ubiquitin ligase. Laforin is polyubiquitinated by the encoded protein. Defects in this intronless gene lead to an accumulation of laforin and onset of Lafora disease, also known as progressive myoclonic epilepsy type 2 (EPM2).[provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6VVB1","text":"E3 ubiquitin-protein ligase. Together with the phosphatase EPM2A/laforin, appears to be involved in the clearance of toxic polyglucosan and protein aggregates via multiple pathways. In complex with EPM2A/laforin and HSP70, suppresses the cellular toxicity of misfolded proteins by promoting their degradation through the ubiquitin-proteasome system (UPS). Ubiquitinates the glycogen-targeting protein phosphatase subunits PPP1R3C/PTG and PPP1R3D in a laforin-dependent manner and targets them for proteasome-dependent degradation, thus decreasing glycogen accumulation. Polyubiquitinates EPM2A/laforin and ubiquitinates AGL and targets them for proteasome-dependent degradation. Also promotes proteasome-independent protein degradation through the macroautophagy pathway."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}