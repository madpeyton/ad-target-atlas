blue","kme":0.0515095,"hub":false,"module_direction":"lower in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000149485"],"dataset_symbols":["FADS1"],"explorer":"explorer.html?dataset=mathys2019#gene/FADS1","cell_types":[{"cell_type":"Ast","gene_symbol":"FADS1","gene_symbol_current":"FADS1","gene_id":"ENSG00000149485","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0104421,"nucleus_log2fc":-0.451177,"nucleus_score":-3.12388,"pct_ad":0.0914634,"pct_control":0.12622,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Ex","gene_symbol":"FADS1","gene_symbol_current":"FADS1","gene_id":"ENSG00000149485","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.24004e-05,"nucleus_log2fc":-0.230058,"nucleus_score":-4.55083,"pct_ad":0.1346,"pct_control":0.155926,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.100587,"donor_lfcse":0.102773,"donor_log2fc_shrunk":-9.92174e-06},{"cell_type":"In","gene_symbol":"FADS1","gene_symbol_current":"FADS1","gene_id":"ENSG00000149485","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.946493,"nucleus_log2fc":-0.0971017,"nucleus_score":-0.230252,"pct_ad":0.139308,"pct_control":0.139122,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0914162,"donor_lfcse":0.169297,"donor_log2fc_shrunk":-3.32422e-06},{"cell_type":"Oli","gene_symbol":"FADS1","gene_symbol_current":"FADS1","gene_id":"ENSG00000149485","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000549212,"nucleus_log2fc":0.262512,"nucleus_score":3.84586,"pct_ad":0.103592,"pct_control":0.0865089,"donor_test":"not significant","donor_padj":0.868589,"donor_log2fc":0.143061,"donor_lfcse":0.156747,"donor_log2fc_shrunk":0.00559837}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000149485","module":"turquoise","kme":0.0997181,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000149485","entrez_id":["3992"],"uniprot":["O60427"],"ncbi_summary":"The protein encoded by this gene is a member of the fatty acid desaturase (FADS) gene family. Desaturase enzymes regulate unsaturation of fatty acids through the introduction of double bonds between defined carbons of the fatty acyl chain. FADS family members are considered fusion products composed of an N-terminal cytochrome b5-like domain and a C-terminal multiple membrane-spanning desaturase portion, both of which are characterized by conserved histidine motifs. This gene is clustered with family members FADS1 and FADS2 at 11q12-q13.1; this cluster is thought to have arisen evolutionarily from gene duplication based on its similar exon/intron organization. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60427","text":"[Isoform 1]: Acts as a front-end fatty acyl-coenzyme A (CoA) desaturase that introduces a cis double bond at carbon 5 located between a preexisting double bond and the carboxyl end of the fatty acyl chain. Involved in biosynthesis of highly unsaturated fatty acids (HUFA) from the essential polyunsaturated fatty acids (PUFA) linoleic acid (LA) (18:2n-6) and alpha-linolenic acid (ALA) (18:3n-3) precursors. Specifically, desaturates dihomo-gamma-linoleoate (DGLA) (20:3n-6) and eicosatetraenoate (ETA) (20:4n-3) to generate arachidonate (AA) (20:4n-6) and eicosapentaenoate (EPA) (20:5n-3), respectively (PubMed:10601301, PubMed:10769175). As a rate limiting enzyme for DGLA (20:3n-6) and AA (20:4n-6)-derived eicosanoid biosynthesis, controls the metabolism of inflammatory lipids like prostaglandin E2, critical for efficient acute inflammatory response and maintenance of epithelium homeostasis. Contributes to membrane phospholipid biosynthesis by providing AA (20:4n-6) as a major acyl chain esterified into phospholipids. In particular, regulates phosphatidylinositol-4,5-bisphosphate levels, modulating inflammatory cytokine production in T-cells (By similarity). Also desaturates (11E)-octadecenoate (trans-vaccenoate)(18:1n-9), a metabolite in the biohydrogenation pathway of LA (18:2n-6) (By similarity). [Isoform 2]: Does not exhibit any catalytic activity toward 20:3n-6, but it may enhance FADS2 activity."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}