sted","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"DYNC1I2","gene_symbol_current":"DYNC1I2","gene_id":"ENSG00000077380","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.510208,"nucleus_log2fc":0.0222884,"nucleus_score":0.850553,"pct_ad":0.187591,"pct_control":0.180129,"donor_test":"not significant","donor_padj":0.972691,"donor_log2fc":0.0195286,"donor_lfcse":0.108519,"donor_log2fc_shrunk":0.00141124}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000077380","entrez_id":["1781"],"uniprot":["Q13409"],"ncbi_summary":"This gene encodes a member of the dynein intermediate chain family. The encoded protein is a non-catalytic component of the cytoplasmic dynein 1 complex, which acts as a retrograde microtubule motor to transport organelles and vesicles. A pseudogene of this gene is located on chromosome 10. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Nov 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13409","text":"Acts as one of several non-catalytic accessory components of the cytoplasmic dynein 1 complex that are thought to be involved in linking dynein to cargos and to adapter proteins that regulate dynein function (PubMed:31079899). Cytoplasmic dynein 1 acts as a motor for the intracellular retrograde motility of vesicles and organelles along microtubules (PubMed:31079899). The intermediate chains mediate the binding of dynein to dynactin via its 150 kDa component (p150-glued) DCTN1 (By similarity). Involved in membrane-transport, such as Golgi apparatus, late endosomes and lysosomes (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}