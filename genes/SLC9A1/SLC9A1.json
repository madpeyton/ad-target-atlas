e":"turquoise","kme":0.0577102,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000090020"],"dataset_symbols":["SLC9A1"],"explorer":"explorer.html?dataset=mathys2019#gene/SLC9A1","cell_types":[{"cell_type":"Ex","gene_symbol":"SLC9A1","gene_symbol_current":"SLC9A1","gene_id":"ENSG00000090020","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0490265,"nucleus_log2fc":-0.0276569,"nucleus_score":-2.18534,"pct_ad":0.183462,"pct_control":0.197559,"donor_test":"not significant","donor_padj":0.996763,"donor_log2fc":-0.0119067,"donor_lfcse":0.0897386,"donor_log2fc_shrunk":-4.61621e-07},{"cell_type":"In","gene_symbol":"SLC9A1","gene_symbol_current":"SLC9A1","gene_id":"ENSG00000090020","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.706091,"nucleus_log2fc":0.0761548,"nucleus_score":0.954556,"pct_ad":0.1189,"pct_control":0.109555,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0093471,"donor_lfcse":0.150105,"donor_log2fc_shrunk":4.30356e-07}],"modules":[{"cell_type":"In","gene_id":"ENSG00000090020","module":"yellow","kme":0.144243,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000090020","entrez_id":["6548"],"uniprot":["P19634"],"ncbi_summary":"This gene encodes a Na+/H+ antiporter that is a member of the solute carrier family 9. The encoded protein is a plasma membrane transporter that is expressed in the kidney and intestine. This protein plays a central role in regulating pH homeostasis, cell migration and cell volume. This protein may also be involved in tumor growth. [provided by RefSeq, Sep 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P19634","text":"Electroneutral Na(+) /H(+) antiporter that extrudes Na(+) in exchange for external protons driven by the inward sodium ion chemical gradient, protecting cells from acidification that occurs from metabolism (PubMed:11350981, PubMed:11532004, PubMed:14680478, PubMed:15035633, PubMed:15677483, PubMed:17073455, PubMed:17493937, PubMed:22020933, PubMed:27650500, PubMed:32130622, PubMed:7110335, PubMed:7603840). Exchanges intracellular H(+) ions for extracellular Na(+) in 1:1 stoichiometry (By similarity). Plays a key role in maintening intracellular pH neutral and cell volume, and thus is important for cell growth, proliferation, migration and survival (PubMed:12947095, PubMed:15096511, PubMed:22020933, PubMed:8901634). In addition, can transport lithium Li(+) and also functions as a Na(+)/Li(+) antiporter (PubMed:7603840). SLC9A1 also functions in membrane anchoring and organization of scaffolding complexes that coordinate signaling inputs (PubMed:15096511)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}