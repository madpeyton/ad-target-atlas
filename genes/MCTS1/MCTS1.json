:"ENSG00000232119","module":"turquoise","kme":0.0656382,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":true,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000232119"],"dataset_symbols":["MCTS1"],"explorer":"explorer.html?dataset=mathys2019#gene/MCTS1","cell_types":[{"cell_type":"Ex","gene_symbol":"MCTS1","gene_symbol_current":"MCTS1","gene_id":"ENSG00000232119","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0359455,"nucleus_log2fc":-0.0672885,"nucleus_score":-2.31985,"pct_ad":0.224096,"pct_control":0.237996,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0531205,"donor_lfcse":0.0814954,"donor_log2fc_shrunk":8.12636e-06},{"cell_type":"In","gene_symbol":"MCTS1","gene_symbol_current":"MCTS1","gene_id":"ENSG00000232119","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.759496,"nucleus_log2fc":-0.0257055,"nucleus_score":0.791575,"pct_ad":0.14685,"pct_control":0.136632,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.098032,"donor_lfcse":0.129301,"donor_log2fc_shrunk":7.17158e-06},{"cell_type":"Oli","gene_symbol":"MCTS1","gene_symbol_current":"MCTS1","gene_id":"ENSG00000232119","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.90387,"donor_log2fc":0.0997411,"donor_lfcse":0.142957,"donor_log2fc_shrunk":0.00463735}],"modules":[{"cell_type":"In","gene_id":"ENSG00000232119","module":"turquoise","kme":0.132962,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000232119","entrez_id":["28985"],"uniprot":["Q9ULC4"],"ncbi_summary":"Predicted to enable translation initiation factor activity. Involved in IRES-dependent viral translational initiation; formation of translation preinitiation complex; and ribosome disassembly. Located in cytosol and plasma membrane. Colocalizes with cytosolic small ribosomal subunit. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9ULC4","text":"Translation regulator forming a complex with DENR to promote translation reinitiation. Translation reinitiation is the process where the small ribosomal subunit remains attached to the mRNA following termination of translation of a regulatory upstream ORF (uORF), and resume scanning on the same mRNA molecule to initiate translation of a downstream ORF, usually the main ORF (mORF). The MCTS1/DENR complex is pivotal to two linked mechanisms essential for translation reinitiation. Firstly, the dissociation of deacylated tRNAs from post-termination 40S ribosomal complexes during ribosome recycling. Secondly, the recruitment in an EIF2-independent manner of aminoacylated initiator tRNA to P site of 40S ribosomes for a new round of translation (PubMed:16982740, PubMed:20713520, PubMed:37875108). This regulatory mechanism governs the translation of more than 150 genes which translation reinitiation is MCTS1/DENR complex-dependent (PubMed:16982740, PubMed:20713520, PubMed:37875108). Consequently, modulates various unrelated biological processes including cell cycle regulation and DNA damage signaling and repair (PubMed:10440924, PubMed:11709712, PubMed:12637315, PubMed:15897892, PubMed:16322206, PubMed:17016429, PubMed:17416211, PubMed:9766643). Notably, it positively regulates interferon gamma immunity to mycobacteria by enhancing the translation of JAK2 (PubMed:37875108)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}