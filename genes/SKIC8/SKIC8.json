,"gene_id":"ENSG00000140395","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":8.11291e-72,"nucleus_log2fc":-0.17226,"nucleus_score":-18.0504,"pct_ad":0.45445,"pct_control":0.49362,"donor_test":"not significant","donor_padj":0.73532,"donor_log2fc":-0.0820518,"donor_lfcse":0.0531681,"donor_log2fc_shrunk":-0.0143227},{"cell_type":"Mic","gene_symbol":"WDR61","gene_symbol_current":"SKIC8","gene_id":"ENSG00000140395","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.305861,"nucleus_log2fc":-0.0591656,"nucleus_score":-1.22973,"pct_ad":0.156453,"pct_control":0.163364,"donor_test":"not significant","donor_padj":0.928189,"donor_log2fc":-0.042732,"donor_lfcse":0.0961089,"donor_log2fc_shrunk":-0.00866717},{"cell_type":"OPC","gene_symbol":"WDR61","gene_symbol_current":"SKIC8","gene_id":"ENSG00000140395","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0127916,"nucleus_log2fc":-0.153967,"nucleus_score":-2.97272,"pct_ad":0.307337,"pct_control":0.328704,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0848549,"donor_lfcse":0.0878046,"donor_log2fc_shrunk":-1.14755e-05},{"cell_type":"Oli","gene_symbol":"WDR61","gene_symbol_current":"SKIC8","gene_id":"ENSG00000140395","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.0085e-15,"nucleus_log2fc":-0.174932,"nucleus_score":-8.18796,"pct_ad":0.230307,"pct_control":0.256547,"donor_test":"not significant","donor_padj":0.472014,"donor_log2fc":-0.134139,"donor_lfcse":0.0535479,"donor_log2fc_shrunk":-0.0826315}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000140395","module":"turquoise","kme":0.143665,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000140395","module":"turquoise","kme":0.219289,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000140395","module":"turquoise","kme":0.08102,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000140395","module":"turquoise","kme":0.0805692,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000140395","entrez_id":["80349"],"uniprot":["Q9GZS3"],"ncbi_summary":"WDR61 is a subunit of the human PAF and SKI complexes, which function in transcriptional regulation and are involved in events downstream of RNA synthesis, such as RNA surveillance (Zhu et al., 2005 [PubMed 16024656]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9GZS3","text":"Component of the PAF1 complex (PAF1C) which has multiple functions during transcription by RNA polymerase II and is implicated in regulation of development and maintenance of embryonic stem cell pluripotency (PubMed:16307923, PubMed:19952111, PubMed:20178742). PAF1C associates with RNA polymerase II through interaction with POLR2A CTD non-phosphorylated and 'Ser-2'- and 'Ser-5'-phosphorylated forms and is involved in transcriptional elongation, acting both independently and synergistically with TCEA1 and in cooperation with the DSIF complex and HTATSF1 (PubMed:16307923, PubMed:19952111, PubMed:20178742). PAF1C is required for transcription of Hox and Wnt target genes (PubMed:16307923, PubMed:19952111, PubMed:20178742). PAF1C is involved in hematopoiesis and stimulates transcriptional activity of KMT2A/MLL1; it promotes leukemogenesis through association with KMT2A/MLL1-rearranged oncoproteins, such as KMT2A/MLL1-MLLT3/AF9 and KMT2A/MLL1-MLLT1/ENL (PubMed:16307923, PubMed:19952111, PubMed:20178742). PAF1C is involved in histone modifications such as ubiquitination of histone H2B and methylation on histone H3 'Lys-4' (H3K4me3) (PubMed:16307923, PubMed:19952111, PubMed:20178742). PAF1C recruits the RNF20/40 E3 ubiquitin-protein ligase complex and the E2 enzyme UBE2A or UBE2B to chromatin which mediate monoubiquitination of 'Lys-120' of histone H2B (H2BK120ub1); UB2A/B-mediated H2B ubiquitination is proposed to be coupled to transcription (PubMed:16307923, PubMed:19952111, PubMed:20178742). PAF1C is involved in mRNA 3' end formation probably through association with cleavage and poly(A) factors (PubMed:16307923, PubMed:19952111, PubMed:20178742). In case of infection by influenza A strain H3N2, PAF1C associates with viral NS1 protein, thereby regulating gene transcription (PubMed:16307923, PubMed:19952111, PubMed:20178742). Required for mono- and trimethylation on histone H3 'Lys-4' (H3K4me3), dimethylation on histone H3 'Lys-79' (H3K4me3). Required for Hox gene transcription (PubMed:16307923, PubMed:19952111, PubMed:20178742). Also acts as a component of the SKI complex, a multiprotein complex that assists the RNA-degrading exosome during the mRNA decay and quality-control pathways (PubMed:16024656, PubMed:32006463, PubMed:35120588). The SKI complex catalyzes mRNA extraction from 80S ribosomal complexes in the 3'-5' direction and channels mRNA to the cytosolic exosome for degradation (PubMed:32006463, PubMed:35120588). SKI-mediated extraction of mRNA from stalled ribosomes allow binding of the Pelota-HBS1L complex and subsequent ribosome disassembly by ABCE1 for ribosome recycling (PubMed:32006463)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}