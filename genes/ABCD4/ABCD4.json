e_id":"ENSG00000119688","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.78464e-05,"nucleus_log2fc":0.0884297,"nucleus_score":4.34268,"pct_ad":0.22817,"pct_control":0.213668,"donor_test":"not significant","donor_padj":0.954479,"donor_log2fc":0.0367197,"donor_lfcse":0.0924553,"donor_log2fc_shrunk":0.00455889,"degas_log2fc":-0.0840489,"degas_padj":0.000926279}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000119688","module":"black","kme":0.150472,"hub":false,"module_direction":"lower in AD","module_padj":1.0,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000119688","entrez_id":["5826"],"uniprot":["O14678"],"ncbi_summary":"The protein encoded by this gene is a member of the superfamily of ATP-binding cassette (ABC) transporters. ABC proteins transport various molecules across extra- and intra-cellular membranes. ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, White). This protein is a member of the ALD subfamily, which is involved in peroxisomal import of fatty acids and/or fatty acyl-CoAs in the organelle. All known peroxisomal ABC transporters are half transporters which require a partner half transporter molecule to form a functional homodimeric or heterodimeric transporter. The function of this peroxisomal membrane protein is unknown. However, it is speculated that it may function as a heterodimer for another peroxisomal ABC transporter and, therefore, may modify the adrenoleukodystrophy phenotype. It may also play a role in the process of peroxisome biogenesis. Alternative splicing results in several protein-coding and non-protein-coding variants. [provided by RefSeq, Jul 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O14678","text":"Lysosomal membrane protein that transports cobalamin (Vitamin B12) from the lysosomal lumen to the cytosol in an ATP-dependent manner (PubMed:22922874, PubMed:28572511, PubMed:31467407, PubMed:33845046). Targeted by LMBRD1 lysosomal chaperone from the endoplasmic reticulum to the lysosomal membrane (PubMed:27456980). Then forms a complex with lysosomal chaperone LMBRD1 and cytosolic MMACHC to transport cobalamin across the lysosomal membrane (PubMed:25535791)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}