,"donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"ABCD4","gene_symbol_current":"ABCD4","gene_id":"ENSG00000119688","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.866699,"donor_log2fc":-0.123926,"donor_lfcse":0.131385,"donor_log2fc_shrunk":-0.00667967}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000119688","module":"lightcyan","kme":0.166603,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000119688","entrez_id":["5826"],"uniprot":["O14678"],"ncbi_summary":"The protein encoded by this gene is a member of the superfamily of ATP-binding cassette (ABC) transporters. ABC proteins transport various molecules across extra- and intra-cellular membranes. ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, White). This protein is a member of the ALD subfamily, which is involved in peroxisomal import of fatty acids and/or fatty acyl-CoAs in the organelle. All known peroxisomal ABC transporters are half transporters which require a partner half transporter molecule to form a functional homodimeric or heterodimeric transporter. The function of this peroxisomal membrane protein is unknown. However, it is speculated that it may function as a heterodimer for another peroxisomal ABC transporter and, therefore, may modify the adrenoleukodystrophy phenotype. It may also play a role in the process of peroxisome biogenesis. Alternative splicing results in several protein-coding and non-protein-coding variants. [provided by RefSeq, Jul 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O14678","text":"Lysosomal membrane protein that transports cobalamin (Vitamin B12) from the lysosomal lumen to the cytosol in an ATP-dependent manner (PubMed:22922874, PubMed:28572511, PubMed:31467407, PubMed:33845046). Targeted by LMBRD1 lysosomal chaperone from the endoplasmic reticulum to the lysosomal membrane (PubMed:27456980). Then forms a complex with lysosomal chaperone LMBRD1 and cytosolic MMACHC to transport cobalamin across the lysosomal membrane (PubMed:25535791)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}