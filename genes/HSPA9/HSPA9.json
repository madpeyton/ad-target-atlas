les":[{"cell_type":"CUX2+","gene_id":"ENSG00000113013","module":"turquoise","kme":0.270923,"hub":false,"module_direction":"higher in AD","module_padj":0.789273,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000113013","module":"turquoise","kme":0.283287,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000113013","module":"turquoise","kme":0.19694,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000113013"],"dataset_symbols":["HSPA9"],"explorer":"explorer.html?dataset=mathys2019#gene/HSPA9","cell_types":[{"cell_type":"Ast","gene_symbol":"HSPA9","gene_symbol_current":"HSPA9","gene_id":"ENSG00000113013","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.655544,"nucleus_log2fc":-0.0243692,"nucleus_score":-0.606973,"pct_ad":0.141907,"pct_control":0.152245,"donor_test":"not significant","donor_padj":0.94451,"donor_log2fc":0.0675283,"donor_lfcse":0.195991,"donor_log2fc_shrunk":0.0036121},{"cell_type":"Ex","gene_symbol":"HSPA9","gene_symbol_current":"HSPA9","gene_id":"ENSG00000113013","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.83704e-09,"nucleus_log2fc":-0.17874,"nucleus_score":-6.36933,"pct_ad":0.453474,"pct_control":0.502233,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0815915,"donor_lfcse":0.0601928,"donor_log2fc_shrunk":-2.34585e-05},{"cell_type":"In","gene_symbol":"HSPA9","gene_symbol_current":"HSPA9","gene_id":"ENSG00000113013","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.360821,"nucleus_log2fc":0.138158,"nucleus_score":1.83655,"pct_ad":0.365129,"pct_control":0.341425,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.124897,"donor_lfcse":0.0994532,"donor_log2fc_shrunk":1.31918e-05},{"cell_type":"OPC","gene_symbol":"HSPA9","gene_symbol_current":"HSPA9","gene_id":"ENSG00000113013","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.701672,"nucleus_log2fc":-0.0786996,"nucleus_score":-0.789085,"pct_ad":0.132653,"pct_control":0.144828,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"HSPA9","gene_symbol_current":"HSPA9","gene_id":"ENSG00000113013","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.886029,"donor_log2fc":0.0848418,"donor_lfcse":0.109796,"donor_log2fc_shrunk":0.00649712}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000113013","module":"turquoise","kme":0.267377,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000113013","module":"turquoise","kme":0.293027,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000113013","entrez_id":["3313"],"uniprot":["P38646"],"ncbi_summary":"This gene encodes a member of the heat shock protein 70 gene family. The encoded protein is primarily localized to the mitochondria but is also found in the endoplasmic reticulum, plasma membrane and cytoplasmic vesicles. This protein is a heat-shock cognate protein. This protein plays a role in cell proliferation, stress response and maintenance of the mitochondria. A pseudogene of this gene is found on chromosome 2.[provided by RefSeq, May 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P38646","text":"Mitochondrial chaperone that plays a key role in mitochondrial protein import, folding, and assembly. Plays an essential role in the protein quality control system, the correct folding of proteins, the re-folding of misfolded proteins, and the targeting of proteins for subsequent degradation. These processes are achieved through cycles of ATP binding, ATP hydrolysis, and ADP release, mediated by co-chaperones (PubMed:18632665, PubMed:25615450, PubMed:28848044, PubMed:30933555, PubMed:31177526). In mitochondria, it associates with the TIM (translocase of the inner membrane) protein complex to assist in the import and folding of mitochondrial proteins (By similarity). Plays an important role in mitochondrial iron-sulfur cluster (ISC) biogenesis, interacts with and stabilizes ISC cluster assembly proteins FXN, NFU1, NFS1 and ISCU (PubMed:26702583). Regulates erythropoiesis via stabilization of ISC assembly (PubMed:21123823, PubMed:26702583). Regulates mitochondrial calcium-dependent apoptosis by coupling two calcium channels, ITPR1 and VDAC1, at the mitochondria-associated endoplasmic reticulum (ER) membrane to facilitate calcium transport from the ER lumen to the mitochondria intermembrane space, providing calcium for the downstream calcium channel MCU, which releases it into the mitochondrial matrix (By similarity). Although primarily located in the mitochondria, it is also found in other cellular compartments. In the cytosol, it associates with proteins involved in signaling, apoptosis, or senescence. It may play a role in cell cycle regulation via its interaction with and promotion of degradation of TP53 (PubMed:24625977, PubMed:26634371). May play a role in the control of cell proliferation and cellular aging (By similarity). Protects against reactive oxygen species (ROS) (By similarity). Extracellular HSPA9 plays a cytoprotective role by preventing cell lysis following immune attack by the membrane attack complex by disrupting formation of the complex (PubMed:16091382)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}