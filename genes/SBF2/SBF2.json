her in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000133812","module":"yellow","kme":0.242433,"hub":false,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000133812","module":"blue","kme":0.260768,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000133812","module":"blue","kme":0.196034,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000133812","entrez_id":["81846"],"uniprot":["Q86WG5"],"ncbi_summary":"This gene encodes a pseudophosphatase and member of the myotubularin-related protein family. This gene maps within the CMT4B2 candidate region of chromosome 11p15 and mutations in this gene have been associated with Charcot-Marie-Tooth Disease, type 4B2. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86WG5","text":"Guanine nucleotide exchange factor (GEF) which activates RAB21 and possibly RAB28 (PubMed:20937701, PubMed:25648148). Promotes the exchange of GDP to GTP, converting inactive GDP-bound Rab proteins into their active GTP-bound form (PubMed:20937701, PubMed:25648148). In response to starvation-induced autophagy, activates RAB21 which in turn binds to and regulates SNARE protein VAMP8 endolysosomal transport required for SNARE-mediated autophagosome-lysosome fusion (PubMed:25648148). Acts as an adapter for the phosphatase MTMR2 (By similarity). Increases MTMR2 catalytic activity towards phosphatidylinositol 3,5-bisphosphate and to a lesser extent towards phosphatidylinositol 3-phosphate (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}