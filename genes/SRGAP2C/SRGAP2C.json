ucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00613627,"nucleus_log2fc":0.165092,"nucleus_score":3.23971,"pct_ad":0.365792,"pct_control":0.340051,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.105289,"donor_lfcse":0.0812945,"donor_log2fc_shrunk":1.66617e-05,"degas_log2fc":-0.231607,"degas_padj":6.49e-07},{"cell_type":"Oli","gene_symbol":"SRGAP2C","gene_symbol_current":"SRGAP2C","gene_id":"ENSG00000171943","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0699329,"nucleus_log2fc":-0.0247685,"nucleus_score":-1.9383,"pct_ad":0.201595,"pct_control":0.208216,"donor_test":"not significant","donor_padj":0.932824,"donor_log2fc":0.0487946,"donor_lfcse":0.0918923,"donor_log2fc_shrunk":0.00740277,"degas_log2fc":-0.205765,"degas_padj":3.02865e-15}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000171943","module":"blue","kme":0.343368,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000171943","entrez_id":["653464"],"uniprot":["P0DJJ0"],"ncbi_summary":"This locus encodes a member of the SLIT-ROBO Rho GTPase activating protein family. This human-specific locus resulted from segmental duplication of the SLIT-ROBO Rho GTPase activating protein 2B locus. The encoded protein lacks the GTPase activating protein domain compared to proteins encoded by SLIT-ROBO Rho GTPase activating protein 2, and acts antagonistically to these proteins in cortical neuron development. [provided by RefSeq, Dec 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P0DJJ0","text":"Human-specific protein that acts as a key modifier of cortical connectivity in the human brain (PubMed:22559944, PubMed:27373832, PubMed:34707291). Acts by inhibiting the functions of ancestral paralog SRGAP2/SRGAP2A, a postsynaptic protein that regulates excitatory and inhibitory synapse maturation and density in cortical pyramidal neurons (PubMed:22559944, PubMed:27373832). SRGAP2C is unstable but is able to heterodimerize with SRGAP2/SRGAP2A, thereby reducing SRGAP2/SRGAP2A levels through proteasome-dependent degradation (PubMed:27373832, PubMed:28333212, PubMed:31822692). Inhibition of SRGAP2/SRGAP2A by SRGAP2C leads to an increase in synaptic density and protracted synaptic maturation of both excitatory and inhibitory synapses (PubMed:27373832, PubMed:34707291). Modifies cortical circuit connectivity by increasing the number of local and long-range cortical inputs received by layer 2/3 pyramidal neurons (PubMed:34707291). Also able to increase the probability of sensory-evoked responses by layer 2/3 pyramidal neurons (PubMed:34707291)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}