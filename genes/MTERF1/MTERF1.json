se,"nucleus_direction":"lower in AD","nucleus_padj":0.121584,"nucleus_log2fc":-0.0810379,"nucleus_score":-1.97053,"pct_ad":0.508351,"pct_control":0.522777,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0800011,"donor_lfcse":0.10057,"donor_log2fc_shrunk":-8.2104e-06,"degas_log2fc":-0.131341,"degas_padj":0.000883775},{"cell_type":"Oli","gene_symbol":"MTERF1","gene_symbol_current":"MTERF1","gene_id":"ENSG00000127989","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":4.11687e-19,"nucleus_log2fc":-0.166975,"nucleus_score":-9.09569,"pct_ad":0.39747,"pct_control":0.430426,"donor_test":"not significant","donor_padj":0.705591,"donor_log2fc":-0.185839,"donor_lfcse":0.117349,"donor_log2fc_shrunk":-0.0156433,"degas_log2fc":-0.25105,"degas_padj":6.58993e-40}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000127989","module":"green","kme":0.210379,"hub":false,"module_direction":"lower in AD","module_padj":0.299526,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000127989","module":"yellow","kme":0.173675,"hub":false,"module_direction":"lower in AD","module_padj":0.0240838,"module_significant":true}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000127989","entrez_id":["7978"],"uniprot":["Q99551"],"ncbi_summary":"This gene encodes a mitochondrial transcription termination factor. This protein participates in attenuating transcription from the mitochondrial genome; this attenuation allows higher levels of expression of 16S ribosomal RNA relative to the tRNA gene downstream. The product of this gene has three leucine zipper motifs bracketed by two basic domains that are all required for DNA binding. There is evidence that, for this protein, the zippers participate in intramolecular interactions that establish the three-dimensional structure required for DNA binding. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q99551","text":"Transcription termination factor. Binds to a 28 bp region within the tRNA(Leu(uur)) gene at a position immediately adjacent to and downstream of the 16S rRNA gene; this region comprises a tridecamer sequence critical for directing accurate termination. Binds DNA along the major grove and promotes DNA bending and partial unwinding. Promotes base flipping. Transcription termination activity appears to be polarized with highest specificity for transcripts initiated on the light strand."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}