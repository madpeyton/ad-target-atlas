":0.0516085,"donor_lfcse":0.133155,"donor_log2fc_shrunk":3.10605e-06,"degas_log2fc":0.201228,"degas_padj":0.0167393},{"cell_type":"Oli","gene_symbol":"CFL2","gene_symbol_current":"CFL2","gene_id":"ENSG00000165410","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.81411e-09,"nucleus_log2fc":-0.101834,"nucleus_score":-6.0501,"pct_ad":0.350357,"pct_control":0.372288,"donor_test":"not significant","donor_padj":0.990719,"donor_log2fc":-0.0109737,"donor_lfcse":0.131809,"donor_log2fc_shrunk":-0.000781343,"degas_log2fc":0.0982319,"degas_padj":7.12599e-07}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000165410","module":"turquoise","kme":0.0963962,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000165410","module":"brown","kme":0.26669,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000165410","module":"brown","kme":0.269685,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000165410","module":"turquoise","kme":0.109791,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000165410","module":"turquoise","kme":0.272264,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165410","entrez_id":["1073"],"uniprot":["Q9Y281"],"ncbi_summary":"This gene encodes an intracellular protein that is involved in the regulation of actin-filament dynamics. This protein is a major component of intranuclear and cytoplasmic actin rods. It can bind G- and F-actin in a 1:1 ratio of cofilin to actin, and it reversibly controls actin polymerization and depolymerization in a pH-dependent manner. Mutations in this gene cause nemaline myopathy type 7, a form of congenital myopathy. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jul 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y281","text":"Controls reversibly actin polymerization and depolymerization in a pH-sensitive manner. Its F-actin depolymerization activity is regulated by association with CSPR3 (PubMed:19752190). It has the ability to bind G- and F-actin in a 1:1 ratio of cofilin to actin. It is the major component of intranuclear and cytoplasmic actin rods. Required for muscle maintenance. May play a role during the exchange of alpha-actin forms during the early postnatal remodeling of the sarcomere (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}