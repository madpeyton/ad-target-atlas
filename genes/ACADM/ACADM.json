s_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.554109,"nucleus_log2fc":0.0263991,"nucleus_score":0.741478,"pct_ad":0.257939,"pct_control":0.253687,"donor_test":"not significant","donor_padj":0.983828,"donor_log2fc":-0.00656716,"donor_lfcse":0.0591718,"donor_log2fc_shrunk":-0.00249953},{"cell_type":"OPC","gene_symbol":"ACADM","gene_symbol_current":"ACADM","gene_id":"ENSG00000117054","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.761188,"nucleus_log2fc":-0.0311374,"nucleus_score":-0.471073,"pct_ad":0.392932,"pct_control":0.395597,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.026965,"donor_lfcse":0.0674911,"donor_log2fc_shrunk":-6.08794e-06},{"cell_type":"Oli","gene_symbol":"ACADM","gene_symbol_current":"ACADM","gene_id":"ENSG00000117054","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.743892,"nucleus_log2fc":0.0109144,"nucleus_score":0.375903,"pct_ad":0.252405,"pct_control":0.251068,"donor_test":"not significant","donor_padj":0.938417,"donor_log2fc":0.0267739,"donor_lfcse":0.0539783,"donor_log2fc_shrunk":0.00761544}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000117054","module":"turquoise","kme":0.130657,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000117054","module":"turquoise","kme":0.0654308,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000117054","module":"turquoise","kme":0.0400935,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000117054","entrez_id":["34"],"uniprot":["P11310"],"ncbi_summary":"This gene encodes the medium-chain specific (C4 to C12 straight chain) acyl-Coenzyme A dehydrogenase. The homotetramer enzyme catalyzes the initial step of the mitochondrial fatty acid beta-oxidation pathway. Defects in this gene cause medium-chain acyl-CoA dehydrogenase deficiency, a disease characterized by hepatic dysfunction, fasting hypoglycemia, and encephalopathy, which can result in infantile death. Alternatively spliced transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P11310","text":"Medium-chain specific acyl-CoA dehydrogenase is one of the acyl-CoA dehydrogenases that catalyze the first step of mitochondrial fatty acid beta-oxidation (FAO), breaking down fatty acids into acetyl-CoA and allowing the production of energy from fats (PubMed:1970566, PubMed:21237683, PubMed:2251268, PubMed:8823175). The first step of FAO consists in the proR-proR stereospecific alpha, beta-dehydrogenation of fatty acyl-CoA thioesters using the electron transfer flavoprotein (ETF) as their physiologic electron acceptor, resulting in the formation of trans-2-enoyl-CoA ((2E)-enoyl-CoA) (PubMed:2251268). ETF is the electron acceptor that transfers electrons to the main mitochondrial respiratory chain via ETF-ubiquinone oxidoreductase (ETF dehydrogenase) (PubMed:15159392, PubMed:25416781). Among the different mitochondrial acyl-CoA dehydrogenases, medium-chain specific acyl-CoA dehydrogenase has preference for fatty acyl-CoAs with saturated 6 to 12 carbons long primary chains, making it but can also catalyze longer chains such as C14 and C16 (PubMed:1970566, PubMed:21237683, PubMed:2251268, PubMed:8823175)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}