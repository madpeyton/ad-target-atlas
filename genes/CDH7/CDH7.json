,"pct_control":null,"donor_test":"not significant","donor_padj":0.943264,"donor_log2fc":-0.093306,"donor_lfcse":0.199126,"donor_log2fc_shrunk":-0.00254876,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000081138","module":"yellow","kme":0.531781,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000081138","module":"magenta","kme":0.375723,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000081138","entrez_id":["1005"],"uniprot":["Q9ULB5"],"ncbi_summary":"This gene encodes a type II classical cadherin of the cadherin superfamily. Alternative splicing results in multiple transcript variants, at least one of which encodes a preproprotein that is proteolytically processed to generate the mature glycoprotein. This calcium dependent cell-cell adhesion molecule is comprised of five extracellular cadherin repeats, a transmembrane region and a highly conserved cytoplasmic tail. Type II (atypical) cadherins are defined based on their lack of a histidine-alanine-valine (HAV) cell adhesion recognition sequence specific to type I cadherins. Cadherins mediate cell-cell binding in a homophilic manner, contributing to the sorting of heterogeneous cell types. Mutations in this gene may be associated with bipolar disease in human patients. This gene is present in a gene cluster on chromosome 18. [provided by RefSeq, May 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9ULB5","text":"Cadherins are calcium-dependent cell adhesion proteins. They preferentially interact with themselves in a homophilic manner in connecting cells; cadherins may thus contribute to the sorting of heterogeneous cell types."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}