":0.0234511,"nucleus_log2fc":-0.153202,"nucleus_score":-2.73521,"pct_ad":0.233522,"pct_control":0.254022,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.16158,"donor_lfcse":0.0969369,"donor_log2fc_shrunk":-1.78576e-05},{"cell_type":"Oli","gene_symbol":"RANBP10","gene_symbol_current":"RANBP10","gene_id":"ENSG00000141084","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":4.44799e-07,"nucleus_log2fc":-0.142159,"nucleus_score":-5.20557,"pct_ad":0.15737,"pct_control":0.171743,"donor_test":"not significant","donor_padj":0.732413,"donor_log2fc":-0.115171,"donor_lfcse":0.0779508,"donor_log2fc_shrunk":-0.0209962}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000141084","module":"blue","kme":0.116401,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000141084","entrez_id":["57610"],"uniprot":["Q6VN20"],"ncbi_summary":"RAN is a small GTPase involved in the assembly of microtubules to form mitotic spindles. The protein encoded by this gene is a cytoplasmic guanine nucleotide exchange factor (GEF) that binds beta-tubulin and has GEF activity toward RAN. The encoded protein plays a role in the formation of noncentrosomal microtubules. In addition, this protein may be involved in the regulation of D(1) receptor signaling by protein kinase C delta and protein kinase C gamma. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Feb 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6VN20","text":"May act as an adapter protein to couple membrane receptors to intracellular signaling pathways (Probable). Core component of the CTLH E3 ubiquitin-protein ligase complex that selectively accepts ubiquitin from UBE2H and mediates ubiquitination and subsequent proteasomal degradation of the transcription factor HBP1 (PubMed:29911972). Enhances dihydrotestosterone-induced transactivation activity of AR, as well as dexamethasone-induced transactivation activity of NR3C1, but does not affect estrogen-induced transactivation (PubMed:18222118). Acts as a guanine nucleotide exchange factor (GEF) for RAN GTPase. May play an essential role in hemostasis and in maintaining microtubule dynamics with respect to both platelet shape and function (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}