:"Mic","gene_symbol":"APLP2","gene_symbol_current":"APLP2","gene_id":"ENSG00000084234","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.557378,"nucleus_log2fc":-0.0246499,"nucleus_score":-0.736082,"pct_ad":0.517456,"pct_control":0.520622,"donor_test":"not significant","donor_padj":0.930416,"donor_log2fc":-0.0364426,"donor_lfcse":0.0835527,"donor_log2fc_shrunk":-0.0085701},{"cell_type":"OPC","gene_symbol":"APLP2","gene_symbol_current":"APLP2","gene_id":"ENSG00000084234","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.7469,"nucleus_log2fc":0.037117,"nucleus_score":0.497755,"pct_ad":0.466001,"pct_control":0.464522,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0371102,"donor_lfcse":0.0662348,"donor_log2fc_shrunk":8.78932e-06},{"cell_type":"Oli","gene_symbol":"APLP2","gene_symbol_current":"APLP2","gene_id":"ENSG00000084234","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.7222e-12,"nucleus_log2fc":0.184696,"nucleus_score":7.21552,"pct_ad":0.248447,"pct_control":0.226397,"donor_test":"not significant","donor_padj":0.661251,"donor_log2fc":0.210718,"donor_lfcse":0.119503,"donor_log2fc_shrunk":0.0178205}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000084234","module":"red","kme":0.266245,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000084234","entrez_id":["334"],"uniprot":["Q06481"],"ncbi_summary":"This gene encodes amyloid precursor- like protein 2 (APLP2), which is a member of the APP (amyloid precursor protein) family including APP, APLP1 and APLP2. This protein is ubiquitously expressed. It contains heparin-, copper- and zinc- binding domains at the N-terminus, BPTI/Kunitz inhibitor and E2 domains in the middle region, and transmembrane and intracellular domains at the C-terminus. This protein interacts with major histocompatibility complex (MHC) class I molecules. The synergy of this protein and the APP is required to mediate neuromuscular transmission, spatial learning and synaptic plasticity. This protein has been implicated in the pathogenesis of Alzheimer's disease. Multiple alternatively spliced transcript variants encoding different isoforms have been identified. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q06481","text":"May play a role in the regulation of hemostasis. The soluble form may have inhibitory properties towards coagulation factors. May interact with cellular G protein signaling pathways. May bind to the DNA 5'-GTCACATG-3'(CDEI box). Inhibits trypsin, chymotrypsin, plasmin, factor XIA and plasma and glandular kallikrein. Modulates the Cu/Zn nitric oxide-catalyzed autodegradation of GPC1 heparan sulfate side chains in fibroblasts (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}