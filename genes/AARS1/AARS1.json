leus_log2fc":-0.0441807,"nucleus_score":-0.0422773,"pct_ad":0.291038,"pct_control":0.284781,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0209594,"donor_lfcse":0.116515,"donor_log2fc_shrunk":-1.63099e-06},{"cell_type":"Oli","gene_symbol":"AARS","gene_symbol_current":"AARS1","gene_id":"ENSG00000090861","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.708624,"donor_log2fc":0.315266,"donor_lfcse":0.125959,"donor_log2fc_shrunk":0.0226829}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000090861","module":"turquoise","kme":0.322625,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000090861","module":"turquoise","kme":0.252709,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000090861","entrez_id":["16"],"uniprot":["P49588"],"ncbi_summary":"The human alanyl-tRNA synthetase (AARS) belongs to a family of tRNA synthases, of the class II enzymes.  Class II tRNA synthases evolved early in evolution and are highly conserved. This is reflected by the fact that 498 of the 968-residue polypeptide human AARS shares 41% identity witht the E.coli protein.  tRNA synthases are the enzymes that interpret the RNA code and attach specific aminoacids to the tRNAs that contain the cognate trinucleotide anticodons.  They consist of a catalytic domain which interacts with the amino acid acceptor-T psi C helix of the tRNA, and a second domain which interacts with the rest of the tRNA structure. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49588","text":"Catalyzes the attachment of alanine to tRNA(Ala) in a two-step reaction: alanine is first activated by ATP to form Ala-AMP and then transferred to the acceptor end of tRNA(Ala) (PubMed:27622773, PubMed:27911835, PubMed:28493438, PubMed:33909043). Also edits incorrectly charged tRNA(Ala) via its editing domain (PubMed:27622773, PubMed:27911835, PubMed:28493438, PubMed:29273753). In presence of high levels of lactate, also acts as a protein lactyltransferase that mediates lactylation of lysine residues in target proteins, such as TEAD1, TP53/p53 and YAP1 (PubMed:38512451, PubMed:38653238). Protein lactylation takes place in a two-step reaction: lactate is first activated by ATP to form lactate-AMP and then transferred to lysine residues of target proteins (PubMed:38512451, PubMed:38653238, PubMed:39322678). Acts as an inhibitor of TP53/p53 activity by catalyzing lactylation of TP53/p53 (PubMed:38653238). Acts as a positive regulator of the Hippo pathway by mediating lactylation of TEAD1 and YAP1 (PubMed:38512451)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}