":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0383081,"nucleus_log2fc":0.105413,"nucleus_score":2.53213,"pct_ad":0.435729,"pct_control":0.416427,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0999223,"donor_lfcse":0.0853759,"donor_log2fc_shrunk":1.43287e-05,"degas_log2fc":-0.278169,"degas_padj":2.13852e-11},{"cell_type":"Oli","gene_symbol":"PPP4R2","gene_symbol_current":"PPP4R2","gene_id":"ENSG00000163605","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":3.91874e-77,"nucleus_log2fc":0.260072,"nucleus_score":18.7427,"pct_ad":0.655998,"pct_control":0.616472,"donor_test":"not significant","donor_padj":0.66994,"donor_log2fc":0.174891,"donor_lfcse":0.101833,"donor_log2fc_shrunk":0.0219486,"degas_log2fc":-0.104179,"degas_padj":1.53828e-13}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000163605","module":"magenta","kme":0.172128,"hub":false,"module_direction":"higher in AD","module_padj":0.456482,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000163605","module":"red","kme":0.174422,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000163605","module":"blue","kme":0.194625,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163605","entrez_id":["151987"],"uniprot":["Q9NY27"],"ncbi_summary":"The protein encoded by this gene is a regulatory subunit of the serine/threonine-protein phosphatase 4 complex. In addition to being required for efficient DNA double strand break repair, this complex plays a role in organization of microtubules at centrosomes and processing of spliceosomal snRNPs. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Dec 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NY27","text":"Regulatory subunit of serine/threonine-protein phosphatase 4 (PP4). May regulate the activity of PPP4C at centrosomal microtubule organizing centers. Its interaction with the SMN complex leads to enhance the temporal localization of snRNPs, suggesting a role of PPP4C in maturation of spliceosomal snRNPs. The PPP4C-PPP4R2-PPP4R3A PP4 complex specifically dephosphorylates H2AX phosphorylated on 'Ser-140' (gamma-H2AX) generated during DNA replication and required for DNA double strand break repair. Mediates RPA2 dephosphorylation by recruiting PPP4C to RPA2 in a DNA damage-dependent manner. RPA2 dephosphorylation is required for the efficient RPA2-mediated recruitment of RAD51 to chromatin following double strand breaks, an essential step for DNA repair."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}