irection":"lower in AD","nucleus_padj":0.00436343,"nucleus_log2fc":-0.17943,"nucleus_score":-3.35227,"pct_ad":0.280048,"pct_control":0.304149,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.1012,"donor_lfcse":0.167717,"donor_log2fc_shrunk":-3.59325e-06,"degas_log2fc":-0.163154,"degas_padj":0.00222732},{"cell_type":"Oli","gene_symbol":"CC2D1A","gene_symbol_current":"CC2D1A","gene_id":"ENSG00000132024","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0162698,"nucleus_log2fc":0.053958,"nucleus_score":2.53738,"pct_ad":0.19885,"pct_control":0.190738,"donor_test":"not significant","donor_padj":0.971528,"donor_log2fc":0.0333218,"donor_lfcse":0.126208,"donor_log2fc_shrunk":0.00218346,"degas_log2fc":-0.125902,"degas_padj":3.00952e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000132024","module":"yellow","kme":0.158475,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000132024","module":"pink","kme":0.172855,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000132024","module":"black","kme":0.136178,"hub":false,"module_direction":"lower in AD","module_padj":0.663532,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000132024","module":"blue","kme":0.0964888,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000132024","entrez_id":["54862"],"uniprot":["Q6P1N0"],"ncbi_summary":"This gene encodes a transcriptional repressor that binds to a conserved 14-bp 5'-repressor element and regulates expression of the 5-hydroxytryptamine (serotonin) receptor 1A gene in neuronal cells. The DNA binding and transcriptional repressor activities of the protein are inhibited by calcium. A mutation in this gene results in a nonsyndromic form of cognitive disability (MRT3). [provided by RefSeq, Jul 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6P1N0","text":"Transcription factor that binds specifically to the DRE (dual repressor element) and represses HTR1A gene transcription in neuronal cells. The combination of calcium and ATP specifically inactivates the binding with FRE. May play a role in the altered regulation of HTR1A associated with anxiety and major depression. Mediates HDAC-independent repression of HTR1A promoter in neuronal cell. Performs essential function in controlling functional maturation of synapses (By similarity). Plays distinct roles depending on its localization. When cytoplasmic, acts as a scaffold protein in the PI3K/PDK1/AKT pathway. Repressor of HTR1A when nuclear. In the centrosome, regulates spindle pole localization of the cohesin subunit SCC1/RAD21, thereby mediating centriole cohesion during mitosis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}