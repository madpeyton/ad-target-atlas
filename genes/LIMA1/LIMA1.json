alse,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.710602,"donor_log2fc":-0.322672,"donor_lfcse":0.136596,"donor_log2fc_shrunk":-0.0188541}],"modules":[{"cell_type":"In","gene_id":"ENSG00000050405","module":"brown","kme":0.157298,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000050405","module":"blue","kme":0.0941782,"hub":false,"module_direction":"lower in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000050405","entrez_id":["51474"],"uniprot":["Q9UHB6"],"ncbi_summary":"This gene encodes a cytoskeleton-associated protein that inhibits actin filament depolymerization and cross-links filaments in bundles. It is downregulated in some cancer cell lines. Alternatively spliced transcript variants encoding different isoforms have been described for this gene, and expression of some of the variants maybe independently regulated. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UHB6","text":"Actin-binding protein involved in actin cytoskeleton regulation and dynamics. Increases the number and size of actin stress fibers and inhibits membrane ruffling. Inhibits actin filament depolymerization. Bundles actin filaments, delays filament nucleation and reduces formation of branched filaments (PubMed:12566430, PubMed:33999101). Acts as a negative regulator of primary cilium formation (PubMed:32496561). Plays a role in cholesterol homeostasis. Influences plasma cholesterol levels through regulation of intestinal cholesterol absorption. May act as a scaffold protein by regulating NPC1L1 transportation, an essential protein for cholesterol absorption, to the plasma membrane by recruiting MYO5B to NPC1L1, and thus facilitates cholesterol uptake (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}