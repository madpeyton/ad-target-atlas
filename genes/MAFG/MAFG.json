":"CUX2-","gene_id":"ENSG00000197063","module":"turquoise","kme":0.25657,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000197063","module":"turquoise","kme":0.142791,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000197063"],"dataset_symbols":["MAFG"],"explorer":"explorer.html?dataset=mathys2019#gene/MAFG","cell_types":[{"cell_type":"Ex","gene_symbol":"MAFG","gene_symbol_current":"MAFG","gene_id":"ENSG00000197063","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0873947,"nucleus_log2fc":0.175151,"nucleus_score":1.91334,"pct_ad":0.159691,"pct_control":0.152177,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.166409,"donor_lfcse":0.140752,"donor_log2fc_shrunk":8.63322e-06},{"cell_type":"In","gene_symbol":"MAFG","gene_symbol_current":"MAFG","gene_id":"ENSG00000197063","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0137263,"donor_lfcse":0.20015,"donor_log2fc_shrunk":-3.44253e-07}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000197063","module":"magenta","kme":0.0961954,"hub":false,"module_direction":"higher in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000197063","module":"brown","kme":0.121238,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000197063","entrez_id":["4097"],"uniprot":["O15525"],"ncbi_summary":"Globin gene expression is regulated through nuclear factor erythroid-2 (NFE2) elements located in enhancer-like locus control regions positioned many kb upstream of alpha- and beta-gene clusters (summarized by Blank et al., 1997 [PubMed 9166829]). NFE2 DNA-binding activity consists of a heterodimer containing a ubiquitous small Maf protein (MafF, MIM 604877; MafG; or MafK, MIM 600197) and the tissue-restricted protein p45 NFE2 (MIM 601490). Both subunits are members of the activator protein-1-like superfamily of basic leucine zipper (bZIP) proteins (see MIM 165160).[supplied by OMIM, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O15525","text":"Since they lack a putative transactivation domain, the small Mafs behave as transcriptional repressors when they dimerize among themselves (PubMed:11154691). However, they seem to serve as transcriptional activators by dimerizing with other (usually larger) basic-zipper proteins, such as NFE2, NFE2L1 and NFE2L2, and recruiting them to specific DNA-binding sites (PubMed:11154691, PubMed:8932385, PubMed:9421508). Small Maf proteins heterodimerize with Fos and may act as competitive repressors of the NFE2L2 transcription factor (PubMed:11154691). Transcription factor, component of erythroid-specific transcription factor NFE2L2 (PubMed:11154691). Activates globin gene expression when associated with NFE2L2 (PubMed:11154691). May be involved in signal transduction of extracellular H(+) (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}