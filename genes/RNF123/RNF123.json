e_id":"ENSG00000164068","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.457131,"nucleus_log2fc":-0.0221751,"nucleus_score":-0.876841,"pct_ad":0.186916,"pct_control":0.191657,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0718576,"donor_lfcse":0.0695297,"donor_log2fc_shrunk":2.26968e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164068","entrez_id":["63891"],"uniprot":["Q5XPI4"],"ncbi_summary":"The protein encoded by this gene contains a C-terminal RING finger domain, a motif present in a variety of functionally distinct proteins and known to be involved in protein-protein and protein-DNA interactions, and an N-terminal SPRY domain. This protein displays E3 ubiquitin ligase activity toward the cyclin-dependent kinase inhibitor 1B which is also known as p27 or KIP1. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Feb 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5XPI4","text":"Catalytic subunit of the KPC complex that acts as E3 ubiquitin-protein ligase (PubMed:15531880, PubMed:16227581, PubMed:25860612). Promotes the ubiquitination and proteasome-mediated degradation of CDKN1B which is the cyclin-dependent kinase inhibitor at the G0-G1 transition of the cell cycle (PubMed:15531880, PubMed:16227581). Also acts as a key regulator of the NF-kappa-B signaling by promoting maturation of the NFKB1 component of NF-kappa-B: acts by catalyzing ubiquitination of the NFKB1 p105 precursor, leading to limited proteasomal degradation of NFKB1 p105 and generation of the active NFKB1 p50 subunit (PubMed:25860612, PubMed:33168738, PubMed:34873064). Also functions as an inhibitor of innate antiviral signaling mediated by RIGI and IFIH1 independently of its E3 ligase activity (PubMed:27312109). Interacts with the N-terminal CARD domains of RIGI and IFIH1 and competes with the downstream adapter MAVS (PubMed:27312109)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}