":0.999342,"donor_log2fc":-0.0752905,"donor_lfcse":0.0754886,"donor_log2fc_shrunk":-1.0904e-05},{"cell_type":"Oli","gene_symbol":"TLK1","gene_symbol_current":"TLK1","gene_id":"ENSG00000198586","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":5.40884e-07,"nucleus_log2fc":-0.0786275,"nucleus_score":-5.16785,"pct_ad":0.337705,"pct_control":0.360149,"donor_test":"not significant","donor_padj":0.974419,"donor_log2fc":-0.0233718,"donor_lfcse":0.112813,"donor_log2fc_shrunk":0.000651997}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000198586","module":"blue","kme":0.456045,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000198586","module":"yellow","kme":0.397304,"hub":false,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000198586","module":"blue","kme":0.180214,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000198586","module":"blue","kme":0.167332,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198586","entrez_id":["9874"],"uniprot":["Q9UKI8"],"ncbi_summary":"The protein encoded by this gene is a serine/threonine kinase that may be involved in the regulation of chromatin assembly. The encoded protein is only active when it is phosphorylated, and this phosphorylation is cell cycle-dependent, with the maximal activity of this protein coming during S phase. The catalytic activity of this protein is diminished by DNA damage and by blockage of DNA replication. Three transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Nov 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UKI8","text":"Rapidly and transiently inhibited by phosphorylation following the generation of DNA double-stranded breaks during S-phase. This is cell cycle checkpoint and ATM-pathway dependent and appears to regulate processes involved in chromatin assembly. Isoform 3 phosphorylates and enhances the stability of the t-SNARE SNAP23, augmenting its assembly with syntaxin. Isoform 3 protects the cells from the ionizing radiation by facilitating the repair of DSBs. In vitro, phosphorylates histone H3 at 'Ser-10'."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}