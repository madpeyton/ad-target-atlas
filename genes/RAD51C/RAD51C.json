:true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0596072,"nucleus_log2fc":-0.0081782,"nucleus_score":-1.9519,"pct_ad":0.327007,"pct_control":0.333421,"donor_test":"not significant","donor_padj":0.830712,"donor_log2fc":0.0700445,"donor_lfcse":0.0875072,"donor_log2fc_shrunk":0.0042183,"degas_log2fc":-0.0252005,"degas_padj":0.0504399},{"cell_type":"Mic","gene_symbol":"RAD51C","gene_symbol_current":"RAD51C","gene_id":"ENSG00000108384","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.833177,"nucleus_log2fc":0.00552265,"nucleus_score":0.276833,"pct_ad":0.114392,"pct_control":0.113134,"donor_test":"not significant","donor_padj":0.993168,"donor_log2fc":0.00353681,"donor_lfcse":0.0890841,"donor_log2fc_shrunk":0.000821812,"degas_log2fc":0.00681327,"degas_padj":0.940813},{"cell_type":"OPC","gene_symbol":"RAD51C","gene_symbol_current":"RAD51C","gene_id":"ENSG00000108384","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.816114,"nucleus_log2fc":0.0317085,"nucleus_score":0.365956,"pct_ad":0.209514,"pct_control":0.20779,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0298254,"donor_lfcse":0.0764783,"donor_log2fc_shrunk":5.32296e-06,"degas_log2fc":-0.095451,"degas_padj":0.138587},{"cell_type":"Oli","gene_symbol":"RAD51C","gene_symbol_current":"RAD51C","gene_id":"ENSG00000108384","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00130484,"nucleus_log2fc":0.089812,"nucleus_score":3.35755,"pct_ad":0.164389,"pct_control":0.155221,"donor_test":"not significant","donor_padj":0.874123,"donor_log2fc":0.0672509,"donor_lfcse":0.0765899,"donor_log2fc_shrunk":0.0110723,"degas_log2fc":-0.151731,"degas_padj":3.42635e-07}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000108384","entrez_id":["5889"],"uniprot":["O43502"],"ncbi_summary":"This gene is a member of the RAD51 family. RAD51 family members are highly similar to bacterial RecA and Saccharomyces cerevisiae Rad51 and are known to be involved in the homologous recombination and repair of DNA. This protein can interact with other RAD51 paralogs and is reported to be important for Holliday junction resolution. Mutations in this gene are associated with Fanconi anemia-like syndrome. This gene is one of four localized to a region of chromosome 17q23 where amplification occurs frequently in breast tumors. Overexpression of the four genes during amplification has been observed and suggests a possible role in tumor progression. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jul 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43502","text":"Essential for the homologous recombination (HR) pathway of DNA repair. Involved in the homologous recombination repair (HRR) pathway of double-stranded DNA breaks arising during DNA replication or induced by DNA-damaging agents. Part of the RAD51 paralog protein complexes BCDX2 and CX3 which act at different stages of the BRCA1-BRCA2-dependent HR pathway. Upon DNA damage, BCDX2 seems to act downstream of BRCA2 recruitment and upstream of RAD51 recruitment; CX3 seems to act downstream of RAD51 recruitment; both complexes bind predominantly to the intersection of the four duplex arms of the Holliday junction (HJ) and to junction of replication forks. The BCDX2 complex was originally reported to bind single-stranded DNA, single-stranded gaps in duplex DNA and specifically to nicks in duplex DNA. The BCDX2 subcomplex RAD51B:RAD51C exhibits single-stranded DNA-dependent ATPase activity suggesting an involvement in early stages of the HR pathway. Involved in RAD51 foci formation in response to DNA damage suggesting an involvement in early stages of HR probably in the invasion step. Has an early function in DNA repair in facilitating phosphorylation of the checkpoint kinase CHEK2 and thereby transduction of the damage signal, leading to cell cycle arrest and HR activation. Participates in branch migration and HJ resolution and thus is important for processing HR intermediates late in the DNA repair process; the function may be linked to the CX3 complex. Part of a PALB2-scaffolded HR complex containing BRCA2 and which is thought to play a role in DNA repair by HR. Protects RAD51 from ubiquitin-mediated degradation that is enhanced following DNA damage. Plays a role in regulating mitochondrial DNA copy number under conditions of oxidative stress in the presence of RAD51 and XRCC3. Contributes to DNA cross-link resistance, sister chromatid cohesion and genomic stability. Involved in maintaining centrosome number in mitosis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}