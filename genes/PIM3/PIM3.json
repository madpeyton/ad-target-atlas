_id":"ENSG00000198355","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000104403,"nucleus_log2fc":0.426139,"nucleus_score":4.38368,"pct_ad":0.12884,"pct_control":0.104657,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.284786,"donor_lfcse":0.194657,"donor_log2fc_shrunk":7.49194e-06,"degas_log2fc":0.4438,"degas_padj":2.24864e-07},{"cell_type":"Oli","gene_symbol":"PIM3","gene_symbol_current":"PIM3","gene_id":"ENSG00000198355","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":4.7669e-164,"nucleus_log2fc":0.928645,"nucleus_score":27.4417,"pct_ad":0.179237,"pct_control":0.108913,"donor_test":"not significant","donor_padj":0.194747,"donor_log2fc":0.804179,"donor_lfcse":0.223066,"donor_log2fc_shrunk":0.649834,"degas_log2fc":0.585111,"degas_padj":7.28577e-75}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000198355","module":"turquoise","kme":0.0782442,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000198355","module":"turquoise","kme":0.0841362,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000198355","module":"turquoise","kme":0.100348,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198355","entrez_id":["415116"],"uniprot":["Q86V86"],"ncbi_summary":"The protein encoded by this gene belongs to the Ser/Thr protein kinase family, and PIM subfamily. This gene is overexpressed in hematological and epithelial tumors and is associated with MYC coexpression. It plays a role in the regulation of signal transduction cascades, contributing to both cell proliferation and survival, and provides a selective advantage in tumorigenesis. [provided by RefSeq, Jun 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86V86","text":"Proto-oncogene with serine/threonine kinase activity that can prevent apoptosis, promote cell survival and protein translation. May contribute to tumorigenesis through: the delivery of survival signaling through phosphorylation of BAD which induces release of the anti-apoptotic protein Bcl-X(L), the regulation of cell cycle progression, protein synthesis and by regulation of MYC transcriptional activity. Additionally to this role on tumorigenesis, can also negatively regulate insulin secretion by inhibiting the activation of MAPK1/3 (ERK1/2), through SOCS6. Involved also in the control of energy metabolism and regulation of AMPK activity in modulating MYC and PPARGC1A protein levels and cell growth."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}