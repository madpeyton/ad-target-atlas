"donor_padj":0.505513,"donor_log2fc":-0.342119,"donor_lfcse":0.188161,"donor_log2fc_shrunk":-0.0220553,"degas_log2fc":0.757123,"degas_padj":1.4773e-52},{"cell_type":"OPC","gene_symbol":"POLB","gene_symbol_current":"POLB","gene_id":"ENSG00000070501","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.698264,"nucleus_log2fc":-0.0226504,"nucleus_score":0.582842,"pct_ad":0.185953,"pct_control":0.179678,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.00841962,"donor_lfcse":0.0741018,"donor_log2fc_shrunk":1.60636e-06,"degas_log2fc":-0.314653,"degas_padj":2.43762e-06},{"cell_type":"Oli","gene_symbol":"POLB","gene_symbol_current":"POLB","gene_id":"ENSG00000070501","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.667186,"nucleus_log2fc":-0.0193173,"nucleus_score":-0.488536,"pct_ad":0.129611,"pct_control":0.130746,"donor_test":"not significant","donor_padj":0.992934,"donor_log2fc":0.00516712,"donor_lfcse":0.0762916,"donor_log2fc_shrunk":0.000841187,"degas_log2fc":-0.190132,"degas_padj":8.49151e-09}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000070501","module":"blue","kme":0.135326,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000070501","module":"blue","kme":0.297645,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000070501","module":"green","kme":0.18724,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000070501","entrez_id":["5423"],"uniprot":["P06746"],"ncbi_summary":"The protein encoded by this gene is a DNA polymerase involved in base excision and repair, also called gap-filling DNA synthesis. The encoded protein, acting as a monomer, is normally found in the cytoplasm, but it translocates to the nucleus upon DNA damage. Several transcript variants of this gene exist, but the full-length nature of only one has been described to date. [provided by RefSeq, Sep 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P06746","text":"Repair polymerase that plays a key role in base-excision repair (PubMed:10556592, PubMed:9207062, PubMed:9572863). During this process, the damaged base is excised by specific DNA glycosylases, the DNA backbone is nicked at the abasic site by an apurinic/apyrimidic (AP) endonuclease, and POLB removes 5'-deoxyribose-phosphate from the preincised AP site acting as a 5'-deoxyribose-phosphate lyase (5'-dRP lyase); through its DNA polymerase activity, it adds one nucleotide to the 3' end of the arising single-nucleotide gap (PubMed:10556592, PubMed:17526740, PubMed:8841119, PubMed:9556598, PubMed:9572863, PubMed:9614142). Conducts 'gap-filling' DNA synthesis in a stepwise distributive fashion rather than in a processive fashion as for other DNA polymerases. It is also able to cleave sugar-phosphate bonds 3' to an intact AP site, acting as an AP lyase (PubMed:9614142)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}