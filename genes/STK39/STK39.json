leus_padj":0.324887,"nucleus_log2fc":-0.0399869,"nucleus_score":-1.32289,"pct_ad":0.723979,"pct_control":0.72989,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0640567,"donor_lfcse":0.0857488,"donor_log2fc_shrunk":-8.99602e-06},{"cell_type":"Oli","gene_symbol":"STK39","gene_symbol_current":"STK39","gene_id":"ENSG00000198648","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.310273,"nucleus_log2fc":-0.0206917,"nucleus_score":-1.11249,"pct_ad":0.746555,"pct_control":0.755873,"donor_test":"not significant","donor_padj":0.991009,"donor_log2fc":-0.00877602,"donor_lfcse":0.107951,"donor_log2fc_shrunk":-0.000748261}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000198648","module":"brown","kme":0.128691,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000198648","module":"green","kme":0.334307,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000198648","module":"turquoise","kme":0.169016,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000198648","module":"brown","kme":0.263078,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000198648","module":"blue","kme":0.313494,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198648","entrez_id":["27347"],"uniprot":["Q9UEW8"],"ncbi_summary":"This gene encodes a serine/threonine kinase that is thought to function in the cellular stress response pathway. The kinase is activated in response to hypotonic stress, leading to phosphorylation of several cation-chloride-coupled cotransporters. The catalytically active kinase specifically activates the p38 MAP kinase pathway, and its interaction with p38 decreases upon cellular stress, suggesting that this kinase may serve as an intermediate in the response to cellular stress. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UEW8","text":"Effector serine/threonine-protein kinase component of the WNK-SPAK/OSR1 kinase cascade, which is involved in various processes, such as ion transport, response to hypertonic stress and blood pressure (PubMed:16669787, PubMed:18270262, PubMed:21321328, PubMed:34289367). Specifically recognizes and binds proteins with a RFXV motif (PubMed:16669787, PubMed:21321328). Acts downstream of WNK kinases (WNK1, WNK2, WNK3 or WNK4): following activation by WNK kinases, catalyzes phosphorylation of ion cotransporters, such as SLC12A1/NKCC2, SLC12A2/NKCC1, SLC12A3/NCC, SLC12A5/KCC2 or SLC12A6/KCC3, regulating their activity (PubMed:21321328). Mediates regulatory volume increase in response to hyperosmotic stress by catalyzing phosphorylation of ion cotransporters SLC12A1/NKCC2, SLC12A2/NKCC1 and SLC12A6/KCC3 downstream of WNK1 and WNK3 kinases (PubMed:12740379, PubMed:16669787, PubMed:21321328). Phosphorylation of Na-K-Cl cotransporters SLC12A2/NKCC1 and SLC12A2/NKCC1 promote their activation and ion influx; simultaneously, phosphorylation of K-Cl cotransporters SLC12A5/KCC2 and SLC12A6/KCC3 inhibit their activity, blocking ion efflux (PubMed:16669787, PubMed:19665974, PubMed:21321328). Acts as a regulator of NaCl reabsorption in the distal nephron by mediating phosphorylation and activation of the thiazide-sensitive Na-Cl cotransporter SLC12A3/NCC in distal convoluted tubule cells of kidney downstream of WNK4 (PubMed:18270262). Mediates the inhibition of SLC4A4, SLC26A6 as well as CFTR activities (By similarity). Phosphorylates RELT (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}