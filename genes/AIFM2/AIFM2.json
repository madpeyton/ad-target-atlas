cant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.843634,"donor_log2fc":0.103119,"donor_lfcse":0.133578,"donor_log2fc_shrunk":0.0113434,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"AIFM2","gene_symbol_current":"AIFM2","gene_id":"ENSG00000042286","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.812776,"nucleus_log2fc":-0.0634264,"nucleus_score":-0.371576,"pct_ad":0.102595,"pct_control":0.104149,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0101406,"donor_lfcse":0.123601,"donor_log2fc_shrunk":-6.8896e-07,"degas_log2fc":-0.119005,"degas_padj":0.205991},{"cell_type":"Oli","gene_symbol":"AIFM2","gene_symbol_current":"AIFM2","gene_id":"ENSG00000042286","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.726115,"donor_log2fc":-0.144428,"donor_lfcse":0.0963461,"donor_log2fc_shrunk":-0.0182726,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000042286","module":"blue","kme":0.145182,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000042286","entrez_id":["84883"],"uniprot":["Q9BRQ8"],"ncbi_summary":"This gene encodes a flavoprotein oxidoreductase that binds single stranded DNA and is thought to contribute to apoptosis in the presence of bacterial and viral DNA. The expression of this gene is also found to be induced by tumor suppressor protein p53 in colon cancer cells. [provided by RefSeq, Nov 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BRQ8","text":"A NAD(P)H-dependent oxidoreductase that acts as a key inhibitor of ferroptosis (PubMed:31634899, PubMed:31634900, PubMed:35922516, PubMed:36788244, PubMed:37957306, PubMed:39881208, PubMed:37739993, PubMed:39160155, PubMed:38414669, PubMed:40233740). At the plasma membrane, catalyzes reduction of coenzyme Q/ubiquinone-10 to ubiquinol-10, a lipophilic radical-trapping antioxidant that prevents lipid oxidative damage and consequently ferroptosis (PubMed:31634899, PubMed:31634900, PubMed:37739993, PubMed:39160155, PubMed:38414669, PubMed:40233740). Acts in parallel to GPX4 to suppress phospholipid peroxidation and ferroptosis (PubMed:31634899, PubMed:31634900). This anti-ferroptotic function is independent of cellular glutathione levels (PubMed:31634899, PubMed:31634900). Also acts as a potent radical-trapping antioxidant by mediating warfarin-resistant vitamin K reduction in the canonical vitamin K cycle: catalyzes NAD(P)H-dependent reduction of vitamin K (phylloquinone, menaquinone-4 and menadione) to hydroquinone forms (PubMed:35922516, PubMed:36788244). Hydroquinones act as potent radical-trapping antioxidants inhibitor of phospholipid peroxidation and ferroptosis (PubMed:35922516). May play a role in mitochondrial stress signaling (PubMed:26689472). Upon oxidative stress, associates with the lipid peroxidation end product 4-hydroxy-2-nonenal (HNE) forming a lipid adduct devoid of oxidoreductase activity, which then translocates from mitochondria into the nucleus triggering DNA damage and cell death (PubMed:26689472). Capable of DNA binding in a non-sequence specific way (PubMed:15958387)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}