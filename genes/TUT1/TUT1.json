not significant","donor_padj":0.545062,"donor_log2fc":-0.175967,"donor_lfcse":0.0731733,"donor_log2fc_shrunk":-0.0557958},{"cell_type":"In","gene_symbol":"TUT1","gene_symbol_current":"TUT1","gene_id":"ENSG00000149016","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.8491e-34,"nucleus_log2fc":-0.217935,"nucleus_score":-12.3618,"pct_ad":0.0982378,"pct_control":0.116533,"donor_test":"not significant","donor_padj":0.691677,"donor_log2fc":-0.159229,"donor_lfcse":0.0723904,"donor_log2fc_shrunk":-0.0166343},{"cell_type":"Mic","gene_symbol":"TUT1","gene_symbol_current":"TUT1","gene_id":"ENSG00000149016","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.787736,"donor_log2fc":0.124267,"donor_lfcse":0.132764,"donor_log2fc_shrunk":0.0143001},{"cell_type":"OPC","gene_symbol":"TUT1","gene_symbol_current":"TUT1","gene_id":"ENSG00000149016","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.867127,"donor_log2fc":-0.483383,"donor_lfcse":0.157851,"donor_log2fc_shrunk":-0.333284},{"cell_type":"Oli","gene_symbol":"TUT1","gene_symbol_current":"TUT1","gene_id":"ENSG00000149016","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.718081,"donor_log2fc":-0.144334,"donor_lfcse":0.0937894,"donor_log2fc_shrunk":-0.0189349}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000149016","entrez_id":["64852"],"uniprot":["Q9H6E5"],"ncbi_summary":"This gene encodes a nucleotidyl transferase that functions as both a terminal uridylyltransferase and a nuclear poly(A) polymerase. The encoded enzyme specifically adds and removes nucleotides from the 3' end of small nuclear RNAs and select mRNAs and may function in controlling gene expression and cell proliferation.[provided by RefSeq, Apr 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H6E5","text":"Poly(A) polymerase that creates the 3'-poly(A) tail of specific pre-mRNAs (PubMed:18288197, PubMed:21102410). Localizes to nuclear speckles together with PIP5K1A and mediates polyadenylation of a select set of mRNAs, such as HMOX1 (PubMed:18288197). In addition to polyadenylation, it is also required for the 3'-end cleavage of pre-mRNAs: binds to the 3'UTR of targeted pre-mRNAs and promotes the recruitment and assembly of the CPSF complex on the 3'UTR of pre-mRNAs (PubMed:21102410). In addition to adenylyltransferase activity, also has uridylyltransferase activity (PubMed:16790842, PubMed:18288197, PubMed:28589955). However, the ATP ratio is higher than UTP in cells, suggesting that it functions primarily as a poly(A) polymerase (PubMed:18288197). Acts as a specific terminal uridylyltransferase for U6 snRNA in vitro: responsible for a controlled elongation reaction that results in the restoration of the four 3'-terminal UMP-residues found in newly transcribed U6 snRNA (PubMed:16790842, PubMed:18288197, PubMed:28589955). Not involved in replication-dependent histone mRNA degradation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}