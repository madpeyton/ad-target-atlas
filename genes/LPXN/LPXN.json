module_padj":0.554841,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000110031"],"dataset_symbols":["LPXN"],"explorer":"explorer.html?dataset=mathys2019#gene/LPXN","cell_types":[{"cell_type":"Ex","gene_symbol":"LPXN","gene_symbol_current":"LPXN","gene_id":"ENSG00000110031","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00186605,"nucleus_log2fc":-0.235799,"nucleus_score":-3.37779,"pct_ad":0.0890898,"pct_control":0.10209,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.168631,"donor_lfcse":0.143447,"donor_log2fc_shrunk":-1.23656e-05},{"cell_type":"Oli","gene_symbol":"LPXN","gene_symbol_current":"LPXN","gene_id":"ENSG00000110031","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.949633,"donor_log2fc":0.0634535,"donor_lfcse":0.157312,"donor_log2fc_shrunk":0.00181669}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000110031","entrez_id":["9404"],"uniprot":["O60711"],"ncbi_summary":"The product encoded by this gene is preferentially expressed in hematopoietic cells and belongs to the paxillin protein family. Similar to other members of this focal-adhesion-associated adaptor-protein family, it has four leucine-rich LD-motifs in the N-terminus and four LIM domains in the C-terminus. It may function in cell type-specific signaling by associating with PYK2, a member of focal adhesion kinase family. As a substrate for a tyrosine kinase in lymphoid cells, this protein may also function in, and be regulated by, tyrosine kinase activity. Alternative splicing results in multiple transcript variants encoding distinct isoforms.[provided by RefSeq, Jan 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60711","text":"Transcriptional coactivator for androgen receptor (AR) and serum response factor (SRF). Contributes to the regulation of cell adhesion, spreading and cell migration and acts as a negative regulator in integrin-mediated cell adhesion events. Suppresses the integrin-induced tyrosine phosphorylation of paxillin (PXN). May play a critical role as an adapter protein in the formation of the adhesion zone in osteoclasts. Negatively regulates B-cell antigen receptor (BCR) signaling."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}