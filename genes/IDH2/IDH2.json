g2fc":-0.238155,"donor_lfcse":0.142183,"donor_log2fc_shrunk":-0.0118054}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000182054","module":"brown","kme":0.204564,"hub":false,"module_direction":"lower in AD","module_padj":0.652213,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000182054","module":"blue","kme":0.115768,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000182054","module":"turquoise","kme":0.152675,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000182054","entrez_id":["3418"],"uniprot":["P48735"],"ncbi_summary":"Isocitrate dehydrogenases catalyze the oxidative decarboxylation of isocitrate to 2-oxoglutarate. These enzymes belong to two distinct subclasses, one of which utilizes NAD(+) as the electron acceptor and the other NADP(+). Five isocitrate dehydrogenases have been reported: three NAD(+)-dependent isocitrate dehydrogenases, which localize to the mitochondrial matrix, and two NADP(+)-dependent isocitrate dehydrogenases, one of which is mitochondrial and the other predominantly cytosolic. Each NADP(+)-dependent isozyme is a homodimer. The protein encoded by this gene is the NADP(+)-dependent isocitrate dehydrogenase found in the mitochondria. It plays a role in intermediary metabolism and energy production. This protein may tightly associate or interact with the pyruvate dehydrogenase complex. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Feb 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P48735","text":"Plays a role in intermediary metabolism and energy production (PubMed:19228619, PubMed:22416140). It may tightly associate or interact with the pyruvate dehydrogenase complex (PubMed:19228619, PubMed:22416140)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}