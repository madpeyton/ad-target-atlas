4,"donor_test":"not significant","donor_padj":0.994258,"donor_log2fc":-0.0307483,"donor_lfcse":0.118517,"donor_log2fc_shrunk":-2.28948e-06}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000114491","module":"purple","kme":0.129118,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000114491","entrez_id":["7372"],"uniprot":["P11172"],"ncbi_summary":"This gene encodes a uridine 5'-monophosphate synthase. The encoded protein is a bifunctional enzyme that catalyzes the final two steps of the de novo pyrimidine biosynthetic pathway. The first reaction is carried out by the N-terminal enzyme orotate phosphoribosyltransferase which converts orotic acid to orotidine-5'-monophosphate. The terminal reaction is carried out by the C-terminal enzyme OMP decarboxylase which converts orotidine-5'-monophosphate to uridine monophosphate. Defects in this gene are the cause of hereditary orotic aciduria. Alternate splicing results in multiple transcript variants. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P11172","text":"Bifunctional enzyme catalyzing the last two steps of de novo pyrimidine biosynthesis, orotate phosphoribosyltransferase (OPRT), which converts orotate to orotidine-5'-monophosphate (OMP), and orotidine-5'-monophosphate decarboxylase (ODC), the terminal enzymatic reaction that decarboxylates OMP to uridine monophosphate (UMP)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}