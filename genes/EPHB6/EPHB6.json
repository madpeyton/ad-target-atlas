ce":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O15197","text":"Kinase-defective receptor for members of the ephrin-B family. Binds to ephrin-B1 and ephrin-B2. Modulates cell adhesion and migration by exerting both positive and negative effects upon stimulation with ephrin-B2. Inhibits JNK activation, T-cell receptor-induced IL-2 secretion and CD25 expression upon stimulation with ephrin-B2 (PubMed:12517763, PubMed:15955811). Can recruit SH2 domain-containing signaling adapters following phosphorylation by EPHB4 (PubMed:34431498)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}