","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.33892,"nucleus_log2fc":-0.0143485,"nucleus_score":-1.1081,"pct_ad":0.119667,"pct_control":0.12506,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":-0.0603898,"donor_lfcse":0.129564,"donor_log2fc_shrunk":-3.69535e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000155252","module":"turquoise","kme":0.130457,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000155252","entrez_id":["55361"],"uniprot":["Q9BTU6"],"ncbi_summary":"Phosphatidylinositolpolyphosphates (PtdInsPs) are centrally involved in many biologic processes, ranging from cell growth and organization of the actin cytoskeleton to endo- and exocytosis. PI4KII phosphorylates PtdIns at the D-4 position, an essential step in the biosynthesis of PtdInsPs (Barylko et al., 2001 [PubMed 11244087]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BTU6","text":"Membrane-bound phosphatidylinositol-4 kinase (PI4-kinase) that catalyzes the phosphorylation of phosphatidylinositol (PI) to phosphatidylinositol 4-phosphate (PI4P), a lipid that plays important roles in endocytosis, Golgi function, protein sorting and membrane trafficking and is required for prolonged survival of neurons. Besides, phosphorylation of phosphatidylinositol (PI) to phosphatidylinositol 4-phosphate (PI4P) is the first committed step in the generation of phosphatidylinositol 4,5-bisphosphate (PIP2), a precursor of the second messenger inositol 1,4,5-trisphosphate (InsP3)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}