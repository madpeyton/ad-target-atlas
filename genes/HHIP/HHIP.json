:false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000164161"],"dataset_symbols":["HHIP"],"explorer":"explorer.html?dataset=mathys2019#gene/HHIP","cell_types":[{"cell_type":"Ex","gene_symbol":"HHIP","gene_symbol_current":"HHIP","gene_id":"ENSG00000164161","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":5.14818e-06,"nucleus_log2fc":-0.31071,"nucleus_score":-4.88279,"pct_ad":0.11987,"pct_control":0.141091,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.192116,"donor_lfcse":0.233088,"donor_log2fc_shrunk":-3.74115e-06},{"cell_type":"Oli","gene_symbol":"HHIP","gene_symbol_current":"HHIP","gene_id":"ENSG00000164161","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.37056,"nucleus_log2fc":0.0521662,"nucleus_score":1.11739,"pct_ad":0.402094,"pct_control":0.388918,"donor_test":"not significant","donor_padj":0.883812,"donor_log2fc":-0.0703034,"donor_lfcse":0.0898719,"donor_log2fc_shrunk":-0.00824061}],"modules":[{"cell_type":"In","gene_id":"ENSG00000164161","module":"turquoise","kme":0.160595,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000164161","module":"turquoise","kme":0.130492,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164161","entrez_id":["64399"],"uniprot":["Q96QV1"],"ncbi_summary":"This gene encodes a member of the hedgehog-interacting protein (HHIP) family. The hedgehog (HH) proteins are evolutionarily conserved protein, which are important morphogens for a wide range of developmental processes, including anteroposterior patterns of limbs and regulation of left-right asymmetry in embryonic development. Multiple cell-surface receptors are responsible for transducing and/or regulating HH signals. The HHIP encoded by this gene is a highly conserved, vertebrate-specific inhibitor of HH signaling. It interacts with all three HH family members, SHH, IHH and DHH. Two single nucleotide polymorphisms (SNPs) near this gene are significantly associated with risk of chronic obstructive pulmonary disease (COPD). A single nucleotide polymorphism in this gene is also strongly associated with human height.[provided by RefSeq, Feb 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96QV1","text":"Modulates hedgehog signaling in several cell types including brain and lung through direct interaction with members of the hedgehog family."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}