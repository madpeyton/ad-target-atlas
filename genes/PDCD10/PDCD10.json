10","gene_id":"ENSG00000114209","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.53324e-08,"nucleus_log2fc":0.276355,"nucleus_score":5.9789,"pct_ad":0.273723,"pct_control":0.23894,"donor_test":"not significant","donor_padj":0.137472,"donor_log2fc":0.230688,"donor_lfcse":0.072296,"donor_log2fc_shrunk":0.179412,"degas_log2fc":-0.0512367,"degas_padj":0.321419},{"cell_type":"OPC","gene_symbol":"PDCD10","gene_symbol_current":"PDCD10","gene_id":"ENSG00000114209","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000131889,"nucleus_log2fc":0.247877,"nucleus_score":4.32571,"pct_ad":0.265732,"pct_control":0.234378,"donor_test":"not significant","donor_padj":0.867127,"donor_log2fc":0.248149,"donor_lfcse":0.0808517,"donor_log2fc_shrunk":0.174582,"degas_log2fc":-0.186829,"degas_padj":0.00103956},{"cell_type":"Oli","gene_symbol":"PDCD10","gene_symbol_current":"PDCD10","gene_id":"ENSG00000114209","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0796608,"nucleus_log2fc":0.0575729,"nucleus_score":1.8766,"pct_ad":0.263988,"pct_control":0.259357,"donor_test":"not significant","donor_padj":0.805852,"donor_log2fc":0.0606556,"donor_lfcse":0.0500044,"donor_log2fc_shrunk":0.0216467,"degas_log2fc":-0.126637,"degas_padj":4.28725e-08}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000114209","module":"turquoise","kme":0.0764011,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000114209","module":"turquoise","kme":0.0548507,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000114209","entrez_id":["11235"],"uniprot":["Q9BUL8"],"ncbi_summary":"This gene encodes an evolutionarily conserved protein associated with cell apoptosis. The protein interacts with the serine/threonine protein kinase MST4 to modulate the extracellular signal-regulated kinase (ERK) pathway. It also interacts with and is phosphoryated by serine/threonine kinase 25, and is thought to function in a signaling pathway essential for vascular developent. Mutations in this gene are one cause of cerebral cavernous malformations, which are vascular malformations that cause seizures and cerebral hemorrhages. Multiple alternatively spliced variants, encoding the same protein, have been identified. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BUL8","text":"Promotes cell proliferation. Modulates apoptotic pathways. Increases mitogen-activated protein kinase activity and STK26 activity (PubMed:27807006). Important for cell migration, and for normal structure and assembly of the Golgi complex (PubMed:27807006). Part of the striatin-interacting phosphatase and kinase (STRIPAK) complexes. STRIPAK complexes have critical roles in protein (de)phosphorylation and are regulators of multiple signaling pathways including Hippo, MAPK, nuclear receptor and cytoskeleton remodeling. Different types of STRIPAK complexes are involved in a variety of biological processes such as cell growth, differentiation, apoptosis, metabolism and immune regulation (PubMed:18782753). Important for KDR/VEGFR2 signaling. Increases the stability of KDR/VEGFR2 and prevents its breakdown. Required for normal cardiovascular development. Required for normal angiogenesis, vasculogenesis and hematopoiesis during embryonic development (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}