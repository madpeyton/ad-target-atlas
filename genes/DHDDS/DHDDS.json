ue,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.10873e-07,"nucleus_log2fc":-0.215612,"nucleus_score":-5.65216,"pct_ad":0.210788,"pct_control":0.243021,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.126925,"donor_lfcse":0.125022,"donor_log2fc_shrunk":-8.23531e-06},{"cell_type":"In","gene_symbol":"DHDDS","gene_symbol_current":"DHDDS","gene_id":"ENSG00000117682","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.381234,"nucleus_log2fc":-0.243035,"nucleus_score":-1.78575,"pct_ad":0.134428,"pct_control":0.149393,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.254101,"donor_lfcse":0.167408,"donor_log2fc_shrunk":-9.44878e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000117682","module":"brown","kme":0.208791,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000117682","entrez_id":["79947"],"uniprot":["Q86SQ9"],"ncbi_summary":"The protein encoded by this gene catalyzes cis-prenyl chain elongation to produce the polyprenyl backbone of dolichol, a glycosyl carrier lipid required for the biosynthesis of several classes of glycoproteins. Mutations in this gene are associated with retinitis pigmentosa type 59. Alternatively spliced transcript variants encoding different isoforms have been described for this gene. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86SQ9","text":"With NUS1, forms the dehydrodolichyl diphosphate synthase (DDS) complex, an essential component of the dolichol monophosphate (Dol-P) biosynthetic machinery (PubMed:25066056, PubMed:28842490, PubMed:32817466, PubMed:33077723). Both subunits contribute to enzymatic activity, i.e. condensation of multiple copies of isopentenyl pyrophosphate (IPP) to farnesyl pyrophosphate (FPP) to produce dehydrodolichyl diphosphate (Dedol-PP), a precursor of dolichol phosphate which is utilized as a sugar carrier in protein glycosylation in the endoplasmic reticulum (ER) (PubMed:25066056, PubMed:28842490, PubMed:32817466, PubMed:33077723). Synthesizes long-chain polyprenols, mostly of C95 and C100 chain length (PubMed:32817466). Regulates the glycosylation and stability of nascent NPC2, thereby promoting trafficking of LDL-derived cholesterol (PubMed:21572394)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}