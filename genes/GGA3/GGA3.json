":"turquoise","kme":0.156333,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000125447"],"dataset_symbols":["GGA3"],"explorer":"explorer.html?dataset=mathys2019#gene/GGA3","cell_types":[{"cell_type":"Ex","gene_symbol":"GGA3","gene_symbol_current":"GGA3","gene_id":"ENSG00000125447","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.94316e-05,"nucleus_log2fc":-0.157025,"nucleus_score":-4.41602,"pct_ad":0.210788,"pct_control":0.236322,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.101631,"donor_lfcse":0.0638391,"donor_log2fc_shrunk":-2.40771e-05},{"cell_type":"In","gene_symbol":"GGA3","gene_symbol_current":"GGA3","gene_id":"ENSG00000125447","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.746758,"nucleus_log2fc":-0.055958,"nucleus_score":0.829987,"pct_ad":0.125998,"pct_control":0.11578,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0116298,"donor_lfcse":0.142209,"donor_log2fc_shrunk":6.08752e-07},{"cell_type":"Oli","gene_symbol":"GGA3","gene_symbol_current":"GGA3","gene_id":"ENSG00000125447","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.868589,"donor_log2fc":-0.135814,"donor_lfcse":0.147528,"donor_log2fc_shrunk":-0.00607863}],"modules":[],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000125447","entrez_id":["23163"],"uniprot":["Q9NZ52"],"ncbi_summary":"This gene encodes a member of the Golgi-localized, gamma adaptin ear-containing, ARF-binding (GGA) family. This family includes ubiquitous coat proteins that regulate the trafficking of proteins between the trans-Golgi network and the lysosome. These proteins share an amino-terminal VHS domain which mediates sorting of the mannose 6-phosphate receptors at the trans-Golgi network. They also contain a carboxy-terminal region with homology to the ear domain of gamma-adaptins. Multiple alternatively spliced transcript variants have been identified in this gene. [provided by RefSeq, Feb 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NZ52","text":"Plays a role in protein sorting and trafficking between the trans-Golgi network (TGN) and endosomes. Mediates the ARF-dependent recruitment of clathrin to the TGN and binds ubiquitinated proteins and membrane cargo molecules with a cytosolic acidic cluster-dileucine (DXXLL) motif (PubMed:11301005). Mediates export of the GPCR receptor ADRA2B to the cell surface (PubMed:26811329). nvolved in BACE1 transport and sorting as well as regulation of BACE1 protein levels (PubMed:15615712, PubMed:17553422, PubMed:20484053). Regulates retrograde transport of BACE1 from endosomes to the trans-Golgi network via interaction through the VHS motif and dependent of BACE1 phosphorylation (PubMed:15615712). Modulates BACE1 protein levels independently of the interaction between VHS domain and DXXLL motif through recognition of ubiquitination (PubMed:20484053). Key player in a novel DXXLL-mediated endosomal sorting machinery to the recycling pathway that targets NTRK1 to the plasma membrane (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}