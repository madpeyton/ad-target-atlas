id":"ENSG00000100387","module":"turquoise","kme":0.140205,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000100387","module":"turquoise","kme":0.226457,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000100387","module":"turquoise","kme":0.141671,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000100387","module":"turquoise","kme":0.119204,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000100387"],"dataset_symbols":["RBX1"],"explorer":"explorer.html?dataset=mathys2019#gene/RBX1","cell_types":[{"cell_type":"Ex","gene_symbol":"RBX1","gene_symbol_current":"RBX1","gene_id":"ENSG00000100387","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0276542,"nucleus_log2fc":-0.0491126,"nucleus_score":-2.43054,"pct_ad":0.451443,"pct_control":0.48365,"donor_test":"not significant","donor_padj":0.992213,"donor_log2fc":0.0297146,"donor_lfcse":0.0914427,"donor_log2fc_shrunk":3.7104e-06},{"cell_type":"In","gene_symbol":"RBX1","gene_symbol_current":"RBX1","gene_id":"ENSG00000100387","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.568558,"nucleus_log2fc":-0.113874,"nucleus_score":-1.29712,"pct_ad":0.2937,"pct_control":0.3047,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0176395,"donor_lfcse":0.137712,"donor_log2fc_shrunk":-9.61013e-07},{"cell_type":"OPC","gene_symbol":"RBX1","gene_symbol_current":"RBX1","gene_id":"ENSG00000100387","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.362646,"nucleus_log2fc":0.327397,"nucleus_score":1.64245,"pct_ad":0.115385,"pct_control":0.0957854,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"RBX1","gene_symbol_current":"RBX1","gene_id":"ENSG00000100387","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.947633,"donor_log2fc":0.0533615,"donor_lfcse":0.127123,"donor_log2fc_shrunk":0.00306955}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000100387","module":"turquoise","kme":0.279781,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000100387","module":"turquoise","kme":0.266261,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000100387","module":"turquoise","kme":0.138805,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100387","entrez_id":["9978"],"uniprot":["P62877"],"ncbi_summary":"This locus encodes a RING finger-like domain-containing protein. The encoded protein interacts with cullin proteins and likely plays a role in ubiquitination processes necessary for cell cycle progression. This protein may also affect protein turnover. Related pseudogenes exist on chromosomes 2 and 5.[provided by RefSeq, Sep 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P62877","text":"E3 ubiquitin ligase component of multiple cullin-RING-based E3 ubiquitin-protein ligase (CRLs) complexes which mediate the ubiquitination and subsequent proteasomal degradation of target proteins, including proteins involved in cell cycle progression, signal transduction, transcription and transcription-coupled nucleotide excision repair (PubMed:10230407, PubMed:10579999, PubMed:11961546, PubMed:15983046, PubMed:16678110, PubMed:19112177, PubMed:19679664, PubMed:22748924, PubMed:23455478, PubMed:27565346, PubMed:29769719, PubMed:32355176, PubMed:33417871, PubMed:37844242, PubMed:38326650, PubMed:39504960, PubMed:39667934, PubMed:38316879). CRLs complexes and ARIH1 collaborate in tandem to mediate ubiquitination of target proteins, ARIH1 mediating addition of the first ubiquitin on CRLs targets (PubMed:27565346). The functional specificity of the E3 ubiquitin-protein ligase complexes depends on the variable substrate recognition components. As a component of the CSA complex mediates ubiquitination of Pol II subunit POLR2A at 'Lys-1268', a critical TC-NER checkpoint (PubMed:32355176, PubMed:34526721). Core component of the Cul7-RING(FBXW8) ubiquitin ligase complex, which mediates the ubiquitination and subsequent proteasomal degradation of target proteins (PubMed:35982156). Core component of a Cul9-RING ubiquitin ligase complex composed of CUL9 and RBX1, which mediates mono-ubiquitination of p53/TP53 (PubMed:38605244). Recruits the E2 ubiquitin-conjugating enzyme CDC34 to the complex and brings it into close proximity to the substrate. Probably also stimulates CDC34 autoubiquitination. May be required for histone H3 and histone H4 ubiquitination in response to ultraviolet and for subsequent DNA repair. Promotes the neddylation of CUL1, CUL2, CUL4 and CUL4 via its interaction with UBE2M. Involved in the ubiquitination of KEAP1, ENC1 and KLHL41. In concert with ATF2 and CUL3, promotes degradation of KAT5 thereby attenuating its ability to acetylate and activate ATM. As part of a multisubunit complex composed of elongin BC complex (ELOB and ELOC), elongin A/ELOA, RBX1 and CUL5; polyubiquitinates monoubiquitinated POLR2A (PubMed:19920177)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}