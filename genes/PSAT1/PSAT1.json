l_type":"Oli","gene_symbol":"PSAT1","gene_symbol_current":"PSAT1","gene_id":"ENSG00000135069","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.64674e-11,"nucleus_log2fc":0.147251,"nucleus_score":6.82406,"pct_ad":0.375516,"pct_control":0.355344,"donor_test":"not significant","donor_padj":0.831946,"donor_log2fc":0.129967,"donor_lfcse":0.119661,"donor_log2fc_shrunk":0.00970865}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000135069","module":"magenta","kme":0.210106,"hub":false,"module_direction":"higher in AD","module_padj":0.456482,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000135069","entrez_id":["29968"],"uniprot":["Q9Y617"],"ncbi_summary":"This gene encodes a member of the class-V pyridoxal-phosphate-dependent aminotransferase family. The encoded protein is a phosphoserine aminotransferase and decreased expression may be associated with schizophrenia. Mutations in this gene are also associated with phosphoserine aminotransferase deficiency. Alternative splicing results in multiple transcript variants. Pseudogenes of this gene have been defined on chromosomes 1, 3, and 8. [provided by RefSeq, Jul 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y617","text":"Involved in L-serine biosynthesis via the phosphorylated pathway, a three-step pathway converting the glycolytic intermediate 3-phospho-D-glycerate into L-serine (PubMed:36851825, PubMed:37627284). Catalyzes the second step, that is the pyridoxal 5'-phosphate-dependent transamination of 3-phosphohydroxypyruvate and L-glutamate to O-phosphoserine (OPS) and alpha-ketoglutarate (PubMed:36851825, PubMed:37627284). Acts as an inhibitor of ferroptosis in response to interferon-gamma (IFNG) by promoting GPX4 stability: following phosphorylation by CAMK2A, PSAT1 interacts with GPX4 and provides 2-oxoglutarate to EGLN3, leading to GPX4 hydroxylation and stability (PubMed:40281343)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}