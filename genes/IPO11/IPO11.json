donor_lfcse":0.0822386,"donor_log2fc_shrunk":-0.0359017},{"cell_type":"OPC","gene_symbol":"IPO11","gene_symbol_current":"IPO11","gene_id":"ENSG00000086200","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.312022,"nucleus_log2fc":-0.0740037,"nucleus_score":-1.35493,"pct_ad":0.257232,"pct_control":0.266892,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0437834,"donor_lfcse":0.0836711,"donor_log2fc_shrunk":5.9767e-06},{"cell_type":"Oli","gene_symbol":"IPO11","gene_symbol_current":"IPO11","gene_id":"ENSG00000086200","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.38497e-05,"nucleus_log2fc":-0.0869098,"nucleus_score":-4.37825,"pct_ad":0.218493,"pct_control":0.233309,"donor_test":"not significant","donor_padj":0.941143,"donor_log2fc":-0.0361814,"donor_lfcse":0.0754809,"donor_log2fc_shrunk":-0.00533132}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000086200","module":"blue","kme":0.189376,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000086200","entrez_id":["51194"],"uniprot":["Q9UI26"],"ncbi_summary":"Importins, including IPO11, are a members of the karyopherin/importin-beta family of transport receptors (see KPNB1; 602738) that mediate nucleocytoplasmic transport of protein and RNA cargoes (Plafker and Macara, 2000 [PubMed 11032817]).[supplied by OMIM, Sep 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UI26","text":"Functions in nuclear protein import as nuclear transport receptor. Serves as receptor for nuclear localization signals (NLS) in cargo substrates. Is thought to mediate docking of the importin/substrate complex to the nuclear pore complex (NPC) through binding to nucleoporin and the complex is subsequently translocated through the pore by an energy requiring, Ran-dependent mechanism. At the nucleoplasmic side of the NPC, Ran binds to the importin, the importin/substrate complex dissociates and importin is re-exported from the nucleus to the cytoplasm where GTP hydrolysis releases Ran. The directionality of nuclear import is thought to be conferred by an asymmetric distribution of the GTP- and GDP-bound forms of Ran between the cytoplasm and nucleus (By similarity). Mediates the nuclear import of UBE2E3, and of RPL12 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}