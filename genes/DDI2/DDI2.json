thys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000197312"],"dataset_symbols":["DDI2"],"explorer":"explorer.html?dataset=mathys2019#gene/DDI2","cell_types":[{"cell_type":"Ex","gene_symbol":"DDI2","gene_symbol_current":"DDI2","gene_id":"ENSG00000197312","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.139901,"nucleus_log2fc":-0.0267999,"nucleus_score":-1.66618,"pct_ad":0.260666,"pct_control":0.272611,"donor_test":"not significant","donor_padj":0.999523,"donor_log2fc":-0.00251403,"donor_lfcse":0.0660934,"donor_log2fc_shrunk":-6.35181e-05},{"cell_type":"In","gene_symbol":"DDI2","gene_symbol_current":"DDI2","gene_id":"ENSG00000197312","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.678243,"nucleus_log2fc":-0.156723,"nucleus_score":-1.03935,"pct_ad":0.153505,"pct_control":0.162465,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.108498,"donor_lfcse":0.125366,"donor_log2fc_shrunk":-7.1734e-06},{"cell_type":"Oli","gene_symbol":"DDI2","gene_symbol_current":"DDI2","gene_id":"ENSG00000197312","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.984481,"donor_log2fc":0.0174736,"donor_lfcse":0.15897,"donor_log2fc_shrunk":0.000650939}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000197312","module":"red","kme":0.0804597,"hub":false,"module_direction":"lower in AD","module_padj":0.32433,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000197312","entrez_id":["84301"],"uniprot":["Q5TDH0"],"ncbi_summary":"Enables aspartic-type endopeptidase activity; identical protein binding activity; and ubiquitin binding activity. Involved in several processes, including cellular response to hydroxyurea; proteolysis; and regulation of DNA stability. Located in cytosol and nucleoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5TDH0","text":"Aspartic protease that mediates the cleavage of NFE2L1/NRF1 at 'Leu-104', thereby promoting release of NFE2L1/NRF1 from the endoplasmic reticulum membrane (PubMed:27528193, PubMed:27676298). Ubiquitination of NFE2L1/NRF1 is a prerequisite for cleavage, suggesting that DDI2 specifically recognizes and binds ubiquitinated NFE2L1/NRF1 (PubMed:27528193). Seems to act as a proteasomal shuttle which links the proteasome and replication fork proteins like RTF2 (Probable). Required, with DDI1, for cellular survival following replication stress. Together or redundantly with DDI1, removes RTF2 from stalled forks to allow cell cycle progression after replication stress and maintains genome integrity (PubMed:29290612)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}