0.127899,"pct_control":0.131812,"donor_test":"not significant","donor_padj":0.383073,"donor_log2fc":-0.0936232,"donor_lfcse":0.0580715,"donor_log2fc_shrunk":-0.0324715},{"cell_type":"Inhibitory","gene_symbol":"E2F5","gene_symbol_current":"E2F5","gene_id":"ENSG00000133740","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.687527,"donor_log2fc":-0.0662228,"donor_lfcse":0.067774,"donor_log2fc_shrunk":-0.0100627},{"cell_type":"Oligodendroglia","gene_symbol":"E2F5","gene_symbol_current":"E2F5","gene_id":"ENSG00000133740","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.951043,"donor_log2fc":-0.00892499,"donor_lfcse":0.0671755,"donor_log2fc_shrunk":-0.00259137}],"modules":[{"cell_type":"CUX2-","gene_id":"ENSG00000133740","module":"blue","kme":0.0979586,"hub":false,"module_direction":"lower in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000133740"],"dataset_symbols":["E2F5"],"explorer":"explorer.html?dataset=mathys2019#gene/E2F5","cell_types":[{"cell_type":"Ex","gene_symbol":"E2F5","gene_symbol_current":"E2F5","gene_id":"ENSG00000133740","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":-0.0599415,"donor_lfcse":0.11792,"donor_log2fc_shrunk":-4.48744e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000133740","entrez_id":["1875"],"uniprot":["Q15329"],"ncbi_summary":"The protein encoded by this gene is a member of the E2F family of transcription factors. The E2F family plays a crucial role in the control of cell cycle and action of tumor suppressor proteins and is also a target of the transforming proteins of small DNA tumor viruses. The E2F proteins contain several evolutionarily conserved domains that are present in most members of the family. These domains include a DNA binding domain, a dimerization domain which determines interaction with the differentiation regulated transcription factor proteins (DP), a transactivation domain enriched in acidic amino acids, and a tumor suppressor protein association domain which is embedded within the transactivation domain. This protein is differentially phosphorylated and is expressed in a wide variety of human tissues. It has higher identity to E2F4 than to other family members. Both this protein and E2F4 interact with tumor suppressor proteins p130 and p107, but not with pRB. Alternative splicing results in multiple variants encoding different isoforms. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15329","text":"Transcriptional activator that binds to E2F sites, these sites are present in the promoter of many genes whose products are involved in cell proliferation. May mediate growth factor-initiated signal transduction. It is likely involved in the early responses of resting cells to growth factor stimulation. Specifically required for multiciliate cell differentiation: together with MCIDAS and E2F5, binds and activate genes required for centriole biogenesis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}