ificant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.401258,"nucleus_log2fc":-0.0622755,"nucleus_score":-1.14924,"pct_ad":0.206681,"pct_control":0.214564,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0241419,"donor_lfcse":0.130347,"donor_log2fc_shrunk":4.07677e-06},{"cell_type":"Oli","gene_symbol":"INTS1","gene_symbol_current":"INTS1","gene_id":"ENSG00000164880","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.949714,"nucleus_log2fc":0.0171545,"nucleus_score":0.0748461,"pct_ad":0.154626,"pct_control":0.154799,"donor_test":"not significant","donor_padj":0.944953,"donor_log2fc":0.0382165,"donor_lfcse":0.0839843,"donor_log2fc_shrunk":0.00499745}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000164880","module":"red","kme":0.102712,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000164880","module":"turquoise","kme":0.193473,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000164880","module":"turquoise","kme":0.0445773,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000164880","module":"turquoise","kme":0.0483694,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164880","entrez_id":["26173"],"uniprot":["Q8N201"],"ncbi_summary":"INTS1 is a subunit of the Integrator complex, which associates with the C-terminal domain of RNA polymerase II large subunit (POLR2A; MIM 180660) and mediates 3-prime end processing of small nuclear RNAs U1 (RNU1; MIM 180680) and U2 (RNU2; MIM 180690) (Baillat et al., 2005 [PubMed 16239144]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8N201","text":"Component of the integrator complex, a multiprotein complex that terminates RNA polymerase II (Pol II) transcription in the promoter-proximal region of genes (PubMed:25201415, PubMed:33243860, PubMed:38570683). The integrator complex provides a quality checkpoint during transcription elongation by driving premature transcription termination of transcripts that are unfavorably configured for transcriptional elongation: the complex terminates transcription by (1) catalyzing dephosphorylation of the C-terminal domain (CTD) of Pol II subunit POLR2A/RPB1 and SUPT5H/SPT5, (2) degrading the exiting nascent RNA transcript via endonuclease activity and (3) promoting the release of Pol II from bound DNA (PubMed:33243860). The integrator complex is also involved in terminating the synthesis of non-coding Pol II transcripts, such as enhancer RNAs (eRNAs), small nuclear RNAs (snRNAs), telomerase RNAs and long non-coding RNAs (lncRNAs) (PubMed:16239144, PubMed:26308897, PubMed:30737432). Within the integrator complex, INTS1 is involved in the post-termination step: INTS1 displaces INTS3 and the SOSS factors, allowing the integrator complex to return to the closed conformation, ready to bind to the paused elongation complex for another termination cycle (PubMed:38570683). Mediates recruitment of cytoplasmic dynein to the nuclear envelope, probably as component of the integrator complex (PubMed:23904267)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}