184402","module":"turquoise","kme":0.100349,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000184402"],"dataset_symbols":["SS18L1"],"explorer":"explorer.html?dataset=mathys2019#gene/SS18L1","cell_types":[{"cell_type":"Ex","gene_symbol":"SS18L1","gene_symbol_current":"SS18L1","gene_id":"ENSG00000184402","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.95216,"nucleus_log2fc":0.0297488,"nucleus_score":0.0780511,"pct_ad":0.240857,"pct_control":0.241586,"donor_test":"not significant","donor_padj":0.992956,"donor_log2fc":0.0248583,"donor_lfcse":0.0870214,"donor_log2fc_shrunk":3.41691e-06},{"cell_type":"In","gene_symbol":"SS18L1","gene_symbol_current":"SS18L1","gene_id":"ENSG00000184402","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.990063,"nucleus_log2fc":-0.0257523,"nucleus_score":0.0408692,"pct_ad":0.168589,"pct_control":0.166511,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0188337,"donor_lfcse":0.133447,"donor_log2fc_shrunk":-1.08744e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000184402","module":"pink","kme":0.168035,"hub":false,"module_direction":"higher in AD","module_padj":0.41964,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000184402","entrez_id":["26039"],"uniprot":["O75177"],"ncbi_summary":"This gene encodes a calcium-responsive transactivator which is an essential subunit of a neuron-specific chromatin-remodeling complex. The structure of this gene is similar to that of the SS18 gene. Mutations in this gene are involved in amyotrophic lateral sclerosis (ALS). Alternatively spliced transcript variants have been found for this gene. [provided by RefSeq, Sep 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75177","text":"Transcriptional activator which is required for calcium-dependent dendritic growth and branching in cortical neurons. Recruits CREB-binding protein (CREBBP) to nuclear bodies. Component of the CREST-BRG1 complex, a multiprotein complex that regulates promoter activation by orchestrating a calcium-dependent release of a repressor complex and a recruitment of an activator complex. In resting neurons, transcription of the c-FOS promoter is inhibited by BRG1-dependent recruitment of a phospho-RB1-HDAC1 repressor complex. Upon calcium influx, RB1 is dephosphorylated by calcineurin, which leads to release of the repressor complex. At the same time, there is increased recruitment of CREBBP to the promoter by a CREST-dependent mechanism, which leads to transcriptional activation. The CREST-BRG1 complex also binds to the NR2B promoter, and activity-dependent induction of NR2B expression involves a release of HDAC1 and recruitment of CREBBP (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}