ested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.724893,"nucleus_log2fc":0.0366121,"nucleus_score":0.891357,"pct_ad":0.11535,"pct_control":0.106443,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0428458,"donor_lfcse":0.191673,"donor_log2fc_shrunk":1.23433e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000180185","module":"turquoise","kme":0.192547,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000180185","module":"turquoise","kme":0.216401,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000180185","entrez_id":["81889"],"uniprot":["Q6P587"],"ncbi_summary":"Enables acetylpyruvate hydrolase activity; fumarylpyruvate hydrolase activity; and oxaloacetate decarboxylase activity. Located in cytosol; mitochondrion; and nucleoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6P587","text":"Tautomerase that converts enol-oxaloacetate, a strong inhibitor of succinate dehydrogenase, to the physiological keto form of oxaloacetate (PubMed:38287013). It is thereby required to maximize aerobic respiration efficiency by preventing succinate dehydrogenase inhibition (PubMed:38287013). Also acts as a weak oxaloacetate decarboxylase (ODx), catalyzing the decarboxylation of oxaloacetate (OAA) to pyruvate and CO(2), and as such is likely a regulatory enzyme in the TCA cycle (PubMed:25575590, PubMed:30348641). Also displays acylpyruvase activity, being able to hydrolyze acetylpyruvate and fumarylpyruvate in vitro (PubMed:21878618, PubMed:30348641). Exhibits only a weak hydrolase activity on methylacetopyruvate and acetylacetone, and no activity toward acetoacetyl-CoA (PubMed:21878618)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}