rol":null,"donor_test":"not significant","donor_padj":0.936681,"donor_log2fc":-0.101775,"donor_lfcse":0.19785,"donor_log2fc_shrunk":-0.00281799,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000101680","module":"black","kme":0.29301,"hub":false,"module_direction":"lower in AD","module_padj":1.0,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101680","entrez_id":["284217"],"uniprot":["P25391"],"ncbi_summary":"This gene encodes one of the alpha 1 subunits of laminin. The laminins are a family of extracellular matrix glycoproteins that have a heterotrimeric structure consisting of an alpha, beta and gamma chain. These proteins make up a major component of the basement membrane and have been implicated in a wide variety of biological processes including cell adhesion, differentiation, migration, signaling, neurite outgrowth and metastasis. Mutations in this gene may be associated with Poretti-Boltshauser syndrome. [provided by RefSeq, Sep 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P25391","text":"Binding to cells via a high affinity receptor, laminin is thought to mediate the attachment, migration and organization of cells into tissues during embryonic development by interacting with other extracellular matrix components. As a ligand for alpha-dystroglycan, it is involved in a number of processes including epithelium branching morphogenesis, down-regulation of apoptotic signals in muscle via the activation of PI3K/AKT signaling, and activation of RAC1 signaling. As a subunit of laminin-1 (also known as laminin-111 or EHS laminin), it is involved in the stimulation of agrin-induced receptor clustering through a MuSK-independent pathway."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}