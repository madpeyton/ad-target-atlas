2277,"pct_ad":0.237101,"pct_control":0.216088,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.154169,"donor_lfcse":0.23458,"donor_log2fc_shrunk":2.93439e-06},{"cell_type":"Oli","gene_symbol":"KCNJ6","gene_symbol_current":"KCNJ6","gene_id":"ENSG00000157542","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.689001,"nucleus_log2fc":0.0142781,"nucleus_score":0.456633,"pct_ad":0.102256,"pct_control":0.101158,"donor_test":"not significant","donor_padj":0.97549,"donor_log2fc":0.0362055,"donor_lfcse":0.183792,"donor_log2fc_shrunk":0.00114855}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000157542","module":"blue","kme":0.1897,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000157542","module":"blue","kme":0.231706,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000157542","module":"turquoise","kme":0.181563,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000157542","module":"brown","kme":0.141449,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000157542","entrez_id":["3763"],"uniprot":["P48051"],"ncbi_summary":"This gene encodes a member of the G protein-coupled inwardly-rectifying potassium channel family of inward rectifier potassium channels. This type of potassium channel allows a greater flow of potassium into the cell than out of it. These proteins modulate many physiological processes, including heart rate in cardiac cells and circuit activity in neuronal cells, through G-protein coupled receptor stimulation. Mutations in this gene are associated with Keppen-Lubinsky Syndrome, a rare condition characterized by severe developmental delay, facial dysmorphism, and intellectual disability. [provided by RefSeq, Apr 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P48051","text":"Inward rectifier potassium channels are characterized by a greater tendency to allow potassium to flow into the cell rather than out of it. Their voltage dependence is regulated by the concentration of extracellular potassium; as external potassium is raised, the voltage range of the channel opening shifts to more positive voltages. The inward rectification is mainly due to the blockage of outward current by internal magnesium. This potassium channel may be involved in the regulation of insulin secretion by glucose and/or neurotransmitters acting through G protein-coupled receptors."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}