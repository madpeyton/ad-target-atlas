dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000074266"],"dataset_symbols":["EED"],"explorer":"explorer.html?dataset=mathys2019#gene/EED","cell_types":[{"cell_type":"Ex","gene_symbol":"EED","gene_symbol_current":"EED","gene_id":"ENSG00000074266","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00100729,"nucleus_log2fc":-0.132022,"nucleus_score":-3.56344,"pct_ad":0.139374,"pct_control":0.157282,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0992415,"donor_lfcse":0.0794694,"donor_log2fc_shrunk":-1.61656e-05},{"cell_type":"In","gene_symbol":"EED","gene_symbol_current":"EED","gene_id":"ENSG00000074266","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.614233,"nucleus_log2fc":-0.164481,"nucleus_score":-1.18163,"pct_ad":0.0918367,"pct_control":0.101152,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.116366,"donor_lfcse":0.153365,"donor_log2fc_shrunk":-5.07573e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000074266","entrez_id":["8726"],"uniprot":["O75530"],"ncbi_summary":"This gene encodes a member of the Polycomb-group (PcG) family. PcG family members form multimeric protein complexes, which are involved in maintaining the transcriptional repressive state of genes over successive cell generations. This protein interacts with enhancer of zeste 2, the cytoplasmic tail of integrin beta7, immunodeficiency virus type 1 (HIV-1) MA protein, and histone deacetylase proteins. This protein mediates repression of gene activity through histone deacetylation, and may act as a specific regulator of integrin function. Two transcript variants encoding distinct isoforms have been identified for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75530","text":"Polycomb group (PcG) protein. Component of the PRC2/EED-EZH2 complex, which methylates 'Lys-9' and 'Lys-27' of histone H3, leading to transcriptional repression of the affected target gene. Also recognizes 'Lys-26' trimethylated histone H1 with the effect of inhibiting PRC2 complex methyltransferase activity on nucleosomal histone H3 'Lys-27', whereas H3 'Lys-27' recognition has the opposite effect, enabling the propagation of this repressive mark. The PRC2/EED-EZH2 complex may also serve as a recruiting platform for DNA methyltransferases, thereby linking two epigenetic repression systems. Genes repressed by the PRC2/EED-EZH2 complex include HOXC8, HOXA9, MYT1 and CDKN2A."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}