4,"pct_control":0.347224,"donor_test":"not significant","donor_padj":0.612837,"donor_log2fc":-0.185833,"donor_lfcse":0.0941164,"donor_log2fc_shrunk":-0.0222972,"degas_log2fc":-0.349143,"degas_padj":8.7764e-64}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000137831","module":"green","kme":0.15575,"hub":false,"module_direction":"lower in AD","module_padj":0.299526,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000137831","module":"yellow","kme":0.168997,"hub":false,"module_direction":"lower in AD","module_padj":0.0240838,"module_significant":true}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000137831","entrez_id":["55075"],"uniprot":["Q9BZF9"],"ncbi_summary":"This gene encodes a protein that contains ankyrin repeats and coiled coil domains and likely plays a role in apoptosis. Studies in rodents have implicated the encoded protein in the stimulation of apoptosis and the regulation of mammary gland involution, in which the mammary gland returns to its pre-pregnant state. This protein has also been proposed to negatively regulate apoptosis based on experiments in human cell lines in which the protein was shown to interact with PRKC apoptosis WT1 regulator protein, also known as PAR-4, and inhibit translocation of the PAR-4 receptor. Autoantibodies to this protein have been identified in human patients with panuveitis and Graves' disease. Differential expression of this gene has been observed in various human cancers. [provided by RefSeq, May 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BZF9","text":"Regulates APAF1 expression and plays an important role in the regulation of stress-induced apoptosis. Promotes apoptosis by regulating three pathways, apoptosome up-regulation, LGALS3/galectin-3 down-regulation and NF-kappa-B inactivation. Regulates the redistribution of APAF1 into the nucleus after proapoptotic stress. Down-regulates the expression of LGALS3 by inhibiting NFKB1 (By similarity). Modulates isoactin dynamics to regulate the morphological alterations required for cell growth and motility. Interaction with ARF6 may modulate cell shape and motility after injury. May be involved in multiple neurite formation (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}