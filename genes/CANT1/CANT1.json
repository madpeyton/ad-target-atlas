:0.186295,"donor_lfcse":0.112398,"donor_log2fc_shrunk":-1.79013e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000171302","module":"turquoise","kme":0.107837,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000171302","entrez_id":["124583"],"uniprot":["Q8WVQ1"],"ncbi_summary":"This protein encoded by this gene belongs to the apyrase family. It functions as a calcium-dependent nucleotidase with a preference for UDP. Mutations in this gene are associated with Desbuquois dysplasia with hand anomalies. Alternatively spliced transcript variants have been noted for this gene.[provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WVQ1","text":"Calcium-dependent nucleotidase with a preference for ribonucleosides diphosphate UDP, GDP and IDP, while having very low activity towards ADP and CDP (PubMed:12234496, PubMed:15006348, PubMed:15248776, PubMed:16835225). In vitro, it can also act with low or negligible efficiency on ribonucletides triphosphate UTP, GTP, ITP, ATP and CTP (PubMed:12234496, PubMed:15248776). Does not hydrolyze AMP and GMP (PubMed:12234496). Involved in proteoglycan synthesis (PubMed:22539336)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}