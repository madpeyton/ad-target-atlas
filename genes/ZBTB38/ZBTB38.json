ested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.679829,"nucleus_log2fc":-0.0729786,"nucleus_score":-0.847319,"pct_ad":0.153846,"pct_control":0.169349,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":-0.138189,"donor_lfcse":0.179538,"donor_log2fc_shrunk":-0.000882103},{"cell_type":"Oli","gene_symbol":"ZBTB38","gene_symbol_current":"ZBTB38","gene_id":"ENSG00000177311","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.326792,"nucleus_log2fc":0.0487719,"nucleus_score":1.21366,"pct_ad":0.130841,"pct_control":0.123978,"donor_test":"not significant","donor_padj":0.970288,"donor_log2fc":0.0195521,"donor_lfcse":0.10037,"donor_log2fc_shrunk":0.00173148}],"modules":[{"cell_type":"In","gene_id":"ENSG00000177311","module":"turquoise","kme":0.234965,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000177311","module":"turquoise","kme":0.126922,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000177311","entrez_id":["253461"],"uniprot":["Q8NAP3"],"ncbi_summary":"The protein encoded by this gene is a zinc finger transcriptional activator that binds methylated DNA. The encoded protein can form homodimers or heterodimers through the zinc finger domains. In mouse, inhibition of this protein has been associated with apoptosis in some cell types. [provided by RefSeq, Jun 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8NAP3","text":"Transcriptional regulator with bimodal DNA-binding specificity. Binds with a higher affinity to methylated CpG dinucleotides in the consensus sequence 5'-CGCG-3' but can also bind to E-box elements (5'-CACGTG-3'). Can also bind specifically to a single methyl-CpG pair. Represses transcription in a methyl-CpG-dependent manner (PubMed:16354688). Plays an important role in regulating DNA replication and common fragile sites (CFS) stability in a RBBP6- and MCM10-dependent manner; represses expression of MCM10 which plays an important role in DNA-replication (PubMed:24726359). Acts as a transcriptional activator. May be involved in the differentiation and/or survival of late postmitotic neurons (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}