925844,"donor_log2fc":0.0168742,"donor_lfcse":0.0451669,"donor_log2fc_shrunk":0.00326506},{"cell_type":"Mic","gene_symbol":"KPNA1","gene_symbol_current":"KPNA1","gene_id":"ENSG00000114030","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.790072,"nucleus_log2fc":-0.0074647,"nucleus_score":-0.346836,"pct_ad":0.47428,"pct_control":0.477189,"donor_test":"not significant","donor_padj":0.996007,"donor_log2fc":0.0013967,"donor_lfcse":0.0614317,"donor_log2fc_shrunk":4.07785e-06},{"cell_type":"OPC","gene_symbol":"KPNA1","gene_symbol_current":"KPNA1","gene_id":"ENSG00000114030","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.938217,"nucleus_log2fc":0.000417303,"nucleus_score":0.124275,"pct_ad":0.499851,"pct_control":0.49873,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0193528,"donor_lfcse":0.0574159,"donor_log2fc_shrunk":-6.07294e-06},{"cell_type":"Oli","gene_symbol":"KPNA1","gene_symbol_current":"KPNA1","gene_id":"ENSG00000114030","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":6.12676e-05,"nucleus_log2fc":-0.0666488,"nucleus_score":-4.15873,"pct_ad":0.428118,"pct_control":0.446274,"donor_test":"not significant","donor_padj":0.989056,"donor_log2fc":-0.00479191,"donor_lfcse":0.05134,"donor_log2fc_shrunk":-0.00165633}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000114030","module":"turquoise","kme":0.121163,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000114030","entrez_id":["3836"],"uniprot":["P52294"],"ncbi_summary":"The transport of molecules between the nucleus and the cytoplasm in eukaryotic cells is mediated by the nuclear pore complex (NPC), which consists of 60-100 proteins. Small molecules (up to 70 kD) can pass through the nuclear pore by nonselective diffusion while larger molecules are transported by an active process. The protein encoded by this gene belongs to the importin alpha family, and is involved in nuclear protein import. This protein interacts with the recombination activating gene 1 (RAG1) protein and is a putative substrate of the RAG1 ubiquitin ligase. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Nov 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P52294","text":"Functions in nuclear protein import as an adapter protein for nuclear receptor KPNB1 (PubMed:27713473, PubMed:7892216, PubMed:8692858). Binds specifically and directly to substrates containing either a simple or bipartite NLS motif (PubMed:27713473, PubMed:7892216, PubMed:8692858). Docking of the importin/substrate complex to the nuclear pore complex (NPC) is mediated by KPNB1 through binding to nucleoporin FxFG repeats and the complex is subsequently translocated through the pore by an energy requiring, Ran-dependent mechanism (PubMed:27713473, PubMed:7892216). At the nucleoplasmic side of the NPC, Ran binds to importin-beta and the three components separate and importin-alpha and -beta are re-exported from the nucleus to the cytoplasm where GTP hydrolysis releases Ran from importin (PubMed:7892216). The directionality of nuclear import is thought to be conferred by an asymmetric distribution of the GTP- and GDP-bound forms of Ran between the cytoplasm and nucleus (PubMed:7892216). Mediator of PR-DUB complex component BAP1 nuclear import; acts redundantly with KPNA2 and Transportin-1/TNPO1 (PubMed:35446349). (Microbial infection) In vitro, mediates the nuclear import of human cytomegalovirus UL84 by recognizing a non-classical NLS."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}