:"explorer.html?dataset=mathys2019#gene/BACE2","cell_types":[{"cell_type":"Ex","gene_symbol":"BACE2","gene_symbol_current":"BACE2","gene_id":"ENSG00000182240","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.123739,"nucleus_log2fc":-0.0205633,"nucleus_score":-1.73361,"pct_ad":0.126778,"pct_control":0.135668,"donor_test":"not significant","donor_padj":0.988658,"donor_log2fc":0.0587961,"donor_lfcse":0.151409,"donor_log2fc_shrunk":2.6623e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000182240","entrez_id":["25825"],"uniprot":["Q9Y5Z0"],"ncbi_summary":"This gene encodes an integral membrane glycoprotein that functions as an aspartic protease. The encoded protein cleaves amyloid precursor protein into amyloid beta peptide, which is a critical step in the etiology of Alzheimer's disease and Down syndrome. The protein precursor is further processed into an active mature peptide. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jul 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y5Z0","text":"Responsible for the proteolytic processing of the amyloid precursor protein (APP). Cleaves APP, between residues 690 and 691, leading to the generation and extracellular release of beta-cleaved soluble APP, and a corresponding cell-associated C-terminal fragment which is later released by gamma-secretase. It has also been shown that it can cleave APP between residues 671 and 672 (PubMed:10591213, PubMed:11083922, PubMed:11423558, PubMed:15857888, PubMed:16816112). Involved in the proteolytic shedding of PMEL at early stages of melanosome biogenesis. Cleaves PMEL within the M-beta fragment to release the amyloidogenic PMEL luminal fragment containing M-alpha and a small portion of M-beta N-terminus. This is a prerequisite step for subsequent processing and assembly of PMEL fibrils into amyloid sheets (PubMed:23754390). Responsible also for the proteolytic processing of CLTRN in pancreatic beta cells (PubMed:21907142)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}