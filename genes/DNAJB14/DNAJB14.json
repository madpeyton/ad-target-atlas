symbol_current":"DNAJB14","gene_id":"ENSG00000164031","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.183891,"nucleus_log2fc":0.510849,"nucleus_score":2.1587,"pct_ad":0.118081,"pct_control":0.0848939,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"DNAJB14","gene_symbol_current":"DNAJB14","gene_id":"ENSG00000164031","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.873606,"nucleus_log2fc":0.0962753,"nucleus_score":0.386822,"pct_ad":0.195447,"pct_control":0.191571,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":0.113383,"donor_lfcse":0.142778,"donor_log2fc_shrunk":0.00114282},{"cell_type":"Oli","gene_symbol":"DNAJB14","gene_symbol_current":"DNAJB14","gene_id":"ENSG00000164031","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.970073,"donor_log2fc":-0.0198664,"donor_lfcse":0.101116,"donor_log2fc_shrunk":-0.0017467}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000164031","module":"turquoise","kme":0.127997,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000164031","module":"brown","kme":0.206045,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000164031","module":"lightgreen","kme":0.14809,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164031","entrez_id":["79982"],"uniprot":["Q8TBM8"],"ncbi_summary":"Enables Hsp70 protein binding activity. Involved in cellular protein-containing complex assembly and chaperone cofactor-dependent protein refolding. Located in endoplasmic reticulum. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TBM8","text":"Acts as a co-chaperone with HSPA8/Hsc70; required to promote protein folding and trafficking, prevent aggregation of client proteins, and promote unfolded proteins to endoplasmic reticulum-associated degradation (ERAD) pathway (PubMed:24732912). Acts by determining HSPA8/Hsc70's ATPase and polypeptide-binding activities (PubMed:24732912). Can also act independently of HSPA8/Hsc70: together with DNAJB12, acts as a chaperone that promotes maturation of potassium channels KCND2 and KCNH2 by stabilizing nascent channel subunits and assembling them into tetramers (PubMed:27916661). While stabilization of nascent channel proteins is dependent on HSPA8/Hsc70, the process of oligomerization of channel subunits is independent of HSPA8/Hsc70 (PubMed:27916661). When overexpressed, forms membranous structures together with DNAJB12 and HSPA8/Hsc70 within the nucleus; the role of these structures, named DJANGOs, is still unclear (PubMed:24732912). (Microbial infection) In case of infection by polyomavirus, involved in the virus endoplasmic reticulum membrane penetration and infection (PubMed:21673190, PubMed:24675744)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}