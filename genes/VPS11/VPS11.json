ignificant":true,"nucleus_direction":"lower in AD","nucleus_padj":4.09762e-13,"nucleus_log2fc":-0.0817746,"nucleus_score":-7.35446,"pct_ad":0.184239,"pct_control":0.198628,"donor_test":"not significant","donor_padj":0.940247,"donor_log2fc":-0.0229868,"donor_lfcse":0.0738377,"donor_log2fc_shrunk":-0.00192312},{"cell_type":"Mic","gene_symbol":"VPS11","gene_symbol_current":"VPS11","gene_id":"ENSG00000160695","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.93897,"donor_log2fc":-0.0436827,"donor_lfcse":0.108639,"donor_log2fc_shrunk":-0.00669868},{"cell_type":"OPC","gene_symbol":"VPS11","gene_symbol_current":"VPS11","gene_id":"ENSG00000160695","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.878881,"nucleus_log2fc":-0.0449229,"nucleus_score":0.246256,"pct_ad":0.1102,"pct_control":0.107875,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.02647,"donor_lfcse":0.130124,"donor_log2fc_shrunk":-1.61886e-06},{"cell_type":"Oli","gene_symbol":"VPS11","gene_symbol_current":"VPS11","gene_id":"ENSG00000160695","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000945324,"nucleus_log2fc":-0.14678,"nucleus_score":-3.44989,"pct_ad":0.0974609,"pct_control":0.105007,"donor_test":"not significant","donor_padj":0.847462,"donor_log2fc":-0.0911765,"donor_lfcse":0.0882887,"donor_log2fc_shrunk":-0.0120766}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000160695","module":"turquoise","kme":0.0561882,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000160695","module":"turquoise","kme":0.0493984,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000160695","module":"turquoise","kme":0.0615803,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000160695","entrez_id":["55823"],"uniprot":["Q9H270"],"ncbi_summary":"Vesicle mediated protein sorting plays an important role in segregation of intracellular molecules into distinct organelles. Genetic studies in yeast have identified more than 40 vacuolar protein sorting (VPS) genes involved in vesicle transport to vacuoles. This gene encodes the human homolog of yeast class C Vps11 protein. The mammalian class C Vps proteins are predominantly associated with late endosomes/lysosomes, and like their yeast counterparts, may mediate vesicle trafficking steps in the endosome/lysosome pathway. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Feb 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H270","text":"Plays a role in vesicle-mediated protein trafficking to lysosomal compartments including the endocytic membrane transport and autophagic pathways. Believed to act as a core component of the putative HOPS and CORVET endosomal tethering complexes which are proposed to be involved in the Rab5-to-Rab7 endosome conversion probably implicating MON1A/B, and via binding SNAREs and SNARE complexes to mediate tethering and docking events during SNARE-mediated membrane fusion. The HOPS complex is proposed to be recruited to Rab7 on the late endosomal membrane and to regulate late endocytic, phagocytic and autophagic traffic towards lysosomes. The CORVET complex is proposed to function as a Rab5 effector to mediate early endosome fusion probably in specific endosome subpopulations (PubMed:11382755, PubMed:23351085, PubMed:24554770, PubMed:25266290, PubMed:25783203). Required for fusion of endosomes and autophagosomes with lysosomes (PubMed:25783203). Involved in cargo transport from early to late endosomes and required for the transition from early to late endosomes (PubMed:21148287). Involved in the retrograde Shiga toxin transport (PubMed:23593995)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}