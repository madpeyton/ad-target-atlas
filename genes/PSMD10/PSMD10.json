":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000101843","module":"turquoise","kme":0.152092,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000101843","module":"turquoise","kme":0.0892991,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000101843"],"dataset_symbols":["PSMD10"],"explorer":"explorer.html?dataset=mathys2019#gene/PSMD10","cell_types":[{"cell_type":"Ex","gene_symbol":"PSMD10","gene_symbol_current":"PSMD10","gene_id":"ENSG00000101843","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.49125,"nucleus_log2fc":0.0618439,"nucleus_score":0.815719,"pct_ad":0.15126,"pct_control":0.14787,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.114921,"donor_lfcse":0.17144,"donor_log2fc_shrunk":2.30869e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000101843","module":"yellow","kme":0.197105,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000101843","module":"turquoise","kme":0.159247,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101843","entrez_id":["5716"],"uniprot":["O75832"],"ncbi_summary":"This gene encodes a subunit of the PA700/19S complex, which is the regulatory component of the 26S proteasome. The 26S proteosome complex is required for ubiquitin-dependent protein degradation. This protein is a non-ATPase subunit that may be involved in protein-protein interactions. Aberrant expression of this gene may paly a role in tumorigenesis. Two transcripts encoding different isoforms have been described. Pseudogenes have been identified on chromosomes 3 and 20.[provided by RefSeq, Mar 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75832","text":"Acts as a chaperone during the assembly of the 26S proteasome, specifically of the PA700/19S regulatory complex (RC). In the initial step of the base subcomplex assembly is part of an intermediate PSMD10:PSMC4:PSMC5:PAAF1 module which probably assembles with a PSMD5:PSMC2:PSMC1:PSMD2 module. Independently of the proteasome, regulates EGF-induced AKT activation through inhibition of the RHOA/ROCK/PTEN pathway, leading to prolonged AKT activation. Plays an important role in RAS-induced tumorigenesis. Acts as an proto-oncoprotein by being involved in negative regulation of tumor suppressors RB1 and p53/TP53. Overexpression is leading to phosphorylation of RB1 and proteasomal degradation of RB1. Regulates CDK4-mediated phosphorylation of RB1 by competing with CDKN2A for binding with CDK4. Facilitates binding of MDM2 to p53/TP53 and the mono- and polyubiquitination of p53/TP53 by MDM2 suggesting a function in targeting the TP53:MDM2 complex to the 26S proteasome. Involved in p53-independent apoptosis. Involved in regulation of NF-kappa-B by retaining it in the cytoplasm. Binds to the NF-kappa-B component RELA and accelerates its XPO1/CRM1-mediated nuclear export."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}