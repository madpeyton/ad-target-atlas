BCB1","gene_symbol_current":"ABCB1","gene_id":"ENSG00000085563","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.303278,"donor_lfcse":0.306786,"donor_log2fc_shrunk":-3.37194e-06},{"cell_type":"Oli","gene_symbol":"ABCB1","gene_symbol_current":"ABCB1","gene_id":"ENSG00000085563","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.935562,"donor_log2fc":-0.133035,"donor_lfcse":0.25624,"donor_log2fc_shrunk":-0.00226172}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000085563","module":"turquoise","kme":0.550505,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000085563","module":"turquoise","kme":0.504879,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000085563","module":"turquoise","kme":0.14217,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000085563","entrez_id":["5243"],"uniprot":["P08183"],"ncbi_summary":"The membrane-associated protein encoded by this gene is a member of the superfamily of ATP-binding cassette (ABC) transporters. ABC proteins transport various molecules across extra- and intra-cellular membranes. ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, White). This protein is a member of the MDR/TAP subfamily. Members of the MDR/TAP subfamily are involved in multidrug resistance. The protein encoded by this gene is an ATP-dependent drug efflux pump for xenobiotic compounds with broad substrate specificity. It is responsible for decreased drug accumulation in multidrug-resistant cells and often mediates the development of resistance to anticancer drugs. This protein also functions as a transporter in the blood-brain barrier. Mutations in this gene are associated with colchicine resistance and Inflammatory bowel disease 13. Alternative splicing and the use of alternative promoters results in multiple transcript variants. [provided by RefSeq, Feb 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P08183","text":"Translocates phospholipids and drugs across the membrane (PubMed:2897240, PubMed:35970996, PubMed:8898203, PubMed:9038218, PubMed:35507548). Catalyzes the flop of phospholipids from the cytoplasmic to the exoplasmic leaflet of the apical membrane. Participates mainly to the flop of phosphatidylcholine, phosphatidylethanolamine, beta-D-glucosylceramides and sphingomyelins (PubMed:8898203). Energy-dependent efflux pump responsible for decreased drug accumulation in multidrug-resistant cells (PubMed:2897240, PubMed:35970996, PubMed:9038218). May contribute to hepatobiliary and renal excretion of etiocholanolone-3-glucuronate. Appears to have very low activity toward testosterone, androsterone and dihydrotestosterone glucuronates."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}