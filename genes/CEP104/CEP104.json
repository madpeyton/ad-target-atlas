 via MyGene.info","uniprot_function":[{"accession":"O60308","text":"Required for ciliogenesis and for structural integrity at the ciliary tip."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}