44,"donor_lfcse":0.209083,"donor_log2fc_shrunk":-0.0129999},{"cell_type":"OPC","gene_symbol":"EPHA3","gene_symbol_current":"EPHA3","gene_id":"ENSG00000044524","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.344939,"donor_lfcse":0.189507,"donor_log2fc_shrunk":-9.78107e-06},{"cell_type":"Oli","gene_symbol":"EPHA3","gene_symbol_current":"EPHA3","gene_id":"ENSG00000044524","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.81618e-05,"nucleus_log2fc":-0.0679347,"nucleus_score":-4.44019,"pct_ad":0.109997,"pct_control":0.121755,"donor_test":"not significant","donor_padj":0.978153,"donor_log2fc":0.0343263,"donor_lfcse":0.195642,"donor_log2fc_shrunk":0.00100374}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000044524","module":"blue","kme":0.124061,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000044524","module":"yellow","kme":0.441725,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000044524","module":"yellow","kme":0.543997,"hub":false,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000044524","module":"turquoise","kme":0.11206,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000044524","entrez_id":["2042"],"uniprot":["P29320"],"ncbi_summary":"This gene belongs to the ephrin receptor subfamily of the protein-tyrosine kinase family. EPH and EPH-related receptors have been implicated in mediating developmental events, particularly in the nervous system. Receptors in the EPH subfamily typically have a single kinase domain and an extracellular region containing a Cys-rich domain and 2 fibronectin type III repeats. The ephrin receptors are divided into 2 groups based on the similarity of their extracellular domain sequences and their affinities for binding ephrin-A and ephrin-B ligands. This gene encodes a protein that binds ephrin-A ligands. Two alternatively spliced transcript variants have been described for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P29320","text":"Receptor tyrosine kinase which binds promiscuously membrane-bound ephrin family ligands residing on adjacent cells, leading to contact-dependent bidirectional signaling into neighboring cells. The signaling pathway downstream of the receptor is referred to as forward signaling while the signaling pathway downstream of the ephrin ligand is referred to as reverse signaling (PubMed:11870224, PubMed:12794130). Highly promiscuous for ephrin-A ligands it binds preferentially EFNA5 (By similarity). Upon activation by EFNA5 regulates cell-cell adhesion, cytoskeletal organization and cell migration (PubMed:11870224). Also activated by EFNA1, inhibiting epithelial-to-mesenchymal transition of cardiac cells and playing a role in heart development (PubMed:12794130). Involved in the retinotectal mapping of neurons. May also control the segregation but not the guidance of motor and sensory axons during neuromuscular circuit development (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}