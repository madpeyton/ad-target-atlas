":"explorer.html?dataset=seaad_pfc#gene/IZUMO1","cell_types":[{"cell_type":"Ex","gene_symbol":"IZUMO1","gene_symbol_current":"IZUMO1","gene_id":"ENSG00000182264","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.834329,"donor_log2fc":-0.0725004,"donor_lfcse":0.114651,"donor_log2fc_shrunk":-0.00483422,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"IZUMO1","gene_symbol_current":"IZUMO1","gene_id":"ENSG00000182264","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.94547,"donor_log2fc":0.0420311,"donor_lfcse":0.148422,"donor_log2fc_shrunk":0.000909529,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"IZUMO1","gene_symbol_current":"IZUMO1","gene_id":"ENSG00000182264","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.866331,"donor_log2fc":0.312962,"donor_lfcse":0.33475,"donor_log2fc_shrunk":0.00337147,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000182264","entrez_id":["284359"],"uniprot":["Q8IYV9"],"ncbi_summary":"The sperm-specific protein Izumo, named for a Japanese shrine dedicated to marriage, is essential for sperm-egg plasma membrane binding and fusion (Inoue et al., 2005 [PubMed 15759005]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IYV9","text":"Essential sperm cell-surface protein required for fertilization by acting as a ligand for IZUMO1R/JUNO receptor on egg. The IZUMO1:IZUMO1R/JUNO interaction is a necessary adhesion event between sperm and egg that is required for fertilization but is not sufficient for cell fusion. The ligand-receptor interaction probably does not act as a membrane 'fusogen'. Acts a ligand for the human-specific oolemma epitope FCRL3/MAIA during fertilization (PubMed:36070373). FCRL3/MAIA replaces IZUMO1R/JUNO as IZUMO1 receptor after sperm-egg adhesion, which permits species-specific gamete fusion (PubMed:36070373). Plays a critical role in sperm-oolemma binding prior to plasma membrane fusion. Can mediate cell-cell fusion in cultured mammalian cells independently of its binding to IZUMO1R/JUNO (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}