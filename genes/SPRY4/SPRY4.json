dataset=mathys2019#gene/SPRY4","cell_types":[{"cell_type":"OPC","gene_symbol":"SPRY4","gene_symbol_current":"SPRY4","gene_id":"ENSG00000187678","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0853271,"nucleus_log2fc":0.532337,"nucleus_score":2.79436,"pct_ad":0.134223,"pct_control":0.0996169,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000187678","module":"midnightblue","kme":0.201569,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000187678","entrez_id":["81848"],"uniprot":["Q9C004"],"ncbi_summary":"This gene encodes a member of a family of cysteine- and proline-rich proteins. The encoded protein is an inhibitor of the receptor-transduced mitogen-activated protein kinase (MAPK) signaling pathway. Activity of this protein impairs the formation of active GTP-RAS. Nucleotide variation in this gene has been associated with hypogonadotropic hypogonadism 17 with or without anosmia. Alternative splicing results in a multiple transcript variants. [provided by RefSeq, Jun 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9C004","text":"Suppresses the insulin receptor and EGFR-transduced MAPK signaling pathway, but does not inhibit MAPK activation by a constitutively active mutant Ras (PubMed:12027893). Probably impairs the formation of GTP-Ras (PubMed:12027893). Inhibits Ras-independent, but not Ras-dependent, activation of RAF1 (PubMed:12717443). Represses integrin-mediated cell spreading via inhibition of TESK1-mediated phosphorylation of cofilin (PubMed:15584898)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}