rce":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9C004","text":"Suppresses the insulin receptor and EGFR-transduced MAPK signaling pathway, but does not inhibit MAPK activation by a constitutively active mutant Ras (PubMed:12027893). Probably impairs the formation of GTP-Ras (PubMed:12027893). Inhibits Ras-independent, but not Ras-dependent, activation of RAF1 (PubMed:12717443). Represses integrin-mediated cell spreading via inhibition of TESK1-mediated phosphorylation of cofilin (PubMed:15584898)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}