log2fc_shrunk":-0.00255297},{"cell_type":"Mic","gene_symbol":"SUCLA2","gene_symbol_current":"SUCLA2","gene_id":"ENSG00000136143","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.512593,"nucleus_log2fc":-0.0369717,"nucleus_score":-0.811562,"pct_ad":0.286258,"pct_control":0.29159,"donor_test":"not significant","donor_padj":0.744543,"donor_log2fc":-0.0817941,"donor_lfcse":0.076391,"donor_log2fc_shrunk":-0.0241264},{"cell_type":"OPC","gene_symbol":"SUCLA2","gene_symbol_current":"SUCLA2","gene_id":"ENSG00000136143","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0117258,"nucleus_log2fc":-0.138043,"nucleus_score":-3.00661,"pct_ad":0.329407,"pct_control":0.351228,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.157643,"donor_lfcse":0.0700585,"donor_log2fc_shrunk":-2.51993e-05},{"cell_type":"Oli","gene_symbol":"SUCLA2","gene_symbol_current":"SUCLA2","gene_id":"ENSG00000136143","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.315499,"nucleus_log2fc":-0.00586802,"nucleus_score":-1.10091,"pct_ad":0.276033,"pct_control":0.281893,"donor_test":"not significant","donor_padj":0.993223,"donor_log2fc":0.00419523,"donor_lfcse":0.064001,"donor_log2fc_shrunk":0.000909989}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136143","entrez_id":["8803"],"uniprot":["Q9P2R7"],"ncbi_summary":"Succinyl-CoA synthetase (SCS) is a mitochondrial matrix enzyme that acts as a heterodimer, being composed of an invariant alpha subunit and a substrate-specific beta subunit. The protein encoded by this gene is an ATP-specific SCS beta subunit that dimerizes with the SCS alpha subunit to form SCS-A, an essential component of the tricarboxylic acid cycle. SCS-A hydrolyzes ATP to convert succinate to succinyl-CoA. Defects in this gene are a cause of myopathic mitochondrial DNA depletion syndrome. A pseudogene of this gene has been found on chromosome 6. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9P2R7","text":"ATP-specific succinyl-CoA synthetase functions in the citric acid cycle (TCA), coupling the hydrolysis of succinyl-CoA to the synthesis of ATP and thus represents the only step of substrate-level phosphorylation in the TCA (PubMed:15877282, PubMed:34492704, PubMed:40108300). The beta subunit provides nucleotide specificity of the enzyme and binds the substrate succinate, while the binding sites for coenzyme A and phosphate are found in the alpha subunit (By similarity). Also able to act as an ATP-specific itaconyl- and malyl-CoA synthetase (PubMed:40108300)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}