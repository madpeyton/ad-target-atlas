:[{"cell_type":"Astrocytes","gene_id":"ENSG00000162191","module":"turquoise","kme":0.0955746,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000162191","module":"turquoise","kme":0.210515,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000162191","module":"turquoise","kme":0.15947,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000162191","module":"turquoise","kme":0.0721701,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000162191"],"dataset_symbols":["UBXN1"],"explorer":"explorer.html?dataset=mathys2019#gene/UBXN1","cell_types":[{"cell_type":"Ex","gene_symbol":"UBXN1","gene_symbol_current":"UBXN1","gene_id":"ENSG00000162191","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.25536e-07,"nucleus_log2fc":-0.284492,"nucleus_score":-5.5172,"pct_ad":0.167208,"pct_control":0.19405,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.145013,"donor_lfcse":0.167346,"donor_log2fc_shrunk":-5.42988e-06},{"cell_type":"In","gene_symbol":"UBXN1","gene_symbol_current":"UBXN1","gene_id":"ENSG00000162191","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.887133,"nucleus_log2fc":-0.0475015,"nucleus_score":0.432624,"pct_ad":0.119343,"pct_control":0.113601,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0892884,"donor_lfcse":0.213001,"donor_log2fc_shrunk":-2.16101e-06},{"cell_type":"Oli","gene_symbol":"UBXN1","gene_symbol_current":"UBXN1","gene_id":"ENSG00000162191","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.942097,"donor_log2fc":0.0834377,"donor_lfcse":0.17371,"donor_log2fc_shrunk":0.00302445}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000162191","module":"turquoise","kme":0.288862,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000162191","module":"turquoise","kme":0.244182,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000162191","entrez_id":["51035"],"uniprot":["Q04323"],"ncbi_summary":"Enables several functions, including enzyme binding activity; polyubiquitin modification-dependent protein binding activity; and proteasome regulatory particle binding activity. Involved in negative regulation of cellular protein metabolic process. Located in cytosol; endoplasmic reticulum; and nucleoplasm. Part of VCP-NPL4-UFD1 AAA ATPase complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q04323","text":"Ubiquitin-binding protein that plays a role in the modulation of innate immune response. Blocks both the RIG-I-like receptors (RLR) and NF-kappa-B pathways. Following viral infection, UBXN1 is induced and recruited to the RLR component MAVS. In turn, interferes with MAVS oligomerization, and disrupts the MAVS/TRAF3/TRAF6 signalosome. This function probably serves as a brake to prevent excessive RLR signaling (PubMed:23545497). Interferes with the TNFalpha-triggered NF-kappa-B pathway by interacting with cellular inhibitors of apoptosis proteins (cIAPs) and thereby inhibiting their recruitment to TNFR1 (PubMed:25681446). Also prevents the activation of NF-kappa-B by associating with CUL1 and thus inhibiting NF-kappa-B inhibitor alpha/NFKBIA degradation that remains bound to NF-kappa-B (PubMed:28152074). Interacts with the BRCA1-BARD1 heterodimer and regulates its activity. Specifically binds 'Lys-6'-linked polyubiquitin chains. Interaction with autoubiquitinated BRCA1 leads to the inhibition of the E3 ubiquitin-protein ligase activity of the BRCA1-BARD1 heterodimer (PubMed:20351172). Component of a complex required to couple deglycosylation and proteasome-mediated degradation of misfolded proteins in the endoplasmic reticulum that are retrotranslocated in the cytosol."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}