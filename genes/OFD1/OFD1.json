re":1.44216,"pct_ad":0.452729,"pct_control":0.437257,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.00505519,"donor_lfcse":0.0706117,"donor_log2fc_shrunk":1.07535e-06,"degas_log2fc":-0.13237,"degas_padj":0.00129238},{"cell_type":"Oli","gene_symbol":"OFD1","gene_symbol_current":"OFD1","gene_id":"ENSG00000046651","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.361607,"nucleus_log2fc":0.0423864,"nucleus_score":1.00719,"pct_ad":0.273723,"pct_control":0.272367,"donor_test":"not significant","donor_padj":0.866891,"donor_log2fc":0.0700432,"donor_lfcse":0.0751298,"donor_log2fc_shrunk":0.0118739,"degas_log2fc":-0.0379488,"degas_padj":0.0998292}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000046651","module":"brown","kme":0.145642,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000046651","entrez_id":["8481"],"uniprot":["O75665"],"ncbi_summary":"This gene is located on the X chromosome and encodes a centrosomal protein. A knockout mouse model has been used to study the effect of mutations in this gene. The mouse gene is also located on the X chromosome, however, unlike the human gene it is not subject to X inactivation. Mutations in this gene are associated with oral-facial-digital syndrome type I and Simpson-Golabi-Behmel syndrome type 2. Many pseudogenes have been identified; a single pseudogene is found on chromosome 5 while as many as fifteen have been found on the Y chromosome. [provided by RefSeq, Aug 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75665","text":"Component of the centrioles controlling mother and daughter centrioles length. Recruits to the centriole IFT88 and centriole distal appendage-specific proteins including CEP164 (By similarity). Involved in the biogenesis of the cilium, a centriole-associated function. The cilium is a cell surface projection found in many vertebrate cells required to transduce signals important for development and tissue homeostasis (PubMed:33934390). Plays an important role in development by regulating Wnt signaling and the specification of the left-right axis. Only OFD1 localized at the centriolar satellites is removed by autophagy, which is an important step in the ciliogenesis regulation (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}