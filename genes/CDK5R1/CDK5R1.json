5526,"donor_log2fc":0.086431,"donor_lfcse":0.0873692,"donor_log2fc_shrunk":0.00525872},{"cell_type":"Mic","gene_symbol":"CDK5R1","gene_symbol_current":"CDK5R1","gene_id":"ENSG00000176749","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.972857,"donor_log2fc":0.0359002,"donor_lfcse":0.190792,"donor_log2fc_shrunk":0.00188839},{"cell_type":"OPC","gene_symbol":"CDK5R1","gene_symbol_current":"CDK5R1","gene_id":"ENSG00000176749","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0333353,"nucleus_log2fc":-0.19026,"nucleus_score":-2.59053,"pct_ad":0.0963316,"pct_control":0.110246,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.237369,"donor_lfcse":0.126913,"donor_log2fc_shrunk":-1.53844e-05},{"cell_type":"Oli","gene_symbol":"CDK5R1","gene_symbol_current":"CDK5R1","gene_id":"ENSG00000176749","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.949744,"donor_log2fc":-0.0466115,"donor_lfcse":0.112304,"donor_log2fc_shrunk":-0.00411714}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000176749","module":"blue","kme":0.0844597,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000176749","module":"brown","kme":0.351352,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000176749","entrez_id":["8851"],"uniprot":["Q15078"],"ncbi_summary":"The protein encoded by this gene (p35) is a neuron-specific activator of cyclin-dependent kinase 5 (CDK5); the activation of CDK5 is required for proper development of the central nervous system. The p35 form of this protein is proteolytically cleaved by calpain, generating a p25 form. The cleavage of p35 into p25 results in relocalization of the protein from the cell periphery to nuclear and perinuclear regions. P25 deregulates CDK5 activity by prolonging its activation and changing its cellular location. The p25 form accumulates in the brain neurons of patients with Alzheimer's disease. This accumulation correlates with an increase in CDK5 kinase activity, and may lead to aberrantly phosphorylated forms of the microtubule-associated protein tau, which contributes to Alzheimer's disease. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15078","text":"p35 is a neuron specific activator of CDK5. The complex p35/CDK5 is required for neurite outgrowth and cortical lamination. Involved in dendritic spine morphogenesis by mediating the EFNA1-EPHA4 signaling. Activator of TPKII. The complex p35/CDK5 participates in the regulation of the circadian clock by modulating the function of CLOCK protein: phosphorylates CLOCK at 'Thr-451' and 'Thr-461' and regulates the transcriptional activity of the CLOCK-BMAL1 heterodimer in association with altered stability and subcellular distribution."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}