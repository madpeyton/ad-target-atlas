43146,"pct_ad":0.162378,"pct_control":0.154373,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.00736561,"donor_lfcse":0.167319,"donor_log2fc_shrunk":-2.67964e-07}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000137575","module":"yellow","kme":0.276378,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000137575","module":"turquoise","kme":0.231869,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000137575","module":"turquoise","kme":0.0843562,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000137575","entrez_id":["6386"],"uniprot":["O00560"],"ncbi_summary":"The protein encoded by this gene was initially identified as a molecule linking syndecan-mediated signaling to the cytoskeleton. The syntenin protein contains tandemly repeated PDZ domains that bind the cytoplasmic, C-terminal domains of a variety of transmembrane proteins. This protein may also affect cytoskeletal-membrane organization, cell adhesion, protein trafficking, and the activation of transcription factors. The protein is primarily localized to membrane-associated adherens junctions and focal adhesions but is also found at the endoplasmic reticulum and nucleus. Alternative splicing results in multiple transcript variants encoding different isoforms. Related pseudogenes have been identified on multiple chromosomes. [provided by RefSeq, Jan 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00560","text":"Multifunctional adapter protein involved in diverse array of functions including trafficking of transmembrane proteins, neuro and immunomodulation, exosome biogenesis, and tumorigenesis (PubMed:26291527). Positively regulates TGFB1-mediated SMAD2/3 activation and TGFB1-induced epithelial-to-mesenchymal transition (EMT) and cell migration in various cell types. May increase TGFB1 signaling by enhancing cell-surface expression of TGFR1 by preventing the interaction between TGFR1 and CAV1 and subsequent CAV1-dependent internalization and degradation of TGFR1 (PubMed:25893292). In concert with SDC1/4 and PDCD6IP, regulates exosome biogenesis (PubMed:22660413). Regulates migration, growth, proliferation, and cell cycle progression in a variety of cancer types (PubMed:26539120). In adherens junctions may function to couple syndecans to cytoskeletal proteins or signaling components. Seems to couple transcription factor SOX4 to the IL-5 receptor (IL5RA) (PubMed:11498591). May also play a role in vesicular trafficking (PubMed:11179419). Seems to be required for the targeting of TGFA to the cell surface in the early secretory pathway (PubMed:10230395)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}