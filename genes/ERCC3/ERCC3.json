163161","module":"turquoise","kme":0.0808459,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000163161"],"dataset_symbols":["ERCC3"],"explorer":"explorer.html?dataset=mathys2019#gene/ERCC3","cell_types":[{"cell_type":"Ex","gene_symbol":"ERCC3","gene_symbol_current":"ERCC3","gene_id":"ENSG00000163161","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0832175,"nucleus_log2fc":-0.0657294,"nucleus_score":-1.93795,"pct_ad":0.248984,"pct_control":0.260887,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0391624,"donor_lfcse":0.0673737,"donor_log2fc_shrunk":-7.78125e-05},{"cell_type":"In","gene_symbol":"ERCC3","gene_symbol_current":"ERCC3","gene_id":"ENSG00000163161","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.569652,"nucleus_log2fc":0.0877585,"nucleus_score":1.29365,"pct_ad":0.161047,"pct_control":0.146592,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0611293,"donor_lfcse":0.125977,"donor_log2fc_shrunk":-1.14847e-05},{"cell_type":"Oli","gene_symbol":"ERCC3","gene_symbol_current":"ERCC3","gene_id":"ENSG00000163161","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.754681,"donor_log2fc":-0.223066,"donor_lfcse":0.121588,"donor_log2fc_shrunk":-0.0155003}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163161","entrez_id":["2071"],"uniprot":["P19447"],"ncbi_summary":"This gene encodes an ATP-dependent DNA helicase that functions in nucleotide excision repair. The encoded protein is a subunit of basal transcription factor 2 (TFIIH) and, therefore, also functions in class II transcription. Mutations in this gene are associated with Xeroderma pigmentosum B, Cockayne's syndrome, and trichothiodystrophy. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Dec 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P19447","text":"ATP-dependent 3'-5' DNA helicase/translocase (PubMed:17466626, PubMed:27193682, PubMed:33902107, PubMed:8465201, PubMed:8663148). Binds dsDNA rather than ssDNA, unzipping it in a translocase rather than classical helicase activity (PubMed:27193682, PubMed:33902107). Component of the general transcription and DNA repair factor IIH (TFIIH) core complex (PubMed:10024882, PubMed:17466626, PubMed:8157004, PubMed:8465201). When complexed to CDK-activating kinase (CAK), involved in RNA transcription by RNA polymerase II. The ATPase activity of XPB/ERCC3, but not its helicase activity, is required for DNA opening; it may wrap around the damaged DNA wedging it open, causing localized melting that allows XPD/ERCC2 helicase to anchor (PubMed:10024882, PubMed:17466626). In transcription, TFIIH has an essential role in transcription initiation (PubMed:30894545, PubMed:8157004). When the pre-initiation complex (PIC) has been established, TFIIH is required for promoter opening and promoter escape (PubMed:8157004). The ATP-dependent helicase activity of XPB/ERCC3 is required for promoter opening and promoter escape (PubMed:10024882). In transcription pre-initiation complexes induces and propagates a DNA twist to open DNA (PubMed:27193682, PubMed:33902107). Also involved in transcription-coupled nucleotide excision repair (NER) of damaged DNA (PubMed:17466626, PubMed:2111438, PubMed:8157004). In NER, TFIIH acts by opening DNA around the lesion to allow the excision of the damaged oligonucleotide and its replacement by a new DNA fragment. The structure of the TFIIH transcription complex differs from the NER-TFIIH complex; large movements by XPD/ERCC2 and XPB/ERCC3 are stabilized by XPA (PubMed:31253769, PubMed:33902107). XPA retains XPB/ERCC3 at the 5' end of a DNA bubble (mimicking DNA damage) (PubMed:31253769)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}