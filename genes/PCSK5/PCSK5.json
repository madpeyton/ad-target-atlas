383174,"donor_lfcse":0.150764,"donor_log2fc_shrunk":1.76058e-06},{"cell_type":"OPC","gene_symbol":"PCSK5","gene_symbol_current":"PCSK5","gene_id":"ENSG00000099139","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.930339,"nucleus_log2fc":0.0365883,"nucleus_score":0.220741,"pct_ad":0.243328,"pct_control":0.239847,"donor_test":"not significant","donor_padj":0.993604,"donor_log2fc":0.0502695,"donor_lfcse":0.132246,"donor_log2fc_shrunk":0.000587638}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000099139","module":"purple","kme":0.243252,"hub":false,"module_direction":"lower in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000099139","module":"blue","kme":0.016763,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000099139","entrez_id":["5125"],"uniprot":["Q92824"],"ncbi_summary":"This gene encodes a member of the subtilisin-like proprotein convertase family, which includes proteases that process protein and peptide precursors trafficking through regulated or constitutive branches of the secretory pathway. The encoded protein undergoes an initial autocatalytic processing event in the ER to generate a heterodimer which exits the ER. It then sorts to the trans-Golgi network where a second autocatalytic event takes place and the catalytic activity is acquired. This encoded protein is widely expressed and one of the seven basic amino acid-specific members which cleave their substrates at single or paired basic residues. It mediates posttranslational endoproteolytic processing for several integrin alpha subunits and is thought to process prorenin, pro-membrane type-1 matrix metalloproteinase and HIV-1 glycoprotein gp160. Alternative splicing results in multiple transcript variants, some of which encode distinct isoforms, including a protease packaged into dense core granules (PC5A) and a type 1 membrane bound protease (PC5B). [provided by RefSeq, May 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92824","text":"Serine endoprotease that processes various proproteins by cleavage at paired basic amino acids, recognizing the RXXX[KR]R consensus motif. Likely functions in the constitutive and regulated secretory pathways. Plays an essential role in pregnancy establishment by proteolytic activation of a number of important factors such as BMP2, CALD1 and alpha-integrins."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}