ol_current":"MSN","gene_id":"ENSG00000147065","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.545589,"nucleus_log2fc":-0.135677,"nucleus_score":-0.858993,"pct_ad":0.0994632,"pct_control":0.103641,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.110113,"donor_lfcse":0.140274,"donor_log2fc_shrunk":-5.77641e-06,"degas_log2fc":-0.281484,"degas_padj":0.0021539},{"cell_type":"Oli","gene_symbol":"MSN","gene_symbol_current":"MSN","gene_id":"ENSG00000147065","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.562326,"donor_log2fc":0.270136,"donor_lfcse":0.126513,"donor_log2fc_shrunk":0.020806,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"In","gene_id":"ENSG00000147065","module":"blue","kme":0.188867,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000147065","module":"yellow","kme":0.232939,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000147065","entrez_id":["4478"],"uniprot":["P26038"],"ncbi_summary":"Moesin (for membrane-organizing extension spike protein) is a member of the ERM family which includes ezrin and radixin. ERM proteins appear to function as cross-linkers between plasma membranes and actin-based cytoskeletons. Moesin is localized to filopodia and other membranous protrusions that are important for cell-cell recognition and signaling and for cell movement. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P26038","text":"Ezrin-radixin-moesin (ERM) family protein that connects the actin cytoskeleton to the plasma membrane and thereby regulates the structure and function of specific domains of the cell cortex. Tethers actin filaments by oscillating between a resting and an activated state providing transient interactions between moesin and the actin cytoskeleton (PubMed:10212266). Once phosphorylated on its C-terminal threonine, moesin is activated leading to interaction with F-actin and cytoskeletal rearrangement (PubMed:10212266). These rearrangements regulate many cellular processes, including cell shape determination, membrane transport, and signal transduction (PubMed:12387735, PubMed:15039356). The role of moesin is particularly important in immunity acting on both T and B-cells homeostasis and self-tolerance, regulating lymphocyte egress from lymphoid organs (PubMed:9298994, PubMed:9616160). Modulates phagolysosomal biogenesis in macrophages (By similarity). Also participates in immunologic synapse formation (PubMed:27405666)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}