","kme":0.172632,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000130294","module":"red","kme":0.304458,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000130294","module":"turquoise","kme":0.146856,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000130294","module":"red","kme":0.0734389,"hub":false,"module_direction":"lower in AD","module_padj":0.627226,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000130294","entrez_id":["547"],"uniprot":["Q12756"],"ncbi_summary":"The protein encoded by this gene is a member of the kinesin family and functions as an anterograde motor protein that transports membranous organelles along axonal microtubules. Mutations at this locus have been associated with spastic paraplegia-30 and hereditary sensory neuropathy IIC. Alternatively spliced transcript variants encoding distinct isoforms have been described. [provided by RefSeq, Apr 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q12756","text":"Kinesin motor with a plus-end-directed microtubule motor activity (By similarity). It is required for anterograde axonal transport of synaptic vesicle precursors (PubMed:33880452). Also required for neuronal dense core vesicles (DCVs) transport to the dendritic spines and axons. The interaction calcium-dependent with CALM1 increases vesicle motility and interaction with the scaffolding proteins PPFIA2 and TANC2 recruits DCVs to synaptic sites."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}