ct_ad":0.840889,"pct_control":0.839458,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0123693,"donor_lfcse":0.118887,"donor_log2fc_shrunk":9.26494e-07},{"cell_type":"Oli","gene_symbol":"NCOA2","gene_symbol_current":"NCOA2","gene_id":"ENSG00000140396","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00565356,"nucleus_log2fc":0.0441151,"nucleus_score":2.90557,"pct_ad":0.61888,"pct_control":0.62566,"donor_test":"not significant","donor_padj":0.902141,"donor_log2fc":0.0813759,"donor_lfcse":0.110374,"donor_log2fc_shrunk":0.00659691}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000140396","module":"green","kme":0.191355,"hub":false,"module_direction":"higher in AD","module_padj":0.232138,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000140396","module":"greenyellow","kme":0.280003,"hub":false,"module_direction":"higher in AD","module_padj":0.778135,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000140396","module":"pink","kme":0.29585,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000140396","module":"blue","kme":0.194878,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000140396","entrez_id":["10499"],"uniprot":["Q15596"],"ncbi_summary":"The protein encoded by this gene functions as a transcriptional coactivator for nuclear hormone receptors, including steroid, thyroid, retinoid, and vitamin D receptors. The encoded protein acts as an intermediary factor for the ligand-dependent activity of these nuclear receptors, which regulate their target genes upon binding of cognate response elements. This gene has been found to be involved in translocations that result in fusions with other genes in various cancers, including the lysine acetyltransferase 6A (KAT6A) gene in acute myeloid leukemia, the ETS variant 6 (ETV6) gene in acute lymphoblastic leukemia, and the hes related family bHLH transcription factor with YRPW motif 1 (HEY1) gene in mesenchymal chondrosarcoma. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Mar 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15596","text":"Transcriptional coactivator for steroid receptors and nuclear receptors (PubMed:23508108, PubMed:8670870, PubMed:9430642, PubMed:22504882, PubMed:26553876). Coactivator of the steroid binding domain (AF-2) but not of the modulating N-terminal domain (AF-1) (PubMed:23508108, PubMed:8670870, PubMed:9430642). Required with NCOA1 to control energy balance between white and brown adipose tissues (PubMed:23508108, PubMed:8670870, PubMed:9430642). Critical regulator of glucose metabolism regulation, acts as a RORA coactivator to specifically modulate G6PC1 expression (PubMed:23508108, PubMed:8670870, PubMed:9430642). Involved in the positive regulation of the transcriptional activity of the glucocorticoid receptor NR3C1 by sumoylation enhancer RWDD3 (PubMed:23508108). Positively regulates the circadian clock by acting as a transcriptional coactivator for the CLOCK-BMAL1 heterodimer (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}