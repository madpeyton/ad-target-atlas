p 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6UXV4","text":"Component of the MICOS complex, a large protein complex of the mitochondrial inner membrane that plays crucial roles in the maintenance of crista junctions, inner membrane architecture, and formation of contact sites to the outer membrane. Specifically binds to cardiolipin (in vitro) but not to the precursor lipid phosphatidylglycerol. Plays a crucial role in crista junction formation and mitochondrial function (PubMed:23704930), (PubMed:25764979)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}