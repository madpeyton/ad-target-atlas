uoise","kme":0.0516581,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000099904","module":"turquoise","kme":0.0773951,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000099904"],"dataset_symbols":["ZDHHC8"],"explorer":"explorer.html?dataset=mathys2019#gene/ZDHHC8","cell_types":[{"cell_type":"Ex","gene_symbol":"ZDHHC8","gene_symbol_current":"ZDHHC8","gene_id":"ENSG00000099904","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.214613,"nucleus_log2fc":0.119525,"nucleus_score":1.41399,"pct_ad":0.18143,"pct_control":0.175626,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.119582,"donor_lfcse":0.12991,"donor_log2fc_shrunk":1.68917e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000099904","entrez_id":["29801"],"uniprot":["Q9ULC8"],"ncbi_summary":"This gene encodes a four transmembrane protein that is a member of the zinc finger DHHC domain-containing protein family. The encoded protein may function as a palmitoyltransferase. Defects in this gene may be associated with a susceptibility to schizophrenia. Alternate splicing of this gene results in multiple transcript variants. A pseudogene of this gene is found on chromosome 22.[provided by RefSeq, May 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9ULC8","text":"Palmitoyltransferase that catalyzes the addition of palmitate onto various protein substrates and therefore functions in several unrelated biological processes (PubMed:19556522, PubMed:23034182, PubMed:26535572). Through the palmitoylation of ABCA1 regulates the localization of the transporter to the plasma membrane and thereby regulates its function in cholesterol and phospholipid efflux (PubMed:19556522). Could also pamitoylate the D(2) dopamine receptor DRD2 and regulate its stability and localization to the plasma membrane (PubMed:26535572). Could also play a role in glutamatergic transmission (By similarity). (Microbial infection) Able to palmitoylate SARS coronavirus-2/SARS-CoV-2 spike protein following its synthesis in the endoplasmic reticulum (ER). In the infected cell, promotes spike biogenesis by protecting it from premature ER degradation, increases half-life and controls the lipid organization of its immediate membrane environment. Once the virus has formed, spike palmitoylation controls fusion with the target cell."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}