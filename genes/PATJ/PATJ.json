_direction":"higher in AD","nucleus_padj":0.579749,"nucleus_log2fc":0.1869,"nucleus_score":1.08758,"pct_ad":0.166405,"pct_control":0.15249,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":0.207591,"donor_lfcse":0.214149,"donor_log2fc_shrunk":0.000922608},{"cell_type":"Oli","gene_symbol":"INADL","gene_symbol_current":"PATJ","gene_id":"ENSG00000132849","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.923147,"donor_log2fc":-0.0992901,"donor_lfcse":0.160294,"donor_log2fc_shrunk":-0.00370939}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000132849","module":"blue","kme":0.17668,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000132849","module":"greenyellow","kme":0.275716,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000132849","module":"yellow","kme":0.232674,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000132849","module":"brown","kme":0.202709,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000132849","entrez_id":["10207"],"uniprot":["Q8NI35"],"ncbi_summary":"This gene encodes a protein with multiple PDZ domains. PDZ domains mediate protein-protein interactions, and proteins with multiple PDZ domains often organize multimeric complexes at the plasma membrane. This protein localizes to tight junctions and to the apical membrane of epithelial cells. A similar protein in Drosophila is a scaffolding protein which tethers several members of a multimeric signaling complex in photoreceptors. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8NI35","text":"Scaffolding protein that facilitates the localization of proteins to the cell membrane (PubMed:11927608, PubMed:16678097, PubMed:22006950). Required for the correct formation of tight junctions and epithelial apico-basal polarity (PubMed:11927608, PubMed:16678097). Acts (via its L27 domain) as an apical connector and elongation factor for multistranded TJP1/ZO1 condensates that form a tight junction belt, thereby required for the formation of the tight junction-mediated cell barrier (By similarity). Positively regulates epithelial cell microtubule elongation and cell migration, possibly via facilitating localization of PRKCI/aPKC and PAR3D/PAR3 at the leading edge of migrating cells (By similarity). Plays a role in the correct reorientation of the microtubule-organizing center during epithelial migration (By similarity). May regulate the surface expression and/or function of ASIC3 in sensory neurons (By similarity). May recruit ARHGEF18 to apical cell-cell boundaries (PubMed:22006950)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}