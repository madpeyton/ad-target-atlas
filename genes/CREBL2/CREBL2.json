eus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.896148,"donor_log2fc":-0.100813,"donor_lfcse":0.135948,"donor_log2fc_shrunk":-0.00515767}],"modules":[{"cell_type":"In","gene_id":"ENSG00000111269","module":"turquoise","kme":0.18009,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000111269","entrez_id":["1389"],"uniprot":["O60519"],"ncbi_summary":"cAMP response element (CRE)-binding protein-like-2 (CREBL2) was identified in a search to find genes in a commonly deleted region on chromosome 12p13 flanked by ETV6 and CDKN1B genes, frequently associated with hematopoietic malignancies, as well as breast, non-small-cell lung and ovarian cancers. CREBL2 shares a 41% identity with CRE-binding protein (CREB) over a 48-base long region which encodes the bZip domain of CREB. The bZip domain consists of about 30 amino acids rich in basic residues involved in DNA binding, followed by a leucine zipper motif involved in protein dimerization. This suggests that CREBL2 encodes a protein with DNA binding capabilities. The occurance of CREBL2 deletion in malignancy suggests that CREBL2 may act as a tumor suppressor gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60519","text":"Probable regulator of CREB1 transcriptional activity which is involved in adipose cells differentiation. May also play a regulatory role in the cell cycle. Identification in a chromosomal region frequently deleted in various cancers suggests that it might act as a tumor suppressor."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}