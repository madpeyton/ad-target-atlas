nificant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.853007,"donor_log2fc":-0.118424,"donor_lfcse":0.172198,"donor_log2fc_shrunk":-0.00192108,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Mic","gene_symbol":"CD40","gene_symbol_current":"CD40","gene_id":"ENSG00000101017","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.128976,"nucleus_log2fc":-0.0744073,"nucleus_score":-1.75793,"pct_ad":0.0998143,"pct_control":0.107949,"donor_test":"not significant","donor_padj":0.980121,"donor_log2fc":-0.0176119,"donor_lfcse":0.121012,"donor_log2fc_shrunk":-0.00222016,"degas_log2fc":0.197995,"degas_padj":0.00891859}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101017","entrez_id":["958"],"uniprot":["P25942"],"ncbi_summary":"This gene is a member of the TNF-receptor superfamily. The encoded protein is a receptor on antigen-presenting cells of the immune system and is essential for mediating a broad variety of immune and inflammatory responses including T cell-dependent immunoglobulin class switching, memory B cell development, and germinal center formation. AT-hook transcription factor AKNA is reported to coordinately regulate the expression of this receptor and its ligand, which may be important for homotypic cell interactions. Adaptor protein TNFR2 interacts with this receptor and serves as a mediator of the signal transduction. The interaction of this receptor and its ligand is found to be necessary for amyloid-beta-induced microglial activation, and thus is thought to be an early event in Alzheimer disease pathogenesis. Mutations affecting this gene are the cause of autosomal recessive hyper-IgM immunodeficiency type 3 (HIGM3). Multiple alternatively spliced transcript variants of this gene encoding distinct isoforms have been reported. [provided by RefSeq, Nov 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P25942","text":"Receptor for TNFSF5/CD40LG (PubMed:31331973). Transduces TRAF6- and MAP3K8-mediated signals that activate ERK in macrophages and B cells, leading to induction of immunoglobulin secretion (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}