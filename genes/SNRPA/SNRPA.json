ted":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.28177,"nucleus_log2fc":-0.0641543,"nucleus_score":-1.23644,"pct_ad":0.108696,"pct_control":0.113734,"donor_test":"not significant","donor_padj":0.992956,"donor_log2fc":0.0297228,"donor_lfcse":0.105296,"donor_log2fc_shrunk":2.81218e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000077312","entrez_id":["6626"],"uniprot":["P09012"],"ncbi_summary":"The protein encoded by this gene associates with stem loop II of the U1 small nuclear ribonucleoprotein, which binds the 5' splice site of precursor mRNAs and is required for splicing. The encoded protein autoregulates itself by polyadenylation inhibition of its own pre-mRNA via dimerization and has been implicated in the coupling of splicing and polyadenylation. [provided by RefSeq, Oct 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P09012","text":"Component of the spliceosomal U1 snRNP, which is essential for recognition of the pre-mRNA 5' splice-site and the subsequent assembly of the spliceosome. U1 snRNP is the first snRNP to interact with pre-mRNA. This interaction is required for the subsequent binding of U2 snRNP and the U4/U6/U5 tri-snRNP. SNRPA binds stem loop II of U1 snRNA. In a snRNP-free form (SF-A) may be involved in coupled pre-mRNA splicing and polyadenylation process. May bind preferentially to the 5'-UGCAC-3' motif on RNAs."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}