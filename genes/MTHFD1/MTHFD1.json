module_direction":"lower in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000100714"],"dataset_symbols":["MTHFD1"],"explorer":"explorer.html?dataset=mathys2019#gene/MTHFD1","cell_types":[{"cell_type":"Ex","gene_symbol":"MTHFD1","gene_symbol_current":"MTHFD1","gene_id":"ENSG00000100714","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.71365e-13,"nucleus_log2fc":-0.302192,"nucleus_score":-7.74266,"pct_ad":0.207842,"pct_control":0.252034,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.153233,"donor_lfcse":0.101918,"donor_log2fc_shrunk":-1.5393e-05},{"cell_type":"In","gene_symbol":"MTHFD1","gene_symbol_current":"MTHFD1","gene_id":"ENSG00000100714","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.956727,"nucleus_log2fc":-0.0245202,"nucleus_score":-0.174372,"pct_ad":0.111801,"pct_control":0.11329,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0511879,"donor_lfcse":0.171463,"donor_log2fc_shrunk":-1.42339e-05}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000100714","module":"blue","kme":0.152161,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000100714","module":"turquoise","kme":0.130814,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000100714","module":"turquoise","kme":0.123677,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100714","entrez_id":["4522"],"uniprot":["P11586"],"ncbi_summary":"This gene encodes a protein that possesses three distinct enzymatic activities, 5,10-methylenetetrahydrofolate dehydrogenase, 5,10-methenyltetrahydrofolate cyclohydrolase and 10-formyltetrahydrofolate synthetase. Each of these activities catalyzes one of three sequential reactions in the interconversion of 1-carbon derivatives of tetrahydrofolate, which are substrates for methionine, thymidylate, and de novo purine syntheses. The trifunctional enzymatic activities are conferred by two major domains, an aminoterminal portion containing the dehydrogenase and cyclohydrolase activities and a larger synthetase domain. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P11586","text":"Trifunctional enzyme that catalyzes the interconversion of three forms of one-carbon-substituted tetrahydrofolate: (6R)-5,10-methylene-5,6,7,8-tetrahydrofolate, 5,10-methenyltetrahydrofolate and (6S)-10-formyltetrahydrofolate (PubMed:10828945, PubMed:18767138, PubMed:1881876). These derivatives of tetrahydrofolate are differentially required in nucleotide and amino acid biosynthesis, (6S)-10-formyltetrahydrofolate being required for purine biosynthesis while (6R)-5,10-methylene-5,6,7,8-tetrahydrofolate is used for serine and methionine biosynthesis for instance (PubMed:18767138, PubMed:25633902)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}