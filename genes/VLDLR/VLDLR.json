s_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.565998,"donor_log2fc":0.366926,"donor_lfcse":0.227679,"donor_log2fc_shrunk":0.0152379},{"cell_type":"OPC","gene_symbol":"VLDLR","gene_symbol_current":"VLDLR","gene_id":"ENSG00000147852","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.898338,"nucleus_log2fc":0.0289624,"nucleus_score":0.207949,"pct_ad":0.121384,"pct_control":0.120237,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0957665,"donor_lfcse":0.127448,"donor_log2fc_shrunk":6.05466e-06},{"cell_type":"Oli","gene_symbol":"VLDLR","gene_symbol_current":"VLDLR","gene_id":"ENSG00000147852","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.660987,"nucleus_log2fc":0.00633537,"nucleus_score":-0.498109,"pct_ad":0.164158,"pct_control":0.165955,"donor_test":"not significant","donor_padj":0.997704,"donor_log2fc":0.00207179,"donor_lfcse":0.110115,"donor_log2fc_shrunk":0.000224232}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000147852","module":"magenta","kme":0.226094,"hub":false,"module_direction":"lower in AD","module_padj":0.209344,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000147852","module":"yellow","kme":0.230685,"hub":false,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000147852","entrez_id":["7436"],"uniprot":["P98155"],"ncbi_summary":"The low density lipoprotein receptor (LDLR) gene family consists of cell surface proteins involved in receptor-mediated endocytosis of specific ligands. This gene encodes a lipoprotein receptor that is a member of the LDLR family and plays important roles in VLDL-triglyceride metabolism and the reelin signaling pathway. Mutations in this gene cause VLDLR-associated cerebellar hypoplasia. Alternative splicing generates multiple transcript variants encoding distinct isoforms for this gene. [provided by RefSeq, Aug 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P98155","text":"Multifunctional cell surface receptor that binds VLDL and transports it into cells by endocytosis and therefore plays an important role in energy metabolism. Also binds to a wide range of other molecules including Reelin/RELN or apolipoprotein E/APOE-containing ligands as well as clusterin/CLU (PubMed:24381170, PubMed:30873003). In the off-state of the pathway, forms homooligomers or heterooligomers with LRP8 (PubMed:30873003). Upon binding to ligands, homooligomers are rearranged to higher order receptor clusters that transmit the extracellular RELN signal to intracellular signaling processes by binding to DAB1 (PubMed:30873003). This interaction results in phosphorylation of DAB1 leading to the ultimate cell responses required for the correct positioning of newly generated neurons. Later, mediates a stop signal for migrating neurons, preventing them from entering the marginal zone (By similarity). (Microbial infection) Acts as a receptor for Semliki Forest virus. (Microbial infection) Functions as a receptor for yellow fever virus."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}