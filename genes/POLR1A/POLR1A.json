leus_log2fc":0.0433715,"nucleus_score":0.988995,"pct_ad":0.202507,"pct_control":0.196429,"donor_test":"not significant","donor_padj":0.969863,"donor_log2fc":0.0310304,"donor_lfcse":0.140277,"donor_log2fc_shrunk":0.00307941,"degas_log2fc":-0.382301,"degas_padj":1.3657e-13},{"cell_type":"OPC","gene_symbol":"POLR1A","gene_symbol_current":"POLR1A","gene_id":"ENSG00000068654","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0654869,"nucleus_log2fc":-0.122516,"nucleus_score":-2.28899,"pct_ad":0.274381,"pct_control":0.290262,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.097467,"donor_lfcse":0.0878925,"donor_log2fc_shrunk":-1.29013e-05,"degas_log2fc":-0.369485,"degas_padj":1.9576e-12},{"cell_type":"Oli","gene_symbol":"POLR1A","gene_symbol_current":"POLR1A","gene_id":"ENSG00000068654","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.58957e-05,"nucleus_log2fc":-0.121631,"nucleus_score":-4.35928,"pct_ad":0.179006,"pct_control":0.191525,"donor_test":"not significant","donor_padj":0.802248,"donor_log2fc":-0.0937777,"donor_lfcse":0.0761695,"donor_log2fc_shrunk":-0.0169258,"degas_log2fc":-0.229026,"degas_padj":6.97686e-17}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000068654","module":"blue","kme":0.114513,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000068654","module":"blue","kme":0.171827,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000068654","module":"blue","kme":0.15042,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000068654","module":"blue","kme":0.0989674,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000068654","entrez_id":["25885"],"uniprot":["O95602"],"ncbi_summary":"The protein encoded by this gene is the largest subunit of the RNA polymerase I complex. The encoded protein represents the catalytic subunit of the complex, which transcribes DNA into ribosomal RNA precursors. Defects in this gene are a cause of the Cincinnati type of acrofacial dysostosis. [provided by RefSeq, May 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95602","text":"Catalytic core component of RNA polymerase I (Pol I), a DNA-dependent RNA polymerase which synthesizes ribosomal RNA precursors using the four ribonucleoside triphosphates as substrates. Transcribes 47S pre-rRNAs from multicopy rRNA gene clusters, giving rise to 5.8S, 18S and 28S ribosomal RNAs (PubMed:11250903, PubMed:11283244, PubMed:16858408, PubMed:34671025, PubMed:34887565, PubMed:36271492). Pol I-mediated transcription cycle proceeds through transcription initiation, transcription elongation and transcription termination stages. During transcription initiation, Pol I pre-initiation complex (PIC) is recruited by the selectivity factor 1 (SL1/TIF-IB) complex bound to the core promoter that precedes an rDNA repeat unit. The PIC assembly bends the promoter favoring the formation of the transcription bubble and promoter escape. Once the polymerase has escaped from the promoter it enters the elongation phase during which RNA is actively polymerized, based on complementarity with the template DNA strand. Highly processive, assembles in structures referred to as 'Miller trees' where many elongating Pol I complexes queue and transcribe the same rDNA coding regions. At terminator sequences downstream of the rDNA gene, PTRF interacts with Pol I and halts Pol I transcription leading to the release of the RNA transcript and polymerase from the DNA (PubMed:11250903, PubMed:11283244, PubMed:16858408, PubMed:34671025, PubMed:34887565, PubMed:36271492). Forms Pol I active center together with the second largest subunit POLR1B/RPA2. Appends one nucleotide at a time to the 3' end of the nascent RNA, with POLR1A/RPA1 contributing a Mg(2+)-coordinating DxDGD motif, and POLR1B/RPA2 participating in the coordination of a second Mg(2+) ion and providing lysine residues believed to facilitate Watson-Crick base pairing between the incoming nucleotide and the template base. Typically, Mg(2+) ions direct a 5' nucleoside triphosphate to form a phosphodiester bond with the 3' hydroxyl of the preceding nucleotide of the nascent RNA, with the elimination of pyrophosphate. Has proofreading activity: Pauses and backtracks to allow the cleavage of a missincorporated nucleotide via POLR1H/RPA12. High Pol I processivity is associated with decreased transcription fidelity (By similarity) (PubMed:11250903, PubMed:11283244, PubMed:16858408, PubMed:34671025, PubMed:34887565, PubMed:36271492)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}