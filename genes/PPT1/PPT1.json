e":0.077917,"donor_log2fc_shrunk":-0.00678418}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000131238","module":"turquoise","kme":0.076206,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000131238","module":"brown","kme":0.19766,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000131238","module":"turquoise","kme":0.118019,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000131238","module":"turquoise","kme":0.0832026,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000131238","entrez_id":["5538"],"uniprot":["P50897"],"ncbi_summary":"The protein encoded by this gene is a small glycoprotein involved in the catabolism of lipid-modified proteins during lysosomal degradation. The encoded enzyme removes thioester-linked fatty acyl groups such as palmitate from cysteine residues. Defects in this gene are a cause of infantile neuronal ceroid lipofuscinosis 1 (CLN1, or INCL) and neuronal ceroid lipofuscinosis 4 (CLN4). Two transcript variants encoding different isoforms have been found for this gene.[provided by RefSeq, Dec 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P50897","text":"Has thioesterase activity against fatty acid thioesters with 14 -18 carbons, including palmitoyl-CoA, S-palmitoyl-N-acetylcysteamine, and palmitoylated proteins (PubMed:12855696, PubMed:26731412, PubMed:8816748). In contrast to PPT2, PPT1 can hydrolyze palmitoylated proteins and palmitoylcysteine (PubMed:12855696)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}