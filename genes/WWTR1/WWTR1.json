,"dataset_symbols":["WWTR1"],"explorer":"explorer.html?dataset=mathys2019#gene/WWTR1","cell_types":[{"cell_type":"Ast","gene_symbol":"WWTR1","gene_symbol_current":"WWTR1","gene_id":"ENSG00000018408","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.38115,"nucleus_log2fc":-0.0799158,"nucleus_score":-1.14261,"pct_ad":0.12694,"pct_control":0.144437,"donor_test":"not significant","donor_padj":0.987406,"donor_log2fc":0.0105569,"donor_lfcse":0.165019,"donor_log2fc_shrunk":0.00079287},{"cell_type":"Ex","gene_symbol":"WWTR1","gene_symbol_current":"WWTR1","gene_id":"ENSG00000018408","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.106374,"donor_lfcse":0.147239,"donor_log2fc_shrunk":5.06848e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000018408","module":"black","kme":0.121998,"hub":false,"module_direction":"higher in AD","module_padj":0.56571,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000018408","entrez_id":["25937"],"uniprot":["Q9GZV5"],"ncbi_summary":"Enables transcription coactivator activity. Involved in several processes, including hippo signaling; positive regulation of cell differentiation; and regulation of signal transduction. Located in cytosol and nuclear body. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9GZV5","text":"Transcriptional coactivator which acts as a downstream regulatory target in the Hippo signaling pathway that plays a pivotal role in organ size control and tumor suppression by restricting proliferation and promoting apoptosis (PubMed:11118213, PubMed:18227151, PubMed:23911299). The core of this pathway is composed of a kinase cascade wherein STK3/MST2 and STK4/MST1, in complex with its regulatory protein SAV1, phosphorylates and activates LATS1/2 in complex with its regulatory protein MOB1, which in turn phosphorylates and inactivates YAP1 oncoprotein and WWTR1/TAZ (PubMed:18227151). WWTR1 enhances PAX8 and NKX2-1/TTF1-dependent gene activation (PubMed:19010321). In conjunction with YAP1, involved in the regulation of TGFB1-dependent SMAD2 and SMAD3 nuclear accumulation (PubMed:18568018). Plays a key role in coupling SMADs to the transcriptional machinery such as the mediator complex (PubMed:18568018). Regulates embryonic stem-cell self-renewal, promotes cell proliferation and epithelial-mesenchymal transition (PubMed:18227151, PubMed:18568018)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}