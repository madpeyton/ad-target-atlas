:false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000213551"],"dataset_symbols":["DNAJC9"],"explorer":"explorer.html?dataset=mathys2019#gene/DNAJC9","cell_types":[{"cell_type":"Ex","gene_symbol":"DNAJC9","gene_symbol_current":"DNAJC9","gene_id":"ENSG00000213551","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.185391,"nucleus_log2fc":0.107571,"nucleus_score":1.50302,"pct_ad":0.303637,"pct_control":0.300447,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.139922,"donor_lfcse":0.0783193,"donor_log2fc_shrunk":1.57242e-05},{"cell_type":"In","gene_symbol":"DNAJC9","gene_symbol_current":"DNAJC9","gene_id":"ENSG00000213551","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.936146,"nucleus_log2fc":0.00258636,"nucleus_score":0.279559,"pct_ad":0.184117,"pct_control":0.179894,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0437759,"donor_lfcse":0.114662,"donor_log2fc_shrunk":-3.62047e-06},{"cell_type":"Oli","gene_symbol":"DNAJC9","gene_symbol_current":"DNAJC9","gene_id":"ENSG00000213551","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.959548,"donor_log2fc":-0.0313473,"donor_lfcse":0.112464,"donor_log2fc_shrunk":-0.00228629}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000213551","module":"brown","kme":0.119814,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000213551","entrez_id":["23234"],"uniprot":["Q8WXX5"],"ncbi_summary":"Enables chaperone binding activity; heat shock protein binding activity; and histone binding activity. Involved in nucleosome assembly and positive regulation of ATPase activity. Located in several cellular components, including cytosol; extracellular space; and nucleoplasm. Part of chaperone complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WXX5","text":"Acts as a dual histone chaperone and heat shock co-chaperone (PubMed:33857403). As a histone chaperone, forms a co-chaperone complex with MCM2 and histone H3-H4 heterodimers; and may thereby assist MCM2 in histone H3-H4 heterodimer recognition and facilitate the assembly of histones into nucleosomes (PubMed:33857403). May also act as a histone co-chaperone together with TONSL (PubMed:33857403). May recruit histone chaperones ASF1A, NASP and SPT2 to histone H3-H4 heterodimers (PubMed:33857403). Also plays a role as co-chaperone of the HSP70 family of molecular chaperone proteins, such as HSPA1A, HSPA1B and HSPA8 (PubMed:17182002, PubMed:33857403). As a co-chaperone, may play a role in the recruitment of HSP70-type molecular chaperone machinery to histone H3-H4 substrates, thereby maintaining the histone structural integrity (PubMed:33857403). Exhibits activity to assemble histones onto DNA in vitro (PubMed:33857403)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}