dule_direction":"lower in AD","module_padj":0.572565,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000185567","entrez_id":["113146"],"uniprot":["Q8IVF2"],"ncbi_summary":"This gene encodes a large nucleoprotein. The encoded protein has a tripartite domain structure with a relatively short N-terminus and a long C-terminus, separated by a large body of repeats. The N-terminal PSD-95/Discs-large/ZO-1 (PDZ)-like domain is thought to function in the formation of stable homodimers. The encoded protein may play a role in calcium signaling by associating with calcium channel proteins. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Apr 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}