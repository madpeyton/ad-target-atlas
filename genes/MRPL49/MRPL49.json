donor_log2fc":-0.00985003,"donor_lfcse":0.136905,"donor_log2fc_shrunk":-5.43571e-07}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000149792","module":"turquoise","kme":0.166091,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000149792","entrez_id":["740"],"uniprot":["Q13405"],"ncbi_summary":"Mammalian mitochondrial ribosomal proteins are encoded by nuclear genes and help in protein synthesis within the mitochondrion. Mitochondrial ribosomes (mitoribosomes) consist of a small 28S subunit and a large 39S subunit. They have an estimated 75% protein to rRNA composition compared to prokaryotic ribosomes, where this ratio is reversed. Another difference between mammalian mitoribosomes and prokaryotic ribosomes is that the latter contain a 5S rRNA. Among different species, the proteins comprising the mitoribosome differ greatly in sequence, and sometimes in biochemical properties, which prevents easy recognition by sequence homology. Pseudogenes corresponding to this gene are found on chromosomes 5q and 8p. [provided by RefSeq, May 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}