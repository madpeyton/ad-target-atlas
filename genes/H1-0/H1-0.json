rot_function":[{"accession":"P07305","text":"Histone H1 protein binds to linker DNA between nucleosomes forming the macromolecular structure known as the chromatin fiber (PubMed:33238161). Histones H1 are necessary for the condensation of nucleosome chains into higher-order structured fibers and promote formation of the H3K27me3 mark by the PRC2/EED-EZH2 complex (PubMed:33238161). The histones H1.0 are found in cells that are in terminal stages of differentiation or that have low rates of cell division (PubMed:7374750)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}