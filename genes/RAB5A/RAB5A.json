":"Astrocytes","gene_id":"ENSG00000144566","module":"blue","kme":0.113829,"hub":false,"module_direction":"higher in AD","module_padj":0.903036,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000144566","module":"turquoise","kme":0.176092,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000144566","module":"turquoise","kme":0.166599,"hub":false,"module_direction":"lower in AD","module_padj":0.773167,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000144566"],"dataset_symbols":["RAB5A"],"explorer":"explorer.html?dataset=mathys2019#gene/RAB5A","cell_types":[{"cell_type":"Ex","gene_symbol":"RAB5A","gene_symbol_current":"RAB5A","gene_id":"ENSG00000144566","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0450065,"nucleus_log2fc":-0.0598902,"nucleus_score":-2.22217,"pct_ad":0.286469,"pct_control":0.301324,"donor_test":"not significant","donor_padj":0.990685,"donor_log2fc":-0.0203758,"donor_lfcse":0.0575619,"donor_log2fc_shrunk":-8.73007e-06},{"cell_type":"In","gene_symbol":"RAB5A","gene_symbol_current":"RAB5A","gene_id":"ENSG00000144566","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.946205,"nucleus_log2fc":-0.0920153,"nucleus_score":-0.234871,"pct_ad":0.172138,"pct_control":0.17118,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0438403,"donor_lfcse":0.120788,"donor_log2fc_shrunk":-3.14718e-06},{"cell_type":"OPC","gene_symbol":"RAB5A","gene_symbol_current":"RAB5A","gene_id":"ENSG00000144566","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.644021,"nucleus_log2fc":-0.104203,"nucleus_score":-0.941683,"pct_ad":0.184458,"pct_control":0.202299,"donor_test":"not significant","donor_padj":0.993604,"donor_log2fc":-0.0614127,"donor_lfcse":0.147559,"donor_log2fc_shrunk":-0.000578238},{"cell_type":"Oli","gene_symbol":"RAB5A","gene_symbol_current":"RAB5A","gene_id":"ENSG00000144566","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.942097,"donor_log2fc":0.0581806,"donor_lfcse":0.118016,"donor_log2fc_shrunk":0.00395657}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000144566","entrez_id":["5868"],"uniprot":["P20339"],"ncbi_summary":"Enables GDP binding activity; GTP binding activity; and GTPase activity. Involved in several processes, including amyloid-beta clearance by transcytosis; early endosome to late endosome transport; and regulation of exocytosis. Located in several cellular components, including cytoplasmic side of early endosome membrane; nucleoplasm; and terminal bouton. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P20339","text":"The small GTPases Rab are key regulators of intracellular membrane trafficking, from the formation of transport vesicles to their fusion with membranes. Rabs cycle between an inactive GDP-bound form and an active GTP-bound form that is able to recruit to membranes different sets of downstream effectors directly responsible for vesicle formation, movement, tethering and fusion. RAB5A is required for the fusion of plasma membranes and early endosomes and involved in early endocytic trafficking (PubMed:10818110, PubMed:14617813, PubMed:15378032, PubMed:16086013, PubMed:16410077, PubMed:17562788). Required for EEA1 recruitment to early endosomes (PubMed:16086013, PubMed:17562788). Recruits FERRY complex to early endosomes, where FERRY links early endosomes with a subgroup of mRNAs to enable mRNA intracellular distribution (PubMed:37267906). Recruits RABEP1/Rabaptin-5 effector to early endosomes, thereby promoting endocytic membrane fusion (By similarity). Required for EGF and transferrin endocytosis and trafficking through early endosomes (PubMed:16086013, PubMed:17562788). Contributes to the regulation of filopodia extension (PubMed:14978216). Required for the exosomal release of SDCBP, CD63, PDCD6IP and syndecan (PubMed:22660413). Regulates maturation of apoptotic cell-containing phagosomes, probably downstream of DYN2 and PIK3C3 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}