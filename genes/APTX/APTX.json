_score":0.366461,"pct_ad":0.437668,"pct_control":0.439627,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0727634,"donor_lfcse":0.106336,"donor_log2fc_shrunk":6.6613e-06,"degas_log2fc":-0.333097,"degas_padj":3.24811e-16},{"cell_type":"Oli","gene_symbol":"APTX","gene_symbol_current":"APTX","gene_id":"ENSG00000137074","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.359377,"nucleus_log2fc":-0.0116496,"nucleus_score":-1.01168,"pct_ad":0.373408,"pct_control":0.379454,"donor_test":"not significant","donor_padj":0.997704,"donor_log2fc":0.00175297,"donor_lfcse":0.0876627,"donor_log2fc_shrunk":1.10985e-05,"degas_log2fc":-0.230776,"degas_padj":1.46068e-33}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000137074","module":"blue","kme":0.138357,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000137074","entrez_id":["54840"],"uniprot":["Q7Z2E3"],"ncbi_summary":"This gene encodes a member of the histidine triad (HIT) superfamily. The encoded protein may play a role in single-stranded DNA repair through its nucleotide-binding activity and its diadenosine polyphosphate hydrolase activity. Mutations in this gene have been associated with ataxia-ocular apraxia. Alternatively spliced transcript variants have been identified for this gene.[provided by RefSeq, Aug 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q7Z2E3","text":"DNA-binding protein involved in single-strand DNA break repair, double-strand DNA break repair and base excision repair (PubMed:15044383, PubMed:15380105, PubMed:16964241, PubMed:17276982, PubMed:24362567). Resolves abortive DNA ligation intermediates formed either at base excision sites, or when DNA ligases attempt to repair non-ligatable breaks induced by reactive oxygen species (PubMed:16964241, PubMed:24362567). Catalyzes the release of adenylate groups covalently linked to 5'-phosphate termini, resulting in the production of 5'-phosphate termini that can be efficiently rejoined (PubMed:16964241, PubMed:17276982, PubMed:24362567). Also able to hydrolyze adenosine 5'-monophosphoramidate (AMP-NH(2)) and diadenosine tetraphosphate (AppppA), but with lower catalytic activity (PubMed:16547001). Likewise, catalyzes the release of 3'-linked guanosine (DNAppG) and inosine (DNAppI) from DNA, but has higher specific activity with 5'-linked adenosine (AppDNA) (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}