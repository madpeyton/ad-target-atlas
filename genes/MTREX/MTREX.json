les":[{"cell_type":"Astrocytes","gene_id":"ENSG00000039123","module":"brown","kme":0.113964,"hub":false,"module_direction":"lower in AD","module_padj":0.833818,"module_significant":false},{"cell_type":"CUX2+","gene_id":"ENSG00000039123","module":"green","kme":0.167898,"hub":false,"module_direction":"higher in AD","module_padj":0.923266,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000039123"],"dataset_symbols":["SKIV2L2"],"explorer":"explorer.html?dataset=mathys2019#gene/SKIV2L2","cell_types":[{"cell_type":"Ast","gene_symbol":"SKIV2L2","gene_symbol_current":"MTREX","gene_id":"ENSG00000039123","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00423871,"nucleus_log2fc":-0.47553,"nucleus_score":-3.47199,"pct_ad":0.110865,"pct_control":0.152895,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Ex","gene_symbol":"SKIV2L2","gene_symbol_current":"MTREX","gene_id":"ENSG00000039123","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00142593,"nucleus_log2fc":-0.0835805,"nucleus_score":-3.45978,"pct_ad":0.360626,"pct_control":0.387382,"donor_test":"not significant","donor_padj":0.998051,"donor_log2fc":0.00749802,"donor_lfcse":0.081397,"donor_log2fc_shrunk":3.61913e-06},{"cell_type":"In","gene_symbol":"SKIV2L2","gene_symbol_current":"MTREX","gene_id":"ENSG00000039123","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.946643,"nucleus_log2fc":-0.0399208,"nucleus_score":-0.223847,"pct_ad":0.263088,"pct_control":0.261127,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.00240629,"donor_lfcse":0.107183,"donor_log2fc_shrunk":2.04022e-07},{"cell_type":"OPC","gene_symbol":"SKIV2L2","gene_symbol_current":"MTREX","gene_id":"ENSG00000039123","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.75502,"nucleus_log2fc":-0.0928679,"nucleus_score":-0.679146,"pct_ad":0.182889,"pct_control":0.19387,"donor_test":"not significant","donor_padj":0.993604,"donor_log2fc":-0.0482339,"donor_lfcse":0.147644,"donor_log2fc_shrunk":-0.000454089},{"cell_type":"Oli","gene_symbol":"SKIV2L2","gene_symbol_current":"MTREX","gene_id":"ENSG00000039123","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.815338,"donor_log2fc":-0.0969894,"donor_lfcse":0.085036,"donor_log2fc_shrunk":-0.0107794}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000039123","entrez_id":["23517"],"uniprot":["P42285"],"ncbi_summary":"Enables ATP binding activity and RNA helicase activity. Involved in RNA catabolic process; cellular response to DNA damage stimulus; and maturation of 5.8S rRNA. Located in nucleoplasm. Part of TRAMP complex and catalytic step 2 spliceosome. Colocalizes with nuclear exosome (RNase complex). Biomarker of amyotrophic lateral sclerosis. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P42285","text":"Catalyzes the ATP-dependent unwinding of RNA duplexes with a single-stranded 3' RNA extension (PubMed:27871484, PubMed:29844170, PubMed:29906447). Central subunit of many protein complexes, namely TRAMP-like, nuclear exosome targeting (NEXT) and poly(A) tail exosome targeting (PAXT) (PubMed:21855801, PubMed:27871484, PubMed:29844170). NEXT functions as an RNA exosome cofactor that directs a subset of non-coding short-lived RNAs for exosomal degradation. NEXT is involved in surveillance and turnover of aberrant transcripts and non-coding RNAs (PubMed:27871484, PubMed:29844170). PAXT directs a subset of long and polyadenylated poly(A) RNAs for exosomal degradation. The RNA exosome is fundamental for the degradation of RNA in eukaryotic nuclei. Substrate targeting is facilitated by its cofactor ZCCHC8, which links to RNA-binding protein adapters (PubMed:27871484). Associated with the RNA exosome complex and involved in the 3'-processing of the 7S pre-RNA to the mature 5.8S rRNA (PubMed:17412707, PubMed:29107693). May be involved in pre-mRNA splicing. In the context of NEXT complex can also in vitro unwind DNA:RNA heteroduplexes with a 3' poly (A) RNA tracking strand (PubMed:29844170). Can promote unwinding and degradation of structured RNA substrates when associated with the nuclear exosome and its cofactors. Can displace a DNA strand while translocating on RNA to ultimately degrade the RNA within a DNA/RNA heteroduplex (PubMed:29906447). Plays a role in DNA damage response (PubMed:29902117)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}