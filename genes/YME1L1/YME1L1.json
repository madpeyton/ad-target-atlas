}],"modules":[{"cell_type":"Astrocytes","gene_id":"ENSG00000136758","module":"brown","kme":0.0811696,"hub":false,"module_direction":"lower in AD","module_padj":0.833818,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000136758","module":"turquoise","kme":0.103127,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000136758"],"dataset_symbols":["YME1L1"],"explorer":"explorer.html?dataset=mathys2019#gene/YME1L1","cell_types":[{"cell_type":"Ast","gene_symbol":"YME1L1","gene_symbol_current":"YME1L1","gene_id":"ENSG00000136758","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.319845,"nucleus_log2fc":-0.0949934,"nucleus_score":-1.27888,"pct_ad":0.11031,"pct_control":0.127521,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Ex","gene_symbol":"YME1L1","gene_symbol_current":"YME1L1","gene_id":"ENSG00000136758","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0299845,"nucleus_log2fc":-0.0507244,"nucleus_score":-2.3963,"pct_ad":0.37759,"pct_control":0.396315,"donor_test":"not significant","donor_padj":0.996763,"donor_log2fc":-0.00560997,"donor_lfcse":0.0464597,"donor_log2fc_shrunk":-3.90565e-06},{"cell_type":"In","gene_symbol":"YME1L1","gene_symbol_current":"YME1L1","gene_id":"ENSG00000136758","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.750569,"nucleus_log2fc":0.0500777,"nucleus_score":0.816471,"pct_ad":0.273292,"pct_control":0.261438,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0183034,"donor_lfcse":0.0974024,"donor_log2fc_shrunk":-5.52683e-06},{"cell_type":"OPC","gene_symbol":"YME1L1","gene_symbol_current":"YME1L1","gene_id":"ENSG00000136758","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.186176,"nucleus_log2fc":-0.359727,"nucleus_score":-2.23305,"pct_ad":0.126374,"pct_control":0.157854,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"YME1L1","gene_symbol_current":"YME1L1","gene_id":"ENSG00000136758","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.9355,"donor_log2fc":-0.0563882,"donor_lfcse":0.10421,"donor_log2fc_shrunk":-0.0046959}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000136758","module":"turquoise","kme":0.0910838,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136758","entrez_id":["10730"],"uniprot":["Q96TA2"],"ncbi_summary":"The protein encoded by this gene is the human ortholog of yeast mitochondrial AAA metalloprotease, Yme1p. It is localized in the mitochondria and can functionally complement a yme1 disruptant yeast strain. It is proposed that this gene plays a role in mitochondrial protein metabolism and could be involved in mitochondrial pathologies. Three transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Dec 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96TA2","text":"ATP-dependent metalloprotease that catalyzes the degradation of folded and unfolded proteins with a suitable degron sequence in the mitochondrial intermembrane region (PubMed:24315374, PubMed:26923599, PubMed:27786171, PubMed:31695197, PubMed:33237841, PubMed:36206740). Plays an important role in regulating mitochondrial morphology and function by cleaving OPA1 at position S2, giving rise to a form of OPA1 that promotes maintenance of normal mitochondrial structure and mitochondrial protein metabolism (PubMed:18076378, PubMed:26923599, PubMed:27495975, PubMed:33237841). Ensures cell proliferation, maintains normal cristae morphology and complex I respiration activity, promotes antiapoptotic activity and protects mitochondria from the accumulation of oxidatively damaged membrane proteins (PubMed:22262461). Required to control the accumulation of nonassembled respiratory chain subunits (NDUFB6, OX4 and ND1) (PubMed:22262461). Involved in the mitochondrial adaptation in response to various signals, such as stress or developmental cues, by mediating degradation of mitochondrial proteins to rewire the mitochondrial proteome (PubMed:31695197). Catalyzes degradation of mitochondrial proteins, such as translocases, lipid transfer proteins and metabolic enzymes in response to nutrient starvation in order to limit mitochondrial biogenesis: mechanistically, YME1L1 is activated by decreased phosphatidylethanolamine levels caused by LPIN1 activity in response to mTORC1 inhibition (PubMed:31695197). Acts as a regulator of adult neural stem cell self-renewal by promoting mitochondrial proteome rewiring, preserving neural stem and progenitor cells self-renewal (By similarity). Required for normal, constitutive degradation of PRELID1 (PubMed:27495975). Catalyzes the degradation of OMA1 in response to membrane depolarization (PubMed:26923599). Mediates degradation of TIMM17A downstream of the integrated stress response (ISR) (PubMed:24315374). Catalyzes degradation of MICU1 when MICU1 is not assembled via an interchain disulfide (PubMed:36206740). Cleaves STARD7 mitochondrial targeting sequence (PubMed:29301859)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}