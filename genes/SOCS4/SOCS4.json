":2.47358e-35,"nucleus_log2fc":0.347956,"nucleus_score":12.5665,"pct_ad":0.184061,"pct_control":0.149011,"donor_test":"not significant","donor_padj":0.542234,"donor_log2fc":0.261677,"donor_lfcse":0.117086,"donor_log2fc_shrunk":0.0241878,"degas_log2fc":-0.00644449,"degas_padj":0.834129}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000180008","entrez_id":["122809"],"uniprot":["Q8WXH5"],"ncbi_summary":"The protein encoded by this gene contains a SH2 domain and a SOCS BOX domain. The protein thus belongs to the suppressor of cytokine signaling (SOCS), also known as STAT-induced STAT inhibitor (SSI), protein family. SOCS family members are known to be cytokine-inducible negative regulators of cytokine signaling. Two alternatively spliced transcript variants encoding the same protein have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WXH5","text":"SOCS family proteins form part of a classical negative feedback system that regulates cytokine signal transduction. Substrate-recognition component of a SCF-like ECS (Elongin BC-CUL2/5-SOCS-box protein) E3 ubiquitin-protein ligase complex which mediates the ubiquitination and subsequent proteasomal degradation of target proteins. Inhibits EGF signaling by mediating the degradation of the Tyr-phosphorylated EGF receptor/EGFR."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}