ded by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H772","text":"Cytokine that inhibits the activity of BMP2 and BMP4 in a dose-dependent manner, and thereby modulates signaling by BMP family members. Contributes to the regulation of embryonic morphogenesis via BMP family members. Antagonizes BMP4-induced suppression of progesterone production in granulosa cells."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}