significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.144501,"nucleus_log2fc":0.240332,"nucleus_score":2.57722,"pct_ad":0.162378,"pct_control":0.136321,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.169738,"donor_lfcse":0.205693,"donor_log2fc_shrunk":4.22445e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000269699","entrez_id":["23619"],"uniprot":["Q9NZV7"],"ncbi_summary":"In human, ZIM2 and PEG3 (GeneID:5178) are two distinct genes that share a set of 5' exons and have a common promoter, and both genes are paternally expressed. Alternative splicing events connect the shared exons either with the remaining 4 exons unique to ZIM2, or with the remaining 2 exons unique to PEG3. This is in contrast to mouse and cow, where ZIM2 and PEG3 genes do not share exons in common, and the imprinting status of ZIM2 is also not conserved amongst mammals. Additional 5' alternatively spliced transcripts encoding the same protein have been found for the human ZIM2 gene. [provided by RefSeq, Oct 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NZV7","text":"May be involved in transcriptional regulation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}