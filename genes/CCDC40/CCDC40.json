ataset_symbols":["CCDC40"],"explorer":"explorer.html?dataset=mathys2019#gene/CCDC40","cell_types":[{"cell_type":"Ex","gene_symbol":"CCDC40","gene_symbol_current":"CCDC40","gene_id":"ENSG00000141519","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.156835,"nucleus_log2fc":0.196432,"nucleus_score":1.60183,"pct_ad":0.101178,"pct_control":0.0954698,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.170532,"donor_lfcse":0.141444,"donor_log2fc_shrunk":8.83857e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000141519","module":"black","kme":0.11422,"hub":false,"module_direction":"higher in AD","module_padj":0.56571,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000141519","module":"green","kme":0.0700125,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000141519","entrez_id":["55036"],"uniprot":["Q4G0X9"],"ncbi_summary":"This gene encodes a protein that is necessary for motile cilia function. It functions in correct left-right axis formation by regulating the assembly of the inner dynein arm and the dynein regulatory complexes, which control ciliary beat. Mutations in this gene cause ciliary dyskinesia type 15, a disorder due to defects in cilia motility. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q4G0X9","text":"Required for assembly of dynein regulatory complex (DRC) and inner dynein arm (IDA) complexes, which are responsible for ciliary beat regulation, thereby playing a central role in motility in cilia and flagella (PubMed:21131974). Probably acts together with CCDC39 to form a molecular ruler that determines the 96 nanometer (nm) repeat length and arrangements of components in cilia and flagella (By similarity). Not required for outer dynein arm complexes assembly. Required for axonemal recruitment of CCDC39 (PubMed:21131974)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}