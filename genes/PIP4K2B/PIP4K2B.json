leus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.476551,"nucleus_log2fc":-0.0568525,"nucleus_score":-0.992918,"pct_ad":0.280197,"pct_control":0.285859,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0363096,"donor_lfcse":0.0681524,"donor_log2fc_shrunk":8.08737e-06,"degas_log2fc":-0.176454,"degas_padj":0.000973398},{"cell_type":"Oli","gene_symbol":"PIP4K2B","gene_symbol_current":"PIP4K2B","gene_id":"ENSG00000276293","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000347031,"nucleus_log2fc":0.111309,"nucleus_score":3.72463,"pct_ad":0.217308,"pct_control":0.207064,"donor_test":"not significant","donor_padj":0.702196,"donor_log2fc":0.0981225,"donor_lfcse":0.0611424,"donor_log2fc_shrunk":0.0289885,"degas_log2fc":-0.173904,"degas_padj":1.27824e-11}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000276293","module":"red","kme":0.304831,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000276293","module":"turquoise","kme":0.0384727,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000276293","entrez_id":["8396"],"uniprot":["P78356"],"ncbi_summary":"The protein encoded by this gene catalyzes the phosphorylation of phosphatidylinositol-5-phosphate on the fourth hydroxyl of the myo-inositol ring to form phosphatidylinositol-5,4-bisphosphate. This gene is a member of the phosphatidylinositol-5-phosphate 4-kinase family. The encoded protein sequence does not show similarity to other kinases, but the protein does exhibit kinase activity. Additionally, the encoded protein interacts with p55 TNF receptor. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P78356","text":"Participates in the biosynthesis of phosphatidylinositol 4,5-bisphosphate (PubMed:26774281, PubMed:9038203). Preferentially utilizes GTP, rather than ATP, for PI(5)P phosphorylation and its activity reflects changes in direct proportion to the physiological GTP concentration (PubMed:26774281). Its GTP-sensing activity is critical for metabolic adaptation (PubMed:26774281). PIP4Ks negatively regulate insulin signaling through a catalytic-independent mechanism. They interact with PIP5Ks and suppress PIP5K-mediated PtdIns(4,5)P2 synthesis and insulin-dependent conversion to PtdIns(3,4,5)P3 (PubMed:31091439)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}