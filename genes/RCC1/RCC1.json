t","donor_padj":0.994258,"donor_log2fc":0.0291904,"donor_lfcse":0.117253,"donor_log2fc_shrunk":2.23354e-06},{"cell_type":"In","gene_symbol":"RCC1","gene_symbol_current":"RCC1","gene_id":"ENSG00000180198","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.512155,"nucleus_log2fc":0.144582,"nucleus_score":1.44942,"pct_ad":0.133984,"pct_control":0.120137,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.196874,"donor_lfcse":0.153811,"donor_log2fc_shrunk":8.70514e-06},{"cell_type":"Oli","gene_symbol":"RCC1","gene_symbol_current":"RCC1","gene_id":"ENSG00000180198","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.842299,"donor_log2fc":0.178174,"donor_lfcse":0.171513,"donor_log2fc_shrunk":0.00584019}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000180198","module":"black","kme":0.116505,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000180198","entrez_id":["1104"],"uniprot":["P18754"],"ncbi_summary":"Enables several functions, including guanyl-nucleotide exchange factor activity; nucleosomal DNA binding activity; and protein heterodimerization activity. Involved in several processes, including G1/S transition of mitotic cell cycle; regulation of mitotic nuclear division; and spindle organization. Located in chromatin; cytoplasm; and nucleus. Part of protein-containing complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P18754","text":"Guanine-nucleotide releasing factor that promotes the exchange of Ran-bound GDP by GTP, and thereby plays an important role in RAN-mediated functions in nuclear import and mitosis (PubMed:11336674, PubMed:17435751, PubMed:1944575, PubMed:20668449, PubMed:22215983, PubMed:29042532). Contributes to the generation of high levels of chromosome-associated, GTP-bound RAN, which is important for mitotic spindle assembly and normal progress through mitosis (PubMed:12194828, PubMed:17435751, PubMed:22215983). Via its role in maintaining high levels of GTP-bound RAN in the nucleus, contributes to the release of cargo proteins from importins after nuclear import (PubMed:22215983). Involved in the regulation of onset of chromosome condensation in the S phase (PubMed:3678831). Binds both to the nucleosomes and double-stranded DNA (PubMed:17435751, PubMed:18762580)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}