se":0.127293,"donor_log2fc_shrunk":0.0211879,"degas_log2fc":-0.286792,"degas_padj":1.92062e-08},{"cell_type":"OPC","gene_symbol":"ANP32B","gene_symbol_current":"ANP32B","gene_id":"ENSG00000136938","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.807024,"nucleus_log2fc":-0.0417899,"nucleus_score":0.382713,"pct_ad":0.142857,"pct_control":0.139204,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0515261,"donor_lfcse":0.0952142,"donor_log2fc_shrunk":5.92259e-06,"degas_log2fc":-0.292836,"degas_padj":0.000141309},{"cell_type":"Oli","gene_symbol":"ANP32B","gene_symbol_current":"ANP32B","gene_id":"ENSG00000136938","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000413851,"nucleus_log2fc":0.108006,"nucleus_score":3.67796,"pct_ad":0.185043,"pct_control":0.174806,"donor_test":"not significant","donor_padj":0.635968,"donor_log2fc":0.123,"donor_lfcse":0.0653676,"donor_log2fc_shrunk":0.0359698,"degas_log2fc":-0.0802079,"degas_padj":0.00441699}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136938","entrez_id":["10541"],"uniprot":["Q92688"],"ncbi_summary":"Enables RNA polymerase binding activity and histone binding activity. Involved in several processes, including activation of cysteine-type endopeptidase activity involved in apoptotic process; nucleosome assembly; and positive regulation of protein export from nucleus. Located in cytoplasm and nucleoplasm. Colocalizes with nucleolus. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92688","text":"Multifunctional protein that is involved in the regulation of many processes including cell proliferation, apoptosis, cell cycle progression or transcription (PubMed:18039846, PubMed:20015864). Regulates the proliferation of neuronal stem cells, differentiation of leukemic cells and progression from G1 to S phase of the cell cycle. As negative regulator of caspase-3-dependent apoptosis, may act as an antagonist of ANP32A in regulating tissue homeostasis (PubMed:20015864). Exhibits histone chaperone properties, able to recruit histones to certain promoters, thus regulating the transcription of specific genes (PubMed:18039846, PubMed:20538007). Also plays an essential role in the nucleocytoplasmic transport of specific mRNAs via the uncommon nuclear mRNA export receptor XPO1/CRM1 (PubMed:17178712). Participates in the regulation of adequate adaptive immune responses by acting on mRNA expression and cell proliferation (By similarity). (Microbial infection) Plays an essential role in influenza A and B viral genome replication (PubMed:31217244, PubMed:33045004). Also plays a role in foamy virus mRNA export from the nucleus to the cytoplasm (PubMed:21159877)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}