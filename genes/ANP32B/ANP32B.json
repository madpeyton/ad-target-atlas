],"modules":[{"cell_type":"Astrocytes","gene_id":"ENSG00000136938","module":"turquoise","kme":0.0664465,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000136938","module":"turquoise","kme":0.0867687,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000136938"],"dataset_symbols":["ANP32B"],"explorer":"explorer.html?dataset=mathys2019#gene/ANP32B","cell_types":[{"cell_type":"Ex","gene_symbol":"ANP32B","gene_symbol_current":"ANP32B","gene_id":"ENSG00000136938","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.861846,"nucleus_log2fc":0.0554108,"nucleus_score":0.223311,"pct_ad":0.125457,"pct_control":0.124821,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.134665,"donor_lfcse":0.109401,"donor_log2fc_shrunk":1.17564e-05},{"cell_type":"Oli","gene_symbol":"ANP32B","gene_symbol_current":"ANP32B","gene_id":"ENSG00000136938","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.839684,"donor_log2fc":0.17417,"donor_lfcse":0.164266,"donor_log2fc_shrunk":0.00611885}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136938","entrez_id":["10541"],"uniprot":["Q92688"],"ncbi_summary":"Enables RNA polymerase binding activity and histone binding activity. Involved in several processes, including activation of cysteine-type endopeptidase activity involved in apoptotic process; nucleosome assembly; and positive regulation of protein export from nucleus. Located in cytoplasm and nucleoplasm. Colocalizes with nucleolus. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92688","text":"Multifunctional protein that is involved in the regulation of many processes including cell proliferation, apoptosis, cell cycle progression or transcription (PubMed:18039846, PubMed:20015864). Regulates the proliferation of neuronal stem cells, differentiation of leukemic cells and progression from G1 to S phase of the cell cycle. As negative regulator of caspase-3-dependent apoptosis, may act as an antagonist of ANP32A in regulating tissue homeostasis (PubMed:20015864). Exhibits histone chaperone properties, able to recruit histones to certain promoters, thus regulating the transcription of specific genes (PubMed:18039846, PubMed:20538007). Also plays an essential role in the nucleocytoplasmic transport of specific mRNAs via the uncommon nuclear mRNA export receptor XPO1/CRM1 (PubMed:17178712). Participates in the regulation of adequate adaptive immune responses by acting on mRNA expression and cell proliferation (By similarity). (Microbial infection) Plays an essential role in influenza A and B viral genome replication (PubMed:31217244, PubMed:33045004). Also plays a role in foamy virus mRNA export from the nucleus to the cytoplasm (PubMed:21159877)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}