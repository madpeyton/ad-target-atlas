ucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000287963,"nucleus_log2fc":-0.177843,"nucleus_score":-3.91292,"pct_ad":0.174015,"pct_control":0.193731,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":-0.0739461,"donor_lfcse":0.139079,"donor_log2fc_shrunk":-2.48658e-05},{"cell_type":"In","gene_symbol":"ACOT8","gene_symbol_current":"ACOT8","gene_id":"ENSG00000101473","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.661546,"nucleus_log2fc":-0.244015,"nucleus_score":-1.07919,"pct_ad":0.0936114,"pct_control":0.101152,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.099623,"donor_lfcse":0.201324,"donor_log2fc_shrunk":-2.61809e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000101473","module":"turquoise","kme":0.224962,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000101473","module":"turquoise","kme":0.187803,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101473","entrez_id":["10005"],"uniprot":["O14734"],"ncbi_summary":"The protein encoded by this gene is a peroxisomal thioesterase that appears to be involved more in the oxidation of fatty acids rather than in their formation. The encoded protein can bind to the human immunodeficiency virus-1 protein Nef, and mediate Nef-induced down-regulation of CD4 in T-cells. [provided by RefSeq, Oct 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O14734","text":"Catalyzes the hydrolysis of acyl-CoAs into free fatty acids and coenzyme A (CoASH), regulating their respective intracellular levels (PubMed:15194431, PubMed:9153233, PubMed:9299485). Displays no strong substrate specificity with respect to the carboxylic acid moiety of Acyl-CoAs (By similarity). Hydrolyzes medium length (C2 to C20) straight-chain, saturated and unsaturated acyl-CoAS but is inactive towards substrates with longer aliphatic chains (PubMed:9153233, PubMed:9299485). Moreover, it catalyzes the hydrolysis of CoA esters of bile acids, such as choloyl-CoA and chenodeoxycholoyl-CoA and competes with bile acid CoA:amino acid N-acyltransferase (BAAT) (By similarity). Is also able to hydrolyze CoA esters of dicarboxylic acids (By similarity). It is involved in the metabolic regulation of peroxisome proliferation (PubMed:15194431). (Microbial infection) May mediate Nef-induced down-regulation of CD4 cell-surface expression (PubMed:9153233)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}