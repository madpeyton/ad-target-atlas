padj":0.999342,"donor_log2fc":0.0417733,"donor_lfcse":0.0925831,"donor_log2fc_shrunk":5.0951e-06,"degas_log2fc":-0.0425892,"degas_padj":0.621931},{"cell_type":"Oli","gene_symbol":"ACOT8","gene_symbol_current":"ACOT8","gene_id":"ENSG00000101473","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.972686,"donor_log2fc":0.0174624,"donor_lfcse":0.0710982,"donor_log2fc_shrunk":0.00321016,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101473","entrez_id":["10005"],"uniprot":["O14734"],"ncbi_summary":"The protein encoded by this gene is a peroxisomal thioesterase that appears to be involved more in the oxidation of fatty acids rather than in their formation. The encoded protein can bind to the human immunodeficiency virus-1 protein Nef, and mediate Nef-induced down-regulation of CD4 in T-cells. [provided by RefSeq, Oct 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O14734","text":"Catalyzes the hydrolysis of acyl-CoAs into free fatty acids and coenzyme A (CoASH), regulating their respective intracellular levels (PubMed:15194431, PubMed:9153233, PubMed:9299485). Displays no strong substrate specificity with respect to the carboxylic acid moiety of Acyl-CoAs (By similarity). Hydrolyzes medium length (C2 to C20) straight-chain, saturated and unsaturated acyl-CoAS but is inactive towards substrates with longer aliphatic chains (PubMed:9153233, PubMed:9299485). Moreover, it catalyzes the hydrolysis of CoA esters of bile acids, such as choloyl-CoA and chenodeoxycholoyl-CoA and competes with bile acid CoA:amino acid N-acyltransferase (BAAT) (By similarity). Is also able to hydrolyze CoA esters of dicarboxylic acids (By similarity). It is involved in the metabolic regulation of peroxisome proliferation (PubMed:15194431). (Microbial infection) May mediate Nef-induced down-regulation of CD4 cell-surface expression (PubMed:9153233)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}