,"nucleus_padj":0.00923686,"nucleus_log2fc":0.106703,"nucleus_score":2.88536,"pct_ad":0.391179,"pct_control":0.372581,"donor_test":"not significant","donor_padj":0.735042,"donor_log2fc":0.0810448,"donor_lfcse":0.0734708,"donor_log2fc_shrunk":0.0253554},{"cell_type":"OPC","gene_symbol":"HNRNPK","gene_symbol_current":"HNRNPK","gene_id":"ENSG00000165119","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000185195,"nucleus_log2fc":0.138577,"nucleus_score":4.24339,"pct_ad":0.577692,"pct_control":0.542083,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0829785,"donor_lfcse":0.080475,"donor_log2fc_shrunk":1.34762e-05},{"cell_type":"Oli","gene_symbol":"HNRNPK","gene_symbol_current":"HNRNPK","gene_id":"ENSG00000165119","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.424848,"nucleus_log2fc":0.0188921,"nucleus_score":0.885302,"pct_ad":0.432219,"pct_control":0.430595,"donor_test":"not significant","donor_padj":0.968093,"donor_log2fc":0.0258728,"donor_lfcse":0.081551,"donor_log2fc_shrunk":0.00379403}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000165119","module":"turquoise","kme":0.145276,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000165119","module":"brown","kme":0.343567,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000165119","module":"brown","kme":0.284764,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000165119","module":"turquoise","kme":0.0899304,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000165119","module":"turquoise","kme":0.156874,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165119","entrez_id":["3190"],"uniprot":["P61978"],"ncbi_summary":"This gene belongs to the subfamily of ubiquitously expressed heterogeneous nuclear ribonucleoproteins (hnRNPs). The hnRNPs are RNA binding proteins and they complex with heterogeneous nuclear RNA (hnRNA). These proteins are associated with pre-mRNAs in the nucleus and appear to influence pre-mRNA processing and other aspects of mRNA metabolism and transport. While all of the hnRNPs are present in the nucleus, some seem to shuttle between the nucleus and the cytoplasm. The hnRNP proteins have distinct nucleic acid binding properties. The protein encoded by this gene is located in the nucleoplasm and has three repeats of KH domains that binds to RNAs. It is distinct among other hnRNP proteins in its binding preference; it binds tenaciously to poly(C). This protein is also thought to have a role during cell cycle progession. Several alternatively spliced transcript variants have been described for this gene, however, not all of them are fully characterized. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P61978","text":"One of the major pre-mRNA-binding proteins. Binds tenaciously to poly(C) sequences. Likely to play a role in the nuclear metabolism of hnRNAs, particularly for pre-mRNAs that contain cytidine-rich sequences. Can also bind poly(C) single-stranded DNA. Plays an important role in p53/TP53 response to DNA damage, acting at the level of both transcription activation and repression. When sumoylated, acts as a transcriptional coactivator of p53/TP53, playing a role in p21/CDKN1A and 14-3-3 sigma/SFN induction. As far as transcription repression is concerned, acts by interacting with long intergenic RNA p21 (lincRNA-p21), a non-coding RNA induced by p53/TP53. This interaction is necessary for the induction of apoptosis, but not cell cycle arrest. As part of a ribonucleoprotein complex composed at least of ZNF827, HNRNPL and the circular RNA circZNF827 that nucleates the complex on chromatin, may negatively regulate the transcription of genes involved in neuronal differentiation (PubMed:33174841)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}