555,"pct_ad":0.379809,"pct_control":0.380864,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0154748,"donor_lfcse":0.0752479,"donor_log2fc_shrunk":-2.85769e-06,"degas_log2fc":-0.0116864,"degas_padj":0.814028},{"cell_type":"Oli","gene_symbol":"SELENOF","gene_symbol_current":"SELENOF","gene_id":"ENSG00000183291","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":8.48562e-07,"nucleus_log2fc":-0.0926946,"nucleus_score":-5.08036,"pct_ad":0.288397,"pct_control":0.306845,"donor_test":"not significant","donor_padj":0.938417,"donor_log2fc":-0.0359014,"donor_lfcse":0.0723632,"donor_log2fc_shrunk":-0.00754473,"degas_log2fc":-0.13396,"degas_padj":6.5682e-10}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000183291","module":"turquoise","kme":0.095084,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000183291","module":"turquoise","kme":0.0719189,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000183291","module":"turquoise","kme":0.0999651,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000183291","entrez_id":["9403"],"uniprot":["O60613"],"ncbi_summary":"The protein encoded by this gene belongs to the SEP15/selenoprotein M family. The exact function of this protein is not known; however, it has been found to associate with UDP-glucose:glycoprotein glucosyltransferase (UGTR), an endoplasmic reticulum(ER)-resident protein, which is involved in the quality control of protein folding. The association with UGTR retains this protein in the ER, where it may play a role in protein folding. It has also been suggested to have a role in cancer etiology. This protein is a selenoprotein, containing the rare amino acid selenocysteine (Sec). Sec is encoded by the UGA codon, which normally signals translation termination. The 3' UTRs of selenoprotein mRNAs contain a conserved stem-loop structure, designated the Sec insertion sequence (SECIS) element, that is necessary for the recognition of UGA as a Sec codon, rather than as a stop signal. Alternatively spliced transcript variants have been found for this gene. [provided by RefSeq, Nov 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60613","text":"May be involved in redox reactions associated with the formation of disulfide bonds (By similarity). May contribute to the quality control of protein folding in the endoplasmic reticulum (PubMed:24415556). May regulate protein folding by enhancing the catalytic activity of UGGT1/UGCGL1 and UGGT2/UGCGL2 (PubMed:24415556)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}