,"donor_padj":0.999889,"donor_log2fc":-0.0384676,"donor_lfcse":0.142081,"donor_log2fc_shrunk":-2.07667e-06},{"cell_type":"OPC","gene_symbol":"CAPRIN1","gene_symbol_current":"CAPRIN1","gene_id":"ENSG00000135387","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.956439,"nucleus_log2fc":0.014548,"nucleus_score":-0.143059,"pct_ad":0.100471,"pct_control":0.102682,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"CAPRIN1","gene_symbol_current":"CAPRIN1","gene_id":"ENSG00000135387","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.666677,"donor_log2fc":0.296304,"donor_lfcse":0.108107,"donor_log2fc_shrunk":0.163582}],"modules":[{"cell_type":"In","gene_id":"ENSG00000135387","module":"turquoise","kme":0.19134,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000135387","entrez_id":["4076"],"uniprot":["Q14444"],"ncbi_summary":"Enables RNA binding activity. Predicted to be involved in negative regulation of translation and positive regulation of dendritic spine morphogenesis. Located in cell leading edge and cytosol. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q14444","text":"mRNA-binding protein that acts as a regulator of mRNAs transport, translation and/or stability, and which is involved in neurogenesis, synaptic plasticity in neurons and cell proliferation and migration in multiple cell types (PubMed:17210633, PubMed:31439799, PubMed:35979925). Plays an essential role in cytoplasmic stress granule formation (PubMed:35977029). Acts as an mRNA regulator by mediating formation of some phase-separated membraneless compartment: undergoes liquid-liquid phase separation upon binding to target mRNAs, leading to assemble mRNAs into cytoplasmic ribonucleoprotein granules that concentrate mRNAs with associated regulatory factors (PubMed:31439799, PubMed:32302570, PubMed:32302571, PubMed:32302572, PubMed:34074792, PubMed:36040869, PubMed:36279435). Undergoes liquid-liquid phase separation following phosphorylation and interaction with FMR1, promoting formation of cytoplasmic ribonucleoprotein granules that concentrate mRNAs with factors that inhibit translation and mediate deadenylation of target mRNAs (PubMed:31439799). In these cytoplasmic ribonucleoprotein granules, CAPRIN1 mediates recruitment of CNOT7 deadenylase, leading to mRNA deadenylation and degradation (PubMed:31439799). Binds directly and selectively to MYC and CCND2 mRNAs (PubMed:17210633). In neuronal cells, directly binds to several mRNAs associated with RNA granules, including BDNF, CAMK2A, CREB1, MAP2, NTRK2 mRNAs, as well as to GRIN1 and KPNB1 mRNAs, but not to rRNAs (PubMed:17210633)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}