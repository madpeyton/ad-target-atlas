_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false},"seaad_pfc":{"dataset_label":"SEA-AD (Gabitto et al. 2024)","gene_ids":["ENSG00000167984"],"dataset_symbols":["NLRC3"],"explorer":"explorer.html?dataset=seaad_pfc#gene/NLRC3","cell_types":[{"cell_type":"Ast","gene_symbol":"NLRC3","gene_symbol_current":"NLRC3","gene_id":"ENSG00000167984","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.906131,"donor_log2fc":-0.12735,"donor_lfcse":0.207574,"donor_log2fc_shrunk":-0.00186123,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Ex","gene_symbol":"NLRC3","gene_symbol_current":"NLRC3","gene_id":"ENSG00000167984","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":7.82901e-146,"nucleus_log2fc":-0.36841,"nucleus_score":-25.7845,"pct_ad":0.176397,"pct_control":0.214783,"donor_test":"not significant","donor_padj":0.716611,"donor_log2fc":-0.211586,"donor_lfcse":0.182657,"donor_log2fc_shrunk":-0.00592627,"degas_log2fc":0.645776,"degas_padj":0.0},{"cell_type":"In","gene_symbol":"NLRC3","gene_symbol_current":"NLRC3","gene_id":"ENSG00000167984","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.89707e-56,"nucleus_log2fc":-0.345236,"nucleus_score":-15.9308,"pct_ad":0.0966835,"pct_control":0.119751,"donor_test":"not significant","donor_padj":0.753277,"donor_log2fc":-0.232327,"donor_lfcse":0.178002,"donor_log2fc_shrunk":-0.00358872,"degas_log2fc":0.656726,"degas_padj":9.93771e-165},{"cell_type":"Oli","gene_symbol":"NLRC3","gene_symbol_current":"NLRC3","gene_id":"ENSG00000167984","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985254,"donor_log2fc":0.0201481,"donor_lfcse":0.172113,"donor_log2fc_shrunk":0.000738323,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000167984","module":"turquoise","kme":0.207483,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000167984","entrez_id":["197358"],"uniprot":["Q7RTR2"],"ncbi_summary":"This gene encodes a NOD-like receptor family member. The encoded protein is a cytosolic regulator of innate immunity. This protein directly interacts with stimulator of interferon genes (STING), to prevent its proper trafficking, resulting in disruption of STING-dependent activation of the innate immune response. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Feb 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q7RTR2","text":"Negative regulator of the innate immune response (PubMed:15705585, PubMed:22863753, PubMed:25277106). Attenuates signaling pathways activated by Toll-like receptors (TLRs) and the DNA sensor STING/TMEM173 in response to pathogen-associated molecular patterns, such as intracellular poly(dA:dT), but not poly(I:C), or in response to DNA virus infection, including that of Herpes simplex virus 1 (HSV1) (By similarity) (PubMed:22863753). May affect TLR4 signaling by acting at the level of TRAF6 ubiquitination, decreasing the activating 'Lys-63'-linked ubiquitination and leaving unchanged the degradative 'Lys-48'-linked ubiquitination (PubMed:22863753). Inhibits the PI3K-AKT-mTOR pathway possibly by directly interacting with the posphatidylinositol 3-kinase regulatory subunit p85 (PIK3R1/PIK3R2) and disrupting the association between PIK3R1/PIK3R2 and the catalytic subunit p110 (PIK3CA/PIK3CB/PIK3CD) and reducing PIK3R1/PIK3R2 activation. Via its regulation of the PI3K-AKT-mTOR pathway, controls cell proliferation, predominantly in intestinal epithelial cells (By similarity). May also affect NOD1- or NOD2-mediated NF-kappa-B activation (PubMed:25277106). Might also affect the inflammatory response by preventing NLRP3 inflammasome formation, CASP1 cleavage and IL1B maturation (PubMed:25277106)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}