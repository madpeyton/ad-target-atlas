":-0.142388,"donor_lfcse":0.0721562,"donor_log2fc_shrunk":-0.0636448},{"cell_type":"OPC","gene_symbol":"INPP5F","gene_symbol_current":"INPP5F","gene_id":"ENSG00000198825","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.552192,"nucleus_log2fc":0.0278033,"nucleus_score":0.847174,"pct_ad":0.512526,"pct_control":0.502625,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.00404852,"donor_lfcse":0.12472,"donor_log2fc_shrunk":-2.48153e-07},{"cell_type":"Oli","gene_symbol":"INPP5F","gene_symbol_current":"INPP5F","gene_id":"ENSG00000198825","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":8.49636e-57,"nucleus_log2fc":0.45757,"nucleus_score":16.0411,"pct_ad":0.284237,"pct_control":0.238592,"donor_test":"not significant","donor_padj":0.612605,"donor_log2fc":0.427843,"donor_lfcse":0.215943,"donor_log2fc_shrunk":0.0100732}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000198825","module":"yellow","kme":0.262643,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000198825","module":"blue","kme":0.244875,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000198825","module":"blue","kme":0.115433,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198825","entrez_id":["22876"],"uniprot":["Q9Y2H2"],"ncbi_summary":"The protein encoded by this gene is an inositol 1,4,5-trisphosphate (InsP3) 5-phosphatase and contains a Sac domain. The activity of this protein is specific for phosphatidylinositol 4,5-bisphosphate and phosphatidylinositol 3,4,5-trisphosphate. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y2H2","text":"Phosphoinositide phosphatase which catalyzes the hydrolysis of phosphatidylinositol 4-phosphate (1,2-diacyl-sn-glycero-3-phospho-(1D-myo-inositol 4-phosphate), PtdIns(4)P). May be functionally linked to OCRL, which converts phosphatidylinositol 4,5-bisphosphate (PtdIns(4,5)P2) to PtdIns, for a sequential dephosphorylation of (PtdIns(4,5)P2) at the 5 and 4 position of inositol, thus playing an important role in the endocytic recycling (PubMed:25869668, PubMed:25869669). Regulator of TF:TFRC and integrins recycling pathway, is also involved in cell migration mechanisms (PubMed:25869669). Modulates AKT/GSK3B pathway by decreasing AKT and GSK3B phosphorylation (PubMed:17322895). Negatively regulates STAT3 signaling pathway through inhibition of STAT3 phosphorylation and translocation to the nucleus (PubMed:25476455). Functionally important modulator of cardiac myocyte size and of the cardiac response to stress (By similarity). May play a role as negative regulator of axon regeneration after central nervous system injuries (By similarity). May be involved in insulin granule docking at the plasma membrane of pancreatic cells, an essential step for insulin secretion (PubMed:31533953)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}