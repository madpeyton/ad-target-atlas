:-0.0129157,"donor_lfcse":0.0684283,"donor_log2fc_shrunk":-2.83857e-06,"degas_log2fc":-0.266872,"degas_padj":7.54333e-10},{"cell_type":"Oli","gene_symbol":"KPNA6","gene_symbol_current":"KPNA6","gene_id":"ENSG00000025800","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.364811,"nucleus_log2fc":-0.0143514,"nucleus_score":-1.00058,"pct_ad":0.378087,"pct_control":0.382573,"donor_test":"not significant","donor_padj":0.975371,"donor_log2fc":0.0152839,"donor_lfcse":0.0757437,"donor_log2fc_shrunk":0.00216682,"degas_log2fc":-0.219647,"degas_padj":3.37479e-31}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000025800","module":"blue","kme":0.126071,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000025800","module":"blue","kme":0.141526,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000025800","entrez_id":["23633"],"uniprot":["O60684"],"ncbi_summary":"Nucleocytoplasmic transport, a signal- and energy-dependent process, takes place through nuclear pore complexes embedded in the nuclear envelope. The import of proteins containing a nuclear localization signal (NLS) requires the NLS import receptor, a heterodimer of importin alpha and beta subunits also known as karyopherins. Importin alpha binds the NLS-containing cargo in the cytoplasm and importin beta docks the complex at the cytoplasmic side of the nuclear pore complex. In the presence of nucleoside triphosphates and the small GTP binding protein Ran, the complex moves into the nuclear pore complex and the importin subunits dissociate. Importin alpha enters the nucleoplasm with its passenger protein and importin beta remains at the pore. The protein encoded by this gene is a member of the importin alpha family. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60684","text":"Functions in nuclear protein import as an adapter protein for nuclear receptor KPNB1. Binds specifically and directly to substrates containing either a simple or bipartite NLS motif. Docking of the importin/substrate complex to the nuclear pore complex (NPC) is mediated by KPNB1 through binding to nucleoporin FxFG repeats and the complex is subsequently translocated through the pore by an energy requiring, Ran-dependent mechanism. At the nucleoplasmic side of the NPC, Ran binds to importin-beta and the three components separate and importin-alpha and -beta are re-exported from the nucleus to the cytoplasm where GTP hydrolysis releases Ran from importin. The directionality of nuclear import is thought to be conferred by an asymmetric distribution of the GTP- and GDP-bound forms of Ran between the cytoplasm and nucleus."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}