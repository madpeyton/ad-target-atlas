iption":[{"gene_id":"ENSG00000028277","entrez_id":["5452"],"uniprot":["P09086"],"ncbi_summary":"The protein encoded by this gene is a homeobox-containing transcription factor of the POU domain family. The encoded protein binds the octamer sequence 5'-ATTTGCAT-3', a common transcription factor binding site in immunoglobulin gene promoters. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Oct 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P09086","text":"Transcription factor that specifically binds to the octamer motif (5'-ATTTGCAT-3') (PubMed:2904654, PubMed:7859290). Regulates IL6 expression in B cells with POU2AF1 (By similarity). Regulates transcription in a number of tissues in addition to activating immunoglobulin gene expression (PubMed:2901913, PubMed:2904654). Modulates transcription transactivation by NR3C1, AR and PGR (PubMed:10480874). [Isoform 5]: Activates the U2 small nuclear RNA (snRNA) promoter."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}