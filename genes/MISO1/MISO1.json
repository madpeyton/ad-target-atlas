eus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.20158,"donor_lfcse":0.158371,"donor_log2fc_shrunk":-8.44546e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000174928","entrez_id":["285315"],"uniprot":["Q6P1S2"],"ncbi_summary":"Involved in negative regulation of ERK1 and ERK2 cascade and regulation of DNA-binding transcription factor activity. Located in extracellular space. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6P1S2","text":"Regulates mitochondrial morphology and mitochondrial DNA (mtDNA) homeostasis (PubMed:41398051). Promotes the formation of specialized mitochondrial subdomains called small MTFP1-enriched mitochondria (SMEM) (PubMed:41398051). Negatively regulates mitochondrial fusion by excluding fusion coordinator OPA1 from SMEM (PubMed:41398051). Recruits mtDNA, potentially through interaction with SSBP1, and facilitates mtDNA transport to the mitochondrial periphery (PubMed:41398051). Also recruits other proteins, including PHB1, PHB2 and MTFP1, into SMEM which promotes peripheral mitochondrial fission, facilitating lysosome-mediated clearance of damaged mtDNA via mitophagy (PubMed:41398051). [Isoform 2]: Secreted protein which may play a role in transcription regulation via the MAPK3/MAPK1 pathway through an unidentified receptor on the plasma membrane."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}