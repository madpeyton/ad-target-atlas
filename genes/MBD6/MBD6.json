odules":[{"cell_type":"Ast","gene_id":"ENSG00000166987","module":"turquoise","kme":0.0683797,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000166987","module":"turquoise","kme":0.0689129,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000166987","module":"turquoise","kme":0.0615285,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000166987","entrez_id":["114785"],"uniprot":["Q96DN6"],"ncbi_summary":"Enables chromatin binding activity. Located in chromocenter; fibrillar center; and nucleoplasm. Implicated in autism spectrum disorder. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96DN6","text":"Non-catalytic component of the polycomb repressive deubiquitinase (PR-DUB) complex, a complex that specifically mediates deubiquitination of histone H2A monoubiquitinated at 'Lys-120' (H2AK119ub1) (PubMed:24634419). Important for stability of PR-DUB components and stimulating its ubiquitinase activity (PubMed:36180891). As part of the PR-DUB complex, associates with chromatin enriched in histone marks H3K4me1, H3K4me3, and H3K27Ac, but not in H3K27me3 (PubMed:36180891). MBD5 and MBD6 containing complexes associate with distinct chromatin regions enriched in genes involved in different pathways (PubMed:36180891). Heterochromatin recruitment is not mediated by DNA methylation (PubMed:20700456). The PR-DUB complex is an epigenetic regulator of gene expression, including genes involved in development, cell communication, signaling, cell proliferation and cell viability; may promote cancer cell growth (PubMed:36180891)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}