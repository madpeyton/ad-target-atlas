3878,"nucleus_score":0.410734,"pct_ad":0.226956,"pct_control":0.225357,"donor_test":"not significant","donor_padj":0.894875,"donor_log2fc":0.107389,"donor_lfcse":0.138388,"donor_log2fc_shrunk":0.00577302}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000177556","module":"turquoise","kme":0.0359172,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000177556","module":"brown","kme":0.223433,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000177556","module":"turquoise","kme":0.131133,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000177556","module":"turquoise","kme":0.196683,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000177556","entrez_id":["475"],"uniprot":["O00244"],"ncbi_summary":"This gene encodes a copper chaperone that plays a role in copper homeostasis by binding and transporting cytosolic copper to ATPase proteins in the trans-Golgi network for later incorporation to the ceruloplasmin. This protein also functions as an antioxidant against superoxide and hydrogen peroxide, and therefore, may play a significant role in cancer carcinogenesis. Because of its cytogenetic location, this gene represents a candidate gene for 5q-syndrome. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00244","text":"Multifunctional copper-sensing protein that operates both as a cytosolic copper chaperone and as a copper-dependent transcription factor. Essential for maintaining cellular copper homeostasis and linking copper distribution to redox balance, signal transduction, and gene regulation. In the cytosol, transfers copper to the copper-transporting ATPase ATP7A at the trans-Golgi network, which is required for activation of secretory copper enzymes including lysyl oxidase (LOX) and SOD3. This chaperone function is essential for full SOD3 and LOX enzymatic activity. Acts as a copper-dependent transcription factor. Upon copper binding, translocates to the nucleus where it binds specific promoter elements and regulates transcription of genes involved in cell proliferation, oxidative stress defense, and extracellular matrix remodeling. Activates expression of target genes including CCND1, SOD3 and NCF1, thereby linking cellular copper status to gene expression programs controlling growth and redox homeostasis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}