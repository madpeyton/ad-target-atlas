0000116157","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.96108,"donor_log2fc":0.0615372,"donor_lfcse":0.170207,"donor_log2fc_shrunk":0.00233735}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000116157","module":"turquoise","kme":0.0408117,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000116157","entrez_id":["2882"],"uniprot":["Q96SL4"],"ncbi_summary":"Enables catalase activity. Predicted to be involved in cellular response to oxidative stress. Located in endoplasmic reticulum. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96SL4","text":"Acts as an endoplasmic reticulum (ER) thiol peroxidase that maintains ER redox homeostasis and supports oxidative protein folding (PubMed:32719007). Rapidly reacts with hydrogen peroxide to form sulfenylated/disulfide intermediates and oxidizes protein disulfide isomerase (PDI) family members, promoting disulfide-bond formation (PubMed:21215271). Functions in a redox relay with ERO1A, using ERO1A-generated H(2)O(2) to drive PDI oxidation, linking peroxide detoxification to productive disulfide formation (PubMed:23919619). Protects esophageal epithelia from hydrogen peroxide-induced oxidative stress by reducing reactive oxygen species (ROS) and preventing oxidative DNA damage and double-strand breaks (PubMed:22157330)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}