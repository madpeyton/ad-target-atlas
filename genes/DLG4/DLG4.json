nor_lfcse":0.0646344,"donor_log2fc_shrunk":0.00819996},{"cell_type":"Mic","gene_symbol":"DLG4","gene_symbol_current":"DLG4","gene_id":"ENSG00000132535","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.793921,"nucleus_log2fc":-0.0421041,"nucleus_score":-0.340873,"pct_ad":0.127019,"pct_control":0.128226,"donor_test":"not significant","donor_padj":0.966538,"donor_log2fc":-0.0281302,"donor_lfcse":0.118591,"donor_log2fc_shrunk":-0.0035969},{"cell_type":"OPC","gene_symbol":"DLG4","gene_symbol_current":"DLG4","gene_id":"ENSG00000132535","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.15068,"nucleus_log2fc":-0.15711,"nucleus_score":-1.84514,"pct_ad":0.171936,"pct_control":0.182388,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0766888,"donor_lfcse":0.119055,"donor_log2fc_shrunk":-5.53542e-06},{"cell_type":"Oli","gene_symbol":"DLG4","gene_symbol_current":"DLG4","gene_id":"ENSG00000132535","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.997243,"donor_log2fc":0.00244348,"donor_lfcse":0.109693,"donor_log2fc_shrunk":0.000194041}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000132535","module":"red","kme":0.207247,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000132535","entrez_id":["1742"],"uniprot":["P78352"],"ncbi_summary":"This gene encodes a member of the membrane-associated guanylate kinase (MAGUK) family. It heteromultimerizes with another MAGUK protein, DLG2, and is recruited into NMDA receptor and potassium channel clusters. These two MAGUK proteins may interact at postsynaptic sites to form a multimeric scaffold for the clustering of receptors, ion channels, and associated signaling proteins. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P78352","text":"Postsynaptic scaffolding protein that plays a critical role in synaptogenesis and synaptic plasticity by providing a platform for the postsynaptic clustering of crucial synaptic proteins. Interacts with the cytoplasmic tail of NMDA receptor subunits and shaker-type potassium channels. Required for synaptic plasticity associated with NMDA receptor signaling. Overexpression or depletion of DLG4 changes the ratio of excitatory to inhibitory synapses in hippocampal neurons. May reduce the amplitude of ASIC3 acid-evoked currents by retaining the channel intracellularly. May regulate the intracellular trafficking of ADR1B. Also regulates AMPA-type glutamate receptor (AMPAR) immobilization at postsynaptic density keeping the channels in an activated state in the presence of glutamate and preventing synaptic depression (By similarity). Under basal conditions, cooperates with FYN to stabilize palmitoyltransferase ZDHHC5 at the synaptic membrane through FYN-mediated phosphorylation of ZDHHC5 and its subsequent inhibition of association with endocytic proteins (PubMed:26334723)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}