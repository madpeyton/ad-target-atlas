r_lfcse":0.12096,"donor_log2fc_shrunk":0.00132594,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"TOP3B","gene_symbol_current":"TOP3B","gene_id":"ENSG00000100038","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0061236,"nucleus_log2fc":0.20484,"nucleus_score":3.24073,"pct_ad":0.107665,"pct_control":0.0897544,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.192245,"donor_lfcse":0.124383,"donor_log2fc_shrunk":1.27491e-05,"degas_log2fc":-0.0485747,"degas_padj":0.624835},{"cell_type":"Oli","gene_symbol":"TOP3B","gene_symbol_current":"TOP3B","gene_id":"ENSG00000100038","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.933235,"donor_log2fc":0.060933,"donor_lfcse":0.115205,"donor_log2fc_shrunk":0.00470585,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000100038","module":"red","kme":0.0947706,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100038","entrez_id":["8940"],"uniprot":["O95985"],"ncbi_summary":"This gene encodes a DNA topoisomerase, an enzyme that controls and alters the topologic states of DNA during transcription. This enzyme catalyzes the transient breaking and rejoining of a single strand of DNA which allows the strands to pass through one another, thus relaxing the supercoils and altering the topology of DNA. The enzyme interacts with DNA helicase SGS1 and plays a role in DNA recombination, cellular aging and maintenance of genome stability. Low expression of this gene may be related to higher survival rates in breast cancer patients. This gene has a pseudogene on chromosome 22. Alternate splicing results in multiple transcript variants. Additional alternatively spliced transcript variants of this gene have been described, but their full-length nature is not known. [provided by RefSeq, Aug 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95985","text":"Releases the supercoiling and torsional tension of DNA introduced during the DNA replication and transcription by transiently cleaving and rejoining one strand of the DNA duplex. Introduces a single-strand break via transesterification at a target site in duplex DNA. The scissile phosphodiester is attacked by the catalytic tyrosine of the enzyme, resulting in the formation of a DNA-(5'-phosphotyrosyl)-enzyme intermediate and the expulsion of a 3'-OH DNA strand. The free DNA strand than undergoes passage around the unbroken strand thus removing DNA supercoils. Finally, in the religation step, the DNA 3'-OH attacks the covalent intermediate to expel the active-site tyrosine and restore the DNA phosphodiester backbone (By similarity). Possesses negatively supercoiled DNA relaxing activity."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}