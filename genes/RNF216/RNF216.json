9889,"donor_log2fc":0.0483871,"donor_lfcse":0.0863904,"donor_log2fc_shrunk":6.745e-06},{"cell_type":"Mic","gene_symbol":"RNF216","gene_symbol_current":"RNF216","gene_id":"ENSG00000011275","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.857873,"nucleus_log2fc":0.0842031,"nucleus_score":0.436414,"pct_ad":0.161132,"pct_control":0.153558,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"RNF216","gene_symbol_current":"RNF216","gene_id":"ENSG00000011275","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.471575,"nucleus_log2fc":-0.184817,"nucleus_score":-1.35315,"pct_ad":0.204082,"pct_control":0.227586,"donor_test":"not significant","donor_padj":0.998161,"donor_log2fc":-0.0231294,"donor_lfcse":0.137786,"donor_log2fc_shrunk":-0.000245284},{"cell_type":"Oli","gene_symbol":"RNF216","gene_symbol_current":"RNF216","gene_id":"ENSG00000011275","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0302138,"nucleus_log2fc":0.146612,"nucleus_score":2.49041,"pct_ad":0.124648,"pct_control":0.11209,"donor_test":"not significant","donor_padj":0.868589,"donor_log2fc":0.0893379,"donor_lfcse":0.0976485,"donor_log2fc_shrunk":0.00863077}],"modules":[{"cell_type":"In","gene_id":"ENSG00000011275","module":"yellow","kme":0.189518,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000011275","module":"red","kme":0.159747,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000011275","entrez_id":["54476"],"uniprot":["Q9NWF9"],"ncbi_summary":"This gene encodes a cytoplasmic protein which specifically colocalizes and interacts with the serine/threonine protein kinase, receptor-interacting protein (RIP). Zinc finger domains of the encoded protein are required for its interaction with RIP and for inhibition of TNF- and IL1-induced NF-kappa B activation pathways. The encoded protein may also function as an E3 ubiquitin-protein ligase which accepts ubiquitin from E2 ubiquitin-conjugating enzymes and transfers it to substrates. Several alternatively spliced transcript variants have been described for this locus but the full-length natures of only some are known. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NWF9","text":"[Isoform 1]: E3 ubiquitin ligase which accepts ubiquitin from specific E2 ubiquitin-conjugating enzymes, and then transfers it to substrates promoting their ubiquitination (PubMed:34998453). Plays a role in the regulation of antiviral responses by promoting the degradation of TRAF3, TLR4 and TLR9 (PubMed:15107846, PubMed:19893624). In turn, down-regulates NF-kappa-B and IRF3 activation as well as beta interferon production. Also participates in the regulation of autophagy by ubiquitinating BECN1 leading to its degradation and autophagy inhibition (PubMed:25484083). Plays a role in ARC-dependent synaptic plasticity by mediating ARC ubiquitination resulting in its rapid proteasomal degradation (PubMed:24945773). Plays aso an essential role in spermatogenesis and male fertility (By similarity). Mechanistically, regulates meiosis by promoting the degradation of PRKACB through the ubiquitin-mediated lysosome pathway (By similarity). Modulates the gonadotropin-releasing hormone signal pathway by affecting the stability of STAU2 that is required for the microtubule-dependent transport of neuronal RNA from the cell body to the dendrite (By similarity). [Isoform 3]: Inhibits TNF and IL-1 mediated activation of NF-kappa-B. Promotes TNF and RIP mediated apoptosis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}