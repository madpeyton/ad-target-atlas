01,"donor_log2fc":0.256821,"donor_lfcse":0.188616,"donor_log2fc_shrunk":0.0066931,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"SLC7A10","gene_symbol_current":"SLC7A10","gene_id":"ENSG00000130876","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.834083,"donor_log2fc":0.186252,"donor_lfcse":0.237488,"donor_log2fc_shrunk":0.00158254,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"SLC7A10","gene_symbol_current":"SLC7A10","gene_id":"ENSG00000130876","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.199768,"donor_lfcse":0.198189,"donor_log2fc_shrunk":-5.28141e-06,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000130876","entrez_id":["56301"],"uniprot":["Q9NS82"],"ncbi_summary":"SLC7A10, in association with 4F2HC (SLC3A2; MIM 158070), mediates high-affinity transport of D-serine and several other neutral amino acids (Nakauchi et al., 2000 [PubMed 10863037]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NS82","text":"Associates with SLC3A2/4F2hc to form a functional heterodimeric complex that translocates small neutral L- and D-amino acids across the plasma membrane. Preferentially mediates exchange transport, but can also operate via facilitated diffusion (By similarity) (PubMed:10863037). Acts as a major transporter for glycine, L- and D-serine in the central nervous system. At the spinal cord and brainstem regulates glycine metabolism and glycinergic inhibitory neurotransmission by providing for glycine de novo synthesis from L-serine and glycine recycling from astrocytes to glycinergic motor neurons (By similarity). At Schaffer collateral-CA1 synapses mediates D-serine and glycine release that modulates post-synaptic activation of NMDA receptors and excitatory glutamatergic transmission (By similarity). May regulate D-serine release from mesenchymal progenitors located in developing subcutaneous adipose tissue, favoring white adipocyte over thermogenic beige adipocyte lineage commitment (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}