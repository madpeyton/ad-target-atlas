:0.475538},{"cell_type":"OPC","gene_symbol":"ARL3","gene_symbol_current":"ARL3","gene_id":"ENSG00000138175","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.132423,"nucleus_log2fc":0.0866241,"nucleus_score":1.92022,"pct_ad":0.353564,"pct_control":0.337511,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0703576,"donor_lfcse":0.0634461,"donor_log2fc_shrunk":1.49531e-05,"degas_log2fc":-0.207069,"degas_padj":1.29124e-05},{"cell_type":"Oli","gene_symbol":"ARL3","gene_symbol_current":"ARL3","gene_id":"ENSG00000138175","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.703709,"nucleus_log2fc":-0.00117745,"nucleus_score":-0.434673,"pct_ad":0.186256,"pct_control":0.187929,"donor_test":"not significant","donor_padj":0.895874,"donor_log2fc":0.041374,"donor_lfcse":0.0536517,"donor_log2fc_shrunk":0.0122167,"degas_log2fc":-0.128654,"degas_padj":3.25665e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000138175","entrez_id":["403"],"uniprot":["P36405"],"ncbi_summary":"ADP-ribosylation factor-like 3 is a member of the ADP-ribosylation factor family of GTP-binding proteins. ARL3 binds guanine nucleotides but lacks ADP-ribosylation factor activity. [provided by RefSeq, Jul 2008]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P36405","text":"Small GTP-binding protein which cycles between an inactive GDP-bound and an active GTP-bound form, and the rate of cycling is regulated by guanine nucleotide exchange factors (GEF) and GTPase-activating proteins (GAP) (PubMed:16525022, PubMed:18588884). Required for normal cytokinesis and cilia signaling (PubMed:22085962). Requires assistance from GTPase-activating proteins (GAPs) like RP2 and PDE6D, in order to cycle between inactive GDP-bound and active GTP-bound forms. Required for targeting proteins to the cilium, including myristoylated NPHP3 and prenylated INPP5E (PubMed:30269812). Targets NPHP3 to the ciliary membrane by releasing myristoylated NPHP3 from UNC119B cargo adapter into the cilium (PubMed:22085962). Required for PKD1:PKD2 complex targeting from the trans-Golgi network to the cilium (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}