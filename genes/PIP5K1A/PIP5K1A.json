34,"pct_ad":0.124804,"pct_control":0.142529,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"PIP5K1A","gene_symbol_current":"PIP5K1A","gene_id":"ENSG00000143398","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.780549,"donor_log2fc":-0.190788,"donor_lfcse":0.139343,"donor_log2fc_shrunk":-0.00960196}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000143398","module":"green","kme":0.136163,"hub":false,"module_direction":"lower in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000143398","module":"blue","kme":0.236287,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000143398","module":"yellow","kme":0.210107,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000143398","module":"black","kme":0.129537,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000143398","module":"blue","kme":0.0791812,"hub":false,"module_direction":"lower in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000143398","entrez_id":["8394"],"uniprot":["Q99755"],"ncbi_summary":"Enables 1-phosphatidylinositol-4-phosphate 5-kinase activity and kinase binding activity. Involved in several processes, including activation of GTPase activity; focal adhesion assembly; and ruffle assembly. Located in several cellular components, including lamellipodium; nuclear speck; and ruffle membrane. Colocalizes with mRNA cleavage and polyadenylation specificity factor complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q99755","text":"Catalyzes the phosphorylation of phosphatidylinositol 4-phosphate (PtdIns(4)P/PI4P) to form phosphatidylinositol 4,5-bisphosphate (PtdIns(4,5)P2/PIP2), a lipid second messenger that regulates several cellular processes such as signal transduction, vesicle trafficking, actin cytoskeleton dynamics, cell adhesion, and cell motility (PubMed:21477596, PubMed:22942276, PubMed:8955136). PtdIns(4,5)P2 can directly act as a second messenger or can be utilized as a precursor to generate other second messengers: inositol 1,4,5-trisphosphate (IP3), diacylglycerol (DAG) or phosphatidylinositol-3,4,5-trisphosphate (PtdIns(3,4,5)P3/PIP3) (PubMed:19158393, PubMed:20660631). PIP5K1A-mediated phosphorylation of PtdIns(4)P is the predominant pathway for PtdIns(4,5)P2 synthesis (By similarity). Can also use phosphatidylinositol (PtdIns) as substrate in vitro (PubMed:22942276). Together with PIP5K1C, is required for phagocytosis, both enzymes regulating different types of actin remodeling at sequential steps (By similarity). Promotes particle ingestion by activating the WAS GTPase-binding protein that induces Arp2/3 dependent actin polymerization at the nascent phagocytic cup (By similarity). Together with PIP5K1B, is required, after stimulation by G protein coupled receptors, for the synthesis of IP3 that will induce stable platelet adhesion (By similarity). Recruited to the plasma membrane by the E-cadherin/beta-catenin complex where it provides the substrate PtdIns(4,5)P2 for the production of PtdIns(3,4,5)P3, IP3 and DAG, that will mobilize internal calcium and drive keratinocyte differentiation (PubMed:19158393). Positively regulates insulin-induced translocation of SLC2A4 to the cell membrane in adipocytes (By similarity). Together with PIP5K1C has a role during embryogenesis (By similarity). Independently of its catalytic activity, is required for membrane ruffling formation, actin organization and focal adhesion formation during directional cell migration by controlling integrin-induced translocation of the small GTPase RAC1 to the plasma membrane (PubMed:20660631). Also functions in the nucleus where it acts as an activator of TUT1 adenylyltransferase activity in nuclear speckles, thereby regulating mRNA polyadenylation of a select set of mRNAs (PubMed:18288197)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}