ataset_symbols":["ANTXR2"],"explorer":"explorer.html?dataset=mathys2019#gene/ANTXR2","cell_types":[{"cell_type":"Ex","gene_symbol":"ANTXR2","gene_symbol_current":"ANTXR2","gene_id":"ENSG00000163297","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.584063,"nucleus_log2fc":0.0894865,"nucleus_score":-0.657045,"pct_ad":0.0991467,"pct_control":0.102807,"donor_test":"not significant","donor_padj":0.998051,"donor_log2fc":0.0166605,"donor_lfcse":0.16778,"donor_log2fc_shrunk":6.13668e-07}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000163297","module":"brown","kme":0.179658,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163297","entrez_id":["118429"],"uniprot":["P58335"],"ncbi_summary":"This gene encodes a receptor for anthrax toxin. The protein binds to collagen IV and laminin, suggesting that it may be involved in extracellular matrix adhesion. Mutations in this gene cause juvenile hyaline fibromatosis and infantile systemic hyalinosis. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P58335","text":"Necessary for cellular interactions with laminin and the extracellular matrix. (Microbial infection) Receptor for the protective antigen (PA) of B.anthracis (PubMed:12700348, PubMed:15243628, PubMed:15326297). Binding of PA leads to heptamerization of the receptor-PA complex (PubMed:12700348, PubMed:15243628, PubMed:15326297). Upon binding of the PA of B.anthracis, the complex moves to glycosphingolipid-rich lipid rafts, where it is internalized via a clathrin-dependent pathway (PubMed:12551953, PubMed:15337774). In the endosomal membrane, at pH under 7, the complex then rearranges and forms a pore allowing the other components of anthrax toxin to escape to the cytoplasm (PubMed:12551953, PubMed:15337774)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}