rue,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.18984e-05,"nucleus_log2fc":-0.0167055,"nucleus_score":-4.43377,"pct_ad":0.443124,"pct_control":0.459442,"donor_test":"not significant","donor_padj":0.864627,"donor_log2fc":0.037789,"donor_lfcse":0.0723579,"donor_log2fc_shrunk":0.0114252,"degas_log2fc":-0.121554,"degas_padj":1.40092e-48},{"cell_type":"In","gene_symbol":"SENP1","gene_symbol_current":"SENP1","gene_id":"ENSG00000079387","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":5.38222e-08,"nucleus_log2fc":-0.052864,"nucleus_score":-5.53075,"pct_ad":0.318572,"pct_control":0.332236,"donor_test":"not significant","donor_padj":0.943385,"donor_log2fc":0.0179662,"donor_lfcse":0.0613146,"donor_log2fc_shrunk":0.00231354,"degas_log2fc":-0.153345,"degas_padj":1.50919e-33},{"cell_type":"Mic","gene_symbol":"SENP1","gene_symbol_current":"SENP1","gene_id":"ENSG00000079387","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.534407,"nucleus_log2fc":0.0340679,"nucleus_score":0.773859,"pct_ad":0.167409,"pct_control":0.163364,"donor_test":"not significant","donor_padj":0.968603,"donor_log2fc":0.0190989,"donor_lfcse":0.0852077,"donor_log2fc_shrunk":0.00432862,"degas_log2fc":0.0353634,"degas_padj":0.602751},{"cell_type":"OPC","gene_symbol":"SENP1","gene_symbol_current":"SENP1","gene_id":"ENSG00000079387","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.66045,"nucleus_log2fc":0.0235164,"nucleus_score":0.651553,"pct_ad":0.216821,"pct_control":0.210838,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0173738,"donor_lfcse":0.0824234,"donor_log2fc_shrunk":2.66472e-06,"degas_log2fc":-0.346478,"degas_padj":1.36628e-08},{"cell_type":"Oli","gene_symbol":"SENP1","gene_symbol_current":"SENP1","gene_id":"ENSG00000079387","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.444453,"nucleus_log2fc":-0.0123577,"nucleus_score":-0.850097,"pct_ad":0.132962,"pct_control":0.135411,"donor_test":"not significant","donor_padj":0.991469,"donor_log2fc":-0.00707412,"donor_lfcse":0.0888315,"donor_log2fc_shrunk":-0.00103907,"degas_log2fc":-0.266487,"degas_padj":1.89307e-16}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000079387","entrez_id":["29843"],"uniprot":["Q9P0U3"],"ncbi_summary":"This gene encodes a cysteine protease that specifically targets members of the small ubiquitin-like modifier (SUMO) protein family. This protease regulates SUMO pathways by deconjugating sumoylated proteins. This protease also functions to process the precursor SUMO proteins into their mature form. Alternate splicing results in multiple transcript variants. [provided by RefSeq, Jun 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9P0U3","text":"Protease that catalyzes two essential functions in the SUMO pathway (PubMed:10652325, PubMed:15199155, PubMed:15487983, PubMed:16253240, PubMed:16553580, PubMed:21829689, PubMed:21965678, PubMed:23160374, PubMed:24943844, PubMed:25406032, PubMed:29506078, PubMed:34048572, PubMed:37257451). The first is the hydrolysis of an alpha-linked peptide bond at the C-terminal end of the small ubiquitin-like modifier (SUMO) propeptides, SUMO1, SUMO2 and SUMO3 leading to the mature form of the proteins (PubMed:15487983). The second is the deconjugation of SUMO1, SUMO2 and SUMO3 from targeted proteins, by cleaving an epsilon-linked peptide bond between the C-terminal glycine of the mature SUMO and the lysine epsilon-amino group of the target protein (PubMed:15199155, PubMed:16253240, PubMed:21829689, PubMed:21965678, PubMed:23160374, PubMed:24943844, PubMed:25406032, PubMed:29506078, PubMed:34048572, PubMed:37257451). Deconjugates SUMO1 from HIPK2 (PubMed:16253240). Deconjugates SUMO1 from HDAC1 and BHLHE40/DEC1, which decreases its transcriptional repression activity (PubMed:15199155, PubMed:21829689). Deconjugates SUMO1 from CLOCK, which decreases its transcriptional activation activity (PubMed:23160374). Deconjugates SUMO2 from MTA1 (PubMed:21965678). Inhibits N(6)-methyladenosine (m6A) RNA methylation by mediating SUMO1 deconjugation from METTL3 and ALKBH5: METTL3 inhibits the m6A RNA methyltransferase activity, while ALKBH5 desumoylation promotes m6A demethylation (PubMed:29506078, PubMed:34048572, PubMed:37257451). Desumoylates CCAR2 which decreases its interaction with SIRT1 (PubMed:25406032). Deconjugates SUMO1 from GPS2 (PubMed:24943844)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}