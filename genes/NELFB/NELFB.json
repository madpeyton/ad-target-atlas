"turquoise","kme":0.104668,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000188986","module":"turquoise","kme":0.196012,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000188986","module":"turquoise","kme":0.136186,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000188986"],"dataset_symbols":["NELFB"],"explorer":"explorer.html?dataset=mathys2019#gene/NELFB","cell_types":[{"cell_type":"Ex","gene_symbol":"NELFB","gene_symbol_current":"NELFB","gene_id":"ENSG00000188986","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.031532,"nucleus_log2fc":-0.0632054,"nucleus_score":-2.3756,"pct_ad":0.181532,"pct_control":0.195007,"donor_test":"not significant","donor_padj":0.999899,"donor_log2fc":0.00361728,"donor_lfcse":0.11561,"donor_log2fc_shrunk":-4.19733e-06},{"cell_type":"In","gene_symbol":"NELFB","gene_symbol_current":"NELFB","gene_id":"ENSG00000188986","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.380477,"nucleus_log2fc":0.15243,"nucleus_score":1.79124,"pct_ad":0.104259,"pct_control":0.0887021,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"NELFB","gene_symbol_current":"NELFB","gene_id":"ENSG00000188986","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.758006,"donor_log2fc":0.294471,"donor_lfcse":0.18954,"donor_log2fc_shrunk":0.0080237}],"modules":[{"cell_type":"In","gene_id":"ENSG00000188986","module":"turquoise","kme":0.118741,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000188986","entrez_id":["25920"],"uniprot":["Q8WX92"],"ncbi_summary":"NELFB is a subunit of negative elongation factor (NELF), which also includes NELFA (WHSC2; MIM 606026), either NELFC or NELFD (TH1L; MIM 605297), and NELFE (RDBP; MIM 154040). NELF acts with DRB sensitivity-inducing factor (DSIF), a heterodimer of SPT4 (SUPT4H1; MIM 603555) and SPT5 (SUPT5H; MIM 602102), to cause transcriptional pausing of RNA polymerase II (see MIM 180660) (Narita et al., 2003 [PubMed 12612062]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WX92","text":"Essential component of the NELF complex, a complex that negatively regulates the elongation of transcription by RNA polymerase II (PubMed:12612062). The NELF complex, which acts via an association with the DSIF complex and causes transcriptional pausing, is counteracted by the P-TEFb kinase complex (PubMed:10199401). May be able to induce chromatin unfolding (PubMed:11739404). Essential for early embryogenesis; plays an important role in maintaining the undifferentiated state of embryonic stem cells (ESCs) by preventing unscheduled expression of developmental genes (By similarity). Plays a key role in establishing the responsiveness of stem cells to developmental cues; facilitates plasticity and cell fate commitment in ESCs by establishing the appropriate expression level of signaling molecules (By similarity). Supports the transcription of genes involved in energy metabolism in cardiomyocytes; facilitates the association of transcription initiation factors with the promoters of the metabolism-related genes (By similarity). (Microbial infection) The NELF complex is involved in HIV-1 latency possibly involving recruitment of PCF11 to paused RNA polymerase II (PubMed:23884411). In vitro, binds weakly to the HIV-1 TAR RNA which is located in the long terminal repeat (LTR) of HIV-1 (PubMed:23884411)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}