gene_id":"ENSG00000162729","module":"turquoise","kme":0.151451,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000162729","module":"turquoise","kme":0.206606,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000162729","module":"turquoise","kme":0.159557,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000162729","module":"turquoise","kme":0.147558,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000162729","module":"blue","kme":0.163107,"hub":false,"module_direction":"higher in AD","module_padj":0.49728,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000162729","module":"turquoise","kme":0.176543,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000162729"],"dataset_symbols":["IGSF8"],"explorer":"explorer.html?dataset=mathys2019#gene/IGSF8","cell_types":[{"cell_type":"Ex","gene_symbol":"IGSF8","gene_symbol_current":"IGSF8","gene_id":"ENSG00000162729","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000443782,"nucleus_log2fc":-0.103763,"nucleus_score":-3.79472,"pct_ad":0.387952,"pct_control":0.420482,"donor_test":"not significant","donor_padj":0.992956,"donor_log2fc":0.0295779,"donor_lfcse":0.0946676,"donor_log2fc_shrunk":5.14003e-05},{"cell_type":"In","gene_symbol":"IGSF8","gene_symbol_current":"IGSF8","gene_id":"ENSG00000162729","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.131601,"nucleus_log2fc":-0.27669,"nucleus_score":-2.6423,"pct_ad":0.182786,"pct_control":0.208217,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.111623,"donor_lfcse":0.168258,"donor_log2fc_shrunk":-4.08764e-06},{"cell_type":"Oli","gene_symbol":"IGSF8","gene_symbol_current":"IGSF8","gene_id":"ENSG00000162729","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.963644,"donor_log2fc":0.0309037,"donor_lfcse":0.128796,"donor_log2fc_shrunk":0.00170834}],"modules":[{"cell_type":"In","gene_id":"ENSG00000162729","module":"turquoise","kme":0.246878,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000162729","module":"turquoise","kme":0.153299,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000162729","entrez_id":["93185"],"uniprot":["Q969P0"],"ncbi_summary":"This gene encodes a member the EWI subfamily of the immunoglobulin protein superfamily. Members of this family contain a single transmembrane domain, an EWI (Glu-Trp-Ile)-motif and a variable number of immunoglobulin domains. This protein interacts with the tetraspanins CD81 and CD9 and may regulate their role in certain cellular functions including cell migration and viral infection. The encoded protein may also function as a tumor suppressor by inhibiting the proliferation of certain cancers. Alternate splicing results in multiple transcript variants that encode the same protein. [provided by RefSeq, Sep 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q969P0","text":"Member of the immunoglobulin superfamily (IgSF) that links tetraspanin-enriched microdomains to the actin cytoskeleton and plays several important roles in innate and adaptive immunity (PubMed:11504738, PubMed:14662754). Acts as an inducible receptor of HSPA8 on dendritic cells to enhance the CCL21/SLC-dependent migration of activated mature dendritic cells while attenuating their antigen-specific stimulatory capacities (PubMed:17785435). In complex with alpha-actinins ACTN1 and ACTN4, regulates actin dynamics in the immune synapse and subsequent T-cell activation (PubMed:22689882). Inhibits the entry of several viruses such as hepatitis C Virus (HCV) or HIV-1. Mechanistically, promotes a change in CD81 organization at the plasma membrane by significantly restricting its diffusion which in turn influences CD81 interaction with Claudin-1/CLDN1, preventing CLDN1 from acting as a co-receptor required for HCV entry (PubMed:23351194). Accumulates at the presynaptic terminal, the producer cell side of the virological synapse, to prevent HIV-1 Env-mediated cell-cell fusion (PubMed:31757023). Highly expressed on malignant cells with antigen presentation defects, interacts with NK receptor KIR3DL2 to suppress NK-cell cytotoxicity (PubMed:38657602). May participate in the regulation of neurite outgrowth and maintenance of the neural network in the adult brain."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}