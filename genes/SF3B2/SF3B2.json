us_padj":0.832929,"nucleus_log2fc":0.0186206,"nucleus_score":0.595203,"pct_ad":0.25244,"pct_control":0.238406,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.00414461,"donor_lfcse":0.128103,"donor_log2fc_shrunk":2.68701e-07},{"cell_type":"OPC","gene_symbol":"SF3B2","gene_symbol_current":"SF3B2","gene_id":"ENSG00000087365","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.526662,"nucleus_log2fc":-0.18907,"nucleus_score":-1.2159,"pct_ad":0.119309,"pct_control":0.135632,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"SF3B2","gene_symbol_current":"SF3B2","gene_id":"ENSG00000087365","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00294511,"nucleus_log2fc":0.215599,"nucleus_score":3.33916,"pct_ad":0.109335,"pct_control":0.0939391,"donor_test":"not significant","donor_padj":0.874417,"donor_log2fc":0.132242,"donor_lfcse":0.156586,"donor_log2fc_shrunk":0.0050747}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000087365","module":"turquoise","kme":0.245828,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000087365","module":"turquoise","kme":0.230762,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000087365","module":"turquoise","kme":0.145676,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000087365","entrez_id":["10992"],"uniprot":["Q13435"],"ncbi_summary":"This gene encodes subunit 2 of the splicing factor 3b protein complex. Splicing factor 3b, together with splicing factor 3a and a 12S RNA unit, forms the U2 small nuclear ribonucleoproteins complex (U2 snRNP). The splicing factor 3b/3a complex binds pre-mRNA upstream of the intron's branch site in a sequence-independent manner and may anchor the U2 snRNP to the pre-mRNA. Splicing factor 3b is also a component of the minor U12-type spliceosome. Subunit 2 associates with pre-mRNA upstream of the branch site at the anchoring site. Subunit 2 also interacts directly with subunit 4 of the splicing factor 3b complex. Subunit 2 is a highly hydrophilic protein with a proline-rich N-terminus and a glutamate-rich stretch in the C-terminus. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13435","text":"Component of the 17S U2 SnRNP complex of the spliceosome, a large ribonucleoprotein complex that removes introns from transcribed pre-mRNAs (PubMed:12234937, PubMed:32494006, PubMed:34822310). The 17S U2 SnRNP complex (1) directly participates in early spliceosome assembly and (2) mediates recognition of the intron branch site during pre-mRNA splicing by promoting the selection of the pre-mRNA branch-site adenosine, the nucleophile for the first step of splicing (PubMed:12234937, PubMed:32494006, PubMed:34822310). Within the 17S U2 SnRNP complex, SF3B2 is part of the SF3B subcomplex, which is required for 'A' complex assembly formed by the stable binding of U2 snRNP to the branchpoint sequence in pre-mRNA (PubMed:12234937, PubMed:27720643). Sequence independent binding of SF3A and SF3B subcomplexes upstream of the branch site is essential, it may anchor U2 snRNP to the pre-mRNA (PubMed:12234937). May also be involved in the assembly of the 'E' complex (PubMed:10882114). Also acts as a component of the minor spliceosome, which is involved in the splicing of U12-type introns in pre-mRNAs (PubMed:15146077, PubMed:33509932)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}