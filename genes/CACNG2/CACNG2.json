ene/CACNG2","cell_types":[{"cell_type":"Ex","gene_symbol":"CACNG2","gene_symbol_current":"CACNG2","gene_id":"ENSG00000166862","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.11541e-05,"nucleus_log2fc":0.158139,"nucleus_score":4.56451,"pct_ad":0.506806,"pct_control":0.492343,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0824368,"donor_lfcse":0.0959949,"donor_log2fc_shrunk":9.31837e-06},{"cell_type":"In","gene_symbol":"CACNG2","gene_symbol_current":"CACNG2","gene_id":"ENSG00000166862","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.458872,"nucleus_log2fc":0.113388,"nucleus_score":1.59161,"pct_ad":0.464951,"pct_control":0.444756,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0911265,"donor_lfcse":0.0902452,"donor_log2fc_shrunk":1.36368e-05},{"cell_type":"OPC","gene_symbol":"CACNG2","gene_symbol_current":"CACNG2","gene_id":"ENSG00000166862","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.638615,"nucleus_log2fc":-0.171332,"nucleus_score":-0.951075,"pct_ad":0.138932,"pct_control":0.150958,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"In","gene_id":"ENSG00000166862","module":"brown","kme":0.218196,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000166862","entrez_id":["10369"],"uniprot":["Q9Y698"],"ncbi_summary":"The protein encoded by this gene is a type I transmembrane AMPA receptor regulatory protein (TARP). TARPs regulate both trafficking and channel gating of the AMPA receptors. The AMPA subtype of ionotropic glutamate receptors are ligand gated ion channels that are typically activated by glutamate released from presynaptic neuron terminals and mediate fast neurotransmission in excitatory synapses. TARPs thus play an important role in synaptic plasticity, learning and memory. Mutations in this gene cause an autosomal dominant form of cognitive disability. [provided by RefSeq, Jul 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y698","text":"Regulates the trafficking and gating properties of AMPA-selective glutamate receptors (AMPARs). Promotes their targeting to the cell membrane and synapses and modulates their gating properties by slowing their rates of activation, deactivation and desensitization. Does not show subunit-specific AMPA receptor regulation and regulates all AMPAR subunits. Thought to stabilize the calcium channel in an inactivated (closed) state."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}