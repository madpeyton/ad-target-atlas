cse":0.0883387,"donor_log2fc_shrunk":0.0164568,"degas_log2fc":-0.0894704,"degas_padj":0.00146943}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000152465","module":"blue","kme":0.017156,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000152465","module":"yellow","kme":0.246582,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000152465","module":"turquoise","kme":0.0967726,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000152465","module":"turquoise","kme":0.0355731,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000152465","entrez_id":["9397"],"uniprot":["O60551"],"ncbi_summary":"This gene encodes one of two N-myristoyltransferase proteins. N-terminal myristoylation is a lipid modification that is involved in regulating the function and localization of signaling proteins. The encoded protein catalyzes the addition of a myristoyl group to the N-terminal glycine residue of many signaling proteins, including the human immunodeficiency virus type 1 (HIV-1) proteins, Gag and Nef. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Apr 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60551","text":"Adds a myristoyl group to the N-terminal glycine residue of certain cellular and viral proteins (PubMed:25255805, PubMed:9506952). Also able to mediate N-terminal lysine myristoylation of proteins: catalyzes myristoylation of ARF6 on both 'Gly-2' and 'Lys-3' (PubMed:32103017). Lysine myristoylation is required to maintain ARF6 on membranes during the GTPase cycle (PubMed:32103017)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}