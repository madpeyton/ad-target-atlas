t":false,"nucleus_direction":"higher in AD","nucleus_padj":0.756157,"nucleus_log2fc":0.0685928,"nucleus_score":0.800794,"pct_ad":0.318545,"pct_control":0.306256,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0344594,"donor_lfcse":0.0941668,"donor_log2fc_shrunk":3.23492e-05},{"cell_type":"Mic","gene_symbol":"BMPR1A","gene_symbol_current":"BMPR1A","gene_id":"ENSG00000107779","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.656344,"nucleus_log2fc":0.21781,"nucleus_score":0.963238,"pct_ad":0.115621,"pct_control":0.0998752,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"BMPR1A","gene_symbol_current":"BMPR1A","gene_id":"ENSG00000107779","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.946199,"nucleus_log2fc":0.0169211,"nucleus_score":-0.167469,"pct_ad":0.240188,"pct_control":0.249042,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":0.128534,"donor_lfcse":0.134931,"donor_log2fc_shrunk":0.00145642},{"cell_type":"Oli","gene_symbol":"BMPR1A","gene_symbol_current":"BMPR1A","gene_id":"ENSG00000107779","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.959548,"donor_log2fc":0.0282126,"donor_lfcse":0.0994648,"donor_log2fc_shrunk":0.00257003}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000107779","module":"yellow","kme":0.197702,"hub":false,"module_direction":"lower in AD","module_padj":0.56571,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000107779","module":"red","kme":0.199501,"hub":false,"module_direction":"lower in AD","module_padj":0.737188,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000107779","module":"tan","kme":0.202417,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000107779","entrez_id":["657"],"uniprot":["P36894"],"ncbi_summary":"The bone morphogenetic protein (BMP) receptors are a family of transmembrane serine/threonine kinases that include the type I receptors BMPR1A and BMPR1B and the type II receptor BMPR2. These receptors are also closely related to the activin receptors, ACVR1 and ACVR2. The ligands of these receptors are members of the TGF-beta superfamily. TGF-betas and activins transduce their signals through the formation of heteromeric complexes with 2 different types of serine (threonine) kinase receptors: type I receptors of about 50-55 kD and type II receptors of about 70-80 kD. Type II receptors bind ligands in the absence of type I receptors, but they require their respective type I receptors for signaling, whereas type I receptors require their respective type II receptors for ligand binding. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P36894","text":"On ligand binding, forms a receptor complex consisting of two type II and two type I transmembrane serine/threonine kinases. Type II receptors phosphorylate and activate type I receptors which autophosphorylate, then bind and activate SMAD transcriptional regulators. Receptor for BMP2, BMP4, GDF5 and GDF6. Positively regulates chondrocyte differentiation through GDF5 interaction. Mediates induction of adipogenesis by GDF6. May promote the expression of HAMP, potentially via its interaction with BMP2 (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}