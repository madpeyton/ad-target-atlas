nt":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000197321","module":"blue","kme":0.158291,"hub":false,"module_direction":"higher in AD","module_padj":0.851077,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000197321","module":"turquoise","kme":0.249188,"hub":false,"module_direction":"lower in AD","module_padj":0.773167,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000197321","module":"brown","kme":0.400989,"hub":false,"module_direction":"lower in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000197321"],"dataset_symbols":["SVIL"],"explorer":"explorer.html?dataset=mathys2019#gene/SVIL","cell_types":[{"cell_type":"Ex","gene_symbol":"SVIL","gene_symbol_current":"SVIL","gene_id":"ENSG00000197321","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0892676,"nucleus_log2fc":-0.0908414,"nucleus_score":-1.90236,"pct_ad":0.110727,"pct_control":0.118759,"donor_test":"not significant","donor_padj":0.986262,"donor_log2fc":0.0960514,"donor_lfcse":0.224287,"donor_log2fc_shrunk":2.02085e-06},{"cell_type":"In","gene_symbol":"SVIL","gene_symbol_current":"SVIL","gene_id":"ENSG00000197321","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.835289,"nucleus_log2fc":0.023472,"nucleus_score":0.589478,"pct_ad":0.152618,"pct_control":0.145347,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0720938,"donor_lfcse":0.163964,"donor_log2fc_shrunk":2.83112e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000197321","module":"black","kme":0.194945,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000197321","module":"blue","kme":0.110147,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000197321","module":"turquoise","kme":0.0978984,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000197321","entrez_id":["6840"],"uniprot":["O95425"],"ncbi_summary":"This gene encodes a bipartite protein with distinct amino- and carboxy-terminal domains. The amino-terminus contains nuclear localization signals and the carboxy-terminus contains numerous consecutive sequences with extensive similarity to proteins in the gelsolin family of actin-binding proteins, which cap, nucleate, and/or sever actin filaments. The gene product is tightly associated with both actin filaments and plasma membranes, suggesting a role as a high-affinity link between the actin cytoskeleton and the membrane. The encoded protein appears to aid in both myosin II assembly during cell spreading and disassembly of focal adhesions. Several transcript variants encoding different isoforms of supervillin have been described. [provided by RefSeq, Apr 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95425","text":"[Isoform 1]: Forms a high-affinity link between the actin cytoskeleton and the membrane. Is among the first costameric proteins to assemble during myogenesis and it contributes to myogenic membrane structure and differentiation (PubMed:12711699). Appears to be involved in myosin II assembly. May modulate myosin II regulation through MLCK during cell spreading, an initial step in cell migration. May play a role in invadopodial function (PubMed:19109420). In addition to its cytoskeletal activities, acts as a cofactor or scaffold for KDM1A, facilitating H3K9me2 demethylation and promoting gene activation, especially in neuronal contexts (PubMed:25684206). [Isoform 2]: May be involved in modulation of focal adhesions. Supervillin-mediated down-regulation of focal adhesions involves binding to TRIP6. Plays a role in cytokinesis through KIF14 interaction (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}