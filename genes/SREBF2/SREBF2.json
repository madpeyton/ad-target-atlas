nucleus_score":-5.30611,"pct_ad":0.695198,"pct_control":0.71177,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.151459,"donor_lfcse":0.0975473,"donor_log2fc_shrunk":-1.64495e-05},{"cell_type":"Oli","gene_symbol":"SREBF2","gene_symbol_current":"SREBF2","gene_id":"ENSG00000198911","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.513824,"nucleus_log2fc":0.00448407,"nucleus_score":0.729509,"pct_ad":0.652359,"pct_control":0.660082,"donor_test":"not significant","donor_padj":0.931213,"donor_log2fc":0.062451,"donor_lfcse":0.113871,"donor_log2fc_shrunk":0.00799868}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000198911","module":"turquoise","kme":0.0395789,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000198911","module":"black","kme":0.178988,"hub":false,"module_direction":"lower in AD","module_padj":0.663532,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000198911","module":"blue","kme":0.197131,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198911","entrez_id":["6721"],"uniprot":["Q12772"],"ncbi_summary":"This gene encodes a member of the a ubiquitously expressed transcription factor that controls cholesterol homeostasis by regulating transcription of sterol-regulated genes. The encoded protein contains a basic helix-loop-helix-leucine zipper (bHLH-Zip) domain and binds the sterol regulatory element 1 motif. Alternate splicing results in multiple transcript variants. [provided by RefSeq, Jul 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q12772","text":"[Sterol regulatory element-binding protein 2]: Precursor of the transcription factor form (Processed sterol regulatory element-binding protein 2), which is embedded in the endoplasmic reticulum membrane (PubMed:32322062). Low sterol concentrations promote processing of this form, releasing the transcription factor form that translocates into the nucleus and activates transcription of genes involved in cholesterol biosynthesis (PubMed:32322062). [Processed sterol regulatory element-binding protein 2]: Key transcription factor that regulates expression of genes involved in cholesterol biosynthesis (PubMed:12177166, PubMed:32322062). Binds to the sterol regulatory element 1 (SRE-1) (5'-ATCACCCCAC-3'). Has dual sequence specificity binding to both an E-box motif (5'-ATCACGTGA-3') and to SRE-1 (5'-ATCACCCCAC-3') (PubMed:12177166, PubMed:7903453). Regulates transcription of genes related to cholesterol synthesis pathway (PubMed:12177166, PubMed:32322062)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}