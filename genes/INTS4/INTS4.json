":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000149262"],"dataset_symbols":["INTS4"],"explorer":"explorer.html?dataset=mathys2019#gene/INTS4","cell_types":[{"cell_type":"Ex","gene_symbol":"INTS4","gene_symbol_current":"INTS4","gene_id":"ENSG00000149262","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.134231,"nucleus_log2fc":-0.0440795,"nucleus_score":-1.69005,"pct_ad":0.184681,"pct_control":0.19397,"donor_test":"not significant","donor_padj":0.990954,"donor_log2fc":-0.0254784,"donor_lfcse":0.0762938,"donor_log2fc_shrunk":-6.58701e-06},{"cell_type":"In","gene_symbol":"INTS4","gene_symbol_current":"INTS4","gene_id":"ENSG00000149262","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.941818,"nucleus_log2fc":-0.00145204,"nucleus_score":0.24868,"pct_ad":0.142857,"pct_control":0.139122,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0452973,"donor_lfcse":0.137262,"donor_log2fc_shrunk":-7.00341e-07},{"cell_type":"Oli","gene_symbol":"INTS4","gene_symbol_current":"INTS4","gene_id":"ENSG00000149262","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.786401,"donor_log2fc":0.174539,"donor_lfcse":0.13296,"donor_log2fc_shrunk":0.00956088}],"modules":[{"cell_type":"In","gene_id":"ENSG00000149262","module":"blue","kme":0.0906986,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000149262","module":"grey60","kme":0.156525,"hub":false,"module_direction":"lower in AD","module_padj":0.817457,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000149262","entrez_id":["92105"],"uniprot":["Q96HW7"],"ncbi_summary":"INTS4 is a subunit of the Integrator complex, which associates with the C-terminal domain of RNA polymerase II large subunit (POLR2A; MIM 180660) and mediates 3-prime end processing of small nuclear RNAs U1 (RNU1; MIM 180680) and U2 (RNU2; MIM 180690) (Baillat et al., 2005 [PubMed 16239144]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96HW7","text":"Component of the integrator complex, a multiprotein complex that terminates RNA polymerase II (Pol II) transcription in the promoter-proximal region of genes (PubMed:29471365, PubMed:33243860, PubMed:33548203, PubMed:38570683). The integrator complex provides a quality checkpoint during transcription elongation by driving premature transcription termination of transcripts that are unfavorably configured for transcriptional elongation: the complex terminates transcription by (1) catalyzing dephosphorylation of the C-terminal domain (CTD) of Pol II subunit POLR2A/RPB1 and SUPT5H/SPT5, (2) degrading the exiting nascent RNA transcript via endonuclease activity and (3) promoting the release of Pol II from bound DNA (PubMed:33243860, PubMed:38570683). The integrator complex is also involved in terminating the synthesis of non-coding Pol II transcripts, such as enhancer RNAs (eRNAs), small nuclear RNAs (snRNAs), telomerase RNAs and long non-coding RNAs (lncRNAs) (PubMed:16239144). Within the integrator complex, INTS4 acts as an scaffold that links INTS9 and INTS11 (PubMed:29471365, PubMed:33548203). Mediates recruitment of cytoplasmic dynein to the nuclear envelope, probably as component of the integrator complex (PubMed:23904267)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}