23,"pct_control":0.197701,"donor_test":"not significant","donor_padj":0.99309,"donor_log2fc":0.0678422,"donor_lfcse":0.143438,"donor_log2fc_shrunk":0.000676122},{"cell_type":"Oli","gene_symbol":"TOP2B","gene_symbol_current":"TOP2B","gene_id":"ENSG00000077097","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.302343,"nucleus_log2fc":0.0617934,"nucleus_score":1.2708,"pct_ad":0.104943,"pct_control":0.0986095,"donor_test":"not significant","donor_padj":0.966005,"donor_log2fc":0.0175449,"donor_lfcse":0.0775798,"donor_log2fc_shrunk":0.00244358}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000077097","module":"green","kme":0.122427,"hub":false,"module_direction":"lower in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000077097","module":"green","kme":0.176236,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000077097","entrez_id":["7155"],"uniprot":["Q02880"],"ncbi_summary":"This gene encodes a DNA topoisomerase, an enzyme that controls and alters the topologic states of DNA during transcription. This nuclear enzyme is involved in processes such as chromosome condensation, chromatid separation, and the relief of torsional stress that occurs during DNA transcription and replication. It catalyzes the transient breaking and rejoining of two strands of duplex DNA which allows the strands to pass through one another, thus altering the topology of DNA. Two forms of this enzyme exist as likely products of a gene duplication event. The gene encoding this form, beta, is localized to chromosome 3 and the alpha form is localized to chromosome 17. The gene encoding this enzyme functions as the target for several anticancer agents and a variety of mutations in this gene have been associated with the development of drug resistance. Reduced activity of this enzyme may also play a role in ataxia-telangiectasia. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q02880","text":"Key decatenating enzyme that alters DNA topology by binding to two double-stranded DNA molecules, generating a double-stranded break in one of the strands, passing the intact strand through the broken strand, and religating the broken strand. Plays a role in B-cell differentiation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}