fcse":0.191799,"donor_log2fc_shrunk":8.38613e-06},{"cell_type":"Oli","gene_symbol":"PROX1","gene_symbol_current":"PROX1","gene_id":"ENSG00000117707","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.299198,"nucleus_log2fc":-0.110557,"nucleus_score":-1.27908,"pct_ad":0.0968359,"pct_control":0.102325,"donor_test":"not significant","donor_padj":0.754681,"donor_log2fc":-0.151179,"donor_lfcse":0.0891285,"donor_log2fc_shrunk":-0.0193482}],"modules":[{"cell_type":"In","gene_id":"ENSG00000117707","module":"blue","kme":0.484866,"hub":true,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000117707","entrez_id":["5629"],"uniprot":["Q92786"],"ncbi_summary":"The protein encoded by this gene is a member of the homeobox transcription factor family. Members of this family contain a homeobox domain that consists of a 60-amino acid helix-turn-helix structure that binds DNA and RNA. The protein encoded by this gene is conserved across vertebrates and may play an essential role during development. Altered levels of this protein have been reported in cancers of different organs, such as colon, brain, blood, breast, pancreas, liver and esophagus. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jul 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92786","text":"Transcription factor involved in developmental processes such as cell fate determination, gene transcriptional regulation and progenitor cell regulation in a number of organs. Plays a critical role in embryonic development and functions as a key regulatory protein in neurogenesis and the development of the heart, eye lens, liver, pancreas and the lymphatic system. Involved in the regulation of the circadian rhythm. Represses: transcription of the retinoid-related orphan receptor RORG, transcriptional activator activity of RORA and RORG and the expression of RORA/G-target genes including core clock components: BMAL1, NPAS2 and CRY1 and metabolic genes: AVPR1A and ELOVL3."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}