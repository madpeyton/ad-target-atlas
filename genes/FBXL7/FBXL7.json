_log2fc":-0.0223346,"donor_lfcse":0.118399,"donor_log2fc_shrunk":-1.62535e-06},{"cell_type":"Oli","gene_symbol":"FBXL7","gene_symbol_current":"FBXL7","gene_id":"ENSG00000183580","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":4.57543e-11,"nucleus_log2fc":0.0693635,"nucleus_score":6.7427,"pct_ad":0.86854,"pct_control":0.866921,"donor_test":"not significant","donor_padj":0.98666,"donor_log2fc":0.012361,"donor_lfcse":0.118794,"donor_log2fc_shrunk":0.000923509}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000183580","module":"cyan","kme":0.411528,"hub":true,"module_direction":"lower in AD","module_padj":1.0,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000183580","module":"yellow","kme":0.893005,"hub":true,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000183580","module":"turquoise","kme":0.163017,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000183580","module":"blue","kme":0.22394,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000183580","entrez_id":["23194"],"uniprot":["Q9UJT9"],"ncbi_summary":"This gene encodes a member of the F-box protein family which is characterized by a 42-48 amino acid motif, the F-box, which binds to the S-phase kinase-associated protein 1 (Skp1) protein. The F-box proteins constitute one of the four subunits of E3 ubiquitin protein ligases called SCFs (SKP1-Cul1-F-box), which play a role in phosphorylation-dependent ubiquitination of proteins. The F-box proteins are divided into 3 subfamilies based on the other domain in the protein: F-box proteins that also have a WD-40 domain (Fbws subfamily), F-box proteins that also have leucine-rich repeats (Fbls subfamily) and F-box proteins that contain other motifs or lack known protein-interaction domains (Fbxs subfamily). The protein encoded by this gene belongs to the Fbls subfamily. Alternative splicing results in multiple transcript variants of this gene. [provided by RefSeq, May 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UJT9","text":"Substrate recognition component of a SCF (SKP1-CUL1-F-box protein) E3 ubiquitin-protein ligase complex (PubMed:25778398). During mitosis, it mediates the ubiquitination and subsequent proteasomal degradation of AURKA, causing mitotic arrest (By similarity). It also regulates mitochondrial function by mediating the ubiquitination and proteasomal degradation of the apoptosis inhibitor BIRC5 (PubMed:25778398, PubMed:28218735)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}