":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.783318,"donor_log2fc":0.131002,"donor_lfcse":0.0996936,"donor_log2fc_shrunk":0.0138728,"degas_log2fc":-0.20347,"degas_padj":5.73882e-07}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000147655","module":"blue","kme":0.0991699,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000147655","module":"magenta","kme":0.681288,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000147655","module":"turquoise","kme":0.116665,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000147655","entrez_id":["340419"],"uniprot":["Q6UXX9"],"ncbi_summary":"This gene encodes a member of the R-spondin family of proteins. These proteins are secreted ligands of leucine-rich repeat containing G protein-coupled receptors that enhance Wnt signaling through the inhibition of ubiquitin E3 ligases. A chromosomal translocation including this locus that results in the formation of a gene fusion has been identified in multiple human cancers. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Dec 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6UXX9","text":"Activator of the canonical Wnt signaling pathway by acting as a ligand for LGR4-6 receptors. Upon binding to LGR4-6 (LGR4, LGR5 or LGR6), LGR4-6 associate with phosphorylated LRP6 and frizzled receptors that are activated by extracellular Wnt receptors, triggering the canonical Wnt signaling pathway to increase expression of target genes. Also regulates the canonical Wnt/beta-catenin-dependent pathway and non-canonical Wnt signaling by acting as an inhibitor of ZNRF3, an important regulator of the Wnt signaling pathway (PubMed:21727895, PubMed:21909076, PubMed:22615920). During embryonic development, plays a crucial role in limb specification, amplifying the Wnt signaling pathway independently of LGR4-6 receptors, possibly by acting as a direct antagonistic ligand to RNF43 and ZNRF3, hence governing the number of limbs an embryo should form (PubMed:29769720)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}