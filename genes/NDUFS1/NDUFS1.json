re":0.456905,"pct_ad":0.577244,"pct_control":0.571211,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.023847,"donor_lfcse":0.0564309,"donor_log2fc_shrunk":7.81049e-06,"degas_log2fc":-0.2205,"degas_padj":1.27821e-10},{"cell_type":"Oli","gene_symbol":"NDUFS1","gene_symbol_current":"NDUFS1","gene_id":"ENSG00000023228","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.995351,"nucleus_log2fc":0.00308653,"nucleus_score":-0.00702852,"pct_ad":0.453508,"pct_control":0.456249,"donor_test":"not significant","donor_padj":0.970861,"donor_log2fc":0.018645,"donor_lfcse":0.0685628,"donor_log2fc_shrunk":0.000693448,"degas_log2fc":-0.13198,"degas_padj":1.29879e-14}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000023228","module":"brown","kme":0.186087,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000023228","module":"tan","kme":0.293671,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000023228","entrez_id":["4719"],"uniprot":["P28331"],"ncbi_summary":"The protein encoded by this gene belongs to the complex I 75 kDa subunit family. Mammalian complex I is composed of 45 different subunits. It locates at the mitochondrial inner membrane. This protein has NADH dehydrogenase activity and oxidoreductase activity. It transfers electrons from NADH to the respiratory chain. The immediate electron acceptor for the enzyme is believed to be ubiquinone. This protein is the largest subunit of complex I and it is a component of the iron-sulfur (IP) fragment of the enzyme. It may form part of the active site crevice where NADH is oxidized. Mutations in this gene are associated with complex I deficiency. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jan 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P28331","text":"Core subunit of the mitochondrial membrane respiratory chain NADH dehydrogenase (Complex I) which catalyzes electron transfer from NADH through the respiratory chain, using ubiquinone as an electron acceptor (PubMed:30879903, PubMed:31557978). Essential for catalysing the entry and efficient transfer of electrons within complex I (PubMed:31557978). Plays a key role in the assembly and stability of complex I and participates in the association of complex I with ubiquinol-cytochrome reductase complex (Complex III) to form supercomplexes (PubMed:30879903, PubMed:31557978)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}