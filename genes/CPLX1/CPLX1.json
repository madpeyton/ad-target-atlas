leus_score":-0.226295,"pct_ad":0.417036,"pct_control":0.421102,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0936345,"donor_lfcse":0.177562,"donor_log2fc_shrunk":-3.10777e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000168993","module":"brown","kme":0.198788,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000168993","module":"brown","kme":0.601299,"hub":true,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000168993","entrez_id":["10815"],"uniprot":["O14810"],"ncbi_summary":"Proteins encoded by the complexin/synaphin gene family are cytosolic proteins that function in synaptic vesicle exocytosis. These proteins bind syntaxin, part of the SNAP receptor.  The protein product of this gene binds to the SNAP receptor complex and disrupts it, allowing transmitter release. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O14810","text":"Positively regulates a late step in exocytosis of various cytoplasmic vesicles, such as synaptic vesicles and other secretory vesicles (PubMed:21785414). Organizes the SNAREs into a cross-linked zigzag topology that, when interposed between the vesicle and plasma membranes, is incompatible with fusion, thereby preventing SNAREs from releasing neurotransmitters until an action potential arrives at the synapse (PubMed:21785414). Also involved in glucose-induced secretion of insulin by pancreatic beta-cells. Essential for motor behavior."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}