,"gene_symbol":"DPF1","gene_symbol_current":"DPF1","gene_id":"ENSG00000011332","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0818231,"nucleus_log2fc":0.099554,"nucleus_score":2.1781,"pct_ad":0.26618,"pct_control":0.248772,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0973242,"donor_lfcse":0.0968982,"donor_log2fc_shrunk":1.06303e-05,"degas_log2fc":-0.236991,"degas_padj":2.61741e-05},{"cell_type":"Oli","gene_symbol":"DPF1","gene_symbol_current":"DPF1","gene_id":"ENSG00000011332","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.912422,"donor_log2fc":0.0899452,"donor_lfcse":0.130115,"donor_log2fc_shrunk":0.0056218,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000011332","module":"blue","kme":0.0664539,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000011332","module":"blue","kme":0.139236,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000011332","module":"blue","kme":0.0717465,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000011332","entrez_id":["8193"],"uniprot":["Q92782"],"ncbi_summary":"Enables sequence-specific double-stranded DNA binding activity. Predicted to be involved in negative regulation of transcription, DNA-templated; nervous system development; and positive regulation of transcription by RNA polymerase II. Predicted to be located in cytoplasm. Predicted to be part of nBAF complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92782","text":"May have an important role in developing neurons by participating in regulation of cell survival, possibly as a neurospecific transcription factor. Belongs to the neuron-specific chromatin remodeling complex (nBAF complex). During neural development a switch from a stem/progenitor to a postmitotic chromatin remodeling mechanism occurs as neurons exit the cell cycle and become committed to their adult state. The transition from proliferating neural stem/progenitor cells to postmitotic neurons requires a switch in subunit composition of the npBAF and nBAF complexes. As neural progenitors exit mitosis and differentiate into neurons, npBAF complexes which contain ACTL6A/BAF53A and PHF10/BAF45A, are exchanged for homologous alternative ACTL6B/BAF53B and DPF1/BAF45B or DPF3/BAF45C subunits in neuron-specific complexes (nBAF). The npBAF complex is essential for the self-renewal/proliferative capacity of the multipotent neural stem cells. The nBAF complex along with CREST plays a role regulating the activity of genes essential for dendrite growth (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}