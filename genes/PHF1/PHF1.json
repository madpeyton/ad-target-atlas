4,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000112511"],"dataset_symbols":["PHF1"],"explorer":"explorer.html?dataset=mathys2019#gene/PHF1","cell_types":[{"cell_type":"Ex","gene_symbol":"PHF1","gene_symbol_current":"PHF1","gene_id":"ENSG00000112511","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.195372,"nucleus_log2fc":0.103584,"nucleus_score":1.47189,"pct_ad":0.231613,"pct_control":0.225794,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.132487,"donor_lfcse":0.0728939,"donor_log2fc_shrunk":2.57325e-05},{"cell_type":"In","gene_symbol":"PHF1","gene_symbol_current":"PHF1","gene_id":"ENSG00000112511","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.747252,"nucleus_log2fc":0.033362,"nucleus_score":0.827957,"pct_ad":0.197427,"pct_control":0.185185,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0665635,"donor_lfcse":0.121033,"donor_log2fc_shrunk":-4.62512e-06},{"cell_type":"Oli","gene_symbol":"PHF1","gene_symbol_current":"PHF1","gene_id":"ENSG00000112511","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.754681,"donor_log2fc":0.299576,"donor_lfcse":0.172073,"donor_log2fc_shrunk":0.0100373}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000112511","entrez_id":["5252"],"uniprot":["O43189"],"ncbi_summary":"This gene encodes a Polycomb group protein. The protein is a component of a histone H3 lysine-27 (H3K27)-specific methyltransferase complex, and functions in transcriptional repression of homeotic genes. The protein is also recruited to double-strand breaks, and reduced protein levels results in X-ray sensitivity and increased homologous recombination. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, May 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43189","text":"Polycomb group (PcG) that specifically binds histone H3 trimethylated at 'Lys-36' (H3K36me3) and recruits the PRC2 complex. Involved in DNA damage response and is recruited at double-strand breaks (DSBs). Acts by binding to H3K36me3, a mark for transcriptional activation, and recruiting the PRC2 complex: it is however unclear whether recruitment of the PRC2 complex to H3K36me3 leads to enhance or inhibit H3K27me3 methylation mediated by the PRC2 complex. According to some reports, PRC2 recruitment by PHF1 promotes H3K27me3 and subsequent gene silencing by inducing spreading of PRC2 and H3K27me3 into H3K36me3 loci (PubMed:18285464, PubMed:23273982). According to another report, PHF1 recruits the PRC2 complex at double-strand breaks (DSBs) and inhibits the activity of PRC2 (PubMed:23142980). Regulates p53/TP53 stability and prolonges its turnover: may act by specifically binding to a methylated from of p53/TP53."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}