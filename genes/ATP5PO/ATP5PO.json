onor_log2fc":-0.0114247,"donor_lfcse":0.131384,"donor_log2fc_shrunk":-6.55054e-07,"degas_log2fc":0.350863,"degas_padj":6.36995e-08},{"cell_type":"Oli","gene_symbol":"ATP5PO","gene_symbol_current":"ATP5PO","gene_id":"ENSG00000241837","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00116917,"nucleus_log2fc":-0.103178,"nucleus_score":-3.38899,"pct_ad":0.129351,"pct_control":0.138024,"donor_test":"not significant","donor_padj":0.983446,"donor_log2fc":0.0192593,"donor_lfcse":0.134494,"donor_log2fc_shrunk":0.0011855,"degas_log2fc":0.0516572,"degas_padj":0.120858}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000241837","module":"turquoise","kme":0.102067,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000241837","module":"brown","kme":0.343862,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000241837","module":"turquoise","kme":0.306971,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000241837","module":"turquoise","kme":0.122393,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000241837","module":"turquoise","kme":0.137151,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000241837","entrez_id":["539"],"uniprot":["P48047"],"ncbi_summary":"The protein encoded by this gene is a component of the F-type ATPase found in the mitochondrial matrix. F-type ATPases are composed of a catalytic core and a membrane proton channel. The encoded protein appears to be part of the connector linking these two components and may be involved in transmission of conformational changes or proton conductance. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P48047","text":"Subunit OSCP, of the mitochondrial membrane ATP synthase complex (F(1)F(0) ATP synthase or Complex V) that produces ATP from ADP in the presence of a proton gradient across the membrane which is generated by electron transport complexes of the respiratory chain (PubMed:37244256). ATP synthase complex consist of a soluble F(1) head domain - the catalytic core - and a membrane F(1) domain - the membrane proton channel (PubMed:37244256). These two domains are linked by a central stalk rotating inside the F(1) region and a stationary peripheral stalk (PubMed:37244256). During catalysis, ATP synthesis in the catalytic domain of F(1) is coupled via a rotary mechanism of the central stalk subunits to proton translocation (Probable). In vivo, can only synthesize ATP although its ATP hydrolase activity can be activated artificially in vitro (By similarity). Part of the complex F(0) domain (PubMed:37244256). Part of the complex F(0) domain and the peripheric stalk, which acts as a stator to hold the catalytic alpha(3)beta(3) subcomplex and subunit a/ATP6 static relative to the rotary elements (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}