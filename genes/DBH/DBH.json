ction":[{"accession":"P09172","text":"Catalyzes the hydroxylation of dopamine to noradrenaline (also known as norepinephrine), and is thus vital for regulation of these neurotransmitters."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}