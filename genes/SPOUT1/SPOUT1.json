,"gene_symbol_current":"SPOUT1","gene_id":"ENSG00000198917","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.118283,"donor_lfcse":0.110546,"donor_log2fc_shrunk":9.96551e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198917","entrez_id":["51490"],"uniprot":["Q5T280"],"ncbi_summary":"Enables miRNA binding activity. Involved in maintenance of centrosome location and production of miRNAs involved in gene silencing by miRNA. Located in kinetochore; mitotic spindle; and spindle pole centrosome. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5T280","text":"S-adenosyl-L-methionine-dependent RNA methyltransferase (PubMed:39671501, PubMed:39962046). Specifically methylates the N3 position of a uridine in 28S rRNA (PubMed:39671501). Required for association of the centrosomes with the poles of the bipolar mitotic spindle during metaphase, ensuring proper spindle organization (PubMed:20813266, PubMed:25657325, PubMed:39962046). Also involved in chromosome alignment (PubMed:20813266). May promote centrosome maturation probably by recruiting A-kinase anchor protein AKAP9 to centrosomes in early mitosis (PubMed:25657325). Binds specifically to miRNA MIR145 hairpin, regulates MIR145 expression at a postranscriptional level (PubMed:28431233)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}