33","module":"yellow","kme":0.204353,"hub":false,"module_direction":"lower in AD","module_padj":0.642666,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000165533","module":"yellow","kme":0.173163,"hub":false,"module_direction":"lower in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000165533","module":"turquoise","kme":0.198193,"hub":false,"module_direction":"lower in AD","module_padj":0.773167,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000165533"],"dataset_symbols":["TTC8"],"explorer":"explorer.html?dataset=mathys2019#gene/TTC8","cell_types":[{"cell_type":"Ex","gene_symbol":"TTC8","gene_symbol_current":"TTC8","gene_id":"ENSG00000165533","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.76354e-17,"nucleus_log2fc":-0.295565,"nucleus_score":-8.80484,"pct_ad":0.271638,"pct_control":0.327724,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.205242,"donor_lfcse":0.14105,"donor_log2fc_shrunk":-1.07758e-05},{"cell_type":"In","gene_symbol":"TTC8","gene_symbol_current":"TTC8","gene_id":"ENSG00000165533","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.97359,"nucleus_log2fc":-0.00265986,"nucleus_score":0.0996123,"pct_ad":0.172138,"pct_control":0.169623,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.00764531,"donor_lfcse":0.136598,"donor_log2fc_shrunk":1.61011e-07},{"cell_type":"OPC","gene_symbol":"TTC8","gene_symbol_current":"TTC8","gene_id":"ENSG00000165533","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.588578,"nucleus_log2fc":-0.149498,"nucleus_score":-1.06522,"pct_ad":0.110675,"pct_control":0.12567,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000165533","module":"blue","kme":0.17761,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000165533","module":"black","kme":0.152578,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165533","entrez_id":["123016"],"uniprot":["Q8TAM2"],"ncbi_summary":"This gene encodes a protein that has been directly linked to Bardet-Biedl syndrome. The primary features of this syndrome include retinal dystrophy, obesity, polydactyly, renal abnormalities and learning disabilities. Experimentation in non-human eukaryotes suggests that this gene is expressed in ciliated cells and that it is involved in the formation of cilia. A mutation in this gene has also been implicated in nonsyndromic retinitis pigmentosa. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jan 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TAM2","text":"The BBSome complex is thought to function as a coat complex required for sorting of specific membrane proteins to the primary cilia. The BBSome complex is required for ciliogenesis but is dispensable for centriolar satellite function. This ciliogenic function is mediated in part by the Rab8 GDP/GTP exchange factor, which localizes to the basal body and contacts the BBSome. Rab8(GTP) enters the primary cilium and promotes extension of the ciliary membrane. Firstly the BBSome associates with the ciliary membrane and binds to RAB3IP/Rabin8, the guanosyl exchange factor (GEF) for Rab8 and then the Rab8-GTP localizes to the cilium and promotes docking and fusion of carrier vesicles to the base of the ciliary membrane. The BBSome complex, together with the LTZL1, controls SMO ciliary trafficking and contributes to the sonic hedgehog (SHH) pathway regulation. Required for proper BBSome complex assembly and its ciliary localization."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}