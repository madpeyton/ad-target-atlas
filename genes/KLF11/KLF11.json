modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000172059","entrez_id":["8462"],"uniprot":["O14901"],"ncbi_summary":"The protein encoded by this gene is a zinc finger transcription factor that binds to SP1-like sequences in epsilon- and gamma-globin gene promoters. This binding inhibits cell growth and causes apoptosis. Defects in this gene are a cause of maturity-onset diabetes of the young type 7 (MODY7). Three transcript variants encoding two different isoforms have been found for this gene. [provided by RefSeq, Apr 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O14901","text":"Transcription factor (PubMed:10207080, PubMed:9748269). Activates the epsilon- and gamma-globin gene promoters and, to a much lower degree, the beta-globin gene and represses promoters containing SP1-like binding inhibiting cell growth (PubMed:10207080, PubMed:16131492, PubMed:9748269). Represses transcription of SMAD7 which enhances TGF-beta signaling (By similarity). Induces apoptosis (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}