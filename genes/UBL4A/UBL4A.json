ull,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0591003,"donor_lfcse":0.201294,"donor_log2fc_shrunk":1.49283e-06},{"cell_type":"Oli","gene_symbol":"UBL4A","gene_symbol_current":"UBL4A","gene_id":"ENSG00000102178","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.815477,"donor_log2fc":0.158555,"donor_lfcse":0.136062,"donor_log2fc_shrunk":0.00950016}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000102178","module":"brown","kme":0.263942,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000102178","entrez_id":["8266"],"uniprot":["P11441"],"ncbi_summary":"Enables chaperone binding activity. Involved in tail-anchored membrane protein insertion into ER membrane. Located in cytosol; membrane; and nucleoplasm. Part of BAT3 complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P11441","text":"As part of a cytosolic protein quality control complex, the BAG6/BAT3 complex, maintains misfolded and hydrophobic patches-containing proteins in a soluble state and participates in their proper delivery to the endoplasmic reticulum or alternatively can promote their sorting to the proteasome where they undergo degradation (PubMed:20676083, PubMed:21636303, PubMed:21743475, PubMed:28104892). The BAG6/BAT3 complex is involved in the post-translational delivery of tail-anchored/type II transmembrane proteins to the endoplasmic reticulum membrane. Recruited to ribosomes, it interacts with the transmembrane region of newly synthesized tail-anchored proteins and together with SGTA and ASNA1 mediates their delivery to the endoplasmic reticulum (PubMed:20676083, PubMed:25535373, PubMed:28104892). Client proteins that cannot be properly delivered to the endoplasmic reticulum are ubiquitinated and sorted to the proteasome (PubMed:28104892). Similarly, the BAG6/BAT3 complex also functions as a sorting platform for proteins of the secretory pathway that are mislocalized to the cytosol either delivering them to the proteasome for degradation or to the endoplasmic reticulum (PubMed:21743475). The BAG6/BAT3 complex also plays a role in the endoplasmic reticulum-associated degradation (ERAD), a quality control mechanism that eliminates unwanted proteins of the endoplasmic reticulum through their retrotranslocation to the cytosol and their targeting to the proteasome. It maintains these retrotranslocated proteins in an unfolded yet soluble state condition in the cytosol to ensure their proper delivery to the proteasome (PubMed:21636303)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}