17,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000140474"],"dataset_symbols":["ULK3"],"explorer":"explorer.html?dataset=mathys2019#gene/ULK3","cell_types":[{"cell_type":"Ex","gene_symbol":"ULK3","gene_symbol_current":"ULK3","gene_id":"ENSG00000140474","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.805113,"nucleus_log2fc":0.0226923,"nucleus_score":-0.312356,"pct_ad":0.325782,"pct_control":0.334104,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0874537,"donor_lfcse":0.0874868,"donor_log2fc_shrunk":1.18825e-05},{"cell_type":"In","gene_symbol":"ULK3","gene_symbol_current":"ULK3","gene_id":"ENSG00000140474","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.957616,"nucleus_log2fc":-0.000769829,"nucleus_score":-0.168588,"pct_ad":0.181012,"pct_control":0.182073,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0465238,"donor_lfcse":0.154193,"donor_log2fc_shrunk":-2.02222e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000140474","entrez_id":["25989"],"uniprot":["Q6PHR2"],"ncbi_summary":"Enables protein serine/threonine kinase activity. Involved in several processes, including fibroblast activation; protein autophosphorylation; and regulation of smoothened signaling pathway. Located in cytoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6PHR2","text":"Serine/threonine protein kinase that acts as a regulator of smoothened signaling and autophagy (PubMed:19279323, PubMed:19878745, PubMed:20643644, PubMed:31279575). Acts as a positive regulator of smoothened signaling in the presence of hedgehog (DHH, IHH or SHH) ligand: autophosphorylates and mediates phosphorylation of full-length GLI2, promoting subsequent phosphorylation by CDK1 and GLI2 dissociation from SUFU and translocation to the nucleus (PubMed:19878745, PubMed:20643644, PubMed:31279575). Also phosphorylates as GLI1 and GLI3, although less efficiently (PubMed:19878745, PubMed:20643644). In the absence of hedgehog ligand, interacts with SUFU, thereby inactivating the protein kinase activity and preventing phosphorylation of GLI proteins (GLI1, GLI2 and/or GLI3) (PubMed:20643644). Also acts as a regulator of autophagy: following cellular senescence, able to induce autophagy (PubMed:19279323)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}