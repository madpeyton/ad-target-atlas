0.0913671,"donor_log2fc_shrunk":9.03858e-07},{"cell_type":"OPC","gene_symbol":"BBS9","gene_symbol_current":"BBS9","gene_id":"ENSG00000122507","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.533146,"nucleus_log2fc":-0.112602,"nucleus_score":-1.20033,"pct_ad":0.321036,"pct_control":0.342529,"donor_test":"not significant","donor_padj":0.986209,"donor_log2fc":-0.0593562,"donor_lfcse":0.109184,"donor_log2fc_shrunk":-0.00100609},{"cell_type":"Oli","gene_symbol":"BBS9","gene_symbol_current":"BBS9","gene_id":"ENSG00000122507","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.511723,"nucleus_log2fc":0.0353161,"nucleus_score":0.847449,"pct_ad":0.219682,"pct_control":0.21261,"donor_test":"not significant","donor_padj":0.968885,"donor_log2fc":-0.0252107,"donor_lfcse":0.125279,"donor_log2fc_shrunk":-0.00146237}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000122507","module":"cyan","kme":0.211694,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000122507","entrez_id":["27241"],"uniprot":["Q3SYG4"],"ncbi_summary":"This gene is downregulated by parathyroid hormone in osteoblastic cells, and therefore is thought to be involved in parathyroid hormone action in bones. The exact function of this gene has not yet been determined. Alternatively spliced transcript variants encoding different isoforms have been identified. [provided by RefSeq, Jan 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q3SYG4","text":"The BBSome complex is thought to function as a coat complex required for sorting of specific membrane proteins to the primary cilia. The BBSome complex is required for ciliogenesis but is dispensable for centriolar satellite function. This ciliogenic function is mediated in part by the Rab8 GDP/GTP exchange factor, which localizes to the basal body and contacts the BBSome. Rab8(GTP) enters the primary cilium and promotes extension of the ciliary membrane. Firstly the BBSome associates with the ciliary membrane and binds to RAB3IP/Rabin8, the guanosyl exchange factor (GEF) for Rab8 and then the Rab8-GTP localizes to the cilium and promotes docking and fusion of carrier vesicles to the base of the ciliary membrane. Required for proper BBSome complex assembly and its ciliary localization."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}