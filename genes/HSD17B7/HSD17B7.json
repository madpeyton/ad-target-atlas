7B7","gene_symbol_current":"HSD17B7","gene_id":"ENSG00000132196","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.5325e-05,"nucleus_log2fc":-0.270546,"nucleus_score":-4.63884,"pct_ad":0.117229,"pct_control":0.137422,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0668476,"donor_lfcse":0.101481,"donor_log2fc_shrunk":-3.81807e-06},{"cell_type":"OPC","gene_symbol":"HSD17B7","gene_symbol_current":"HSD17B7","gene_id":"ENSG00000132196","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.52769,"nucleus_log2fc":-0.175739,"nucleus_score":-1.21367,"pct_ad":0.0965463,"pct_control":0.111877,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"HSD17B7","gene_symbol_current":"HSD17B7","gene_id":"ENSG00000132196","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.875193,"donor_log2fc":0.129485,"donor_lfcse":0.155615,"donor_log2fc_shrunk":0.00507686}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000132196","module":"yellow","kme":0.105738,"hub":false,"module_direction":"lower in AD","module_padj":0.56571,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000132196","module":"turquoise","kme":0.152242,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000132196","entrez_id":["51478"],"uniprot":["P56937"],"ncbi_summary":"HSD17B7 encodes an enzyme that functions both as a 17-beta-hydroxysteroid dehydrogenase (EC 1.1.1.62) in the biosynthesis of sex steroids and as a 3-ketosteroid reductase (EC 1.1.1.270) in the biosynthesis of cholesterol (Marijanovic et al., 2003 [PubMed 12829805]).[supplied by OMIM, May 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P56937","text":"Bifunctional enzyme involved in steroid-hormone metabolism and cholesterol biosynthesis (PubMed:11165030, PubMed:12574203, PubMed:12732193, PubMed:12829805, PubMed:19772289, PubMed:20659585). Catalyzes the NADP(H)-dependent reduction of estrogens and androgens and regulates the biological potency of these steroids. Converts estrone (E1) to a more potent estrogen, 17beta-estradiol (E2) (PubMed:12574203, PubMed:12732193, PubMed:19772289). Converts dihydrotestosterone (DHT) to its inactive form 5a-androstane-3b,17b-diol (PubMed:12574203, PubMed:12732193, PubMed:19772289). Converts moderately progesterone to 3beta-hydroxypregn-4-ene-20-one, leading to its inactivation (PubMed:12574203, PubMed:12732193). Additionally, participates in the post-squalene cholesterol biosynthesis, as a 3-ketosteroid reductase (PubMed:11165030, PubMed:12829805, PubMed:20659585). [Isoform 3]: Does not have enzymatic activities toward E1 and DHT."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}