_log2fc_shrunk":-0.00367933,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Ex","gene_symbol":"EPHB3","gene_symbol_current":"EPHB3","gene_id":"ENSG00000182580","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.74981,"donor_log2fc":-0.168053,"donor_lfcse":0.16681,"donor_log2fc_shrunk":-0.00565124,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"EPHB3","gene_symbol_current":"EPHB3","gene_id":"ENSG00000182580","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.63052e-15,"nucleus_log2fc":-0.126832,"nucleus_score":-8.07206,"pct_ad":0.108078,"pct_control":0.120561,"donor_test":"not significant","donor_padj":0.852071,"donor_log2fc":-0.0616329,"donor_lfcse":0.0882475,"donor_log2fc_shrunk":-0.00374114,"degas_log2fc":0.280599,"degas_padj":5.73748e-34},{"cell_type":"Mic","gene_symbol":"EPHB3","gene_symbol_current":"EPHB3","gene_id":"ENSG00000182580","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.937176,"donor_log2fc":-0.0753821,"donor_lfcse":0.183796,"donor_log2fc_shrunk":-0.0043349,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"EPHB3","gene_symbol_current":"EPHB3","gene_id":"ENSG00000182580","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.293785,"donor_lfcse":0.181761,"donor_log2fc_shrunk":9.22465e-06,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000182580","entrez_id":["2049"],"uniprot":["P54753"],"ncbi_summary":"Ephrin receptors and their ligands, the ephrins, mediate numerous developmental processes, particularly in the nervous system. Based on their structures and sequence relationships, ephrins are divided into the ephrin-A (EFNA) class, which are anchored to the membrane by a glycosylphosphatidylinositol linkage, and the ephrin-B (EFNB) class, which are transmembrane proteins. The Eph family of receptors are divided into two groups based on the similarity of their extracellular domain sequences and their affinities for binding ephrin-A and ephrin-B ligands. Ephrin receptors make up the largest subgroup of the receptor tyrosine kinase (RTK) family. This gene encodes a receptor for ephrin-B family members. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P54753","text":"Receptor tyrosine kinase which binds promiscuously transmembrane ephrin-B family ligands residing on adjacent cells, leading to contact-dependent bidirectional signaling into neighboring cells. The signaling pathway downstream of the receptor is referred to as forward signaling while the signaling pathway downstream of the ephrin ligand is referred to as reverse signaling. Generally has an overlapping and redundant function with EPHB2. Like EPHB2, functions in axon guidance during development regulating for instance the neurons forming the corpus callosum and the anterior commissure, 2 major interhemispheric connections between the temporal lobes of the cerebral cortex. In addition to its role in axon guidance also plays an important redundant role with other ephrin-B receptors in development and maturation of dendritic spines and the formation of excitatory synapses. Controls other aspects of development through regulation of cell migration and positioning. This includes angiogenesis, palate development and thymic epithelium development for instance. Forward and reverse signaling through the EFNB2/EPHB3 complex also regulate migration and adhesion of cells that tubularize the urethra and septate the cloaca. Finally, plays an important role in intestinal epithelium differentiation segregating progenitor from differentiated cells in the crypt."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}