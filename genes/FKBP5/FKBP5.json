eus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.11496,"nucleus_log2fc":-0.276518,"nucleus_score":-2.59114,"pct_ad":0.310047,"pct_control":0.365517,"donor_test":"not significant","donor_padj":0.998161,"donor_log2fc":0.0421701,"donor_lfcse":0.264288,"donor_log2fc_shrunk":0.00012366},{"cell_type":"Oli","gene_symbol":"FKBP5","gene_symbol_current":"FKBP5","gene_id":"ENSG00000096060","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.41297e-09,"nucleus_log2fc":0.345194,"nucleus_score":6.46895,"pct_ad":0.217768,"pct_control":0.178431,"donor_test":"not significant","donor_padj":0.958934,"donor_log2fc":0.0760223,"donor_lfcse":0.253674,"donor_log2fc_shrunk":0.00114992}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000096060","module":"turquoise","kme":0.148086,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000096060","module":"pink","kme":0.307499,"hub":true,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000096060","entrez_id":["2289"],"uniprot":["Q13451"],"ncbi_summary":"The protein encoded by this gene is a member of the immunophilin protein family, which play a role in immunoregulation and basic cellular processes involving protein folding and trafficking. This encoded protein is a cis-trans prolyl isomerase that binds to the immunosuppressants FK506 and rapamycin. It is thought to mediate calcineurin inhibition. It also interacts functionally with mature hetero-oligomeric progesterone receptor complexes along with the 90 kDa heat shock protein and P23 protein. This gene has been found to have multiple polyadenylation sites. Alternative splicing results in multiple transcript variants.[provided by RefSeq, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13451","text":"Immunophilin protein with PPIase and co-chaperone activities (PubMed:11350175). Component of unligated steroid receptors heterocomplexes through interaction with heat-shock protein 90 (HSP90). Plays a role in the intracellular trafficking of heterooligomeric forms of steroid hormone receptors maintaining the complex into the cytoplasm when unliganded (PubMed:12538866). Acts as a regulator of Akt/AKT1 activity by promoting the interaction between Akt/AKT1 and PHLPP1, thereby enhancing dephosphorylation and subsequent activation of Akt/AKT1 (PubMed:28147277, PubMed:28363942). Interacts with IKBKE and IKBKB which facilitates IKK complex assembly leading to increased IKBKE and IKBKB kinase activity, NF-kappa-B activation, and IFN production (PubMed:26101251, PubMed:31434731)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}