tent":"no","known_active":false,"moa":"Glucocorticoid receptor agonist","note":null},{"rank":15,"name":"HYDROCORTISONE BUTYRATE","compound_id":"CHEMBL1683","accession":"Q13451","score":2.57503,"score_min":0.970806,"consistent":"no","known_active":false,"moa":"Glucocorticoid receptor agonist","note":null},{"rank":16,"name":"MEDROXYPROGESTERONE ACETATE","compound_id":"CHEMBL717","accession":"Q13451","score":2.56864,"score_min":0.798639,"consistent":"no","known_active":false,"moa":"Progesterone receptor agonist","note":null},{"rank":17,"name":"FLUOROMETHOLONE","compound_id":"CHEMBL1200600","accession":"Q13451","score":2.56259,"score_min":0.532107,"consistent":"no","known_active":false,"moa":"Glucocorticoid receptor agonist","note":null},{"rank":18,"name":"HYDROCORTISONE VALERATE","compound_id":"CHEMBL1200562","accession":"Q13451","score":2.5617,"score_min":1.25515,"consistent":"no","known_active":false,"moa":"Glucocorticoid receptor agonist","note":null},{"rank":19,"name":"RIMEXOLONE","compound_id":"CHEMBL1200617","accession":"Q13451","score":2.54831,"score_min":0.593489,"consistent":"no","known_active":false,"moa":"Glucocorticoid receptor agonist","note":null},{"rank":20,"name":"REPAGLINIDE","compound_id":"CHEMBL1272","accession":"Q13451","score":2.54637,"score_min":1.40253,"consistent":"no","known_active":false,"moa":"Sulfonylurea receptor 1, Kir6.2 blocker","note":null}],"n_screening_hits":10,"top_screening_hits":[{"name":null,"compound_id":"PV-001880390382_1_T1","accession":"Q13451","score":6.89919},{"name":null,"compound_id":"ZINC001160249438","accession":"Q13451","score":6.66085},{"name":null,"compound_id":"Z2445386570_1_T1","accession":"Q13451","score":6.64513},{"name":null,"compound_id":"ZINC001216138215","accession":"Q13451","score":6.62041},{"name":null,"compound_id":"Z1650761392_1_T2","accession":"Q13451","score":6.55667}],"notes":[]}},"description":[{"gene_id":"ENSG00000096060","entrez_id":["2289"],"uniprot":["Q13451"],"ncbi_summary":"The protein encoded by this gene is a member of the immunophilin protein family, which play a role in immunoregulation and basic cellular processes involving protein folding and trafficking. This encoded protein is a cis-trans prolyl isomerase that binds to the immunosuppressants FK506 and rapamycin. It is thought to mediate calcineurin inhibition. It also interacts functionally with mature hetero-oligomeric progesterone receptor complexes along with the 90 kDa heat shock protein and P23 protein. This gene has been found to have multiple polyadenylation sites. Alternative splicing results in multiple transcript variants.[provided by RefSeq, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13451","text":"Immunophilin protein with PPIase and co-chaperone activities (PubMed:11350175). Component of unligated steroid receptors heterocomplexes through interaction with heat-shock protein 90 (HSP90). Plays a role in the intracellular trafficking of heterooligomeric forms of steroid hormone receptors maintaining the complex into the cytoplasm when unliganded (PubMed:12538866). Acts as a regulator of Akt/AKT1 activity by promoting the interaction between Akt/AKT1 and PHLPP1, thereby enhancing dephosphorylation and subsequent activation of Akt/AKT1 (PubMed:28147277, PubMed:28363942). Interacts with IKBKE and IKBKB which facilitates IKK complex assembly leading to increased IKBKE and IKBKB kinase activity, NF-kappa-B activation, and IFN production (PubMed:26101251, PubMed:31434731)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[{"accession":"Q13451","pdb_id":"7aot","het_id":"RTQ","resolution":0.85,"method":"X-ray diffraction","ligand_rule":"SUBJECT_OF_INVESTIGATION","datasets":["SEA-AD (Gabitto et al. 2024)"],"ligand_name":"(2R,5S,12R)-12-cyclohexyl-2-[2-(3,4-dimethoxyphenyl)ethyl]-3,19-dioxa-10,13,16-triazatricyclo[18.3.1.0-5,10]tetracosa- 1(24),20,22-triene-4,11,14,17-tetrone",