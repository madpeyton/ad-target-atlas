pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.844739,"donor_log2fc":-0.115301,"donor_lfcse":0.157647,"donor_log2fc_shrunk":-0.00224883,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Mic","gene_symbol":"SERPINB1","gene_symbol_current":"SERPINB1","gene_id":"ENSG00000021355","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0272542,"nucleus_log2fc":0.140822,"nucleus_score":2.48022,"pct_ad":0.242433,"pct_control":0.229608,"donor_test":"not significant","donor_padj":0.90331,"donor_log2fc":0.0823627,"donor_lfcse":0.150313,"donor_log2fc_shrunk":0.00715961,"degas_log2fc":-0.181891,"degas_padj":0.000199181},{"cell_type":"OPC","gene_symbol":"SERPINB1","gene_symbol_current":"SERPINB1","gene_id":"ENSG00000021355","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.311546,"donor_lfcse":0.249281,"donor_log2fc_shrunk":5.0687e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"SERPINB1","gene_symbol_current":"SERPINB1","gene_id":"ENSG00000021355","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.957664,"donor_log2fc":-0.0652107,"donor_lfcse":0.170124,"donor_log2fc_shrunk":-0.00241742,"degas_log2fc":0.114573,"degas_padj":0.00342992}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000021355","module":"turquoise","kme":0.0984855,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000021355","entrez_id":["1992"],"uniprot":["P30740"],"ncbi_summary":"The protein encoded by this gene is a member of the serpin family of proteinase inhibitors. Members of this family maintain homeostasis by neutralizing overexpressed proteinase activity through their function as suicide substrates. This protein inhibits the neutrophil-derived proteinases neutrophil elastase, cathepsin G, and proteinase-3 and thus protects tissues from damage at inflammatory sites. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P30740","text":"Neutrophil serine protease inhibitor that plays an essential role in the regulation of the innate immune response, inflammation and cellular homeostasis (PubMed:30692621). Acts primarily to protect the cell from proteases released in the cytoplasm during stress or infection. These proteases are important in killing microbes but when released from granules, these potent enzymes also destroy host proteins and contribute to mortality. Regulates the activity of the neutrophil proteases elastase, cathepsin G, proteinase-3, chymase, chymotrypsin, and kallikrein-3 (PubMed:11747453, PubMed:30692621). Also acts as a potent intracellular inhibitor of GZMH by directly blocking its proteolytic activity (PubMed:23269243). During inflammation, limits the activity of inflammatory caspases CASP1, CASP4 and CASP5 by suppressing their caspase-recruitment domain (CARD) oligomerization and enzymatic activation (PubMed:30692621). When secreted, promotes the proliferation of beta-cells via its protease inhibitory function (PubMed:26701651)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}