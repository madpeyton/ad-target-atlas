ction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000079432","module":"turquoise","kme":0.151046,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000079432"],"dataset_symbols":["CIC"],"explorer":"explorer.html?dataset=mathys2019#gene/CIC","cell_types":[{"cell_type":"Ex","gene_symbol":"CIC","gene_symbol_current":"CIC","gene_id":"ENSG00000079432","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.692321,"nucleus_log2fc":0.0513623,"nucleus_score":0.485058,"pct_ad":0.12759,"pct_control":0.125778,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.192326,"donor_lfcse":0.118685,"donor_log2fc_shrunk":1.40058e-05},{"cell_type":"In","gene_symbol":"CIC","gene_symbol_current":"CIC","gene_id":"ENSG00000079432","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.247519,"donor_lfcse":0.190559,"donor_log2fc_shrunk":6.972e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000079432","entrez_id":["23152"],"uniprot":["Q96RK0"],"ncbi_summary":"The protein encoded by this gene is an ortholog of the Drosophila melanogaster capicua gene, and is a member of the high mobility group (HMG)-box superfamily of transcriptional repressors. This protein contains a conserved HMG domain that is involved in DNA binding and nuclear localization, and a conserved C-terminus. Studies suggest that the N-terminal region of this protein interacts with Atxn1 (GeneID:6310), to form a transcription repressor complex, and in vitro studies suggest that polyglutamine-expansion of ATXN1 may alter the repressor activity of this complex. Mutations in this gene have been associated with olidogdendrogliomas (PMID:21817013). In addition, translocation events resulting in gene fusions of this gene with both DUX4 (GeneID:100288687) and FOXO4 (GeneID:4303) have been associated with round cell sarcomas. There are multiple pseudogenes of this gene found on chromosomes 1, 4, 6, 7, 16, 20, and the Y chromosome. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Feb 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96RK0","text":"Transcriptional repressor which plays a role in development of the central nervous system (CNS). In concert with ATXN1 and ATXN1L, involved in brain development."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}