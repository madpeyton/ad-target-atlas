13521,"donor_test":"not significant","donor_padj":0.995512,"donor_log2fc":0.00442929,"donor_lfcse":0.127672,"donor_log2fc_shrunk":0.000221375}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000079432","module":"red","kme":0.12478,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000079432","module":"turquoise","kme":0.0234249,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000079432","entrez_id":["23152"],"uniprot":["Q96RK0"],"ncbi_summary":"The protein encoded by this gene is an ortholog of the Drosophila melanogaster capicua gene, and is a member of the high mobility group (HMG)-box superfamily of transcriptional repressors. This protein contains a conserved HMG domain that is involved in DNA binding and nuclear localization, and a conserved C-terminus. Studies suggest that the N-terminal region of this protein interacts with Atxn1 (GeneID:6310), to form a transcription repressor complex, and in vitro studies suggest that polyglutamine-expansion of ATXN1 may alter the repressor activity of this complex. Mutations in this gene have been associated with olidogdendrogliomas (PMID:21817013). In addition, translocation events resulting in gene fusions of this gene with both DUX4 (GeneID:100288687) and FOXO4 (GeneID:4303) have been associated with round cell sarcomas. There are multiple pseudogenes of this gene found on chromosomes 1, 4, 6, 7, 16, 20, and the Y chromosome. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Feb 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96RK0","text":"Transcriptional repressor which plays a role in development of the central nervous system (CNS). In concert with ATXN1 and ATXN1L, involved in brain development."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}