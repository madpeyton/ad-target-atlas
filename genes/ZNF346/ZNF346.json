n":[{"accession":"Q9UL40","text":"Binds with low affinity to dsDNA and ssRNA, and with high affinity to dsRNA, with no detectable sequence specificity (PubMed:24521053). May bind to specific miRNA hairpins (PubMed:28431233)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}