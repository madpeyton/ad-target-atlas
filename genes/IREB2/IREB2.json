d":"ENSG00000136381","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.459778,"nucleus_log2fc":0.0462648,"nucleus_score":1.02676,"pct_ad":0.440203,"pct_control":0.430144,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.010951,"donor_lfcse":0.064441,"donor_log2fc_shrunk":2.7612e-06,"degas_log2fc":-0.348765,"degas_padj":1.16572e-17},{"cell_type":"Oli","gene_symbol":"IREB2","gene_symbol_current":"IREB2","gene_id":"ENSG00000136381","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.301332,"nucleus_log2fc":0.0413392,"nucleus_score":1.13257,"pct_ad":0.322626,"pct_control":0.321204,"donor_test":"not significant","donor_padj":0.927014,"donor_log2fc":0.0375989,"donor_lfcse":0.0636647,"donor_log2fc_shrunk":0.00814553,"degas_log2fc":-0.216058,"degas_padj":1.63823e-25}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000136381","module":"blue","kme":0.10513,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136381","entrez_id":["3658"],"uniprot":["P48200"],"ncbi_summary":"The protein encoded by this gene is an RNA-binding protein that acts to regulate iron levels in the cells by regulating the translation and stability of mRNAs that affect iron homeostasis under conditions when iron is depleted. When iron levels are low, this protein binds to iron-responsive elements (IRES), stem-loop structures located either in the 5' or 3' UTRs. Binding to the 5' UTR represses translation, while binding to the 3' UTR inhibits mRNA degradation. When iron is found in the cell, this protein is degraded in a F-box and leucine rich repeat protein 5-dependent manner. Variants in this gene have been associated with lung cancer and chronic obstructive pulmonary disease (COPD). Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Aug 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P48200","text":"RNA-binding protein that binds to iron-responsive elements (IRES), which are stem-loop structures found in the 5'-UTR of ferritin, and delta aminolevulinic acid synthase mRNAs, and in the 3'-UTR of transferrin receptor mRNA. Binding to the IRE element in ferritin results in the repression of its mRNA translation. Binding of the protein to the transferrin receptor mRNA inhibits the degradation of this otherwise rapidly degraded mRNA."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}