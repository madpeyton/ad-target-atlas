ignificant","donor_padj":0.913843,"donor_log2fc":-0.041629,"donor_lfcse":0.0819569,"donor_log2fc_shrunk":-0.0102667,"degas_log2fc":-0.036396,"degas_padj":0.495037},{"cell_type":"OPC","gene_symbol":"SRSF3","gene_symbol_current":"SRSF3","gene_id":"ENSG00000112081","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0043042,"nucleus_log2fc":0.187035,"nucleus_score":3.35723,"pct_ad":0.307337,"pct_control":0.281626,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.103633,"donor_lfcse":0.0952697,"donor_log2fc_shrunk":1.19324e-05,"degas_log2fc":-0.096164,"degas_padj":0.0721513},{"cell_type":"Oli","gene_symbol":"SRSF3","gene_symbol_current":"SRSF3","gene_id":"ENSG00000112081","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.26292e-24,"nucleus_log2fc":0.251021,"nucleus_score":10.3483,"pct_ad":0.238626,"pct_control":0.206755,"donor_test":"not significant","donor_padj":0.612837,"donor_log2fc":0.159853,"donor_lfcse":0.0807665,"donor_log2fc_shrunk":0.0325757,"degas_log2fc":-0.0464872,"degas_padj":0.0688082}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000112081","module":"turquoise","kme":0.0850531,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000112081","module":"brown","kme":0.221718,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000112081","module":"turquoise","kme":0.0388692,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000112081","module":"turquoise","kme":0.057741,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000112081","entrez_id":["6428"],"uniprot":["P84103"],"ncbi_summary":"The protein encoded by this gene is a member of the serine/arginine (SR)-rich family of pre-mRNA splicing factors, which constitute part of the spliceosome. Each of these factors contains an RNA recognition motif (RRM) for binding RNA and an RS domain for binding other proteins. The RS domain is rich in serine and arginine residues and facilitates interaction between different SR splicing factors. In addition to being critical for mRNA splicing, the SR proteins have also been shown to be involved in mRNA export from the nucleus and in translation. Two transcript variants, one protein-coding and the other non-coding, have been found for this gene. [provided by RefSeq, Sep 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P84103","text":"Splicing factor, which binds the consensus motif 5'-C[ACU][AU]C[ACU][AC]C-3' within pre-mRNA and promotes specific exons inclusion during alternative splicing (PubMed:17036044, PubMed:26876937, PubMed:32440474). Interaction with YTHDC1, a RNA-binding protein that recognizes and binds N6-methyladenosine (m6A)-containing RNAs, promotes recruitment of SRSF3 to its mRNA-binding elements adjacent to m6A sites within exons (PubMed:26876937). Also functions as an adapter involved in mRNA nuclear export (PubMed:11336712, PubMed:18364396, PubMed:28984244). Binds mRNA which is thought to be transferred to the NXF1-NXT1 heterodimer for export (TAP/NXF1 pathway); enhances NXF1-NXT1 RNA-binding activity (PubMed:11336712, PubMed:18364396). Involved in nuclear export of m6A-containing mRNAs via interaction with YTHDC1: interaction with YTHDC1 facilitates m6A-containing mRNA-binding to both SRSF3 and NXF1, promoting mRNA nuclear export (PubMed:28984244)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}