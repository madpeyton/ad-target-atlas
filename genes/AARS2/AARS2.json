ct_ad":0.17718,"pct_control":0.17487,"donor_test":"not significant","donor_padj":0.782364,"donor_log2fc":-0.0251218,"donor_lfcse":0.0408112,"donor_log2fc_shrunk":-0.011196},{"cell_type":"Inhibitory","gene_symbol":"AARS2","gene_symbol_current":"AARS2","gene_id":"ENSG00000124608","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.464148,"nucleus_log2fc":-0.0670346,"nucleus_score":-0.908099,"pct_ad":0.127978,"pct_control":0.129195,"donor_test":"not significant","donor_padj":0.727196,"donor_log2fc":-0.0450387,"donor_lfcse":0.0516248,"donor_log2fc_shrunk":-0.0113706},{"cell_type":"Oligodendroglia","gene_symbol":"AARS2","gene_symbol_current":"AARS2","gene_id":"ENSG00000124608","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.209422,"donor_log2fc":0.120753,"donor_lfcse":0.0566012,"donor_log2fc_shrunk":0.06738}],"modules":[],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000124608"],"dataset_symbols":["AARS2"],"explorer":"explorer.html?dataset=mathys2019#gene/AARS2","cell_types":[{"cell_type":"Ex","gene_symbol":"AARS2","gene_symbol_current":"AARS2","gene_id":"ENSG00000124608","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.994258,"donor_log2fc":0.0306847,"donor_lfcse":0.120175,"donor_log2fc_shrunk":1.19665e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000124608","entrez_id":["57505"],"uniprot":["Q5JTZ9"],"ncbi_summary":"The protein encoded by this gene belongs to the class-II aminoacyl-tRNA synthetase family. Aminoacyl-tRNA synthetases play critical roles in mRNA translation by charging tRNAs with their cognate amino acids. The encoded protein is a mitochondrial enzyme that specifically aminoacylates alanyl-tRNA. Mutations in this gene are a cause of combined oxidative phosphorylation deficiency 8. [provided by RefSeq, Dec 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5JTZ9","text":"Catalyzes the attachment of alanine to tRNA(Ala) in a two-step reaction: alanine is first activated by ATP to form Ala-AMP and then transferred to the acceptor end of tRNA(Ala). Also edits incorrectly charged tRNA(Ala) via its editing domain (PubMed:21549344). In presence of high levels of lactate, also acts as a protein lactyltransferase that mediates lactylation of lysine residues in target proteins, such as CGAS (PubMed:39322678). Acts as an inhibitor of cGAS/STING signaling by catalyzing lactylation of CGAS, preventing the formation of liquid-like droplets in which CGAS is activated (PubMed:39322678)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}