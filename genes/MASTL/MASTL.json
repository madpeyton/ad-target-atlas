53,"pct_ad":0.126477,"pct_control":0.129801,"donor_test":"not significant","donor_padj":0.176372,"donor_log2fc":-0.0964662,"donor_lfcse":0.0418496,"donor_log2fc_shrunk":-0.0629666},{"cell_type":"Inhibitory","gene_symbol":"MASTL","gene_symbol_current":"MASTL","gene_id":"ENSG00000120539","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.87345,"donor_log2fc":-0.0236225,"donor_lfcse":0.0516243,"donor_log2fc_shrunk":-0.00540386},{"cell_type":"Oligodendroglia","gene_symbol":"MASTL","gene_symbol_current":"MASTL","gene_id":"ENSG00000120539","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.370077,"donor_log2fc":0.107876,"donor_lfcse":0.0714435,"donor_log2fc_shrunk":0.0333131}],"modules":[],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000120539"],"dataset_symbols":["MASTL"],"explorer":"explorer.html?dataset=mathys2019#gene/MASTL","cell_types":[{"cell_type":"Ex","gene_symbol":"MASTL","gene_symbol_current":"MASTL","gene_id":"ENSG00000120539","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.988831,"donor_log2fc":-0.0448874,"donor_lfcse":0.119321,"donor_log2fc_shrunk":-3.22123e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000120539","entrez_id":["84930"],"uniprot":["Q96GX5"],"ncbi_summary":"This gene encodes a microtubule-associated serine/threonine kinase. Mutations at this locus have been associated with autosomal dominant thrombocytopenia, also known as thrombocytopenia-2. Alternatively spliced transcript variants have been described for this locus. [provided by RefSeq, Feb 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96GX5","text":"Serine/threonine kinase that plays a key role in M phase by acting as a regulator of mitosis entry and maintenance (PubMed:19680222). Acts by promoting the inactivation of protein phosphatase 2A (PP2A) during M phase: does not directly inhibit PP2A but acts by mediating phosphorylation and subsequent activation of ARPP19 and ENSA at 'Ser-62' and 'Ser-67', respectively (PubMed:38123684). ARPP19 and ENSA are phosphatase inhibitors that specifically inhibit the PPP2R2D (PR55-delta) subunit of PP2A. Inactivation of PP2A during M phase is essential to keep cyclin-B1-CDK1 activity high (PubMed:20818157). Following DNA damage, it is also involved in checkpoint recovery by being inhibited. Phosphorylates histone protein in vitro; however such activity is unsure in vivo. May be involved in megakaryocyte differentiation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}