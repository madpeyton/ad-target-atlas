ue,"nucleus_direction":"lower in AD","nucleus_padj":0.00387368,"nucleus_log2fc":-0.170839,"nucleus_score":-3.17574,"pct_ad":0.122934,"pct_control":0.139055,"donor_test":"not significant","donor_padj":0.624179,"donor_log2fc":-0.174835,"donor_lfcse":0.121804,"donor_log2fc_shrunk":-0.0249723},{"cell_type":"OPC","gene_symbol":"TPMT","gene_symbol_current":"TPMT","gene_id":"ENSG00000137364","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0956995,"nucleus_log2fc":-0.158754,"nucleus_score":-2.09897,"pct_ad":0.110349,"pct_control":0.1221,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.151929,"donor_lfcse":0.094161,"donor_log2fc_shrunk":-1.77139e-05},{"cell_type":"Oli","gene_symbol":"TPMT","gene_symbol_current":"TPMT","gene_id":"ENSG00000137364","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.628812,"donor_log2fc":-0.135606,"donor_lfcse":0.0706576,"donor_log2fc_shrunk":-0.0345308}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000137364","entrez_id":["7172"],"uniprot":["P51580"],"ncbi_summary":"This gene encodes the enzyme that metabolizes thiopurine drugs via S-adenosyl-L-methionine as the S-methyl donor and S-adenosyl-L-homocysteine as a byproduct. Thiopurine drugs such as 6-mercaptopurine are used as chemotherapeutic agents. Genetic polymorphisms that affect this enzymatic activity are correlated with variations in sensitivity and toxicity to such drugs within individuals, causing thiopurine S-methyltransferase deficiency. Related pseudogenes have been identified on chromosomes 3, 18 and X. [provided by RefSeq, Aug 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P51580","text":"Catalyzes the S-methylation of thiopurine drugs such as 6-mercaptopurine (also called mercaptopurine, 6-MP or its brand name Purinethol) and 6-thioguanine (also called tioguanine or 6-TG) using S-adenosyl-L-methionine as the methyl donor (PubMed:18484748, PubMed:657528). TPMT activity modulates the cytotoxic effects of thiopurine prodrugs. A natural substrate for this enzyme has yet to be identified."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}