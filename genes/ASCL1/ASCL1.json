nor_lfcse":0.181183,"donor_log2fc_shrunk":0.00117789,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"ASCL1","gene_symbol_current":"ASCL1","gene_id":"ENSG00000139352","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.872545,"donor_log2fc":-0.109854,"donor_lfcse":0.182634,"donor_log2fc_shrunk":-0.00154744,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"ASCL1","gene_symbol_current":"ASCL1","gene_id":"ENSG00000139352","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":8.58365e-18,"nucleus_log2fc":0.434934,"nucleus_score":9.07573,"pct_ad":0.425142,"pct_control":0.355631,"donor_test":"not significant","donor_padj":0.991471,"donor_log2fc":0.374701,"donor_lfcse":0.150728,"donor_log2fc_shrunk":1.68805e-05,"degas_log2fc":0.164178,"degas_padj":0.000324432}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000139352","module":"turquoise","kme":0.0973061,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000139352","module":"turquoise","kme":0.170854,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000139352","entrez_id":["429"],"uniprot":["P50553"],"ncbi_summary":"This gene encodes a member of the basic helix-loop-helix (BHLH) family of transcription factors. The protein activates transcription by binding to the E box (5'-CANNTG-3'). Dimerization with other BHLH proteins is required for efficient DNA binding. This protein plays a role in the neuronal commitment and differentiation and in the generation of olfactory and autonomic neurons. Mutations in this gene may contribute to the congenital central hypoventilation syndrome (CCHS) phenotype in rare cases. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P50553","text":"Transcription factor that plays a key role in neuronal differentiation: acts as a pioneer transcription factor, accessing closed chromatin to allow other factors to bind and activate neural pathways. Directly binds the E box motif (5'-CANNTG-3') on promoters and promotes transcription of neuronal genes. The combination of three transcription factors, ASCL1, POU3F2/BRN2 and MYT1L, is sufficient to reprogram fibroblasts and other somatic cells into induced neuronal (iN) cells in vitro. Plays a role at early stages of development of specific neural lineages in most regions of the CNS, and of several lineages in the PNS. Essential for the generation of olfactory and autonomic neurons. Acts synergistically with FOXN4 to specify the identity of V2b neurons rather than V2a from bipotential p2 progenitors during spinal cord neurogenesis, probably through DLL4-NOTCH signaling activation. Involved in the regulation of neuroendocrine cell development in the glandular stomach (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}