cleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.992934,"donor_log2fc":-0.0112107,"donor_lfcse":0.165015,"donor_log2fc_shrunk":-0.000329137,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000071575","module":"yellow","kme":0.29442,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000071575","entrez_id":["28951"],"uniprot":["Q92519"],"ncbi_summary":"This gene encodes one of three members of the Tribbles family. The Tribbles members share a Trb domain, which is homologous to protein serine-threonine kinases, but lacks the active site lysine and probably lacks a catalytic function. The Tribbles proteins interact and modulate the activity of signal transduction pathways in a number of physiological and pathological processes. This Tribbles member induces apoptosis of cells mainly of the hematopoietic origin. It has been identified as a protein up-regulated by inflammatory stimuli in myeloid (THP-1) cells, and also as an oncogene that inactivates the transcription factor C/EBPalpha (CCAAT/enhancer-binding protein alpha) and causes acute myelogenous leukemia. Alternatively spliced transcript variants have been found for this gene. [provided by RefSeq, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92519","text":"Interacts with MAPK kinases and regulates activation of MAP kinases. Does not display kinase activity (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}