i","gene_symbol":"RNF167","gene_symbol_current":"RNF167","gene_id":"ENSG00000108523","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.953972,"donor_log2fc":0.070282,"donor_lfcse":0.183261,"donor_log2fc_shrunk":0.00197767}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000108523","module":"brown","kme":0.119105,"hub":false,"module_direction":"lower in AD","module_padj":0.652213,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000108523","module":"turquoise","kme":0.26515,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000108523","module":"turquoise","kme":0.230696,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000108523","module":"turquoise","kme":0.137738,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000108523","entrez_id":["26001"],"uniprot":["Q9H6Y7"],"ncbi_summary":"RNF167 is an E3 ubiquitin ligase that interacts with TSSC5 (SLC22A18; MIM 602631) and, together with UBCH6 (UBE2E1; MIM 602916), facilitates TSSC5 polyubiquitylation (Yamada and Gorbsky, 2006 [PubMed 16314844]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H6Y7","text":"E3 ubiquitin-protein ligase that acts as a regulator of the TORC1 signaling pathway (PubMed:33594058, PubMed:35114100). Positively regulates the TORC1 signaling pathway independently of arginine levels: acts by catalyzing 'Lys-29'-polyubiquitination and degradation of CASTOR1, releasing the GATOR2 complex from CASTOR1 (PubMed:33594058). Also negatively regulates the TORC1 signaling pathway in response to leucine deprivation: acts by mediating 'Lys-63'-linked polyubiquitination of SESN2, promoting SESN2-interaction with the GATOR2 complex (PubMed:35114100). Also involved in protein trafficking and localization (PubMed:23129617, PubMed:23353890, PubMed:24387786, PubMed:27808481, PubMed:32409562). Acts as a regulator of synaptic transmission by mediating ubiquitination and degradation of AMPAR receptor GluA2/GRIA2 (PubMed:23129617, PubMed:33650289). Does not catalyze ubiquitination of GluA1/GRIA1 (PubMed:23129617). Also acts as a regulator of the recycling endosome pathway by mediating ubiquitination of VAMP3 (PubMed:23353890). Regulates lysosome positioning by catalyzing ubiquitination and degradation of ARL8B (PubMed:27808481). Plays a role in growth regulation involved in G1/S transition by mediating, possibly by mediating ubiquitination of SLC22A18 (PubMed:16314844). Acts with a limited set of E2 enzymes, such as UBE2D1 and UBE2N (PubMed:33650289)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}