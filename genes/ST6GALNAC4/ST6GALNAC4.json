efSeq, Jan 2022].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H4F1","text":"Transfers the sialyl group (N-acetyl-alpha-neuraminyl or NeuAc) from CMP-NeuAc to the GalNAc residue on the NeuAc-alpha-2,3-Gal-beta-1,3-GalNAc sequence of glycoproteins and glycolipids forming an alpha-2,6-linkage. Produces branched type disialyl structures by transfer of a sialyl group onto a GalNAc residue inside the backbone core chains. Prefers O-glycans to glycoproteins or glycolipids."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}