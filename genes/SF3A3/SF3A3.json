ise","kme":0.116408,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":true,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000183431"],"dataset_symbols":["SF3A3"],"explorer":"explorer.html?dataset=mathys2019#gene/SF3A3","cell_types":[{"cell_type":"Ex","gene_symbol":"SF3A3","gene_symbol_current":"SF3A3","gene_id":"ENSG00000183431","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":9.12721e-07,"nucleus_log2fc":-0.20547,"nucleus_score":-5.24195,"pct_ad":0.183056,"pct_control":0.211677,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0968945,"donor_lfcse":0.0770697,"donor_log2fc_shrunk":-1.2756e-05},{"cell_type":"In","gene_symbol":"SF3A3","gene_symbol_current":"SF3A3","gene_id":"ENSG00000183431","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.726177,"nucleus_log2fc":-0.178748,"nucleus_score":-0.887919,"pct_ad":0.110027,"pct_control":0.116091,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0405635,"donor_lfcse":0.151115,"donor_log2fc_shrunk":-1.86115e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000183431","module":"turquoise","kme":0.15072,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000183431","entrez_id":["10946"],"uniprot":["Q12874"],"ncbi_summary":"This gene encodes subunit 3 of the splicing factor 3a protein complex. The splicing factor 3a heterotrimer includes subunits 1, 2 and 3 and is necessary for the in vitro conversion of 15S U2 snRNP into an active 17S particle that performs pre-mRNA splicing. Subunit 3 interacts with subunit 1 through its amino-terminus while the zinc finger domain of subunit 3 plays a role in its binding to the 15S U2 snRNP. This gene has a pseudogene on chromosome 20. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Mar 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q12874","text":"Component of the 17S U2 SnRNP complex of the spliceosome, a large ribonucleoprotein complex that removes introns from transcribed pre-mRNAs (PubMed:10882114, PubMed:11533230, PubMed:32494006, PubMed:34822310, PubMed:8022796). The 17S U2 SnRNP complex (1) directly participates in early spliceosome assembly and (2) mediates recognition of the intron branch site during pre-mRNA splicing by promoting the selection of the pre-mRNA branch-site adenosine, the nucleophile for the first step of splicing (PubMed:10882114, PubMed:11533230, PubMed:32494006, PubMed:34822310). Within the 17S U2 SnRNP complex, SF3A3 is part of the SF3A subcomplex that contributes to the assembly of the 17S U2 snRNP, and the subsequent assembly of the pre-spliceosome 'E' complex and the pre-catalytic spliceosome 'A' complex (PubMed:10882114, PubMed:11533230). Involved in pre-mRNA splicing as a component of pre-catalytic spliceosome 'B' complexes (PubMed:29360106, PubMed:30315277)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}