er.html?dataset=seaad_pfc#gene/CASQ1","cell_types":[{"cell_type":"Ast","gene_symbol":"CASQ1","gene_symbol_current":"CASQ1","gene_id":"ENSG00000143318","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.932072,"donor_log2fc":0.111721,"donor_lfcse":0.251601,"donor_log2fc_shrunk":0.00109343,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Ex","gene_symbol":"CASQ1","gene_symbol_current":"CASQ1","gene_id":"ENSG00000143318","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.823447,"donor_log2fc":0.0991623,"donor_lfcse":0.146652,"donor_log2fc_shrunk":0.00423168,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"CASQ1","gene_symbol_current":"CASQ1","gene_id":"ENSG00000143318","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.909899,"donor_log2fc":0.0562059,"donor_lfcse":0.128357,"donor_log2fc_shrunk":0.00163813,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000143318","entrez_id":["844"],"uniprot":["P31415"],"ncbi_summary":"This gene encodes the skeletal muscle specific member of the calsequestrin protein family. Calsequestrin functions as a luminal sarcoplasmic reticulum calcium sensor in both cardiac and skeletal muscle cells. This protein, also known as calmitine, functions as a calcium regulator in the mitochondria of skeletal muscle. This protein is absent in patients with Duchenne and Becker types of muscular dystrophy. [provided by RefSeq, Jun 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P31415","text":"Calsequestrin is a high-capacity, moderate affinity, calcium-binding protein and thus acts as an internal calcium store in muscle (PubMed:28895244). Calcium ions are bound by clusters of acidic residues at the protein surface, often at the interface between subunits. Can bind around 80 Ca(2+) ions (PubMed:28895244). Regulates the release of lumenal Ca(2+) via the calcium release channel RYR1; this plays an important role in triggering muscle contraction. Negatively regulates store-operated Ca(2+) entry (SOCE) activity (PubMed:27185316)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}