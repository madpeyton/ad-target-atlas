eus_score":10.4319,"pct_ad":0.194777,"pct_control":0.167332,"donor_test":"not significant","donor_padj":0.6486,"donor_log2fc":0.422623,"donor_lfcse":0.231207,"donor_log2fc_shrunk":0.00842853,"degas_log2fc":0.106133,"degas_padj":0.000176909}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000160191","module":"greenyellow","kme":0.757167,"hub":true,"module_direction":"lower in AD","module_padj":0.398964,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000160191","module":"blue","kme":0.336309,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000160191","module":"green","kme":0.20964,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000160191","module":"blue","kme":0.16133,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000160191","entrez_id":["5152"],"uniprot":["O76083"],"ncbi_summary":"The protein encoded by this gene catalyzes the hydrolysis of cAMP and cGMP to their corresponding monophosphates. The encoded protein plays a role in signal transduction by regulating the intracellular concentration of these cyclic nucleotides. Multiple transcript variants encoding several different isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O76083","text":"Specifically hydrolyzes the second messenger cGMP, which is a key regulator of many important physiological processes. Highly specific: compared to other members of the cyclic nucleotide phosphodiesterase family, has the highest affinity and selectivity for cGMP (PubMed:18757755, PubMed:21483814, PubMed:9624146). Specifically regulates natriuretic-peptide-dependent cGMP signaling in heart, acting as a regulator of cardiac hypertrophy in myocytes and muscle. Does not regulate nitric oxide-dependent cGMP in heart (PubMed:25799991). Additional experiments are required to confirm whether its ability to hydrolyze natriuretic-peptide-dependent cGMP is specific to heart or is a general feature of the protein (Probable). In brain, involved in cognitive function, such as learning and long-term memory (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}