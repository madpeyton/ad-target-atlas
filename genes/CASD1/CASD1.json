ucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00269893,"nucleus_log2fc":-0.0208526,"nucleus_score":-3.0782,"pct_ad":0.683606,"pct_control":0.695391,"donor_test":"not significant","donor_padj":0.717828,"donor_log2fc":0.0618579,"donor_lfcse":0.0352048,"donor_log2fc_shrunk":0.0229782},{"cell_type":"Mic","gene_symbol":"CASD1","gene_symbol_current":"CASD1","gene_id":"ENSG00000127995","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.21019,"nucleus_log2fc":-0.0427483,"nucleus_score":-1.47691,"pct_ad":0.326277,"pct_control":0.338018,"donor_test":"not significant","donor_padj":0.937176,"donor_log2fc":-0.0291116,"donor_lfcse":0.0713922,"donor_log2fc_shrunk":-0.00881804},{"cell_type":"OPC","gene_symbol":"CASD1","gene_symbol_current":"CASD1","gene_id":"ENSG00000127995","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.228482,"nucleus_log2fc":0.0535489,"nucleus_score":1.58074,"pct_ad":0.5762,"pct_control":0.567655,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0412594,"donor_lfcse":0.0650961,"donor_log2fc_shrunk":1.0184e-05},{"cell_type":"Oli","gene_symbol":"CASD1","gene_symbol_current":"CASD1","gene_id":"ENSG00000127995","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":6.37113e-18,"nucleus_log2fc":-0.140784,"nucleus_score":-8.7873,"pct_ad":0.483925,"pct_control":0.516551,"donor_test":"not significant","donor_padj":0.727018,"donor_log2fc":-0.0995471,"donor_lfcse":0.0665584,"donor_log2fc_shrunk":-0.0251477}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000127995","entrez_id":["64921"],"uniprot":["Q96PB1"],"ncbi_summary":"Enables N-acetylneuraminate 7-O(or 9-O)-acetyltransferase activity. Involved in carbohydrate metabolic process. Is integral component of Golgi membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96PB1","text":"Key enzyme in the biosynthesis of O-acetylated (O-Ac) sialoglycans such as gangliosides O-AcGD3 and O-AcGD2, which affect various processes such as cell-cell interactions, host-pathogen recognition (PubMed:20947662, PubMed:26169044, PubMed:34208013). Catalyzes the transfer of an acetyl group from a donor, the acetyl-coenzyme-A molecule (acetyl-CoA), to the C7/8/9 OH-position of a sialic acid residue (PubMed:20947662, PubMed:26169044). The primary site of O-acetyl group transfer on sialic acid seems to depend on cell type and can be C7, from which the O-acetyl group could subsequently migrate to the C8 and then to the C9 position, or at C9 with possibility of migrating to the C8 and then to the C7 position (PubMed:20947662, PubMed:26169044). Together with ST8SIA1 (GD3 synthase) it increases the levels of ganglioside Ac-O-7-GD3 (PubMed:20947662). Can transfer the acetyl group from acetyl-CoA to free sialate (N-acetylneuraminate, Neu5Ac) in vitro, but has preferred substrate specificity for CMP-activated sialate (CMP-Neu5Ac), resulting in the formation of 9-O-acetylated CMP-Neu5Ac (CMP-Neu5,9Ac2) (PubMed:26169044). CMP-Neu5,9Ac2 may be used by sialyltransferases as a sialate donor for glycoconjugate acceptors such as ganglioside GD3 (PubMed:26169044). O-acetylation at position C9 of ganglioside GD3 can counteract the pro-apoptotic effects of the ganglioside GD3 in tumor cells (PubMed:12486096)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}