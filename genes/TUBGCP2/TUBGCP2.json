b":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000130640","entrez_id":["10844"],"uniprot":["Q9BSJ2"],"ncbi_summary":"Predicted to enable gamma-tubulin binding activity. Predicted to contribute to microtubule minus-end binding activity. Involved in brain development and neuron migration. Located in centrosome and nucleoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BSJ2","text":"Component of the gamma-tubulin ring complex (gTuRC) which mediates microtubule nucleation (PubMed:38305685, PubMed:38609661, PubMed:39321809, PubMed:9566967). The gTuRC regulates the minus-end nucleation of alpha-beta tubulin heterodimers that grow into microtubule protafilaments, a critical step in centrosome duplication and spindle formation (PubMed:38305685, PubMed:38609661, PubMed:39321809). Plays a role in neuronal migration (PubMed:31630790)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}