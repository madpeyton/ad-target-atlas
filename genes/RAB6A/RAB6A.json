ol":0.504724,"donor_test":"not significant","donor_padj":0.970703,"donor_log2fc":-0.0134125,"donor_lfcse":0.0630285,"donor_log2fc_shrunk":-0.00458668,"degas_log2fc":-0.0209312,"degas_padj":0.58446},{"cell_type":"OPC","gene_symbol":"RAB6A","gene_symbol_current":"RAB6A","gene_id":"ENSG00000175582","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0022211,"nucleus_log2fc":-0.0976234,"nucleus_score":-3.56486,"pct_ad":0.725768,"pct_control":0.751228,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0361114,"donor_lfcse":0.0594529,"donor_log2fc_shrunk":-1.06351e-05,"degas_log2fc":-0.227957,"degas_padj":5.40924e-16},{"cell_type":"Oli","gene_symbol":"RAB6A","gene_symbol_current":"RAB6A","gene_id":"ENSG00000175582","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.67937e-13,"nucleus_log2fc":-0.113984,"nucleus_score":-7.53328,"pct_ad":0.523065,"pct_control":0.550776,"donor_test":"not significant","donor_padj":0.788411,"donor_log2fc":-0.0721813,"donor_lfcse":0.0561305,"donor_log2fc_shrunk":-0.0207834,"degas_log2fc":-0.176378,"degas_padj":2.35064e-29}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000175582","entrez_id":["5870"],"uniprot":["P20340"],"ncbi_summary":"This gene encodes a member of the RAB family, which belongs to the small GTPase superfamily. GTPases of the RAB family bind to various effectors to regulate the targeting and fusion of transport carriers to acceptor compartments. This protein is located at the Golgi apparatus, which regulates trafficking in both a retrograde (from early endosomes and Golgi to the endoplasmic reticulum) and an anterograde (from the Golgi to the plasma membrane) directions. Myosin II is an effector of this protein in these processes. This protein is also involved in assembly of human cytomegalovirus (HCMV) by interacting with the cellular protein Bicaudal D1, which interacts with the HCMV virion tegument protein, pp150. Multiple alternatively spliced transcript variants encoding different isoforms have been identified. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P20340","text":"The small GTPases Rab are key regulators of intracellular membrane trafficking, from the formation of transport vesicles to their fusion with membranes (PubMed:25962623). Rabs cycle between an inactive GDP-bound form and an active GTP-bound form that is able to recruit to membranes different sets of downstream effectors directly responsible for vesicle formation, movement, tethering and fusion (PubMed:25962623). RAB6A acts as a regulator of COPI-independent retrograde transport from the Golgi apparatus towards the endoplasmic reticulum (ER) (PubMed:25962623). Has a low GTPase activity (PubMed:25962623). Recruits VPS13B to the Golgi membrane (PubMed:25492866). Plays a role in neuron projection development (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}