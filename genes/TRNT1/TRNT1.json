fc_shrunk":0.0104283},{"cell_type":"OPC","gene_symbol":"TRNT1","gene_symbol_current":"TRNT1","gene_id":"ENSG00000072756","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.894475,"nucleus_log2fc":-0.0351261,"nucleus_score":0.214847,"pct_ad":0.20683,"pct_control":0.203387,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0709447,"donor_lfcse":0.125445,"donor_log2fc_shrunk":-4.70888e-06},{"cell_type":"Oli","gene_symbol":"TRNT1","gene_symbol_current":"TRNT1","gene_id":"ENSG00000072756","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.66897,"nucleus_log2fc":-0.018036,"nucleus_score":-0.485836,"pct_ad":0.143389,"pct_control":0.144543,"donor_test":"not significant","donor_padj":0.97984,"donor_log2fc":0.0167456,"donor_lfcse":0.0992072,"donor_log2fc_shrunk":0.00174863}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000072756","module":"turquoise","kme":0.101508,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000072756","module":"turquoise","kme":0.199,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000072756","module":"turquoise","kme":0.0940525,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000072756","module":"turquoise","kme":0.0847997,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000072756","entrez_id":["51095"],"uniprot":["Q96Q11"],"ncbi_summary":"The protein encoded by this gene is a CCA-adding enzyme which belongs to the tRNA nucleotidyltransferase/poly(A) polymerase family. This essential enzyme functions by catalyzing the addition of the conserved nucleotide triplet CCA to the 3' terminus of tRNA molecules. Mutations in this gene result in sideroblastic anemia with B-cell immunodeficiency, periodic fevers, and developmental delay. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Dec 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96Q11","text":"Nucleotidyltransferase that catalyzes the addition and repair of the essential 3'-terminal CCA sequence in tRNAs, which is necessary for the attachment of amino acids to the 3' terminus of tRNA molecules, using CTP and ATP as substrates (PubMed:11504732, PubMed:25193871, PubMed:25640237, PubMed:25652405, PubMed:29454993, PubMed:30959222, PubMed:31011209, PubMed:34023389). tRNA 3'-terminal CCA addition is required both for tRNA processing and repair (PubMed:22076379, PubMed:25640237). Promotes tRNA repair and recycling downstream of the ribosome-associated quality control (RQC) pathway by mediating addition of the tRNA 3'-terminal CCA following cleavage by ANKZF1 and repair by ELAC1 (PubMed:31011209). Also involved in tRNA surveillance by mediating tandem CCA addition to generate a CCACCA at the 3' terminus of unstable tRNAs and tRNA-like transcripts (PubMed:22076379, PubMed:25640237). While stable tRNAs receive only 3'-terminal CCA, unstable tRNAs beginning with GG are marked with CCACCA and rapidly degraded (PubMed:22076379, PubMed:25640237). The structural flexibility of RNA controls the choice between CCA versus CCACCA addition: following the first CCA addition cycle, nucleotide-binding to the active site triggers a clockwise screw motion, producing torque on the RNA (PubMed:25640237). This ejects stable RNAs, whereas unstable RNAs are refolded while bound to the enzyme and subjected to a second CCA catalytic cycle (PubMed:25640237). [Isoform 2]: Adds 2 C residues (CC-) to the 3' terminus of tRNA molecules instead of a complete CCA end as isoform 1 does (in vitro)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}