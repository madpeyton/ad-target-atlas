00000084072","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000431639,"nucleus_log2fc":-0.161633,"nucleus_score":-3.80221,"pct_ad":0.152987,"pct_control":0.171877,"donor_test":"not significant","donor_padj":0.986262,"donor_log2fc":-0.0404442,"donor_lfcse":0.0933649,"donor_log2fc_shrunk":1.48862e-05},{"cell_type":"In","gene_symbol":"PPIE","gene_symbol_current":"PPIE","gene_id":"ENSG00000084072","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.742809,"nucleus_log2fc":-0.133666,"nucleus_score":-0.841395,"pct_ad":0.125998,"pct_control":0.132898,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0435843,"donor_lfcse":0.160841,"donor_log2fc_shrunk":-1.87904e-06},{"cell_type":"Oli","gene_symbol":"PPIE","gene_symbol_current":"PPIE","gene_id":"ENSG00000084072","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.966005,"donor_log2fc":0.0382883,"donor_lfcse":0.168982,"donor_log2fc_shrunk":0.00116396}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000084072","module":"turquoise","kme":0.138502,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000084072","module":"lightyellow","kme":0.137622,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000084072","entrez_id":["10450"],"uniprot":["Q9UNP9"],"ncbi_summary":"The protein encoded by this gene is a member of the peptidyl-prolyl cis-trans isomerase (PPIase) family. PPIases catalyze the cis-trans isomerization of proline imidic peptide bonds in oligopeptides and accelerate the folding of proteins. This protein contains a highly conserved cyclophilin (CYP) domain as well as an RNA-binding domain. It was shown to possess PPIase and protein folding activities, and it also exhibits RNA-binding activity. Alternative splicing results in multiple transcript variants. A related pseudogene, which is also located on chromosome 1, has been identified. [provided by RefSeq, Aug 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UNP9","text":"Involved in pre-mRNA splicing as component of the spliceosome (PubMed:11991638, PubMed:28076346). Combines RNA-binding and PPIase activities (PubMed:18258190, PubMed:20460131, PubMed:20677832, PubMed:8977107). Binds mRNA and has a preference for single-stranded RNA molecules with poly-A and poly-U stretches, suggesting it binds to the poly(A)-region in the 3'-UTR of mRNA molecules (PubMed:18258190, PubMed:20460131, PubMed:8977107). Catalyzes the cis-trans isomerization of proline imidic peptide bonds in proteins (PubMed:18258190, PubMed:20541251, PubMed:20677832, PubMed:8977107). Inhibits KMT2A activity; this requires proline isomerase activity (PubMed:20460131, PubMed:20541251, PubMed:20677832)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}