fc":-0.158317,"donor_lfcse":0.101658,"donor_log2fc_shrunk":-1.58286e-05},{"cell_type":"Oli","gene_symbol":"TARBP1","gene_symbol_current":"TARBP1","gene_id":"ENSG00000059588","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.4951e-87,"nucleus_log2fc":-0.376585,"nucleus_score":-19.9598,"pct_ad":0.306421,"pct_control":0.378611,"donor_test":"not significant","donor_padj":0.473457,"donor_log2fc":-0.309277,"donor_lfcse":0.123635,"donor_log2fc_shrunk":-0.0280238}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000059588","module":"green","kme":0.195447,"hub":false,"module_direction":"lower in AD","module_padj":0.299526,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000059588","module":"turquoise","kme":0.0898413,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000059588","entrez_id":["6894"],"uniprot":["Q13395"],"ncbi_summary":"HIV-1, the causative agent of acquired immunodeficiency syndrome (AIDS), contains an RNA genome that produces a chromosomally integrated DNA during the replicative cycle. Activation of HIV-1 gene expression by the transactivator Tat is dependent on an RNA regulatory element (TAR) located downstream of the transcription initiation site. This element forms a stable stem-loop structure and can be bound by either the protein encoded by this gene or by RNA polymerase II. This protein may act to disengage RNA polymerase II from TAR during transcriptional elongation. Alternatively spliced transcripts of this gene may exist, but their full-length natures have not been determined. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13395","text":"S-adenosyl-L-methionine-dependent 2'-O-ribose methyltransferase that catalyzes the formation of 2'-O-methylguanosine at position 18 (Gm18) in a subset of tRNA (PubMed:18412263, PubMed:31019095, PubMed:38867004). Selectively mediates Gm18 methylation of tRNAGln-TTG/CTG and tRNASer-TGA/GCT. Gm18 modification can enhance the stability of modified tRNAs (PubMed:38867004). (Microbial infection) In case of infection by HIV-1, it binds to the loop region of TAR RNA, a region also bound by RNA polymerase II (PubMed:7638159, PubMed:8626763, PubMed:8846792). Binding of TARBP1 and RNA polymerase II to HIV-1 TAR RNA is mutually exclusive, suggesting that TARBP1 may function alone or in conjunction with HIV-1 Tat to disengage RNA polymerase II from HIV-1 TAR RNA (PubMed:7638159, PubMed:8626763, PubMed:8846792)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}