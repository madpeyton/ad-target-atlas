donor_log2fc":0.0555473,"donor_lfcse":0.102402,"donor_log2fc_shrunk":0.00480089,"degas_log2fc":-0.12379,"degas_padj":1.30826e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000153936","module":"pink","kme":0.335416,"hub":false,"module_direction":"lower in AD","module_padj":0.531952,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000153936","module":"blue","kme":0.161252,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000153936","module":"blue","kme":0.174412,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000153936","module":"blue","kme":0.184598,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000153936","module":"blue","kme":0.0828852,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000153936","entrez_id":["9653"],"uniprot":["Q7LGA3"],"ncbi_summary":"Heparan sulfate biosynthetic enzymes are key components in generating a myriad of distinct heparan sulfate fine structures that carry out multiple biologic activities. This gene encodes a member of the heparan sulfate biosynthetic enzyme family that transfers sulfate to the 2 position of the iduronic acid residue of heparan sulfate. The disruption of this gene resulted in no kidney formation in knockout embryonic mice, indicating that the absence of this enzyme may interfere with the signaling required for kidney formation. Two alternatively spliced transcript variants that encode different proteins have been found for this gene. [provided by RefSeq, Aug 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q7LGA3","text":"Catalyzes the transfer of a sulfo group from 3'-phospho-5'-adenylyl sulfate (PAPS) to the 2-OH position of iduronic acid (IdoA) or glucuronic acid (GlcA) within the heparan sulfate (HS) chain and participates in HS biosynthesis (By similarity). Required for metanephric development of kidney formation, suggesting that 2-O-sulfation within HS is essential for signaling between ureteric bud and metanephric mesenchyme (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}