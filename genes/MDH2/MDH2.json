_control":0.192966,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0899297,"donor_lfcse":0.240853,"donor_log2fc_shrunk":-7.98167e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000146701","module":"turquoise","kme":0.412223,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000146701","module":"turquoise","kme":0.41795,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000146701","module":"turquoise","kme":0.117551,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000146701","entrez_id":["4191"],"uniprot":["P40926"],"ncbi_summary":"Malate dehydrogenase catalyzes the reversible oxidation of malate to oxaloacetate, utilizing the NAD/NADH cofactor system in the citric acid cycle. The protein encoded by this gene is localized to the mitochondria and may play pivotal roles in the malate-aspartate shuttle that operates in the metabolic coordination between cytosol and mitochondria. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Sep 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P40926","text":"Mitochondrial malate dehydrogenase that catalyzes the reversible conversion of malate to oxaloacetate using NAD(+) as a cofactor (PubMed:27989324). Plays a central role in the tricarboxylic acid (TCA) cycle contributing to cellular respiration and energy production via the mitochondrial electron transport chain (PubMed:35366151). Also participates in the malate-aspartate NADH shuttle, facilitating transfer of reducing equivalents between cytosol and mitochondria to maintain redox balance (NAD(+)/NADH homeostasis) and support metabolic flux between compartments (By similarity). In addition to its metabolic role, binds to RNA in cells, associating with cytosolic RNAs including tRNAs and mRNAs (PubMed:38609156)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}