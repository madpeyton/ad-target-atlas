407,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Ex","gene_symbol":"SOD3","gene_symbol_current":"SOD3","gene_id":"ENSG00000109610","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.873286,"donor_log2fc":0.0922523,"donor_lfcse":0.187563,"donor_log2fc_shrunk":0.00236239,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"SOD3","gene_symbol_current":"SOD3","gene_id":"ENSG00000109610","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.876411,"donor_log2fc":0.132495,"donor_lfcse":0.229298,"donor_log2fc_shrunk":0.00122273,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"SOD3","gene_symbol_current":"SOD3","gene_id":"ENSG00000109610","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.798972,"donor_log2fc":-0.35686,"donor_lfcse":0.287713,"donor_log2fc_shrunk":-0.00474362,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000109610","module":"turquoise","kme":0.133071,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000109610","entrez_id":["6649"],"uniprot":["P08294"],"ncbi_summary":"This gene encodes a member of the superoxide dismutase (SOD) protein family. SODs are antioxidant enzymes that catalyze the conversion of superoxide radicals into hydrogen peroxide and oxygen, which may protect the brain, lungs, and other tissues from oxidative stress. Proteolytic processing of the encoded protein results in the formation of two distinct homotetramers that differ in their ability to interact with the extracellular matrix (ECM). Homotetramers consisting of the intact protein, or type C subunit, exhibit high affinity for heparin and are anchored to the ECM. Homotetramers consisting of a proteolytically cleaved form of the protein, or type A subunit, exhibit low affinity for heparin and do not interact with the ECM. A mutation in this gene may be associated with increased heart disease risk. [provided by RefSeq, Oct 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P08294","text":"Secreted antioxidant enzyme that acts as the primary scavenger of superoxide radicals in the extracellular space, converting them to hydrogen peroxide and thereby protecting tissues from oxidative damage (PubMed:12933702, PubMed:15761197). Also preserves nitric oxide bioavailability by preventing the formation of harmful peroxynitrite (PubMed:12933702). Stored in intracellular pre-formed vesicles of macrophages and neutrophils and released upon stimulation by inflammatory mediators (PubMed:31326693)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}