Gene.info","uniprot_function":[{"accession":"Q96BF6","text":"Functions as a transcriptional repressor through its association with the NuRD complex. Recruits the NuRD complex to the promoter of MDM2, leading to the repression of MDM2 transcription and subsequent stability of p53/TP53."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}