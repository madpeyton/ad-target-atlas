g2fc":0.0912029,"donor_lfcse":0.178789,"donor_log2fc_shrunk":0.00136181},{"cell_type":"Oli","gene_symbol":"USH1C","gene_symbol_current":"USH1C","gene_id":"ENSG00000006611","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.585922,"donor_log2fc":-0.668803,"donor_lfcse":0.32524,"donor_log2fc_shrunk":-0.00720881}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000006611","module":"brown","kme":0.469372,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000006611","entrez_id":["10083"],"uniprot":["Q9Y6N9"],"ncbi_summary":"This gene encodes a scaffold protein that functions in the assembly of Usher protein complexes. The protein contains PDZ domains, a coiled-coil region with a bipartite nuclear localization signal and a PEST degradation sequence. Defects in this gene are the cause of Usher syndrome type 1C and non-syndromic sensorineural deafness autosomal recessive type 18. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y6N9","text":"Anchoring/scaffolding protein that is a part of the functional network formed by USH1C, USH1G, CDH23 and MYO7A that mediates mechanotransduction in cochlear hair cells. Required for normal development and maintenance of cochlear hair cell bundles (By similarity). As part of the intermicrovillar adhesion complex/IMAC plays a role in brush border differentiation, controlling microvilli organization and length. Probably plays a central regulatory role in the assembly of the complex, recruiting CDHR2, CDHR5 and MYO7B to the microvilli tips (PubMed:24725409, PubMed:26812018)."}],"unipro