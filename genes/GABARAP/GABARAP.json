_padj":2.12117e-06,"nucleus_log2fc":0.287493,"nucleus_score":5.25248,"pct_ad":0.271995,"pct_control":0.232007,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.280415,"donor_lfcse":0.19746,"donor_log2fc_shrunk":7.53503e-06},{"cell_type":"Oli","gene_symbol":"GABARAP","gene_symbol_current":"GABARAP","gene_id":"ENSG00000170296","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000985611,"nucleus_log2fc":-0.0645049,"nucleus_score":-3.43767,"pct_ad":0.251769,"pct_control":0.265117,"donor_test":"not significant","donor_padj":0.959293,"donor_log2fc":0.0834791,"donor_lfcse":0.223304,"donor_log2fc_shrunk":0.00187556}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000170296","module":"turquoise","kme":0.217173,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000170296","module":"brown","kme":0.579942,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000170296","module":"brown","kme":0.51374,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000170296","module":"red","kme":0.433829,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000170296","module":"turquoise","kme":0.273208,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000170296","module":"turquoise","kme":0.36906,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000170296","entrez_id":["11337"],"uniprot":["O95166"],"ncbi_summary":"Gamma-aminobutyric acid A receptors [GABA(A) receptors] are ligand-gated chloride channels that mediate inhibitory neurotransmission. This gene encodes GABA(A) receptor-associated protein, which is highly positively charged in its N-terminus and shares sequence similarity with light chain-3 of microtubule-associated proteins 1A and 1B. This protein clusters neurotransmitter receptors by mediating interaction with the cytoskeleton. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95166","text":"Ubiquitin-like modifier that plays a role in intracellular transport of GABA(A) receptors and its interaction with the cytoskeleton (PubMed:9892355). Involved in autophagy: while LC3s are involved in elongation of the phagophore membrane, the GABARAP/GATE-16 subfamily is essential for a later stage in autophagosome maturation (PubMed:15169837, PubMed:20562859, PubMed:22948227, PubMed:34597140). Through its interaction with the reticulophagy receptor TEX264, participates in the remodeling of subdomains of the endoplasmic reticulum into autophagosomes upon nutrient stress, which then fuse with lysosomes for endoplasmic reticulum turnover (PubMed:31006538). Participates in selective ER-phagy through interaction with UBAC2, promoting recruitment of UBAC2-associated ER fragments to autophagosomes (PubMed:39284914). In addition to autophagy, also regulates lysosome biogenesis via interaction with FNIP1 (or FNIP2): interaction sequesters the FLCN-FNIP complex and prevents non-canonical mTORC1 signaling cascade activation, leading to activation of transcription factors TFEB and TFE3 (PubMed:39423796, PubMed:34597140). Also required for the local activation of the CUL3(KBTBD6/7) E3 ubiquitin ligase complex, regulating ubiquitination and degradation of TIAM1, a guanyl-nucleotide exchange factor (GEF) that activates RAC1 and downstream signal transduction (PubMed:25684205). Thereby, regulates different biological processes including the organization of the cytoskeleton, cell migration and proliferation (PubMed:25684205). Involved in apoptosis (PubMed:15977068)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}