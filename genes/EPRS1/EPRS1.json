itory","gene_id":"ENSG00000136628","module":"yellow","kme":0.273894,"hub":false,"module_direction":"higher in AD","module_padj":0.726304,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000136628"],"dataset_symbols":["EPRS"],"explorer":"explorer.html?dataset=mathys2019#gene/EPRS","cell_types":[{"cell_type":"Ast","gene_symbol":"EPRS","gene_symbol_current":"EPRS1","gene_id":"ENSG00000136628","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.987998,"nucleus_log2fc":0.113248,"nucleus_score":0.0237193,"pct_ad":0.111973,"pct_control":0.114509,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Ex","gene_symbol":"EPRS","gene_symbol_current":"EPRS1","gene_id":"ENSG00000136628","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.137936,"nucleus_log2fc":-0.0338553,"nucleus_score":-1.67483,"pct_ad":0.359813,"pct_control":0.374541,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0334798,"donor_lfcse":0.06,"donor_log2fc_shrunk":9.35794e-06},{"cell_type":"In","gene_symbol":"EPRS","gene_symbol_current":"EPRS1","gene_id":"ENSG00000136628","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.87367,"nucleus_log2fc":0.0512975,"nucleus_score":0.469761,"pct_ad":0.318545,"pct_control":0.314348,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0531564,"donor_lfcse":0.111062,"donor_log2fc_shrunk":6.77105e-06},{"cell_type":"OPC","gene_symbol":"EPRS","gene_symbol_current":"EPRS1","gene_id":"ENSG00000136628","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.295828,"nucleus_log2fc":0.303347,"nucleus_score":1.84634,"pct_ad":0.131083,"pct_control":0.10728,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"EPRS","gene_symbol_current":"EPRS1","gene_id":"ENSG00000136628","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.886029,"donor_log2fc":0.0834265,"donor_lfcse":0.10749,"donor_log2fc_shrunk":0.00667761}],"modules":[{"cell_type":"In","gene_id":"ENSG00000136628","module":"brown","kme":0.281465,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000136628","module":"turquoise","kme":0.133593,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136628","entrez_id":["2058"],"uniprot":["P07814"],"ncbi_summary":"Aminoacyl-tRNA synthetases are a class of enzymes that charge tRNAs with their cognate amino acids. The protein encoded by this gene is a multifunctional aminoacyl-tRNA synthetase that catalyzes the aminoacylation of glutamic acid and proline tRNA species. Alternative splicing has been observed for this gene, but the full-length nature and biological validity of the variant have not been determined. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P07814","text":"Multifunctional protein which primarily functions within the aminoacyl-tRNA synthetase multienzyme complex, also known as multisynthetase complex. Within the complex it catalyzes the attachment of both L-glutamate and L-proline to their cognate tRNAs in a two-step reaction where the amino acid is first activated by ATP to form a covalent intermediate with AMP. Subsequently, the activated amino acid is transferred to the acceptor end of the cognate tRNA to form L-glutamyl-tRNA(Glu) and L-prolyl-tRNA(Pro) (PubMed:23263184, PubMed:24100331, PubMed:29576217, PubMed:3290852, PubMed:37212275). Upon interferon-gamma stimulation, EPRS1 undergoes phosphorylation, causing its dissociation from the aminoacyl-tRNA synthetase multienzyme complex. It is recruited to form the GAIT complex, which binds to stem loop-containing GAIT elements found in the 3'-UTR of various inflammatory mRNAs, such as ceruloplasmin. The GAIT complex inhibits the translation of these mRNAs, allowing interferon-gamma to redirect the function of EPRS1 from protein synthesis to translation inhibition in specific cell contexts (PubMed:15479637, PubMed:23071094). Furthermore, it can function as a downstream effector in the mTORC1 signaling pathway, by promoting the translocation of SLC27A1 from the cytoplasm to the plasma membrane where it mediates the uptake of long-chain fatty acid by adipocytes. Thereby, EPRS1 also plays a role in fat metabolism and more indirectly influences lifespan (PubMed:28178239)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}