est":"not significant","donor_padj":0.842158,"donor_log2fc":0.0947417,"donor_lfcse":0.122089,"donor_log2fc_shrunk":0.0123044,"degas_log2fc":-0.148084,"degas_padj":2.37757e-05},{"cell_type":"OPC","gene_symbol":"INTS6","gene_symbol_current":"INTS6","gene_id":"ENSG00000102786","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0955521,"nucleus_log2fc":0.0841379,"nucleus_score":2.09988,"pct_ad":0.545183,"pct_control":0.528196,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.102333,"donor_lfcse":0.10482,"donor_log2fc_shrunk":9.61437e-06,"degas_log2fc":-0.452214,"degas_padj":7.14266e-35},{"cell_type":"Oli","gene_symbol":"INTS6","gene_symbol_current":"INTS6","gene_id":"ENSG00000102786","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0166362,"nucleus_log2fc":0.0635579,"nucleus_score":2.52927,"pct_ad":0.40576,"pct_control":0.402804,"donor_test":"not significant","donor_padj":0.927014,"donor_log2fc":0.0794264,"donor_lfcse":0.131008,"donor_log2fc_shrunk":0.00452853,"degas_log2fc":-0.160862,"degas_padj":1.37528e-17}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000102786","module":"magenta","kme":0.191114,"hub":false,"module_direction":"higher in AD","module_padj":0.456482,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000102786","module":"blue","kme":0.214704,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000102786","module":"blue","kme":0.230281,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000102786","module":"blue","kme":0.158978,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000102786","entrez_id":["26512"],"uniprot":["Q9UL03"],"ncbi_summary":"DEAD box proteins, characterized by the conserved motif Asp-Glu-Ala-Asp (DEAD), are putative RNA helicases. The protein encoded by this gene is a DEAD box protein that is part of a complex that interacts with the C-terminus of RNA polymerase II and is involved in 3' end processing of snRNAs. In addition, this gene is a candidate tumor suppressor and is located in the critical region of loss of heterozygosity (LOH). Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Apr 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UL03","text":"Component of the integrator complex, a multiprotein complex that terminates RNA polymerase II (Pol II) transcription in the promoter-proximal region of genes (PubMed:33243860, PubMed:34004147, PubMed:39504960). The integrator complex provides a quality checkpoint during transcription elongation by driving premature transcription termination of transcripts that are unfavorably configured for transcriptional elongation: the complex terminates transcription by (1) catalyzing dephosphorylation of the C-terminal domain (CTD) of Pol II subunit POLR2A and SUPT5H/SPT5, (2) degrading the exiting nascent RNA transcript via endonuclease activity and (3) promoting the release of Pol II from bound DNA (PubMed:33243860, PubMed:34004147, PubMed:38570683, PubMed:39504960). The integrator complex is also involved in terminating the synthesis of non-coding Pol II transcripts, such as enhancer RNAs (eRNAs), small nuclear RNAs (snRNAs), telomerase RNAs and long non-coding RNAs (lncRNAs) (PubMed:16239144). Within the integrator complex, INTS6 acts as a molecular adapter that promotes assembly of protein phosphatase 2A (PP2A) subunits to the integrator core complex, promoting recruitment of PP2A to transcription pause-release checkpoint (PubMed:33243860, PubMed:34004147). Mediates recruitment of cytoplasmic dynein to the nuclear envelope, probably as component of the integrator complex (PubMed:23904267). May have a tumor suppressor role; an ectopic expression suppressing tumor cell growth (PubMed:15254679, PubMed:16239144)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}