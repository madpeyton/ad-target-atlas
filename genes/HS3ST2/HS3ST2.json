2254","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.210876,"donor_lfcse":0.21824,"donor_log2fc_shrunk":-4.55262e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000122254","module":"red","kme":0.512266,"hub":true,"module_direction":"lower in AD","module_padj":0.641133,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000122254","module":"brown","kme":0.287239,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000122254","entrez_id":["9956"],"uniprot":["Q9Y278"],"ncbi_summary":"Heparan sulfate biosynthetic enzymes are key components in generating a myriad of distinct heparan sulfate fine structures that carry out multiple biologic activities. The enzyme encoded by this gene is a member of the heparan sulfate biosynthetic enzyme family. It is a type II integral membrane protein and possesses heparan sulfate glucosaminyl 3-O-sulfotransferase activity. This gene is expressed predominantly in brain and may play a role in the nervous system. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y278","text":"Sulfotransferase that utilizes 3'-phospho-5'-adenylyl sulfate (PAPS) to catalyze the transfer of a sulfo group to an N-unsubstituted glucosamine linked to a 2-O-sulfo iduronic acid unit on heparan sulfate (PubMed:9988768). Catalyzes the O-sulfation of glucosamine in GlcA2S-GlcNS (PubMed:9988768). Unlike HS3ST1/3-OST-1, does not convert non-anticoagulant heparan sulfate to anticoagulant heparan sulfate (PubMed:9988768)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}