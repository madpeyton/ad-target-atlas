ype":"CUX2+","gene_id":"ENSG00000100150","module":"yellow","kme":0.132625,"hub":false,"module_direction":"lower in AD","module_padj":0.642666,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000100150","module":"yellow","kme":0.138953,"hub":false,"module_direction":"lower in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000100150","module":"brown","kme":0.136031,"hub":false,"module_direction":"lower in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000100150"],"dataset_symbols":["DEPDC5"],"explorer":"explorer.html?dataset=mathys2019#gene/DEPDC5","cell_types":[{"cell_type":"Ex","gene_symbol":"DEPDC5","gene_symbol_current":"DEPDC5","gene_id":"ENSG00000100150","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00113443,"nucleus_log2fc":-0.0793642,"nucleus_score":-3.52831,"pct_ad":0.306684,"pct_control":0.33211,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0465827,"donor_lfcse":0.0717505,"donor_log2fc_shrunk":-9.46105e-06},{"cell_type":"In","gene_symbol":"DEPDC5","gene_symbol_current":"DEPDC5","gene_id":"ENSG00000100150","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.345933,"nucleus_log2fc":-0.184121,"nucleus_score":-1.88354,"pct_ad":0.16992,"pct_control":0.189231,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.200817,"donor_lfcse":0.134908,"donor_log2fc_shrunk":-1.1534e-05},{"cell_type":"Oli","gene_symbol":"DEPDC5","gene_symbol_current":"DEPDC5","gene_id":"ENSG00000100150","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.780549,"donor_log2fc":-0.176076,"donor_lfcse":0.127766,"donor_log2fc_shrunk":-0.0106626}],"modules":[{"cell_type":"In","gene_id":"ENSG00000100150","module":"yellow","kme":0.170956,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100150","entrez_id":["9681"],"uniprot":["O75140"],"ncbi_summary":"This gene encodes a member of the IML1 family of proteins involved in G-protein signaling pathways. The mechanistic target of rapamycin complex 1 (mTORC1) pathway regulates cell growth by sensing the availability of nutrients. The protein encoded by this gene is a component of the GATOR1 (GAP activity toward Rags) complex which inhibits the amino acid-sensing branch of the mTORC1 pathway. Mutations in this gene are associated with autosomal dominant familial focal epilepsy with variable foci. A single nucleotide polymorphism in an intron of this gene has been associated with an increased risk of hepatocellular carcinoma in individuals with chronic hepatitis C virus infection. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Mar 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75140","text":"As a component of the GATOR1 complex functions as an inhibitor of the amino acid-sensing branch of the mTORC1 pathway (PubMed:23723238, PubMed:25457612, PubMed:29590090, PubMed:29769719, PubMed:31548394, PubMed:35338845). In response to amino acid depletion, the GATOR1 complex has GTPase activating protein (GAP) activity and strongly increases GTP hydrolysis by RagA/RRAGA (or RagB/RRAGB) within heterodimeric Rag complexes, thereby turning them into their inactive GDP-bound form, releasing mTORC1 from lysosomal surface and inhibiting mTORC1 signaling (PubMed:23723238, PubMed:25457612, PubMed:29590090, PubMed:29769719, PubMed:35338845). In the presence of abundant amino acids, the GATOR1 complex is negatively regulated by GATOR2, the other GATOR subcomplex, in this amino acid-sensing branch of the TORC1 pathway (PubMed:23723238, PubMed:25457612, PubMed:29769719). Within the GATOR1 complex, DEPDC5 mediates direct interaction with the nucleotide-binding pocket of small GTPases Rag (RagA/RRAGA, RagB/RRAGB, RagC/RRAGC and/or RagD/RRAGD) and coordinates their nucleotide loading states by promoting RagA/RRAGA or RagB/RRAGB into their GDP-binding state and RagC/RRAGC or RagD/RRAGD into their GTP-binding state (PubMed:29590090, PubMed:35338845). However, it does not execute the GAP activity, which is mediated by NPRL2 (PubMed:29590090)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}