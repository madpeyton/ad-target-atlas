ymbol_current":"DEPDC5","gene_id":"ENSG00000100150","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":4.59946e-15,"nucleus_log2fc":-0.0683352,"nucleus_score":-7.94244,"pct_ad":0.544421,"pct_control":0.562233,"donor_test":"not significant","donor_padj":0.960545,"donor_log2fc":0.012091,"donor_lfcse":0.0581187,"donor_log2fc_shrunk":0.00916369,"degas_log2fc":-0.191176,"degas_padj":1.09561e-100},{"cell_type":"Mic","gene_symbol":"DEPDC5","gene_symbol_current":"DEPDC5","gene_id":"ENSG00000100150","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0234751,"nucleus_log2fc":0.109454,"nucleus_score":2.53959,"pct_ad":0.305571,"pct_control":0.290668,"donor_test":"not significant","donor_padj":0.717144,"donor_log2fc":0.0917751,"donor_lfcse":0.0786478,"donor_log2fc_shrunk":0.0263973,"degas_log2fc":-0.0311766,"degas_padj":0.532886},{"cell_type":"OPC","gene_symbol":"DEPDC5","gene_symbol_current":"DEPDC5","gene_id":"ENSG00000100150","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000413999,"nucleus_log2fc":-0.208116,"nucleus_score":-4.03717,"pct_ad":0.293469,"pct_control":0.323963,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.145688,"donor_lfcse":0.067453,"donor_log2fc_shrunk":-3.33625e-05,"degas_log2fc":-0.329471,"degas_padj":5.29465e-11},{"cell_type":"Oli","gene_symbol":"DEPDC5","gene_symbol_current":"DEPDC5","gene_id":"ENSG00000100150","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.467441,"nucleus_log2fc":-0.0106661,"nucleus_score":-0.809268,"pct_ad":0.249025,"pct_control":0.252164,"donor_test":"not significant","donor_padj":0.900903,"donor_log2fc":0.0624652,"donor_lfcse":0.0839544,"donor_log2fc_shrunk":0.00861244,"degas_log2fc":-0.204227,"degas_padj":5.35604e-18}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000100150","module":"blue","kme":0.155607,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000100150","module":"blue","kme":0.11514,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100150","entrez_id":["9681"],"uniprot":["O75140"],"ncbi_summary":"This gene encodes a member of the IML1 family of proteins involved in G-protein signaling pathways. The mechanistic target of rapamycin complex 1 (mTORC1) pathway regulates cell growth by sensing the availability of nutrients. The protein encoded by this gene is a component of the GATOR1 (GAP activity toward Rags) complex which inhibits the amino acid-sensing branch of the mTORC1 pathway. Mutations in this gene are associated with autosomal dominant familial focal epilepsy with variable foci. A single nucleotide polymorphism in an intron of this gene has been associated with an increased risk of hepatocellular carcinoma in individuals with chronic hepatitis C virus infection. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Mar 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75140","text":"As a component of the GATOR1 complex functions as an inhibitor of the amino acid-sensing branch of the mTORC1 pathway (PubMed:23723238, PubMed:25457612, PubMed:29590090, PubMed:29769719, PubMed:31548394, PubMed:35338845). In response to amino acid depletion, the GATOR1 complex has GTPase activating protein (GAP) activity and strongly increases GTP hydrolysis by RagA/RRAGA (or RagB/RRAGB) within heterodimeric Rag complexes, thereby turning them into their inactive GDP-bound form, releasing mTORC1 from lysosomal surface and inhibiting mTORC1 signaling (PubMed:23723238, PubMed:25457612, PubMed:29590090, PubMed:29769719, PubMed:35338845). In the presence of abundant amino acids, the GATOR1 complex is negatively regulated by GATOR2, the other GATOR subcomplex, in this amino acid-sensing branch of the TORC1 pathway (PubMed:23723238, PubMed:25457612, PubMed:29769719). Within the GATOR1 complex, DEPDC5 mediates direct interaction with the nucleotide-binding pocket of small GTPases Rag (RagA/RRAGA, RagB/RRAGB, RagC/RRAGC and/or RagD/RRAGD) and coordinates their nucleotide loading states by promoting RagA/RRAGA or RagB/RRAGB into their GDP-binding state and RagC/RRAGC or RagD/RRAGD into their GTP-binding state (PubMed:29590090, PubMed:35338845). However, it does not execute the GAP activity, which is mediated by NPRL2 (PubMed:29590090)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}