:"HIKESHI","gene_id":"ENSG00000149196","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.679102,"nucleus_log2fc":0.0368672,"nucleus_score":0.616922,"pct_ad":0.305249,"pct_control":0.30127,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.00735285,"donor_lfcse":0.0617897,"donor_log2fc_shrunk":2.02566e-06},{"cell_type":"Oli","gene_symbol":"HIKESHI","gene_symbol_current":"HIKESHI","gene_id":"ENSG00000149196","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000720814,"nucleus_log2fc":-0.0692628,"nucleus_score":-3.52605,"pct_ad":0.224674,"pct_control":0.236653,"donor_test":"not significant","donor_padj":0.634306,"donor_log2fc":-0.106105,"donor_lfcse":0.0560254,"donor_log2fc_shrunk":-0.0403754}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000149196","module":"turquoise","kme":0.0131173,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000149196","entrez_id":["51501"],"uniprot":["Q53FT3"],"ncbi_summary":"This gene encodes an evolutionarily conserved nuclear transport receptor that mediates heat-shock-induced nuclear import of 70 kDa heat-shock proteins (Hsp70s) through interactions with FG-nucleoporins. The protein mediates transport of the ATP form but not the ADP form of Hsp70 proteins under conditions of heat shock stress. Structural analyses demonstrate that the protein forms an asymmetric homodimer and that the N-terminal domain consists of a jelly-roll/beta-sandwich fold structure that contains hydrophobic pockets involved in FG-nucleoporin recognition. Reduction of RNA expression levels in HeLa cells using small interfering RNAs results in inhibition of heat shock-induced nuclear accumulation of Hsp70s, indicating a role for this gene in regulation of Hsp70 nuclear import during heat shock stress. [provided by RefSeq, Apr 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q53FT3","text":"Acts as a specific nuclear import carrier for HSP70 proteins following heat-shock stress: acts by mediating the nucleoporin-dependent translocation of ATP-bound HSP70 proteins into the nucleus. HSP70 proteins import is required to protect cells from heat shock damages. Does not translocate ADP-bound HSP70 proteins into the nucleus."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}