681","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.886387,"nucleus_log2fc":0.0721522,"nucleus_score":0.360384,"pct_ad":0.169742,"pct_control":0.162297,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"ATF7IP","gene_symbol_current":"ATF7IP","gene_id":"ENSG00000171681","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.740807,"nucleus_log2fc":-0.0700324,"nucleus_score":-0.715432,"pct_ad":0.22763,"pct_control":0.240613,"donor_test":"not significant","donor_padj":0.99309,"donor_log2fc":-0.0647944,"donor_lfcse":0.14062,"donor_log2fc_shrunk":-0.000691268},{"cell_type":"Oli","gene_symbol":"ATF7IP","gene_symbol_current":"ATF7IP","gene_id":"ENSG00000171681","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.308161,"nucleus_log2fc":0.0875614,"nucleus_score":1.25617,"pct_ad":0.121721,"pct_control":0.115805,"donor_test":"not significant","donor_padj":0.960295,"donor_log2fc":0.021732,"donor_lfcse":0.0843581,"donor_log2fc_shrunk":0.00305251}],"modules":[{"cell_type":"In","gene_id":"ENSG00000171681","module":"blue","kme":0.0861719,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000171681","module":"brown","kme":0.151523,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000171681","entrez_id":["55729"],"uniprot":["Q6VMQ6"],"ncbi_summary":"ATF7IP is a multifunctional nuclear protein that associates with heterochromatin. It can act as a transcriptional coactivator or corepressor depending upon its binding partners (summary by Liu et al., 2009 [PubMed 19106100]).[supplied by OMIM, Nov 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6VMQ6","text":"Recruiter that couples transcriptional factors to general transcription apparatus and thereby modulates transcription regulation and chromatin formation. Can both act as an activator or a repressor depending on the context. Required for HUSH-mediated heterochromatin formation and gene silencing (PubMed:27732843). Mediates MBD1-dependent transcriptional repression, probably by recruiting complexes containing SETDB1 (PubMed:12665582). Stabilizes SETDB1, is required to stimulate histone methyltransferase activity of SETDB1 and facilitates the conversion of dimethylated to trimethylated H3 'Lys-9' (H3K9me3). The complex formed with MBD1 and SETDB1 represses transcription and couples DNA methylation and histone H3 'Lys-9' trimethylation (H3K9me3) (PubMed:14536086, PubMed:27732843). Facilitates telomerase TERT and TERC gene expression by SP1 in cancer cells (PubMed:19106100)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}