r":"explorer.html?dataset=mathys2019#gene/ANKRD9","cell_types":[{"cell_type":"Ex","gene_symbol":"ANKRD9","gene_symbol_current":"ANKRD9","gene_id":"ENSG00000156381","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.36086,"nucleus_log2fc":-0.0311705,"nucleus_score":-1.0623,"pct_ad":0.10575,"pct_control":0.110305,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":0.0518543,"donor_lfcse":0.113242,"donor_log2fc_shrunk":4.19049e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000156381","module":"brown","kme":0.192598,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000156381","entrez_id":["122416"],"uniprot":["Q96BM1"],"ncbi_summary":"Enables ubiquitin ligase-substrate adaptor activity. Involved in cellular copper ion homeostasis; proteasome-mediated ubiquitin-dependent protein catabolic process; and protein ubiquitination. Located in cytoplasmic vesicle and cytosol. Part of Cul5-RING ubiquitin ligase complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96BM1","text":"Substrate receptor subunit of a cullin-RING superfamily E3 ligase complex (CUL5-based E3 ubiquitin ligase complex) which mediates the ubiquitination and subsequent proteasomal degradation of target proteins (PubMed:30293565). Depending of the metabolic state of the cell, promotes the proteasomal degradation of IMPDH2, the rate-limiting enzyme in GTP biosynthesis or protects IMPDH2 by stabilizing IMPDH2 filaments assembly (PubMed:30293565, PubMed:31337707). Implicated in different cellular processes, like copper homeostasis and cell proliferation (PubMed:24522796, PubMed:30293565)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions