G3","gene_symbol_current":"ALG3","gene_id":"ENSG00000214160","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.140833,"donor_lfcse":0.159658,"donor_log2fc_shrunk":5.74208e-06},{"cell_type":"Oli","gene_symbol":"ALG3","gene_symbol_current":"ALG3","gene_id":"ENSG00000214160","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.765328,"donor_log2fc":0.162661,"donor_lfcse":0.118397,"donor_log2fc_shrunk":0.0127927}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000214160","module":"turquoise","kme":0.056764,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000214160","entrez_id":["10195"],"uniprot":["Q92685"],"ncbi_summary":"This gene encodes a member of the ALG3 family. The encoded protein catalyses the addition of the first dol-P-Man derived mannose in an alpha 1,3 linkage to Man5GlcNAc2-PP-Dol. Defects in this gene have been associated with congenital disorder of glycosylation type Id (CDG-Id) characterized by abnormal N-glycosylation. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Nov 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92685","text":"Dol-P-Man:Man(5)GlcNAc(2)-PP-Dol alpha-1,3-mannosyltransferase that operates in the biosynthetic pathway of dolichol-linked oligosaccharides, the glycan precursors employed in protein asparagine (N)-glycosylation. The assembly of dolichol-linked oligosaccharides begins on the cytosolic side of the endoplasmic reticulum membrane and finishes in its lumen. The sequential addition of sugars to dolichol pyrophosphate produces dolichol-linked oligosaccharides containing fourteen sugars, including two GlcNAcs, nine mannoses and three glucoses. Once assembled, the oligosaccharide is transferred from the lipid to nascent proteins by oligosaccharyltransferases. In the lumen of the endoplasmic reticulum, adds the first dolichyl beta-D-mannosyl phosphate derived mannose in an alpha-1,3 linkage to Man(5)GlcNAc(2)-PP-dolichol to produce Man(6)GlcNAc(2)-PP-dolichol (PubMed:10581255). Man(6)GlcNAc(2)-PP-dolichol is a substrate for ALG9, the following enzyme in the biosynthetic pathway (PubMed:10581255)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}