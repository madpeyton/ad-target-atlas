lower in AD","nucleus_padj":0.863652,"nucleus_log2fc":-0.0356122,"nucleus_score":-0.504958,"pct_ad":0.46362,"pct_control":0.458761,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0537463,"donor_lfcse":0.0718378,"donor_log2fc_shrunk":-7.59709e-06},{"cell_type":"OPC","gene_symbol":"MNAT1","gene_symbol_current":"MNAT1","gene_id":"ENSG00000020426","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.528451,"nucleus_log2fc":0.133323,"nucleus_score":1.21125,"pct_ad":0.314757,"pct_control":0.291188,"donor_test":"not significant","donor_padj":0.986209,"donor_log2fc":0.0640813,"donor_lfcse":0.115098,"donor_log2fc_shrunk":0.00101102},{"cell_type":"Oli","gene_symbol":"MNAT1","gene_symbol_current":"MNAT1","gene_id":"ENSG00000020426","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.282285,"nucleus_log2fc":-0.123106,"nucleus_score":-1.32758,"pct_ad":0.101678,"pct_control":0.107101,"donor_test":"not significant","donor_padj":0.732555,"donor_log2fc":-0.168102,"donor_lfcse":0.0869524,"donor_log2fc_shrunk":-0.0254531}],"modules":[{"cell_type":"In","gene_id":"ENSG00000020426","module":"yellow","kme":0.224022,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000020426","module":"purple","kme":0.213704,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000020426","entrez_id":["4331"],"uniprot":["P51948"],"ncbi_summary":"The protein encoded by this gene, along with cyclin H and CDK7, forms the CDK-activating kinase (CAK) enzymatic complex. This complex activates several cyclin-associated kinases and can also associate with TFIIH to activate transcription by RNA polymerase II. Two transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Sep 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P51948","text":"Component of the CDK-activating kinase (CAK) complex, a master regulator of CDK activity by catalyzing the activating threonine phosphorylation of CDKs (PubMed:41100585). Binds and activates CDK7, the catalytic subunit of CAK (PubMed:41100585). CAK activates major mediators of cell cycle control, including CDK1, CDK2, CDK4 and CDK6, and plays a key role in regulating cell cycle progression (PubMed:41100585). CAK complexed to the core-TFIIH basal transcription factor activates RNA polymerase II by serine phosphorylation of the repetitive C-terminal domain (CTD) of its large subunit (POLR2A), allowing its escape from the promoter and elongation of the transcripts (PubMed:10024882). Involved in cell cycle control and in RNA transcription by RNA polymerase II (PubMed:10024882)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}