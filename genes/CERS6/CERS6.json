ue,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.32796,"nucleus_log2fc":0.040199,"nucleus_score":1.17971,"pct_ad":0.530826,"pct_control":0.526498,"donor_test":"not significant","donor_padj":0.948808,"donor_log2fc":0.0430796,"donor_lfcse":0.124902,"donor_log2fc_shrunk":0.00478113,"degas_log2fc":-0.104946,"degas_padj":0.0017555},{"cell_type":"OPC","gene_symbol":"CERS6","gene_symbol_current":"CERS6","gene_id":"ENSG00000172292","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.634172,"nucleus_log2fc":0.010978,"nucleus_score":0.699264,"pct_ad":0.731136,"pct_control":0.724979,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0367765,"donor_lfcse":0.108344,"donor_log2fc_shrunk":-3.24821e-06,"degas_log2fc":-0.499969,"degas_padj":3.36527e-67},{"cell_type":"Oli","gene_symbol":"CERS6","gene_symbol_current":"CERS6","gene_id":"ENSG00000172292","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.02918e-21,"nucleus_log2fc":-0.228653,"nucleus_score":-9.66493,"pct_ad":0.186487,"pct_control":0.215831,"donor_test":"not significant","donor_padj":0.832221,"donor_log2fc":-0.223631,"donor_lfcse":0.20618,"donor_log2fc_shrunk":-0.00570858,"degas_log2fc":-0.141145,"degas_padj":1.21376e-07}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000172292","module":"brown","kme":0.59964,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000172292","module":"midnightblue","kme":0.303254,"hub":false,"module_direction":"higher in AD","module_padj":0.698612,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000172292","module":"brown","kme":0.180762,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000172292","entrez_id":["253782"],"uniprot":["Q6ZMG9"],"ncbi_summary":"Enables sphingosine N-acyltransferase activity. Involved in ceramide biosynthetic process. Located in membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6ZMG9","text":"Ceramide synthase that catalyzes the transfer of the fatty acyl chain from acyl-CoA to a sphingoid base, with high selectivity toward palmitoyl-CoA (hexadecanoyl-CoA; C16:0-CoA) (PubMed:17609214, PubMed:17977534, PubMed:23530041, PubMed:26887952, PubMed:31916624, PubMed:39528795). Can use different sphingoid bases as substrates for ceramide synthesis, such as sphinganine in de novo synthesis, and sphing-4E-enine (sphingosine), (4R)-hydroxysphinganine (phytosphingosine) or sphinga-4E,14Z-dienine in salvage pathways (PubMed:17977534, PubMed:23530041, PubMed:26887952, PubMed:31916624). Other fatty acyl-CoAs such as long-chain saturated stearoyl-CoA (octadecanoyl-CoA; C18:0-CoA), myristoyl-CoA (tetradecanoyl-CoA; C14:0-CoA), and monounsaturated oleoyl-CoA (9Z-octadecenoyl-CoA; C18:1-CoA) can also act as acyl donors, but with less efficiency than hexadecanoyl-CoA (PubMed:39528795). Ceramides generated by CERS6 play a role in inflammatory response (By similarity). Acts as a regulator of metabolism and hepatic lipid accumulation (By similarity). Under high fat diet, palmitoyl- (C16:0-) ceramides generated by CERS6 specifically bind the mitochondrial fission factor MFF, thereby promoting mitochondrial fragmentation and contributing to the development of obesity (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}