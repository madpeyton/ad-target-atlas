0.999342,"donor_log2fc":0.0811758,"donor_lfcse":0.0847986,"donor_log2fc_shrunk":1.18675e-05},{"cell_type":"Oli","gene_symbol":"CDC5L","gene_symbol_current":"CDC5L","gene_id":"ENSG00000096401","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":6.07009e-07,"nucleus_log2fc":0.147121,"nucleus_score":5.14547,"pct_ad":0.185216,"pct_control":0.170844,"donor_test":"not significant","donor_padj":0.667861,"donor_log2fc":0.132119,"donor_lfcse":0.0766265,"donor_log2fc_shrunk":0.0259396}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000096401","entrez_id":["988"],"uniprot":["Q99459"],"ncbi_summary":"The protein encoded by this gene shares a significant similarity with Schizosaccharomyces pombe cdc5 gene product, which is a cell cycle regulator important for G2/M transition. This protein has been demonstrated to act as a positive regulator of cell cycle G2/M progression. It was also found to be an essential component of a non-snRNA spliceosome, which contains at least five additional protein factors and is required for the second catalytic step of pre-mRNA splicing. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q99459","text":"DNA-binding protein involved in cell cycle control. May act as a transcription activator. Plays a role in pre-mRNA splicing as core component of precatalytic, catalytic and postcatalytic spliceosomal complexes (PubMed:11991638, PubMed:20176811, PubMed:28076346, PubMed:28502770, PubMed:29301961, PubMed:29360106, PubMed:29361316, PubMed:30705154, PubMed:30728453). Component of the PRP19-CDC5L complex that forms an integral part of the spliceosome and is required for activating pre-mRNA splicing. The PRP19-CDC5L complex may also play a role in the response to DNA damage (DDR) (PubMed:20176811). As a component of the minor spliceosome, involved in the splicing of U12-type introns in pre-mRNAs (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}