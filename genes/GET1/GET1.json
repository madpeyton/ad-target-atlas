"degas_padj":null},{"cell_type":"OPC","gene_symbol":"GET1","gene_symbol_current":"GET1","gene_id":"ENSG00000182093","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.388981,"nucleus_log2fc":0.0439836,"nucleus_score":1.17486,"pct_ad":0.240382,"pct_control":0.23116,"donor_test":"not significant","donor_padj":0.999398,"donor_log2fc":0.000612836,"donor_lfcse":0.113185,"donor_log2fc_shrunk":5.91964e-08,"degas_log2fc":0.229357,"degas_padj":0.000114869},{"cell_type":"Oli","gene_symbol":"GET1","gene_symbol_current":"GET1","gene_id":"ENSG00000182093","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00522455,"nucleus_log2fc":0.0794568,"nucleus_score":2.93122,"pct_ad":0.226263,"pct_control":0.217461,"donor_test":"not significant","donor_padj":0.918654,"donor_log2fc":0.0684265,"donor_lfcse":0.104095,"donor_log2fc_shrunk":0.00656544,"degas_log2fc":-0.0228921,"degas_padj":0.378753}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000182093","module":"turquoise","kme":0.0871791,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000182093","module":"turquoise","kme":0.114074,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000182093","module":"turquoise","kme":0.115378,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000182093","entrez_id":["7485"],"uniprot":["O00258"],"ncbi_summary":"This gene is located in the candidate region for congenital heart disease (CHD) in Down syndrome (DS). It encodes a basic protein that functions as a receptor that promotes insertion of tail-anchored proteins in the endoplasmic reticulum membrane. This gene is located at a maternally-methylated differentially methylated region (DMR); however, its transcription may be biallelic, not imprinted. Alternative splicing results in different transcript variants. A pseudogene has been defined on chromosome 4. [provided by RefSeq, Apr 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00258","text":"Required for the post-translational delivery of tail-anchored (TA) proteins to the endoplasmic reticulum (ER) (PubMed:21444755, PubMed:23041287, PubMed:24392163, PubMed:27226539). Together with CAMLG/GET2, acts as a membrane receptor for soluble GET3/TRC40, which recognizes and selectively binds the transmembrane domain of TA proteins in the cytosol (PubMed:21444755, PubMed:23041287, PubMed:24392163, PubMed:27226539). Required to ensure correct topology and ER insertion of CAMLG (PubMed:31417168, PubMed:32187542)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}