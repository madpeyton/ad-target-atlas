"gene_id":"ENSG00000178607","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":7.59905e-09,"nucleus_log2fc":-0.0196014,"nucleus_score":-5.83333,"pct_ad":0.290505,"pct_control":0.304926,"donor_test":"not significant","donor_padj":0.924665,"donor_log2fc":0.0217448,"donor_lfcse":0.0691576,"donor_log2fc_shrunk":0.00373872,"degas_log2fc":-0.0839085,"degas_padj":4.10399e-14},{"cell_type":"In","gene_symbol":"ERN1","gene_symbol_current":"ERN1","gene_id":"ENSG00000178607","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":8.43841e-16,"nucleus_log2fc":-0.143641,"nucleus_score":-8.15331,"pct_ad":0.129601,"pct_control":0.143037,"donor_test":"not significant","donor_padj":0.843103,"donor_log2fc":-0.0468132,"donor_lfcse":0.0632908,"donor_log2fc_shrunk":-0.00522152,"degas_log2fc":0.197022,"degas_padj":3.6262e-21},{"cell_type":"Mic","gene_symbol":"ERN1","gene_symbol_current":"ERN1","gene_id":"ENSG00000178607","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000323303,"nucleus_log2fc":0.276264,"nucleus_score":3.89694,"pct_ad":0.165738,"pct_control":0.146313,"donor_test":"not significant","donor_padj":0.305067,"donor_log2fc":0.281608,"donor_lfcse":0.112995,"donor_log2fc_shrunk":0.112481,"degas_log2fc":-0.217395,"degas_padj":0.000413457},{"cell_type":"OPC","gene_symbol":"ERN1","gene_symbol_current":"ERN1","gene_id":"ENSG00000178607","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.492244,"nucleus_log2fc":-0.0429702,"nucleus_score":-0.961611,"pct_ad":0.117805,"pct_control":0.123793,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.00471607,"donor_lfcse":0.10853,"donor_log2fc_shrunk":-4.14236e-07,"degas_log2fc":-0.193687,"degas_padj":0.0217175},{"cell_type":"Oli","gene_symbol":"ERN1","gene_symbol_current":"ERN1","gene_id":"ENSG00000178607","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.851926,"donor_log2fc":0.0757701,"donor_lfcse":0.0748852,"donor_log2fc_shrunk":0.0139104,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000178607","module":"greenyellow","kme":0.216905,"hub":false,"module_direction":"lower in AD","module_padj":0.398964,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000178607","module":"blue","kme":0.168654,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000178607","entrez_id":["2081"],"uniprot":["O75460"],"ncbi_summary":"This gene encodes the transmembrane protein kinase inositol-requiring enzyme 1. The encoded protein contains two functional catalytic domains, a serine/threonine-protein kinase domain and an endoribonuclease domain. This protein functions as a sensor of unfolded proteins in the endoplasmic reticulum (ER) and triggers an intracellular signaling pathway termed the unfolded protein response (UPR). The UPR is an ER stress response that is conserved from yeast to mammals and activates genes involved in degrading misfolded proteins, regulating protein synthesis and activating molecular chaperones. This protein specifically mediates the splicing and activation of the stress response transcription factor X-box binding protein 1. [provided by RefSeq, Aug 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75460","text":"Serine/threonine-protein kinase and endoribonuclease that acts as a key sensor for the endoplasmic reticulum unfolded protein response (UPR) (PubMed:11175748, PubMed:11779464, PubMed:12637535, PubMed:19328063, PubMed:21317875, PubMed:28128204, PubMed:30118681, PubMed:36739529, PubMed:9637683). In unstressed cells, the endoplasmic reticulum luminal domain is maintained in its inactive monomeric state by binding to the endoplasmic reticulum chaperone HSPA5/BiP (PubMed:21317875). Accumulation of misfolded proteins in the endoplasmic reticulum causes release of HSPA5/BiP, allowing the luminal domain to homodimerize, promoting autophosphorylation of the kinase domain and subsequent activation of the endoribonuclease activity (PubMed:21317875). The endoribonuclease activity is specific for XBP1 mRNA and excises 26 nucleotides from XBP1 mRNA (PubMed:11779464, PubMed:21317875, PubMed:24508390). The resulting spliced transcript of XBP1 encodes a transcriptional activator protein that up-regulates expression of UPR target genes (PubMed:11779464, PubMed:21317875, PubMed:24508390). Acts as an upstream signal for ER stress-induced GORASP2-mediated unconventional (ER/Golgi-independent) trafficking of CFTR to cell membrane by modulating the expression and localization of SEC16A (PubMed:21884936, PubMed:28067262)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}