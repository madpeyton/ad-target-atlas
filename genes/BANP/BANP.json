fc_shrunk":0.00498827}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000172530","module":"blue","kme":0.198234,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000172530","module":"blue","kme":0.113156,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000172530","module":"turquoise","kme":0.0903216,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000172530","entrez_id":["54971"],"uniprot":["Q8N9N5"],"ncbi_summary":"This gene encodes a protein that binds to matrix attachment regions. The protein forms a complex with p53 and negatively regulates p53 transcription, and functions as a tumor suppressor and cell cycle regulator. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8N9N5","text":"Controls V(D)J recombination during T-cell development by repressing T-cell receptor (TCR) beta enhancer function (By similarity). Binds to scaffold/matrix attachment region beta (S/MARbeta), an ATC-rich DNA sequence located upstream of the TCR beta enhancer (By similarity). Represses cyclin D1 transcription by recruiting HDAC1 to its promoter, thereby diminishing H3K9ac, H3S10ph and H4K8ac levels (PubMed:16166625). Promotes TP53 activation, which causes cell cycle arrest (By similarity). Plays a role in the regulation of alternative splicing (PubMed:26080397). Binds to CD44 pre-mRNA and negatively regulates the inclusion of CD44 proximal variable exons v2-v6 but has no effect on distal variable exons v7-v10 (PubMed:26080397)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}