_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.472607,"nucleus_log2fc":-0.156369,"nucleus_score":-1.3466,"pct_ad":0.160126,"pct_control":0.183142,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"SRSF2","gene_symbol_current":"SRSF2","gene_id":"ENSG00000161547","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.959548,"donor_log2fc":-0.0324329,"donor_lfcse":0.121705,"donor_log2fc_shrunk":-0.00196003}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000161547","module":"brown","kme":0.195492,"hub":false,"module_direction":"lower in AD","module_padj":0.652213,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000161547","module":"turquoise","kme":0.249262,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000161547","module":"turquoise","kme":0.227024,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000161547","module":"turquoise","kme":0.159417,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000161547","entrez_id":["6427"],"uniprot":["Q01130"],"ncbi_summary":"The protein encoded by this gene is a member of the serine/arginine (SR)-rich family of pre-mRNA splicing factors, which constitute part of the spliceosome. Each of these factors contains an RNA recognition motif (RRM) for binding RNA and an RS domain for binding other proteins. The RS domain is rich in serine and arginine residues and facilitates interaction between different SR splicing factors. In addition to being critical for mRNA splicing, the SR proteins have also been shown to be involved in mRNA export from the nucleus and in translation. Two transcript variants encoding the same protein and one non-coding transcript variant have been found for this gene. In addition, a pseudogene of this gene has been found on chromosome 11. [provided by RefSeq, Sep 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q01130","text":"Necessary for the splicing of pre-mRNA. It is required for formation of the earliest ATP-dependent splicing complex and interacts with spliceosomal components bound to both the 5'- and 3'-splice sites during spliceosome assembly. It also is required for ATP-dependent interactions of both U1 and U2 snRNPs with pre-mRNA. Interacts with other spliceosomal components, via the RS domains, to form a bridge between the 5'- and 3'-splice site binding components, U1 snRNP and U2AF. Binds to purine-rich RNA sequences, either 5'-AGSAGAGTA-3' (S=C or G) or 5'-GTTCGAGTA-3'. Can bind to beta-globin mRNA and commit it to the splicing pathway. The phosphorylated form (by SRPK2) is required for cellular apoptosis in response to cisplatin treatment."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}