ficant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.286924,"nucleus_log2fc":-0.125745,"nucleus_score":-1.41726,"pct_ad":0.133164,"pct_control":0.141236,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.00385256,"donor_lfcse":0.117107,"donor_log2fc_shrunk":-2.86398e-07},{"cell_type":"Oli","gene_symbol":"KLHL25","gene_symbol_current":"KLHL25","gene_id":"ENSG00000183655","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.870532,"donor_log2fc":0.128227,"donor_lfcse":0.14405,"donor_log2fc_shrunk":0.00659204}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000183655","module":"brown","kme":0.136947,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000183655","module":"blue","kme":0.248438,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000183655","entrez_id":["64410"],"uniprot":["Q9H0H3"],"ncbi_summary":"Involved in protein ubiquitination; regulation of translational initiation; and ubiquitin-dependent protein catabolic process. Located in cytoplasm. Part of Cul3-RING ubiquitin ligase complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H0H3","text":"Substrate-specific adapter of a BCR (BTB-CUL3-RBX1) E3 ubiquitin ligase complex involved in various processes, such as translation homeostasis and lipid synthesis (PubMed:22578813, PubMed:27664236, PubMed:34491895). The BCR(KLHL25) ubiquitin ligase complex acts by mediating ubiquitination of hypophosphorylated EIF4EBP1 (4E-BP1): ubiquitination and subsequent degradation of hypophosphorylated EIF4EBP1 (4E-BP1) probably serves as a homeostatic mechanism to maintain translation and prevent eIF4E inhibition when eIF4E levels are low (PubMed:22578813). The BCR(KLHL25) complex does not target EIF4EBP1 (4E-BP1) when it is hyperphosphorylated or associated with eIF4E (PubMed:22578813). The BCR(KLHL25) complex also acts as a regulator of lipid synthesis by mediating ubiquitination and degradation of ACLY, thereby inhibiting lipid synthesis (PubMed:27664236, PubMed:34491895). BCR(KLHL25)-mediated degradation of ACLY promotes fatty acid oxidation and is required for differentiation of inducible regulatory T (iTreg) cells (PubMed:34491895)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}