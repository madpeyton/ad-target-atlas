onor_lfcse":0.209305,"donor_log2fc_shrunk":1.16356e-05},{"cell_type":"Oli","gene_symbol":"DFNB31","gene_symbol_current":"WHRN","gene_id":"ENSG00000095397","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.12654,"nucleus_log2fc":0.116705,"nucleus_score":1.82073,"pct_ad":0.106294,"pct_control":0.0977603,"donor_test":"not significant","donor_padj":0.938389,"donor_log2fc":0.045442,"donor_lfcse":0.0881385,"donor_log2fc_shrunk":0.00520387}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000095397","module":"turquoise","kme":0.0484426,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000095397","entrez_id":["25861"],"uniprot":["Q9P202"],"ncbi_summary":"This gene is thought to function in the organization and stabilization of sterocilia elongation and actin cystoskeletal assembly, based on studies of the related mouse gene. Mutations in this gene have been associated with autosomal recessive non-syndromic deafness and Usher Syndrome. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Nov 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9P202","text":"Involved in hearing and vision as member of the USH2 complex. Necessary for elongation and maintenance of inner and outer hair cell stereocilia in the organ of Corti in the inner ear. Involved in the maintenance of the hair bundle ankle region, which connects stereocilia in cochlear hair cells of the inner ear. In retina photoreceptors, required for the maintenance of periciliary membrane complex that seems to play a role in regulating intracellular protein transport."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}