or_lfcse":0.14865,"donor_log2fc_shrunk":0.0060797,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"GRK4","gene_symbol_current":"GRK4","gene_id":"ENSG00000125388","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.837349,"nucleus_log2fc":0.0209797,"nucleus_score":0.324553,"pct_ad":0.498061,"pct_control":0.501439,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0259166,"donor_lfcse":0.0888371,"donor_log2fc_shrunk":3.39825e-06,"degas_log2fc":-0.317127,"degas_padj":8.30608e-17},{"cell_type":"Oli","gene_symbol":"GRK4","gene_symbol_current":"GRK4","gene_id":"ENSG00000125388","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.881419,"nucleus_log2fc":0.00725059,"nucleus_score":-0.175589,"pct_ad":0.230596,"pct_control":0.231764,"donor_test":"not significant","donor_padj":0.969057,"donor_log2fc":0.0324264,"donor_lfcse":0.108029,"donor_log2fc_shrunk":0.00417052,"degas_log2fc":-0.107458,"degas_padj":1.61865e-05}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000125388","module":"turquoise","kme":0.0758516,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000125388","module":"blue","kme":0.102019,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000125388","entrez_id":["2868"],"uniprot":["P32298"],"ncbi_summary":"This gene encodes a member of the guanine nucleotide-binding protein (G protein)-coupled receptor kinase subfamily of the Ser/Thr protein kinase family. The protein phosphorylates the activated forms of G protein-coupled receptors thus initiating its deactivation. This gene has been linked to both genetic and acquired hypertension. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Nov 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P32298","text":"Specifically phosphorylates the activated forms of G protein-coupled receptors, such as ADRB2, DRD1 and DRD3 (PubMed:16338988, PubMed:19520868). Such receptor phosphorylation initiates beta-arrestin-mediated receptor internalization, and signaling events leading to their desensitization (PubMed:16338988, PubMed:19520868). Mediates phosphorylation of DRD1 in the absence of dopamine activation, resulting in constitutive desensitization (PubMed:16338988). [Isoform 1]: Phosphorylates rhodopsin and its activity is inhibited by calmodulin. [Isoform 2]: In contrast to isoform 1, does not phosphorylate rhodopsin and does not interact with calmodulin. [Isoform 3]: In contrast to isoform 1, does not phosphorylate rhodopsin and does not interact with calmodulin. [Isoform 4]: In contrast to isoform 1, does not phosphorylate rhodopsin and does not interact with calmodulin."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}