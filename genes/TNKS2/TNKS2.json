symbol_current":"TNKS2","gene_id":"ENSG00000107854","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.154131,"nucleus_log2fc":-0.0155579,"nucleus_score":-1.53763,"pct_ad":0.341951,"pct_control":0.349725,"donor_test":"not significant","donor_padj":0.982394,"donor_log2fc":0.00996686,"donor_lfcse":0.063829,"donor_log2fc_shrunk":0.00228381,"degas_log2fc":-0.189611,"degas_padj":1.48975e-21}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000107854","entrez_id":["80351"],"uniprot":["Q9H2K2"],"ncbi_summary":"Enables NAD+ ADP-ribosyltransferase activity; enzyme binding activity; and protein ADP-ribosylase activity. Involved in several processes, including protein ADP-ribosylation; protein localization to chromosome, telomeric region; and regulation of telomere maintenance. Located in nuclear envelope; pericentriolar material; and perinuclear region of cytoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H2K2","text":"Poly-ADP-ribosyltransferase involved in various processes such as Wnt signaling pathway, telomere length and vesicle trafficking (PubMed:11739745, PubMed:11802774, PubMed:19759537, PubMed:21478859, PubMed:23622245, PubMed:25043379). Acts as an activator of the Wnt signaling pathway by mediating poly-ADP-ribosylation of AXIN1 and AXIN2, 2 key components of the beta-catenin destruction complex: poly-ADP-ribosylated target proteins are recognized by RNF146, which mediates their ubiquitination and subsequent degradation (PubMed:19759537, PubMed:21478859). Also mediates poly-ADP-ribosylation of BLZF1 and CASC3, followed by recruitment of RNF146 and subsequent ubiquitination (PubMed:21478859). Mediates poly-ADP-ribosylation of TERF1, thereby contributing to the regulation of telomere length (PubMed:11739745). Stimulates 26S proteasome activity (PubMed:23622245)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}