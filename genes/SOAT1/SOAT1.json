ue","kme":0.0994212,"hub":false,"module_direction":"higher in AD","module_padj":0.903036,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000057252"],"dataset_symbols":["SOAT1"],"explorer":"explorer.html?dataset=mathys2019#gene/SOAT1","cell_types":[{"cell_type":"Ex","gene_symbol":"SOAT1","gene_symbol_current":"SOAT1","gene_id":"ENSG00000057252","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.628633,"nucleus_log2fc":0.0642199,"nucleus_score":0.584205,"pct_ad":0.115705,"pct_control":0.113575,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.111321,"donor_lfcse":0.0959825,"donor_log2fc_shrunk":1.39537e-05},{"cell_type":"In","gene_symbol":"SOAT1","gene_symbol_current":"SOAT1","gene_id":"ENSG00000057252","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0137578,"donor_lfcse":0.162062,"donor_log2fc_shrunk":5.41258e-07},{"cell_type":"Mic","gene_symbol":"SOAT1","gene_symbol_current":"SOAT1","gene_id":"ENSG00000057252","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.988721,"nucleus_log2fc":0.0434634,"nucleus_score":0.0376832,"pct_ad":0.131611,"pct_control":0.132335,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000057252","entrez_id":["6646"],"uniprot":["P35610"],"ncbi_summary":"The protein encoded by this gene belongs to the acyltransferase family. It is located in the endoplasmic reticulum, and catalyzes the formation of fatty acid-cholesterol esters. This gene has been implicated in the formation of beta-amyloid and atherosclerotic plaques by controlling the equilibrium between free cholesterol and cytoplasmic cholesteryl esters. Alternatively spliced transcript variants have been found for this gene. [provided by RefSeq, Nov 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P35610","text":"Catalyzes the formation of fatty acid-cholesterol esters, which are less soluble in membranes than cholesterol (PubMed:16154994, PubMed:16647063, PubMed:32433613, PubMed:32433614, PubMed:32944968, PubMed:9020103). Plays a role in lipoprotein assembly and dietary cholesterol absorption (PubMed:16154994, PubMed:9020103). Preferentially utilizes oleoyl-CoA ((9Z)-octadecenoyl-CoA) as a substrate: shows a higher activity towards an acyl-CoA substrate with a double bond at the delta-9 position (9Z) than towards saturated acyl-CoA or an unsaturated acyl-CoA with a double bond at the delta-7 (7Z) or delta-11 (11Z) positions (PubMed:11294643, PubMed:32433614)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}