t":false},{"cell_type":"Ex","gene_id":"ENSG00000133112","module":"turquoise","kme":0.424516,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000133112","module":"turquoise","kme":0.352826,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000133112","module":"turquoise","kme":0.162586,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000133112","module":"turquoise","kme":0.222756,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000133112","entrez_id":["7178"],"uniprot":["P13693"],"ncbi_summary":"This gene encodes a protein that is a regulator of cellular growth and proliferation. Its mRNA is highly structured and contains an oligopyrimidine tract (5'-TOP) in its 5' untranslated region that functions to repress its translation under quiescent conditions. The encoded protein is involved in a variety of cellular pathways, including apoptosis, protein synthesis and cell division. It binds to and stabilizes microtubules, and removal of this protein through phosphorylation is required for progression through mitotic and meiotic cell divisions. This gene is known to play a role in carcinogenesis, and is upregulated in some cancer cells. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Aug 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P13693","text":"Involved in calcium binding and microtubule stabilization (PubMed:12167714, PubMed:15162379, PubMed:15958728). Acts as a negative regulator of TSC22D1-mediated apoptosis, via interaction with and destabilization of TSC22D1 protein (PubMed:18325344)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}