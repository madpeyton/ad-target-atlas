e},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000165861"],"dataset_symbols":["ZFYVE1"],"explorer":"explorer.html?dataset=mathys2019#gene/ZFYVE1","cell_types":[{"cell_type":"Ex","gene_symbol":"ZFYVE1","gene_symbol_current":"ZFYVE1","gene_id":"ENSG00000165861","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0586452,"nucleus_log2fc":-0.082675,"nucleus_score":-2.10483,"pct_ad":0.165278,"pct_control":0.176025,"donor_test":"not significant","donor_padj":0.994258,"donor_log2fc":-0.0164245,"donor_lfcse":0.067714,"donor_log2fc_shrunk":-1.64534e-05},{"cell_type":"In","gene_symbol":"ZFYVE1","gene_symbol_current":"ZFYVE1","gene_id":"ENSG00000165861","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.11138,"donor_lfcse":0.159847,"donor_log2fc_shrunk":-1.48902e-05},{"cell_type":"Oli","gene_symbol":"ZFYVE1","gene_symbol_current":"ZFYVE1","gene_id":"ENSG00000165861","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.959523,"donor_log2fc":0.0407065,"donor_lfcse":0.141545,"donor_log2fc_shrunk":0.00191458}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165861","entrez_id":["53349"],"uniprot":["Q9HBF4"],"ncbi_summary":"The FYVE domain mediates the recruitment of proteins involved in membrane trafficking and cell signaling to phosphatidylinositol 3-phosphate-containing membranes. This protein contains two zinc-binding FYVE domains in tandem and is reported to localize to the Golgi apparatus. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9HBF4","text":"Plays a role in the formation of lipid droplets (LDs) which are storage organelles at the center of lipid and energy homeostasis (PubMed:30970241). Regulates the morphology, size and distribution of LDs (PubMed:30970241, PubMed:31293035). Mediates the formation of endoplasmic reticulum-lipid droplets (ER-LD) contacts by forming a complex with RAB18 and ZW10 (PubMed:30970241). Binds to phosphatidylinositol 3-phosphate (PtdIns3P) through FYVE-type zinc finger (PubMed:11256955, PubMed:11739631). (Microbial infection) Upon SARS coronavirus-2/SARS-CoV-2 infection, mediates through binding with non-structural protein 6 (nsp6) the replication organelle-lipid droplet association required to sustain viral replication."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}