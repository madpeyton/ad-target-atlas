unk":-3.1212e-05},{"cell_type":"In","gene_symbol":"DAAM1","gene_symbol_current":"DAAM1","gene_id":"ENSG00000100592","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.347435,"nucleus_log2fc":-0.105203,"nucleus_score":-1.87782,"pct_ad":0.613576,"pct_control":0.633987,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0459099,"donor_lfcse":0.0528058,"donor_log2fc_shrunk":-1.70245e-05},{"cell_type":"Mic","gene_symbol":"DAAM1","gene_symbol_current":"DAAM1","gene_id":"ENSG00000100592","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.659773,"nucleus_log2fc":-0.240561,"nucleus_score":-0.952376,"pct_ad":0.0897909,"pct_control":0.10362,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"DAAM1","gene_symbol_current":"DAAM1","gene_id":"ENSG00000100592","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.307969,"nucleus_log2fc":-0.206185,"nucleus_score":-1.80899,"pct_ad":0.182889,"pct_control":0.216092,"donor_test":"not significant","donor_padj":0.986209,"donor_log2fc":-0.116714,"donor_lfcse":0.162348,"donor_log2fc_shrunk":-0.000913965},{"cell_type":"Oli","gene_symbol":"DAAM1","gene_symbol_current":"DAAM1","gene_id":"ENSG00000100592","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.780549,"donor_log2fc":-0.202172,"donor_lfcse":0.14457,"donor_log2fc_shrunk":-0.00953372}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000100592","module":"black","kme":0.14304,"hub":false,"module_direction":"higher in AD","module_padj":0.56571,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000100592","module":"blue","kme":0.238598,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000100592","module":"brown","kme":0.230328,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100592","entrez_id":["23002"],"uniprot":["Q9Y4D1"],"ncbi_summary":"Cell motility, adhesion, cytokinesis, and other functions of the cell cortex are mediated by reorganization of the actin cytoskeleton and several formin homology (FH) proteins have been associated with these processes. The protein encoded by this gene contains two FH domains and belongs to a novel FH protein subfamily implicated in cell polarity. A key regulator of cytoskeletal architecture, the small GTPase Rho, is activated during development by Wnt/Fz signaling to control cell polarity and movement. The protein encoded by this gene is thought to function as a scaffolding protein for the Wnt-induced assembly of a disheveled (Dvl)-Rho complex. This protein also promotes the nucleation and elongation of new actin filaments and regulates cell growth through the stabilization of microtubules. Alternative splicing results in multiple transcript variants encoding distinct proteins. [provided by RefSeq, Jul 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y4D1","text":"Binds to disheveled (Dvl) and Rho, and mediates Wnt-induced Dvl-Rho complex formation. May play a role as a scaffolding protein to recruit Rho-GDP and Rho-GEF, thereby enhancing Rho-GTP formation. Can direct nucleation and elongation of new actin filaments. Involved in building functional cilia (PubMed:16630611, PubMed:17482208). Involved in the organization of the subapical actin network in multiciliated epithelial cells (By similarity). Together with DAAM2, required for myocardial maturation and sarcomere assembly (By similarity). During cell division, may regulate RHOA activation that signals spindle orientation and chromosomal segregation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}