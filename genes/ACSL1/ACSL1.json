":30,"top_screening_hits":[{"name":null,"compound_id":"Z234423640_1_T2","accession":"P33121","score":7.07417},{"name":null,"compound_id":"Z739521186_1_T3","accession":"P33121","score":6.97229},{"name":null,"compound_id":"Z768708340_2_T1","accession":"P33121","score":6.79337},{"name":null,"compound_id":"PV-002036256308_1_T1","accession":"P33121","score":6.57536},{"name":null,"compound_id":"PV-002033155588_1_T2","accession":"P33121","score":6.51472}],"notes":[]}},"description":[{"gene_id":"ENSG00000151726","entrez_id":["2180"],"uniprot":["P33121"],"ncbi_summary":"The protein encoded by this gene is an isozyme of the long-chain fatty-acid-coenzyme A ligase family. Although differing in substrate specificity, subcellular localization, and tissue distribution, all isozymes of this family convert free long-chain fatty acids into fatty acyl-CoA esters, and thereby play a key role in lipid biosynthesis and fatty acid degradation. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Nov 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P33121","text":"Catalyzes the conversion of long-chain fatty acids to their active form acyl-CoAs for both synthesis of cellular lipids, and degradation via beta-oxidation (PubMed:21242590, PubMed:22633490, PubMed:24269233). Preferentially uses palmitoleate, oleate and linoleate (PubMed:24269233). Preferentially activates arachidonate than epoxyeicosatrienoic acids (EETs) or hydroxyeicosatrienoic acids (HETEs) (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":["P33121"]}