ull,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.282388,"donor_lfcse":0.291672,"donor_log2fc_shrunk":-4.13627e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"DOCK2","gene_symbol_current":"DOCK2","gene_id":"ENSG00000134516","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":9.02283e-57,"nucleus_log2fc":-0.422001,"nucleus_score":-16.0373,"pct_ad":0.158901,"pct_control":0.205715,"donor_test":"not significant","donor_padj":0.775505,"donor_log2fc":-0.354897,"donor_lfcse":0.265045,"donor_log2fc_shrunk":-0.00576565,"degas_log2fc":0.400962,"degas_padj":7.59563e-45}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000134516","module":"turquoise","kme":0.340983,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000134516","module":"blue","kme":0.384594,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000134516","module":"turquoise","kme":0.109352,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000134516","module":"turquoise","kme":0.257333,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000134516","entrez_id":["1794"],"uniprot":["Q92608"],"ncbi_summary":"The protein encoded by this gene belongs to the CDM protein family. It is specifically expressed in hematopoietic cells and is predominantly expressed in peripheral blood leukocytes. The protein is involved in remodeling of the actin cytoskeleton required for lymphocyte migration in response to chemokine signaling. It activates members of the Rho family of GTPases, for example RAC1 and RAC2, by acting as a guanine nucleotide exchange factor (GEF) to exchange bound GDP for free GTP. Mutations in this gene result in immunodeficiency 40 (IMD40), a combined form of immunodeficiency that affects T cell number and function, also with variable defects in B cell and NK cell function. [provided by RefSeq, May 2018].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92608","text":"Guanine nucleotide exchange factor (GEF) that activates monomeric GTPases by catalysing the release of bound GDP in exchange for free GTP (PubMed:32651375). Activates RAC1 and RAC2, but not CDC42 (PubMed:21613211, PubMed:32651375). Involved in cytoskeletal rearrangements required for lymphocyte migration in response of chemokines (PubMed:21613211). May also participate in IL2 transcriptional activation via the activation of RAC2 (PubMed:21613211)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}