symbol_current":"CDH23","gene_id":"ENSG00000107736","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000209452,"nucleus_log2fc":-0.12611,"nucleus_score":-3.85558,"pct_ad":0.138566,"pct_control":0.148533,"donor_test":"not significant","donor_padj":0.86925,"donor_log2fc":-0.222089,"donor_lfcse":0.248024,"donor_log2fc_shrunk":-0.00407129,"degas_log2fc":-0.360507,"degas_padj":4.39967e-30}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000107736","module":"yellow","kme":0.244985,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000107736","module":"turquoise","kme":0.000130971,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":true,"target_cell_types":[{"cell_type":"Ast","rank":10}],"approved_drugs_status":"not tested","approved_drugs_reason":"no structure with a usable bound ligand (drug-sized, not an additive, on this protein)","screening_hits_status":"not tested","screening_hits_reason":"not in GenomeScreenDB","approved_drugs":[],"n_screening_hits":0,"top_screening_hits":[],"notes":[]}},"description":[{"gene_id":"ENSG00000107736","entrez_id":["64072"],"uniprot":["Q9H251"],"ncbi_summary":"This gene is a member of the cadherin superfamily, whose genes encode calcium dependent cell-cell adhesion glycoproteins. The encoded protein is thought to be involved in stereocilia organization and hair bundle formation. The gene is located in a region containing the human deafness loci DFNB12 and USH1D. Usher syndrome 1D and nonsyndromic autosomal recessive deafness DFNB12 are caused by allelic mutations of this cadherin-like gene. Upregulation of this gene may also be associated with breast cancer. Alternative splice variants encoding different isoforms have been described. [provided by RefSeq, May 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H251","text":"Cadherins are calcium-dependent cell adhesion proteins. They preferentially interact with themselves in a homophilic manner in connecting cells. CDH23 is required for establishing and/or maintaining the proper organization of the stereocilia bundle of hair cells in the cochlea and the vestibule during late embryonic/early postnatal development. It is part of the functional network formed by USH1C, USH1G, CDH23 and MYO7A that mediates mechanotransduction in cochlear hair cells. Required for normal hearing."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":["Q9H251"]}