 AD","nucleus_padj":0.270272,"nucleus_log2fc":0.07973,"nucleus_score":1.31257,"pct_ad":0.183008,"pct_control":0.176037,"donor_test":"not significant","donor_padj":0.729097,"donor_log2fc":0.0893638,"donor_lfcse":0.0793715,"donor_log2fc_shrunk":0.0254313},{"cell_type":"OPC","gene_symbol":"PSMD5","gene_symbol_current":"PSMD5","gene_id":"ENSG00000095261","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.406416,"nucleus_log2fc":0.0317278,"nucleus_score":1.13782,"pct_ad":0.324486,"pct_control":0.31177,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0187439,"donor_lfcse":0.0781045,"donor_log2fc_shrunk":5.13657e-06},{"cell_type":"Oli","gene_symbol":"PSMD5","gene_symbol_current":"PSMD5","gene_id":"ENSG00000095261","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0895511,"nucleus_log2fc":-0.0418243,"nucleus_score":-1.82041,"pct_ad":0.203125,"pct_control":0.208975,"donor_test":"not significant","donor_padj":0.941143,"donor_log2fc":-0.0376131,"donor_lfcse":0.0784376,"donor_log2fc_shrunk":-0.00588469}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000095261","module":"yellow","kme":0.0763859,"hub":false,"module_direction":"higher in AD","module_padj":0.663532,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000095261","entrez_id":["5711"],"uniprot":["Q16401"],"ncbi_summary":"The 26S proteasome is a multicatalytic proteinase complex with a highly ordered structure composed of 2 complexes, a 20S core and a 19S regulator. The 20S core is composed of 4 rings of 28 non-identical subunits; 2 rings are composed of 7 alpha subunits and 2 rings are composed of 7 beta subunits. The 19S regulator is composed of a base, which contains 6 ATPase subunits and 2 non-ATPase subunits, and a lid, which contains up to 10 non-ATPase subunits. Proteasomes are distributed throughout eukaryotic cells at a high concentration and cleave peptides in an ATP/ubiquitin-dependent process in a non-lysosomal pathway. This gene encodes a non-ATPase subunit of the 19S regulator base that functions as a chaperone protein during 26S proteasome assembly. [provided by RefSeq, Jul 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q16401","text":"Acts as a chaperone during the assembly of the 26S proteasome, specifically of the base subcomplex of the PA700/19S regulatory complex (RC). In the initial step of the base subcomplex assembly is part of an intermediate PSMD5:PSMC2:PSMC1:PSMD2 module which probably assembles with a PSMD10:PSMC4:PSMC5:PAAF1 module followed by dissociation of PSMD5."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}