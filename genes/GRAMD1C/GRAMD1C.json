ion":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.64306,"donor_log2fc":0.526086,"donor_lfcse":0.28486,"donor_log2fc_shrunk":0.00692068}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000178075","module":"greenyellow","kme":0.445172,"hub":false,"module_direction":"higher in AD","module_padj":0.866421,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000178075","module":"blue","kme":0.226972,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000178075","module":"turquoise","kme":0.00839782,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000178075","entrez_id":["54762"],"uniprot":["Q8IYS0"],"ncbi_summary":"Predicted to enable cholesterol binding activity and cholesterol transfer activity. Predicted to be involved in cellular response to cholesterol. Predicted to be located in endoplasmic reticulum membrane; endoplasmic reticulum-plasma membrane contact site; and plasma membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IYS0","text":"Cholesterol transporter that mediates non-vesicular transport of cholesterol from the plasma membrane (PM) to the endoplasmic reticulum (ER) (By similarity). Contains unique domains for binding cholesterol and the PM, thereby serving as a molecular bridge for the transfer of cholesterol from the PM to the ER (By similarity). Plays a crucial role in cholesterol homeostasis and has the unique ability to localize to the PM based on the level of membrane cholesterol (By similarity). In lipid-poor conditions localizes to the ER membrane and in response to excess cholesterol in the PM is recruited to the endoplasmic reticulum-plasma membrane contact sites (EPCS) which is mediated by the GRAM domain (By similarity). At the EPCS, the sterol-binding VASt/ASTER domain binds to the cholesterol in the PM and facilitates its transfer from the PM to ER (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}