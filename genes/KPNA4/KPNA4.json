":2.06987e-67},{"cell_type":"In","gene_symbol":"KPNA4","gene_symbol_current":"KPNA4","gene_id":"ENSG00000186432","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0165232,"nucleus_log2fc":-0.017463,"nucleus_score":-2.47092,"pct_ad":0.571438,"pct_control":0.581703,"donor_test":"not significant","donor_padj":0.846812,"donor_log2fc":0.0495229,"donor_lfcse":0.0691683,"donor_log2fc_shrunk":0.0046318,"degas_log2fc":-0.120275,"degas_padj":6.07044e-45},{"cell_type":"Mic","gene_symbol":"KPNA4","gene_symbol_current":"KPNA4","gene_id":"ENSG00000186432","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.38335e-07,"nucleus_log2fc":0.191593,"nucleus_score":5.5868,"pct_ad":0.437604,"pct_control":0.402995,"donor_test":"not significant","donor_padj":0.416818,"donor_log2fc":0.183155,"donor_lfcse":0.0873443,"donor_log2fc_shrunk":0.0678715,"degas_log2fc":0.0779901,"degas_padj":0.0388473},{"cell_type":"OPC","gene_symbol":"KPNA4","gene_symbol_current":"KPNA4","gene_id":"ENSG00000186432","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0624265,"nucleus_log2fc":0.0961987,"nucleus_score":2.31239,"pct_ad":0.388458,"pct_control":0.366808,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.072,"donor_lfcse":0.0837056,"donor_log2fc_shrunk":1.05285e-05,"degas_log2fc":-0.38231,"degas_padj":8.7509e-18},{"cell_type":"Oli","gene_symbol":"KPNA4","gene_symbol_current":"KPNA4","gene_id":"ENSG00000186432","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0715039,"nucleus_log2fc":-0.0247309,"nucleus_score":-1.92808,"pct_ad":0.335134,"pct_control":0.344554,"donor_test":"not significant","donor_padj":0.983293,"donor_log2fc":-0.013527,"donor_lfcse":0.0895875,"donor_log2fc_shrunk":-0.00182803,"degas_log2fc":-0.268921,"degas_padj":1.0079e-40}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000186432","module":"blue","kme":0.133191,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000186432","module":"blue","kme":0.139653,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000186432","entrez_id":["3840"],"uniprot":["O00629"],"ncbi_summary":"The nuclear import of karyophilic proteins is directed by short amino acid sequences termed nuclear localization signals (NLSs). Karyopherins, or importins, are cytoplasmic proteins that recognize NLSs and dock NLS-containing proteins to the nuclear pore complex. The protein encoded by this gene shares the sequence similarity with Xenopus importin-alpha and Saccharomyces cerevisiae Srp1. This protein is found to interact with the NLSs of DNA helicase Q1 and SV40 T antigen. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00629","text":"Functions in nuclear protein import as an adapter protein for nuclear receptor KPNB1 (PubMed:10567565, PubMed:20818336, PubMed:28760339, PubMed:29042532, PubMed:38512451). Binds specifically and directly to substrates containing either a simple or bipartite NLS motif (PubMed:20818336, PubMed:28760339, PubMed:29042532, PubMed:38512451). Docking of the importin/substrate complex to the nuclear pore complex (NPC) is mediated by KPNB1 through binding to nucleoporin FxFG repeats and the complex is subsequently translocated through the pore by an energy requiring, Ran-dependent mechanism (PubMed:20818336, PubMed:28760339, PubMed:29042532, PubMed:38512451). At the nucleoplasmic side of the NPC, Ran binds to importin-beta and the three components separate and importin-alpha and -beta are re-exported from the nucleus to the cytoplasm where GTP hydrolysis releases Ran from importin (PubMed:20818336, PubMed:28760339, PubMed:29042532, PubMed:38512451). The directionality of nuclear import is thought to be conferred by an asymmetric distribution of the GTP- and GDP-bound forms of Ran between the cytoplasm and nucleus (PubMed:20818336, PubMed:28760339, PubMed:29042532, PubMed:38512451). Mediates nuclear import of AARS1, MRTFA and RANBP3 (PubMed:10567565, PubMed:20818336, PubMed:28760339, PubMed:38512451). (Microbial infection) In vitro, mediates the nuclear import of human cytomegalovirus UL84 by recognizing a non-classical NLS. In vitro, mediates the nuclear import of human cytomegalovirus UL84 by recognizing a non-classical NLS."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}