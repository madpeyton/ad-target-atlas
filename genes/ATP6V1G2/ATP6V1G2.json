eus_direction":"unclear","nucleus_padj":0.65441,"nucleus_log2fc":0.00327449,"nucleus_score":-0.66296,"pct_ad":0.104682,"pct_control":0.108721,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0476224,"donor_lfcse":0.155302,"donor_log2fc_shrunk":-1.78193e-06,"degas_log2fc":0.275423,"degas_padj":0.00214681},{"cell_type":"Oli","gene_symbol":"ATP6V1G2","gene_symbol_current":"ATP6V1G2","gene_id":"ENSG00000213760","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.990301,"donor_log2fc":-0.0128758,"donor_lfcse":0.152626,"donor_log2fc_shrunk":-0.000507716,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000213760","module":"turquoise","kme":0.036907,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000213760","module":"brown","kme":0.446072,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000213760","module":"brown","kme":0.297343,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000213760","module":"turquoise","kme":0.0900288,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000213760","module":"turquoise","kme":0.0569616,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000213760","entrez_id":["534"],"uniprot":["O95670"],"ncbi_summary":"This gene encodes a component of vacuolar ATPase (V-ATPase), a multisubunit enzyme that mediates acidification of intracellular compartments of eukaryotic cells. V-ATPase dependent acidification is necessary for such intracellular processes as protein sorting, zymogen activation, receptor-mediated endocytosis, and synaptic vesicle proton gradient generation. V-ATPase is composed of a cytosolic V1 domain and a transmembrane V0 domain. The V1 domain consists of three A and three B subunits, two G subunits plus the C, D, E, F, and H subunits. The V1 domain contains the ATP catalytic site. The V0 domain consists of five different subunits: a, c, c', c'', and d. Additional isoforms of many of the V1 and V0 subunit proteins are encoded by multiple genes or alternatively spliced transcript variants. This encoded protein is one of three V1 domain G subunit proteins. This gene had previous gene symbols of ATP6G and ATP6G2. Alternatively spliced transcript variants encoding different isoforms have been described. Read-through transcription also exists between this gene and the downstream DEAD (Asp-Glu-Ala-Asp) box polypeptide 39B (DDX39B) gene. [provided by RefSeq, Feb 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95670","text":"Subunit of the V1 complex of vacuolar(H+)-ATPase (V-ATPase), a multisubunit enzyme composed of a peripheral complex (V1) that hydrolyzes ATP and a membrane integral complex (V0) that translocates protons. V-ATPase is responsible for acidifying and maintaining the pH of intracellular compartments and in some cell types, is targeted to the plasma membrane, where it is responsible for acidifying the extracellular environment."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}