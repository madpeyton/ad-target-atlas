lfcse":0.127756,"donor_log2fc_shrunk":-7.41693e-08,"degas_log2fc":0.441375,"degas_padj":4.18646e-19},{"cell_type":"Oli","gene_symbol":"COMT","gene_symbol_current":"COMT","gene_id":"ENSG00000093010","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":6.12185e-13,"nucleus_log2fc":0.160197,"nucleus_score":7.35824,"pct_ad":0.333863,"pct_control":0.310273,"donor_test":"not significant","donor_padj":0.760866,"donor_log2fc":0.173139,"donor_lfcse":0.12494,"donor_log2fc_shrunk":0.0122756,"degas_log2fc":0.263874,"degas_padj":6.86916e-36}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000093010","module":"blue","kme":0.0189073,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000093010","module":"turquoise","kme":0.157102,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000093010","module":"turquoise","kme":0.231067,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000093010","entrez_id":["1312"],"uniprot":["P21964"],"ncbi_summary":"Catechol-O-methyltransferase catalyzes the transfer of a methyl group from S-adenosylmethionine to catecholamines, including the neurotransmitters dopamine, epinephrine, and norepinephrine. This O-methylation results in one of the major degradative pathways of the catecholamine transmitters. In addition to its role in the metabolism of endogenous substances, COMT is important in the metabolism of catechol drugs used in the treatment of hypertension, asthma, and Parkinson disease. COMT is found in two forms in tissues, a soluble form (S-COMT) and a membrane-bound form (MB-COMT). The differences between S-COMT and MB-COMT reside within the N-termini. Several transcript variants are formed through the use of alternative translation initiation sites and promoters. [provided by RefSeq, Sep 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P21964","text":"Catalyzes the O-methylation, and thereby the inactivation, of catecholamine neurotransmitters and catechol hormones. Also shortens the biological half-lives of certain neuroactive drugs, like L-DOPA, alpha-methyl DOPA and isoproterenol."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}