e_id":"ENSG00000145416","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000243069,"nucleus_log2fc":0.0690593,"nucleus_score":4.17375,"pct_ad":0.970922,"pct_control":0.970703,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0420144,"donor_lfcse":0.104988,"donor_log2fc_shrunk":3.96607e-06},{"cell_type":"Oli","gene_symbol":"MARCH1","gene_symbol_current":"MARCHF1","gene_id":"ENSG00000145416","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00599406,"nucleus_log2fc":-0.0282505,"nucleus_score":-2.88577,"pct_ad":0.973338,"pct_control":0.976593,"donor_test":"not significant","donor_padj":0.984493,"donor_log2fc":-0.0135837,"donor_lfcse":0.109126,"donor_log2fc_shrunk":-0.00114267}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000145416","module":"blue","kme":0.210546,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000145416","module":"black","kme":0.515522,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000145416","module":"pink","kme":0.513137,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000145416","module":"blue","kme":0.398113,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000145416","module":"blue","kme":0.275116,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000145416","entrez_id":["55016"],"uniprot":["Q8TCQ1"],"ncbi_summary":"MARCH1 is a member of the MARCH family of membrane-bound E3 ubiquitin ligases (EC 6.3.2.19). MARCH proteins add ubiquitin (see MIM 191339) to target lysines in substrate proteins, thereby signaling their vesicular transport between membrane compartments. MARCH1 downregulates the surface expression of major histocompatibility complex (MHC) class II molecules (see MIM 142880) and other glycoproteins by directing them to the late endosomal/lysosomal compartment (Bartee et al., 2004 [PubMed 14722266]; Thibodeau et al., 2008 [PubMed 18389477]; De Gassart et al., 2008 [PubMed 18305173]).[supplied by OMIM, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TCQ1","text":"E3 ubiquitin-protein ligase that mediates ubiquitination of TFRC, CD86, FAS and MHC class II proteins, such as HLA-DR alpha and beta, and promotes their subsequent endocytosis and sorting to lysosomes via multivesicular bodies (PubMed:18389477, PubMed:18305173, PubMed:21220452, PubMed:35045264). By constitutively ubiquitinating MHC class II proteins in immature dendritic cells, down-regulates their cell surface localization thus sequestering them in the intracellular endosomal system. Also regulates insulin sensitivity by controlling surface expression of the insulin receptor subunit beta/INSR by direct ubiquitination and degradation (PubMed:27577745). (Microbial infection) Plays a role in iron metabolism by regulating the levels of the transferrin receptor TFRC during human cytomegalovirus infection, subsequently contributing to a proviral effect."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}