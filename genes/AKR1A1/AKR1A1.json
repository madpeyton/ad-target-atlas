A1","gene_id":"ENSG00000117448","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.40932e-05,"nucleus_log2fc":-0.24647,"nucleus_score":-4.45217,"pct_ad":0.133787,"pct_control":0.153852,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.12636,"donor_lfcse":0.151157,"donor_log2fc_shrunk":-5.62223e-06},{"cell_type":"Mic","gene_symbol":"AKR1A1","gene_symbol_current":"AKR1A1","gene_id":"ENSG00000117448","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.916768,"nucleus_log2fc":0.104789,"nucleus_score":0.284082,"pct_ad":0.104551,"pct_control":0.101124,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"AKR1A1","gene_symbol_current":"AKR1A1","gene_id":"ENSG00000117448","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.785669,"donor_log2fc":-0.240518,"donor_lfcse":0.179985,"donor_log2fc_shrunk":-0.00708036}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000117448","module":"turquoise","kme":0.154753,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000117448","module":"turquoise","kme":0.150739,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000117448","module":"turquoise","kme":0.0801733,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000117448","entrez_id":["10327"],"uniprot":["P14550"],"ncbi_summary":"This gene encodes a member of the aldo/keto reductase superfamily, which consists of more than 40 known enzymes and proteins. This member, also known as aldehyde reductase, is involved in the reduction of biogenic and xenobiotic aldehydes and is present in virtually every tissue. Multiple alternatively spliced transcript variants of this gene exist, all encoding the same protein. [provided by RefSeq, Jan 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P14550","text":"Catalyzes the NADPH-dependent reduction of a wide variety of carbonyl-containing compounds to their corresponding alcohols (PubMed:10510318, PubMed:30538128). Displays enzymatic activity towards endogenous metabolites such as aromatic and aliphatic aldehydes, ketones, monosaccharides and bile acids, with a preference for negatively charged substrates, such as glucuronate and succinic semialdehyde (PubMed:10510318, PubMed:30538128). Functions as a detoxifiying enzyme by reducing a range of toxic aldehydes (By similarity). Reduces methylglyoxal and 3-deoxyglucosone, which are present at elevated levels under hyperglycemic conditions and are cytotoxic (By similarity). Involved also in the detoxification of lipid-derived aldehydes like acrolein (By similarity). Plays a role in the activation of procarcinogens, such as polycyclic aromatic hydrocarbon trans-dihydrodiols, and in the metabolism of various xenobiotics and drugs, including the anthracyclines doxorubicin (DOX) and daunorubicin (DAUN) (PubMed:11306097, PubMed:18276838). Also acts as an inhibitor of protein S-nitrosylation by mediating degradation of S-nitroso-coenzyme A (S-nitroso-CoA), a cofactor required to S-nitrosylate proteins (PubMed:30538128). S-nitroso-CoA reductase activity is involved in reprogramming intermediary metabolism in renal proximal tubules, notably by inhibiting protein S-nitrosylation of isoform 2 of PKM (PKM2) (By similarity). Also acts as a S-nitroso-glutathione reductase by catalyzing the NADPH-dependent reduction of S-nitrosoglutathione (PubMed:31649033). Displays no reductase activity towards retinoids (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}