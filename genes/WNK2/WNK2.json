b":false,"module_direction":"lower in AD","module_padj":0.923266,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000165238","module":"pink","kme":0.177164,"hub":false,"module_direction":"lower in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000165238","module":"turquoise","kme":0.146779,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000165238","module":"turquoise","kme":0.17525,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000165238"],"dataset_symbols":["WNK2"],"explorer":"explorer.html?dataset=mathys2019#gene/WNK2","cell_types":[{"cell_type":"Ast","gene_symbol":"WNK2","gene_symbol_current":"WNK2","gene_id":"ENSG00000165238","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.257378,"nucleus_log2fc":-0.122958,"nucleus_score":-1.44259,"pct_ad":0.12306,"pct_control":0.143787,"donor_test":"not significant","donor_padj":0.955977,"donor_log2fc":0.0415905,"donor_lfcse":0.170874,"donor_log2fc_shrunk":0.00294746},{"cell_type":"Ex","gene_symbol":"WNK2","gene_symbol_current":"WNK2","gene_id":"ENSG00000165238","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.216075,"nucleus_log2fc":0.0445787,"nucleus_score":1.4097,"pct_ad":0.589801,"pct_control":0.600494,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.047207,"donor_lfcse":0.0761417,"donor_log2fc_shrunk":-2.1394e-06},{"cell_type":"In","gene_symbol":"WNK2","gene_symbol_current":"WNK2","gene_id":"ENSG00000165238","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.569652,"nucleus_log2fc":-0.0913473,"nucleus_score":-1.29512,"pct_ad":0.388642,"pct_control":0.399627,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0578835,"donor_lfcse":0.0931807,"donor_log2fc_shrunk":-6.78367e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000165238","module":"black","kme":0.115059,"hub":false,"module_direction":"higher in AD","module_padj":0.56571,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000165238","module":"yellow","kme":0.226192,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165238","entrez_id":["65268"],"uniprot":["Q9Y3S1"],"ncbi_summary":"The protein encoded by this gene is a cytoplasmic serine-threonine kinase that belongs to the protein kinase superfamily. The protein plays an important role in the regulation of electrolyte homeostasis, cell signaling survival, and proliferation. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Sep 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y3S1","text":"Serine/threonine-protein kinase component of the WNK2-SPAK/OSR1 kinase cascade, which plays an important role in the regulation of electrolyte homeostasis, cell signaling, survival, and proliferation (PubMed:17667937, PubMed:18593598, PubMed:21733846). The WNK2-SPAK/OSR1 kinase cascade is composed of WNK2, which mediates phosphorylation and activation of downstream kinases OXSR1/OSR1 and STK39/SPAK (By similarity). Following activation, OXSR1/OSR1 and STK39/SPAK catalyze phosphorylation of ion cotransporters, regulating their activity (By similarity). Acts as an activator and inhibitor of sodium-coupled chloride cotransporters and potassium-coupled chloride cotransporters respectively (PubMed:21733846). Activates SLC12A2, SCNN1A, SCNN1B, SCNN1D and SGK1 and inhibits SLC12A5 (PubMed:21733846). Negatively regulates the EGF-induced activation of the ERK/MAPK-pathway and the downstream cell cycle progression (PubMed:17667937, PubMed:18593598). Affects MAPK3/MAPK1 activity by modulating the activity of MAP2K1 and this modulation depends on phosphorylation of MAP2K1 by PAK1 (PubMed:17667937, PubMed:18593598). WNK2 acts by interfering with the activity of PAK1 by controlling the balance of the activity of upstream regulators of PAK1 activity, RHOA and RAC1, which display reciprocal activity (PubMed:17667937, PubMed:18593598)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}