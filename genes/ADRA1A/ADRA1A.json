","cell_types":[{"cell_type":"Ast","gene_symbol":"ADRA1A","gene_symbol_current":"ADRA1A","gene_id":"ENSG00000120907","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.39124e-34,"nucleus_log2fc":0.216484,"nucleus_score":12.4733,"pct_ad":0.693873,"pct_control":0.647706,"donor_test":"not significant","donor_padj":0.821885,"donor_log2fc":0.168481,"donor_lfcse":0.15046,"donor_log2fc_shrunk":0.00443079},{"cell_type":"Ex","gene_symbol":"ADRA1A","gene_symbol_current":"ADRA1A","gene_id":"ENSG00000120907","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.815647,"nucleus_log2fc":0.116876,"nucleus_score":-0.247099,"pct_ad":0.12318,"pct_control":0.124521,"donor_test":"not significant","donor_padj":0.722022,"donor_log2fc":0.182517,"donor_lfcse":0.161346,"donor_log2fc_shrunk":0.00615228},{"cell_type":"In","gene_symbol":"ADRA1A","gene_symbol_current":"ADRA1A","gene_id":"ENSG00000120907","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.58757e-18,"nucleus_log2fc":-0.0810778,"nucleus_score":-8.83669,"pct_ad":0.583299,"pct_control":0.60242,"donor_test":"not significant","donor_padj":0.925844,"donor_log2fc":-0.0354017,"donor_lfcse":0.0945115,"donor_log2fc_shrunk":-0.00180499},{"cell_type":"Mic","gene_symbol":"ADRA1A","gene_symbol_current":"ADRA1A","gene_id":"ENSG00000120907","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.58144,"donor_log2fc":-0.354592,"donor_lfcse":0.227331,"donor_log2fc_shrunk":-0.0146305},{"cell_type":"OPC","gene_symbol":"ADRA1A","gene_symbol_current":"ADRA1A","gene_id":"ENSG00000120907","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00100915,"nucleus_log2fc":0.14454,"nucleus_score":3.79573,"pct_ad":0.577095,"pct_control":0.551905,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.122157,"donor_lfcse":0.119184,"donor_log2fc_shrunk":8.82801e-06},{"cell_type":"Oli","gene_symbol":"ADRA1A","gene_symbol_current":"ADRA1A","gene_id":"ENSG00000120907","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.901448,"donor_log2fc":0.134088,"donor_lfcse":0.181497,"donor_log2fc_shrunk":0.00423377}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000120907","entrez_id":["148"],"uniprot":["P35348"],"ncbi_summary":"Alpha-1-adrenergic receptors (alpha-1-ARs) are members of the G protein-coupled receptor superfamily. They activate mitogenic responses and regulate growth and proliferation of many cells. There are 3 alpha-1-AR subtypes: alpha-1A, -1B and -1D, all of which signal through the Gq/11 family of G-proteins and different subtypes show different patterns of activation. This gene encodes alpha-1A-adrenergic receptor. Alternative splicing of this gene generates four transcript variants, which encode four different isoforms with distinct C-termini but having similar ligand binding properties. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P35348","text":"Alpha-1 adrenergic receptors are G protein-coupled receptors for catecholamines that signal through the G(q) family of G proteins, including G(q) and G(11). Upon activation, they stimulate the phosphatidylinositol-calcium second messenger pathway, leading to calcium release from intracellular stores and activation of protein kinase C (PubMed:37563160). ADRA1A binds the catecholamine ligands norepinephrine and epinephrine (PubMed:18802028, PubMed:37563160, PubMed:7815325, PubMed:8024574, PubMed:8183249, PubMed:8832064). Can also couple to G(14) protein (By similarity). Nuclear ADRA1A forms heterooligomers with ADRA1B to regulate phenylephrine(PE)-stimulated ERK signaling in cardiac myocytes (PubMed:18802028, PubMed:22120526). At the plasma membrane, ADRA1A interacts with CAVIN4/MURC to regulates ERK activation in cardiomyocytes, contributing to the regulation of cardiac hypertrophy (PubMed:24567387). Additionally, functions as a vasopressor in resistance arteries and plays a role in maintaining normal arterial blood pressure (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}