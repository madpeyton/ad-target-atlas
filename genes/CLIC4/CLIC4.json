74e-06,"degas_log2fc":-0.245632,"degas_padj":1.26373e-07},{"cell_type":"Oli","gene_symbol":"CLIC4","gene_symbol_current":"CLIC4","gene_id":"ENSG00000169504","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.03726,"nucleus_log2fc":0.0295784,"nucleus_score":2.21439,"pct_ad":0.698258,"pct_control":0.695656,"donor_test":"not significant","donor_padj":0.927014,"donor_log2fc":0.0527732,"donor_lfcse":0.0886695,"donor_log2fc_shrunk":0.00638723,"degas_log2fc":-0.117947,"degas_padj":4.9304e-18}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000169504","module":"salmon","kme":0.401671,"hub":true,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000169504","module":"yellow","kme":0.450342,"hub":false,"module_direction":"lower in AD","module_padj":0.987842,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000169504","module":"blue","kme":0.117984,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000169504","module":"blue","kme":0.281578,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000169504","entrez_id":["25932"],"uniprot":["Q9Y696"],"ncbi_summary":"Chloride channels are a diverse group of proteins that regulate fundamental cellular processes including stabilization of cell membrane potential, transepithelial transport, maintenance of intracellular pH, and regulation of cell volume. Chloride intracellular channel 4 (CLIC4) protein, encoded by the CLIC4 gene, is a member of the p64 family; the gene is expressed in many tissues and exhibits a intracellular vesicular pattern in Panc-1 cells (pancreatic cancer cells). [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y696","text":"In the soluble state, catalyzes glutaredoxin-like thiol disulfide exchange reactions with reduced glutathione as electron donor (PubMed:25581026, PubMed:37759794). Can insert into membranes and form voltage-dependent multi-ion conductive channels. Membrane insertion seems to be redox-regulated and may occur only under oxidizing conditions (By similarity) (PubMed:16176272). Has alternate cellular functions like a potential role in angiogenesis or in maintaining apical-basolateral membrane polarity during mitosis and cytokinesis. Could also promote endothelial cell proliferation and regulate endothelial morphogenesis (tubulogenesis). Promotes cell-surface expression of HRH3."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}