leus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.78068,"nucleus_log2fc":-0.131899,"nucleus_score":-0.609051,"pct_ad":0.115385,"pct_control":0.122605,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"CLIC4","gene_symbol_current":"CLIC4","gene_id":"ENSG00000169504","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00218348,"nucleus_log2fc":0.161755,"nucleus_score":3.43083,"pct_ad":0.245693,"pct_control":0.22089,"donor_test":"not significant","donor_padj":0.999307,"donor_log2fc":0.000101463,"donor_lfcse":0.0858935,"donor_log2fc_shrunk":-4.75805e-05}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000169504","module":"yellow","kme":0.173402,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000169504","entrez_id":["25932"],"uniprot":["Q9Y696"],"ncbi_summary":"Chloride channels are a diverse group of proteins that regulate fundamental cellular processes including stabilization of cell membrane potential, transepithelial transport, maintenance of intracellular pH, and regulation of cell volume. Chloride intracellular channel 4 (CLIC4) protein, encoded by the CLIC4 gene, is a member of the p64 family; the gene is expressed in many tissues and exhibits a intracellular vesicular pattern in Panc-1 cells (pancreatic cancer cells). [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y696","text":"In the soluble state, catalyzes glutaredoxin-like thiol disulfide exchange reactions with reduced glutathione as electron donor (PubMed:25581026, PubMed:37759794). Can insert into membranes and form voltage-dependent multi-ion conductive channels. Membrane insertion seems to be redox-regulated and may occur only under oxidizing conditions (By similarity) (PubMed:16176272). Has alternate cellular functions like a potential role in angiogenesis or in maintaining apical-basolateral membrane polarity during mitosis and cytokinesis. Could also promote endothelial cell proliferation and regulate endothelial morphogenesis (tubulogenesis). Promotes cell-surface expression of HRH3."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}