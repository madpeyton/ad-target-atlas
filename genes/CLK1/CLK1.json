,"donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"CLK1","gene_symbol_current":"CLK1","gene_id":"ENSG00000013441","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.484756,"nucleus_log2fc":0.229274,"nucleus_score":1.31251,"pct_ad":0.197017,"pct_control":0.17931,"donor_test":"not significant","donor_padj":0.940764,"donor_log2fc":0.248255,"donor_lfcse":0.152883,"donor_log2fc_shrunk":0.00202261},{"cell_type":"Oli","gene_symbol":"CLK1","gene_symbol_current":"CLK1","gene_id":"ENSG00000013441","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":5.61554e-05,"nucleus_log2fc":0.260502,"nucleus_score":4.43631,"pct_ad":0.176669,"pct_control":0.152213,"donor_test":"not significant","donor_padj":0.786401,"donor_log2fc":0.138663,"donor_lfcse":0.104032,"donor_log2fc_shrunk":0.0123317}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000013441","entrez_id":["1195"],"uniprot":["P49759"],"ncbi_summary":"This gene encodes a member of the CDC2-like (or LAMMER) family of dual specificity protein kinases. In the nucleus, the encoded protein phosphorylates serine/arginine-rich proteins involved in pre-mRNA processing, releasing them into the nucleoplasm. The choice of splice sites during pre-mRNA processing may be regulated by the concentration of transacting factors, including serine/arginine rich proteins. Therefore, the encoded protein may play an indirect role in governing splice site selection. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jun 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49759","text":"Dual specificity kinase acting on both serine/threonine and tyrosine-containing substrates. Phosphorylates serine- and arginine-rich (SR) proteins of the spliceosomal complex and may be a constituent of a network of regulatory mechanisms that enable SR proteins to control RNA splicing. Phosphorylates: SRSF1, SRSF3 and PTPN1 (PubMed:10480872, PubMed:19168442). Regulates the alternative splicing of tissue factor (F3) pre-mRNA in endothelial cells (PubMed:19168442)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}