g2fc_shrunk":2.11547e-06},{"cell_type":"OPC","gene_symbol":"RAB14","gene_symbol_current":"RAB14","gene_id":"ENSG00000119396","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.622492,"nucleus_log2fc":0.200782,"nucleus_score":0.986435,"pct_ad":0.135008,"pct_control":0.122605,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"RAB14","gene_symbol_current":"RAB14","gene_id":"ENSG00000119396","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.795144,"donor_log2fc":0.144473,"donor_lfcse":0.114567,"donor_log2fc_shrunk":0.0105358}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000119396","module":"turquoise","kme":0.153628,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000119396","module":"turquoise","kme":0.313033,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000119396","module":"turquoise","kme":0.2764,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000119396","module":"turquoise","kme":0.135927,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000119396","entrez_id":["51552"],"uniprot":["P61106"],"ncbi_summary":"RAB14 belongs to the large RAB family of low molecular mass GTPases that are involved in intracellular membrane trafficking. These proteins act as molecular switches that flip between an inactive GDP-bound state and an active GTP-bound state in which they recruit downstream effector proteins onto membranes (Junutula et al., 2004 [PubMed 15004230]).[supplied by OMIM, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P61106","text":"The small GTPases Rab are key regulators of intracellular membrane trafficking, from the formation of transport vesicles to their fusion with membranes. Rabs cycle between an inactive GDP-bound form and an active GTP-bound form that is able to recruit to membranes different set of downstream effectors directly responsible for vesicle formation, movement, tethering and fusion (PubMed:22595670). RAB14 is involved in membrane trafficking between the Golgi complex and endosomes during early embryonic development (By similarity). Regulates the Golgi to endosome transport of FGFR-containing vesicles during early development, a key process for developing basement membrane and epiblast and primitive endoderm lineages during early postimplantation development. May act by modulating the kinesin KIF16B-cargo association to endosomes (By similarity). Regulates, together with its guanine nucleotide exchange factor DENND6A, the specific endocytic transport of ADAM10, N-cadherin/CDH2 shedding and cell-cell adhesion (PubMed:22595670). Mediates endosomal tethering and fusion through the interaction with RUFY1 and RAB4B (PubMed:20534812). Interaction with RAB11FIP1 may function in the process of neurite formation (PubMed:26032412)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}