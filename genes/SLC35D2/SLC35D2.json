eus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0243778,"nucleus_log2fc":-0.164427,"nucleus_score":-2.58258,"pct_ad":0.13512,"pct_control":0.148498,"donor_test":"not significant","donor_padj":0.754681,"donor_log2fc":-0.202878,"donor_lfcse":0.114672,"donor_log2fc_shrunk":-0.0158243}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000130958","module":"blue","kme":0.122351,"hub":false,"module_direction":"lower in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000130958","entrez_id":["11046"],"uniprot":["Q76EJ3"],"ncbi_summary":"Nucleotide sugars, which are synthesized in the cytosol or the nucleus, are high-energy donor substrates for glycosyltransferases located in the lumen of the endoplasmic reticulum and Golgi apparatus. Translocation of nucleotide sugars from the cytosol into the lumen compartment is mediated by specific nucleotide sugar transporters, such as SLC35D2 (Suda et al., 2004 [PubMed 15082721]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q76EJ3","text":"Nucleotide sugar antiporter transporting UDP-N-acetylglucosamine (UDP-GlcNAc) and UDP-glucose (UDP-Glc) from the cytosol into the lumen of the Golgi in exchange of UMP. By supplying UDP-N-acetylglucosamine, a donor substrate to heparan sulfate synthases, probably takes part in the synthesis of these glycoconjugates."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}