ds":["ENSG00000115457"],"dataset_symbols":["IGFBP2"],"explorer":"explorer.html?dataset=mathys2019#gene/IGFBP2","cell_types":[{"cell_type":"Ex","gene_symbol":"IGFBP2","gene_symbol_current":"IGFBP2","gene_id":"ENSG00000115457","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":0.102757,"donor_lfcse":0.213118,"donor_log2fc_shrunk":2.34782e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000115457","module":"brown","kme":0.102348,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"seaad_pfc":{"dataset_label":"SEA-AD (Gabitto et al. 2024)","gene_ids":["ENSG00000115457"],"dataset_symbols":["IGFBP2"],"explorer":"explorer.html?dataset=seaad_pfc#gene/IGFBP2","cell_types":[{"cell_type":"Ex","gene_symbol":"IGFBP2","gene_symbol_current":"IGFBP2","gene_id":"ENSG00000115457","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.131069,"nucleus_log2fc":0.0869625,"nucleus_score":1.55402,"pct_ad":0.110515,"pct_control":0.109354,"donor_test":"not significant","donor_padj":0.948303,"donor_log2fc":0.0478794,"donor_lfcse":0.213837,"donor_log2fc_shrunk":0.00123677},{"cell_type":"In","gene_symbol":"IGFBP2","gene_symbol_current":"IGFBP2","gene_id":"ENSG00000115457","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.99265,"donor_log2fc":0.00838283,"donor_lfcse":0.16273,"donor_log2fc_shrunk":0.000370509},{"cell_type":"Oli","gene_symbol":"IGFBP2","gene_symbol_current":"IGFBP2","gene_id":"ENSG00000115457","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985647,"donor_log2fc":0.0324476,"donor_lfcse":0.290768,"donor_log2fc_shrunk":0.000417615}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000115457","entrez_id":["3485"],"uniprot":["P18065"],"ncbi_summary":"The protein encoded by this gene is one of six similar proteins that bind insulin-like growth factors I and II (IGF-I and IGF-II). The encoded protein can be secreted into the bloodstream, where it binds IGF-I and IGF-II with high affinity, or it can remain intracellular, interacting with many different ligands. High expression levels of this protein promote the growth of several types of tumors and may be predictive of the chances of recovery of the patient. Several transcript variants, one encoding a secreted isoform and the others encoding nonsecreted isoforms, have been found for this gene. [provided by RefSeq, Sep 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P18065","text":"Multifunctional protein that plays a critical role in regulating the availability of IGFs such as IGF1 and IGF2 to their receptors and thereby regulates IGF-mediated cellular processes including proliferation, differentiation, and apoptosis in a cell-type specific manner (PubMed:18563800, PubMed:38796567). Functions coordinately with receptor protein tyrosine phosphatase beta/PTPRB and the IGF1 receptor to regulate IGF1-mediated signaling by stimulating the phosphorylation of PTEN leading to its inactivation and AKT1 activation (PubMed:22869525). Plays a positive role in cell migration via interaction with integrin alpha5/ITGA5 through an RGD motif (PubMed:16569642). Additionally, interaction with ITGA5/ITGB1 enhances the adhesion of endothelial progenitor cells to endothelial cells (PubMed:26076738). Upon mitochondrial damage, facilitates apoptosis with ITGA5 of podocytes, and then activates the phosphorylation of focal adhesion kinase (FAK)-mediated mitochondrial injury (PubMed:38796567)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}