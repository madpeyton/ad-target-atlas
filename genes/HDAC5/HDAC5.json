odules":[{"cell_type":"Astrocytes","gene_id":"ENSG00000108840","module":"turquoise","kme":0.109584,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000108840","module":"turquoise","kme":0.142523,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000108840","module":"turquoise","kme":0.0640294,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000108840"],"dataset_symbols":["HDAC5"],"explorer":"explorer.html?dataset=mathys2019#gene/HDAC5","cell_types":[{"cell_type":"Ex","gene_symbol":"HDAC5","gene_symbol_current":"HDAC5","gene_id":"ENSG00000108840","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.378752,"nucleus_log2fc":0.000798207,"nucleus_score":-1.02734,"pct_ad":0.237607,"pct_control":0.245733,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0451477,"donor_lfcse":0.0691174,"donor_log2fc_shrunk":9.92945e-06},{"cell_type":"In","gene_symbol":"HDAC5","gene_symbol_current":"HDAC5","gene_id":"ENSG00000108840","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.957126,"nucleus_log2fc":-0.0270557,"nucleus_score":0.171677,"pct_ad":0.241349,"pct_control":0.235294,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0119716,"donor_lfcse":0.112422,"donor_log2fc_shrunk":-9.7963e-07},{"cell_type":"Oli","gene_symbol":"HDAC5","gene_symbol_current":"HDAC5","gene_id":"ENSG00000108840","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.855932,"donor_log2fc":0.120287,"donor_lfcse":0.121419,"donor_log2fc_shrunk":0.00772552}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000108840","module":"red","kme":0.155462,"hub":false,"module_direction":"lower in AD","module_padj":0.641133,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000108840","entrez_id":["10014"],"uniprot":["Q9UQL6"],"ncbi_summary":"Histones play a critical role in transcriptional regulation, cell cycle progression, and developmental events. Histone acetylation/deacetylation alters chromosome structure and affects transcription factor access to DNA. The protein encoded by this gene belongs to the class II histone deacetylase/acuc/apha family. It possesses histone deacetylase activity and represses transcription when tethered to a promoter. It coimmunoprecipitates only with HDAC3 family member and might form multicomplex proteins. It also interacts with myocyte enhancer factor-2 (MEF2) proteins, resulting in repression of MEF2-dependent genes. This gene is thought to be associated with colon cancer. Two transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UQL6","text":"In vitro, it deacetylates lysine residues on the N-terminal part of the core histones (H2A, H2B, H3 and H4) (PubMed:10220385). Histone deacetylation gives a tag for epigenetic repression and plays an important role in transcriptional regulation, cell cycle progression and developmental events. Histone deacetylases act via the formation of large multiprotein complexes. Involved in muscle maturation by repressing transcription of myocyte enhancer MEF2C. During muscle differentiation, it shuttles into the cytoplasm, allowing the expression of myocyte enhancer factors. Involved in the MTA1-mediated epigenetic regulation of ESR1 expression in breast cancer. Serves as a corepressor of RARA and causes its deacetylation (PubMed:28167758). In association with RARA, plays a role in the repression of microRNA-10a and thereby in the inflammatory response (PubMed:28167758)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}