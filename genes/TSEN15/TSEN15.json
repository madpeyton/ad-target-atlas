"donor_log2fc_shrunk":0.0121787},{"cell_type":"OPC","gene_symbol":"TSEN15","gene_symbol_current":"TSEN15","gene_id":"ENSG00000198860","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.260387,"nucleus_log2fc":0.0539182,"nucleus_score":1.48871,"pct_ad":0.359976,"pct_control":0.345978,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0800733,"donor_lfcse":0.0892955,"donor_log2fc_shrunk":1.05049e-05},{"cell_type":"Oli","gene_symbol":"TSEN15","gene_symbol_current":"TSEN15","gene_id":"ENSG00000198860","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.07751e-29,"nucleus_log2fc":0.222392,"nucleus_score":11.4795,"pct_ad":0.4436,"pct_control":0.41188,"donor_test":"not significant","donor_padj":0.665064,"donor_log2fc":0.188683,"donor_lfcse":0.108879,"donor_log2fc_shrunk":0.018537}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000198860","module":"blue","kme":0.172882,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198860","entrez_id":["116461"],"uniprot":["Q8WW01"],"ncbi_summary":"This gene encodes a subunit of the tRNA splicing endonuclease, which catalyzes the removal of introns from tRNA precursors. Alternative splicing results in multiple transcript variants. There is a pseudogene of this gene on chromosome 17. [provided by RefSeq, Jul 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WW01","text":"Non-catalytic subunit of the tRNA-splicing endonuclease complex, a complex responsible for identification and cleavage of the splice sites in pre-tRNA. It cleaves pre-tRNA at the 5' and 3' splice sites to release the intron. The products are an intron and two tRNA half-molecules bearing 2',3' cyclic phosphate and 5'-OH termini (PubMed:15109492, PubMed:27392077). There are no conserved sequences at the splice sites, but the intron is invariably located at the same site in the gene, placing the splice sites an invariant distance from the constant structural features of the tRNA body. The tRNA splicing endonuclease is also involved in mRNA processing via its association with pre-mRNA 3'-end processing factors, establishing a link between pre-tRNA splicing and pre-mRNA 3'-end formation, suggesting that the endonuclease subunits function in multiple RNA-processing events (PubMed:15109492)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}