:-0.0568077,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"PAFAH2","gene_symbol_current":"PAFAH2","gene_id":"ENSG00000158006","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.407554,"nucleus_log2fc":-0.131952,"nucleus_score":-1.13466,"pct_ad":0.108559,"pct_control":0.11431,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0916745,"donor_lfcse":0.122881,"donor_log2fc_shrunk":-6.28804e-06,"degas_log2fc":-0.287814,"degas_padj":0.00102858},{"cell_type":"Oli","gene_symbol":"PAFAH2","gene_symbol_current":"PAFAH2","gene_id":"ENSG00000158006","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.318914,"nucleus_log2fc":-0.0376132,"nucleus_score":-1.09323,"pct_ad":0.1037,"pct_control":0.106131,"donor_test":"not significant","donor_padj":0.984184,"donor_log2fc":-0.0116297,"donor_lfcse":0.0869584,"donor_log2fc_shrunk":-0.00149789,"degas_log2fc":-0.325382,"degas_padj":9.67293e-19}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000158006","entrez_id":["5051"],"uniprot":["Q99487"],"ncbi_summary":"This gene encodes platelet-activating factor acetylhydrolase isoform 2, a single-subunit intracellular enzyme that catalyzes the removal of the acetyl group at the SN-2 position of platelet-activating factor (identified as 1-O-alkyl-2-acetyl-sn-glyceryl-3-phosphorylcholine). However, this lipase exhibits a broader substrate specificity than simply platelet activating factor. Two other isoforms of intracellular platelet-activating factor acetylhydrolase exist, and both are multi-subunit enzymes. Additionally, there is a single-subunit serum isoform of this enzyme. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q99487","text":"Catalyzes the hydrolyze of the acetyl group at the sn-2 position of platelet-activating factor (PAF) and its analogs, leading to their inactivation (PubMed:9494101). Hydrolyzes propionyl and butyroyl moieties approximately half as effectively as PAF (By similarity). Also catalyzes transacetylation of the acetyl group from platelet-activating factor (PAF) to lysoplasmalogen and to sphingosine, producing plasmalogen analogs of PAF and N-acetylsphingosine (C2-ceramide) respectively. Has a marked selectivity for phospholipids with short acyl chains at the sn-2 position (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}