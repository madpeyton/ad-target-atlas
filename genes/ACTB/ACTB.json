_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.181823,"nucleus_log2fc":0.0271762,"nucleus_score":1.44547,"pct_ad":0.588116,"pct_control":0.586321,"donor_test":"not significant","donor_padj":0.95271,"donor_log2fc":0.0591401,"donor_lfcse":0.14533,"donor_log2fc_shrunk":0.0021877,"degas_log2fc":0.0526822,"degas_padj":0.000648439}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000075624","module":"turquoise","kme":0.103872,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000075624","module":"brown","kme":0.574514,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000075624","module":"brown","kme":0.413913,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000075624","module":"red","kme":0.333218,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000075624","module":"turquoise","kme":0.257293,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000075624","module":"turquoise","kme":0.338331,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000075624","entrez_id":["60"],"uniprot":["P60709"],"ncbi_summary":"This gene encodes one of six different actin proteins. Actins are highly conserved proteins that are involved in cell motility, structure, integrity, and intercellular signaling. The encoded protein is a major constituent of the contractile apparatus and one of the two nonmuscle cytoskeletal actins that are ubiquitously expressed. Mutations in this gene cause Baraitser-Winter syndrome 1, which is characterized by intellectual disability with a distinctive facial appearance in human patients. Numerous pseudogenes of this gene have been identified throughout the human genome. [provided by RefSeq, Aug 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P60709","text":"Actin is a highly conserved protein that polymerizes to produce filaments that form cross-linked networks in the cytoplasm of cells (PubMed:25255767, PubMed:29581253). Actin exists in both monomeric (G-actin) and polymeric (F-actin) forms, both forms playing key functions, such as cell motility and contraction (PubMed:29581253). In addition to their role in the cytoplasmic cytoskeleton, G- and F-actin also localize in the nucleus, and regulate gene transcription and motility and repair of damaged DNA (PubMed:29925947). Plays a role in the assembly of the gamma-tubulin ring complex (gTuRC), which regulates the minus-end nucleation of alpha-beta tubulin heterodimers that grow into microtubule protafilaments (PubMed:39321809, PubMed:38609661). Part of the ACTR1A/ACTB filament around which the dynactin complex is built (By similarity). The dynactin multiprotein complex activates the molecular motor dynein for ultra-processive transport along microtubules (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}