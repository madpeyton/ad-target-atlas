scription":[{"gene_id":"ENSG00000135040","entrez_id":["60560"],"uniprot":["Q5VZE5"],"ncbi_summary":"Involved in negative regulation of apoptotic process. Located in cytosol; nucleoplasm; and plasma membrane. Part of NatC complex. Colocalizes with polysome. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5VZE5","text":"Auxillary component of the N-terminal acetyltransferase C (NatC) complex which catalyzes acetylation of N-terminal methionine residues (PubMed:19398576, PubMed:37891180). N-terminal acetylation protects proteins from ubiquitination and degradation by the N-end rule pathway (PubMed:37891180). Involved in regulation of apoptosis and proliferation of smooth muscle cells (PubMed:19398576)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}