cant","donor_padj":0.77756,"donor_log2fc":-0.125569,"donor_lfcse":0.14535,"donor_log2fc_shrunk":-0.00534428},{"cell_type":"In","gene_symbol":"CSF1","gene_symbol_current":"CSF1","gene_id":"ENSG00000184371","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.996429,"donor_log2fc":-0.00247043,"donor_lfcse":0.106871,"donor_log2fc_shrunk":-8.88243e-05},{"cell_type":"OPC","gene_symbol":"CSF1","gene_symbol_current":"CSF1","gene_id":"ENSG00000184371","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.10875e-05,"nucleus_log2fc":0.384792,"nucleus_score":4.90022,"pct_ad":0.130778,"pct_control":0.102625,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.289474,"donor_lfcse":0.211543,"donor_log2fc_shrunk":6.50073e-06},{"cell_type":"Oli","gene_symbol":"CSF1","gene_symbol_current":"CSF1","gene_id":"ENSG00000184371","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.60296e-11,"nucleus_log2fc":0.233082,"nucleus_score":6.89719,"pct_ad":0.149138,"pct_control":0.131589,"donor_test":"not significant","donor_padj":0.725041,"donor_log2fc":0.19778,"donor_lfcse":0.131167,"donor_log2fc_shrunk":0.0125033}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000184371","entrez_id":["1435"],"uniprot":["P09603"],"ncbi_summary":"The protein encoded by this gene is a cytokine that controls the production, differentiation, and function of macrophages. The active form of the protein is found extracellularly as a disulfide-linked homodimer, and is thought to be produced by proteolytic cleavage of membrane-bound precursors. The encoded protein may be involved in development of the placenta. Alternate splicing results in multiple transcript variants. [provided by RefSeq, Sep 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P09603","text":"Cytokine that plays an essential role in the regulation of survival, proliferation and differentiation of hematopoietic precursor cells, especially mononuclear phagocytes, such as macrophages and monocytes. Promotes the release of pro-inflammatory chemokines, and thereby plays an important role in innate immunity and in inflammatory processes. Plays an important role in the regulation of osteoclast proliferation and differentiation, the regulation of bone resorption, and is required for normal bone development. Required for normal male and female fertility. Promotes reorganization of the actin cytoskeleton, regulates formation of membrane ruffles, cell adhesion and cell migration. Plays a role in lipoprotein clearance."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}