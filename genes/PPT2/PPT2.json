ucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.647288,"donor_log2fc":0.162143,"donor_lfcse":0.088147,"donor_log2fc_shrunk":0.0249582,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000221988","entrez_id":["9374"],"uniprot":["Q9UMR5"],"ncbi_summary":"This gene encodes a member of the palmitoyl-protein thioesterase family. The encoded glycosylated lysosomal protein has palmitoyl-CoA hydrolase activity in vitro, but does not hydrolyze palmitate from cysteine residues in proteins. Alternative splicing results in multiple transcript variants. Read-through transcription also exists between this gene and the downstream EGFL8 (EGF-like-domain, multiple 8) gene. [provided by RefSeq, Feb 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UMR5","text":"Catalyzes the cleavage of thioester bonds from S-palmitoyl-CoA or S-palmitoyl-N-acetylcysteamine (unbranched structures) but does not have activity against palmitoylcysteine or palmitoylated proteins, branched structures or bulky head groups. Conversely, hydrolyzes both long and short chain fatty acyl-CoA substrate. [Isoform 2]: Catalytically inactive due to lack of active site His-283."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}