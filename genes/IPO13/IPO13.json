,"nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.888834,"nucleus_log2fc":-0.00297697,"nucleus_score":-0.224681,"pct_ad":0.0991649,"pct_control":0.100254,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0277371,"donor_lfcse":0.124444,"donor_log2fc_shrunk":-1.83562e-06,"degas_log2fc":-0.129738,"degas_padj":0.173778},{"cell_type":"Oli","gene_symbol":"IPO13","gene_symbol_current":"IPO13","gene_id":"ENSG00000117408","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.50389e-39,"nucleus_log2fc":-0.255305,"nucleus_score":-13.2566,"pct_ad":0.3176,"pct_control":0.362763,"donor_test":"not significant","donor_padj":0.477427,"donor_log2fc":-0.204787,"donor_lfcse":0.0827565,"donor_log2fc_shrunk":-0.0688354,"degas_log2fc":-0.166074,"degas_padj":1.25416e-16}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000117408","module":"red","kme":0.0953385,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000117408","module":"turquoise","kme":0.0658602,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000117408","entrez_id":["9670"],"uniprot":["O94829"],"ncbi_summary":"This gene encodes a member of the importin-beta family of nuclear transport proteins. The encoded protein mediates the import of specific cargo proteins from the cytoplasm to the nucleus and is dependent on the Ras-related nuclear protein-GTPase system. The encoded protein is also involved in nuclear export of the eukaryotic translation initiation factor 1A.[provided by RefSeq, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O94829","text":"Functions in nuclear protein import as nuclear transport receptor. Serves as receptor for nuclear localization signals (NLS) in cargo substrates. Is thought to mediate docking of the importin/substrate complex to the nuclear pore complex (NPC) through binding to nucleoporin and the complex is subsequently translocated through the pore by an energy requiring, Ran-dependent mechanism. At the nucleoplasmic side of the NPC, Ran binds to the importin, the importin/substrate complex dissociates and importin is re-exported from the nucleus to the cytoplasm where GTP hydrolysis releases Ran. The directionality of nuclear import is thought to be conferred by an asymmetric distribution of the GTP- and GDP-bound forms of Ran between the cytoplasm and nucleus (By similarity). Mediates the nuclear import of UBC9, the RBM8A/MAGOH complex, PAX6 and probably other members of the paired homeobox family. Also mediates nuclear export of eIF-1A, and the cytoplasmic release of eIF-1A is triggered by the loading of import substrates onto IPO13."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}