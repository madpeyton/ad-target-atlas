":"higher in AD","module_padj":0.49728,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000117408"],"dataset_symbols":["IPO13"],"explorer":"explorer.html?dataset=mathys2019#gene/IPO13","cell_types":[{"cell_type":"Ex","gene_symbol":"IPO13","gene_symbol_current":"IPO13","gene_id":"ENSG00000117408","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.932684,"nucleus_log2fc":0.0518083,"nucleus_score":0.109055,"pct_ad":0.130841,"pct_control":0.131042,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0748553,"donor_lfcse":0.0934831,"donor_log2fc_shrunk":8.97718e-06},{"cell_type":"Oli","gene_symbol":"IPO13","gene_symbol_current":"IPO13","gene_id":"ENSG00000117408","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.807944,"nucleus_log2fc":0.00528071,"nucleus_score":0.347347,"pct_ad":0.105394,"pct_control":0.103386,"donor_test":"not significant","donor_padj":0.9355,"donor_log2fc":-0.0637254,"donor_lfcse":0.114942,"donor_log2fc_shrunk":-0.0044501}],"modules":[{"cell_type":"In","gene_id":"ENSG00000117408","module":"brown","kme":0.101082,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000117408","entrez_id":["9670"],"uniprot":["O94829"],"ncbi_summary":"This gene encodes a member of the importin-beta family of nuclear transport proteins. The encoded protein mediates the import of specific cargo proteins from the cytoplasm to the nucleus and is dependent on the Ras-related nuclear protein-GTPase system. The encoded protein is also involved in nuclear export of the eukaryotic translation initiation factor 1A.[provided by RefSeq, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O94829","text":"Functions in nuclear protein import as nuclear transport receptor. Serves as receptor for nuclear localization signals (NLS) in cargo substrates. Is thought to mediate docking of the importin/substrate complex to the nuclear pore complex (NPC) through binding to nucleoporin and the complex is subsequently translocated through the pore by an energy requiring, Ran-dependent mechanism. At the nucleoplasmic side of the NPC, Ran binds to the importin, the importin/substrate complex dissociates and importin is re-exported from the nucleus to the cytoplasm where GTP hydrolysis releases Ran. The directionality of nuclear import is thought to be conferred by an asymmetric distribution of the GTP- and GDP-bound forms of Ran between the cytoplasm and nucleus (By similarity). Mediates the nuclear import of UBC9, the RBM8A/MAGOH complex, PAX6 and probably other members of the paired homeobox family. Also mediates nuclear export of eIF-1A, and the cytoplasmic release of eIF-1A is triggered by the loading of import substrates onto IPO13."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}