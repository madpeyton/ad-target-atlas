direction":"lower in AD","module_padj":0.80895,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000169621","module":"brown","kme":0.141042,"hub":false,"module_direction":"lower in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000169621"],"dataset_symbols":["APLF"],"explorer":"explorer.html?dataset=mathys2019#gene/APLF","cell_types":[{"cell_type":"Ex","gene_symbol":"APLF","gene_symbol_current":"APLF","gene_id":"ENSG00000169621","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.169635,"donor_lfcse":0.143334,"donor_log2fc_shrunk":-8.52176e-06},{"cell_type":"Oli","gene_symbol":"APLF","gene_symbol_current":"APLF","gene_id":"ENSG00000169621","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.795115,"donor_log2fc":-0.181515,"donor_lfcse":0.142537,"donor_log2fc_shrunk":-0.00870808}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000169621","module":"blue","kme":0.0879037,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000169621","module":"red","kme":0.0959099,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000169621","entrez_id":["200558"],"uniprot":["Q8IW19"],"ncbi_summary":"C2ORF13 is a component of the cellular response to chromosomal DNA single- and double-strand breaks (Iles et al., 2007 [PubMed 17353262]).[supplied by OMIM, Mar 2008]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IW19","text":"Histone chaperone involved in single-strand and double-strand DNA break repair (PubMed:17353262, PubMed:17396150, PubMed:21211721, PubMed:21211722, PubMed:29905837, PubMed:30104678). Recruited to sites of DNA damage through interaction with branched poly-ADP-ribose chains, a polymeric post-translational modification synthesized transiently at sites of chromosomal damage to accelerate DNA strand break repair reactions (PubMed:17353262, PubMed:17396150, PubMed:21211721, PubMed:30104678). Following recruitment to DNA damage sites, acts as a histone chaperone that mediates histone eviction during DNA repair and promotes recruitment of histone variant MACROH2A1 (PubMed:21211722, PubMed:29905837, PubMed:30104678). Also has a nuclease activity: displays apurinic-apyrimidinic (AP) endonuclease and 3'-5' exonuclease activities in vitro (PubMed:17353262, PubMed:17396150). Also able to introduce nicks at hydroxyuracil and other types of pyrimidine base damage (PubMed:17353262, PubMed:17396150). Together with PARP3, promotes the retention of the LIG4-XRCC4 complex on chromatin and accelerate DNA ligation during non-homologous end-joining (NHEJ) (PubMed:21211721, PubMed:23689425). Also acts as a negative regulator of cell pluripotency by promoting histone exchange (By similarity). Required for the embryo implantation during the epithelial to mesenchymal transition in females (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}