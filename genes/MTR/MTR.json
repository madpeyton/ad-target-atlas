Oli","gene_symbol":"MTR","gene_symbol_current":"MTR","gene_id":"ENSG00000116984","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.971591,"donor_log2fc":-0.0226543,"donor_lfcse":0.122226,"donor_log2fc_shrunk":-0.00144971}],"modules":[{"cell_type":"In","gene_id":"ENSG00000116984","module":"yellow","kme":0.219435,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000116984","module":"blue","kme":0.0620015,"hub":false,"module_direction":"lower in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000116984","entrez_id":["4548"],"uniprot":["Q99707"],"ncbi_summary":"This gene encodes the 5-methyltetrahydrofolate-homocysteine methyltransferase. This enzyme, also known as cobalamin-dependent methionine synthase, catalyzes the final step in methionine biosynthesis. Mutations in MTR have been identified as the underlying cause of methylcobalamin deficiency complementation group G. Alternatively spliced transcript variants encoding distinct isoforms have been found for this gene. [provided by RefSeq, May 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q99707","text":"Catalyzes the transfer of a methyl group from methylcob(III)alamin (MeCbl) to homocysteine, yielding enzyme-bound cob(I)alamin and methionine in the cytosol (PubMed:16769880, PubMed:17288554, PubMed:27771510). MeCbl is an active form of cobalamin (vitamin B12) used as a cofactor for methionine biosynthesis. Cob(I)alamin form is regenerated to MeCbl by a transfer of a methyl group from 5-methyltetrahydrofolate (PubMed:16769880, PubMed:17288554, PubMed:27771510). The processing of cobalamin in the cytosol occurs in a multiprotein complex composed of at least MMACHC, MMADHC, MTRR (methionine synthase reductase) and MTR which may contribute to shuttle safely and efficiently cobalamin towards MTR in order to produce methionine (PubMed:16769880, PubMed:27771510)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}