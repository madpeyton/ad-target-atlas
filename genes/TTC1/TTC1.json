,{"cell_type":"OPC","gene_symbol":"TTC1","gene_symbol_current":"TTC1","gene_id":"ENSG00000113312","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.130715,"nucleus_log2fc":0.0899813,"nucleus_score":1.92769,"pct_ad":0.405607,"pct_control":0.389331,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0449732,"donor_lfcse":0.072164,"donor_log2fc_shrunk":9.04691e-06,"degas_log2fc":0.116282,"degas_padj":0.0095896},{"cell_type":"Oli","gene_symbol":"TTC1","gene_symbol_current":"TTC1","gene_id":"ENSG00000113312","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.1401e-05,"nucleus_log2fc":0.0928879,"nucleus_score":4.12167,"pct_ad":0.381611,"pct_control":0.371249,"donor_test":"not significant","donor_padj":0.859612,"donor_log2fc":0.0770357,"donor_lfcse":0.0789268,"donor_log2fc_shrunk":0.0124587,"degas_log2fc":0.0771964,"degas_padj":6.73211e-05}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000113312","module":"turquoise","kme":0.20991,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000113312","module":"turquoise","kme":0.110224,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000113312","module":"turquoise","kme":0.157269,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000113312","entrez_id":["7265"],"uniprot":["Q99614"],"ncbi_summary":"This gene encodes a protein that belongs to the tetratrico peptide repeat superfamily of proteins. The encoded protein plays a role in protein-protein interactions, and binds to the Galpha subunit of G protein-coupled receptors to activate the Ras signaling pathway. Alternate splicing results in multiple transcript variants. [provided by RefSeq, Sep 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q99614","text":"Adapter protein that plays a role downstream of GNA15 to stimulate Ras activation and subsequent phosphorylation of ERK1/2 independently of phospholipase Cbeta signaling (PubMed:12748287, PubMed:21486497). Mechanistically, interacts with GNA15 and SOS2 to form a macromolecular signaling complex which has a high affinity for HRAS (PubMed:20639119). Additionally, participates in signaling via other G-alpha proteins like GNA14, activating NF-kappa-B through Ras and ERK pathways (PubMed:22711498). Beyond signaling, supports protein homeostasis by cooperating with HSP40 in the HSP70 chaperone cycle, promoting protein folding through the regulated dissociation of the HSP70 inhibitor HSPBP1 (PubMed:14503850)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}