":"Astrocytes","gene_id":"ENSG00000102572","module":"blue","kme":0.17273,"hub":false,"module_direction":"higher in AD","module_padj":0.903036,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000102572","module":"turquoise","kme":0.155166,"hub":false,"module_direction":"lower in AD","module_padj":0.773167,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000102572"],"dataset_symbols":["STK24"],"explorer":"explorer.html?dataset=mathys2019#gene/STK24","cell_types":[{"cell_type":"Ast","gene_symbol":"STK24","gene_symbol_current":"STK24","gene_id":"ENSG00000102572","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0245982,"nucleus_log2fc":-0.374242,"nucleus_score":-2.75801,"pct_ad":0.0814856,"pct_control":0.111256,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Ex","gene_symbol":"STK24","gene_symbol_current":"STK24","gene_id":"ENSG00000102572","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.396582,"nucleus_log2fc":0.00375625,"nucleus_score":-0.990323,"pct_ad":0.288704,"pct_control":0.297974,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0380385,"donor_lfcse":0.0576791,"donor_log2fc_shrunk":2.16433e-05},{"cell_type":"In","gene_symbol":"STK24","gene_symbol_current":"STK24","gene_id":"ENSG00000102572","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.576513,"nucleus_log2fc":-0.188221,"nucleus_score":-1.27725,"pct_ad":0.148625,"pct_control":0.15873,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.1902,"donor_lfcse":0.123159,"donor_log2fc_shrunk":-1.31412e-05}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000102572","module":"blue","kme":0.107841,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000102572","entrez_id":["8428"],"uniprot":["Q9Y6E0"],"ncbi_summary":"This gene encodes a serine/threonine protein kinase that functions upstream of mitogen-activated protein kinase (MAPK) signaling. The encoded protein is cleaved into two chains by caspases; the N-terminal fragment (MST3/N) translocates to the nucleus and promotes programmed cells death. There is a pseudogene for this gene on chromosome X. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Nov 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y6E0","text":"Serine/threonine-protein kinase that acts on both serine and threonine residues and promotes apoptosis in response to stress stimuli and caspase activation. Mediates oxidative-stress-induced cell death by modulating phosphorylation of JNK1-JNK2 (MAPK8 and MAPK9), p38 (MAPK11, MAPK12, MAPK13 and MAPK14) during oxidative stress. Plays a role in a staurosporine-induced caspase-independent apoptotic pathway by regulating the nuclear translocation of AIFM1 and ENDOG and the DNase activity associated with ENDOG. Phosphorylates STK38L on 'Thr-442' and stimulates its kinase activity. In association with STK26 negatively regulates Golgi reorientation in polarized cell migration upon RHO activation (PubMed:27807006). Also regulates cellular migration with alteration of PTPN12 activity and PXN phosphorylation: phosphorylates PTPN12 and inhibits its activity and may regulate PXN phosphorylation through PTPN12. May act as a key regulator of axon regeneration in the optic nerve and radial nerve. Part of the striatin-interacting phosphatase and kinase (STRIPAK) complexes. STRIPAK complexes have critical roles in protein (de)phosphorylation and are regulators of multiple signaling pathways including Hippo, MAPK, nuclear receptor and cytoskeleton remodeling. Different types of STRIPAK complexes are involved in a variety of biological processes such as cell growth, differentiation, apoptosis, metabolism and immune regulation (PubMed:18782753)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}