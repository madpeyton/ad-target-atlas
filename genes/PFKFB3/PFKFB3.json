NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q16875","text":"Catalyzes both the synthesis and degradation of fructose 2,6-bisphosphate."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}