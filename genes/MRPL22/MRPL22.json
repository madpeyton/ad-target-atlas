egas_padj":0.106393},{"cell_type":"Oli","gene_symbol":"MRPL22","gene_symbol_current":"MRPL22","gene_id":"ENSG00000082515","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.046843,"nucleus_log2fc":-0.059961,"nucleus_score":-2.11735,"pct_ad":0.15763,"pct_control":0.163285,"donor_test":"not significant","donor_padj":0.921562,"donor_log2fc":-0.0381229,"donor_lfcse":0.0594653,"donor_log2fc_shrunk":-0.00955931,"degas_log2fc":-0.142186,"degas_padj":1.65234e-06}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000082515","module":"turquoise","kme":0.0776342,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000082515","module":"turquoise","kme":0.0519556,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000082515","entrez_id":["29093"],"uniprot":["Q9NWU5"],"ncbi_summary":"Mammalian mitochondrial ribosomal proteins are encoded by nuclear genes and help in protein synthesis within the mitochondrion. Mitochondrial ribosomes (mitoribosomes) consist of a small 28S subunit and a large 39S subunit. They have an estimated 75% protein to rRNA composition compared to prokaryotic ribosomes, where this ratio is reversed. Another difference between mammalian mitoribosomes and prokaryotic ribosomes is that the latter contain a 5S rRNA. Among different species, the proteins comprising the mitoribosome differ greatly in sequence, and sometimes in biochemical properties, which prevents easy recognition by sequence homology. This gene encodes a 39S subunit protein that belongs to the L22 ribosomal protein family. A pseudogene corresponding to this gene is found on chromosome 4q. Two transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}