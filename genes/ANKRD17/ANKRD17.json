,"nucleus_padj":0.246635,"nucleus_log2fc":0.0213619,"nucleus_score":1.52819,"pct_ad":0.856397,"pct_control":0.860627,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.021801,"donor_lfcse":0.0826489,"donor_log2fc_shrunk":3.31863e-06},{"cell_type":"Oli","gene_symbol":"ANKRD17","gene_symbol_current":"ANKRD17","gene_id":"ENSG00000132466","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.53023e-05,"nucleus_log2fc":0.0373562,"nucleus_score":4.4789,"pct_ad":0.760074,"pct_control":0.770513,"donor_test":"not significant","donor_padj":0.978464,"donor_log2fc":0.018104,"donor_lfcse":0.103706,"donor_log2fc_shrunk":0.000767545}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000132466","module":"green","kme":0.231213,"hub":false,"module_direction":"higher in AD","module_padj":0.232138,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000132466","module":"green","kme":0.269636,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000132466","module":"blue","kme":0.289988,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000132466","module":"brown","kme":0.236741,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000132466","module":"blue","kme":0.24427,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000132466","entrez_id":["26057"],"uniprot":["O75179"],"ncbi_summary":"The protein encoded by this gene belongs to the family of ankyrin repeat-containing proteins, and contains two distinct arrays of ankyrin repeats in its amino-terminal region, one with 15 ankyrin repeats, and the other with 10 ankyrin repeats. It also contains a nuclear export signal, nuclear localization signal, and a cyclin-binding RXL motif. Localization of this protein to the nucleus has been shown experimentally, and interactions between this protein and cyclin-dependent kinase 2 have been observed. It has been suggested that this protein plays a role in both DNA replication and in both anti-viral and anti-bacterial innate immune pathways. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Dec 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75179","text":"Could play pivotal roles in cell cycle and DNA regulation (PubMed:19150984). Involved in innate immune defense against viruse by positively regulating the viral dsRNA receptors DDX58 and IFIH1 signaling pathways (PubMed:22328336). Involves in NOD2- and NOD1-mediated responses to bacteria suggesting a role in innate antibacterial immune pathways too (PubMed:23711367). Target of enterovirus 71 which is the major etiological agent of HFMD (hand, foot and mouth disease) (PubMed:17276651). Could play a central role for the formation and/or maintenance of the blood vessels of the circulation system (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}