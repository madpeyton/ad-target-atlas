d":"ENSG00000132382","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.13012,"nucleus_log2fc":-0.0617735,"nucleus_score":-1.70651,"pct_ad":0.16345,"pct_control":0.172595,"donor_test":"not significant","donor_padj":0.994185,"donor_log2fc":0.0232162,"donor_lfcse":0.0886064,"donor_log2fc_shrunk":3.08737e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000132382","entrez_id":["10514"],"uniprot":["Q9BQG0"],"ncbi_summary":"This gene encodes a nucleolar transcriptional regulator that was first identified by its ability to bind specifically to the Myb proto-oncogene protein. The encoded protein is thought to play a role in many cellular processes including response to nucleolar stress, tumor suppression and synthesis of ribosomal DNA. Alternate splicing results in multiple transcript variants. [provided by RefSeq, Sep 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BQG0","text":"May activate or repress transcription via interactions with sequence specific DNA-binding proteins (By similarity). Repression may be mediated at least in part by histone deacetylase activity (HDAC activity) (By similarity). Acts as a corepressor and in concert with CRY1, represses the transcription of the core circadian clock component PER2 (By similarity). Preferentially binds to dimethylated histone H3 'Lys-9' (H3K9me2) on the PER2 promoter (By similarity). Has a role in rRNA biogenesis together with PWP1 (PubMed:29065309)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}