ucleus_log2fc":0.0865536,"nucleus_score":2.88747,"pct_ad":0.113984,"pct_control":0.10689,"donor_test":"not significant","donor_padj":0.848963,"donor_log2fc":0.0914648,"donor_lfcse":0.0892927,"donor_log2fc_shrunk":0.0118595,"degas_log2fc":0.136519,"degas_padj":0.000160772}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000182180","module":"turquoise","kme":0.0920868,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000182180","module":"turquoise","kme":0.245685,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000182180","module":"turquoise","kme":0.0692837,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000182180","module":"turquoise","kme":0.062599,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000182180","entrez_id":["51021"],"uniprot":["Q9Y3D3"],"ncbi_summary":"Mammalian mitochondrial ribosomal proteins are encoded by nuclear genes and help in protein synthesis within the mitochondrion. Mitochondrial ribosomes (mitoribosomes) consist of a small 28S subunit and a large 39S subunit. They have an estimated 75% protein to rRNA composition compared to prokaryotic ribosomes, where this ratio is reversed. Another difference between mammalian mitoribosomes and prokaryotic ribosomes is that the latter contain a 5S rRNA. Among different species, the proteins comprising the mitoribosome differ greatly in sequence, and sometimes in biochemical properties, which prevents easy recognition by sequence homology. This gene encodes a 28S subunit protein that belongs to the ribosomal protein S16P family. The encoded protein is one of the most highly conserved ribosomal proteins between mammalian and yeast mitochondria. Three pseudogenes (located at 8q21.3, 20q13.32, 22q12-q13.1) for this gene have been described. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}