er in AD","module_padj":0.726304,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000176454","module":"turquoise","kme":0.110784,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000176454","module":"turquoise","kme":0.135094,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000176454"],"dataset_symbols":["LPCAT4"],"explorer":"explorer.html?dataset=mathys2019#gene/LPCAT4","cell_types":[{"cell_type":"Ex","gene_symbol":"LPCAT4","gene_symbol_current":"LPCAT4","gene_id":"ENSG00000176454","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00589467,"nucleus_log2fc":0.12553,"nucleus_score":3.00338,"pct_ad":0.415786,"pct_control":0.408438,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0952154,"donor_lfcse":0.0870482,"donor_log2fc_shrunk":1.25224e-05},{"cell_type":"In","gene_symbol":"LPCAT4","gene_symbol_current":"LPCAT4","gene_id":"ENSG00000176454","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0349893,"nucleus_log2fc":0.257009,"nucleus_score":3.27705,"pct_ad":0.282165,"pct_control":0.239651,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.234885,"donor_lfcse":0.102353,"donor_log2fc_shrunk":1.87218e-05}],"modules":[{"cell_type":"In","gene_id":"ENSG00000176454","module":"brown","kme":0.304222,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000176454","entrez_id":["254531"],"uniprot":["Q643R3"],"ncbi_summary":"Members of the 1-acylglycerol-3-phosphate O-acyltransferase (EC 2.3.1.51) family, such as AGPAT7, catalyze the conversion of lysophosphatidic acid (LPA) to phosphatidic acid (PA), a precursor in the biosynthesis of all glycerolipids. Both LPA and PA are involved in signal transduction (Ye et al., 2005 [PubMed 16243729]).[supplied by OMIM, May 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q643R3","text":"Acyl-CoA-dependent lysophospholipid acyltransferase involved in phospholipid remodeling. Displays acyltransferase activity with a subset of lysophospholipids as substrates; converts lysophosphatidylethanolamine to phosphatidylethanolamine, lysophosphatidylcholine to phosphatidycholine, 1-alkenyl-lysophatidylethanolamine to 1-alkenyl-phosphatidylethanolamine, lysophosphatidylglycerol and alkyl-lysophosphatidylcholine to phosphatidylglycerol and alkyl-phosphatidylcholine, respectively (PubMed:18458083, PubMed:41740885). Can use various medium- and long-chain, saturated and unsaturated fatty acyl-CoAs, displaying the highest activity toward unsaturated fatty acyl-CoAs (PubMed:18458083, PubMed:41740885). Catalysis the biosynthesis of atypical phospholipids carrying unsaturated fatty acids esterified at the sn-1 position of the glycerol backbone. Transfers unsaturated fatty acyl chains to the sn-1 position of lysophosphatidylcholines, lysophosphatidylethanolamines and lysophosphatidylserines with lysophosphatidylcholines being the preferred substrates. Contributes to the remodeling of brain phosphatidylcholine species with unsaturated fatty acyl chains such as C18:1, C18:2, C20:4 and C22:6 at the sn-1 position (PubMed:41740885). Has no apparent acyltransferase activity toward lysophosphatidylinositols, lysophosphatidic acids, lysophosphatidylglycerols, glycerol-3-phosphates or diacylglycerols. Has no acetyltransferase activity toward lysoplatelet-activating factor (lyso-PAF) (PubMed:18458083, PubMed:41740885)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}