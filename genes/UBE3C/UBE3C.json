9,"donor_log2fc":0.0235327,"donor_lfcse":0.0922133,"donor_log2fc_shrunk":3.43633e-06},{"cell_type":"Mic","gene_symbol":"UBE3C","gene_symbol_current":"UBE3C","gene_id":"ENSG00000009335","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.435404,"nucleus_log2fc":0.283248,"nucleus_score":1.42668,"pct_ad":0.159902,"pct_control":0.133583,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"UBE3C","gene_symbol_current":"UBE3C","gene_id":"ENSG00000009335","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.878135,"nucleus_log2fc":0.0482113,"nucleus_score":0.369819,"pct_ad":0.251177,"pct_control":0.246743,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":0.101758,"donor_lfcse":0.132309,"donor_log2fc_shrunk":0.00118797},{"cell_type":"Oli","gene_symbol":"UBE3C","gene_symbol_current":"UBE3C","gene_id":"ENSG00000009335","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.655137,"nucleus_log2fc":-0.0654053,"nucleus_score":-0.605534,"pct_ad":0.116203,"pct_control":0.118565,"donor_test":"not significant","donor_padj":0.797653,"donor_log2fc":-0.118578,"donor_lfcse":0.0959726,"donor_log2fc_shrunk":-0.012273}],"modules":[{"cell_type":"In","gene_id":"ENSG00000009335","module":"yellow","kme":0.203237,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000009335","entrez_id":["9690"],"uniprot":["Q15386"],"ncbi_summary":"Enables ubiquitin protein ligase activity. Involved in protein polyubiquitination. Predicted to be located in nucleus. Predicted to be part of proteasome complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15386","text":"E3 ubiquitin-protein ligase that specifically catalyzes 'Lys-29'- and 'Lys-48'-linked polyubiquitin chains (PubMed:11278995, PubMed:12692129, PubMed:16341092, PubMed:16601690, PubMed:24158444, PubMed:24811749, PubMed:25752573, PubMed:25752577, PubMed:32039437, PubMed:33637724, PubMed:34239127). Accepts ubiquitin from the E2 ubiquitin-conjugating enzyme UBE2D1 in the form of a thioester and then directly transfers the ubiquitin to targeted substrates (PubMed:32039437, PubMed:9575161). Associates with the proteasome and promotes elongation of ubiquitin chains on substrates bound to the 26S proteasome (PubMed:24158444, PubMed:28396413, PubMed:31375563). Also catalyzes 'Lys-29'- and 'Lys-48'-linked ubiquitination of 26S proteasome subunit ADRM1/RPN13 in response to proteotoxic stress, impairing the ability of the proteasome to bind and degrade ubiquitin-conjugated proteins (PubMed:24811749, PubMed:31375563). Acts as a negative regulator of autophagy by mediating 'Lys-29'- and 'Lys-48'-linked ubiquitination of PIK3C3/VPS34, promoting its degradation (PubMed:33637724). Can assemble unanchored poly-ubiquitin chains in either 'Lys-29'- or 'Lys-48'-linked polyubiquitin chains; with some preference for 'Lys-48' linkages (PubMed:11278995, PubMed:16601690, PubMed:25752577). Acts as a negative regulator of type I interferon by mediating 'Lys-48'-linked ubiquitination of IRF3 and IRF7, leading to their degradation by the proteasome (PubMed:21167755). Catalyzes ubiquitination and degradation of CAND2 (PubMed:12692129)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}