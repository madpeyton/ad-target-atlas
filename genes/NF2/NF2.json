c":-0.0550411,"donor_lfcse":0.0878115,"donor_log2fc_shrunk":-7.37854e-06,"degas_log2fc":-0.4144,"degas_padj":7.14766e-14},{"cell_type":"Oli","gene_symbol":"NF2","gene_symbol_current":"NF2","gene_id":"ENSG00000186575","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.387044,"nucleus_log2fc":-0.0179924,"nucleus_score":-0.957074,"pct_ad":0.142523,"pct_control":0.145246,"donor_test":"not significant","donor_padj":0.93178,"donor_log2fc":0.0390855,"donor_lfcse":0.0722712,"donor_log2fc_shrunk":0.00678895,"degas_log2fc":-0.209193,"degas_padj":2.70155e-11}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000186575","module":"blue","kme":0.15415,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000186575","module":"red","kme":0.205012,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000186575","module":"blue","kme":0.128102,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000186575","module":"blue","kme":0.077955,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000186575","entrez_id":["4771"],"uniprot":["P35240"],"ncbi_summary":"This gene encodes a protein that is similar to some members of the ERM (ezrin, radixin, moesin) family of proteins that link cytoskeletal components with proteins in the cell membrane. The encoded protein is involved in regulation of contact-dependent inhibition of cell proliferation and functions in cell-cell adhesion and transmembrane signaling. The encoded protein has been shown to interact with cell-surface proteins, proteins involved in cytoskeletal dynamics, and proteins involved in regulating ion transport. Disruption of this protein's function has been implicated in tumorigenesis and metastasis. Mutations in this gene are associated with neurofibromatosis type II which is characterized by nervous system and skin tumors and ocular abnormalities. [provided by RefSeq, May 2022].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P35240","text":"Probable regulator of the Hippo/SWH (Sav/Wts/Hpo) signaling pathway, a signaling pathway that plays a pivotal role in tumor suppression by restricting proliferation and promoting apoptosis. Along with WWC1 can synergistically induce the phosphorylation of LATS1 and LATS2 and can probably function in the regulation of the Hippo/SWH (Sav/Wts/Hpo) signaling pathway. May act as a membrane stabilizing protein. May inhibit PI3 kinase by binding to AGAP2 and impairing its stimulating activity. Suppresses cell proliferation and tumorigenesis by inhibiting the CUL4A-RBX1-DDB1-VprBP/DCAF1 E3 ubiquitin-protein ligase complex."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}