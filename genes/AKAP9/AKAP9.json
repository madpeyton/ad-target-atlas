0253722,"donor_lfcse":0.061517,"donor_log2fc_shrunk":6.91515e-06},{"cell_type":"Mic","gene_symbol":"AKAP9","gene_symbol_current":"AKAP9","gene_id":"ENSG00000127914","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.917813,"nucleus_log2fc":-0.0655281,"nucleus_score":-0.274156,"pct_ad":0.211562,"pct_control":0.21598,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"AKAP9","gene_symbol_current":"AKAP9","gene_id":"ENSG00000127914","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.859485,"nucleus_log2fc":0.0245026,"nucleus_score":0.415597,"pct_ad":0.475667,"pct_control":0.478161,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":0.140789,"donor_lfcse":0.116776,"donor_log2fc_shrunk":0.00212413},{"cell_type":"Oli","gene_symbol":"AKAP9","gene_symbol_current":"AKAP9","gene_id":"ENSG00000127914","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.000918211,"nucleus_log2fc":0.178404,"nucleus_score":3.69575,"pct_ad":0.289269,"pct_control":0.263666,"donor_test":"not significant","donor_padj":0.735413,"donor_log2fc":0.142951,"donor_lfcse":0.0764296,"donor_log2fc_shrunk":0.0268197}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000127914","module":"turquoise","kme":0.136207,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000127914","module":"blue","kme":0.108857,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000127914","module":"turquoise","kme":0.185471,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000127914","entrez_id":["10142"],"uniprot":["Q99996"],"ncbi_summary":"The A-kinase anchor proteins (AKAPs) are a group of structurally diverse proteins which have the common function of binding to the regulatory subunit of protein kinase A (PKA) and confining the holoenzyme to discrete locations within the cell. This gene encodes a member of the AKAP family. Alternate splicing of this gene results in at least two isoforms that localize to the centrosome and the Golgi apparatus, and interact with numerous signaling proteins from multiple signal transduction pathways. These signaling proteins include type II protein kinase A, serine/threonine kinase protein kinase N, protein phosphatase 1, protein phosphatase 2a, protein kinase C-epsilon and phosphodiesterase 4D3. [provided by RefSeq, Aug 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q99996","text":"Scaffolding protein that assembles several protein kinases and phosphatases on the centrosome and Golgi apparatus. Required to maintain the integrity of the Golgi apparatus (PubMed:10202149, PubMed:15047863). Required for microtubule nucleation at the cis-side of the Golgi apparatus (PubMed:15047863, PubMed:19242490). Required for association of the centrosomes with the poles of the bipolar mitotic spindle during metaphase (PubMed:25657325). In complex with PDE4DIP isoform 13/MMG8/SMYLE, recruits CAMSAP2 to the Golgi apparatus and tethers non-centrosomal minus-end microtubules to the Golgi, an important step for polarized cell movement (PubMed:27666745, PubMed:28814570). In complex with PDE4DIP isoform 13/MMG8/SMYLE, EB1/MAPRE1 and CDK5RAP2, contributes to microtubules nucleation and extension also from the centrosome to the cell periphery (PubMed:29162697). [Isoform 4]: Associated with the N-methyl-D-aspartate receptor and is specifically found in the neuromuscular junction (NMJ) as well as in neuronal synapses, suggesting a role in the organization of postsynaptic specializations."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}