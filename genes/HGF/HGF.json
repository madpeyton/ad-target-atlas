ype":"Ast","gene_symbol":"HGF","gene_symbol_current":"HGF","gene_id":"ENSG00000019991","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.210854,"nucleus_log2fc":0.331185,"nucleus_score":1.5756,"pct_ad":0.12694,"pct_control":0.111906,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000019991","module":"magenta","kme":0.238564,"hub":false,"module_direction":"higher in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000019991","module":"brown","kme":0.26849,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000019991","entrez_id":["3082"],"uniprot":["P14210"],"ncbi_summary":"This gene encodes a protein that binds to the hepatocyte growth factor receptor to regulate cell growth, cell motility and morphogenesis in numerous cell and tissue types. Alternative splicing results in multiple transcript variants, at least one of which encodes a preproprotein that is proteolytically processed to generate alpha and beta chains, which form the mature heterodimer. This protein is secreted by mesenchymal cells and acts as a multi-functional cytokine on cells of mainly epithelial origin. This protein also plays a role in angiogenesis, tumorogenesis, and tissue regeneration. Although the encoded protein is a member of the peptidase S1 family of serine proteases, it lacks peptidase activity. Mutations in this gene are associated with nonsyndromic hearing loss. [provided by RefSeq, Nov 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P14210","text":"Potent mitogen for mature parenchymal hepatocyte cells, seems to be a hepatotrophic factor, and acts as a growth factor for a broad spectrum of tissues and cell types (PubMed:20624990). Activating ligand for the receptor tyrosine kinase MET by binding to it and promoting its dimerization (PubMed:15167892, PubMed:20977675). Activates MAPK signaling following TMPRSS13 cleavage and activation (PubMed:20977675)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}