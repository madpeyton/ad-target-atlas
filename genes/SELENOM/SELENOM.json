OM","gene_symbol_current":"SELENOM","gene_id":"ENSG00000198832","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.78147e-05,"nucleus_log2fc":0.291383,"nucleus_score":4.45546,"pct_ad":0.207575,"pct_control":0.177646,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.223445,"donor_lfcse":0.260258,"donor_log2fc_shrunk":3.44978e-06},{"cell_type":"Oli","gene_symbol":"SELENOM","gene_symbol_current":"SELENOM","gene_id":"ENSG00000198832","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.04823e-07,"nucleus_log2fc":0.216373,"nucleus_score":5.35201,"pct_ad":0.133482,"pct_control":0.120996,"donor_test":"not significant","donor_padj":0.829406,"donor_log2fc":0.294893,"donor_lfcse":0.266852,"donor_log2fc_shrunk":0.00462561}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000198832","module":"turquoise","kme":0.221219,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000198832","module":"brown","kme":0.435134,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000198832","module":"brown","kme":0.504409,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000198832","module":"turquoise","kme":0.290624,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000198832","module":"turquoise","kme":0.271725,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198832","entrez_id":["140606"],"uniprot":["Q8WWX9"],"ncbi_summary":"The protein encoded by this gene belongs to the selenoprotein M/SEP15 family. The exact function of this protein is not known. It is localized in the perinuclear region, is highly expressed in the brain, and may be involved in neurodegenerative disorders. Transgenic mice with targeted deletion of this gene exhibit increased weight gain, suggesting a role for this gene in the regulation of body weight and energy metabolism. This protein is a selenoprotein, containing the rare amino acid selenocysteine (Sec). Sec is encoded by the UGA codon, which normally signals translation termination. The 3' UTRs of selenoprotein mRNAs contain a conserved stem-loop structure, designated the Sec insertion sequence (SECIS) element, that is necessary for the recognition of UGA as a Sec codon, rather than as a stop signal. [provided by RefSeq, Dec 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WWX9","text":"May function as a thiol-disulfide oxidoreductase that participates in disulfide bond formation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}