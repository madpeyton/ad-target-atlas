,"pct_control":0.314862,"donor_test":"not significant","donor_padj":0.657213,"donor_log2fc":-0.214566,"donor_lfcse":0.158898,"donor_log2fc_shrunk":-0.0183163},{"cell_type":"OPC","gene_symbol":"TNIK","gene_symbol_current":"TNIK","gene_id":"ENSG00000154310","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.226164,"nucleus_log2fc":0.0344901,"nucleus_score":1.58936,"pct_ad":0.924993,"pct_control":0.917358,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.00689705,"donor_lfcse":0.105519,"donor_log2fc_shrunk":-6.17932e-07},{"cell_type":"Oli","gene_symbol":"TNIK","gene_symbol_current":"TNIK","gene_id":"ENSG00000154310","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":4.29625e-103,"nucleus_log2fc":-0.335394,"nucleus_score":-21.71,"pct_ad":0.549987,"pct_control":0.628836,"donor_test":"not significant","donor_padj":0.623121,"donor_log2fc":-0.293567,"donor_lfcse":0.151658,"donor_log2fc_shrunk":-0.0157083}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000154310","module":"pink","kme":0.486376,"hub":true,"module_direction":"lower in AD","module_padj":0.531952,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000154310","module":"yellow","kme":0.461236,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000154310","module":"turquoise","kme":0.138187,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000154310","module":"brown","kme":0.339677,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000154310","entrez_id":["23043"],"uniprot":["Q9UKE5"],"ncbi_summary":"Wnt signaling plays important roles in carcinogenesis and embryonic development. The protein encoded by this gene is a serine/threonine kinase that functions as an activator of the Wnt signaling pathway. Mutations in this gene are associated with an autosomal recessive form of cognitive disability. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Jul 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UKE5","text":"Serine/threonine kinase that acts as an essential activator of the Wnt signaling pathway. Recruited to promoters of Wnt target genes and required to activate their expression. May act by phosphorylating TCF4/TCF7L2. Appears to act upstream of the JUN N-terminal pathway. May play a role in the response to environmental stress. Part of a signaling complex composed of NEDD4, RAP2A and TNIK which regulates neuronal dendrite extension and arborization during development. More generally, it may play a role in cytoskeletal rearrangements and regulate cell spreading. Phosphorylates SMAD1 on Thr-322. Activator of the Hippo signaling pathway which plays a pivotal role in organ size control and tumor suppression by restricting proliferation and promoting apoptosis. MAP4Ks act in parallel to and are partially redundant with STK3/MST2 and STK4/MST2 in the phosphorylation and activation of LATS1/2, and establish MAP4Ks as components of the expanded Hippo pathway (PubMed:26437443)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}