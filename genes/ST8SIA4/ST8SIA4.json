rol":0.651613,"donor_test":"not significant","donor_padj":0.859346,"donor_log2fc":0.0908323,"donor_lfcse":0.12958,"donor_log2fc_shrunk":0.0103019},{"cell_type":"Oli","gene_symbol":"ST8SIA4","gene_symbol_current":"ST8SIA4","gene_id":"ENSG00000113532","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.921024,"donor_log2fc":-0.120842,"donor_lfcse":0.187805,"donor_log2fc_shrunk":-0.00376934}],"modules":[{"cell_type":"In","gene_id":"ENSG00000113532","module":"green","kme":0.56432,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000113532","module":"yellow","kme":0.314101,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000113532","entrez_id":["7903"],"uniprot":["Q92187"],"ncbi_summary":"The protein encoded by this gene catalyzes the polycondensation of alpha-2,8-linked sialic acid required for the synthesis of polysialic acid, a modulator of the adhesive properties of neural cell adhesion molecule (NCAM1). The encoded protein, which is a member of glycosyltransferase family 29, is a type II membrane protein that may be present in the Golgi apparatus. Two transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92187","text":"Catalyzes the transfer of a sialic acid from a CMP-linked sialic acid donor onto a terminal alpha-2,3-, alpha-2,6-, or alpha-2,8-linked sialic acid of an N-linked glycan protein acceptor through alpha-2,8-linkages (PubMed:10766765, PubMed:11279095, PubMed:28810663, PubMed:9774483). Therefore, participates in polysialic acid synthesis on various sialylated N-acetyllactosaminyl oligosaccharides, including NCAM1 N-glycans, FETUB N-glycans and AHSG (PubMed:10766765, PubMed:11279095, PubMed:28810663, PubMed:9774483). It is noteworthy that alpha-2,3-linked sialic acid is apparently a better acceptor than alpha-2,6-linked sialic acid (PubMed:9774483)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}