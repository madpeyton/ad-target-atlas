ested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.133841,"donor_lfcse":0.200525,"donor_log2fc_shrunk":3.33651e-06},{"cell_type":"Oli","gene_symbol":"SLC6A6","gene_symbol_current":"SLC6A6","gene_id":"ENSG00000131389","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":4.70664e-88,"nucleus_log2fc":0.568221,"nucleus_score":20.0435,"pct_ad":0.248361,"pct_control":0.190429,"donor_test":"not significant","donor_padj":0.612605,"donor_log2fc":0.507055,"donor_lfcse":0.254359,"donor_log2fc_shrunk":0.00818296}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000131389","module":"blue","kme":0.248004,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000131389","module":"red","kme":0.159217,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000131389","module":"blue","kme":0.155012,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000131389","module":"blue","kme":0.0713905,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000131389","module":"blue","kme":0.143945,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000131389","entrez_id":["6533"],"uniprot":["P31641"],"ncbi_summary":"This gene encodes a multi-pass membrane protein that is a member of a family of sodium and chloride-ion dependent transporters. The encoded protein transports taurine and beta-alanine. There is a pseudogene for this gene on chromosome 21. Alternative splicing results in multiple transcript variants. [provided by RefSeq, May 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P31641","text":"Mediates sodium- and chloride-dependent transport of taurine, a key amino acid (PubMed:31345061, PubMed:31903486, PubMed:39837997, PubMed:40108165, PubMed:40108449, PubMed:40615403, PubMed:40789850, PubMed:41269860, PubMed:41652173, PubMed:8010975, PubMed:8382624, PubMed:8654117). Taurine acts as an anti-aging agent by reducing cellular senescence and combating oxidative stress: levels decline with age and supplementation has been shown to extend lifespan (By similarity). In addition to mediate extracellular taurine uptake, also able to mediate transport of taurine into mitochondria, sustaining mitochondrial translation (PubMed:41652173). Can also mediate transport of beta-alanine, hypotaurine and gamma-aminobutyric acid (GABA) (PubMed:39837997, PubMed:40108165, PubMed:40789850, PubMed:41269860, PubMed:8010975)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}