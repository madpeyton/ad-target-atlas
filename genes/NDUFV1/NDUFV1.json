us_direction":"lower in AD","nucleus_padj":0.566834,"nucleus_log2fc":-0.027269,"nucleus_score":-0.819591,"pct_ad":0.336863,"pct_control":0.343946,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0899326,"donor_lfcse":0.133356,"donor_log2fc_shrunk":-5.2671e-06},{"cell_type":"Oli","gene_symbol":"NDUFV1","gene_symbol_current":"NDUFV1","gene_id":"ENSG00000167792","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.62747e-14,"nucleus_log2fc":-0.157433,"nucleus_score":-7.83941,"pct_ad":0.294925,"pct_control":0.322412,"donor_test":"not significant","donor_padj":0.827384,"donor_log2fc":-0.116961,"donor_lfcse":0.105288,"donor_log2fc_shrunk":-0.0112623}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000167792","module":"turquoise","kme":0.121039,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000167792","module":"turquoise","kme":0.290396,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000167792","module":"turquoise","kme":0.144374,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000167792","module":"turquoise","kme":0.160618,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000167792","entrez_id":["4723"],"uniprot":["P49821"],"ncbi_summary":"The mitochondrial respiratory chain provides energy to cells via oxidative phosphorylation and consists of four membrane-bound electron-transporting protein complexes (I-IV) and an ATP synthase (complex V). This gene encodes a 51 kDa subunit of the NADH:ubiquinone oxidoreductase complex I; a large complex with at least 45 nuclear and mitochondrial encoded subunits that liberates electrons from NADH and channels them to ubiquinone. This subunit carries the NADH-binding site as well as flavin mononucleotide (FMN)- and Fe-S-biding sites. Defects in complex I are a common cause of mitochondrial dysfunction; a syndrome that occurs in approximately 1 in 10,000 live births. Mitochondrial complex I deficiency is linked to myopathies, encephalomyopathies, and neurodegenerative disorders such as Parkinson's disease and Leigh syndrome. Alternative splicing results in multiple transcript variants encoding distinct isoforms.[provided by RefSeq, Oct 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49821","text":"Core subunit of the mitochondrial membrane respiratory chain NADH dehydrogenase (Complex I) which catalyzes electron transfer from NADH through the respiratory chain, using ubiquinone as an electron acceptor (PubMed:28844695). Part of the peripheral arm of the enzyme, where the electrons from NADH are accepted by flavin mononucleotide (FMN) and then passed along a chain of iron-sulfur clusters by electron tunnelling to the final acceptor ubiquinone (PubMed:28844695). Contains FMN, which is the initial electron acceptor as well as one iron-sulfur cluster (PubMed:28844695)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}