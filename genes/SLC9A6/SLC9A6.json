0.446837,"nucleus_log2fc":0.114391,"nucleus_score":1.61972,"pct_ad":0.30701,"pct_control":0.284781,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.137518,"donor_lfcse":0.132787,"donor_log2fc_shrunk":7.92963e-06},{"cell_type":"OPC","gene_symbol":"SLC9A6","gene_symbol_current":"SLC9A6","gene_id":"ENSG00000198689","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.55162,"nucleus_log2fc":-0.165115,"nucleus_score":-1.15958,"pct_ad":0.0879121,"pct_control":0.101916,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"SLC9A6","gene_symbol_current":"SLC9A6","gene_id":"ENSG00000198689","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.896148,"donor_log2fc":0.103734,"donor_lfcse":0.140434,"donor_log2fc_shrunk":0.0049876}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000198689","module":"yellow","kme":0.356893,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000198689","module":"pink","kme":0.255488,"hub":false,"module_direction":"higher in AD","module_padj":0.41964,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198689","entrez_id":["10479"],"uniprot":["Q92581"],"ncbi_summary":"This gene encodes a sodium-hydrogen exchanger that is amember of the solute carrier family 9. The encoded protein localizes to early and recycling endosomes and may be involved in regulating endosomal pH and volume. Defects in this gene are associated with X-linked syndromic cognitive disability, Christianson type. Alternate splicing results in multiple transcript variants.[provided by RefSeq, Apr 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92581","text":"Endosomal Na(+), K(+)/H(+) antiporter (PubMed:15522866, PubMed:28635961, PubMed:31676550, PubMed:32277048). Mediates the electroneutral exchange of endosomal luminal H(+) for a cytosolic Na(+) or K(+). By facilitating proton efflux, SLC9A6 counteracts the acidity generated by vacuolar (V)-ATPase, thereby limiting luminal acidification. Responsible for alkalizing and maintaining the endosomal pH, and consequently in, e.g., endosome maturation and trafficking of recycling endosomal cargo (PubMed:15522866, PubMed:28635961, PubMed:31676550, PubMed:32277048). Plays a critical role during neurodevelopment by regulating synaptic development and plasticity (By similarity). Implicated in the maintenance of cell polarity in a manner that is dependent on its ability to modulate intravesicular pH (PubMed:20130086). Regulates intracellular pH in some specialized cells, osteoclasts and stereocilia where this transporter localizes to the plasma membrane (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}