ell_type":"Ex","gene_symbol":"TNFRSF4","gene_symbol_current":"TNFRSF4","gene_id":"ENSG00000186827","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.670962,"donor_log2fc":0.33246,"donor_lfcse":0.226757,"donor_log2fc_shrunk":0.00608007},{"cell_type":"In","gene_symbol":"TNFRSF4","gene_symbol_current":"TNFRSF4","gene_id":"ENSG00000186827","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.816161,"donor_log2fc":0.197917,"donor_lfcse":0.223857,"donor_log2fc_shrunk":0.00188225}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000186827","entrez_id":["7293"],"uniprot":["P43489"],"ncbi_summary":"The protein encoded by this gene is a member of the TNF-receptor superfamily. This receptor has been shown to activate NF-kappaB through its interaction with adaptor proteins TRAF2 and TRAF5. Knockout studies in mice suggested that this receptor promotes the expression of apoptosis inhibitors BCL2 and BCL2lL1/BCL2-XL, and thus suppresses apoptosis. The knockout studies also suggested the roles of this receptor in CD4+ T cell response, as well as in T cell-dependent B cell proliferation and differentiation. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P43489","text":"Receptor for TNFSF4/OX40L/GP34. Is a costimulatory molecule implicated in long-term T-cell immunity. (Microbial infection) Acts as a receptor for human herpesvirus 6B/HHV-6B."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}