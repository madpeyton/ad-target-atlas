e_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000023572","module":"turquoise","kme":0.102288,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000023572"],"dataset_symbols":["GLRX2"],"explorer":"explorer.html?dataset=mathys2019#gene/GLRX2","cell_types":[{"cell_type":"Ex","gene_symbol":"GLRX2","gene_symbol_current":"GLRX2","gene_id":"ENSG00000023572","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00210263,"nucleus_log2fc":-0.174799,"nucleus_score":-3.34,"pct_ad":0.132466,"pct_control":0.147631,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.145595,"donor_lfcse":0.19253,"donor_log2fc_shrunk":1.06066e-05}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000023572","module":"turquoise","kme":0.28505,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000023572","module":"turquoise","kme":0.261633,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000023572","entrez_id":["51022"],"uniprot":["Q9NS18"],"ncbi_summary":"The protein encoded by this gene is a member of the glutaredoxin family of proteins, which maintain cellular thiol homeostasis. These proteins are thiol-disulfide oxidoreductases that use a glutathione-binding site and one or two active cysteines in their active site. This gene undergoes alternative splicing to produce multiple isoforms, one of which is ubiquitously expressed and localizes to mitochondria, where it functions in mitochondrial redox homeostasis and is important for the protection against and recovery from oxidative stress. Other isoforms, which have more restrictive expression patterns, show cytosolic and nuclear localization, and are thought to function in cellular differentiation and transformation, possibly with a role in tumor progression. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NS18","text":"Glutathione-dependent oxidoreductase that facilitates the maintenance of mitochondrial redox homeostasis upon induction of apoptosis by oxidative stress. Involved in response to hydrogen peroxide and regulation of apoptosis caused by oxidative stress. Acts as a very efficient catalyst of monothiol reactions because of its high affinity for protein glutathione-mixed disulfides. Can receive electrons not only from glutathione (GSH), but also from thioredoxin reductase supporting both monothiol and dithiol reactions. Efficiently catalyzes both glutathionylation and deglutathionylation of mitochondrial complex I, which in turn regulates the superoxide production by the complex. Overexpression decreases the susceptibility to apoptosis and prevents loss of cardiolipin and cytochrome c release."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}