t":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.751245,"donor_log2fc":-0.2855,"donor_lfcse":0.212756,"donor_log2fc_shrunk":-0.00307326,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"EFS","gene_symbol_current":"EFS","gene_id":"ENSG00000100842","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00695435,"nucleus_log2fc":-0.166412,"nucleus_score":-3.19603,"pct_ad":0.259618,"pct_control":0.284166,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.128959,"donor_lfcse":0.104162,"donor_log2fc_shrunk":-1.36592e-05,"degas_log2fc":0.0442491,"degas_padj":0.442392},{"cell_type":"Oli","gene_symbol":"EFS","gene_symbol_current":"EFS","gene_id":"ENSG00000100842","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":5.28369e-58,"nucleus_log2fc":-0.382701,"nucleus_score":-16.2141,"pct_ad":0.213467,"pct_control":0.263993,"donor_test":"not significant","donor_padj":0.615914,"donor_log2fc":-0.311951,"donor_lfcse":0.158695,"donor_log2fc_shrunk":-0.0146941,"degas_log2fc":-0.23875,"degas_padj":3.3921e-23}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000100842","module":"turquoise","kme":0.0588054,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000100842","module":"turquoise","kme":0.03765,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000100842","module":"turquoise","kme":0.0740128,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100842","entrez_id":["10278"],"uniprot":["O43281"],"ncbi_summary":"The protein encoded by this gene is a member of the CAS (CRK-associated substrate) family of adaptor proteins which typically serve as scaffolds for the assembly of larger signaling complexes. These complexes form at the cell surface where integrin binding leads to the subsequent phosphorylation of a CAS protein. Additional binding of SRC family kinases leads to CAS hyperphosphorylation and the creation of binding sites for CRK and other proteins that cause actin cytoskeleton reorganization. This gene plays a role in integrin-mediated cell attachment, spreading, and migration and also plays a role in both normal and malignant cellular transformation. This broadly expressed gene has been shown to play a role in neurite outgrowth and its expression in the thymus and lymphocytes is important for T cell maturation and the development of immunological self-tolerance. Alternative splicing of this gene results in multiple transcript variants encoding distinct isoforms. [provided by RefSeq, Jul 2020].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43281","text":"Docking protein which plays a central coordinating role for tyrosine-kinase-based signaling related to cell adhesion. May serve as an activator of SRC and a downstream effector. Interacts with the SH3 domain of FYN and with CRK, SRC, and YES (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}