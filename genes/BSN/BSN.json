:0.24851,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000164061","module":"turquoise","kme":0.393215,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000164061","module":"turquoise","kme":0.187303,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000164061","module":"turquoise","kme":0.2137,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000164061","module":"brown","kme":0.213619,"hub":false,"module_direction":"higher in AD","module_padj":0.137697,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000164061","module":"turquoise","kme":0.342969,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000164061"],"dataset_symbols":["BSN"],"explorer":"explorer.html?dataset=mathys2019#gene/BSN","cell_types":[{"cell_type":"Ex","gene_symbol":"BSN","gene_symbol_current":"BSN","gene_id":"ENSG00000164061","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.23824e-05,"nucleus_log2fc":0.0784416,"nucleus_score":4.5511,"pct_ad":0.672389,"pct_control":0.68751,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.120253,"donor_lfcse":0.0789213,"donor_log2fc_shrunk":1.96103e-05},{"cell_type":"In","gene_symbol":"BSN","gene_symbol_current":"BSN","gene_id":"ENSG00000164061","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.904458,"nucleus_log2fc":0.0225078,"nucleus_score":0.371285,"pct_ad":0.33984,"pct_control":0.330532,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0278168,"donor_lfcse":0.0952376,"donor_log2fc_shrunk":5.91004e-07}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000164061","module":"yellow","kme":0.314131,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000164061","module":"red","kme":0.0893087,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164061","entrez_id":["8927"],"uniprot":["Q9UPA5"],"ncbi_summary":"Neurotransmitters are released from a specific site in the axon terminal called the active zone, which is composed of synaptic vesicles and a meshwork of cytoskeleton underlying the plasma membrane. The protein encoded by this gene is thought to be a scaffolding protein involved in organizing the presynaptic cytoskeleton. The gene is expressed primarily in neurons in the brain. A similar gene product in rodents is concentrated in the active zone of axon terminals and tightly associated with cytoskeletal structures, and is essential for regulating neurotransmitter release from a subset of synapses. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UPA5","text":"Scaffold protein of the presynaptic cytomatrix at the active zone (CAZ) which is the place in the synapse where neurotransmitter is released (PubMed:12812759). After synthesis, participates in the formation of Golgi-derived membranous organelles termed Piccolo-Bassoon transport vesicles (PTVs) that are transported along axons to sites of nascent synaptic contacts (PubMed:19380881). At the presynaptic active zone, regulates the spatial organization of synaptic vesicle cluster, the protein complexes that execute membrane fusion and compensatory endocytosis (By similarity). Also functions in processes other than assembly such as the regulation of specific presynaptic protein ubiquitination by interacting with SIAH1 or the regulation of presynaptic autophagy by associating with ATG5 (By similarity). Also mediates synapse to nucleus communication leading to reconfiguration of gene expression by associating with the transcriptional corepressor CTBP1 and by subsequently reducing the size of its pool available for nuclear import (By similarity). Inhibits the activity of the proportion of DAO enzyme that localizes to the presynaptic active zone, which may modulate synaptic transmission (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}