":0.0596634}],"modules":[{"cell_type":"CUX2-","gene_id":"ENSG00000204569","module":"turquoise","kme":0.0729262,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000204569"],"dataset_symbols":["PPP1R10"],"explorer":"explorer.html?dataset=mathys2019#gene/PPP1R10","cell_types":[{"cell_type":"Ast","gene_symbol":"PPP1R10","gene_symbol_current":"PPP1R10","gene_id":"ENSG00000204569","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.407004,"nucleus_log2fc":-0.0952771,"nucleus_score":-1.08311,"pct_ad":0.0898004,"pct_control":0.102147,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Ex","gene_symbol":"PPP1R10","gene_symbol_current":"PPP1R10","gene_id":"ENSG00000204569","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":8.99311e-06,"nucleus_log2fc":-0.168509,"nucleus_score":-4.76029,"pct_ad":0.268488,"pct_control":0.297575,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0605746,"donor_lfcse":0.072205,"donor_log2fc_shrunk":-1.21215e-05},{"cell_type":"In","gene_symbol":"PPP1R10","gene_symbol_current":"PPP1R10","gene_id":"ENSG00000204569","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.402359,"nucleus_log2fc":-0.189033,"nucleus_score":-1.7302,"pct_ad":0.167702,"pct_control":0.184874,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.136177,"donor_lfcse":0.122603,"donor_log2fc_shrunk":-1.01835e-05},{"cell_type":"Oli","gene_symbol":"PPP1R10","gene_symbol_current":"PPP1R10","gene_id":"ENSG00000204569","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.880294,"donor_log2fc":0.102948,"donor_lfcse":0.127764,"donor_log2fc_shrunk":0.00595013}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000204569","entrez_id":["5514"],"uniprot":["Q96QC0"],"ncbi_summary":"This gene encodes a protein phosphatase 1 binding protein. The encoded protein plays a role in many cellular processes including cell cycle progression, DNA repair and apoptosis by regulating the activity of protein phosphatase 1. This gene lies within the major histocompatibility complex class I region on chromosome 6, and alternatively spliced transcript variants have been observed for this gene. [provided by RefSeq, Jul 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96QC0","text":"Substrate-recognition component of the PNUTS-PP1 protein phosphatase complex, a protein phosphatase 1 (PP1) complex that promotes RNA polymerase II transcription pause-release, allowing transcription elongation (PubMed:39603239, PubMed:39603240). Promoter-proximal pausing by RNA polymerase II is a transcription halt following transcription initiation but prior to elongation, which acts as a checkpoint to control that transcripts are favorably configured for transcriptional elongation (PubMed:39603239, PubMed:39603240). The PNUTS-PP1 complex mediates the release of RNA polymerase II from promoter-proximal region of genes by catalyzing dephosphorylation of proteins involved in transcription, such as AFF4, CDK9, MEPCE, INTS12, NCBP1, POLR2M/GDOWN1 and SUPT6H (PubMed:39603239, PubMed:39603240). The PNUTS-PP1 complex also regulates RNA polymerase II transcription termination by mediating dephosphorylation of SUPT5H in termination zones downstream of poly(A) sites, thereby promoting deceleration of RNA polymerase II transcription (PubMed:31677974). PNUTS-PP1 complex is also involved in the response to replication stress by mediating dephosphorylation of POLR2A at 'Ser-5' of the CTD, promoting RNA polymerase II degradation (PubMed:33264625). The PNUTS-PP1 complex also plays a role in the control of chromatin structure and cell cycle progression during the transition from mitosis into interphase (By similarity). PNUTS-PP1 complex mediates dephosphorylation of MYC, promoting MYC stability by preventing MYC ubiquitination by the SCF(FBXW7) complex (PubMed:30158517). In addition to acts as a substrate-recognition component, PPP1R10/PNUTS also acts as a nuclear targeting subunit for the PNUTS-PP1 complex (PubMed:9450550). In some context, PPP1R10/PNUTS also acts as an inhibitor of protein phosphatase 1 (PP1) activity by preventing access to substrates, such as RB (PubMed:18360108)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}