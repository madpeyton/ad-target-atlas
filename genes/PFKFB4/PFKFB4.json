:"ENSG00000114268","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.123863,"donor_lfcse":0.151184,"donor_log2fc_shrunk":5.43636e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000114268","module":"blue","kme":0.0733455,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000114268","entrez_id":["5210"],"uniprot":["Q16877"],"ncbi_summary":"The protein encoded by this gene is one of four bifunctional kinase/phosphatases that regulate the concentration of the glycolytic byproduct fructose-2,6-bisphosphate (F2,6BP). The encoded protein is highly expressed in cancer cells and is induced by hypoxia. This protein is essential to the survival of cancer cells under conditions of hypoxia, because it increases the amount of F2,6BP and ATP at a time when the cell cannot produce much of them. This finding suggests that this protein may be a good target for disruption in cancer cells, hopefully imperiling their survival. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Nov 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q16877","text":"Synthesis and degradation of fructose 2,6-bisphosphate."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}