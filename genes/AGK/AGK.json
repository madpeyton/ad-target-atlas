j":0.0070861,"nucleus_log2fc":-0.112134,"nucleus_score":-2.97748,"pct_ad":0.241133,"pct_control":0.261521,"donor_test":"not significant","donor_padj":0.634098,"donor_log2fc":-0.125517,"donor_lfcse":0.0890119,"donor_log2fc_shrunk":-0.0309334,"degas_log2fc":-0.0121502,"degas_padj":0.835145},{"cell_type":"OPC","gene_symbol":"AGK","gene_symbol_current":"AGK","gene_id":"ENSG00000006530","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.700799,"nucleus_log2fc":0.0306246,"nucleus_score":0.578307,"pct_ad":0.34402,"pct_control":0.339712,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.00746996,"donor_lfcse":0.0665017,"donor_log2fc_shrunk":-1.73926e-06,"degas_log2fc":-0.224742,"degas_padj":2.50859e-06},{"cell_type":"Oli","gene_symbol":"AGK","gene_symbol_current":"AGK","gene_id":"ENSG00000006530","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000178694,"nucleus_log2fc":-0.0751811,"nucleus_score":-3.8959,"pct_ad":0.223837,"pct_control":0.237074,"donor_test":"not significant","donor_padj":0.94644,"donor_log2fc":-0.0264254,"donor_lfcse":0.0596459,"donor_log2fc_shrunk":-0.00644569,"degas_log2fc":-0.172415,"degas_padj":3.19762e-12}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000006530","module":"blue","kme":0.122368,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000006530","entrez_id":["55750"],"uniprot":["Q53H12"],"ncbi_summary":"The protein encoded by this gene is a mitochondrial membrane protein involved in lipid and glycerolipid metabolism. The encoded protein is a lipid kinase that catalyzes the formation of phosphatidic and lysophosphatidic acids. Defects in this gene have been associated with mitochondrial DNA depletion syndrome 10. [provided by RefSeq, Feb 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q53H12","text":"Lipid kinase that can phosphorylate both monoacylglycerol and diacylglycerol to form lysophosphatidic acid (LPA) and phosphatidic acid (PA), respectively (PubMed:15939762). Does not phosphorylate sphingosine (PubMed:15939762). Phosphorylates ceramide (By similarity). Phosphorylates 1,2-dioleoylglycerol more rapidly than 2,3-dioleoylglycerol (By similarity). Independently of its lipid kinase activity, acts as a component of the TIM22 complex (PubMed:28712724, PubMed:28712726). The TIM22 complex mediates the import and insertion of multi-pass transmembrane proteins into the mitochondrial inner membrane by forming a twin-pore translocase that uses the membrane potential as the external driving force (PubMed:28712724, PubMed:28712726). In the TIM22 complex, required for the import of a subset of metabolite carriers into mitochondria, such as ANT1/SLC25A4 and SLC25A24, while it is not required for the import of TIMM23 (PubMed:28712724). Overexpression increases the formation and secretion of LPA, resulting in transactivation of EGFR and activation of the downstream MAPK signaling pathway, leading to increased cell growth (PubMed:15939762)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}