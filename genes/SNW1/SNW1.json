t_ad":0.395931,"pct_control":0.405338,"donor_test":"not significant","donor_padj":0.694045,"donor_log2fc":0.0721801,"donor_lfcse":0.0351594,"donor_log2fc_shrunk":0.0302245,"degas_log2fc":0.16839,"degas_padj":8.90356e-52},{"cell_type":"Mic","gene_symbol":"SNW1","gene_symbol_current":"SNW1","gene_id":"ENSG00000100603","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.504699,"nucleus_log2fc":0.038379,"nucleus_score":0.826137,"pct_ad":0.283101,"pct_control":0.278456,"donor_test":"not significant","donor_padj":0.893311,"donor_log2fc":0.0337119,"donor_lfcse":0.0582326,"donor_log2fc_shrunk":0.0134351,"degas_log2fc":-0.0302082,"degas_padj":0.558799},{"cell_type":"OPC","gene_symbol":"SNW1","gene_symbol_current":"SNW1","gene_id":"ENSG00000100603","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.603401,"nucleus_log2fc":0.0311054,"nucleus_score":0.752783,"pct_ad":0.287504,"pct_control":0.280948,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0167872,"donor_lfcse":0.0592356,"donor_log2fc_shrunk":-4.97313e-06,"degas_log2fc":0.049375,"degas_padj":0.375931},{"cell_type":"Oli","gene_symbol":"SNW1","gene_symbol_current":"SNW1","gene_id":"ENSG00000100603","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.73556,"nucleus_log2fc":0.017795,"nucleus_score":0.388132,"pct_ad":0.258471,"pct_control":0.25798,"donor_test":"not significant","donor_padj":0.830837,"donor_log2fc":0.0690545,"donor_lfcse":0.0629225,"donor_log2fc_shrunk":0.0171305,"degas_log2fc":-0.0436649,"degas_padj":0.0648609}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000100603","module":"turquoise","kme":0.0748967,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000100603","module":"turquoise","kme":0.0516733,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000100603","module":"turquoise","kme":0.0948816,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100603","entrez_id":["22938"],"uniprot":["Q13573"],"ncbi_summary":"This gene, a member of the SNW gene family, encodes a coactivator that enhances transcription from some Pol II promoters. This coactivator can bind to the ligand-binding domain of the vitamin D receptor and to retinoid receptors to enhance vitamin D-, retinoic acid-, estrogen-, and glucocorticoid-mediated gene expression. It can also function as a splicing factor by interacting with poly(A)-binding protein 2 to directly control the expression of muscle-specific genes at the transcriptional level. Finally, the protein may be involved in oncogenesis since it interacts with a region of SKI oncoproteins that is required for transforming activity. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jan 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13573","text":"Involved in pre-mRNA splicing as component of the spliceosome (PubMed:11991638, PubMed:28076346, PubMed:28502770). As a component of the minor spliceosome, involved in the splicing of U12-type introns in pre-mRNAs (Probable). Required for the specific splicing of CDKN1A pre-mRNA; the function probably involves the recruitment of U2AF2 to the mRNA. May recruit PPIL1 to the spliceosome. May be involved in cyclin-D1/CCND1 mRNA stability through the SNARP complex which associates with both the 3'end of the CCND1 gene and its mRNA. Involved in transcriptional regulation. Modulates TGF-beta-mediated transcription via association with SMAD proteins, MYOD1-mediated transcription via association with PABPN1, RB1-mediated transcriptional repression, and retinoid-X receptor (RXR)- and vitamin D receptor (VDR)-dependent gene transcription in a cell line-specific manner probably involving coactivators NCOA1 and GRIP1. Is involved in NOTCH1-mediated transcriptional activation. Binds to multimerized forms of Notch intracellular domain (NICD) and is proposed to recruit transcriptional coactivators such as MAML1 to form an intermediate preactivation complex which associates with DNA-bound CBF-1/RBPJ to form a transcriptional activation complex by releasing SNW1 and redundant NOTCH1 NICD. (Microbial infection) Is recruited by HIV-1 Tat to Tat:P-TEFb:TAR RNA complexes and is involved in Tat transcription by recruitment of MYC, MEN1 and TRRAP to the HIV promoter. (Microbial infection) Proposed to be involved in transcriptional activation by EBV EBNA2 of CBF-1/RBPJ-repressed promoters."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}