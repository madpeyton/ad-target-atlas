eus_log2fc":0.0904852,"nucleus_score":1.22258,"pct_ad":0.169033,"pct_control":0.155307,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.106085,"donor_lfcse":0.146757,"donor_log2fc_shrunk":5.07294e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000129355","module":"yellow","kme":0.312978,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000129355","module":"turquoise","kme":0.166078,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000129355","entrez_id":["1032"],"uniprot":["P55273"],"ncbi_summary":"The protein encoded by this gene is a member of the INK4 family of cyclin-dependent kinase inhibitors. This protein has been shown to form a stable complex with CDK4 or CDK6, and prevent the activation of the CDK kinases, thus function as a cell growth regulator that controls cell cycle G1 progression. The abundance of the transcript of this gene was found to oscillate in a cell-cycle dependent manner with the lowest expression at mid G1 and a maximal expression during S phase. The negative regulation of the cell cycle involved in this protein was shown to participate in repressing neuronal proliferation, as well as spermatogenesis. Two alternatively spliced variants of this gene, which encode an identical protein, have been reported. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P55273","text":"Interacts strongly with CDK4 and CDK6 and inhibits them."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}