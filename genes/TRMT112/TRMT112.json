32,"nucleus_score":-2.4076,"pct_ad":0.204525,"pct_control":0.226891,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.235986,"donor_lfcse":0.178943,"donor_log2fc_shrunk":-7.76946e-06},{"cell_type":"Oli","gene_symbol":"TRMT112","gene_symbol_current":"TRMT112","gene_id":"ENSG00000173113","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.90387,"donor_log2fc":0.147667,"donor_lfcse":0.210132,"donor_log2fc_shrunk":0.00320556}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000173113","module":"turquoise","kme":0.396897,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000173113","module":"turquoise","kme":0.299906,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000173113","module":"turquoise","kme":0.135714,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000173113","module":"turquoise","kme":0.170735,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000173113","entrez_id":["51504"],"uniprot":["Q9UI30"],"ncbi_summary":"Enables protein heterodimerization activity and protein methyltransferase activity. Involved in macromolecule methylation and positive regulation of rRNA processing. Located in nucleoplasm and perinuclear region of cytoplasm. Part of protein-containing complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UI30","text":"Acts as an activator of both rRNA/tRNA and protein methyltransferases (PubMed:18539146, PubMed:20308323, PubMed:25851604, PubMed:31061526, PubMed:31328227, PubMed:31636962, PubMed:37283053). Together with methyltransferase BUD23, methylates the N(7) position of a guanine in 18S rRNA (PubMed:25851604). The heterodimer with N6AMT1/HEMK2 catalyzes N5-methylation of ETF1 on 'Gln-185', using S-adenosyl L-methionine as methyl donor (PubMed:18539146, PubMed:31061526, PubMed:31636962). The heterodimer with N6AMT1/HEMK2 also monomethylates 'Lys-12' of histone H4 (H4K12me1) (PubMed:31061526). The heterodimer with ALKBH8 catalyzes the methylation of 5-carboxymethyl uridine to 5-methylcarboxymethyl uridine at the wobble position of the anticodon loop in target tRNA species (PubMed:20308323). Together with methyltransferase THUMPD3, catalyzes the formation of N(2)-methylguanosine at position 6 in a broad range of tRNA substrates and at position 7 of tRNA(Trp) (PubMed:34669960, PubMed:37283053). Involved in the pre-rRNA processing steps leading to small-subunit rRNA production (PubMed:25851604). Together with methyltransferase METTL5, specifically methylates the 6th position of adenine in position 1832 of 18S rRNA (PubMed:31328227, PubMed:33428944, PubMed:35033535, PubMed:37283053)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}