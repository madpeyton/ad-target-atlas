_shrunk":1.30873e-06},{"cell_type":"Oli","gene_symbol":"CAMLG","gene_symbol_current":"CAMLG","gene_id":"ENSG00000164615","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.9355,"donor_log2fc":0.106951,"donor_lfcse":0.196859,"donor_log2fc_shrunk":0.00263549}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000164615","module":"brown","kme":0.127553,"hub":false,"module_direction":"lower in AD","module_padj":0.652213,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000164615","module":"turquoise","kme":0.377226,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000164615","module":"turquoise","kme":0.332161,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000164615","module":"turquoise","kme":0.138659,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000164615","entrez_id":["819"],"uniprot":["P49069"],"ncbi_summary":"The immunosuppressant drug cyclosporin A blocks a calcium-dependent signal from the T-cell receptor (TCR) that normally leads to T-cell activation. When bound to cyclophilin B, cyclosporin A binds and inactivates the key signaling intermediate calcineurin. The protein encoded by this gene functions similarly to cyclosporin A, binding to cyclophilin B and acting downstream of the TCR and upstream of calcineurin by causing an influx of calcium. This integral membrane protein appears to be a new participant in the calcium signal transduction pathway, implicating cyclophilin B in calcium signaling, even in the absence of cyclosporin. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49069","text":"Required for the post-translational delivery of tail-anchored (TA) proteins to the endoplasmic reticulum (PubMed:23041287, PubMed:24392163, PubMed:27226539). Together with GET1/WRB, acts as a membrane receptor for soluble GET3/TRC40, which recognizes and selectively binds the transmembrane domain of TA proteins in the cytosol (PubMed:23041287, PubMed:24392163, PubMed:27226539). Required for the stability of GET1 (PubMed:32187542). Stimulates calcium signaling in T cells through its involvement in elevation of intracellular calcium (PubMed:7522304). Essential for the survival of peripheral follicular B cells (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}