nucleus_log2fc":-0.160484,"nucleus_score":-1.02972,"pct_ad":0.117569,"pct_control":0.12605,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.126476,"donor_lfcse":0.185486,"donor_log2fc_shrunk":-3.85005e-06},{"cell_type":"Oli","gene_symbol":"SLC9A8","gene_symbol_current":"SLC9A8","gene_id":"ENSG00000197818","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.976203,"donor_log2fc":0.0248168,"donor_lfcse":0.163517,"donor_log2fc_shrunk":0.000885637}],"modules":[{"cell_type":"In","gene_id":"ENSG00000197818","module":"yellow","kme":0.159288,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000197818","entrez_id":["23315"],"uniprot":["Q9Y2E8"],"ncbi_summary":"Sodium-hydrogen exchangers (NHEs), such as SLC9A8, are integral transmembrane proteins that exchange extracellular Na+ for intracellular H+. NHEs have multiple functions, including intracellular pH homeostasis, cell volume regulation, and electroneutral NaCl absorption in epithelia (Xu et al., 2008 [PubMed 18209477]).[supplied by OMIM, Apr 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y2E8","text":"Na(+)/H(+) antiporter. Mediates the electoneutral exchange of intracellular H(+) ions for extracellular Na(+) in 1:1 stoichiometry (PubMed:15522866). Acts as an Na(+)/H(+) exchanger in the trans-Golgi. Contributes to the regulation of pH regulation of Golgi apparatus, and consequently, in protein trafficking and endosomal morphology (PubMed:15522866, PubMed:20719963). In germ cells, plays a crucial role in acrosome biogenesis and sperm development, probably by playing a role in the fusion of the Golgi-derived vesicles that form the acrosomal cap (By similarity). Can also be active at the cell surface of specialized cells. In the small intestine, at the cell membrane, plays a major physiological role in transepithelial absorption of Na(+) and regulates intracellular pH homeostasis of intestinal epithelial cells (PubMed:34288721). Acts as an important regulator of mucosal integrity in the intestine and in the stomach, could mediate the pH fluctuation necessary for mucin exocytosis or assist membrane trafficking of other proteins (By similarity). Plays a role in photoreceptor survival and in the maintenance of intracellular pH homeostasis in retinal pigment epithelium (RPE cells) (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}