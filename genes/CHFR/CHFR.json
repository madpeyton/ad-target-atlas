nucleus_direction":"higher in AD","nucleus_padj":0.648947,"nucleus_log2fc":0.0152984,"nucleus_score":0.583521,"pct_ad":0.483473,"pct_control":0.478456,"donor_test":"not significant","donor_padj":0.90331,"donor_log2fc":-0.0346509,"donor_lfcse":0.0633052,"donor_log2fc_shrunk":-0.0125005,"degas_log2fc":-0.021111,"degas_padj":0.589287},{"cell_type":"OPC","gene_symbol":"CHFR","gene_symbol_current":"CHFR","gene_id":"ENSG00000072609","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.219777,"nucleus_log2fc":-0.0753184,"nucleus_score":-1.60899,"pct_ad":0.389204,"pct_control":0.400847,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0532382,"donor_lfcse":0.064522,"donor_log2fc_shrunk":-1.33188e-05,"degas_log2fc":-0.113958,"degas_padj":0.0106889},{"cell_type":"Oli","gene_symbol":"CHFR","gene_symbol_current":"CHFR","gene_id":"ENSG00000072609","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00690622,"nucleus_log2fc":-0.0436096,"nucleus_score":-2.83871,"pct_ad":0.355527,"pct_control":0.366978,"donor_test":"not significant","donor_padj":0.968093,"donor_log2fc":-0.0201314,"donor_lfcse":0.0644647,"donor_log2fc_shrunk":-0.00399953,"degas_log2fc":-0.0980812,"degas_padj":5.04063e-07}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000072609","module":"blue","kme":0.0931469,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000072609","entrez_id":["55743"],"uniprot":["Q96EP1"],"ncbi_summary":"This gene encodes an E3 ubiquitin-protein ligase required for the maintenance of the antephase checkpoint that regulates cell cycle entry into mitosis and, therefore, may play a key role in cell cycle progression and tumorigenesis. The encoded protein has an N-terminal forkhead-associated domain, a central RING-finger domain, and a cysteine-rich C-terminal region. Alternatively spliced transcript variants that encode different protein isoforms have been described. [provided by RefSeq, Mar 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96EP1","text":"E3 ubiquitin-protein ligase that functions in the antephase checkpoint by actively delaying passage into mitosis in response to microtubule poisons. Acts in early prophase before chromosome condensation, when the centrosome move apart from each other along the periphery of the nucleus. Probably involved in signaling the presence of mitotic stress caused by microtubule poisons by mediating the 'Lys-48'-linked ubiquitination of target proteins, leading to their degradation by the proteasome. Promotes the ubiquitination and subsequent degradation of AURKA and PLK1. Probably acts as a tumor suppressor, possibly by mediating the polyubiquitination of HDAC1, leading to its degradation. May also promote the formation of 'Lys-63'-linked polyubiquitin chains and functions with the specific ubiquitin-conjugating UBC13-MMS2 (UBE2N-UBE2V2) heterodimer. Substrates that are polyubiquitinated at 'Lys-63' are usually not targeted for degradation, but are rather involved in signaling cellular stress."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}