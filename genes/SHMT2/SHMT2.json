pct_control":null,"donor_test":"not significant","donor_padj":0.845995,"donor_log2fc":0.194075,"donor_lfcse":0.256331,"donor_log2fc_shrunk":0.00609568,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"SHMT2","gene_symbol_current":"SHMT2","gene_id":"ENSG00000182199","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0938711,"donor_lfcse":0.17735,"donor_log2fc_shrunk":3.17207e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"SHMT2","gene_symbol_current":"SHMT2","gene_id":"ENSG00000182199","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.855786,"donor_log2fc":0.175277,"donor_lfcse":0.176166,"donor_log2fc_shrunk":0.0061029,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000182199","entrez_id":["6472"],"uniprot":["P34897"],"ncbi_summary":"This gene encodes the mitochondrial form of a pyridoxal phosphate-dependent enzyme that catalyzes the reversible reaction of serine and tetrahydrofolate to glycine and 5,10-methylene tetrahydrofolate. The encoded product is primarily responsible for glycine synthesis. The activity of the encoded protein has been suggested to be the primary source of intracellular glycine. The gene which encodes the cytosolic form of this enzyme is located on chromosome 17. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Oct 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P34897","text":"Catalyzes the cleavage of serine to glycine accompanied with the production of 5,10-methylenetetrahydrofolate, an essential intermediate for purine biosynthesis (PubMed:24075985, PubMed:25619277, PubMed:29364879, PubMed:33015733). Serine provides the major source of folate one-carbon in cells by catalyzing the transfer of one carbon from serine to tetrahydrofolate (PubMed:25619277). Contributes to the de novo mitochondrial thymidylate biosynthesis pathway via its role in glycine and tetrahydrofolate metabolism: thymidylate biosynthesis is required to prevent uracil accumulation in mtDNA (PubMed:21876188). Also required for mitochondrial translation by producing 5,10-methylenetetrahydrofolate; 5,10-methylenetetrahydrofolate providing methyl donors to produce the taurinomethyluridine base at the wobble position of some mitochondrial tRNAs (PubMed:29364879, PubMed:29452640). Associates with mitochondrial DNA (PubMed:18063578). In addition to its role in mitochondria, also plays a role in the deubiquitination of target proteins as component of the BRISC complex: required for IFNAR1 deubiquitination by the BRISC complex (PubMed:24075985)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}