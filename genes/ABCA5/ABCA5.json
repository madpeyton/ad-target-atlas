icant","donor_padj":0.194747,"donor_log2fc":-0.257093,"donor_lfcse":0.0713546,"donor_log2fc_shrunk":-0.210804,"degas_log2fc":-0.199306,"degas_padj":1.66878e-26}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000154265","module":"blue","kme":0.115966,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000154265","module":"turquoise","kme":0.153725,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000154265","module":"yellow","kme":0.071186,"hub":false,"module_direction":"higher in AD","module_padj":0.663532,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000154265","entrez_id":["23461"],"uniprot":["Q8WWZ7"],"ncbi_summary":"The membrane-associated protein encoded by this gene is a member of the superfamily of ATP-binding cassette (ABC) transporters. ABC proteins transport various molecules across extra- and intracellular membranes. ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, and White). This encoded protein is a member of the ABC1 subfamily. Members of the ABC1 subfamily comprise the only major ABC subfamily found exclusively in multicellular eukaryotes. This gene is clustered among 4 other ABC1 family members on 17q24, but neither the substrate nor the function of this gene is known. Alternative splicing of this gene results in several transcript variants; however, not all variants have been fully described. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8WWZ7","text":"Cholesterol efflux transporter in macrophages that is responsible for APOAI/high-density lipoproteins (HDL) formation at the plasma membrane under high cholesterol levels and participates in reverse cholesterol transport (PubMed:25125465). May play a role in the processing of autolysosomes (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}