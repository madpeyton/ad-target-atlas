odule_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000050438","module":"turquoise","kme":0.0642935,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000050438","module":"yellow","kme":0.260713,"hub":false,"module_direction":"lower in AD","module_padj":0.0240838,"module_significant":true}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000050438","entrez_id":["9498"],"uniprot":["Q2Y0W8"],"ncbi_summary":"The protein encoded by this gene is a membrane protein that functions to transport sodium and bicarbonate ions across the cell membrane. The encoded protein is important for pH regulation in neurons. The activity of this protein can be inhibited by 4,4'-Di-isothiocyanatostilbene-2,2'-disulfonic acid (DIDS). Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Apr 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q2Y0W8","text":"Mediates electroneutral sodium- and carbonate-dependent chloride-HCO3(-) exchange with a Na(+):HCO3(-) stoichiometry of 2:1 (PubMed:18577713). Plays a major role in pH regulation in neurons (By similarity). Mediates sodium reabsorption in the renal cortical collecting ducts (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}