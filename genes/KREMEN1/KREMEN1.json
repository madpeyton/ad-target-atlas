ed","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.776007,"donor_log2fc":0.201093,"donor_lfcse":0.150679,"donor_log2fc_shrunk":0.00986104,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000183762","module":"brown","kme":0.287985,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000183762","module":"blue","kme":0.132594,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000183762","entrez_id":["83999"],"uniprot":["Q96MU8"],"ncbi_summary":"This gene encodes a high-affinity dickkopf homolog 1 (DKK1) transmembrane receptor that functionally cooperates with DKK1 to block wingless (WNT)/beta-catenin signaling. The encoded protein is a component of a membrane complex that modulates canonical WNT signaling through lipoprotein receptor-related protein 6 (LRP6). It contains extracellular kringle, WSC, and CUB domains. Mutations in this gene result in ectodermal dysplasia. This protein has also been found to be a functional receptor for Coxsackievirus A10 and may be an alternative entry receptor for SARS-CoV-2. [provided by RefSeq, Nov 2021].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96MU8","text":"Receptor for Dickkopf proteins. Cooperates with DKK1/2 to inhibit Wnt/beta-catenin signaling by promoting the endocytosis of Wnt receptors LRP5 and LRP6. In the absence of DKK1, potentiates Wnt-beta-catenin signaling by maintaining LRP5 or LRP6 at the cell membrane. Can trigger apoptosis in a Wnt-independent manner and this apoptotic activity is inhibited upon binding of the ligand DKK1. Plays a role in limb development; attenuates Wnt signaling in the developing limb to allow normal limb patterning and can also negatively regulate bone formation. Modulates cell fate decisions in the developing cochlea with an inhibitory role in hair cell fate specification."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}