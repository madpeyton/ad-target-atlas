irection":"higher in AD","nucleus_padj":0.0992566,"nucleus_log2fc":0.0828049,"nucleus_score":2.08113,"pct_ad":0.569937,"pct_control":0.559356,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0876753,"donor_lfcse":0.138408,"donor_log2fc_shrunk":4.77986e-06},{"cell_type":"Oli","gene_symbol":"PRKAG2","gene_symbol_current":"PRKAG2","gene_id":"ENSG00000106617","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.61982e-05,"nucleus_log2fc":-0.12157,"nucleus_score":-4.2824,"pct_ad":0.136399,"pct_control":0.147662,"donor_test":"not significant","donor_padj":0.952773,"donor_log2fc":-0.0728218,"donor_lfcse":0.179145,"donor_log2fc_shrunk":-0.00246284}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000106617","module":"brown","kme":0.2053,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000106617","module":"green","kme":0.351577,"hub":false,"module_direction":"higher in AD","module_padj":0.232138,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000106617","module":"greenyellow","kme":0.310494,"hub":false,"module_direction":"higher in AD","module_padj":0.778135,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000106617","module":"yellow","kme":0.218351,"hub":false,"module_direction":"higher in AD","module_padj":0.663532,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000106617","module":"brown","kme":0.160086,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000106617","entrez_id":["51422"],"uniprot":["Q9UGJ0"],"ncbi_summary":"AMP-activated protein kinase (AMPK) is a heterotrimeric protein composed of a catalytic alpha subunit, a noncatalytic beta subunit, and a noncatalytic regulatory gamma subunit. Various forms of each of these subunits exist, encoded by different genes. AMPK is an important energy-sensing enzyme that monitors cellular energy status and functions by inactivating key enzymes involved in regulating de novo biosynthesis of fatty acid and cholesterol. This gene is a member of the AMPK gamma subunit family. Mutations in this gene have been associated with Wolff-Parkinson-White syndrome, familial hypertrophic cardiomyopathy, and glycogen storage disease of the heart. Alternate transcriptional splice variants, encoding different isoforms, have been characterized. [provided by RefSeq, Jan 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UGJ0","text":"AMP/ATP-binding subunit of AMP-activated protein kinase (AMPK), an energy sensor protein kinase that plays a key role in regulating cellular energy metabolism (PubMed:14722619, PubMed:24563466). In response to reduction of intracellular ATP levels, AMPK activates energy-producing pathways and inhibits energy-consuming processes: inhibits protein, carbohydrate and lipid biosynthesis, as well as cell growth and proliferation (PubMed:14722619, PubMed:24563466). AMPK acts via direct phosphorylation of metabolic enzymes, and by longer-term effects via phosphorylation of transcription regulators (PubMed:14722619, PubMed:24563466). Also acts as a regulator of cellular polarity by remodeling the actin cytoskeleton; probably by indirectly activating myosin (PubMed:14722619, PubMed:24563466). Gamma non-catalytic subunit mediates binding to AMP, ADP and ATP, leading to activate or inhibit AMPK: AMP-binding results in allosteric activation of alpha catalytic subunit (PRKAA1 or PRKAA2) both by inducing phosphorylation and preventing dephosphorylation of catalytic subunits (PubMed:14722619, PubMed:24563466). ADP also stimulates phosphorylation, without stimulating already phosphorylated catalytic subunit (PubMed:14722619, PubMed:24563466). ATP promotes dephosphorylation of catalytic subunit, rendering the AMPK enzyme inactive (PubMed:14722619, PubMed:24563466)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}