0.160369,"donor_test":"not significant","donor_padj":0.783933,"donor_log2fc":-0.145892,"donor_lfcse":0.153355,"donor_log2fc_shrunk":-0.012676,"degas_log2fc":-0.310117,"degas_padj":1.2812e-07},{"cell_type":"OPC","gene_symbol":"RBL1","gene_symbol_current":"RBL1","gene_id":"ENSG00000080839","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.936934,"nucleus_log2fc":0.0131877,"nucleus_score":0.126916,"pct_ad":0.260066,"pct_control":0.25961,"donor_test":"not significant","donor_padj":0.999412,"donor_log2fc":-0.00028108,"donor_lfcse":0.0847607,"donor_log2fc_shrunk":4.13378e-07,"degas_log2fc":-0.366187,"degas_padj":3.12272e-11},{"cell_type":"Oli","gene_symbol":"RBL1","gene_symbol_current":"RBL1","gene_id":"ENSG00000080839","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.19105e-06,"nucleus_log2fc":0.146066,"nucleus_score":5.01344,"pct_ad":0.179815,"pct_control":0.165983,"donor_test":"not significant","donor_padj":0.784832,"donor_log2fc":0.120737,"donor_lfcse":0.0927509,"donor_log2fc_shrunk":0.0137903,"degas_log2fc":-0.192016,"degas_padj":2.3872e-11}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000080839","module":"yellow","kme":0.148776,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000080839","module":"magenta","kme":0.312374,"hub":false,"module_direction":"higher in AD","module_padj":0.939268,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000080839","entrez_id":["5933"],"uniprot":["P28749"],"ncbi_summary":"The protein encoded by this gene is similar in sequence and possibly function to the product of the retinoblastoma 1 (RB1) gene. The RB1 gene product is a tumor suppressor protein that appears to be involved in cell cycle regulation, as it is phosphorylated in the S to M phase transition and is dephosphorylated in the G1 phase of the cell cycle. Both the RB1 protein and the product of this gene can form a complex with adenovirus E1A protein and SV40 large T-antigen, with the SV40 large T-antigen binding only to the unphosphorylated form of each protein. In addition, both proteins can inhibit the transcription of cell cycle genes containing E2F binding sites in their promoters. Due to the sequence and biochemical similarities with the RB1 protein, it is thought that the protein encoded by this gene may also be a tumor suppressor. Two transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P28749","text":"Key regulator of entry into cell division (PubMed:17671431). Directly involved in heterochromatin formation by maintaining overall chromatin structure and, in particular, that of constitutive heterochromatin by stabilizing histone methylation (By similarity). Recruits and targets histone methyltransferases KMT5B and KMT5C, leading to epigenetic transcriptional repression (By similarity). Controls histone H4 'Lys-20' trimethylation (By similarity). Probably acts as a transcription repressor by recruiting chromatin-modifying enzymes to promoters (By similarity). Potent inhibitor of E2F-mediated trans-activation (PubMed:8319904). May act as a tumor suppressor (PubMed:8319904)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}