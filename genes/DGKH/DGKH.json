[{"cell_type":"Mic","gene_id":"ENSG00000102780","module":"black","kme":0.175104,"hub":false,"module_direction":"higher in AD","module_padj":0.169392,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000102780","module":"blue","kme":0.197366,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000102780","module":"blue","kme":0.0359972,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000102780","entrez_id":["160851"],"uniprot":["Q86XP1"],"ncbi_summary":"This gene encodes a member of the diacylglycerol kinase (DGK) enzyme family. Members of this family are involved in regulating intracellular concentrations of diacylglycerol and phosphatidic acid. Variation in this gene has been associated with bipolar disorder. Alternatively spliced transcript variants have been identified. [provided by RefSeq, Jul 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86XP1","text":"Diacylglycerol kinase that converts diacylglycerol/DAG into phosphatidic acid/phosphatidate/PA and regulates the respective levels of these two bioactive lipids (PubMed:12810723, PubMed:23949095). Thereby, acts as a central switch between the signaling pathways activated by these second messengers with different cellular targets and opposite effects in numerous biological processes (Probable) (PubMed:12810723, PubMed:23949095). Plays a key role in promoting cell growth (PubMed:19710016). Activates the Ras/B-Raf/C-Raf/MEK/ERK signaling pathway induced by EGF (PubMed:19710016). Regulates the recruitment of RAF1 and BRAF from cytoplasm to membranes and their heterodimerization (PubMed:19710016)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}