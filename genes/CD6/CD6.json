e/CD6","cell_types":[{"cell_type":"Ex","gene_symbol":"CD6","gene_symbol_current":"CD6","gene_id":"ENSG00000013725","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.992357,"donor_log2fc":0.0741327,"donor_lfcse":0.230979,"donor_log2fc_shrunk":1.46117e-06,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false},"seaad_pfc":{"dataset_label":"SEA-AD (Gabitto et al. 2024)","gene_ids":["ENSG00000013725"],"dataset_symbols":["CD6"],"explorer":"explorer.html?dataset=seaad_pfc#gene/CD6","cell_types":[{"cell_type":"Ast","gene_symbol":"CD6","gene_symbol_current":"CD6","gene_id":"ENSG00000013725","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.996928,"donor_log2fc":-0.00796103,"donor_lfcse":0.327735,"donor_log2fc_shrunk":-4.14672e-05,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Ex","gene_symbol":"CD6","gene_symbol_current":"CD6","gene_id":"ENSG00000013725","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.568157,"donor_log2fc":-0.497908,"donor_lfcse":0.224795,"donor_log2fc_shrunk":-0.00954715,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"CD6","gene_symbol_current":"CD6","gene_id":"ENSG00000013725","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.664928,"donor_log2fc":-0.463459,"donor_lfcse":0.18925,"donor_log2fc_shrunk":-0.00648875,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000013725","entrez_id":["923"],"uniprot":["P30203"],"ncbi_summary":"This gene encodes a protein found on the outer membrane of T-lymphocytes as well as some other immune cells. The encoded protein contains three scavenger receptor cysteine-rich (SRCR) domains and a binding site for an activated leukocyte cell adhesion molecule. The gene product is important for continuation of T cell activation. This gene may be associated with susceptibility to multiple sclerosis (PMID: 19525953, 21849685). Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Dec 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P30203","text":"Cell adhesion molecule that mediates cell-cell contacts and regulates T-cell responses via its interaction with ALCAM/CD166 (PubMed:15048703, PubMed:15294938, PubMed:16352806, PubMed:16914752, PubMed:24584089, PubMed:24945728). Contributes to signaling cascades triggered by activation of the TCR/CD3 complex (PubMed:24584089). Functions as a costimulatory molecule; promotes T-cell activation and proliferation (PubMed:15294938, PubMed:16352806, PubMed:16914752). Contributes to the formation and maturation of the immunological synapse (PubMed:15294938, PubMed:16352806). Functions as a calcium-dependent pattern receptor that binds and aggregates both Gram-positive and Gram-negative bacteria. Binds both lipopolysaccharide (LPS) from Gram-negative bacteria and lipoteichoic acid from Gram-positive bacteria (PubMed:17601777). LPS binding leads to the activation of signaling cascades and down-stream MAP kinases (PubMed:17601777). Mediates activation of the inflammatory response and the secretion of pro-inflammatory cytokines in response to LPS (PubMed:17601777)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}