or_padj":0.940074,"donor_log2fc":0.0592433,"donor_lfcse":0.12175,"donor_log2fc_shrunk":0.00388136}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000143702","module":"brown","kme":0.14374,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000143702","module":"green","kme":0.157956,"hub":false,"module_direction":"higher in AD","module_padj":0.232138,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000143702","module":"blue","kme":0.298505,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000143702","module":"blue","kme":0.27172,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000143702","entrez_id":["9859"],"uniprot":["Q5SW79"],"ncbi_summary":"The product of this gene is a component of the centrosome, a non-membraneous organelle that functions as the major microtubule-organizing center in animal cells. During interphase, the encoded protein localizes to the sub-distal appendages of mature centrioles, which are microtubule-based structures thought to help organize centrosomes. During mitosis, the protein associates with spindle microtubules near the centrosomes. The protein interacts with and is phosphorylated by polo-like kinase 1, and functions in maintaining microtubule organization and cell morphology. The human genome contains a putative transcribed pseudogene. Several alternatively spliced transcript variants of this gene have been found, but the full-length nature of some of these variants has not been determined. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5SW79","text":"Plays a role in microtubule organization (PubMed:15616186). Required for centriole subdistal appendage assembly (PubMed:28422092)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}