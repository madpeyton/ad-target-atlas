e","kme":0.193795,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000165675","module":"yellow","kme":0.207354,"hub":false,"module_direction":"higher in AD","module_padj":0.663532,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000165675","module":"blue","kme":0.148079,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165675","entrez_id":["10495"],"uniprot":["Q16206"],"ncbi_summary":"This gene is a tumor-specific member of the ECTO-NOX family of genes that encode cell surface NADH oxidases. The encoded protein has two enzymatic activities: catalysis of hydroquinone or NADH oxidation, and protein disulfide interchange. The protein also displays prion-like properties. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q16206","text":"May be involved in cell growth. Probably acts as a terminal oxidase of plasma electron transport from cytosolic NAD(P)H via hydroquinones to acceptors at the cell surface. Hydroquinone oxidase activity alternates with a protein disulfide-thiol interchange/oxidoreductase activity which may control physical membrane displacements associated with vesicle budding or cell enlargement. The activities oscillate with a period length of 22 minutes and play a role in control of the ultradian cellular biological clock."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}