id":"ENSG00000136536","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.548797,"nucleus_log2fc":0.288658,"nucleus_score":1.17467,"pct_ad":0.136531,"pct_control":0.118602,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"MARCH7","gene_symbol_current":"MARCHF7","gene_id":"ENSG00000136536","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.817411,"nucleus_log2fc":0.12987,"nucleus_score":0.522625,"pct_ad":0.16876,"pct_control":0.164751,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"MARCH7","gene_symbol_current":"MARCHF7","gene_id":"ENSG00000136536","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.811387,"donor_log2fc":0.107328,"donor_lfcse":0.0914305,"donor_log2fc_shrunk":0.0119896}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000136536","module":"blue","kme":0.138552,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000136536","module":"grey60","kme":0.155622,"hub":false,"module_direction":"lower in AD","module_padj":0.817457,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136536","entrez_id":["64844"],"uniprot":["Q9H992"],"ncbi_summary":"MARCH7 is a member of the MARCH family of membrane-bound E3 ubiquitin ligases (EC 6.3.2.19). MARCH proteins add ubiquitin (see MIM 191339) to target lysines in substrate proteins, thereby signaling their vesicular transport between membrane compartments (Bartee et al., 2004 [PubMed 14722266]).[supplied by OMIM, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H992","text":"E3 ubiquitin-protein ligase which may specifically enhance the E2 activity of HIP2. E3 ubiquitin ligases accept ubiquitin from an E2 ubiquitin-conjugating enzyme in the form of a thioester and then directly transfer the ubiquitin to targeted substrates (PubMed:16868077). May be involved in T-cell proliferation by regulating LIF secretion (By similarity). May play a role in lysosome homeostasis (PubMed:31270356). Promotes 'Lys-6', 'Lys-11' and 'Lys-63'-linked mixed polyubiquitination on ATG14 leading to the inhibition of autophagy by impairing the interaction between ATG14 and STX7 (PubMed:37632749). Participates in the dopamine-mediated negative regulation of the NLRP3 inflammasome by promoting its ubiquitination and subsequent degradation (PubMed:25594175)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}