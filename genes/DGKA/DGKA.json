100},{"cell_type":"In","gene_symbol":"DGKA","gene_symbol_current":"DGKA","gene_id":"ENSG00000065357","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.44485e-26,"nucleus_log2fc":-0.152771,"nucleus_score":-10.7816,"pct_ad":0.240501,"pct_control":0.262077,"donor_test":"not significant","donor_padj":0.817817,"donor_log2fc":-0.0490783,"donor_lfcse":0.0563191,"donor_log2fc_shrunk":-0.0065622,"degas_log2fc":0.149604,"degas_padj":1.98292e-23},{"cell_type":"Mic","gene_symbol":"DGKA","gene_symbol_current":"DGKA","gene_id":"ENSG00000065357","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.476907,"nucleus_log2fc":-0.0386613,"nucleus_score":-0.877775,"pct_ad":0.209935,"pct_control":0.215092,"donor_test":"not significant","donor_padj":0.9828,"donor_log2fc":0.0121631,"donor_lfcse":0.0945198,"donor_log2fc_shrunk":0.00238266,"degas_log2fc":0.014293,"degas_padj":0.820701},{"cell_type":"OPC","gene_symbol":"DGKA","gene_symbol_current":"DGKA","gene_id":"ENSG00000065357","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.178139,"nucleus_log2fc":-0.128025,"nucleus_score":-1.74334,"pct_ad":0.201461,"pct_control":0.21287,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.110085,"donor_lfcse":0.0913968,"donor_log2fc_shrunk":-1.37104e-05,"degas_log2fc":0.0984436,"degas_padj":0.129874},{"cell_type":"Oli","gene_symbol":"DGKA","gene_symbol_current":"DGKA","gene_id":"ENSG00000065357","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.721333,"donor_log2fc":0.151502,"donor_lfcse":0.099027,"donor_log2fc_shrunk":0.0173864,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000065357","module":"blue","kme":0.312994,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000065357","module":"turquoise","kme":0.0164663,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000065357","entrez_id":["1606"],"uniprot":["P23743"],"ncbi_summary":"The protein encoded by this gene belongs to the eukaryotic diacylglycerol kinase family. It acts as a modulator that competes with protein kinase C for the second messenger diacylglycerol in intracellular signaling pathways. It also plays an important role in the resynthesis of phosphatidylinositols and phosphorylating diacylglycerol to phosphatidic acid. Several transcript variants encoding different isoforms have been identified for this gene. [provided by RefSeq, Apr 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P23743","text":"Diacylglycerol kinase that converts diacylglycerol/DAG into phosphatidic acid/phosphatidate/PA and regulates the respective levels of these two bioactive lipids (PubMed:15544348, PubMed:2175712). Thereby, acts as a central switch between the signaling pathways activated by these second messengers with different cellular targets and opposite effects in numerous biological processes (PubMed:15544348, PubMed:2175712). Also plays an important role in the biosynthesis of complex lipids (Probable). Can also phosphorylate 1-alkyl-2-acylglycerol in vitro as efficiently as diacylglycerol provided it contains an arachidonoyl group (PubMed:15544348). Also involved in the production of alkyl-lysophosphatidic acid, another bioactive lipid, through the phosphorylation of 1-alkyl-2-acetyl glycerol (PubMed:22627129)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}