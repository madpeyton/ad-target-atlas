ll_type":"Ast","gene_id":"ENSG00000155897","module":"brown","kme":0.324719,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000155897","module":"black","kme":0.438739,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000155897","module":"magenta","kme":0.585338,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000155897","module":"turquoise","kme":0.121776,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000155897","module":"brown","kme":0.100637,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000155897","entrez_id":["114"],"uniprot":["P40145"],"ncbi_summary":"Adenylate cyclase is a membrane bound enzyme that catalyses the formation of cyclic AMP from ATP. The enzymatic activity is under the control of several hormones, and different polypeptides participate in the transduction of the signal from the receptor to the catalytic moiety. Stimulatory or inhibitory receptors (Rs and Ri) interact with G proteins (Gs and Gi) that exhibit GTPase activity and they modulate the activity of the catalytic subunit of the adenylyl cyclase [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P40145","text":"Catalyzes the formation of cAMP in response to calcium entry leadings to cAMP signaling activation that affect processes suche as synaptic plasticity and insulin secretion. Plays a role in many brain functions, such as learning, memory, drug addiction, and anxiety modulation through regulation of synaptic plasticity by modulating long-term memory and long-term potentiation (LTP) through CREB transcription factor activity modulation. Plays a central role in insulin secretion by controlling glucose homeostasis through glucagon-like peptide 1 and glucose signaling pathway and maintains insulin secretion through calcium-dependent PKA activation leading to vesicle pool replenishment. Also, allows PTGER3 to induce potentiation of PTGER4-mediated PLA2 secretion by switching from a negative to a positive regulation, during the IL1B induced-dedifferentiation of smooth muscle cells."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}