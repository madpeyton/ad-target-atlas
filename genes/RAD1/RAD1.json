30522,"donor_log2fc_shrunk":0.0037785},{"cell_type":"Mic","gene_symbol":"RAD1","gene_symbol_current":"RAD1","gene_id":"ENSG00000113456","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.976478,"donor_log2fc":-0.0179125,"donor_lfcse":0.106059,"donor_log2fc_shrunk":-0.00282866},{"cell_type":"OPC","gene_symbol":"RAD1","gene_symbol_current":"RAD1","gene_id":"ENSG00000113456","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.884469,"nucleus_log2fc":-0.00212221,"nucleus_score":0.235423,"pct_ad":0.10006,"pct_control":0.0985605,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0402368,"donor_lfcse":0.113471,"donor_log2fc_shrunk":3.23669e-06},{"cell_type":"Oli","gene_symbol":"RAD1","gene_symbol_current":"RAD1","gene_id":"ENSG00000113456","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.9698,"donor_log2fc":-0.0191789,"donor_lfcse":0.0679744,"donor_log2fc_shrunk":-0.00373687}],"modules":[{"cell_type":"In","gene_id":"ENSG00000113456","module":"tan","kme":0.226355,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000113456","module":"turquoise","kme":0.028883,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000113456","entrez_id":["5810"],"uniprot":["O60671"],"ncbi_summary":"This gene encodes a component of a heterotrimeric cell cycle checkpoint complex, known as the 9-1-1 complex, that is activated to stop cell cycle progression in response to DNA damage or incomplete DNA replication. The 9-1-1 complex is recruited by RAD17 to affected sites where it may attract specialized DNA polymerases and other DNA repair effectors. Alternatively spliced transcript variants of this gene have been described. [provided by RefSeq, Jan 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60671","text":"Component of the 9-1-1 cell-cycle checkpoint response complex that plays a major role in DNA repair (PubMed:10846170, PubMed:10884395). The 9-1-1 complex is recruited to DNA lesion upon damage by the RAD17-replication factor C (RFC) clamp loader complex (PubMed:12578958). Acts then as a sliding clamp platform on DNA for several proteins involved in long-patch base excision repair (LP-BER) (PubMed:15871698). The 9-1-1 complex stimulates DNA polymerase beta (POLB) activity by increasing its affinity for the 3'-OH end of the primer-template and stabilizes POLB to those sites where LP-BER proceeds; endonuclease FEN1 cleavage activity on substrates with double, nick, or gap flaps of distinct sequences and lengths; and DNA ligase I (LIG1) on long-patch base excision repair substrates (PubMed:15314187, PubMed:15556996, PubMed:15871698). The 9-1-1 complex is necessary for the recruitment of RHNO1 to sites of double-stranded breaks (DSB) occurring during the S phase (PubMed:21659603)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}