_symbol":"CLCN4","gene_symbol_current":"CLCN4","gene_id":"ENSG00000073464","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.243767,"nucleus_log2fc":-0.111494,"nucleus_score":-1.53675,"pct_ad":0.220996,"pct_control":0.230313,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.107405,"donor_lfcse":0.0989538,"donor_log2fc_shrunk":-1.14835e-05,"degas_log2fc":-0.102463,"degas_padj":0.0977805},{"cell_type":"Oli","gene_symbol":"CLCN4","gene_symbol_current":"CLCN4","gene_id":"ENSG00000073464","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.52787e-18,"nucleus_log2fc":0.18495,"nucleus_score":8.9495,"pct_ad":0.402091,"pct_control":0.375042,"donor_test":"not significant","donor_padj":0.886226,"donor_log2fc":0.100035,"donor_lfcse":0.123875,"donor_log2fc_shrunk":0.00688335,"degas_log2fc":-0.0119864,"degas_padj":0.541213}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000073464","module":"brown","kme":0.198949,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000073464","module":"turquoise","kme":0.0637681,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000073464","entrez_id":["1183"],"uniprot":["P51793"],"ncbi_summary":"The CLCN family of voltage-dependent chloride channel genes comprises nine members (CLCN1-7, Ka and Kb) which demonstrate quite diverse functional characteristics while sharing significant sequence homology. Chloride channel 4 has an evolutionary conserved CpG island and is conserved in both mouse and hamster. This gene is mapped in close proximity to APXL (Apical protein Xenopus laevis-like) and OA1 (Ocular albinism type I), which are both located on the human X chromosome at band p22.3. The physiological role of chloride channel 4 remains unknown but may contribute to the pathogenesis of neuronal disorders. Alternate splicing results in two transcript variants that encode different proteins. [provided by RefSeq, Mar 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P51793","text":"Strongly outwardly rectifying, electrogenic H(+)/Cl(-)exchanger which mediates the exchange of chloride ions against protons (PubMed:18063579, PubMed:23647072, PubMed:25644381, PubMed:27550844, PubMed:28972156). The CLC channel family contains both chloride channels and proton-coupled anion transporters that exchange chloride or another anion for protons (PubMed:29845874). The presence of conserved gating glutamate residues is typical for family members that function as antiporters (PubMed:29845874)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}