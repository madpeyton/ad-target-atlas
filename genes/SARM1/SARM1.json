ne_symbol":"SARM1","gene_symbol_current":"SARM1","gene_id":"ENSG00000004139","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.177883,"nucleus_log2fc":-0.0893391,"nucleus_score":-1.7445,"pct_ad":0.316731,"pct_control":0.327858,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0792905,"donor_lfcse":0.0654292,"donor_log2fc_shrunk":-1.9151e-05},{"cell_type":"Oli","gene_symbol":"SARM1","gene_symbol_current":"SARM1","gene_id":"ENSG00000004139","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.54467e-05,"nucleus_log2fc":-0.110913,"nucleus_score":-4.36326,"pct_ad":0.132904,"pct_control":0.144459,"donor_test":"not significant","donor_padj":0.822554,"donor_log2fc":-0.0886272,"donor_lfcse":0.0778625,"donor_log2fc_shrunk":-0.0148754}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000004139","module":"blue","kme":0.0550326,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000004139","module":"pink","kme":0.186775,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000004139","entrez_id":["23098"],"uniprot":["Q6SZW1"],"ncbi_summary":"Enables NAD+ nucleotidase, cyclic ADP-ribose generating and identical protein binding activity. Involved in NAD catabolic process; positive regulation of neuron death; and response to axon injury. Located in mitochondrion. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6SZW1","text":"NAD(+) hydrolase, which plays a key role in axonal degeneration following injury by regulating NAD(+) metabolism (PubMed:25908823, PubMed:27671644, PubMed:28334607). Acts as a negative regulator of MYD88- and TRIF-dependent toll-like receptor signaling pathway by promoting Wallerian degeneration, an injury-induced form of programmed subcellular death which involves degeneration of an axon distal to the injury site (PubMed:15123841, PubMed:16964262, PubMed:20306472, PubMed:25908823). Wallerian degeneration is triggered by NAD(+) depletion: in response to injury, SARM1 is activated and catalyzes cleavage of NAD(+) into ADP-D-ribose (ADPR), cyclic ADPR (cADPR) and nicotinamide; NAD(+) cleavage promoting cytoskeletal degradation and axon destruction (PubMed:25908823, PubMed:28334607, PubMed:30333228, PubMed:31128467, PubMed:31439792, PubMed:31439793, PubMed:32049506, PubMed:32828421, PubMed:33053563). Also able to hydrolyze NADP(+), but not other NAD(+)-related molecules (PubMed:29395922). Can activate neuronal cell death in response to stress (PubMed:20306472). Regulates dendritic arborization through the MAPK4-JNK pathway (By similarity). Involved in innate immune response: inhibits both TICAM1/TRIF- and MYD88-dependent activation of JUN/AP-1, TRIF-dependent activation of NF-kappa-B and IRF3, and the phosphorylation of MAPK14/p38 (PubMed:16964262). Acts as a non-self dsDNA sensor in a sequence-independent manner to elicit NAD(+) degradation and thus to promote programmed cell death (PubMed:41138726)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}