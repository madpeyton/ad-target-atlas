onor_log2fc_shrunk":0.00194287,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Ex","gene_symbol":"ICAM1","gene_symbol_current":"ICAM1","gene_id":"ENSG00000090339","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.700297,"donor_log2fc":-0.131244,"donor_lfcse":0.104091,"donor_log2fc_shrunk":-0.0112822,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"ICAM1","gene_symbol_current":"ICAM1","gene_id":"ENSG00000090339","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.749854,"donor_log2fc":-0.17453,"donor_lfcse":0.123628,"donor_log2fc_shrunk":-0.00551349,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Mic","gene_symbol":"ICAM1","gene_symbol_current":"ICAM1","gene_id":"ENSG00000090339","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.947814,"donor_log2fc":0.0654439,"donor_lfcse":0.184657,"donor_log2fc_shrunk":0.00382915,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000090339","module":"black","kme":0.173725,"hub":false,"module_direction":"lower in AD","module_padj":1.0,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000090339","entrez_id":["3383"],"uniprot":["P05362"],"ncbi_summary":"This gene encodes a cell surface glycoprotein which is typically expressed on endothelial cells and cells of the immune system. It binds to integrins of type CD11a / CD18, or CD11b / CD18 and is also exploited by Rhinovirus as a receptor. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P05362","text":"Cell adhesion molecule that functions as a receptor ligand of the signaling receptor ITGAL:ITGB2/LFA-1 (lymphocyte-function associated (LFA) molecule 1) ensuring leukocyte cell-cell adhesion, by providing a calibrated system to namely adjust T-cell killing to the antigen stimulation strength (PubMed:3086451, PubMed:3340213, PubMed:38195629). Also functions as a ligand receptor of the signaling receptor ITGAM:ITGB2/MAC-1 ensuring adhesion between stimulated neutrophils and stimulated endothelial cells (PubMed:1980124). During leukocyte trans-endothelial migration, ICAM1 engagement promotes the assembly of endothelial apical cups through ARHGEF26/SGEF and RHOG activation (PubMed:17875742). Promotes cell aggregation in epithelial cells through interaction with MUC1 (PubMed:11173916). (Microbial infection) Acts as a receptor for major receptor group rhinovirus A-B capsid proteins. (Microbial infection) Acts as a receptor for Coxsackievirus A21 capsid proteins. (Microbial infection) Upon Kaposi's sarcoma-associated herpesvirus/HHV-8 infection, is degraded by viral E3 ubiquitin ligase MIR2, presumably to prevent lysis of infected cells by cytotoxic T-lymphocytes and NK cell."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}