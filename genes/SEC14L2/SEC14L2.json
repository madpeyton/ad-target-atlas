bel":"Mathys et al. 2019","gene_ids":["ENSG00000100003"],"dataset_symbols":["SEC14L2"],"explorer":"explorer.html?dataset=mathys2019#gene/SEC14L2","cell_types":[{"cell_type":"Ex","gene_symbol":"SEC14L2","gene_symbol_current":"SEC14L2","gene_id":"ENSG00000100003","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.992956,"donor_log2fc":-0.0592718,"donor_lfcse":0.201622,"donor_log2fc_shrunk":-2.95934e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100003","entrez_id":["23541"],"uniprot":["O76054"],"ncbi_summary":"This gene encodes a cytosolic protein which belongs to a family of lipid-binding proteins including Sec14p, alpha-tocopherol transfer protein, and cellular retinol-binding protein. The encoded protein stimulates squalene monooxygenase which is a downstream enzyme in the cholesterol biosynthetic pathway. Alternatively spliced transcript variants encoding different isoforms have been identified for this gene. [provided by RefSeq, Oct 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O76054","text":"Carrier protein. Binds to some hydrophobic molecules and promotes their transfer between the different cellular sites. Binds with high affinity to alpha-tocopherol. Also binds with a weaker affinity to other tocopherols and to tocotrienols. May have a transcriptional activatory activity via its association with alpha-tocopherol. Probably recognizes and binds some squalene structure, suggesting that it may regulate cholesterol biosynthesis by increasing the transfer of squalene to a metabolic active pool in the cell."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}