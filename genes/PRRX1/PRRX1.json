7,"donor_log2fc_shrunk":-0.00157567,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"PRRX1","gene_symbol_current":"PRRX1","gene_id":"ENSG00000116132","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.294976,"nucleus_log2fc":-0.0439821,"nucleus_score":-1.39593,"pct_ad":0.728899,"pct_control":0.737172,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0446038,"donor_lfcse":0.163901,"donor_log2fc_shrunk":-1.71431e-06,"degas_log2fc":-0.587168,"degas_padj":8.90364e-85},{"cell_type":"Oli","gene_symbol":"PRRX1","gene_symbol_current":"PRRX1","gene_id":"ENSG00000116132","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.967401,"donor_log2fc":-0.0750747,"donor_lfcse":0.232945,"donor_log2fc_shrunk":-0.00148156,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000116132","module":"brown","kme":0.294011,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000116132","module":"red","kme":0.161716,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000116132","entrez_id":["5396"],"uniprot":["P54821"],"ncbi_summary":"The DNA-associated protein encoded by this gene is a member of the paired family of homeobox proteins localized to the nucleus. The protein functions as a transcription co-activator, enhancing the DNA-binding activity of serum response factor, a protein required for the induction of genes by growth and differentiation factors. The protein regulates muscle creatine kinase, indicating a role in the establishment of diverse mesodermal muscle types. Alternative splicing yields two isoforms that differ in abundance and expression patterns. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P54821","text":"Master transcription factor of stromal fibroblasts for myofibroblastic lineage progression. Orchestrates the functional drift of fibroblasts into myofibroblastic phenotype via TGF-beta signaling by remodeling a super-enhancer landscape. Through this function, plays an essential role in wound healing process (PubMed:35589735). Acts as a transcriptional regulator of muscle creatine kinase (MCK) and so has a role in the establishment of diverse mesodermal muscle types. The protein binds to an A/T-rich element in the muscle creatine enhancer (By similarity). May play a role in homeostasis and regeneration of bone, white adipose tissue and derm (By similarity). [Isoform 1]: Transcriptional activator, when transfected in fibroblastic or myoblastic cell lines. This activity may be masked by the C-terminal OAR domain. [Isoform 2]: Transcriptional repressor, when transfected in fibroblastic or myoblastic cell lines."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}