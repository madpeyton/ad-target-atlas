":9.92873e-07,"nucleus_log2fc":0.122556,"nucleus_score":4.94812,"pct_ad":0.24549,"pct_control":0.241748,"donor_test":"not significant","donor_padj":0.68984,"donor_log2fc":0.119173,"donor_lfcse":0.0900657,"donor_log2fc_shrunk":0.0127724},{"cell_type":"In","gene_symbol":"CSK","gene_symbol_current":"CSK","gene_id":"ENSG00000103653","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00144778,"nucleus_log2fc":-0.0101986,"nucleus_score":-3.2647,"pct_ad":0.259935,"pct_control":0.268263,"donor_test":"not significant","donor_padj":0.968207,"donor_log2fc":0.0122713,"donor_lfcse":0.0721866,"donor_log2fc_shrunk":0.00115079},{"cell_type":"Mic","gene_symbol":"CSK","gene_symbol_current":"CSK","gene_id":"ENSG00000103653","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.803622,"nucleus_log2fc":0.0014081,"nucleus_score":0.32383,"pct_ad":0.275023,"pct_control":0.272465,"donor_test":"not significant","donor_padj":0.953199,"donor_log2fc":0.0267968,"donor_lfcse":0.0866057,"donor_log2fc_shrunk":0.00605025},{"cell_type":"OPC","gene_symbol":"CSK","gene_symbol_current":"CSK","gene_id":"ENSG00000103653","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0941751,"donor_lfcse":0.116846,"donor_log2fc_shrunk":-7.12026e-06},{"cell_type":"Oli","gene_symbol":"CSK","gene_symbol_current":"CSK","gene_id":"ENSG00000103653","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.84394,"donor_log2fc":0.134502,"donor_lfcse":0.12783,"donor_log2fc_shrunk":0.0086952}],"modules":[{"cell_type":"In","gene_id":"ENSG00000103653","module":"red","kme":0.142844,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000103653","entrez_id":["1445"],"uniprot":["P41240"],"ncbi_summary":"The protein encoded by this gene is involved in multiple pathways, including the regulation of Src family kinases. It plays an important role in T-cell activation through its association with the protein encoded by the protein tyrosine phosphatase, non-receptor type 22 (PTPN22) gene. This protein also phosphorylates C-terminal tyrosine residues on multiple substrates, including the protein encoded by the SRC proto-oncogene, non-receptor tyrosine kinase gene. Phosphorylation suppresses the kinase activity of the Src family tyrosine kinases. An intronic polymorphism (rs34933034) in this gene has been found to affect B-cell activation and is associated with systemic lupus erythematosus (SLE). Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P41240","text":"Non-receptor tyrosine-protein kinase that plays an important role in the regulation of cell growth, differentiation, migration and immune response. Phosphorylates tyrosine residues located in the C-terminal tails of Src-family kinases (SFKs) including LCK, SRC, HCK, FYN, LYN, CSK or YES1. Upon tail phosphorylation, Src-family members engage in intramolecular interactions between the phosphotyrosine tail and the SH2 domain that result in an inactive conformation. To inhibit SFKs, CSK is recruited to the plasma membrane via binding to transmembrane proteins or adapter proteins located near the plasma membrane. Suppresses signaling by various surface receptors, including T-cell receptor (TCR) and B-cell receptor (BCR) by phosphorylating and maintaining inactive several positive effectors such as FYN or LCK. May act as a negative regulator of EGFR and STAT3 signaling pathways (PubMed:26918609)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}