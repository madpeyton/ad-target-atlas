plorer.html?dataset=mathys2019#gene/ASMTL","cell_types":[{"cell_type":"Ex","gene_symbol":"ASMTL","gene_symbol_current":"ASMTL","gene_id":"ENSG00000169093","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":5.25382e-11,"nucleus_log2fc":-0.349749,"nucleus_score":-6.92903,"pct_ad":0.166599,"pct_control":0.200829,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.123305,"donor_lfcse":0.15479,"donor_log2fc_shrunk":-5.40425e-06},{"cell_type":"In","gene_symbol":"ASMTL","gene_symbol_current":"ASMTL","gene_id":"ENSG00000169093","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.071853,"donor_lfcse":0.23755,"donor_log2fc_shrunk":-1.35655e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000169093","module":"turquoise","kme":0.205306,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000169093","entrez_id":["8623"],"uniprot":["O95671"],"ncbi_summary":"The protein encoded by this gene has an N-terminus that is similar to the multicopy associated filamentation (maf) protein of Bacillus subtilis and to orfE of Escherichia coli, while the C-terminus is similar to N-acetylserotonin O-methyltransferase. This gene is located in the pseudoautosomal region 1 (PAR1) of X and Y chromosomes. Three transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95671","text":"Nucleoside triphosphate pyrophosphatase that hydrolyzes dTTP and UTP. Can also hydrolyze CTP and the modified nucleotides pseudo-UTP, 5-methyl-UTP (m(5)UTP) and 5-methyl-CTP (m(5)CTP). Has weak activity with dCTP, 8-oxo-GTP and N(4)-methyl-dCTP (PubMed:24210219). May have a dual role in cell division arrest and in preventing the incorporation of modified nucleotides into cellular nucleic acids (PubMed:24210219). In addition, the presence of the putative catalytic domain of S-adenosyl-L-methionine binding in the C-terminal region argues for a methyltransferase activity (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}