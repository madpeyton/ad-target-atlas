rue,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.65716e-39,"nucleus_log2fc":-0.22519,"nucleus_score":-13.2777,"pct_ad":0.425344,"pct_control":0.473783,"donor_test":"not significant","donor_padj":0.689277,"donor_log2fc":-0.138301,"donor_lfcse":0.083442,"donor_log2fc_shrunk":-0.0209953,"degas_log2fc":-0.296195,"degas_padj":1.01503e-64}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165714","entrez_id":["118426"],"uniprot":["Q969J3"],"ncbi_summary":"Involved in lysosome localization and organelle transport along microtubule. Located in cytoplasmic side of lysosomal membrane and plasma membrane. Is intrinsic component of membrane. Part of BORC complex. Colocalizes with plus-end kinesin complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q969J3","text":"As part of the BORC complex may play a role in lysosomes movement and localization at the cell periphery. Associated with the cytosolic face of lysosomes, the BORC complex may recruit ARL8B and couple lysosomes to microtubule plus-end-directed kinesin motor. Thereby, it may indirectly play a role in cell spreading and motility."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}