ficant","donor_padj":0.638149,"donor_log2fc":-0.119049,"donor_lfcse":0.085108,"donor_log2fc_shrunk":-0.0319443},{"cell_type":"OPC","gene_symbol":"HDAC8","gene_symbol_current":"HDAC8","gene_id":"ENSG00000147099","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.10236e-05,"nucleus_log2fc":-0.13579,"nucleus_score":-4.75999,"pct_ad":0.705339,"pct_control":0.718374,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.133094,"donor_lfcse":0.0875447,"donor_log2fc_shrunk":-1.7932e-05},{"cell_type":"Oli","gene_symbol":"HDAC8","gene_symbol_current":"HDAC8","gene_id":"ENSG00000147099","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":4.5391e-05,"nucleus_log2fc":-0.061132,"nucleus_score":-4.22999,"pct_ad":0.512984,"pct_control":0.533607,"donor_test":"not significant","donor_padj":0.954407,"donor_log2fc":-0.0371302,"donor_lfcse":0.0930046,"donor_log2fc_shrunk":-0.00377214}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000147099","module":"blue","kme":0.154387,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000147099","module":"pink","kme":0.234517,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000147099","module":"brown","kme":0.239002,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000147099","module":"blue","kme":0.188606,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000147099","entrez_id":["55869"],"uniprot":["Q9BY41"],"ncbi_summary":"Histones play a critical role in transcriptional regulation, cell cycle progression, and developmental events. Histone acetylation/deacetylation alters chromosome structure and affects transcription factor access to DNA. The protein encoded by this gene belongs to class I of the histone deacetylase family. It catalyzes the deacetylation of lysine residues in the histone N-terminal tails and represses transcription in large multiprotein complexes with transcriptional co-repressors. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Oct 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BY41","text":"Histone deacetylase that catalyzes the deacetylation of lysine residues on the N-terminal part of the core histones (H2A, H2B, H3 and H4) (PubMed:10748112, PubMed:10922473, PubMed:10926844, PubMed:14701748, PubMed:28497810). Histone deacetylation gives a tag for epigenetic repression and plays an important role in transcriptional regulation, cell cycle progression and developmental events (PubMed:10748112, PubMed:10922473, PubMed:10926844, PubMed:14701748). Histone deacetylases act via the formation of large multiprotein complexes (PubMed:10748112, PubMed:10922473, PubMed:10926844, PubMed:14701748). Also involved in the deacetylation of cohesin complex protein SMC3 regulating release of cohesin complexes from chromatin (PubMed:22885700). May play a role in smooth muscle cell contractility (PubMed:15772115). In addition to protein deacetylase activity, also has protein-lysine deacylase activity: acts as a protein decrotonylase by mediating decrotonylation ((2E)-butenoyl) of histones (PubMed:28497810)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}