"OPC","gene_symbol":"SLC7A5","gene_symbol_current":"SLC7A5","gene_id":"ENSG00000103257","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.982773,"nucleus_log2fc":-0.0261088,"nucleus_score":-0.0355549,"pct_ad":0.21861,"pct_control":0.21812,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0716862,"donor_lfcse":0.0797321,"donor_log2fc_shrunk":-1.169e-05},{"cell_type":"Oli","gene_symbol":"SLC7A5","gene_symbol_current":"SLC7A5","gene_id":"ENSG00000103257","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.867581,"donor_log2fc":0.187812,"donor_lfcse":0.207009,"donor_log2fc_shrunk":0.00530255}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000103257","module":"magenta","kme":0.229165,"hub":false,"module_direction":"higher in AD","module_padj":0.456482,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000103257","module":"purple","kme":0.202583,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000103257","entrez_id":["8140"],"uniprot":["Q01650"],"ncbi_summary":"Enables L-leucine transmembrane transporter activity; L-tryptophan transmembrane transporter activity; and thyroid hormone transmembrane transporter activity. Involved in carboxylic acid transport; thyroid hormone transport; and xenobiotic transport. Located in cytosol; intracellular membrane-bounded organelle; and plasma membrane. Is integral component of membrane. Part of amino acid transport complex; apical plasma membrane; and microvillus membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q01650","text":"Forms a heterodimer with SLC3A2 that functions as a sodium-independent transporter for large neutral amino acids (PubMed:9751058, PubMed:10049700, PubMed:11557028, PubMed:10574970, PubMed:11564694, PubMed:12117417, PubMed:12225859, PubMed:15769744, PubMed:18262359, PubMed:25998567, PubMed:30867591). Functions as an obligatory amino acid antiporter, mediating the exchange of amino acids and amino acid-related compounds across the plasma membrane (PubMed:11557028, PubMed:12117417, PubMed:12225859, PubMed:11847106, PubMed:17896864). Also mediates sodium-independent exchange of iodothyronines with neutral and aromatic L-alpha-amino acids (PubMed:11564694, PubMed:12225859). Mediates exchange of L-tryptophan with the tryptophan metabolites L-kynurenine and 3-hydroxy-L-kynurenine (PubMed:17896864). Mediates cellular uptake of iodothyronines, including thyroxine (T4), triiodothyronine (T3), reverse triiodothyronine (rT3) and 3,3'-diiodo-L-thyronine (3,3'-T2), and iodotyrosines including 3-iodo-L-tyrosine (MIT) and 3,5-diiodo-L-tyrosine (DIT) (PubMed:26305885, PubMed:38661522). Involved in the uptake of methylmercury (MeHg) when administered as L-cysteine or D,L-homocysteine complexes, thereby contributing to metal ion homeostasis and toxicity (PubMed:12117417). Involved in the cellular activity of low-molecular-weight nitrosothiols through stereoselective transport of L-nitrosocysteine (L-CNSO) across the plasma membrane (PubMed:15769744). When associated with LAPTM4B, the heterodimer is recruited to lysosomes, where it promotes leucine uptake into these organelles and thereby contributes to mTORC1 activation (PubMed:25998567). (Microbial infection) In case of hepatitis C virus/HCV infection, the complex formed by SLC3A2 and SLC7A5/LAT1 plays a role in HCV propagation by facilitating viral entry into host cell and increasing L-leucine uptake-mediated mTORC1 signaling activation, thereby contributing to HCV-mediated pathogenesis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}