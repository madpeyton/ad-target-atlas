ds":["ENSG00000125686"],"dataset_symbols":["MED1"],"explorer":"explorer.html?dataset=mathys2019#gene/MED1","cell_types":[{"cell_type":"Ex","gene_symbol":"MED1","gene_symbol_current":"MED1","gene_id":"ENSG00000125686","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0127344,"nucleus_log2fc":-0.0938403,"nucleus_score":-2.73153,"pct_ad":0.180313,"pct_control":0.195565,"donor_test":"not significant","donor_padj":0.988658,"donor_log2fc":-0.026364,"donor_lfcse":0.0673582,"donor_log2fc_shrunk":7.07691e-05},{"cell_type":"In","gene_symbol":"MED1","gene_symbol_current":"MED1","gene_id":"ENSG00000125686","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.851046,"nucleus_log2fc":-0.0202322,"nucleus_score":0.546239,"pct_ad":0.11402,"pct_control":0.107999,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.09773,"donor_lfcse":0.144098,"donor_log2fc_shrunk":4.90861e-06},{"cell_type":"Oli","gene_symbol":"MED1","gene_symbol_current":"MED1","gene_id":"ENSG00000125686","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.942097,"donor_log2fc":0.0673357,"donor_lfcse":0.144153,"donor_log2fc_shrunk":0.00306579}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000125686","module":"tan","kme":0.163002,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000125686","entrez_id":["5469"],"uniprot":["Q15648"],"ncbi_summary":"The activation of gene transcription is a multistep process that is triggered by factors that recognize transcriptional enhancer sites in DNA. These factors work with co-activators to direct transcriptional initiation by the RNA polymerase II apparatus. The protein encoded by this gene is a subunit of the CRSP (cofactor required for SP1 activation) complex, which, along with TFIID, is required for efficient activation by SP1. This protein is also a component of other multisubunit complexes e.g. thyroid hormone receptor-(TR-) associated proteins which interact with TR and facilitate TR function on DNA templates in conjunction with initiation factors and cofactors. It also regulates p53-dependent apoptosis and it is essential for adipogenesis. This protein is known to have the ability to self-oligomerize. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15648","text":"Component of the Mediator complex, a coactivator involved in the regulated transcription of nearly all RNA polymerase II-dependent genes. Mediator functions as a bridge to convey information from gene-specific regulatory proteins to the basal RNA polymerase II transcription machinery. Mediator is recruited to promoters by direct interactions with regulatory proteins and serves as a scaffold for the assembly of a functional preinitiation complex with RNA polymerase II and the general transcription factors (PubMed:10406464, PubMed:11867769, PubMed:12037571, PubMed:12218053, PubMed:12556447, PubMed:14636573, PubMed:15340084, PubMed:15471764, PubMed:15989967, PubMed:16574658, PubMed:9653119). Acts as a coactivator for GATA1-mediated transcriptional activation during erythroid differentiation of K562 erythroleukemia cells (PubMed:24245781)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}