eus_log2fc":0.242412,"nucleus_score":6.08081,"pct_ad":0.477632,"pct_control":0.431329,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.155078,"donor_lfcse":0.174682,"donor_log2fc_shrunk":5.32346e-06,"degas_log2fc":-0.356014,"degas_padj":1.37146e-18},{"cell_type":"Oli","gene_symbol":"CHST3","gene_symbol_current":"CHST3","gene_id":"ENSG00000122863","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.76371e-116,"nucleus_log2fc":0.403126,"nucleus_score":23.0713,"pct_ad":0.467749,"pct_control":0.388755,"donor_test":"not significant","donor_padj":0.634068,"donor_log2fc":0.292575,"donor_lfcse":0.153575,"donor_log2fc_shrunk":0.0142065,"degas_log2fc":-0.107826,"degas_padj":1.96907e-09}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000122863","module":"yellow","kme":0.226723,"hub":false,"module_direction":"higher in AD","module_padj":0.663532,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000122863","module":"blue","kme":0.225481,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000122863","entrez_id":["9469"],"uniprot":["Q7LGC8"],"ncbi_summary":"This gene encodes an enzyme which catalyzes the sulfation of chondroitin, a proteoglycan found in the extracellular matrix and most cells which is involved in cell migration and differentiation. Mutations in this gene are associated with spondylepiphyseal dysplasia and humerospinal dysostosis. [provided by RefSeq, Mar 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q7LGC8","text":"Sulfotransferase that utilizes 3'-phospho-5'-adenylyl sulfate (PAPS) as sulfonate donor to catalyze the transfer of sulfate to position 6 of the N-acetylgalactosamine (GalNAc) residue of chondroitin (PubMed:15215498, PubMed:9714738, PubMed:9883891). Chondroitin sulfate constitutes the predominant proteoglycan present in cartilage and is distributed on the surfaces of many cells and extracellular matrices (PubMed:9714738). Catalyzes with a lower efficiency the sulfation of Gal residues of keratan sulfate, another glycosaminoglycan (PubMed:9714738). Can also catalyze the sulfation of the Gal residues in sialyl N-acetyllactosamine (sialyl LacNAc) oligosaccharides (By similarity). May play a role in the maintenance of naive T-lymphocytes in the spleen (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}