leus_direction":"higher in AD","nucleus_padj":5.11615e-10,"nucleus_log2fc":0.477932,"nucleus_score":6.63023,"pct_ad":0.115753,"pct_control":0.0864027,"donor_test":"not significant","donor_padj":0.758006,"donor_log2fc":0.308308,"donor_lfcse":0.190674,"donor_log2fc_shrunk":0.00833509}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000129757","module":"turquoise","kme":0.129125,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000129757","entrez_id":["1028"],"uniprot":["P49918"],"ncbi_summary":"This gene is imprinted, with preferential expression of the maternal allele. The encoded protein is a tight-binding, strong inhibitor of several G1 cyclin/Cdk complexes and a negative regulator of cell proliferation. Mutations in this gene are implicated in sporadic cancers and Beckwith-Wiedemann syndorome, suggesting that this gene is a tumor suppressor candidate. Three transcript variants encoding two different isoforms have been found for this gene. [provided by RefSeq, Oct 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P49918","text":"Potent tight-binding inhibitor of several G1 cyclin/CDK complexes (cyclin E-CDK2, cyclin D2-CDK4, and cyclin A-CDK2) and, to lesser extent, of the mitotic cyclin B-CDC2. Negative regulator of cell proliferation. May play a role in maintenance of the non-proliferative state throughout life."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}