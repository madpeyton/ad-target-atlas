nt":"CRLF1","gene_id":"ENSG00000006016","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.998576,"donor_log2fc":0.00190446,"donor_lfcse":0.243702,"donor_log2fc_shrunk":7.34341e-05,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"CRLF1","gene_symbol_current":"CRLF1","gene_id":"ENSG00000006016","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.918654,"donor_log2fc":-0.110157,"donor_lfcse":0.168122,"donor_log2fc_shrunk":-0.00421135,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000006016","module":"blue","kme":0.390906,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000006016","entrez_id":["9244"],"uniprot":["O75462"],"ncbi_summary":"This gene encodes a member of the cytokine type I receptor family. The protein forms a secreted complex with cardiotrophin-like cytokine factor 1 and acts on cells expressing ciliary neurotrophic factor receptors. The complex can promote survival of neuronal cells. Mutations in this gene result in Crisponi syndrome and cold-induced sweating syndrome. [provided by RefSeq, Oct 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75462","text":"Functions as secretory protein carrier chaperone that promotes cellular release (PubMed:10966616). Also functions as a cytokine subunit within the CRLF1-CLCF1 heterodimer, which engages the CNTF receptor complex (CNTFR, IL6ST/gp130, LIFR) (PubMed:10966616). As part of the CRLF-CLCF1 complex, binds to CNTFR, induces dimerization of the IL6ST/gp130 and LIFR, which activates JAK tyrosine kinases (JAK1 or JAK2 and to lesser extent TYK2) bound to their intracellular domains (PubMed:11294841). These kinases subsequently phosphorylate IL6ST/gp130 and LIFR (PubMed:11294841). The tyrosine phosphorylated signaling receptors serve in turn as docking sites for recruitment and activation of signal transducer and activators of transcription (STAT3 and to lesser extent STAT1) (PubMed:10966616, PubMed:11294841). Moreover, CLCF1/CLF heterodimer induces tyrosine phosphorylation of PTPN11, that associates with IL6ST/gp130-LIFR, which in turn recruits PIK3 protein kinase followed by AKT protein phosphorylation (PubMed:11294841). Participates in the survival of embryonic motor neurons (PubMed:10966616). May also play a regulatory role in the immune system (PubMed:9686600)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}