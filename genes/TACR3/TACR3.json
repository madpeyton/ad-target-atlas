ted","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.917079,"donor_log2fc":0.114891,"donor_lfcse":0.173134,"donor_log2fc_shrunk":0.00408403,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000169836","module":"blue","kme":0.261845,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000169836","entrez_id":["6870"],"uniprot":["P29371"],"ncbi_summary":"This gene belongs to a family of genes that function as receptors for tachykinins.  Receptor affinities are specified by variations in the 5'-end of the sequence.  The receptors belonging to this family are characterized by interactions with G proteins and 7 hydrophobic transmembrane regions.  This gene encodes the receptor for the tachykinin neurokinin 3, also referred to as neurokinin B. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P29371","text":"Receptor for the tachykinin neuromedin-K (neurokinin B), also able to bind and respond to tachynins substance K/neurokinin A and substance P (PubMed:1312036, PubMed:37391393). The rank order of affinity of this receptor to tachykinins is: neuromedin-K > substance K and substance P (PubMed:1312036). Neuromedin-K binding to its receptor triggers G protein-coupled receptor signaling via activation of G(q) and phosphatidylinositol hydrolysis by phospholipase C (PubMed:37391393). Neuromedin-K binding also triggers signaling via activation of adenylate cyclase activity which results in increased intracellular levels of cyclic AMP (cAMP) (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}