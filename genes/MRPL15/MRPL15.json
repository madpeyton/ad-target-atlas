":"ENSG00000137547","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.753256,"nucleus_log2fc":-0.0192641,"nucleus_score":0.809905,"pct_ad":0.124224,"pct_control":0.115157,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0298481,"donor_lfcse":0.21841,"donor_log2fc_shrunk":6.6995e-07}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000137547","module":"turquoise","kme":0.270726,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000137547","module":"turquoise","kme":0.267548,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000137547","entrez_id":["29088"],"uniprot":["Q9P015"],"ncbi_summary":"Mammalian mitochondrial ribosomal proteins are encoded by nuclear genes and help in protein synthesis within the mitochondrion. Mitochondrial ribosomes (mitoribosomes) consist of a small 28S subunit and a large 39S subunit. They have an estimated 75% protein to rRNA composition compared to prokaryotic ribosomes, where this ratio is reversed. Another difference between mammalian mitoribosomes and prokaryotic ribosomes is that the latter contain a 5S rRNA. Among different species, the proteins comprising the mitoribosome differ greatly in sequence, and sometimes in biochemical properties, which prevents easy recognition by sequence homology. This gene encodes a 39S subunit protein that belongs to the EcoL15 ribosomal protein family. A pseudogene corresponding to this gene is found on chromosome 15q. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[],"uniprot_source":null,"retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}