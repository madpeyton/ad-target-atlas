8,"pct_ad":0.169825,"pct_control":0.19294,"donor_test":"not significant","donor_padj":0.81546,"donor_log2fc":-0.111738,"donor_lfcse":0.126162,"donor_log2fc_shrunk":-0.00355678},{"cell_type":"Mic","gene_symbol":"EBP","gene_symbol_current":"EBP","gene_id":"ENSG00000147155","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.900726,"donor_log2fc":0.102368,"donor_lfcse":0.183883,"donor_log2fc_shrunk":0.00601799},{"cell_type":"OPC","gene_symbol":"EBP","gene_symbol_current":"EBP","gene_id":"ENSG00000147155","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.264121,"donor_lfcse":0.209855,"donor_log2fc_shrunk":-6.15843e-06},{"cell_type":"Oli","gene_symbol":"EBP","gene_symbol_current":"EBP","gene_id":"ENSG00000147155","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.938004,"donor_log2fc":-0.100656,"donor_lfcse":0.200626,"donor_log2fc_shrunk":-0.00274712}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000147155","module":"turquoise","kme":0.0776381,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000147155","entrez_id":["10682"],"uniprot":["Q15125"],"ncbi_summary":"The protein encoded by this gene is an integral membrane protein of the endoplasmic reticulum. It is a high affinity binding protein for the antiischemic phenylalkylamine Ca2+ antagonist [3H]emopamil and the photoaffinity label [3H]azidopamil. It is similar to sigma receptors and may be a member of a superfamily of high affinity drug-binding proteins in the endoplasmic reticulum of different tissues. This protein shares structural features with bacterial and eukaryontic drug transporting proteins. It has four putative transmembrane segments and contains two conserved glutamate residues which may be involved in the transport of cationic amphiphilics. Another prominent feature of this protein is its high content of aromatic amino acid residues (>23%) in its transmembrane segments. These aromatic amino acid residues have been suggested to be involved in the drug transport by the P-glycoprotein. Mutations in this gene cause Chondrodysplasia punctata 2 (CDPX2; also known as Conradi-Hunermann syndrome). [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15125","text":"Isomerase that catalyzes the conversion of Delta(8)-sterols to their corresponding Delta(7)-isomers a catalytic step in the postlanosterol biosynthesis of cholesterol. Component of the microsomal antiestrogen binding site (AEBS), a multiproteic complex at the ER membrane that consists of an association between EBP and 7-dehydrocholesterol reductase/DHCR7 (PubMed:15175332, PubMed:20615952). This complex is responsible for cholesterol-5,6-epoxide hydrolase (ChEH) activity, which consists in the hydration of cholesterol-5,6-epoxides (5,6-EC) into cholestane-3beta,5alpha,6beta-triol (CT) (PubMed:20615952). The precise role of each component of this complex has not been described yet (PubMed:20615952)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}