5e-10,"nucleus_log2fc":0.262565,"nucleus_score":6.32504,"pct_ad":0.109709,"pct_control":0.0956783,"donor_test":"not significant","donor_padj":0.927802,"donor_log2fc":0.118555,"donor_lfcse":0.202786,"donor_log2fc_shrunk":0.00311897,"degas_log2fc":-0.0739268,"degas_padj":0.0511304}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000008056","module":"blue","kme":0.144985,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000008056","module":"red","kme":0.423868,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000008056","module":"turquoise","kme":0.138924,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000008056","module":"brown","kme":0.103032,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000008056","entrez_id":["6853"],"uniprot":["P17600"],"ncbi_summary":"This gene is a member of the synapsin gene family. Synapsins encode neuronal phosphoproteins which associate with the cytoplasmic surface of synaptic vesicles. Family members are characterized by common protein domains, and they are implicated in synaptogenesis and the modulation of neurotransmitter release, suggesting a potential role in several neuropsychiatric diseases. This member of the synapsin family plays a role in regulation of axonogenesis and synaptogenesis. The protein encoded serves as a substrate for several different protein kinases and phosphorylation may function in the regulation of this protein in the nerve terminal. Mutations in this gene may be associated with X-linked disorders with primary neuronal degeneration such as Rett syndrome. Alternatively spliced transcript variants encoding different isoforms have been identified. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P17600","text":"Neuronal phosphoprotein that coats synaptic vesicles, and binds to the cytoskeleton. Acts as a regulator of synaptic vesicles trafficking, involved in the control of neurotransmitter release at the pre-synaptic terminal (PubMed:21441247, PubMed:23406870). Also involved in the regulation of axon outgrowth and synaptogenesis (By similarity). The complex formed with NOS1 and CAPON proteins is necessary for specific nitric-oxid functions at a presynaptic level (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}