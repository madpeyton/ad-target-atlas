mbol":"KLRB1","gene_symbol_current":"KLRB1","gene_id":"ENSG00000111796","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.973576,"donor_log2fc":-0.0472207,"donor_lfcse":0.387612,"donor_log2fc_shrunk":-0.000289439},{"cell_type":"In","gene_symbol":"KLRB1","gene_symbol_current":"KLRB1","gene_id":"ENSG00000111796","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.978668,"donor_log2fc":-0.0448716,"donor_lfcse":0.369828,"donor_log2fc_shrunk":-0.000157589},{"cell_type":"OPC","gene_symbol":"KLRB1","gene_symbol_current":"KLRB1","gene_id":"ENSG00000111796","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0147753,"donor_lfcse":0.409267,"donor_log2fc_shrunk":9.72207e-08}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000111796","module":"turquoise","kme":0.173726,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000111796","entrez_id":["3820"],"uniprot":["Q12918"],"ncbi_summary":"Natural killer (NK) cells are lymphocytes that mediate cytotoxicity and secrete cytokines after immune stimulation. Several genes of the C-type lectin superfamily, including the rodent NKRP1 family of glycoproteins, are expressed by NK cells and may be involved in the regulation of NK cell function. The KLRB1 protein contains an extracellular domain with several motifs characteristic of C-type lectins, a transmembrane domain, and a cytoplasmic domain. The KLRB1 protein is classified as a type II membrane protein because it has an external C terminus. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q12918","text":"Plays an inhibitory role on natural killer (NK) cells cytotoxicity. Activation results in specific acid sphingomyelinase/SMPD1 stimulation with subsequent marked elevation of intracellular ceramide. Activation also leads to AKT1/PKB and RPS6KA1/RSK1 kinases stimulation as well as markedly enhanced T-cell proliferation induced by anti-CD3. Acts as a lectin that binds to the terminal carbohydrate Gal-alpha(1,3)Gal epitope as well as to the N-acetyllactosamine epitope. Also binds to CLEC2D/LLT1 as a ligand and inhibits NK cell-mediated cytotoxicity as well as interferon-gamma secretion in target cells."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}