j":0.756495,"donor_log2fc":0.0684473,"donor_lfcse":0.0660148,"donor_log2fc_shrunk":0.0255916,"degas_log2fc":0.136452,"degas_padj":0.00500652},{"cell_type":"OPC","gene_symbol":"LARP7","gene_symbol_current":"LARP7","gene_id":"ENSG00000174720","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0332379,"nucleus_log2fc":0.141124,"nucleus_score":2.59173,"pct_ad":0.223084,"pct_control":0.203726,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.175215,"donor_lfcse":0.0872496,"donor_log2fc_shrunk":2.40866e-05,"degas_log2fc":-0.143968,"degas_padj":0.0223224},{"cell_type":"Oli","gene_symbol":"LARP7","gene_symbol_current":"LARP7","gene_id":"ENSG00000174720","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.3587e-31,"nucleus_log2fc":0.271068,"nucleus_score":11.7119,"pct_ad":0.248014,"pct_control":0.210605,"donor_test":"not significant","donor_padj":0.552938,"donor_log2fc":0.210646,"donor_lfcse":0.0959227,"donor_log2fc_shrunk":0.0328631,"degas_log2fc":-0.06174,"degas_padj":0.0137237}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000174720","module":"red","kme":0.127848,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000174720","entrez_id":["51574"],"uniprot":["Q4G0J3"],"ncbi_summary":"This gene encodes a protein which is found in the 7SK snRNP (small nuclear ribonucleoprotein). This snRNP complex inhibits a cyclin-dependent kinase, positive transcription elongation factor b, which is required for paused RNA polymerase II at a promoter to begin transcription elongation. A pseudogene of this gene is located on chromosome 3. Alternative splicing results in multiple transcript variants. [provided by RefSeq, May 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q4G0J3","text":"RNA-binding protein that specifically binds distinct small nuclear RNA (snRNAs) and regulates their processing and function (PubMed:18249148, PubMed:32017898). Specifically binds the 7SK snRNA (7SK RNA) and acts as a core component of the 7SK ribonucleoprotein (RNP) complex, thereby acting as a negative regulator of transcription elongation by RNA polymerase II (PubMed:18249148, PubMed:18483487). The 7SK RNP complex sequesters the positive transcription elongation factor b (P-TEFb) in a large inactive 7SK RNP complex preventing RNA polymerase II phosphorylation and subsequent transcriptional elongation (PubMed:18249148, PubMed:18483487). The 7SK RNP complex also promotes snRNA gene transcription by RNA polymerase II via interaction with the little elongation complex (LEC) (PubMed:28254838). LARP7 specifically binds to the highly conserved 3'-terminal U-rich stretch of 7SK RNA; on stimulation, remains associated with 7SK RNA, whereas P-TEFb is released from the complex (PubMed:18281698, PubMed:18483487). LARP7 also acts as a regulator of mRNA splicing fidelity by promoting U6 snRNA processing (PubMed:32017898). Specifically binds U6 snRNAs and associates with a subset of box C/D RNP complexes: promotes U6 snRNA 2'-O-methylation by facilitating U6 snRNA loading into box C/D RNP complexes (PubMed:32017898). U6 snRNA 2'-O-methylation is required for mRNA splicing fidelity (PubMed:32017898). Binds U6 snRNAs with a 5'-CAGGG-3' sequence motif (PubMed:32017898). U6 snRNA processing is required for spermatogenesis (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}