15,"nucleus_score":-3.72148,"pct_ad":0.642061,"pct_control":0.6553,"donor_test":"not significant","donor_padj":0.781113,"donor_log2fc":-0.100178,"donor_lfcse":0.104443,"donor_log2fc_shrunk":-0.0174773,"degas_log2fc":0.120777,"degas_padj":1.99232e-05},{"cell_type":"OPC","gene_symbol":"SAMHD1","gene_symbol_current":"SAMHD1","gene_id":"ENSG00000101347","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.24304e-22,"nucleus_log2fc":0.34009,"nucleus_score":10.2063,"pct_ad":0.624963,"pct_control":0.543607,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.271429,"donor_lfcse":0.231383,"donor_log2fc_shrunk":5.3151e-06,"degas_log2fc":-0.39295,"degas_padj":2.15675e-29},{"cell_type":"Oli","gene_symbol":"SAMHD1","gene_symbol_current":"SAMHD1","gene_id":"ENSG00000101347","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":8.13982e-58,"nucleus_log2fc":0.396934,"nucleus_score":16.1873,"pct_ad":0.238251,"pct_control":0.188996,"donor_test":"not significant","donor_padj":0.873308,"donor_log2fc":0.219346,"donor_lfcse":0.249035,"donor_log2fc_shrunk":0.0040695,"degas_log2fc":-0.143899,"degas_padj":3.02842e-08}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000101347","module":"yellow","kme":0.170744,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000101347","module":"yellow","kme":0.317611,"hub":false,"module_direction":"higher in AD","module_padj":0.663532,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000101347","module":"blue","kme":0.103724,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101347","entrez_id":["25939"],"uniprot":["Q9Y3Z3"],"ncbi_summary":"This gene may play a role in regulation of the innate immune response. The encoded protein is upregulated in response to viral infection and may be involved in mediation of tumor necrosis factor-alpha proinflammatory responses. Mutations in this gene have been associated with Aicardi-Goutieres syndrome. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y3Z3","text":"Protein that acts both as a host restriction factor involved in defense response to virus and as a regulator of DNA end resection at stalled replication forks (PubMed:19525956, PubMed:21613998, PubMed:21720370, PubMed:22056990, PubMed:23601106, PubMed:23602554, PubMed:24336198, PubMed:26294762, PubMed:26431200, PubMed:28229507, PubMed:28834754, PubMed:29670289). Has deoxynucleoside triphosphate (dNTPase) activity, which is required to restrict infection by viruses, such as HIV-1: dNTPase activity reduces cellular dNTP levels to levels too low for retroviral reverse transcription to occur, blocking early-stage virus replication in dendritic and other myeloid cells (PubMed:19525956, PubMed:21613998, PubMed:21720370, PubMed:22056990, PubMed:23364794, PubMed:23601106, PubMed:23602554, PubMed:24336198, PubMed:25038827, PubMed:26101257, PubMed:26294762, PubMed:26431200, PubMed:28229507). Likewise, suppresses LINE-1 retrotransposon activity (PubMed:24035396, PubMed:24217394, PubMed:29610582). Not able to restrict infection by HIV-2 virus; because restriction activity is counteracted by HIV-2 viral protein Vpx (PubMed:21613998, PubMed:21720370). In addition to virus restriction, dNTPase activity acts as a regulator of DNA precursor pools by regulating dNTP pools (PubMed:23858451). Phosphorylation at Thr-592 acts as a switch to control dNTPase-dependent and -independent functions: it inhibits dNTPase activity and ability to restrict infection by viruses, while it promotes DNA end resection at stalled replication forks (PubMed:23601106, PubMed:23602554, PubMed:29610582, PubMed:29670289). Functions during S phase at stalled DNA replication forks to promote the resection of gapped or reversed forks: acts by stimulating the exonuclease activity of MRE11, activating the ATR-CHK1 pathway and allowing the forks to restart replication (PubMed:29670289). Its ability to promote degradation of nascent DNA at stalled replication forks is required to prevent induction of type I interferons, thereby preventing chronic inflammation (PubMed:27477283, PubMed:29670289). Ability to promote DNA end resection at stalled replication forks is independent of dNTPase activity (PubMed:29670289). Enhances immunoglobulin hypermutation in B-lymphocytes by promoting transversion mutation (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}