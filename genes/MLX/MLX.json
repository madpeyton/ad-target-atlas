eus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.975371,"donor_log2fc":0.0244596,"donor_lfcse":0.120035,"donor_log2fc_shrunk":0.00177535,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000108788","module":"turquoise","kme":0.134994,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000108788","module":"turquoise","kme":0.208044,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000108788","module":"brown","kme":0.150893,"hub":false,"module_direction":"higher in AD","module_padj":0.939268,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000108788","module":"turquoise","kme":0.123437,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000108788","module":"turquoise","kme":0.0865986,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000108788","entrez_id":["6945"],"uniprot":["Q9UH92"],"ncbi_summary":"The product of this gene belongs to the family of basic helix-loop-helix leucine zipper (bHLH-Zip) transcription factors. These factors form heterodimers with Mad proteins and play a role in proliferation, determination and differentiation. This gene product may act to diversify Mad family function by its restricted association with a subset of the Mad family of transcriptional repressors, namely, Mad1 and Mad4. Alternatively spliced transcript variants encoding different isoforms have been identified for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UH92","text":"Transcription regulator. Forms a sequence-specific DNA-binding protein complex with MAD1, MAD4, MNT, WBSCR14 and MLXIP which recognizes the core sequence 5'-CACGTG-3'. The TCFL4-MAD1, TCFL4-MAD4, TCFL4-WBSCR14 complexes are transcriptional repressors. Plays a role in transcriptional activation of glycolytic target genes. Involved in glucose-responsive gene regulation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}