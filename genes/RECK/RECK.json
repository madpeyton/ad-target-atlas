type":"Mic","gene_symbol":"RECK","gene_symbol_current":"RECK","gene_id":"ENSG00000122707","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.00016869,"nucleus_log2fc":0.142406,"nucleus_score":4.06647,"pct_ad":0.416992,"pct_control":0.391359,"donor_test":"not significant","donor_padj":0.848715,"donor_log2fc":0.0744931,"donor_lfcse":0.099923,"donor_log2fc_shrunk":0.0136905,"degas_log2fc":0.223622,"degas_padj":9.7247e-10},{"cell_type":"OPC","gene_symbol":"RECK","gene_symbol_current":"RECK","gene_id":"ENSG00000122707","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.617673,"nucleus_log2fc":0.0336225,"nucleus_score":0.729112,"pct_ad":0.51521,"pct_control":0.509568,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0402119,"donor_lfcse":0.0654415,"donor_log2fc_shrunk":9.78355e-06,"degas_log2fc":-0.153567,"degas_padj":5.07651e-05},{"cell_type":"Oli","gene_symbol":"RECK","gene_symbol_current":"RECK","gene_id":"ENSG00000122707","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0012979,"nucleus_log2fc":-0.0499793,"nucleus_score":-3.35925,"pct_ad":0.444409,"pct_control":0.45979,"donor_test":"not significant","donor_padj":0.885609,"donor_log2fc":-0.0697953,"donor_lfcse":0.0851403,"donor_log2fc_shrunk":-0.0096805,"degas_log2fc":-0.15919,"degas_padj":8.7084e-20}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000122707","module":"blue","kme":0.225639,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000122707","module":"tan","kme":0.265053,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000122707","entrez_id":["8434"],"uniprot":["O95980"],"ncbi_summary":"The protein encoded by this gene is a cysteine-rich, extracellular protein with protease inhibitor-like domains whose expression is suppressed strongly in many tumors and cells transformed by various kinds of oncogenes. In normal cells, this membrane-anchored glycoprotein may serve as a negative regulator for matrix metalloproteinase-9, a key enzyme involved in tumor invasion and metastasis. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Oct 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95980","text":"Functions together with ADGRA2 to enable brain endothelial cells to selectively respond to Wnt7 signals (WNT7A or WNT7B) (PubMed:28289266, PubMed:30026314). Plays a key role in Wnt7-specific responses: required for central nervous system (CNS) angiogenesis and blood-brain barrier regulation (By similarity). Acts as a Wnt7-specific coactivator of canonical Wnt signaling by decoding Wnt ligands: acts by interacting specifically with the disordered linker region of Wnt7, thereby conferring ligand selectivity for Wnt7 (PubMed:30026314). ADGRA2 is then required to deliver RECK-bound Wnt7 to frizzled by assembling a higher-order RECK-ADGRA2-Fzd-LRP5-LRP6 complex (PubMed:30026314). Also acts as a serine protease inhibitor: negatively regulates matrix metalloproteinase-9 (MMP9) by suppressing MMP9 secretion and by direct inhibition of its enzymatic activity (PubMed:18194466, PubMed:9789069). Also inhibits metalloproteinase activity of MMP2, MMP14 (MT1-MMP) and ADAM10 (PubMed:9789069, PubMed:33731436)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}