ol":"BTNL2","gene_symbol_current":"BTNL2","gene_id":"ENSG00000204290","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.664928,"donor_log2fc":-0.785628,"donor_lfcse":0.328266,"donor_log2fc_shrunk":-0.00357793}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000204290","entrez_id":["56244"],"uniprot":["Q9UIR0"],"ncbi_summary":"This gene encodes a major histocompatibility complex, class II associated, type I transmembrane protein which belongs to the butyrophilin-like B7 family of immunoregulators. It is thought to be involved in immune surveillance, serving as a negative T-cell regulator by decreasing T-cell proliferation and cytokine release. The encoded protein contains an N-terminal signal peptide, two pairs of immunoglobulin-like domains, separated by a heptad peptide sequence, and a C-terminal transmembrane domain. Naturally occurring mutations in this gene are associated with sarcoidosis, rheumatoid arthritis, ulcerative colitis, inflammatory bowel disease, myositis, type 1 diabetes, systemic lupus erythematosus, acute coronary syndrome, and prostate cancer. [provided by RefSeq, May 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UIR0","text":"Negative regulator of T-cell proliferation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}