current":"ATP6V1H","gene_id":"ENSG00000047249","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0854742,"nucleus_log2fc":-0.0858189,"nucleus_score":-2.15684,"pct_ad":0.479571,"pct_control":0.496528,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.085549,"donor_lfcse":0.0736077,"donor_log2fc_shrunk":-1.64401e-05,"degas_log2fc":-0.321466,"degas_padj":4.0446e-17},{"cell_type":"Oli","gene_symbol":"ATP6V1H","gene_symbol_current":"ATP6V1H","gene_id":"ENSG00000047249","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.64863e-07,"nucleus_log2fc":-0.0927395,"nucleus_score":-5.30397,"pct_ad":0.328808,"pct_control":0.348629,"donor_test":"not significant","donor_padj":0.824887,"donor_log2fc":-0.06966,"donor_lfcse":0.0620091,"donor_log2fc_shrunk":-0.0172196,"degas_log2fc":-0.186487,"degas_padj":4.42197e-20}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000047249","module":"blue","kme":0.519955,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000047249","entrez_id":["51606"],"uniprot":["Q9UI12"],"ncbi_summary":"This gene encodes a component of vacuolar ATPase (V-ATPase), a multisubunit enzyme that mediates acidification of intracellular organelles. V-ATPase-dependent organelle acidification is necessary for multiple processes including protein sorting, zymogen activation, receptor-mediated endocytosis, and synaptic vesicle proton gradient generation. The encoded protein is the regulatory H subunit of the V1 domain of V-ATPase, which is required for catalysis of ATP but not the assembly of V-ATPase. Decreased expression of this gene may play a role in the development of type 2 diabetes. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene. [provided by RefSeq, May 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UI12","text":"Subunit of the V1 complex of vacuolar(H+)-ATPase (V-ATPase), a multisubunit enzyme composed of a peripheral complex (V1) that hydrolyzes ATP and a membrane integral complex (V0) that translocates protons (PubMed:33065002). V-ATPase is responsible for acidifying and maintaining the pH of intracellular compartments and in some cell types, is targeted to the plasma membrane, where it promotes acidification of the extracellular environment (By similarity). The V-ATPase complex also acts as an activator for mTORC1 on lysosomal membrane by promoting the guanine nucleotide exchange factor (GEF) of the Ragulator complex, thereby enabling mTORC1 recruitment (PubMed:22053050). Subunit H is essential for V-ATPase activity, but not for the assembly of the complex (By similarity). Involved in the endocytosis mediated by clathrin-coated pits, required for the formation of endosomes (PubMed:12032142)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}