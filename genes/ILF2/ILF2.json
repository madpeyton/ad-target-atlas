_control":null,"donor_test":"not significant","donor_padj":0.915085,"donor_log2fc":0.130688,"donor_lfcse":0.202509,"donor_log2fc_shrunk":0.00301585}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000143621","module":"turquoise","kme":0.284672,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000143621","module":"turquoise","kme":0.263268,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000143621","module":"turquoise","kme":0.126641,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000143621","entrez_id":["3608"],"uniprot":["Q12905"],"ncbi_summary":"The protein encoded by this gene is a transcription factor required for T-cell expression of the interleukin 2 gene. It also binds RNA and is an essential component for encapsidation and protein priming of hepatitis B viral polymerase. The encoded 45 kDa protein (NF45, ILF2) forms a complex with the 90 kDa interleukin enhancer-binding factor 3 (NF90, ILF3), and this complex has been shown to affect the redistribution of nuclear mRNA to the cytoplasm, to repair DNA breaks by nonhomologous end joining, and to negatively regulate the microRNA processing pathway. Knockdown of NF45 or NF90 protein retards cell growth, possibly by inhibition of mRNA stabilization. Alternative splicing results in multiple transcript variants. Related pseudogenes have been found on chromosomes 3 and 14. [provided by RefSeq, Dec 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q12905","text":"Chromatin-interacting protein that forms a stable heterodimer with interleukin enhancer-binding factor 3/ILF3 and plays a role in several biological processes including transcription, innate immunity or cell growth (PubMed:18458058, PubMed:31212927). Essential for the efficient reshuttling of ILF3 (isoform 1 and isoform 2) into the nucleus. Together with ILF3, forms an RNA-binding complex that is required for mitotic progression and cytokinesis by regulating the expression of a cluster of mitotic genes. Mechanistically, competes with STAU1/STAU2-mediated mRNA decay (PubMed:32433969). Also plays a role in the inhibition of various viruses including Japanese encephalitis virus or enterovirus 71. (Microbial infection) Plays a positive role in HIV-1 virus production by binding to and thereby stabilizing HIV-1 RNA, together with ILF3."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}