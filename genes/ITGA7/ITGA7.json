re":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.979945,"donor_log2fc":-0.0317056,"donor_lfcse":0.210944,"donor_log2fc_shrunk":-0.00149794,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"ITGA7","gene_symbol_current":"ITGA7","gene_id":"ENSG00000135424","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000129166,"nucleus_log2fc":-0.308021,"nucleus_score":-4.33161,"pct_ad":0.0921563,"pct_control":0.116003,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.346266,"donor_lfcse":0.194824,"donor_log2fc_shrunk":-9.22913e-06,"degas_log2fc":0.307453,"degas_padj":0.000750032},{"cell_type":"Oli","gene_symbol":"ITGA7","gene_symbol_current":"ITGA7","gene_id":"ENSG00000135424","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.983765,"donor_log2fc":-0.0191579,"donor_lfcse":0.134993,"donor_log2fc_shrunk":-0.00108236,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000135424","module":"turquoise","kme":0.100594,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000135424","module":"blue","kme":0.264402,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000135424","module":"turquoise","kme":0.00851983,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000135424","entrez_id":["3679"],"uniprot":["Q13683"],"ncbi_summary":"The protein encoded by this gene belongs to the integrin alpha chain family. Integrins are heterodimeric integral membrane proteins composed of an alpha chain and a beta chain. They mediate a wide spectrum of cell-cell and cell-matrix interactions, and thus play a role in cell migration, morphologic development, differentiation, and metastasis. This protein functions as a receptor for the basement membrane protein laminin-1. It is mainly expressed in skeletal and cardiac muscles and may be involved in differentiation and migration processes during myogenesis. Defects in this gene are associated with congenital myopathy. Alternatively spliced transcript variants encoding different isoforms have been noted for this gene. [provided by RefSeq, Feb 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13683","text":"Integrin alpha-7/beta-1 is the primary laminin receptor on skeletal myoblasts and adult myofibers. During myogenic differentiation, it may induce changes in the shape and mobility of myoblasts, and facilitate their localization at laminin-rich sites of secondary fiber formation. It is involved in the maintenance of the myofibers cytoarchitecture as well as for their anchorage, viability and functional integrity. Isoform Alpha-7X2B and isoform Alpha-7X1B promote myoblast migration on laminin 1 and laminin 2/4, but isoform Alpha-7X1B is less active on laminin 1 (In vitro). Acts as a Schwann cell receptor for laminin-2. Acts as a receptor of COMP and mediates its effect on vascular smooth muscle cells (VSMCs) maturation (By similarity). Required to promote contractile phenotype acquisition in differentiated airway smooth muscle (ASM) cells."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}