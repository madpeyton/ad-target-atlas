og2fc":0.133124,"nucleus_score":0.701414,"pct_ad":0.211146,"pct_control":0.205364,"donor_test":"not significant","donor_padj":0.984213,"donor_log2fc":0.150641,"donor_lfcse":0.151173,"donor_log2fc_shrunk":0.00134315},{"cell_type":"Oli","gene_symbol":"GATM","gene_symbol_current":"GATM","gene_id":"ENSG00000171766","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.145374,"nucleus_log2fc":0.0803355,"nucleus_score":1.74406,"pct_ad":0.154375,"pct_control":0.143615,"donor_test":"not significant","donor_padj":0.984481,"donor_log2fc":-0.0112472,"donor_lfcse":0.093913,"donor_log2fc_shrunk":-0.00115264}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000171766","module":"turquoise","kme":0.175054,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000171766","module":"turquoise","kme":0.155859,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000171766","entrez_id":["2628"],"uniprot":["P50440"],"ncbi_summary":"This gene encodes a mitochondrial enzyme that belongs to the amidinotransferase family. This enzyme is involved in creatine biosynthesis, whereby it catalyzes the transfer of a guanido group from L-arginine to glycine, resulting in guanidinoacetic acid, the immediate precursor of creatine. Mutations in this gene cause arginine:glycine amidinotransferase deficiency, an inborn error of creatine synthesis characterized by cognitive disability, language impairment, and behavioral disorders. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P50440","text":"Transamidinase that catalyzes the transfer of the amidino group of L-arginine onto the amino moiety of acceptor metabolites such as glycine, beta-alanine, gamma-aminobutyric acid (GABA) and taurine yielding the corresponding guanidine derivatives (PubMed:16820567, PubMed:27233232, PubMed:36543883, PubMed:3800397). Catalyzes the rate-limiting step of creatine biosynthesis, namely the transfer of the amidino group from L-arginine to glycine to generate guanidinoacetate, which is then methylated by GAMT to form creatine. Provides creatine as a source for ATP generation in tissues with high energy demands, in particular skeletal muscle, heart and brain (Probable) (PubMed:27233232, PubMed:36543883, PubMed:3800397, PubMed:9266688)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}