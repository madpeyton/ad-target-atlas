"nucleus_score":0.925378,"pct_ad":0.126442,"pct_control":0.116713,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0716072,"donor_lfcse":0.154162,"donor_log2fc_shrunk":3.14271e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000137806","module":"turquoise","kme":0.113749,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000137806","entrez_id":["51103"],"uniprot":["Q9Y375"],"ncbi_summary":"This gene encodes a complex I assembly factor protein. Complex I (NADH-ubiquinone oxidoreductase) catalyzes the transfer of electrons from NADH to ubiquinone (coenzyme Q) in the first step of the mitochondrial respiratory chain, resulting in the translocation of protons across the inner mitochondrial membrane. The encoded protein is required for assembly of complex I, and mutations in this gene are a cause of mitochondrial complex I deficiency. Alternatively spliced transcript variants have been observed for this gene, and a pseudogene of this gene is located on the long arm of chromosome 19. [provided by RefSeq, Dec 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y375","text":"As part of the MCIA complex, involved in the assembly of the mitochondrial complex I."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}