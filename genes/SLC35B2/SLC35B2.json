0.133701,"donor_lfcse":0.151816,"donor_log2fc_shrunk":5.31417e-06},{"cell_type":"Oli","gene_symbol":"SLC35B2","gene_symbol_current":"SLC35B2","gene_id":"ENSG00000157593","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.542816,"donor_log2fc":0.462753,"donor_lfcse":0.15591,"donor_log2fc_shrunk":0.306694}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000157593","entrez_id":["347734"],"uniprot":["Q8TB61"],"ncbi_summary":"Sulfotransferases (e.g., SULT4A1; MIM 608359) use an activated form of sulfate, 3-prime-phosphoadenosine 5-prime-phosphosulfate (PAPS), as a common sulfate donor for sulfation of glycoproteins, proteoglycans, and glycolipids in the endoplasmic reticulum and Golgi apparatus. SLC35B2 is located in the microsomal membrane and transports PAPS from the cytosol, where it is synthesized, into the Golgi lumen (Kamiyama et al., 2003 [PubMed 12716889]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TB61","text":"Probably functions as a 3'-phosphoadenylyl sulfate:adenosine 3',5'-bisphosphate antiporter at the Golgi membranes. Mediates the transport from the cytosol into the lumen of the Golgi of 3'-phosphoadenylyl sulfate/adenosine 3'-phospho 5'-phosphosulfate (PAPS), a universal sulfuryl donor for sulfation events that take place in that compartment."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}