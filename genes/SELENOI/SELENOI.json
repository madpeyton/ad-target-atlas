dj":0.80735,"donor_log2fc":0.042298,"donor_lfcse":0.0460599,"donor_log2fc_shrunk":0.0081523},{"cell_type":"Mic","gene_symbol":"SELENOI","gene_symbol_current":"SELENOI","gene_id":"ENSG00000138018","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.116023,"nucleus_log2fc":0.0924315,"nucleus_score":1.81408,"pct_ad":0.239183,"pct_control":0.228917,"donor_test":"not significant","donor_padj":0.932098,"donor_log2fc":0.038768,"donor_lfcse":0.0898683,"donor_log2fc_shrunk":0.00803816},{"cell_type":"OPC","gene_symbol":"SELENOI","gene_symbol_current":"SELENOI","gene_id":"ENSG00000138018","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.137611,"nucleus_log2fc":-0.0806494,"nucleus_score":-1.89724,"pct_ad":0.355801,"pct_control":0.370703,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0695034,"donor_lfcse":0.0796449,"donor_log2fc_shrunk":-1.13264e-05},{"cell_type":"Oli","gene_symbol":"SELENOI","gene_symbol_current":"SELENOI","gene_id":"ENSG00000138018","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.437181,"nucleus_log2fc":-0.000569507,"nucleus_score":-0.863319,"pct_ad":0.259337,"pct_control":0.263403,"donor_test":"not significant","donor_padj":0.948327,"donor_log2fc":0.0256985,"donor_lfcse":0.0607115,"donor_log2fc_shrunk":0.00619219}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000138018","module":"turquoise","kme":0.151711,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000138018","module":"red","kme":0.194661,"hub":false,"module_direction":"higher in AD","module_padj":0.0519952,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000138018","entrez_id":["85465"],"uniprot":["Q9C0D9"],"ncbi_summary":"The multi-pass transmembrane protein encoded by this gene belongs to the CDP-alcohol phosphatidyltransferase class-I family. It catalyzes the transfer of phosphoethanolamine from CDP-ethanolamine to diacylglycerol to produce phosphatidylethanolamine, which is involved in the formation and maintenance of vesicular membranes, regulation of lipid metabolism, and protein folding. This protein is a selenoprotein, containing the rare selenocysteine (Sec) amino acid at its active site. Sec is encoded by the UGA codon, which normally signals translation termination. The 3' UTRs of selenoprotein mRNAs contain a conserved stem-loop structure, designated the Sec insertion sequence (SECIS) element, that is necessary for the recognition of UGA as a Sec codon rather than as a stop signal. Alternatively spliced transcript variants have been found for this gene. [provided by RefSeq, Jul 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9C0D9","text":"Ethanolaminephosphotransferase that catalyzes the transfer of phosphoethanolamine (PE) from CDP-ethanolamine to lipid acceptors, the final step in the synthesis of PE via the 'Kennedy' pathway (PubMed:17132865, PubMed:28052917, PubMed:29500230). PE is the second most abundant phospholipid of membranes in mammals and is involved in various membrane-related cellular processes (PubMed:17132865). The enzyme is critical for the synthesis of several PE species and also catalyzes the synthesis of plasmanyl-PE, a lipid required for proper myelination and neurodevelopment, from 1-alkyl-2-acylglycerol (PubMed:29500230)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}