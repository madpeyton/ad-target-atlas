direction":"lower in AD","nucleus_padj":0.335962,"nucleus_log2fc":-0.0927121,"nucleus_score":-1.16161,"pct_ad":0.130919,"pct_control":0.13606,"donor_test":"not significant","donor_padj":0.732365,"donor_log2fc":-0.0991657,"donor_lfcse":0.0890198,"donor_log2fc_shrunk":-0.0229597},{"cell_type":"OPC","gene_symbol":"RFT1","gene_symbol_current":"RFT1","gene_id":"ENSG00000163933","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.435805,"nucleus_log2fc":-0.0863854,"nucleus_score":-1.07407,"pct_ad":0.110945,"pct_control":0.116681,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0892905,"donor_lfcse":0.104974,"donor_log2fc_shrunk":-8.36635e-06},{"cell_type":"Oli","gene_symbol":"RFT1","gene_symbol_current":"RFT1","gene_id":"ENSG00000163933","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.82562e-05,"nucleus_log2fc":-0.155913,"nucleus_score":-4.43897,"pct_ad":0.0902972,"pct_control":0.10009,"donor_test":"not significant","donor_padj":0.553131,"donor_log2fc":-0.130199,"donor_lfcse":0.0594423,"donor_log2fc_shrunk":-0.0570932}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163933","entrez_id":["91869"],"uniprot":["Q96AA3"],"ncbi_summary":"This gene encodes an enzyme which catalyzes the translocation of the Man(5)GlcNAc (2)-PP-Dol intermediate from the cytoplasmic to the luminal side of the endoplasmic reticulum membrane in the pathway for the N-glycosylation of proteins. Mutations in this gene are associated with congenital disorder of glycosylation type In.[provided by RefSeq, Dec 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96AA3","text":"Intramembrane glycolipid transporter that operates in the biosynthetic pathway of dolichol-linked oligosaccharides, the glycan precursors employed in protein asparagine (N)-glycosylation. The sequential addition of sugars to dolichol pyrophosphate produces dolichol-linked oligosaccharides containing fourteen sugars, including two GlcNAcs, nine mannoses and three glucoses. Once assembled, the oligosaccharide is transferred from the lipid to nascent proteins by oligosaccharyltransferases. The assembly of dolichol-linked oligosaccharides begins on the cytosolic side of the endoplasmic reticulum membrane and finishes in its lumen. RFT1 could mediate the translocation of the cytosolically oriented intermediate DolPP-GlcNAc2Man5, produced by ALG11, into the ER lumen where dolichol-linked oligosaccharides assembly continues (PubMed:18313027, PubMed:19701946). However, the intramembrane lipid transporter activity could not be confirmed in vitro (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}