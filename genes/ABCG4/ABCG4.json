_score":2.16627,"pct_ad":0.121163,"pct_control":0.115398,"donor_test":"not significant","donor_padj":0.657962,"donor_log2fc":0.0468511,"donor_lfcse":0.0446232,"donor_log2fc_shrunk":0.0137739},{"cell_type":"Oligodendroglia","gene_symbol":"ABCG4","gene_symbol_current":"ABCG4","gene_id":"ENSG00000172350","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.64021,"donor_log2fc":0.0957915,"donor_lfcse":0.118931,"donor_log2fc_shrunk":0.0110334}],"modules":[{"cell_type":"CUX2-","gene_id":"ENSG00000172350","module":"turquoise","kme":0.0766807,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000172350"],"dataset_symbols":["ABCG4"],"explorer":"explorer.html?dataset=mathys2019#gene/ABCG4","cell_types":[{"cell_type":"Ex","gene_symbol":"ABCG4","gene_symbol_current":"ABCG4","gene_id":"ENSG00000172350","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.996763,"donor_log2fc":0.0146409,"donor_lfcse":0.113837,"donor_log2fc_shrunk":1.17067e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000172350","module":"turquoise","kme":0.134082,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000172350","entrez_id":["64137"],"uniprot":["Q9H172"],"ncbi_summary":"The protein encoded by this gene is a member of the ATP-binding cassette (ABC) transporter superfamily. ABC proteins transport various molecules across extra- and intra-cellular membranes. ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, White). The encoded protein is a member of the White subfamily and plays an important role in cellular cholesterol homeostasis. This protein functions as either a homodimer or as a heterodimer with another ABC subfamily protein such as ABCG1. [provided by RefSeq, Jan 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H172","text":"ATP-dependent transporter of the ATP-binding cassette (ABC) family that may be involved in the cellular efflux of sterols, in particular cholesterol and desmosterol (a cholesterol precursor), to high-density lipoprotein (HDL) (PubMed:15240127, PubMed:33141061). May play an important role in the removal of amyloid-beta peptides from brain, in a process that can be antagonized by desmosterol. However it is unclear whether ABCG4 can directly transport amyloid-beta peptides or whether peptide export may be facilitated due to changes in the membrane lipid environment (By similarity). Induces apoptosis in various cells (PubMed:27228027)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}