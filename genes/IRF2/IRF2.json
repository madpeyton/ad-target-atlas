us_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.429739,"nucleus_log2fc":-0.0471396,"nucleus_score":-1.08563,"pct_ad":0.490307,"pct_control":0.495343,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0124619,"donor_lfcse":0.105336,"donor_log2fc_shrunk":-1.15926e-06,"degas_log2fc":-0.472462,"degas_padj":1.75878e-36},{"cell_type":"Oli","gene_symbol":"IRF2","gene_symbol_current":"IRF2","gene_id":"ENSG00000168310","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.95825e-07,"nucleus_log2fc":0.104609,"nucleus_score":5.2833,"pct_ad":0.445969,"pct_control":0.434219,"donor_test":"not significant","donor_padj":0.842117,"donor_log2fc":0.10233,"donor_lfcse":0.0969223,"donor_log2fc_shrunk":0.0112625,"degas_log2fc":-0.204313,"degas_padj":1.41693e-31}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000168310","module":"yellow","kme":0.240074,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000168310","module":"blue","kme":0.196862,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000168310","entrez_id":["3660"],"uniprot":["P14316"],"ncbi_summary":"IRF2 encodes interferon regulatory factor 2, a member of the interferon regulatory transcription factor (IRF) family. IRF2 competitively inhibits the IRF1-mediated transcriptional activation of interferons alpha and beta, and presumably other genes that employ IRF1 for transcription activation. However, IRF2 also functions as a transcriptional activator of histone H4. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P14316","text":"DNA-binding transcription factor that specifically binds to the upstream regulatory region of type I interferon (IFN) and IFN-inducible genes and regulates their expression (PubMed:39013473, PubMed:7687740). Mainly acts as a transcription repressor, repressing expression (PubMed:39013473). Also acts as an activator for several genes including H4 and IL7 (PubMed:15226432, PubMed:9540062). Constitutively binds to the ISRE promoter to activate IL7 (PubMed:15226432). Involved in cell cycle regulation through binding the site II (HiNF-M) promoter region of H4 and activating transcription during cell growth (PubMed:9540062). Antagonizes IRF1 transcriptional activation (By similarity). [Isoform 2]: Unable to bind to IRF2BP1 and IRF2BP2 corepressors and cannot mediate repression."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}