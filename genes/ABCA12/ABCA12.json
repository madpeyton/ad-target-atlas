alse,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.801993,"donor_log2fc":-0.145823,"donor_lfcse":0.155295,"donor_log2fc_shrunk":-0.00298506,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"ABCA12","gene_symbol_current":"ABCA12","gene_id":"ENSG00000144452","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.367847,"donor_lfcse":0.369992,"donor_log2fc_shrunk":-2.80227e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"ABCA12","gene_symbol_current":"ABCA12","gene_id":"ENSG00000144452","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.954113,"donor_log2fc":-0.111466,"donor_lfcse":0.277952,"donor_log2fc_shrunk":-0.00160291,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000144452","module":"turquoise","kme":0.135987,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000144452","entrez_id":["26154"],"uniprot":["Q86UK0"],"ncbi_summary":"The membrane-associated protein encoded by this gene is a member of the superfamily of ATP-binding cassette (ABC) transporters. ABC proteins transport various molecules across extra- and intracellular membranes. ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, and White). This encoded protein is a member of the ABC1 subfamily, which is the only major ABC subfamily found exclusively in multicellular eukaryotes. Alternative splicing of this gene results in multiple transcript variants. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86UK0","text":"Transports lipids such as glucosylceramides from the outer to the inner leaflet of lamellar granules (LGs) membrane, whereby the lipids are finally transported to the keratinocyte periphery via the trans-Golgi network and LGs and released to the apical surface of the granular keratinocytes to form lipid lamellae in the stratum corneum of the epidermis, which is essential for skin barrier function (PubMed:16007253, PubMed:20869849). In the meantime, participates in the transport of the lamellar granules-associated proteolytic enzymes, in turn regulates desquamation and keratinocyte differentiation (PubMed:19179616). Furthermore, is essential for the regulation of cellular cholesterol homeostasis by regulating ABCA1-dependent cholesterol efflux from macrophages through interaction with NR1H2 and ABCA1 (By similarity). Plays pleiotropic roles in regulating glucose stimulated insulin secretion from beta cells, regulating the morphology and fusion of insulin granules, lipid raft abundance and the actin cytoskeleton (By similarity). Also involved in lung surfactant biogenesis (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}