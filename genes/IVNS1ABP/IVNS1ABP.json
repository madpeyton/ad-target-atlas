04,"donor_log2fc_shrunk":0.0188247}],"modules":[{"cell_type":"CUX2-","gene_id":"ENSG00000116679","module":"turquoise","kme":0.0787213,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Oligodendroglia","gene_id":"ENSG00000116679","module":"blue","kme":0.15928,"hub":false,"module_direction":"higher in AD","module_padj":0.49728,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000116679","module":"blue","kme":0.232388,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000116679"],"dataset_symbols":["IVNS1ABP"],"explorer":"explorer.html?dataset=mathys2019#gene/IVNS1ABP","cell_types":[{"cell_type":"Ex","gene_symbol":"IVNS1ABP","gene_symbol_current":"IVNS1ABP","gene_id":"ENSG00000116679","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.45347,"nucleus_log2fc":0.0158571,"nucleus_score":-0.88376,"pct_ad":0.108899,"pct_control":0.113415,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":-0.0522383,"donor_lfcse":0.108894,"donor_log2fc_shrunk":7.925e-06},{"cell_type":"Oli","gene_symbol":"IVNS1ABP","gene_symbol_current":"IVNS1ABP","gene_id":"ENSG00000116679","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.868589,"donor_log2fc":0.11917,"donor_lfcse":0.128145,"donor_log2fc_shrunk":0.00686737}],"modules":[{"cell_type":"In","gene_id":"ENSG00000116679","module":"turquoise","kme":0.126908,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000116679","entrez_id":["10625"],"uniprot":["Q9Y6Y0"],"ncbi_summary":"Involved in RNA splicing; negative regulation of protein ubiquitination; and response to virus. Located in cytosol. Implicated in immunodeficiency 70. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y6Y0","text":"Involved in many cell functions, including pre-mRNA splicing, the aryl hydrocarbon receptor (AHR) pathway, F-actin organization and protein ubiquitination. Plays a role in the dynamic organization of the actin skeleton as a stabilizer of actin filaments by association with F-actin through Kelch repeats (By similarity). Protects cells from cell death induced by actin destabilization (By similarity). Functions as modifier of the AHR/Aryl hydrocarbon receptor pathway increasing the concentration of AHR available to activate transcription (PubMed:16582008). In addition, functions as a negative regulator of BCR(KLHL20) E3 ubiquitin ligase complex to prevent ubiquitin-mediated proteolysis of PML and DAPK1, two tumor suppressors (PubMed:25619834). Inhibits pre-mRNA splicing (in vitro) (PubMed:9696811). May play a role in mRNA nuclear export (PubMed:30538201). (Microbial infection) Involved in the alternative splicing of influenza A virus M1 mRNA through interaction with HNRNPK, thereby facilitating the generation of viral M2 protein (PubMed:23825951, PubMed:9696811). The BTB and Kelch domains are required for splicing activity (PubMed:30538201). Promotes export of viral M mRNA and RNP via its interaction with mRNA export factor ALYREF (PubMed:30538201)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}