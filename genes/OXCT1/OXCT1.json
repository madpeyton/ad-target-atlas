.993904,"donor_log2fc":0.0037296,"donor_lfcse":0.0728647,"donor_log2fc_shrunk":0.00061951}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000083720","module":"brown","kme":0.129161,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000083720","entrez_id":["5019"],"uniprot":["P55809"],"ncbi_summary":"This gene encodes a member of the 3-oxoacid CoA-transferase gene family. The encoded protein is a homodimeric mitochondrial matrix enzyme that plays a central role in extrahepatic ketone body catabolism by catalyzing the reversible transfer of coenzyme A from succinyl-CoA to acetoacetate. Mutations in this gene are associated with succinyl CoA:3-oxoacid CoA transferase deficiency. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P55809","text":"Key enzyme for ketone body catabolism. Catalyzes the first, rate-limiting step of ketone body utilization in extrahepatic tissues, by transferring coenzyme A (CoA) from a donor thiolester species (succinyl-CoA) to an acceptor carboxylate (acetoacetate), and produces acetoacetyl-CoA. Acetoacetyl-CoA is further metabolized by acetoacetyl-CoA thiolase into two acetyl-CoA molecules which enter the citric acid cycle for energy production (PubMed:10964512). Forms a dimeric enzyme where both of the subunits are able to form enzyme-CoA thiolester intermediates, but only one subunit is competent to transfer the CoA moiety to the acceptor carboxylate (3-oxo acid) and produce a new acyl-CoA. Formation of the enzyme-CoA intermediate proceeds via an unstable anhydride species formed between the carboxylate groups of the enzyme and substrate (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}