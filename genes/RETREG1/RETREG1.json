rection":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000154153","module":"yellow","kme":0.539488,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000154153","module":"turquoise","kme":0.144533,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000154153","module":"blue","kme":0.248606,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000154153","module":"blue","kme":0.188592,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000154153","entrez_id":["54463"],"uniprot":["Q9H6L5"],"ncbi_summary":"The protein encoded by this gene is a cis-Golgi transmembrane protein that may be necessary for the long-term survival of nociceptive and autonomic ganglion neurons. Mutations in this gene are a cause of hereditary sensory and autonomic neuropathy type IIB (HSAN IIB), and this gene may also play a role in susceptibility to vascular dementia. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene. [provided by RefSeq, Nov 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H6L5","text":"Endoplasmic reticulum (ER)-anchored autophagy regulator which mediates ER delivery into lysosomes through sequestration into autophagosomes (PubMed:26040720, PubMed:31930741, PubMed:34338405). Promotes membrane remodeling and ER scission via its membrane bending capacity and targets the fragments into autophagosomes via interaction with ATG8 family proteins (PubMed:26040720, PubMed:31930741, PubMed:34338405). Active under basal conditions (PubMed:34338405). Required for collagen quality control in a LIR motif-dependent manner (By similarity). Required for long-term survival of nociceptive and autonomic ganglion neurons (PubMed:19838196, PubMed:26040720). (Microbial infection) During SARS-CoV-2 infection, RETREG1-mediated reticulophagy is promoted by SARS-CoV-2 ORF3A protein (PubMed:35239449). This induces endoplasmic reticulum stress and inflammatory responses and facilitates viral infection (PubMed:35239449)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}