019","gene_ids":["ENSG00000159921"],"dataset_symbols":["GNE"],"explorer":"explorer.html?dataset=mathys2019#gene/GNE","cell_types":[{"cell_type":"Ex","gene_symbol":"GNE","gene_symbol_current":"GNE","gene_id":"ENSG00000159921","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.324249,"nucleus_log2fc":0.127396,"nucleus_score":1.13946,"pct_ad":0.181837,"pct_control":0.1777,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.144506,"donor_lfcse":0.0900773,"donor_log2fc_shrunk":1.93771e-05},{"cell_type":"In","gene_symbol":"GNE","gene_symbol_current":"GNE","gene_id":"ENSG00000159921","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.654024,"nucleus_log2fc":0.161505,"nucleus_score":1.09755,"pct_ad":0.129104,"pct_control":0.119203,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.142533,"donor_lfcse":0.1342,"donor_log2fc_shrunk":-2.75708e-06},{"cell_type":"OPC","gene_symbol":"GNE","gene_symbol_current":"GNE","gene_id":"ENSG00000159921","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.39361,"nucleus_log2fc":-0.264084,"nucleus_score":-1.56391,"pct_ad":0.0863422,"pct_control":0.104981,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"GNE","gene_symbol_current":"GNE","gene_id":"ENSG00000159921","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.868589,"donor_log2fc":0.123319,"donor_lfcse":0.132653,"donor_log2fc_shrunk":0.00664691}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000159921","entrez_id":["10020"],"uniprot":["Q9Y223"],"ncbi_summary":"The protein encoded by this gene is a bifunctional enzyme that initiates and regulates the biosynthesis of N-acetylneuraminic acid (NeuAc), a precursor of sialic acids. It is a rate-limiting enzyme in the sialic acid biosynthetic pathway. Sialic acid modification of cell surface molecules is crucial for their function in many biologic processes, including cell adhesion and signal transduction. Differential sialylation of cell surface molecules is also implicated in the tumorigenicity and metastatic behavior of malignant cells. Mutations in this gene are associated with sialuria, autosomal recessive inclusion body myopathy, and Nonaka myopathy. Alternative splicing of this gene results in transcript variants encoding different isoforms. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y223","text":"Bifunctional enzyme that possesses both UDP-N-acetylglucosamine 2-epimerase and N-acetylmannosamine kinase activities, and serves as the initiator of the biosynthetic pathway leading to the production of N-acetylneuraminic acid (NeuAc), a critical precursor in the synthesis of sialic acids. By catalyzing this pivotal and rate-limiting step in sialic acid biosynthesis, this enzyme assumes a pivotal role in governing the regulation of cell surface sialylation, playing a role in embryonic angiogenesis (PubMed:10334995, PubMed:11326336, PubMed:14707127, PubMed:16503651, PubMed:2808337, PubMed:38237079). Sialic acids represent a category of negatively charged sugars that reside on the surface of cells as terminal components of glycoconjugates and mediate important functions in various cellular processes, including cell adhesion, signal transduction, and cellular recognition (PubMed:10334995, PubMed:14707127)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}