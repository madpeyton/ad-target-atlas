nor_padj":0.73713,"donor_log2fc":0.0921851,"donor_lfcse":0.0605974,"donor_log2fc_shrunk":0.0120166,"degas_log2fc":0.0187238,"degas_padj":0.005471},{"cell_type":"Mic","gene_symbol":"TAX1BP1","gene_symbol_current":"TAX1BP1","gene_id":"ENSG00000106052","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.347827,"nucleus_log2fc":0.0400798,"nucleus_score":1.13514,"pct_ad":0.508078,"pct_control":0.502189,"donor_test":"not significant","donor_padj":0.925615,"donor_log2fc":0.037934,"donor_lfcse":0.0822622,"donor_log2fc_shrunk":0.0093788,"degas_log2fc":0.271012,"degas_padj":1.76942e-17},{"cell_type":"OPC","gene_symbol":"TAX1BP1","gene_symbol_current":"TAX1BP1","gene_id":"ENSG00000106052","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0564549,"nucleus_log2fc":0.0771218,"nucleus_score":2.35999,"pct_ad":0.604235,"pct_control":0.58713,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.066158,"donor_lfcse":0.0671809,"donor_log2fc_shrunk":1.5191e-05,"degas_log2fc":-0.235445,"degas_padj":2.09365e-12},{"cell_type":"Oli","gene_symbol":"TAX1BP1","gene_symbol_current":"TAX1BP1","gene_id":"ENSG00000106052","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":6.48383e-06,"nucleus_log2fc":0.0868945,"nucleus_score":4.66519,"pct_ad":0.482798,"pct_control":0.47457,"donor_test":"not significant","donor_padj":0.634306,"donor_log2fc":0.116941,"donor_lfcse":0.0615101,"donor_log2fc_shrunk":0.0337609,"degas_log2fc":-0.153186,"degas_padj":4.70734e-20}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000106052","entrez_id":["8887"],"uniprot":["Q86VP1"],"ncbi_summary":"This gene encodes a HTLV-1 tax1 binding protein. The encoded protein interacts with TNFAIP3, and inhibits TNF-induced apoptosis by mediating the TNFAIP3 anti-apoptotic activity. Degradation of this protein by caspase-3-like family proteins is associated with apoptosis induced by TNF. This protein may also have a role in the inhibition of inflammatory signaling pathways. Alternatively spliced transcript variants encoding different isoforms have been found for this gene.[provided by RefSeq, May 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86VP1","text":"Ubiquitin-binding adapter that participates in inflammatory, antiviral and innate immune processes as well as selective autophagy regulation (PubMed:29940186, PubMed:30459273, PubMed:30909570). Plays a key role in the negative regulation of NF-kappa-B and IRF3 signalings by acting as an adapter for the ubiquitin-editing enzyme A20/TNFAIP3 to bind and inactivate its substrates (PubMed:17703191). Disrupts the interactions between the E3 ubiquitin ligase TRAF3 and TBK1/IKBKE to attenuate 'Lys63'-linked polyubiquitination of TBK1 and thereby IFN-beta production (PubMed:21885437). Also recruits A20/TNFAIP3 to ubiquitinated signaling proteins TRAF6 and RIPK1, leading to their deubiquitination and disruption of IL-1 and TNF-induced NF-kappa-B signaling pathways (PubMed:17703191). Inhibits virus-induced apoptosis by inducing the 'Lys-48'-linked polyubiquitination and degradation of MAVS via recruitment of the E3 ligase ITCH, thereby attenuating MAVS-mediated apoptosis signaling (PubMed:27736772). As a macroautophagy/autophagy receptor, facilitates the xenophagic clearance of pathogenic bacteria such as Salmonella typhimurium and Mycobacterium tuberculosis (PubMed:26451915). Upon NBR1 recruitment to the SQSTM1-ubiquitin condensates, acts as the major recruiter of RB1CC1 to these ubiquitin condensates to promote their autophagic degradation (PubMed:33226137, PubMed:34471133). Mediates the autophagic degradation of other substrates including TICAM1 (PubMed:28898289)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}