,"gene_symbol_current":"TAX1BP1","gene_id":"ENSG00000106052","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.921881,"nucleus_log2fc":-0.0527319,"nucleus_score":-0.2645,"pct_ad":0.129151,"pct_control":0.133583,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"TAX1BP1","gene_symbol_current":"TAX1BP1","gene_id":"ENSG00000106052","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.876429,"nucleus_log2fc":-0.0552963,"nucleus_score":-0.374082,"pct_ad":0.251962,"pct_control":0.257471,"donor_test":"not significant","donor_padj":0.993604,"donor_log2fc":0.0410666,"donor_lfcse":0.145502,"donor_log2fc_shrunk":0.000345},{"cell_type":"Oli","gene_symbol":"TAX1BP1","gene_symbol_current":"TAX1BP1","gene_id":"ENSG00000106052","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":6.07635e-05,"nucleus_log2fc":0.274747,"nucleus_score":4.41858,"pct_ad":0.146155,"pct_control":0.123554,"donor_test":"not significant","donor_padj":0.708624,"donor_log2fc":0.184308,"donor_lfcse":0.0764559,"donor_log2fc_shrunk":0.056147}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000106052","module":"turquoise","kme":0.293431,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000106052","module":"turquoise","kme":0.306968,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000106052","module":"turquoise","kme":0.194421,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000106052","entrez_id":["8887"],"uniprot":["Q86VP1"],"ncbi_summary":"This gene encodes a HTLV-1 tax1 binding protein. The encoded protein interacts with TNFAIP3, and inhibits TNF-induced apoptosis by mediating the TNFAIP3 anti-apoptotic activity. Degradation of this protein by caspase-3-like family proteins is associated with apoptosis induced by TNF. This protein may also have a role in the inhibition of inflammatory signaling pathways. Alternatively spliced transcript variants encoding different isoforms have been found for this gene.[provided by RefSeq, May 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86VP1","text":"Ubiquitin-binding adapter that participates in inflammatory, antiviral and innate immune processes as well as selective autophagy regulation (PubMed:29940186, PubMed:30459273, PubMed:30909570). Plays a key role in the negative regulation of NF-kappa-B and IRF3 signalings by acting as an adapter for the ubiquitin-editing enzyme A20/TNFAIP3 to bind and inactivate its substrates (PubMed:17703191). Disrupts the interactions between the E3 ubiquitin ligase TRAF3 and TBK1/IKBKE to attenuate 'Lys63'-linked polyubiquitination of TBK1 and thereby IFN-beta production (PubMed:21885437). Also recruits A20/TNFAIP3 to ubiquitinated signaling proteins TRAF6 and RIPK1, leading to their deubiquitination and disruption of IL-1 and TNF-induced NF-kappa-B signaling pathways (PubMed:17703191). Inhibits virus-induced apoptosis by inducing the 'Lys-48'-linked polyubiquitination and degradation of MAVS via recruitment of the E3 ligase ITCH, thereby attenuating MAVS-mediated apoptosis signaling (PubMed:27736772). As a macroautophagy/autophagy receptor, facilitates the xenophagic clearance of pathogenic bacteria such as Salmonella typhimurium and Mycobacterium tuberculosis (PubMed:26451915). Upon NBR1 recruitment to the SQSTM1-ubiquitin condensates, acts as the major recruiter of RB1CC1 to these ubiquitin condensates to promote their autophagic degradation (PubMed:33226137, PubMed:34471133). Mediates the autophagic degradation of other substrates including TICAM1 (PubMed:28898289)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}