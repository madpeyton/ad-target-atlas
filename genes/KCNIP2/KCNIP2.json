odule_padj":0.396297,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000120049","module":"turquoise","kme":0.147405,"hub":false,"module_direction":"higher in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000120049"],"dataset_symbols":["KCNIP2"],"explorer":"explorer.html?dataset=mathys2019#gene/KCNIP2","cell_types":[{"cell_type":"Ex","gene_symbol":"KCNIP2","gene_symbol_current":"KCNIP2","gene_id":"ENSG00000120049","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.50466,"nucleus_log2fc":0.0983214,"nucleus_score":0.791505,"pct_ad":0.245733,"pct_control":0.245175,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.178129,"donor_lfcse":0.153921,"donor_log2fc_shrunk":7.70071e-06},{"cell_type":"In","gene_symbol":"KCNIP2","gene_symbol_current":"KCNIP2","gene_id":"ENSG00000120049","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.763664,"nucleus_log2fc":0.0452392,"nucleus_score":0.783024,"pct_ad":0.251109,"pct_control":0.237784,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0134703,"donor_lfcse":0.116729,"donor_log2fc_shrunk":1.03345e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000120049","module":"blue","kme":0.280002,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000120049","module":"brown","kme":0.322533,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000120049","entrez_id":["30819"],"uniprot":["Q9NS61"],"ncbi_summary":"This gene encodes a member of the family of voltage-gated potassium (Kv) channel-interacting proteins (KCNIPs), which belongs to the recoverin branch of the EF-hand superfamily. Members of the KCNIP family are small calcium binding proteins. They all have EF-hand-like domains, and differ from each other in the N-terminus. They are integral subunit components of native Kv4 channel complexes. They may regulate A-type currents, and hence neuronal excitability, in response to changes in intracellular calcium. Multiple alternatively spliced transcript variants encoding distinct isoforms have been identified from this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NS61","text":"Regulatory subunit of Kv4/D (Shal)-type voltage-gated rapidly inactivating A-type potassium channels (PubMed:10676964, PubMed:11287421, PubMed:11684073, PubMed:12297301, PubMed:14623880, PubMed:34997220). Modulates channel density, inactivation kinetics and rate of recovery from inactivation in a calcium-dependent and isoform-specific manner (PubMed:10676964, PubMed:11287421, PubMed:11684073, PubMed:12297301, PubMed:14623880, PubMed:34997220). Involved in KCND2 and KCND3 trafficking to the cell surface (PubMed:12829703). May be required for the expression of I(To) currents in the heart (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}