gas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000275832","entrez_id":["57636"],"uniprot":["Q9P227"],"ncbi_summary":"The RHO (see ARHA; MIM 165390) family of small GTPases are involved in signal transduction through transmembrane receptors, and they are inactive in the GDP-bound form and active in the GTP-bound form. GTPase-activating proteins, such as ARHGAP23, inactivate RHO family proteins by stimulating their hydrolysis of GTP (Katoh and Katoh, 2004 [PubMed 15254754]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9P227","text":"GTPase activator for the Rho-type GTPases by converting them to an inactive GDP-bound state."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}