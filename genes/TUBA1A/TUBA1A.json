ested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":7.78503e-51,"nucleus_log2fc":-0.206053,"nucleus_score":-15.1567,"pct_ad":0.673272,"pct_control":0.719568,"donor_test":"not significant","donor_padj":0.986213,"donor_log2fc":0.019949,"donor_lfcse":0.185036,"donor_log2fc_shrunk":0.000653815,"degas_log2fc":0.380713,"degas_padj":7.24873e-157}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000167552","module":"turquoise","kme":0.204863,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000167552","module":"brown","kme":0.566614,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000167552","module":"brown","kme":0.539645,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000167552","module":"turquoise","kme":0.0238921,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000167552","module":"turquoise","kme":0.29131,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000167552","module":"turquoise","kme":0.512057,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000167552","entrez_id":["7846"],"uniprot":["Q71U36"],"ncbi_summary":"Microtubules of the eukaryotic cytoskeleton perform essential and diverse functions and are composed of a heterodimer of alpha and beta tubulins. The genes encoding these microtubule constituents belong to the tubulin superfamily, which is composed of six distinct families. Genes from the alpha, beta and gamma tubulin families are found in all eukaryotes. The alpha and beta tubulins represent the major components of microtubules, while gamma tubulin plays a critical role in the nucleation of microtubule assembly. There are multiple alpha and beta tubulin genes, which are highly conserved among species. This gene encodes alpha tubulin and is highly similar to the mouse and rat Tuba1 genes. Northern blot studies have shown that the gene expression is predominantly found in morphologically differentiated neurologic cells. This gene is one of three alpha-tubulin genes in a cluster on chromosome 12q. Mutations in this gene cause lissencephaly type 3 (LIS3) - a neurological condition characterized by microcephaly, intellectual disability, and early-onset epilepsy caused by defective neuronal migration. Alternative splicing results in multiple transcript variants encoding distinct isoforms. [provided by RefSeq, Jul 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q71U36","text":"Tubulin is the major constituent of microtubules, a cylinder consisting of laterally associated linear protofilaments composed of alpha- and beta-tubulin heterodimers. Microtubules grow by the addition of GTP-tubulin dimers to the microtubule end, where a stabilizing cap forms. Below the cap, tubulin dimers are in GDP-bound state, owing to GTPase activity of alpha-tubulin."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}