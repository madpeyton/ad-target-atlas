 AD","nucleus_padj":0.0817368,"nucleus_log2fc":0.315095,"nucleus_score":2.63499,"pct_ad":0.720787,"pct_control":0.67166,"donor_test":"not significant","donor_padj":0.807697,"donor_log2fc":0.16571,"donor_lfcse":0.14026,"donor_log2fc_shrunk":0.0103662}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000107099","entrez_id":["81704"],"uniprot":["Q8NF50"],"ncbi_summary":"This gene encodes a member of the DOCK180 family of guanine nucleotide exchange factors. Guanine nucleotide exchange factors interact with Rho GTPases and are components of intracellular signaling networks. Mutations in this gene result in the autosomal recessive form of the hyper-IgE syndrome. Alternatively spliced transcript variants encoding different isoforms have been described.[provided by RefSeq, Jun 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8NF50","text":"Guanine nucleotide exchange factor (GEF) which specifically activates small GTPase CDC42 by exchanging bound GDP for free GTP (PubMed:22461490, PubMed:28028151). During immune responses, required for interstitial dendritic cell (DC) migration by locally activating CDC42 at the leading edge membrane of DC (By similarity). Required for CD4(+) T-cell migration in response to chemokine stimulation by promoting CDC42 activation at T cell leading edge membrane (PubMed:28028151). Is involved in NK cell cytotoxicity by controlling polarization of microtubule-organizing center (MTOC), and possibly regulating CCDC88B-mediated lytic granule transport to MTOC during cell killing (PubMed:25762780)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}