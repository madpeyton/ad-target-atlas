null,"donor_test":"significant","donor_padj":0.0312593,"donor_log2fc":0.228832,"donor_lfcse":0.0667983,"donor_log2fc_shrunk":0.183568},{"cell_type":"Inhibitory","gene_symbol":"BMP1","gene_symbol_current":"BMP1","gene_id":"ENSG00000168487","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.0934064,"donor_log2fc":0.195031,"donor_lfcse":0.0657384,"donor_log2fc_shrunk":0.136544},{"cell_type":"Oligodendroglia","gene_symbol":"BMP1","gene_symbol_current":"BMP1","gene_id":"ENSG00000168487","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.29123,"donor_log2fc":0.0937174,"donor_lfcse":0.0523762,"donor_log2fc_shrunk":0.0483186}],"modules":[],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000168487"],"dataset_symbols":["BMP1"],"explorer":"explorer.html?dataset=mathys2019#gene/BMP1","cell_types":[{"cell_type":"Ex","gene_symbol":"BMP1","gene_symbol_current":"BMP1","gene_id":"ENSG00000168487","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999899,"donor_log2fc":-0.00291064,"donor_lfcse":0.162962,"donor_log2fc_shrunk":-1.08246e-07}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000168487","entrez_id":["649"],"uniprot":["P13497"],"ncbi_summary":"This gene encodes a protein that is capable of inducing formation of cartilage in vivo. Although other bone morphogenetic proteins are members of the TGF-beta superfamily, this gene encodes a protein that is not closely related to other known growth factors. This gene is expressed as alternatively spliced variants that share an N-terminal protease domain but differ in their C-terminal region. [provided by RefSeq, Aug 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P13497","text":"Metalloprotease that plays key roles in regulating the formation of the extracellular matrix (ECM) via processing of various precursor proteins into mature functional enzymes or structural proteins (PubMed:33206546). Thereby participates in several developmental and physiological processes such as cartilage and bone formation, muscle growth and homeostasis, wound healing and tissue repair (PubMed:32636307, PubMed:33169406). Roles in ECM formation include cleavage of the C-terminal propeptides from procollagens such as procollagen I, II and III or the proteolytic activation of the enzyme lysyl oxidase LOX, necessary to formation of covalent cross-links in collagen and elastic fibers (PubMed:31152061, PubMed:33206546). Additional substrates include matricellular thrombospondin-1/THBS1 whose cleavage leads to cell adhesion disruption and TGF-beta activation (PubMed:32636307). [Isoform BMP1-3]: Plays an important role in bone repair by acting as a coactivator of BMP7."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}