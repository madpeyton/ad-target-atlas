_shrunk":0.00258737}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000169714","module":"brown","kme":0.132545,"hub":false,"module_direction":"lower in AD","module_padj":0.652213,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000169714","module":"turquoise","kme":0.218668,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000169714","module":"turquoise","kme":0.253773,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000169714","module":"turquoise","kme":0.120025,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000169714","entrez_id":["7555"],"uniprot":["P62633"],"ncbi_summary":"This gene encodes a nucleic-acid binding protein with seven zinc-finger domains. The protein has a preference for binding single stranded DNA and RNA. The protein functions in cap-independent translation of ornithine decarboxylase mRNA, and may also function in sterol-mediated transcriptional regulation. A CCTG expansion from <30 repeats to 75-11000 repeats in the first intron of this gene results in myotonic dystrophy type 2. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P62633","text":"Single-stranded DNA-binding protein that preferentially binds to the sterol regulatory element (SRE) sequence 5'-GTGCGGTG-3', and thereby mediates transcriptional repression (PubMed:2562787). Has a role as transactivator of the Myc promoter (By similarity). Binds single-stranded RNA in a sequence-specific manner (By similarity). [Isoform 1]: Binds G-rich elements in target mRNA coding sequences (PubMed:28329689). Prevents G-quadruplex structure formation in vitro, suggesting a role in supporting translation by resolving stable structures on mRNAs (PubMed:28329689). [Isoform 2]: Binds to RNA. [Isoform 4]: Binds to RNA. [Isoform 5]: Binds to RNA. [Isoform 6]: Binds to RNA. [Isoform 8]: Binds to RNA."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}