donor_test":"not significant","donor_padj":0.808677,"donor_log2fc":-0.0963066,"donor_lfcse":0.110784,"donor_log2fc_shrunk":-0.0148182,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"CASP9","gene_symbol_current":"CASP9","gene_id":"ENSG00000132906","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.851453,"nucleus_log2fc":0.0251439,"nucleus_score":0.300015,"pct_ad":0.108112,"pct_control":0.10652,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0901933,"donor_lfcse":0.103007,"donor_log2fc_shrunk":-2.08912e-06,"degas_log2fc":-0.245788,"degas_padj":0.00609667},{"cell_type":"Oli","gene_symbol":"CASP9","gene_symbol_current":"CASP9","gene_id":"ENSG00000132906","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.930178,"donor_log2fc":0.0510666,"donor_lfcse":0.0915648,"donor_log2fc_shrunk":0.0061387,"degas_log2fc":-0.247082,"degas_padj":1.48946e-10}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000132906","entrez_id":["842"],"uniprot":["P55211"],"ncbi_summary":"This gene encodes a member of the cysteine-aspartic acid protease (caspase) family. Sequential activation of caspases plays a central role in the execution-phase of cell apoptosis. Caspases exist as inactive proenzymes which undergo proteolytic processing at conserved aspartic residues to produce two subunits, large and small, that dimerize to form the active enzyme. This protein can undergo autoproteolytic processing and activation by the apoptosome, a protein complex of cytochrome c and the apoptotic peptidase activating factor 1; this step is thought to be one of the earliest in the caspase activation cascade. This protein is thought to play a central role in apoptosis and to be a tumor suppressor. Alternative splicing results in multiple transcript variants. [provided by RefSeq, May 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P55211","text":"Involved in the activation cascade of caspases responsible for apoptosis execution. Binding of caspase-9 to Apaf-1 leads to activation of the protease which then cleaves and activates effector caspases caspase-3 (CASP3) or caspase-7 (CASP7). Promotes DNA damage-induced apoptosis in a ABL1/c-Abl-dependent manner. Proteolytically cleaves poly(ADP-ribose) polymerase (PARP). Cleaves BIRC6 following inhibition of BIRC6-caspase binding by DIABLO/SMAC (PubMed:36758105, PubMed:36758106). [Isoform 2]: Lacks activity is an dominant-negative inhibitor of caspase-9."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}