s_direction":"lower in AD","nucleus_padj":0.250233,"nucleus_log2fc":-0.298157,"nucleus_score":-1.98974,"pct_ad":0.117739,"pct_control":0.145594,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"TBCD","gene_symbol_current":"TBCD","gene_id":"ENSG00000141556","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.995236,"donor_log2fc":0.00346817,"donor_lfcse":0.140738,"donor_log2fc_shrunk":0.000224154}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000141556","module":"blue","kme":0.164148,"hub":false,"module_direction":"lower in AD","module_padj":0.474279,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000141556","module":"blue","kme":0.0887076,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000141556","module":"turquoise","kme":0.118635,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000141556","entrez_id":["6904"],"uniprot":["Q9BTW9"],"ncbi_summary":"Cofactor D is one of four proteins (cofactors A, D, E, and C) involved in the pathway leading to correctly folded beta-tubulin from folding intermediates. Cofactors A and D are believed to play a role in capturing and stabilizing beta-tubulin intermediates in a quasi-native confirmation. Cofactor E binds to the cofactor D/beta-tubulin complex; interaction with cofactor C then causes the release of beta-tubulin polypeptides that are committed to the native state. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BTW9","text":"Tubulin-folding protein implicated in the first step of the tubulin folding pathway and required for tubulin complex assembly. Involved in the regulation of microtubule polymerization or depolymerization, it modulates microtubule dynamics by capturing GTP-bound beta-tubulin (TUBB). Its ability to interact with beta tubulin is regulated via its interaction with ARL2. Acts as a GTPase-activating protein (GAP) for ARL2. Induces microtubule disruption in absence of ARL2. Increases degradation of beta tubulin, when overexpressed in polarized cells. Promotes epithelial cell detachment, a process antagonized by ARL2. Induces tight adherens and tight junctions disassembly at the lateral cell membrane (PubMed:10722852, PubMed:10831612, PubMed:11847227, PubMed:20740604, PubMed:27666370, PubMed:28158450). Required for correct assembly and maintenance of the mitotic spindle, and proper progression of mitosis (PubMed:27666370). Involved in neuron morphogenesis (PubMed:27666374)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}