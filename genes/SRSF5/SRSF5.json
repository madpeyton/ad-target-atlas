ub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000100650","module":"turquoise","kme":0.253802,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000100650","module":"turquoise","kme":0.211451,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100650","entrez_id":["6430"],"uniprot":["Q13243"],"ncbi_summary":"The protein encoded by this gene is a member of the serine/arginine (SR)-rich family of pre-mRNA splicing factors, which constitute part of the spliceosome. Each of these factors contains an RNA recognition motif (RRM) for binding RNA and an RS domain for binding other proteins. The RS domain is rich in serine and arginine residues and facilitates interaction between different SR splicing factors. In addition to being critical for mRNA splicing, the SR proteins have also been shown to be involved in mRNA export from the nucleus and in translation. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Feb 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13243","text":"Plays a role in constitutive splicing and can modulate the selection of alternative splice sites."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}