ucleus_score":-7.21739,"pct_ad":0.42181,"pct_control":0.440786,"donor_test":"not significant","donor_padj":0.881966,"donor_log2fc":0.0196379,"donor_lfcse":0.0352444,"donor_log2fc_shrunk":0.00462084,"degas_log2fc":0.133151,"degas_padj":4.98171e-36},{"cell_type":"Mic","gene_symbol":"SAR1B","gene_symbol_current":"SAR1B","gene_id":"ENSG00000152700","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.677494,"nucleus_log2fc":0.0462062,"nucleus_score":0.534855,"pct_ad":0.19415,"pct_control":0.192627,"donor_test":"not significant","donor_padj":0.980417,"donor_log2fc":0.0121231,"donor_lfcse":0.0846904,"donor_log2fc_shrunk":0.00283995,"degas_log2fc":-0.000707486,"degas_padj":0.99293},{"cell_type":"OPC","gene_symbol":"SAR1B","gene_symbol_current":"SAR1B","gene_id":"ENSG00000152700","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.887683,"nucleus_log2fc":0.0263325,"nucleus_score":0.227824,"pct_ad":0.306591,"pct_control":0.304996,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0525668,"donor_lfcse":0.0790905,"donor_log2fc_shrunk":8.76162e-06,"degas_log2fc":0.123387,"degas_padj":0.0174661},{"cell_type":"Oli","gene_symbol":"SAR1B","gene_symbol_current":"SAR1B","gene_id":"ENSG00000152700","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.638641,"nucleus_log2fc":0.0158027,"nucleus_score":0.531547,"pct_ad":0.32072,"pct_control":0.319405,"donor_test":"not significant","donor_padj":0.935271,"donor_log2fc":0.040788,"donor_lfcse":0.0782827,"donor_log2fc_shrunk":0.00632439,"degas_log2fc":0.0132595,"degas_padj":0.541081}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000152700","module":"turquoise","kme":0.114796,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000152700","module":"turquoise","kme":0.0874288,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000152700","module":"turquoise","kme":0.160771,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000152700","entrez_id":["51128"],"uniprot":["Q9Y6B6"],"ncbi_summary":"The protein encoded by this gene is a small GTPase that acts as a homodimer. The encoded protein is activated by the guanine nucleotide exchange factor PREB and is involved in protein transport from the endoplasmic reticulum to the Golgi. This protein is part of the COPII coat complex. Defects in this gene are a cause of chylomicron retention disease (CMRD), also known as Anderson disease (ANDD). Two transcript variants encoding the same protein have been found for this gene. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y6B6","text":"Small GTPase that cycles between an active GTP-bound and an inactive GDP-bound state and mainly functions in vesicle-mediated endoplasmic reticulum (ER) to Golgi transport. The active GTP-bound form inserts into the endoplasmic reticulum membrane where it recruits the remainder of the coat protein complex II/COPII (PubMed:23433038, PubMed:32358066, PubMed:33186557, PubMed:36369712). The coat protein complex II assembling and polymerizing on endoplasmic reticulum membrane is responsible for both the sorting of cargos and the deformation and budding of membranes into vesicles destined to the Golgi (PubMed:23433038, PubMed:32358066, PubMed:33186557). In contrast to SAR1A, SAR1B specifically interacts with the cargo receptor SURF4 to mediate the transport of lipid-carrying lipoproteins including APOB and APOA1 from the endoplasmic reticulum to the Golgi and thereby, indirectly regulates lipid homeostasis (PubMed:32358066, PubMed:33186557). In addition to its role in vesicle trafficking, can also function as a leucine sensor regulating TORC1 signaling and more indirectly cellular metabolism, growth and survival. In absence of leucine, interacts with the GATOR2 complex via MIOS and inhibits TORC1 signaling. The binding of leucine abrogates the interaction with GATOR2 and the inhibition of the TORC1 signaling. This function is completely independent of the GTPase activity of SAR1B (PubMed:34290409)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}