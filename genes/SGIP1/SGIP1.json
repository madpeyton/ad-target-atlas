e}},"description":[{"gene_id":"ENSG00000118473","entrez_id":["84251"],"uniprot":["Q9BQI5"],"ncbi_summary":"SGIP1 functions as an endocytic protein that affects signaling by receptors in neuronal systems involved in energy homeostasis via its interaction with endophilins (see SH3GL3; MIM 603362) (Trevaskis et al., 2005 [PubMed 15919751] and Uezu et al., 2007 [PubMed 17626015]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BQI5","text":"May function in clathrin-mediated endocytosis. Has both a membrane binding/tubulating activity and the ability to recruit proteins essential to the formation of functional clathrin-coated pits. Has a preference for membranes enriched in phosphatidylserine and phosphoinositides and is required for the endocytosis of the transferrin receptor. May also bind tubulin. May play a role in the regulation of energy homeostasis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}