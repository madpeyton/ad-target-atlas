ucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":4.43888e-06,"nucleus_log2fc":-0.230037,"nucleus_score":-4.91386,"pct_ad":0.146485,"pct_control":0.170522,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0958829,"donor_lfcse":0.110296,"donor_log2fc_shrunk":-7.981e-06},{"cell_type":"In","gene_symbol":"PHKG2","gene_symbol_current":"PHKG2","gene_id":"ENSG00000156873","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.987395,"nucleus_log2fc":-0.128892,"nucleus_score":-0.0535312,"pct_ad":0.105146,"pct_control":0.103641,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.00960219,"donor_lfcse":0.189642,"donor_log2fc_shrunk":-2.79131e-07}],"modules":[{"cell_type":"In","gene_id":"ENSG00000156873","module":"turquoise","kme":0.16811,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000156873","entrez_id":["5261"],"uniprot":["P15735"],"ncbi_summary":"Phosphorylase kinase is a polymer of 16 subunits, four each of alpha, beta, gamma and delta. The alpha subunit includes the skeletal muscle and hepatic isoforms, encoded by two different genes. The beta subunit is the same in both the muscle and hepatic isoforms, and encoded by one gene. The gamma subunit also includes the skeletal muscle and hepatic isoforms, and the hepatic isoform is encoded by this gene. The delta subunit is a calmodulin and can be encoded by three different genes. The gamma subunits contain the active site of the enzyme, whereas the alpha and beta subunits have regulatory functions controlled by phosphorylation. The delta subunit mediates the dependence of the enzyme on calcium concentration. Mutations in this gene cause glycogen storage disease type 9C, also known as autosomal liver glycogenosis. Alternatively spliced transcript variants encoding different isoforms have been identified in this gene.[provided by RefSeq, Feb 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P15735","text":"Catalytic subunit of the phosphorylase b kinase (PHK), which mediates the neural and hormonal regulation of glycogen breakdown (glycogenolysis) by phosphorylating and thereby activating glycogen phosphorylase. May regulate glycogeneolysis in the testis. In vitro, phosphorylates PYGM (PubMed:35549678)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}