fcse":0.19387,"donor_log2fc_shrunk":-5.2692e-06},{"cell_type":"Oli","gene_symbol":"LAMTOR4","gene_symbol_current":"LAMTOR4","gene_id":"ENSG00000188186","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.848825,"donor_log2fc":-0.159455,"donor_lfcse":0.157328,"donor_log2fc_shrunk":-0.00621401}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000188186","module":"brown","kme":0.127015,"hub":false,"module_direction":"lower in AD","module_padj":0.652213,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000188186","module":"turquoise","kme":0.304285,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000188186","module":"turquoise","kme":0.269013,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000188186","module":"turquoise","kme":0.162576,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000188186","module":"turquoise","kme":0.146262,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000188186","entrez_id":["389541"],"uniprot":["Q0VGL1"],"ncbi_summary":"Contributes to guanyl-nucleotide exchange factor activity and molecular adaptor activity. Involved in several processes, including cellular response to amino acid stimulus; positive regulation of TOR signaling; and protein localization to lysosome. Located in lysosome. Part of Ragulator complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q0VGL1","text":"As part of the Ragulator complex it is involved in amino acid sensing and activation of mTORC1, a signaling complex promoting cell growth in response to growth factors, energy levels, and amino acids (PubMed:22980980, PubMed:28935770, PubMed:29107538, PubMed:29158492, PubMed:30181260). Activated by amino acids through a mechanism involving the lysosomal V-ATPase, the Ragulator plays a dual role for the small GTPases Rag (RagA/RRAGA, RagB/RRAGB, RagC/RRAGC and/or RagD/RRAGD): it (1) acts as a guanine nucleotide exchange factor (GEF), activating the small GTPases Rag and (2) mediates recruitment of Rag GTPases to the lysosome membrane (PubMed:22053050, PubMed:22980980, PubMed:28935770, PubMed:29107538, PubMed:29158492, PubMed:30181260). Activated Ragulator and Rag GTPases function as a scaffold recruiting mTORC1 to lysosomes where it is in turn activated (PubMed:22980980, PubMed:28935770, PubMed:29107538, PubMed:29158492, PubMed:30181260)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}