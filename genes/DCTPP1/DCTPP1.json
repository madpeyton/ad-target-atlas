lfcse":0.203162,"donor_log2fc_shrunk":-1.90939e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000179958","module":"turquoise","kme":0.223727,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000179958","module":"turquoise","kme":0.201497,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000179958","entrez_id":["79077"],"uniprot":["Q9H773"],"ncbi_summary":"The protein encoded by this gene is dCTP pyrophosphatase, which converts dCTP to dCMP and inorganic pyrophosphate. The encoded protein also displays weak activity against dTTP and dATP, but none against dGTP. This protein may be responsible for eliminating excess dCTP after DNA synthesis and may prevent overmethylation of CpG islands. Three transcript variants, one protein-coding and the other two non-protein coding, have been found for this gene. [provided by RefSeq, Dec 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H773","text":"Hydrolyzes deoxynucleoside triphosphates (dNTPs) to the corresponding nucleoside monophosphates. Has a strong preference for dCTP and its analogs including 5-iodo-dCTP and 5-methyl-dCTP for which it may even have a higher efficiency. May protect DNA or RNA against the incorporation of these genotoxic nucleotide analogs through their catabolism."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}