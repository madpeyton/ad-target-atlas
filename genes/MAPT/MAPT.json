"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.90839e-125,"nucleus_log2fc":0.244024,"nucleus_score":23.9543,"pct_ad":0.848003,"pct_control":0.83087,"donor_test":"not significant","donor_padj":0.888631,"donor_log2fc":0.115557,"donor_lfcse":0.145886,"donor_log2fc_shrunk":0.0058471}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000186868","module":"brown","kme":0.244866,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000186868","module":"blue","kme":0.272469,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000186868","module":"turquoise","kme":0.213498,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000186868","module":"yellow","kme":0.31058,"hub":false,"module_direction":"higher in AD","module_padj":0.663532,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000186868","module":"blue","kme":0.223617,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000186868","entrez_id":["4137"],"uniprot":["P10636"],"ncbi_summary":"This gene encodes the microtubule-associated protein tau (MAPT) whose transcript undergoes complex, regulated alternative splicing, giving rise to several mRNA species. MAPT transcripts are differentially expressed in the nervous system, depending on stage of neuronal maturation and neuron type. MAPT gene mutations have been associated with several neurodegenerative disorders such as Alzheimer's disease, Pick's disease, frontotemporal dementia, cortico-basal degeneration and progressive supranuclear palsy. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P10636","text":"Promotes microtubule assembly and stability, and might be involved in the establishment and maintenance of neuronal polarity (PubMed:21985311). The C-terminus binds axonal microtubules while the N-terminus binds neural plasma membrane components, suggesting that tau functions as a linker protein between both (PubMed:21985311, PubMed:32961270). Axonal polarity is predetermined by TAU/MAPT localization (in the neuronal cell) in the domain of the cell body defined by the centrosome. The short isoforms allow plasticity of the cytoskeleton whereas the longer isoforms may preferentially play a role in its stabilization."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}