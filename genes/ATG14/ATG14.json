us_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.13889,"donor_log2fc":-0.522058,"donor_lfcse":0.12364,"donor_log2fc_shrunk":-0.455744}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000126775","module":"turquoise","kme":0.102763,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000126775","entrez_id":["22863"],"uniprot":["Q6ZNE5"],"ncbi_summary":"Enables GTPase binding activity. Involved in several processes, including macroautophagy; regulation of phosphorylation; and response to mitochondrial depolarisation. Acts upstream of or within endosome to lysosome transport. Located in autophagosome and phagophore assembly site membrane. Is extrinsic component of omegasome membrane and extrinsic component of phagophore assembly site membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6ZNE5","text":"Required for both basal and inducible autophagy. Determines the localization of the autophagy-specific PI3-kinase complex PI3KC3-C1 (PubMed:18843052, PubMed:19050071). Plays a role in autophagosome formation and MAP1LC3/LC3 conjugation to phosphatidylethanolamine (PubMed:19270696, PubMed:20713597). Promotes BECN1 translocation from the trans-Golgi network to autophagosomes (PubMed:20713597). Enhances PIK3C3 activity in a BECN1-dependent manner. Essential for the autophagy-dependent phosphorylation of BECN1 (PubMed:23878393). Stimulates the phosphorylation of BECN1, but suppresses the phosphorylation PIK3C3 by AMPK (PubMed:23878393). Binds to STX17-SNAP29 binary t-SNARE complex on autophagosomes and primes it for VAMP8 interaction to promote autophagosome-endolysosome fusion (PubMed:25686604, PubMed:37632749). Modulates the hepatic lipid metabolism (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}