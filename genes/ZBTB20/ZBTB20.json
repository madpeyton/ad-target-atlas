_type":"Ast","gene_id":"ENSG00000181722","module":"greenyellow","kme":0.482184,"hub":false,"module_direction":"higher in AD","module_padj":0.866421,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000181722","module":"pink","kme":0.154874,"hub":false,"module_direction":"lower in AD","module_padj":0.524491,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000181722","module":"green","kme":0.302498,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000181722","module":"brown","kme":0.340342,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000181722","module":"blue","kme":0.357559,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000181722","entrez_id":["26137"],"uniprot":["Q9HC78"],"ncbi_summary":"This gene, which was initially designated as dendritic cell-derived BTB/POZ zinc finger (DPZF), belongs to a family of transcription factors with an N-terminal BTB/POZ domain and a C-terminal DNA-bindng zinc finger domain. The BTB/POZ domain is a hydrophobic region of approximately 120 aa which mediates association with other BTB/POZ domain-containing proteins. This gene acts as a transcriptional repressor and plays a role in many processes including neurogenesis, glucose homeostasis, and postnatal growth. Mutations in this gene have been associated with Primrose syndrome as well as the 3q13.31 microdeletion syndrome. Alternative splicing results in multiple transcript variants encoding distinct isoforms. [provided by RefSeq, Feb 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9HC78","text":"May be a transcription factor that may be involved in hematopoiesis, oncogenesis, and immune responses (PubMed:11352661). Plays a role in postnatal myogenesis, may be involved in the regulation of satellite cells self-renewal (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}