:[{"cell_type":"CUX2-","gene_id":"ENSG00000161533","module":"turquoise","kme":0.119216,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000161533"],"dataset_symbols":["ACOX1"],"explorer":"explorer.html?dataset=mathys2019#gene/ACOX1","cell_types":[{"cell_type":"Ex","gene_symbol":"ACOX1","gene_symbol_current":"ACOX1","gene_id":"ENSG00000161533","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.541664,"nucleus_log2fc":-0.00333308,"nucleus_score":-0.726389,"pct_ad":0.206928,"pct_control":0.211118,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.0621409,"donor_lfcse":0.0599673,"donor_log2fc_shrunk":1.33059e-05},{"cell_type":"In","gene_symbol":"ACOX1","gene_symbol_current":"ACOX1","gene_id":"ENSG00000161533","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.957609,"nucleus_log2fc":-0.0630018,"nucleus_score":0.168823,"pct_ad":0.131766,"pct_control":0.127918,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0148721,"donor_lfcse":0.133187,"donor_log2fc_shrunk":-7.53996e-07}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000161533","module":"blue","kme":0.0803621,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000161533","entrez_id":["51"],"uniprot":["Q15067"],"ncbi_summary":"The protein encoded by this gene is the first enzyme of the fatty acid beta-oxidation pathway, which catalyzes the desaturation of acyl-CoAs to 2-trans-enoyl-CoAs. It donates electrons directly to molecular oxygen, thereby producing hydrogen peroxide. Defects in this gene result in pseudoneonatal adrenoleukodystrophy, a disease that is characterized by accumulation of very long chain fatty acids. Alternatively spliced transcript variants encoding different isoforms have been identified. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q15067","text":"Involved in the initial and rate-limiting step of peroxisomal beta-oxidation of straight-chain saturated and unsaturated very-long-chain fatty acids (VLCFAs) (PubMed:15060085, PubMed:17458872, PubMed:17603022, PubMed:32169171, PubMed:33234382, PubMed:7876265). Catalyzes the desaturation of fatty acyl-CoAs that have a saturated bond between C2 and C3 (2,3-saturated acyl-CoA) to 2-trans-enoyl-CoAs ((2E)-enoyl-CoAs), and donates electrons directly to molecular oxygen (O(2)), thereby producing hydrogen peroxide (H(2)O(2)) (PubMed:17458872, PubMed:17603022, PubMed:7876265). May play a role in peroxisomal beta-oxidation step in polyunsaturated fatty acids (PUFAs) biosynthesis. Possibly regulates systemic levels of docosahexaenoic acid (DHA, C22:6n-3) through a process involving endoplasmic reticulum desaturation and elongation of alpha-linolenic acid (ALA, C18:3n-3) to form tetracosahexaenoic acid (THA, C24:6n-3), which is then beta-oxidized to DHA in peroxisomes (Probable). Involved in VLCFA-dependent hepatic-to-adipose tissue inter-organ signaling in response to diet. Through hepatic beta-oxidation of THA, may regulate THA systemic levels and THA-dependent activation of FFAR4 signaling in adipocytes, limiting adipose tissue thermogenesis (By similarity). [Isoform 1]: Shows highest activity against medium-chain fatty acyl-CoAs. Shows optimum activity with a chain length of 10 carbons (decanoyl-CoA) in vitro. [Isoform 2]: Is active against a much broader range of substrates and shows activity towards long-chain and very-long-chain fatty acyl-CoAs."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}