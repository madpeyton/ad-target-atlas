false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000184743"],"dataset_symbols":["ATL3"],"explorer":"explorer.html?dataset=mathys2019#gene/ATL3","cell_types":[{"cell_type":"Ex","gene_symbol":"ATL3","gene_symbol_current":"ATL3","gene_id":"ENSG00000184743","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.439355,"nucleus_log2fc":0.121523,"nucleus_score":0.90991,"pct_ad":0.130435,"pct_control":0.127453,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.147972,"donor_lfcse":0.0817363,"donor_log2fc_shrunk":2.28786e-05},{"cell_type":"Oli","gene_symbol":"ATL3","gene_symbol_current":"ATL3","gene_id":"ENSG00000184743","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.81145,"donor_log2fc":0.145158,"donor_lfcse":0.125923,"donor_log2fc_shrunk":0.00883681}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000184743","entrez_id":["25923"],"uniprot":["Q6DD88"],"ncbi_summary":"This gene encodes a member of a family of dynamin-like, integral membrane GTPases. The encoded protein is required for the proper formation of the network of interconnected tubules of the endoplasmic reticulum. Mutations in this gene may be associated with hereditary sensory neuropathy type IF. Alternatively spliced transcript variants that encode distinct isoforms have been described. [provided by RefSeq, Feb 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6DD88","text":"Atlastin-3 (ATL3) is a membrane-anchored GTPase that mediates the GTP-dependent fusion of endoplasmic reticulum (ER) membranes, maintaining the continuous ER network. It facilitates the formation of three-way junctions where ER tubules intersect (PubMed:18270207, PubMed:19665976, PubMed:24459106, PubMed:27619977, PubMed:37102997). Two atlastin-3 on neighboring ER tubules bind GTP and form loose homodimers through the GB1/RHD3-type G domains and 3HB regions. Upon GTP hydrolysis, the 3HB regions tighten, pulling the membranes together to drive their fusion. After fusion, the homodimer disassembles upon release of inorganic phosphate (Pi). Subsequently, GDP dissociates, resetting the monomers to a conformation ready for a new fusion cycle (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}