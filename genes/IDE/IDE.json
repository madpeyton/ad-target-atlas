:false},"seaad_pfc":{"dataset_label":"SEA-AD (Gabitto et al. 2024)","gene_ids":["ENSG00000119912"],"dataset_symbols":["IDE"],"explorer":"explorer.html?dataset=seaad_pfc#gene/IDE","cell_types":[{"cell_type":"Ast","gene_symbol":"IDE","gene_symbol_current":"IDE","gene_id":"ENSG00000119912","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.53864e-06,"nucleus_log2fc":0.11505,"nucleus_score":5.00677,"pct_ad":0.344561,"pct_control":0.321322,"donor_test":"not significant","donor_padj":0.75511,"donor_log2fc":0.136364,"donor_lfcse":0.0886003,"donor_log2fc_shrunk":0.0107563,"degas_log2fc":-0.123725,"degas_padj":2.65219e-06},{"cell_type":"Ex","gene_symbol":"IDE","gene_symbol_current":"IDE","gene_id":"ENSG00000119912","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.49467e-43,"nucleus_log2fc":0.070325,"nucleus_score":13.9035,"pct_ad":0.775427,"pct_control":0.769749,"donor_test":"not significant","donor_padj":0.673841,"donor_log2fc":0.109683,"donor_lfcse":0.0759319,"donor_log2fc_shrunk":0.0173842,"degas_log2fc":-0.0677276,"degas_padj":2.65674e-40},{"cell_type":"In","gene_symbol":"IDE","gene_symbol_current":"IDE","gene_id":"ENSG00000119912","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.193099,"nucleus_log2fc":0.0150427,"nucleus_score":1.36142,"pct_ad":0.583437,"pct_control":0.586779,"donor_test":"not significant","donor_padj":0.739207,"donor_log2fc":0.103196,"donor_lfcse":0.0696698,"donor_log2fc_shrunk":0.00850326,"degas_log2fc":-0.153416,"degas_padj":5.12501e-74},{"cell_type":"Mic","gene_symbol":"IDE","gene_symbol_current":"IDE","gene_id":"ENSG00000119912","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.411627,"nucleus_log2fc":0.0290023,"nucleus_score":1.00131,"pct_ad":0.295357,"pct_control":0.287788,"donor_test":"not significant","donor_padj":0.974573,"donor_log2fc":0.0141871,"donor_lfcse":0.078865,"donor_log2fc_shrunk":0.00369823,"degas_log2fc":0.065272,"degas_padj":0.166495},{"cell_type":"OPC","gene_symbol":"IDE","gene_symbol_current":"IDE","gene_id":"ENSG00000119912","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.822485,"nucleus_log2fc":-0.0157495,"nucleus_score":-0.354372,"pct_ad":0.317477,"pct_control":0.320237,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0256478,"donor_lfcse":0.0791421,"donor_log2fc_shrunk":2.21764e-05,"degas_log2fc":-0.237772,"degas_padj":1.51231e-06},{"cell_type":"Oli","gene_symbol":"IDE","gene_symbol_current":"IDE","gene_id":"ENSG00000119912","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.134892,"nucleus_log2fc":0.060053,"nucleus_score":1.61054,"pct_ad":0.217337,"pct_control":0.213527,"donor_test":"not significant","donor_padj":0.897341,"donor_log2fc":0.0611671,"donor_lfcse":0.0804943,"donor_log2fc_shrunk":0.00940144,"degas_log2fc":-0.152211,"degas_padj":2.84953e-09}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000119912","module":"blue","kme":0.127087,"hub":false,"module_direction":"lower in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000119912","entrez_id":["3416"],"uniprot":["P14735"],"ncbi_summary":"This gene encodes a zinc metallopeptidase that degrades intracellular insulin, and thereby terminates insulins activity, as well as participating in intercellular peptide signalling by degrading diverse peptides such as glucagon, amylin, bradykinin, and kallidin. The preferential affinity of this enzyme for insulin results in insulin-mediated inhibition of the degradation of other peptides such as beta-amyloid. Deficiencies in this protein's function are associated with Alzheimer's disease and type 2 diabetes mellitus but mutations in this gene have not been shown to be causitive for these diseases. This protein localizes primarily to the cytoplasm but in some cell types localizes to the extracellular space, cell membrane, peroxisome, and mitochondrion. Alternative splicing results in multiple transcript variants encoding distinct isoforms. Additional transcript variants have been described but have not been experimentally verified.[provided by RefSeq, Sep 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P14735","text":"Plays a role in the cellular breakdown of insulin, APP peptides, IAPP peptides, natriuretic peptides, glucagon, bradykinin, kallidin, and other peptides, and thereby plays a role in intercellular peptide signaling (PubMed:10684867, PubMed:17051221, PubMed:17613531, PubMed:18986166, PubMed:19321446, PubMed:21098034, PubMed:2293021, PubMed:23922390, PubMed:24847884, PubMed:26394692, PubMed:26968463, PubMed:29596046). Substrate binding induces important conformation changes, making it possible to bind and degrade larger substrates, such as insulin (PubMed:23922390, PubMed:26394692, PubMed:29596046). Contributes to the regulation of peptide hormone signaling cascades and regulation of blood glucose homeostasis via its role in the degradation of insulin, glucagon and IAPP (By similarity). Plays a role in the degradation and clearance of APP-derived amyloidogenic peptides that are secreted by neurons and microglia (Probable) (PubMed:26394692, PubMed:9830016). Degrades the natriuretic peptides ANP, BNP and CNP, inactivating their ability to raise intracellular cGMP (PubMed:21098034). Also degrades an aberrant frameshifted 40-residue form of NPPA (fsNPPA) which is associated with familial atrial fibrillation in heterozygous patients (PubMed:21098034). Involved in antigen processing. Produces both the N terminus and the C terminus of MAGEA3-derived antigenic peptide (EVDPIGHLY) that is presented to cytotoxic T lymphocytes by MHC class I. (Microbial infection) The membrane-associated isoform acts as an entry receptor for varicella-zoster virus (VZV)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}