,"nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000305281,"nucleus_log2fc":-0.148025,"nucleus_score":-3.91297,"pct_ad":0.355896,"pct_control":0.380415,"donor_test":"not significant","donor_padj":0.652939,"donor_log2fc":-0.0943413,"donor_lfcse":0.0694245,"donor_log2fc_shrunk":-0.0344549},{"cell_type":"OPC","gene_symbol":"STRADA","gene_symbol_current":"STRADA","gene_id":"ENSG00000266173","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.73731e-07,"nucleus_log2fc":-0.267321,"nucleus_score":-5.59408,"pct_ad":0.364301,"pct_control":0.403048,"donor_test":"not significant","donor_padj":0.991471,"donor_log2fc":-0.229957,"donor_lfcse":0.089299,"donor_log2fc_shrunk":-2.97533e-05},{"cell_type":"Oli","gene_symbol":"STRADA","gene_symbol_current":"STRADA","gene_id":"ENSG00000266173","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.69705e-84,"nucleus_log2fc":-0.356431,"nucleus_score":-19.6297,"pct_ad":0.365753,"pct_control":0.433967,"donor_test":"not significant","donor_padj":0.455843,"donor_log2fc":-0.259874,"donor_lfcse":0.095644,"donor_log2fc_shrunk":-0.147689}],"modules":[{"cell_type":"Oli","gene_id":"ENSG00000266173","module":"yellow","kme":0.169734,"hub":false,"module_direction":"lower in AD","module_padj":0.0240838,"module_significant":true}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000266173","entrez_id":["92335"],"uniprot":["Q7RTN6"],"ncbi_summary":"The protein encoded by this gene contains a STE20-like kinase domain, but lacks several residues that are critical for catalytic activity, so it is termed a 'pseudokinase'. The protein forms a heterotrimeric complex with serine/threonine kinase 11 (STK11, also known as LKB1) and the scaffolding protein calcium binding protein 39 (CAB39, also known as MO25). The protein activates STK11 leading to the phosphorylation of both proteins and excluding STK11 from the nucleus. The protein is necessary for STK11-induced G1 cell cycle arrest. A mutation in this gene has been shown to result in polyhydramnios, megalencephaly, and symptomatic epilepsy (PMSE) syndrome. Multiple transcript variants encoding different isoforms have been found for this gene. Additional transcript variants have been described but their full-length nature is not known. [provided by RefSeq, Sep 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q7RTN6","text":"Pseudokinase which, in complex with CAB39/MO25 (CAB39/MO25alpha or CAB39L/MO25beta), binds to and activates STK11/LKB1. Adopts a closed conformation typical of active protein kinases and binds STK11/LKB1 as a pseudosubstrate, promoting conformational change of STK11/LKB1 in an active conformation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}