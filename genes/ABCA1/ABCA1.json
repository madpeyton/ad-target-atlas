test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0846485,"donor_lfcse":0.10934,"donor_log2fc_shrunk":7.41593e-06,"degas_log2fc":-0.434611,"degas_padj":4.89993e-31},{"cell_type":"Oli","gene_symbol":"ABCA1","gene_symbol_current":"ABCA1","gene_id":"ENSG00000165029","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":5.80648e-16,"nucleus_log2fc":-0.209663,"nucleus_score":-8.25526,"pct_ad":0.12808,"pct_control":0.150332,"donor_test":"not significant","donor_padj":0.925068,"donor_log2fc":-0.133989,"donor_lfcse":0.21827,"donor_log2fc_shrunk":-0.00304434,"degas_log2fc":-0.24694,"degas_padj":2.00066e-14}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000165029","module":"brown","kme":0.273768,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165029","entrez_id":["19"],"uniprot":["O95477"],"ncbi_summary":"The membrane-associated protein encoded by this gene is a member of the superfamily of ATP-binding cassette (ABC) transporters. ABC proteins transport various molecules across extra- and intracellular membranes. ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, White). This protein is a member of the ABC1 subfamily. Members of the ABC1 subfamily comprise the only major ABC subfamily found exclusively in multicellular eukaryotes. With cholesterol as its substrate, this protein functions as a cholesteral efflux pump in the cellular lipid removal pathway. Mutations in both alleles of this gene cause Tangier disease and familial high-density lipoprotein (HDL) deficiency. [provided by RefSeq, Sep 2019].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95477","text":"Catalyzes the translocation of specific phospholipids from the cytoplasmic to the extracellular/lumenal leaflet of membrane coupled to the hydrolysis of ATP (PubMed:24097981, PubMed:35974019). Thereby, participates in phospholipid transfer to apolipoproteins to form nascent high density lipoproteins/HDLs (PubMed:14754908). Transports preferentially phosphatidylcholine over phosphatidylserine (PubMed:24097981). May play a similar role in the efflux of intracellular cholesterol to apolipoproteins and the formation of nascent high density lipoproteins/HDLs (PubMed:10533863, PubMed:14754908, PubMed:24097981, PubMed:35974019). Translocates phospholipids from the outer face of the plasma membrane and forces it through its gateway and annulus into an elongated hydrophobic tunnel in its extracellular domain (PubMed:35974019)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}