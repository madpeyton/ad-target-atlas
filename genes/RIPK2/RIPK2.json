donor_log2fc_shrunk":0.00534089},{"cell_type":"In","gene_symbol":"RIPK2","gene_symbol_current":"RIPK2","gene_id":"ENSG00000104312","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0399975,"nucleus_log2fc":0.0599907,"nucleus_score":2.12394,"pct_ad":0.190347,"pct_control":0.187552,"donor_test":"not significant","donor_padj":0.694045,"donor_log2fc":0.120248,"donor_lfcse":0.0626056,"donor_log2fc_shrunk":0.0152937},{"cell_type":"Mic","gene_symbol":"RIPK2","gene_symbol_current":"RIPK2","gene_id":"ENSG00000104312","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.653798,"nucleus_log2fc":0.0378612,"nucleus_score":0.574847,"pct_ad":0.180966,"pct_control":0.178111,"donor_test":"not significant","donor_padj":0.974711,"donor_log2fc":-0.0249019,"donor_lfcse":0.139546,"donor_log2fc_shrunk":-0.0025497},{"cell_type":"OPC","gene_symbol":"RIPK2","gene_symbol_current":"RIPK2","gene_id":"ENSG00000104312","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.370441,"nucleus_log2fc":-0.0927178,"nucleus_score":-1.21665,"pct_ad":0.157769,"pct_control":0.165453,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.125387,"donor_lfcse":0.0809656,"donor_log2fc_shrunk":-2.00714e-05},{"cell_type":"Oli","gene_symbol":"RIPK2","gene_symbol_current":"RIPK2","gene_id":"ENSG00000104312","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.465034,"donor_log2fc":0.212181,"donor_lfcse":0.0839158,"donor_log2fc_shrunk":0.0913852}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000104312","module":"brown","kme":0.24619,"hub":false,"module_direction":"lower in AD","module_padj":0.802039,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000104312","module":"blue","kme":0.205142,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000104312","module":"magenta","kme":0.164765,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000104312","entrez_id":["8767"],"uniprot":["O43353"],"ncbi_summary":"This gene encodes a member of the receptor-interacting protein (RIP) family of serine/threonine protein kinases. The encoded protein contains a C-terminal caspase activation and recruitment domain (CARD), and is a component of signaling complexes in both the innate and adaptive immune pathways. It is a potent activator of NF-kappaB and inducer of apoptosis in response to various stimuli. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43353","text":"Serine/threonine/tyrosine-protein kinase that plays an essential role in modulation of innate and adaptive immune responses (PubMed:14638696, PubMed:17054981, PubMed:21123652, PubMed:28656966, PubMed:9575181, PubMed:9642260). Acts as a key effector of NOD1 and NOD2 signaling pathways: upon activation by bacterial peptidoglycans, NOD1 and NOD2 oligomerize and recruit RIPK2 via CARD-CARD domains, leading to the formation of RIPK2 filaments (PubMed:17054981, PubMed:17562858, PubMed:21123652, PubMed:22607974, PubMed:28656966, PubMed:29452636, PubMed:30026309). Once recruited, RIPK2 autophosphorylates and undergoes 'Lys-63'-linked polyubiquitination by E3 ubiquitin ligases XIAP, BIRC2 and BIRC3, as well as 'Met-1'-linked (linear) polyubiquitination by the LUBAC complex, becoming a scaffolding protein for downstream effectors (PubMed:22607974, PubMed:28545134, PubMed:29452636, PubMed:30026309, PubMed:30279485, PubMed:30478312). 'Met-1'-linked polyubiquitin chains attached to RIPK2 recruit IKBKG/NEMO, which undergoes 'Lys-63'-linked polyubiquitination in a RIPK2-dependent process (PubMed:17562858, PubMed:22607974, PubMed:29452636, PubMed:30026309). 'Lys-63'-linked polyubiquitin chains attached to RIPK2 serve as docking sites for TAB2 and TAB3 and mediate the recruitment of MAP3K7/TAK1 to IKBKG/NEMO, inducing subsequent activation of IKBKB/IKKB (PubMed:18079694). In turn, NF-kappa-B is released from NF-kappa-B inhibitors and translocates into the nucleus where it activates the transcription of hundreds of genes involved in immune response, growth control, or protection against apoptosis (PubMed:18079694). The protein kinase activity is dispensable for the NOD1 and NOD2 signaling pathways (PubMed:29452636, PubMed:30026309). Contributes to the tyrosine phosphorylation of the guanine exchange factor ARHGEF2 through Src tyrosine kinase leading to NF-kappa-B activation by NOD2 (PubMed:21887730). Also involved in adaptive immunity: plays a role during engagement of the T-cell receptor (TCR) in promoting BCL10 phosphorylation and subsequent NF-kappa-B activation (PubMed:14638696). Plays a role in the inactivation of RHOA in response to NGFR signaling (PubMed:26646181)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}