nk":-1.68136e-05},{"cell_type":"Oli","gene_symbol":"GNPTG","gene_symbol_current":"GNPTG","gene_id":"ENSG00000090581","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.72844e-25,"nucleus_log2fc":-0.216525,"nucleus_score":-10.5963,"pct_ad":0.284988,"pct_control":0.320529,"donor_test":"not significant","donor_padj":0.458942,"donor_log2fc":-0.195976,"donor_lfcse":0.0747134,"donor_log2fc_shrunk":-0.11424}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000090581","module":"turquoise","kme":0.0539567,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000090581","module":"turquoise","kme":0.0677793,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000090581","entrez_id":["84572"],"uniprot":["Q9UJJ9"],"ncbi_summary":"This gene encodes the gamma sunbunit of the N-acetylglucosamine-1-phosphotransferase complex. This hexameric complex, composed of alpha, beta and gamma subunits, catalyzes the first step in synthesis of a mannose 6-phosphate lysosomal recognition marker. This enzyme complex is necessary for targeting of lysosomal hydrolases to the lysosome. Mutations in the gene encoding the gamma subunit have been associated with mucolipidosis IIIC, also known as mucolipidosis III gamma.[provided by RefSeq, Feb 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UJJ9","text":"Non-catalytic subunit of the N-acetylglucosamine-1-phosphotransferase complex, an enzyme that catalyzes the formation of mannose 6-phosphate (M6P) markers on high mannose type oligosaccharides in the Golgi apparatus. Binds and presents the high mannose glycans of the acceptor to the catalytic alpha and beta subunits (GNPTAB). Enhances the rate of N-acetylglucosamine-1-phosphate transfer to the oligosaccharides of acid hydrolase acceptors."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}