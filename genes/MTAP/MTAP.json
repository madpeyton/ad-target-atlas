es","gene_id":"ENSG00000099810","module":"black","kme":0.186614,"hub":false,"module_direction":"lower in AD","module_padj":0.552382,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000099810","module":"brown","kme":0.147624,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000099810","module":"blue","kme":0.131123,"hub":false,"module_direction":"higher in AD","module_padj":0.554841,"module_significant":false},{"cell_type":"Vascular.niche","gene_id":"ENSG00000099810","module":"brown","kme":0.178981,"hub":false,"module_direction":"lower in AD","module_padj":0.548873,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000099810","entrez_id":["4507"],"uniprot":["Q13126"],"ncbi_summary":"This gene encodes an enzyme that plays a major role in polyamine metabolism and is important for the salvage pathway of both adenine and methionine. The encoded enzyme is deficient in many cancers. Multiple alternatively spliced transcript variants have been described for this gene. [provided by RefSeq, Sep 2021].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13126","text":"Catalyzes the phosphorolytic cleavage of S-methyl-5'-thioadenosine (MTA) to adenine and 5-methylthioribose1-phosphate (PubMed:3091600, PubMed:8687427, PubMed:10404592). Involved in the breakdown of MTA, a major by-product of polyamine biosynthesis (PubMed:3091600, PubMed:8687427, PubMed:10404592). Responsible for the first step in the methionine salvage pathway after MTA has been generated from S-adenosylmethionine (PubMed:3091600, PubMed:8687427, PubMed:10404592). Has broad substrate specificity with 6-aminopurine nucleosides as preferred substrates (PubMed:10404592)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}