ull,"donor_test":"not significant","donor_padj":0.994734,"donor_log2fc":-0.0172354,"donor_lfcse":0.095689,"donor_log2fc_shrunk":-9.39107e-06}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000117543","module":"turquoise","kme":0.095998,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000117543","entrez_id":["51611"],"uniprot":["Q9H2P9"],"ncbi_summary":"This gene encodes a component of the diphthamide synthesis pathway. Diphthamide is a post-translationally modified histidine residue found only on translation elongation factor 2. It is conserved from archaebacteria to humans, and is targeted by diphtheria toxin and Pseudomonas exotoxin A to halt cellular protein synthesis. The yeast and Chinese hamster homologs of this protein catalyze the trimethylation of the histidine residue on elongation factor 2, resulting in a diphthine moiety that is subsequently amidated to yield diphthamide. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H2P9","text":"S-adenosyl-L-methionine-dependent methyltransferase that catalyzes four methylations of the modified target histidine residue in translation elongation factor 2 (EF-2), to form an intermediate called diphthine methyl ester. The four successive methylation reactions represent the second step of diphthamide biosynthesis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}