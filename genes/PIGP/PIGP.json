cleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.210891,"nucleus_log2fc":-0.374072,"nucleus_score":-2.29946,"pct_ad":0.0829636,"pct_control":0.100529,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000185808","module":"turquoise","kme":0.186299,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000185808","module":"turquoise","kme":0.150569,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000185808","entrez_id":["51227"],"uniprot":["P57054"],"ncbi_summary":"This gene encodes an enzyme involved in the first step of glycosylphosphatidylinositol (GPI)-anchor biosynthesis. The GPI-anchor is a glycolipid found on many blood cells that serves to anchor proteins to the cell surface. The encoded protein is a component of the GPI-N-acetylglucosaminyltransferase complex that catalyzes the transfer of N-acetylglucosamine (GlcNAc) from UDP-GlcNAc to phosphatidylinositol (PI). This gene is located in the Down Syndrome critical region on chromosome 21 and is a candidate for the pathogenesis of Down syndrome. This gene has multiple pseudogenes and is a member of the phosphatidylinositol glycan anchor biosynthesis gene family. Alternatively spliced transcript variants encoding different isoforms have been described. [provided by RefSeq, Feb 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P57054","text":"Part of the glycosylphosphatidylinositol-N-acetylglucosaminyltransferase (GPI-GnT) complex that catalyzes the transfer of N-acetylglucosamine from UDP-N-acetylglucosamine to phosphatidylinositol and participates in the first step of GPI biosynthesis."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}