 AD","nucleus_padj":0.871504,"nucleus_log2fc":0.0527402,"nucleus_score":0.483699,"pct_ad":0.200089,"pct_control":0.193589,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0616607,"donor_lfcse":0.136945,"donor_log2fc_shrunk":3.33377e-06},{"cell_type":"OPC","gene_symbol":"ITPK1","gene_symbol_current":"ITPK1","gene_id":"ENSG00000100605","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.106187,"nucleus_log2fc":-0.385667,"nucleus_score":-2.64871,"pct_ad":0.174254,"pct_control":0.214559,"donor_test":"not significant","donor_padj":0.940764,"donor_log2fc":-0.261423,"donor_lfcse":0.15974,"donor_log2fc_shrunk":-0.0020865},{"cell_type":"Oli","gene_symbol":"ITPK1","gene_symbol_current":"ITPK1","gene_id":"ENSG00000100605","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0520783,"nucleus_log2fc":0.107106,"nucleus_score":2.25406,"pct_ad":0.162482,"pct_control":0.148498,"donor_test":"not significant","donor_padj":0.959468,"donor_log2fc":0.0296871,"donor_lfcse":0.101149,"donor_log2fc_shrunk":0.00260157}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000100605","module":"turquoise","kme":0.147167,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000100605","module":"red","kme":0.338658,"hub":false,"module_direction":"lower in AD","module_padj":0.641133,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000100605","module":"blue","kme":0.11296,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000100605","module":"red","kme":0.207716,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000100605","entrez_id":["3705"],"uniprot":["Q13572"],"ncbi_summary":"This gene encodes an enzyme that belongs to the inositol 1,3,4-trisphosphate 5/6-kinase family. This enzyme regulates the synthesis of inositol tetraphosphate, and downstream products, inositol pentakisphosphate and inositol hexakisphosphate. Inositol metabolism plays a role in the development of the neural tube. Disruptions in this gene are thought to be associated with neural tube defects. A pseudogene of this gene has been identified on chromosome X. [provided by RefSeq, Jul 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13572","text":"Kinase that can phosphorylate various inositol polyphosphate such as Ins(3,4,5,6)P4 or Ins(1,3,4)P3 (PubMed:11042108, PubMed:8662638). Phosphorylates Ins(3,4,5,6)P4 at position 1 to form Ins(1,3,4,5,6)P5 (PubMed:11042108). This reaction is thought to have regulatory importance, since Ins(3,4,5,6)P4 is an inhibitor of plasma membrane Ca(2+)-activated Cl(-) channels, while Ins(1,3,4,5,6)P5 is not. Also phosphorylates Ins(1,3,4)P3 on O-5 and O-6 to form Ins(1,3,4,6)P4, an essential molecule in the hexakisphosphate (InsP6) pathway (PubMed:11042108, PubMed:8662638). Also acts as an inositol polyphosphate phosphatase that dephosphorylates Ins(1,3,4,5)P4 and Ins(1,3,4,6)P4 to Ins(1,3,4)P3, and Ins(1,3,4,5,6)P5 to Ins(3,4,5,6)P4 (PubMed:11909533, PubMed:17616525). May also act as an isomerase that interconverts the inositol tetrakisphosphate isomers Ins(1,3,4,5)P4 and Ins(1,3,4,6)P4 in the presence of ADP and magnesium (PubMed:11909533). Probably acts as the rate-limiting enzyme of the InsP6 pathway. Modifies TNF-induced apoptosis by interfering with the activation of TNFRSF1A-associated death domain (PubMed:11909533, PubMed:12925536, PubMed:17616525). Plays an important role in MLKL-mediated necroptosis. Produces highly phosphorylated inositol phosphates such as inositolhexakisphosphate (InsP6) which bind to MLKL mediating the release of an N-terminal auto-inhibitory region leading to its activation. Essential for activated phospho-MLKL to oligomerize and localize to the cell membrane during necroptosis (PubMed:17616525)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}