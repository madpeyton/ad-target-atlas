t":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0989804,"nucleus_log2fc":0.027442,"nucleus_score":1.695,"pct_ad":0.431141,"pct_control":0.4355,"donor_test":"not significant","donor_padj":0.795993,"donor_log2fc":0.0467263,"donor_lfcse":0.0600221,"donor_log2fc_shrunk":0.0117595,"degas_log2fc":0.0409549,"degas_padj":1.9169e-06},{"cell_type":"In","gene_symbol":"SEH1L","gene_symbol_current":"SEH1L","gene_id":"ENSG00000085415","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.51155e-17,"nucleus_log2fc":-0.111207,"nucleus_score":-8.53546,"pct_ad":0.215286,"pct_control":0.232554,"donor_test":"not significant","donor_padj":0.853752,"donor_log2fc":-0.029471,"donor_lfcse":0.0431562,"donor_log2fc_shrunk":-0.00660936,"degas_log2fc":0.0594509,"degas_padj":0.000209668},{"cell_type":"Mic","gene_symbol":"SEH1L","gene_symbol_current":"SEH1L","gene_id":"ENSG00000085415","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.749735,"nucleus_log2fc":-0.0158606,"nucleus_score":-0.413297,"pct_ad":0.14234,"pct_control":0.1447,"donor_test":"not significant","donor_padj":0.980739,"donor_log2fc":0.0202872,"donor_lfcse":0.145474,"donor_log2fc_shrunk":0.00185039,"degas_log2fc":-0.179177,"degas_padj":0.00508516},{"cell_type":"OPC","gene_symbol":"SEH1L","gene_symbol_current":"SEH1L","gene_id":"ENSG00000085415","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.378186,"nucleus_log2fc":-0.114499,"nucleus_score":-1.20032,"pct_ad":0.103937,"pct_control":0.110246,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.10749,"donor_lfcse":0.0995368,"donor_log2fc_shrunk":-1.12081e-05,"degas_log2fc":-0.105927,"degas_padj":0.250792},{"cell_type":"Oli","gene_symbol":"SEH1L","gene_symbol_current":"SEH1L","gene_id":"ENSG00000085415","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0160412,"nucleus_log2fc":-0.0908457,"nucleus_score":-2.54295,"pct_ad":0.106242,"pct_control":0.112004,"donor_test":"not significant","donor_padj":0.97549,"donor_log2fc":-0.0171777,"donor_lfcse":0.0859378,"donor_log2fc_shrunk":-0.00225947,"degas_log2fc":-0.106338,"degas_padj":0.0034334}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000085415","entrez_id":["81929"],"uniprot":["Q96EE3"],"ncbi_summary":"The protein encoded by this gene is part of a nuclear pore complex, Nup107-160. This protein contains WD repeats and shares 34% amino acid identity with yeast Seh1 and 30% identity with yeast Sec13. All constituents of the Nup107-160 complex, including this protein, specifically localize to kinetochores in mitosis. Two alternatively spliced transcript variants encoding distinct isoforms have been found for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96EE3","text":"Component of the Nup107-160 subcomplex of the nuclear pore complex (NPC). The Nup107-160 subcomplex is required for the assembly of a functional NPC (PubMed:15146057, PubMed:17363900). The Nup107-160 subcomplex is also required for normal kinetochore microtubule attachment, mitotic progression and chromosome segregation. This subunit plays a role in recruitment of the Nup107-160 subcomplex to the kinetochore (PubMed:15146057, PubMed:17363900). As a component of the GATOR2 complex, functions as an activator of the amino acid-sensing branch of the mTORC1 signaling pathway (PubMed:23723238, PubMed:25457612, PubMed:27487210, PubMed:35831510, PubMed:36528027). The GATOR2 complex indirectly activates mTORC1 through the inhibition of the GATOR1 subcomplex (PubMed:23723238, PubMed:27487210, PubMed:35831510, PubMed:36528027). GATOR2 probably acts as an E3 ubiquitin-protein ligase toward GATOR1 (PubMed:36528027). In the presence of abundant amino acids, the GATOR2 complex mediates ubiquitination of the NPRL2 core component of the GATOR1 complex, leading to GATOR1 inactivation (PubMed:36528027). In the absence of amino acids, GATOR2 is inhibited, activating the GATOR1 complex (PubMed:25457612, PubMed:26972053, PubMed:27487210). Within the GATOR2 complex, SEC13 and SEH1L are required to stabilize the complex (PubMed:35831510)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}