dule":"turquoise","kme":0.0728413,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000159210"],"dataset_symbols":["SNF8"],"explorer":"explorer.html?dataset=mathys2019#gene/SNF8","cell_types":[{"cell_type":"Ex","gene_symbol":"SNF8","gene_symbol_current":"SNF8","gene_id":"ENSG00000159210","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0185514,"nucleus_log2fc":-0.0797668,"nucleus_score":-2.58923,"pct_ad":0.198903,"pct_control":0.214149,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":-0.0397027,"donor_lfcse":0.0853243,"donor_log2fc_shrunk":-5.69371e-06},{"cell_type":"In","gene_symbol":"SNF8","gene_symbol_current":"SNF8","gene_id":"ENSG00000159210","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.809586,"nucleus_log2fc":-0.155409,"nucleus_score":-0.657567,"pct_ad":0.128217,"pct_control":0.132275,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.162899,"donor_lfcse":0.135933,"donor_log2fc_shrunk":-9.25687e-06},{"cell_type":"Oli","gene_symbol":"SNF8","gene_symbol_current":"SNF8","gene_id":"ENSG00000159210","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.914343,"donor_log2fc":0.103991,"donor_lfcse":0.158287,"donor_log2fc_shrunk":0.0039592}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000159210","entrez_id":["11267"],"uniprot":["Q96H20"],"ncbi_summary":"The protein encoded by this gene is a component of the endosomal sorting complex required for transport II (ESCRT-II), which regulates the movement of ubiquitinylated transmembrane proteins to the lysosome for degradation. This complex also interacts with the RNA polymerase II elongation factor (ELL) to overcome the repressive effects of ELL on RNA polymerase II activity. Several transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Nov 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96H20","text":"Component of the endosomal sorting complex required for transport II (ESCRT-II), which is required for multivesicular body (MVB) formation and sorting of endosomal cargo proteins into MVBs, and plays a role in autophagy (PubMed:38423010). The MVB pathway mediates delivery of transmembrane proteins into the lumen of the lysosome for degradation. The ESCRT-II complex is probably involved in the recruitment of the ESCRT-III complex. The ESCRT-II complex may also play a role in transcription regulation by participating in derepression of transcription by RNA polymerase II, possibly via its interaction with ELL. Required for degradation of both endocytosed EGF and EGFR, but not for the EGFR ligand-mediated internalization. It is also required for the degradation of CXCR4. Required for the exosomal release of SDCBP, CD63 and syndecan (PubMed:22660413)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}