[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000134698","entrez_id":["192670"],"uniprot":["Q9HCK5"],"ncbi_summary":"This gene encodes a member of the Argonaute family of proteins which contain PAZ and PIWI domains and play an integral role in RNA interference and short-interfering-RNA-mediated gene silencing. This gene is located on chromosome 1 in a cluster of related family members. [provided by RefSeq, Mar 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9HCK5","text":"Required for RNA-mediated gene silencing (RNAi). Binds to short RNAs such as microRNAs (miRNAs) and represses the translation of mRNAs which are complementary to them. Lacks endonuclease activity and does not appear to cleave target mRNAs. Also required for RNA-directed transcription and replication of the human hapatitis delta virus (HDV)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}