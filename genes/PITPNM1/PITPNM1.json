,"gene_symbol":"PITPNM1","gene_symbol_current":"PITPNM1","gene_id":"ENSG00000110697","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.140346,"donor_lfcse":0.212475,"donor_log2fc_shrunk":3.18214e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"PITPNM1","gene_symbol_current":"PITPNM1","gene_id":"ENSG00000110697","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.997704,"donor_log2fc":-0.00478744,"donor_lfcse":0.231261,"donor_log2fc_shrunk":-0.000448466,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000110697","entrez_id":["9600"],"uniprot":["O00562"],"ncbi_summary":"PITPNM1 belongs to a family of membrane-associated phosphatidylinositol transfer domain-containing proteins that share homology with the Drosophila retinal degeneration B (rdgB) protein (Ocaka et al., 2005 [PubMed 15627748]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00562","text":"Membrane-associated phosphatidylinositol (PI) transfer protein that shuttles PI between intracellular membranes and thereby maintains plasma-membrane phosphoinositide signaling competence (PubMed:10531358, PubMed:22822086, PubMed:25887399, PubMed:26028218, PubMed:41129229). Transfers phosphatidylinositol from the endoplasmic reticulum to the plasma membrane and mediates counter-transport of phosphatidic acid (PA) from the plasma membrane to the endoplasmic reticulum at endoplasmic reticulum-plasma membrane contact sites, this PI/PA exchange is required for sustained PLC-coupled receptor signaling and for replenishment of plasma membrane phosphoinositide following receptor-induced hydrolysis (PubMed:10531358, PubMed:22822086, PubMed:26028218). Regulates RHOA activity, and plays a role in cytoskeleton remodeling (PubMed:11909959). Necessary for normal completion of cytokinesis (PubMed:15125835). Plays a role in maintaining normal diacylglycerol levels in the Golgi apparatus (PubMed:15723057). Necessary for maintaining the normal structure of the endoplasmic reticulum and the Golgi apparatus (PubMed:15545272). Required for protein export from the endoplasmic reticulum and the Golgi (PubMed:11909959, PubMed:15545272, PubMed:15723057)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}