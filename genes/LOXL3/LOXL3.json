cleus_score":-1.92471,"pct_ad":0.180883,"pct_control":0.194242,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.110949,"donor_lfcse":0.0979591,"donor_log2fc_shrunk":-1.19363e-05},{"cell_type":"Oli","gene_symbol":"LOXL3","gene_symbol_current":"LOXL3","gene_id":"ENSG00000115318","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.927821,"donor_log2fc":-0.115522,"donor_lfcse":0.201373,"donor_log2fc_shrunk":-0.00313653}],"modules":[{"cell_type":"In","gene_id":"ENSG00000115318","module":"blue","kme":0.131684,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000115318","module":"green","kme":0.160738,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000115318","entrez_id":["84695"],"uniprot":["P58215"],"ncbi_summary":"This gene encodes a lysyl oxidase, which likely functions as an amine oxidase and plays a role in the formation of crosslinks in collagens and elastin. Deletion of the related gene in mouse causes neonatal mortality with cleft palate, spine deformity, and defects in collagen organization. A mutation in this gene was found in a family with Stickler syndrome. [provided by RefSeq, Sep 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P58215","text":"Protein-lysine 6-oxidase that mediates the oxidation of peptidyl lysine residues to allysine in target proteins (PubMed:17018530, PubMed:28065600). Catalyzes the post-translational oxidative deamination of peptidyl lysine residues in precursors of elastin and different types of collagens, a prerequisite in the formation of cross-links between collagens and elastin (PubMed:17018530). Required for somite boundary formation by catalyzing oxidation of fibronectin (FN1), enhancing integrin signaling in myofibers and their adhesion to the myotendinous junction (MTJ) (By similarity). Acts as a regulator of inflammatory response by inhibiting differentiation of naive CD4(+) T-cells into T-helper Th17 or regulatory T-cells (Treg): acts by interacting with STAT3 in the nucleus and catalyzing both deacetylation and oxidation of lysine residues on STAT3, leading to disrupt STAT3 dimerization and inhibit STAT3 transcription activity (PubMed:28065600). Oxidation of lysine residues to allysine on STAT3 preferentially takes place on lysine residues that are acetylated (PubMed:28065600). Also able to catalyze deacetylation of lysine residues on STAT3 (PubMed:28065600). [Isoform 1]: Shows protein-lysine 6-oxidase activity toward elastin and different types of collagens, with the highest activity toward collagen type VIII (PubMed:17018530). [Isoform 2]: Shows protein-lysine 6-oxidase activity toward elastin and different types of collagens, with the highest activity toward collagen type IV (PubMed:17018530)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}