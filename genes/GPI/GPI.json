s_score":-0.914829,"pct_ad":0.643454,"pct_control":0.650466,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0293625,"donor_lfcse":0.133309,"donor_log2fc_shrunk":-1.67299e-06},{"cell_type":"Oli","gene_symbol":"GPI","gene_symbol_current":"GPI","gene_id":"ENSG00000105220","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":2.78842e-09,"nucleus_log2fc":-0.0919014,"nucleus_score":-6.10209,"pct_ad":0.522025,"pct_control":0.543582,"donor_test":"not significant","donor_padj":0.868586,"donor_log2fc":-0.0883794,"donor_lfcse":0.0982256,"donor_log2fc_shrunk":-0.00971564}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000105220","module":"turquoise","kme":0.0691158,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000105220","module":"blue","kme":0.186145,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000105220","entrez_id":["2821"],"uniprot":["P06744"],"ncbi_summary":"This gene encodes a member of the glucose phosphate isomerase protein family. The encoded protein has been identified as a moonlighting protein based on its ability to perform mechanistically distinct functions. In the cytoplasm, the gene product functions as a glycolytic enzyme (glucose-6-phosphate isomerase) that interconverts glucose-6-phosphate and fructose-6-phosphate. Extracellularly, the encoded protein (also referred to as neuroleukin) functions as a neurotrophic factor that promotes survival of skeletal motor neurons and sensory neurons, and as a lymphokine that induces immunoglobulin secretion. The encoded protein is also referred to as autocrine motility factor based on an additional function as a tumor-secreted cytokine and angiogenic factor. Defects in this gene are the cause of nonspherocytic hemolytic anemia and a severe enzyme deficiency can be associated with hydrops fetalis, immediate neonatal death and neurological impairment. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Aug 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P06744","text":"Isomerase that catalyzes the conversion of alpha-D-glucose-6-phosphate to beta-D-fructose-6-phosphate, the second step in glycolysis, and the reverse reaction in gluconeogenesis, within the cytoplasm (PubMed:28803808). Also shows C2-epimerase activity, interconverting D-glucose-6-phosphate (G6P) and D-mannose-6-phosphate (M6P) (By similarity). Also displays anomerase activity, interconverting alpha and beta-anomeric forms of G6P, D-fructose-6-phosphate and M6P (By similarity). In addition to its metabolic role, this enzyme functions extracellularly as a cytokine: acts as autocrine motility factor (AMF), a secreted angiogenic factor that enhances endothelial cell motility (PubMed:11437381). Functions as neuroleukin, a neurotrophic factor supporting the survival of spinal and sensory neurons (PubMed:11004567, PubMed:3352745). Released by lectin-stimulated T-cells to induce immunoglobulin secretion (PubMed:11004567, PubMed:3352745)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}