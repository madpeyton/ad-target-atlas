d":"ENSG00000115966","module":"black","kme":0.2691,"hub":false,"module_direction":"higher in AD","module_padj":0.685734,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000115966","module":"turquoise","kme":0.113353,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000115966"],"dataset_symbols":["ATF2"],"explorer":"explorer.html?dataset=mathys2019#gene/ATF2","cell_types":[{"cell_type":"Ast","gene_symbol":"ATF2","gene_symbol_current":"ATF2","gene_id":"ENSG00000115966","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.11655,"nucleus_log2fc":-0.272074,"nucleus_score":-1.95436,"pct_ad":0.105876,"pct_control":0.128822,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Ex","gene_symbol":"ATF2","gene_symbol_current":"ATF2","gene_id":"ENSG00000115966","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.0313289,"nucleus_log2fc":-0.0532856,"nucleus_score":-2.37842,"pct_ad":0.48527,"pct_control":0.514277,"donor_test":"not significant","donor_padj":0.99429,"donor_log2fc":0.013893,"donor_lfcse":0.065344,"donor_log2fc_shrunk":-1.15603e-05},{"cell_type":"In","gene_symbol":"ATF2","gene_symbol_current":"ATF2","gene_id":"ENSG00000115966","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.580972,"nucleus_log2fc":0.0737319,"nucleus_score":1.26864,"pct_ad":0.303017,"pct_control":0.282602,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.0949855,"donor_lfcse":0.0901317,"donor_log2fc_shrunk":1.21842e-05},{"cell_type":"OPC","gene_symbol":"ATF2","gene_symbol_current":"ATF2","gene_id":"ENSG00000115966","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.179475,"nucleus_log2fc":-0.312206,"nucleus_score":-2.25624,"pct_ad":0.156986,"pct_control":0.190805,"donor_test":"not significant","donor_padj":0.946461,"donor_log2fc":-0.215645,"donor_lfcse":0.149088,"donor_log2fc_shrunk":-0.0020062},{"cell_type":"Oli","gene_symbol":"ATF2","gene_symbol_current":"ATF2","gene_id":"ENSG00000115966","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.795115,"donor_log2fc":0.13226,"donor_lfcse":0.104457,"donor_log2fc_shrunk":0.0120304}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000115966","module":"red","kme":0.0959661,"hub":false,"module_direction":"lower in AD","module_padj":0.32433,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000115966","entrez_id":["1386"],"uniprot":["P15336"],"ncbi_summary":"This gene encodes a transcription factor that is a member of the leucine zipper family of DNA binding proteins. The encoded protein has been identified as a moonlighting protein based on its ability to perform mechanistically distinct functions This protein binds to the cAMP-responsive element (CRE), an octameric palindrome. It forms a homodimer or a heterodimer with c-Jun and stimulates CRE-dependent transcription. This protein is also a histone acetyltransferase (HAT) that specifically acetylates histones H2B and H4 in vitro; thus it may represent a class of sequence-specific factors that activate transcription by direct effects on chromatin components. The encoded protein may also be involved in cell's DNA damage response independent of its role in transcriptional regulation. Several alternatively spliced transcript variants have been found for this gene [provided by RefSeq, Jan 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P15336","text":"Transcriptional activator which regulates the transcription of various genes, including those involved in anti-apoptosis, cell growth, and DNA damage response (PubMed:11932306, PubMed:15105425, PubMed:15916964, PubMed:22304920, PubMed:2529117). Dependent on its binding partner, binds to CRE (cAMP response element) consensus sequences (5'-TGACGTCA-3') or to AP-1 (activator protein 1) consensus sequences (5'-TGACTCA-3') (PubMed:11932306, PubMed:2529117). In the nucleus, contributes to global transcription and the DNA damage response, in addition to specific transcriptional activities that are related to cell development, proliferation and death (PubMed:22304920). In liver, acts as a regulator of glucose metabolism downstream of OR5V1 signaling, which promotes ATF2 activation, leading to expression of carnitine palmitoyltransferase CPT1A (By similarity). In the cytoplasm, interacts with and perturbs HK1- and VDAC1-containing complexes at the mitochondrial outer membrane, thereby impairing mitochondrial membrane potential, inducing mitochondrial leakage and promoting cell death (PubMed:22304920). The phosphorylated form (mediated by ATM) plays a role in the DNA damage response and is involved in the ionizing radiation (IR)-induced S phase checkpoint control and in the recruitment of the MRN complex into the IR-induced foci (IRIF) (PubMed:15916964). In concert with CUL3 and RBX1, promotes the degradation of KAT5 thereby attenuating its ability to acetylate and activate ATM (PubMed:18397884). Can elicit oncogenic or tumor suppressor activities depending on the tissue or cell type (PubMed:18677098)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}