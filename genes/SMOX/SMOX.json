mbol_current":"SMOX","gene_id":"ENSG00000088826","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.75732e-06,"nucleus_log2fc":-0.0870863,"nucleus_score":-4.71232,"pct_ad":0.110534,"pct_control":0.11768,"donor_test":"not significant","donor_padj":0.840723,"donor_log2fc":-0.0465391,"donor_lfcse":0.0621544,"donor_log2fc_shrunk":-0.005332},{"cell_type":"Mic","gene_symbol":"SMOX","gene_symbol_current":"SMOX","gene_id":"ENSG00000088826","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.762505,"donor_log2fc":-0.143326,"donor_lfcse":0.140571,"donor_log2fc_shrunk":-0.0143247},{"cell_type":"OPC","gene_symbol":"SMOX","gene_symbol_current":"SMOX","gene_id":"ENSG00000088826","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":7.88598e-05,"nucleus_log2fc":0.220132,"nucleus_score":4.45201,"pct_ad":0.257531,"pct_control":0.223031,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.17892,"donor_lfcse":0.0823315,"donor_log2fc_shrunk":2.72603e-05},{"cell_type":"Oli","gene_symbol":"SMOX","gene_symbol_current":"SMOX","gene_id":"ENSG00000088826","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.722463,"donor_log2fc":0.159032,"donor_lfcse":0.104174,"donor_log2fc_shrunk":0.0163759}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000088826","entrez_id":["54498"],"uniprot":["Q9NWM0"],"ncbi_summary":"Polyamines are ubiquitous polycationic alkylamines which include spermine, spermidine, putrescine, and agmatine. These molecules participate in a broad range of cellular functions which include cell cycle modulation, scavenging reactive oxygen species, and the control of gene expression. These molecules also play important roles in neurotransmission through their regulation of cell-surface receptor activity, involvement in intracellular signalling pathways, and their putative roles as neurotransmitters. This gene encodes an FAD-containing enzyme that catalyzes the oxidation of spermine to spermadine and secondarily produces hydrogen peroxide. Multiple transcript variants encoding different isoenzymes have been identified for this gene, some of which have failed to demonstrate significant oxidase activity on natural polyamine substrates. The characterized isoenzymes have distinctive biochemical characteristics and substrate specificities, suggesting the existence of additional levels of complexity in polyamine catabolism. [provided by RefSeq, Jul 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NWM0","text":"Flavoenzyme which catalyzes the oxidation of spermine to spermidine. Can also use N(1)-acetylspermine and spermidine as substrates, with different affinity depending on the isoform (isozyme) and on the experimental conditions. Plays an important role in the regulation of polyamine intracellular concentration and has the potential to act as a determinant of cellular sensitivity to the antitumor polyamine analogs. May contribute to beta-alanine production via aldehyde dehydrogenase conversion of 3-amino-propanal."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}