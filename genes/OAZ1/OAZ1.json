.20463,"nucleus_score":4.43185,"pct_ad":0.353415,"pct_control":0.316342,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.190587,"donor_lfcse":0.149944,"donor_log2fc_shrunk":8.89644e-06,"degas_log2fc":0.462203,"degas_padj":4.27161e-21},{"cell_type":"Oli","gene_symbol":"OAZ1","gene_symbol_current":"OAZ1","gene_id":"ENSG00000104904","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0598682,"nucleus_log2fc":-0.0248473,"nucleus_score":-2.00949,"pct_ad":0.245992,"pct_control":0.253653,"donor_test":"not significant","donor_padj":0.948653,"donor_log2fc":0.072348,"donor_lfcse":0.172227,"donor_log2fc_shrunk":0.00300258,"degas_log2fc":0.299029,"degas_padj":1.19235e-35}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000104904","module":"turquoise","kme":0.167727,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000104904","module":"brown","kme":0.682223,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000104904","module":"brown","kme":0.557993,"hub":false,"module_direction":"lower in AD","module_padj":0.852428,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000104904","module":"red","kme":0.328052,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000104904","module":"turquoise","kme":0.223395,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000104904","module":"turquoise","kme":0.242148,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000104904","entrez_id":["4946"],"uniprot":["P54368"],"ncbi_summary":"The protein encoded by this gene belongs to the ornithine decarboxylase antizyme family, which plays a role in cell growth and proliferation by regulating intracellular polyamine levels. Expression of antizymes requires +1 ribosomal frameshifting, which is enhanced by high levels of polyamines. Antizymes in turn bind to and inhibit ornithine decarboxylase (ODC), the key enzyme in polyamine biosynthesis; thus, completing the auto-regulatory circuit. This gene encodes antizyme 1, the first member of the antizyme family, that has broad tissue distribution, and negatively regulates intracellular polyamine levels by binding to and targeting ODC for degradation, as well as inhibiting polyamine uptake. Antizyme 1 mRNA contains two potential in-frame AUGs; and studies in rat suggest that alternative use of the two translation initiation sites results in N-terminally distinct protein isoforms with different subcellular localization. Alternatively spliced transcript variants have also been noted for this gene. [provided by RefSeq, Dec 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P54368","text":"Ornithine decarboxylase (ODC) antizyme protein that negatively regulates ODC activity and intracellular polyamine biosynthesis and uptake in response to increased intracellular polyamine levels. Binds to ODC monomers, inhibiting the assembly of the functional ODC homodimer, and targets the monomers for ubiquitin-independent proteolytic destruction by the 26S proteasome (PubMed:17900240, PubMed:26305948, PubMed:26443277). Triggers ODC degradation by inducing the exposure of a cryptic proteasome-interacting surface of ODC (PubMed:26305948). Stabilizes AZIN2 by interfering with its ubiquitination (PubMed:17900240). Also inhibits cellular uptake of polyamines by inactivating the polyamine uptake transporter. SMAD1/OAZ1/PSMB4 complex mediates the degradation of the CREBBP/EP300 repressor SNIP1. Involved in the translocation of AZIN2 from ER-Golgi intermediate compartment (ERGIC) to the cytosol (PubMed:12097147)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}