s_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.910959,"donor_log2fc":-0.105931,"donor_lfcse":0.150999,"donor_log2fc_shrunk":-0.00499933}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000113645","module":"yellow","kme":0.316066,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000113645","module":"blue","kme":0.32619,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000113645","entrez_id":["23286"],"uniprot":["Q8IX03"],"ncbi_summary":"The protein encoded by this gene is a cytoplasmic phosphoprotein that interacts with PRKC-zeta and dynein light chain-1. Alleles of this gene have been found that enhance memory in some individuals. Three transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IX03","text":"Regulator of the Hippo signaling pathway, also known as the Salvador-Warts-Hippo (SWH) pathway (PubMed:24682284). Enhances phosphorylation of LATS1 and YAP1 and negatively regulates cell proliferation and organ growth due to a suppression of the transcriptional activity of YAP1, the major effector of the Hippo pathway (PubMed:24682284). Along with NF2 can synergistically induce the phosphorylation of LATS1 and LATS2 and function in the regulation of Hippo signaling pathway (PubMed:20159598). Acts as a transcriptional coactivator of ESR1 which plays an essential role in DYNLL1-mediated ESR1 transactivation (PubMed:16684779). Regulates collagen-stimulated activation of the ERK/MAPK cascade (PubMed:18190796). Modulates directional migration of podocytes (PubMed:18596123). Plays a role in cognition and memory performance (PubMed:18672031). Plays an important role in regulating AMPA-selective glutamate receptors (AMPARs) trafficking underlying synaptic plasticity and learning (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}