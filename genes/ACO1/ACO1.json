","module":"brown","kme":0.0973297,"hub":false,"module_direction":"lower in AD","module_padj":0.833818,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000122729"],"dataset_symbols":["ACO1"],"explorer":"explorer.html?dataset=mathys2019#gene/ACO1","cell_types":[{"cell_type":"Ast","gene_symbol":"ACO1","gene_symbol_current":"ACO1","gene_id":"ENSG00000122729","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.386569,"nucleus_log2fc":-0.191587,"nucleus_score":-1.12966,"pct_ad":0.0914634,"pct_control":0.103448,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Ex","gene_symbol":"ACO1","gene_symbol_current":"ACO1","gene_id":"ENSG00000122729","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.668467,"nucleus_log2fc":-0.000781612,"nucleus_score":-0.522923,"pct_ad":0.144149,"pct_control":0.147073,"donor_test":"not significant","donor_padj":0.996763,"donor_log2fc":0.0132977,"donor_lfcse":0.0903638,"donor_log2fc_shrunk":1.6906e-06},{"cell_type":"In","gene_symbol":"ACO1","gene_symbol_current":"ACO1","gene_id":"ENSG00000122729","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.891759,"nucleus_log2fc":-0.103208,"nucleus_score":-0.417472,"pct_ad":0.177462,"pct_control":0.178027,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0674817,"donor_lfcse":0.114798,"donor_log2fc_shrunk":-5.33676e-06}],"modules":[{"cell_type":"In","gene_id":"ENSG00000122729","module":"yellow","kme":0.148625,"hub":false,"module_direction":"lower in AD","module_padj":0.41964,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000122729","module":"red","kme":0.142882,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000122729","entrez_id":["48"],"uniprot":["P21399"],"ncbi_summary":"The protein encoded by this gene is a bifunctional, cytosolic protein that functions as an essential enzyme in the TCA cycle and interacts with mRNA to control the levels of iron inside cells. When cellular iron levels are high, this protein binds to a 4Fe-4S cluster and functions as an aconitase. Aconitases are iron-sulfur proteins that function to catalyze the conversion of citrate to isocitrate. When cellular iron levels are low, the protein binds to iron-responsive elements (IREs), which are stem-loop structures found in the 5' UTR of ferritin mRNA, and in the 3' UTR of transferrin receptor mRNA. When the protein binds to IRE, it results in repression of translation of ferritin mRNA, and inhibition of degradation of the otherwise rapidly degraded transferrin receptor mRNA. The encoded protein has been identified as a moonlighting protein based on its ability to perform mechanistically distinct functions. Alternative splicing results in multiple transcript variants [provided by RefSeq, Jan 2014].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P21399","text":"Bifunctional iron sensor that switches between 2 activities depending on iron availability (PubMed:1281544, PubMed:1946430, PubMed:8041788). Iron deprivation, promotes its mRNA binding activity through which it regulates the expression of genes involved in iron uptake, sequestration and utilization (PubMed:1281544, PubMed:1946430, PubMed:23891004, PubMed:8041788). Binds to iron-responsive elements (IRES) in the untranslated region of target mRNAs preventing for instance the translation of ferritin and aminolevulinic acid synthase and stabilizing the transferrin receptor mRNA (PubMed:1281544, PubMed:1946430, PubMed:23891004, PubMed:8041788). Conversely, when cellular iron levels are high, binds a 4Fe-4S cluster which precludes RNA binding activity and promotes the aconitase activity, the isomerization of citrate to isocitrate via cis-aconitate."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}