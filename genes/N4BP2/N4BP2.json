blue","kme":0.264499,"hub":false,"module_direction":"lower in AD","module_padj":0.137528,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000078177","entrez_id":["55728"],"uniprot":["Q86UW6"],"ncbi_summary":"This gene encodes a protein containing a polynucleotide kinase domain (PNK) near the N-terminal region, and a Small MutS Related (Smr) domain near the C-terminal region. The encoded protein can bind to both B-cell leukemia/lymphoma 3 (BCL-3) and neural precursor cell expressed, developmentally downregulated 4, (Nedd4) proteins. This protein binds and hydrolyzes ATP, may function as a 5'-polynucleotide kinase, and has the capacity to be a ubiquitylation substrate. This protein may play a role in transcription-coupled DNA repair or genetic recombination. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Jan 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86UW6","text":"Has 5'-polynucleotide kinase and nicking endonuclease activity. May play a role in DNA repair or recombination (PubMed:12730195). May play a role in the non-stop mRNA decay pathway (NSD), which specifically targets and degrades mRNAs that lack a proper stop codon (PubMed:40441874)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[{"accession":"Q86UW6","pdb_id":"9zwq","het_id":"ADP","resolution":1.95,"method":"X-ray diffraction","ligand_rule":"SUBJECT_OF_INVESTIGATION","datasets":["Mathys et al. 2019"],"ligand_name":"ADP","ligand_class":"cofactor or substrate","ligand_note":null,"entry_title":"Crystal structure of the N4BP2 polynucleotide kinase (PNK) domain in complex with ADP and Mg.","first_author":"Wang, H.","n_authors":2,"journal":"Nat Commun","year":2026,"doi":null,"citation_url":null},{"accession":"Q86UW6","pdb_id":"9zws","het_id":"ATP","resolution":2.0,"method":"