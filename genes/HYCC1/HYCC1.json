47}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000122591","module":"red","kme":0.157087,"hub":false,"module_direction":"lower in AD","module_padj":0.641133,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000122591","entrez_id":["84668"],"uniprot":["Q9BYI3"],"ncbi_summary":"The protein encoded by this gene may play a part in the beta-catenin/Lef signaling pathway. Expression of this gene is down-regulated by beta-catenin. Defects in this gene are a cause of hypomyelination with congenital cataract (HCC). [provided by RefSeq, Oct 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BYI3","text":"Component of a complex required to localize phosphatidylinositol 4-kinase (PI4K) to the plasma membrane (PubMed:26571211). The complex acts as a regulator of phosphatidylinositol 4-phosphate (PtdIns(4)P) synthesis (PubMed:26571211). HYCC1 plays a key role in oligodendrocytes formation, a cell type with expanded plasma membrane that requires generation of PtdIns(4)P (PubMed:26571211). Its role in oligodendrocytes formation probably explains its importance in myelination of the central and peripheral nervous system (PubMed:16951682, PubMed:26571211). May also have a role in the beta-catenin/Lef signaling pathway (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}