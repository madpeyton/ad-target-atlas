ymbols":["CA4"],"explorer":"explorer.html?dataset=seaad_pfc#gene/CA4","cell_types":[{"cell_type":"Ast","gene_symbol":"CA4","gene_symbol_current":"CA4","gene_id":"ENSG00000167434","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.900114,"donor_log2fc":-0.152885,"donor_lfcse":0.229629,"donor_log2fc_shrunk":-0.00175981},{"cell_type":"Ex","gene_symbol":"CA4","gene_symbol_current":"CA4","gene_id":"ENSG00000167434","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":7.52426e-61,"nucleus_log2fc":-0.132504,"nucleus_score":-16.5233,"pct_ad":0.24831,"pct_control":0.27914,"donor_test":"not significant","donor_padj":0.978787,"donor_log2fc":-0.0199847,"donor_lfcse":0.205116,"donor_log2fc_shrunk":-0.000427938},{"cell_type":"In","gene_symbol":"CA4","gene_symbol_current":"CA4","gene_id":"ENSG00000167434","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.769236,"donor_log2fc":-0.174843,"donor_lfcse":0.151717,"donor_log2fc_shrunk":-0.0036661},{"cell_type":"Oli","gene_symbol":"CA4","gene_symbol_current":"CA4","gene_id":"ENSG00000167434","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.753837,"donor_log2fc":-0.329617,"donor_lfcse":0.233306,"donor_log2fc_shrunk":-0.00670922}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000167434","module":"blue","kme":0.246476,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000167434","entrez_id":["762"],"uniprot":["P22748"],"ncbi_summary":"Carbonic anhydrases (CAs) are a large family of zinc metalloenzymes that catalyze the reversible hydration of carbon dioxide. They participate in a variety of biological processes, including respiration, calcification, acid-base balance, bone resorption, and the formation of aqueous humor, cerebrospinal fluid, saliva, and gastric acid. They show extensive diversity in tissue distribution and in their subcellular localization. This gene encodes a glycosylphosphatidyl-inositol-anchored membrane isozyme expressed on the luminal surfaces of pulmonary (and certain other) capillaries and proximal renal tubules. Its exact function is not known; however, it may have a role in inherited renal abnormalities of bicarbonate transport. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P22748","text":"Catalyzes the reversible hydration of carbon dioxide into bicarbonate and protons and thus is essential to maintaining intracellular and extracellular pH (PubMed:15563508, PubMed:16686544, PubMed:16807956, PubMed:17127057, PubMed:17314045, PubMed:17652713, PubMed:17705204, PubMed:19186056, PubMed:19206230, PubMed:7625839, PubMed:9054574). May stimulate the sodium/bicarbonate transporter activity of SLC4A4 that acts in pH homeostasis (PubMed:15563508). It is essential for acid overload removal from the retina and retina epithelium, and acid release in the choriocapillaris in the choroid (PubMed:15563508)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}