s_padj":0.0509974},{"cell_type":"Oli","gene_symbol":"HOPX","gene_symbol_current":"HOPX","gene_id":"ENSG00000171476","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.987593,"donor_log2fc":0.0222939,"donor_lfcse":0.22119,"donor_log2fc_shrunk":0.000727844,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000171476","module":"pink","kme":0.315044,"hub":false,"module_direction":"lower in AD","module_padj":0.531952,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000171476","module":"blue","kme":0.474243,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000171476","module":"turquoise","kme":0.0431891,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000171476","module":"turquoise","kme":0.0317065,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000171476","entrez_id":["84525"],"uniprot":["Q9BPY8"],"ncbi_summary":"The protein encoded by this gene is a homeodomain protein that lacks certain conserved residues required for DNA binding. It was reported that choriocarcinoma cell lines and tissues failed to express this gene, which suggested the possible involvement of this gene in malignant conversion of placental trophoblasts. Studies in mice suggest that this protein may interact with serum response factor (SRF) and modulate SRF-dependent cardiac-specific gene expression and cardiac development. Multiple alternatively spliced transcript variants have been identified for this gene. [provided by RefSeq, Feb 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BPY8","text":"Atypical homeodomain protein which does not bind DNA and is required to modulate cardiac growth and development. Acts via its interaction with SRF, thereby modulating the expression of SRF-dependent cardiac-specific genes and cardiac development. Prevents SRF-dependent transcription either by inhibiting SRF binding to DNA or by recruiting histone deacetylase (HDAC) proteins that prevent transcription by SRF. Overexpression causes cardiac hypertrophy (By similarity). May act as a tumor suppressor. Acts as a co-chaperone for HSPA1A and HSPA1B chaperone proteins and assists in chaperone-mediated protein refolding (PubMed:27708256)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}