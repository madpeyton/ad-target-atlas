:0.577304,"donor_test":"significant","donor_padj":0.0235768,"donor_log2fc":-0.189558,"donor_lfcse":0.0452254,"donor_log2fc_shrunk":-0.168654,"degas_log2fc":0.101987,"degas_padj":0.00112383},{"cell_type":"OPC","gene_symbol":"YTHDC2","gene_symbol_current":"YTHDC2","gene_id":"ENSG00000047188","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.458352,"nucleus_log2fc":-0.0361673,"nucleus_score":-1.02963,"pct_ad":0.621086,"pct_control":0.627434,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0430102,"donor_lfcse":0.0636072,"donor_log2fc_shrunk":-1.10842e-05,"degas_log2fc":-0.294942,"degas_padj":3.97694e-20},{"cell_type":"Oli","gene_symbol":"YTHDC2","gene_symbol_current":"YTHDC2","gene_id":"ENSG00000047188","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.24109e-07,"nucleus_log2fc":-0.0895698,"nucleus_score":-5.44488,"pct_ad":0.414917,"pct_control":0.436917,"donor_test":"not significant","donor_padj":0.98957,"donor_log2fc":-0.00645114,"donor_lfcse":0.0714579,"donor_log2fc_shrunk":-0.00135434,"degas_log2fc":-0.188893,"degas_padj":2.12315e-26}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000047188","entrez_id":["64848"],"uniprot":["Q9H6S0"],"ncbi_summary":"This gene encodes a member of the DEAH (Asp-Glu-Ala-His) subfamily of proteins, part of the DEAD (Asp-Glu-Ala-Asp) box family of RNA helicases. The encoded protein binds to N6-methyladenosine, a common modified RNA nucleotide that is enriched in the stop codons and 3' UTRs of eukaryotic messenger RNAs. Binding of proteins to this modified nucleotide may regulate mRNA translation and stability. This gene may be associated with susceptibility to pancreatic cancer in human patients, and knockdown of this gene resulted in reduced proliferation in a human liver cancer cell line. [provided by RefSeq, Sep 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H6S0","text":"3'-5' RNA helicase that plays a key role in the male and female germline by promoting transition from mitotic to meiotic divisions in stem cells (PubMed:26318451, PubMed:29033321, PubMed:29970596). Specifically recognizes and binds N6-methyladenosine (m6A)-containing RNAs, a modification present at internal sites of mRNAs and some non-coding RNAs that plays a role in the efficiency of RNA processing and stability (PubMed:26318451, PubMed:29033321). Essential for ensuring a successful progression of the meiotic program in the germline by regulating the level of m6A-containing RNAs (By similarity). Acts by binding and promoting degradation of m6A-containing mRNAs: the 3'-5' RNA helicase activity is required for this process and RNA degradation may be mediated by XRN1 exoribonuclease (PubMed:29033321). Required for both spermatogenesis and oogenesis (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}