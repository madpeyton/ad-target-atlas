st":"not significant","donor_padj":0.830712,"donor_log2fc":-0.0724538,"donor_lfcse":0.0905953,"donor_log2fc_shrunk":-0.00403588,"degas_log2fc":0.266861,"degas_padj":1.58619e-26},{"cell_type":"Mic","gene_symbol":"NTHL1","gene_symbol_current":"NTHL1","gene_id":"ENSG00000065057","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.994638,"donor_log2fc":-0.0068058,"donor_lfcse":0.206919,"donor_log2fc_shrunk":-0.000336259,"degas_log2fc":null,"degas_padj":null},{"cell_type":"OPC","gene_symbol":"NTHL1","gene_symbol_current":"NTHL1","gene_id":"ENSG00000065057","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.109471,"donor_lfcse":0.160959,"donor_log2fc_shrunk":-4.43002e-06,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"NTHL1","gene_symbol_current":"NTHL1","gene_id":"ENSG00000065057","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.914259,"donor_log2fc":0.101019,"donor_lfcse":0.149488,"donor_log2fc_shrunk":0.00496222,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000065057","module":"turquoise","kme":0.0389453,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000065057","entrez_id":["4913"],"uniprot":["P78549"],"ncbi_summary":"The protein encoded by this gene is a DNA N-glycosylase of the endonuclease III family. Like a similar protein in E. coli, the encoded protein has DNA glycosylase activity on DNA substrates containing oxidized pyrimidine residues and has apurinic/apyrimidinic lyase activity. [provided by RefSeq, Oct 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P78549","text":"Bifunctional DNA N-glycosylase with associated apurinic/apyrimidinic (AP) lyase function that catalyzes the first step in base excision repair (BER), the primary repair pathway for the repair of oxidative DNA damage (PubMed:29610152, PubMed:9927729). The DNA N-glycosylase activity releases the damaged DNA base from DNA by cleaving the N-glycosidic bond, leaving an AP site. The AP-lyase activity cleaves the phosphodiester bond 3' to the AP site by a beta-elimination. Primarily recognizes and repairs oxidative base damage of pyrimidines. Also has 8-oxo-7,8-dihydroguanine (8-oxoG) DNA glycosylase activity. Acts preferentially on DNA damage opposite guanine residues in DNA. Is able to process lesions in nucleosomes without requiring or inducing nucleosome disruption."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}