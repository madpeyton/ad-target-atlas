rol":0.166544,"donor_test":"not significant","donor_padj":0.987145,"donor_log2fc":-0.00163819,"donor_lfcse":0.0419521,"donor_log2fc_shrunk":-0.000578498},{"cell_type":"Inhibitory","gene_symbol":"CAD","gene_symbol_current":"CAD","gene_id":"ENSG00000084774","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.586554,"donor_log2fc":-0.0607366,"donor_lfcse":0.0500454,"donor_log2fc_shrunk":-0.016303},{"cell_type":"Microglia","gene_symbol":"CAD","gene_symbol_current":"CAD","gene_id":"ENSG00000084774","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"filtered (low counts, not tested at FDR)","donor_padj":null,"donor_log2fc":0.087017,"donor_lfcse":0.0858953,"donor_log2fc_shrunk":0.0131984},{"cell_type":"Oligodendroglia","gene_symbol":"CAD","gene_symbol_current":"CAD","gene_id":"ENSG00000084774","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.960736,"donor_log2fc":-0.00490726,"donor_lfcse":0.0466882,"donor_log2fc_shrunk":-0.00217895}],"modules":[],"degas_bulk_de":true,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000084774"],"dataset_symbols":["CAD"],"explorer":"explorer.html?dataset=mathys2019#gene/CAD","cell_types":[{"cell_type":"Ex","gene_symbol":"CAD","gene_symbol_current":"CAD","gene_id":"ENSG00000084774","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.990685,"donor_log2fc":0.0333367,"donor_lfcse":0.0938322,"donor_log2fc_shrunk":-1.28796e-06}],"modules":[],"degas_bulk_de":true,"drug_target":false}},"description":[{"gene_id":"ENSG00000084774","entrez_id":["790"],"uniprot":["P27708"],"ncbi_summary":"The de novo synthesis of pyrimidine nucleotides is required for mammalian cells to proliferate. This gene encodes a trifunctional protein which is associated with the enzymatic activities of the first 3 enzymes in the 6-step pathway of pyrimidine biosynthesis: carbamoylphosphate synthetase (CPS II), aspartate transcarbamoylase, and dihydroorotase. This protein is regulated by the mitogen-activated protein kinase (MAPK) cascade, which indicates a direct link between activation of the MAPK cascade and de novo biosynthesis of pyrimidine nucleotides. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Apr 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P27708","text":"Multifunctional protein that encodes the first 3 enzymatic activities of the de novo pyrimidine pathway: carbamoylphosphate synthetase (CPSase; EC 6.3.5.5), aspartate transcarbamylase (ATCase; EC 2.1.3.2) and dihydroorotase (DHOase; EC 3.5.2.3). The CPSase-function is accomplished in 2 steps, by a glutamine-dependent amidotransferase activity (GATase) that binds and cleaves glutamine to produce ammonia, followed by an ammonium-dependent carbamoyl phosphate synthetase, which reacts with the ammonia, hydrogencarbonate and ATP to form carbamoyl phosphate. The endogenously produced carbamoyl phosphate is sequestered and channeled to the ATCase active site. ATCase then catalyzes the formation of carbamoyl-L-aspartate from L-aspartate and carbamoyl phosphate. In the last step, DHOase catalyzes the cyclization of carbamoyl aspartate to dihydroorotate."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}