:0.170311,"pct_control":0.165679,"donor_test":"not significant","donor_padj":0.897717,"donor_log2fc":0.0160869,"donor_lfcse":0.0503067,"donor_log2fc_shrunk":0.00538608},{"cell_type":"Inhibitory","gene_symbol":"POMK","gene_symbol_current":"POMK","gene_id":"ENSG00000185900","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0190036,"nucleus_log2fc":0.05259,"nucleus_score":2.64602,"pct_ad":0.102794,"pct_control":0.0970802,"donor_test":"not significant","donor_padj":0.873856,"donor_log2fc":0.0224988,"donor_lfcse":0.0493553,"donor_log2fc_shrunk":0.00552868},{"cell_type":"Oligodendroglia","gene_symbol":"POMK","gene_symbol_current":"POMK","gene_id":"ENSG00000185900","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.660391,"donor_log2fc":-0.0433469,"donor_lfcse":0.0568403,"donor_log2fc_shrunk":-0.0158536}],"modules":[],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000185900"],"dataset_symbols":["POMK"],"explorer":"explorer.html?dataset=mathys2019#gene/POMK","cell_types":[{"cell_type":"Ex","gene_symbol":"POMK","gene_symbol_current":"POMK","gene_id":"ENSG00000185900","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999899,"donor_log2fc":0.0031613,"donor_lfcse":0.130556,"donor_log2fc_shrunk":1.97831e-07}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000185900","entrez_id":["84197"],"uniprot":["Q9H5K3"],"ncbi_summary":"This gene encodes a protein that may be involved in the presentation of the laminin-binding O-linked carbohydrate chain of alpha-dystroglycan (a-DG), which forms transmembrane linkages between the extracellular matrix and the exoskeleton. Some pathogens use this O-linked carbohydrate unit for host entry. Loss of function compound heterozygous mutations in this gene were found in a human patient affected by the Walker-Warburg syndrome (WWS) phenotype. Mice lacking this gene contain misplaced neurons (heterotopia) in some regions of the brain, possibly from defects in neuronal migration. Alternative splicing of this gene results in multiple transcript variants. [provided by RefSeq, May 2013].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9H5K3","text":"Protein O-mannose kinase that specifically mediates phosphorylation at the 6-position of an O-mannose of the trisaccharide (N-acetylgalactosamine (GalNAc)-beta-1,3-N-acetylglucosamine (GlcNAc)-beta-1,4-mannose) to generate phosphorylated O-mannosyl trisaccharide (N-acetylgalactosamine-beta-1,3-N-acetylglucosamine-beta-1,4-(phosphate-6-)mannose). Phosphorylated O-mannosyl trisaccharide is a carbohydrate structure present in alpha-dystroglycan (DAG1), which is required for binding laminin G-like domain-containing extracellular proteins with high affinity. Only shows kinase activity when the GalNAc-beta-3-GlcNAc-beta-terminus is linked to the 4-position of O-mannose, suggesting that this disaccharide serves as the substrate recognition motif."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}