3].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O75935","text":"Part of the dynactin complex that activates the molecular motor dynein for ultra-processive transport along microtubules (By similarity). Together with dynein may be involved in spindle assembly and cytokinesis (PubMed:9722614)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}