test":"not significant","donor_padj":0.465072,"donor_log2fc":0.108346,"donor_lfcse":0.0781745,"donor_log2fc_shrunk":0.0216436},{"cell_type":"Inhibitory","gene_symbol":"INTS5","gene_symbol_current":"INTS5","gene_id":"ENSG00000185085","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.887687,"donor_log2fc":-0.0301592,"donor_lfcse":0.0735119,"donor_log2fc_shrunk":-0.00379431},{"cell_type":"Oligodendroglia","gene_symbol":"INTS5","gene_symbol_current":"INTS5","gene_id":"ENSG00000185085","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.432265,"donor_log2fc":0.109979,"donor_lfcse":0.0838405,"donor_log2fc_shrunk":0.0256928}],"modules":[{"cell_type":"CUX2-","gene_id":"ENSG00000185085","module":"turquoise","kme":0.149714,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000185085"],"dataset_symbols":["INTS5"],"explorer":"explorer.html?dataset=mathys2019#gene/INTS5","cell_types":[{"cell_type":"Ex","gene_symbol":"INTS5","gene_symbol_current":"INTS5","gene_id":"ENSG00000185085","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":0.165279,"donor_lfcse":0.162197,"donor_log2fc_shrunk":7.52351e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000185085","module":"turquoise","kme":0.155089,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000185085","entrez_id":["80789"],"uniprot":["Q6P9B9"],"ncbi_summary":"The Integrator complex is a complex that associates with the C-terminal domain of RNA polymerase II large subunit. This complex is brought to U1 and U2 small nuclear RNA genes, where it is involved in the transcription and processing of their transcripts. The protein encoded by this gene represents a subunit of the Integrator complex. [provided by RefSeq, Aug 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6P9B9","text":"Component of the integrator complex, a multiprotein complex that terminates RNA polymerase II (Pol II) transcription in the promoter-proximal region of genes (PubMed:33243860, PubMed:38570683). The integrator complex provides a quality checkpoint during transcription elongation by driving premature transcription termination of transcripts that are unfavorably configured for transcriptional elongation: the complex terminates transcription by (1) catalyzing dephosphorylation of the C-terminal domain (CTD) of Pol II subunit POLR2A/RPB1 and SUPT5H/SPT5, (2) degrading the exiting nascent RNA transcript via endonuclease activity and (3) promoting the release of Pol II from bound DNA (PubMed:33243860, PubMed:38570683). The integrator complex is also involved in terminating the synthesis of non-coding Pol II transcripts, such as enhancer RNAs (eRNAs), small nuclear RNAs (snRNAs), telomerase RNAs and long non-coding RNAs (lncRNAs) (PubMed:16239144). Mediates recruitment of cytoplasmic dynein to the nuclear envelope, probably as component of the integrator complex (PubMed:23904267)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}