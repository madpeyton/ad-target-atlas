us_score":-0.187486,"pct_ad":0.160899,"pct_control":0.160056,"donor_test":"not significant","donor_padj":0.837152,"donor_log2fc":-0.0284897,"donor_lfcse":0.05948,"donor_log2fc_shrunk":-0.00765177},{"cell_type":"Inhibitory","gene_symbol":"MLYCD","gene_symbol_current":"MLYCD","gene_id":"ENSG00000103150","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.254707,"nucleus_log2fc":-0.0740994,"nucleus_score":-1.36223,"pct_ad":0.136851,"pct_control":0.139024,"donor_test":"not significant","donor_padj":0.867619,"donor_log2fc":-0.0291077,"donor_lfcse":0.0609055,"donor_log2fc_shrunk":-0.00428547},{"cell_type":"Microglia","gene_symbol":"MLYCD","gene_symbol_current":"MLYCD","gene_id":"ENSG00000103150","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.729957,"donor_log2fc":0.0752448,"donor_lfcse":0.0923749,"donor_log2fc_shrunk":0.00927849},{"cell_type":"Oligodendroglia","gene_symbol":"MLYCD","gene_symbol_current":"MLYCD","gene_id":"ENSG00000103150","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.660049,"donor_log2fc":-0.0461284,"donor_lfcse":0.0604222,"donor_log2fc_shrunk":-0.0157669}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000103150","entrez_id":["23417"],"uniprot":["O95822"],"ncbi_summary":"The product of this gene catalyzes the breakdown of malonyl-CoA to acetyl-CoA and carbon dioxide. Malonyl-CoA is an intermediate in fatty acid biosynthesis, and also inhibits the transport of fatty acyl CoAs into mitochondria. Consequently, the encoded protein acts to increase the rate of fatty acid oxidation. It is found in mitochondria, peroxisomes, and the cytoplasm. Mutations in this gene result in malonyl-CoA decarboyxlase deficiency. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O95822","text":"Catalyzes the conversion of malonyl-CoA to acetyl-CoA. In the fatty acid biosynthesis MCD selectively removes malonyl-CoA and thus assures that methyl-malonyl-CoA is the only chain elongating substrate for fatty acid synthase and that fatty acids with multiple methyl side chains are produced. In peroxisomes it may be involved in degrading intraperoxisomal malonyl-CoA, which is generated by the peroxisomal beta-oxidation of odd chain-length dicarboxylic fatty acids. Plays a role in the metabolic balance between glucose and lipid oxidation in muscle independent of alterations in insulin signaling. May play a role in controlling the extent of ischemic injury by promoting glucose oxidation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}