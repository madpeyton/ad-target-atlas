wer in AD","nucleus_padj":0.206621,"nucleus_log2fc":-0.0863477,"nucleus_score":-1.64969,"pct_ad":0.355204,"pct_control":0.365453,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0641897,"donor_lfcse":0.0828593,"donor_log2fc_shrunk":-9.67638e-06,"degas_log2fc":-0.0934123,"degas_padj":0.0517073},{"cell_type":"Oli","gene_symbol":"ABCA3","gene_symbol_current":"ABCA3","gene_id":"ENSG00000167972","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.868098,"nucleus_log2fc":0.0226751,"nucleus_score":0.196574,"pct_ad":0.27043,"pct_control":0.271215,"donor_test":"not significant","donor_padj":0.844947,"donor_log2fc":0.0940488,"donor_lfcse":0.0896786,"donor_log2fc_shrunk":0.0120243,"degas_log2fc":-0.0683554,"degas_padj":0.00300642}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000167972","module":"yellow","kme":0.144899,"hub":false,"module_direction":"higher in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000167972","module":"turquoise","kme":0.081987,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000167972","module":"blue","kme":0.0845497,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000167972","entrez_id":["21"],"uniprot":["Q99758"],"ncbi_summary":"The membrane-associated protein encoded by this gene is a member of the superfamily of ATP-binding cassette (ABC) transporters.  ABC proteins transport various molecules across extra- and intracellular membranes.  ABC genes are divided into seven distinct subfamilies (ABC1, MDR/TAP, MRP, ALD, OABP, GCN20, White).  This protein is a member of the ABC1 subfamily.  Members of the ABC1 subfamily comprise the only major ABC subfamily found exclusively in multicellular eukaryotes.  The full transporter encoded by this gene may be involved in development of resistance to xenobiotics and engulfment during programmed cell death. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q99758","text":"Catalyzes the ATP-dependent transport of phospholipids such as phosphatidylcholine and phosphoglycerol from the cytoplasm into the lumen side of lamellar bodies, in turn participates in the lamellar bodies biogenesis and homeostasis of pulmonary surfactant (PubMed:16959783, PubMed:17574245, PubMed:27177387, PubMed:28887056, PubMed:31473345). Transports preferentially phosphatidylcholine containing short acyl chains (PubMed:27177387). In addition plays a role as an efflux transporter of miltefosine across macrophage membranes and free cholesterol (FC) through intralumenal vesicles by removing FC from the cell as a component of surfactant and protects cells from free cholesterol toxicity (PubMed:25817392, PubMed:26903515, PubMed:27177387)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}