nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":6.9148e-09,"nucleus_log2fc":-0.432409,"nucleus_score":-6.30238,"pct_ad":0.130778,"pct_control":0.170195,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.306666,"donor_lfcse":0.166825,"donor_log2fc_shrunk":-1.12006e-05},{"cell_type":"Oli","gene_symbol":"OSBPL10","gene_symbol_current":"OSBPL10","gene_id":"ENSG00000144645","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.885426,"donor_log2fc":-0.128743,"donor_lfcse":0.155369,"donor_log2fc_shrunk":-0.00578483}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000144645","module":"blue","kme":0.145338,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000144645","module":"yellow","kme":0.381225,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000144645","module":"magenta","kme":0.534179,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000144645","module":"turquoise","kme":0.123886,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000144645","module":"brown","kme":0.0995103,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000144645","entrez_id":["114884"],"uniprot":["Q9BXB5"],"ncbi_summary":"This gene encodes a member of the oxysterol-binding protein (OSBP) family, a group of intracellular lipid receptors. Like most members, the encoded protein contains an N-terminal pleckstrin homology domain and a highly conserved C-terminal OSBP-like sterol-binding domain. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BXB5","text":"Lipid transporter involved in lipid countertransport between the endoplasmic reticulum and the plasma membrane. Its ability to bind phosphatidylserine, suggests that it specifically exchanges phosphatidylserine with phosphatidylinositol 4-phosphate (PI4P), delivering phosphatidylserine to the plasma membrane in exchange for PI4P (Probable) (PubMed:23934110). Plays a role in negative regulation of lipid biosynthesis (PubMed:19554302). Interacts with OSBPL9 to function as lipid transfer proteins (PubMed:36853333). Together they form a heterodimer that localizes at the ER-trans-Golgi membrane contact sites, and exchanges phosphatidylserine (1,2-diacyl-sn-glycero-3-phospho-L-serine, PS) for phosphatidylinositol-4-phosphate (1,2-diacyl-sn-glycero-3-phospho-(1D-myo-inositol 4-phosphate), PI(4)P) between the two organelles, a step that is critical for sphingomyelin synthesis in the Golgi complex (PubMed:36853333). Negatively regulates APOB secretion from hepatocytes (PubMed:19554302, PubMed:22906437). Binds cholesterol and acidic phospholipids (PubMed:22906437). Also binds 25-hydroxycholesterol (PubMed:17428193). Binds phosphatidylserine (PubMed:23934110)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}