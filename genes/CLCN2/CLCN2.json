,"gene_symbol_current":"CLCN2","gene_id":"ENSG00000114859","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.802144,"nucleus_log2fc":-0.00144517,"nucleus_score":0.297717,"pct_ad":0.159539,"pct_control":0.157938,"donor_test":"not significant","donor_padj":0.969143,"donor_log2fc":0.025246,"donor_lfcse":0.1216,"donor_log2fc_shrunk":0.000980865},{"cell_type":"Ex","gene_symbol":"CLCN2","gene_symbol_current":"CLCN2","gene_id":"ENSG00000114859","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.21297e-09,"nucleus_log2fc":-0.0263315,"nucleus_score":-5.97688,"pct_ad":0.189808,"pct_control":0.201364,"donor_test":"not significant","donor_padj":0.983211,"donor_log2fc":0.00462308,"donor_lfcse":0.058956,"donor_log2fc_shrunk":0.00152199},{"cell_type":"In","gene_symbol":"CLCN2","gene_symbol_current":"CLCN2","gene_id":"ENSG00000114859","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.142536,"nucleus_log2fc":-0.0122046,"nucleus_score":-1.52904,"pct_ad":0.178794,"pct_control":0.181989,"donor_test":"not significant","donor_padj":0.806194,"donor_log2fc":0.0702717,"donor_lfcse":0.0760943,"donor_log2fc_shrunk":0.0055289},{"cell_type":"Mic","gene_symbol":"CLCN2","gene_symbol_current":"CLCN2","gene_id":"ENSG00000114859","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.827275,"donor_log2fc":-0.16094,"donor_lfcse":0.19726,"donor_log2fc_shrunk":-0.00842462},{"cell_type":"OPC","gene_symbol":"CLCN2","gene_symbol_current":"CLCN2","gene_id":"ENSG00000114859","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.