6"],"dataset_symbols":["PLA2R1"],"explorer":"explorer.html?dataset=mathys2019#gene/PLA2R1","cell_types":[{"cell_type":"Ex","gene_symbol":"PLA2R1","gene_symbol_current":"PLA2R1","gene_id":"ENSG00000153246","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.00192855,"nucleus_log2fc":-0.129145,"nucleus_score":-3.36802,"pct_ad":0.177265,"pct_control":0.195486,"donor_test":"not significant","donor_padj":0.986149,"donor_log2fc":-0.0630941,"donor_lfcse":0.120952,"donor_log2fc_shrunk":-4.48649e-06},{"cell_type":"In","gene_symbol":"PLA2R1","gene_symbol_current":"PLA2R1","gene_id":"ENSG00000153246","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.941769,"nucleus_log2fc":-0.104563,"nucleus_score":-0.25042,"pct_ad":0.142857,"pct_control":0.144102,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0759177,"donor_lfcse":0.149279,"donor_log2fc_shrunk":-3.99567e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000153246","module":"brown","kme":0.176435,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000153246","module":"brown","kme":0.200017,"hub":false,"module_direction":"lower in AD","module_padj":0.372712,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000153246","entrez_id":["22925"],"uniprot":["Q13018"],"ncbi_summary":"This gene represents a phospholipase A2 receptor. The encoded protein likely exists as both a transmembrane form and a soluble form. The transmembrane receptor may play a role in clearance of phospholipase A2, thereby inhibiting its action. Polymorphisms at this locus have been associated with susceptibility to idiopathic membranous nephropathy. Alternatively spliced transcript variants encoding different isoforms have been identified.[provided by RefSeq, Sep 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q13018","text":"Receptor for secretory phospholipase A2 (sPLA2). Acts as a receptor for phospholipase sPLA2-IB/PLA2G1B but not sPLA2-IIA/PLA2G2A. Also able to bind to snake PA2-like toxins. Although its precise function remains unclear, binding of sPLA2 to its receptor participates in both positive and negative regulation of sPLA2 functions as well as clearance of sPLA2. Binding of sPLA2-IB/PLA2G1B induces various effects depending on the cell type, such as activation of the mitogen-activated protein kinase (MAPK) cascade to induce cell proliferation, the production of lipid mediators, selective release of arachidonic acid in bone marrow-derived mast cells. In neutrophils, binding of sPLA2-IB/PLA2G1B can activate p38 MAPK to stimulate elastase release and cell adhesion. May be involved in responses in pro-inflammatory cytokine productions during endotoxic shock. Also has endocytic properties and rapidly internalizes sPLA2 ligands, which is particularly important for the clearance of extracellular sPLA2s to protect their potent enzymatic activities. The soluble secretory phospholipase A2 receptor form is circulating and acts as a negative regulator of sPLA2 functions by blocking the biological functions of sPLA2-IB/PLA2G1B (PubMed:15611272, PubMed:7721806). In podocytes, binding of sPLA2-IB/PLA2G1B can regulate podocyte survival and glomerular homeostasis (PubMed:25335547)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}