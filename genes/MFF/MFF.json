ot_function":[{"accession":"Q9GZY8","text":"Plays a role in mitochondrial and peroxisomal fission (PubMed:18353969, PubMed:23530241, PubMed:24196833). Promotes the recruitment and association of the fission mediator dynamin-related protein 1 (DNM1L) to the mitochondrial surface (PubMed:23530241). May be involved in regulation of synaptic vesicle membrane dynamics by recruitment of DNM1L to clathrin-containing vesicles (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}