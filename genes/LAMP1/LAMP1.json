ell_type":"In","gene_symbol":"LAMP1","gene_symbol_current":"LAMP1","gene_id":"ENSG00000185896","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.522248,"nucleus_log2fc":0.0846502,"nucleus_score":1.4115,"pct_ad":0.166815,"pct_control":0.149704,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.151164,"donor_lfcse":0.121142,"donor_log2fc_shrunk":-9.23998e-06},{"cell_type":"OPC","gene_symbol":"LAMP1","gene_symbol_current":"LAMP1","gene_id":"ENSG00000185896","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.935413,"nucleus_log2fc":0.105616,"nucleus_score":0.207668,"pct_ad":0.133438,"pct_control":0.133333,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"Oli","gene_symbol":"LAMP1","gene_symbol_current":"LAMP1","gene_id":"ENSG00000185896","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.25573e-17,"nucleus_log2fc":0.500478,"nucleus_score":8.95275,"pct_ad":0.205833,"pct_control":0.153699,"donor_test":"not significant","donor_padj":0.732555,"donor_log2fc":0.256226,"donor_lfcse":0.129315,"donor_log2fc_shrunk":0.0158068}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000185896","module":"turquoise","kme":0.200271,"hub":false,"module_direction":"higher in AD","module_padj":0.32433,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000185896","module":"lightgreen","kme":0.208635,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000185896","module":"turquoise","kme":0.224383,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000185896","entrez_id":["3916"],"uniprot":["P11279"],"ncbi_summary":"The protein encoded by this gene is a member of a family of membrane glycoproteins.  This glycoprotein provides selectins with carbohydrate ligands.  It may also play a role in tumor cell metastasis. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P11279","text":"Lysosomal membrane glycoprotein which plays an important role in lysosome biogenesis, lysosomal pH regulation, autophagy and cholesterol homeostasis (PubMed:37390818). Acts as an important regulator of lysosomal lumen pH regulation by acting as a direct inhibitor of the proton channel TMEM175, facilitating lysosomal acidification for optimal hydrolase activity (PubMed:37390818). Also plays an important role in NK-cells cytotoxicity (PubMed:2022921, PubMed:23632890). Mechanistically, participates in cytotoxic granule movement to the cell surface and perforin trafficking to the lytic granule (PubMed:23632890). In addition, protects NK-cells from degranulation-associated damage induced by their own cytotoxic granule content (PubMed:23847195). Presents carbohydrate ligands to selectins (PubMed:7685349). (Microbial infection) Acts as a receptor for Lassa virus glycoprotein (PubMed:24970085, PubMed:25972533, PubMed:27605678, PubMed:28448640). Also promotes fusion of the virus with host membrane in less acidic endosomes (PubMed:29295909). (Microbial infection) Supports the FURIN-mediated cleavage of mumps virus fusion protein F by interacting with both FURIN and the unprocessed form but not the processed form of the viral protein F."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}