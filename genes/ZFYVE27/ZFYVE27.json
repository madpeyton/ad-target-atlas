les":[{"cell_type":"CUX2-","gene_id":"ENSG00000155256","module":"turquoise","kme":0.0988658,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000155256"],"dataset_symbols":["ZFYVE27"],"explorer":"explorer.html?dataset=mathys2019#gene/ZFYVE27","cell_types":[{"cell_type":"Ex","gene_symbol":"ZFYVE27","gene_symbol_current":"ZFYVE27","gene_id":"ENSG00000155256","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000213793,"nucleus_log2fc":-0.125612,"nucleus_score":-3.99161,"pct_ad":0.24939,"pct_control":0.275004,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0478562,"donor_lfcse":0.0554421,"donor_log2fc_shrunk":-2.61544e-05},{"cell_type":"In","gene_symbol":"ZFYVE27","gene_symbol_current":"ZFYVE27","gene_id":"ENSG00000155256","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.786941,"nucleus_log2fc":-0.0805316,"nucleus_score":-0.724678,"pct_ad":0.158829,"pct_control":0.165266,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":-0.0726751,"donor_lfcse":0.120891,"donor_log2fc_shrunk":-5.18361e-06}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000155256","entrez_id":["118813"],"uniprot":["Q5T4F4"],"ncbi_summary":"This gene encodes a protein with several transmembrane domains, a Rab11-binding domain and a lipid-binding FYVE finger domain. The encoded protein appears to promote neurite formation. A mutation in this gene has been reported to be associated with hereditary spastic paraplegia, however the pathogenicity of the mutation, which may simply represent a polymorphism, is unclear. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5T4F4","text":"Molecular tethering protein, which plays a role in the formation of membrane contact sites between the endoplasmic reticulum and late endosomes/lysosomes (PubMed:17082457, PubMed:25855459, PubMed:32686675). Promotes neurite formation by tethering endosomes to the endoplasmic reticulum membrane: interacts with Rab7-positive late endosomes, acting as a bridge to form endoplasmic reticulum membrane-endosome contact sites (PubMed:25855459, PubMed:32686675). Acts in cooperation with vesicle-associated membrane protein-associated protein (VAPA or VAPB), thereby facilitating loading of the endosome membrane with KIF5, which is required for movement of the endosomes along microtubules in the plus-end direction (PubMed:19289470, PubMed:21976701, PubMed:25855459). Also associates with Rab11-positive recycling endosomes, facilitating exocytosis and membrane expansion (PubMed:17082457). Contributes to both the formation and stabilization of the tubular endoplasmic reticulum network (PubMed:24668814). Involved in endoplasmic reticulum morphogenesis by regulating the sheet-to-tubule balance and possibly the density of tubule interconnections (PubMed:23969831)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}