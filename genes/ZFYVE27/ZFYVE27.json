FYVE27","gene_symbol_current":"ZFYVE27","gene_id":"ENSG00000155256","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.967423,"nucleus_log2fc":0.0448077,"nucleus_score":-0.0693593,"pct_ad":0.155234,"pct_control":0.156647,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0237718,"donor_lfcse":0.108716,"donor_log2fc_shrunk":-2.04641e-06,"degas_log2fc":0.0849151,"degas_padj":0.268567},{"cell_type":"Oli","gene_symbol":"ZFYVE27","gene_symbol_current":"ZFYVE27","gene_id":"ENSG00000155256","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0480798,"nucleus_log2fc":0.0768468,"nucleus_score":2.106,"pct_ad":0.154742,"pct_control":0.149067,"donor_test":"not significant","donor_padj":0.827384,"donor_log2fc":0.0653837,"donor_lfcse":0.0588175,"donor_log2fc_shrunk":0.0166705,"degas_log2fc":-0.0578204,"degas_padj":0.0619576}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000155256","module":"turquoise","kme":0.0297216,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000155256","entrez_id":["118813"],"uniprot":["Q5T4F4"],"ncbi_summary":"This gene encodes a protein with several transmembrane domains, a Rab11-binding domain and a lipid-binding FYVE finger domain. The encoded protein appears to promote neurite formation. A mutation in this gene has been reported to be associated with hereditary spastic paraplegia, however the pathogenicity of the mutation, which may simply represent a polymorphism, is unclear. [provided by RefSeq, Mar 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5T4F4","text":"Molecular tethering protein, which plays a role in the formation of membrane contact sites between the endoplasmic reticulum and late endosomes/lysosomes (PubMed:17082457, PubMed:25855459, PubMed:32686675). Promotes neurite formation by tethering endosomes to the endoplasmic reticulum membrane: interacts with Rab7-positive late endosomes, acting as a bridge to form endoplasmic reticulum membrane-endosome contact sites (PubMed:25855459, PubMed:32686675). Acts in cooperation with vesicle-associated membrane protein-associated protein (VAPA or VAPB), thereby facilitating loading of the endosome membrane with KIF5, which is required for movement of the endosomes along microtubules in the plus-end direction (PubMed:19289470, PubMed:21976701, PubMed:25855459). Also associates with Rab11-positive recycling endosomes, facilitating exocytosis and membrane expansion (PubMed:17082457). Contributes to both the formation and stabilization of the tubular endoplasmic reticulum network (PubMed:24668814). Involved in endoplasmic reticulum morphogenesis by regulating the sheet-to-tubule balance and possibly the density of tubule interconnections (PubMed:23969831)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}