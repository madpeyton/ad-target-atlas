824729,"donor_log2fc":0.247365,"donor_lfcse":0.22408,"donor_log2fc_shrunk":0.00294461},{"cell_type":"Ex","gene_symbol":"SOCS2","gene_symbol_current":"SOCS2","gene_id":"ENSG00000120833","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"unclear","nucleus_padj":0.000715871,"nucleus_log2fc":0.00914435,"nucleus_score":-3.436,"pct_ad":0.19065,"pct_control":0.198001,"donor_test":"not significant","donor_padj":0.885132,"donor_log2fc":0.055712,"donor_lfcse":0.124356,"donor_log2fc_shrunk":0.00319115},{"cell_type":"In","gene_symbol":"SOCS2","gene_symbol_current":"SOCS2","gene_id":"ENSG00000120833","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0392887,"nucleus_log2fc":0.081297,"nucleus_score":2.13132,"pct_ad":0.142194,"pct_control":0.139445,"donor_test":"not significant","donor_padj":0.751245,"donor_log2fc":0.144941,"donor_lfcse":0.105492,"donor_log2fc_shrunk":0.00625523}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000120833","entrez_id":["8835"],"uniprot":["O14508"],"ncbi_summary":"This gene encodes a member of the suppressor of cytokine signaling (SOCS) family. SOCS family members are cytokine-inducible negative regulators of cytokine receptor signaling via the Janus kinase/signal transducer and activation of transcription pathway (the JAK/STAT pathway). SOCS family proteins interact with major molecules of signaling complexes to block further signal transduction, in part, by proteasomal depletion of receptors or signal-transducing proteins via ubiquitination. The expression of this gene can be induced by a subset of cytokines, including erythropoietin, GM-CSF, IL10, interferon (IFN)-gamma and by cytokine receptors such as growth horomone receptor. The protein encoded by this gene interacts with the cytoplasmic domain of insulin-like growth factor-1 receptor (IGF1R) and is thought to be involved in the regulation of IGF1R mediated cell signaling. This gene has pseudogenes on chromosomes 20 and 22. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jul 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O14508","text":"Substrate-recognition component of a cullin-5-RING E3 ubiquitin-protein ligase complex (ECS complex, also named CRL5 complex), which mediates the ubiquitination and subsequent proteasomal degradation of target proteins, such as EPOR and GHR (PubMed:11781573, PubMed:21980433, PubMed:25505247, PubMed:31182716, PubMed:34857742). Specifically recognizes and binds phosphorylated proteins via its SH2 domain, promoting their ubiquitination (PubMed:21980433, PubMed:25505247, PubMed:31182716, PubMed:34857742, PubMed:37816714). The ECS(SOCS2) complex acts as a key regulator of growth hormone receptor (GHR) levels by mediating ubiquitination and degradation of GHR, following GHR phosphorylation by JAK2 (PubMed:21980433, PubMed:25505247, PubMed:34857742). The ECS(SOCS2) also catalyzes ubiquitination and degradation of JAK2-phosphorylated EPOR (PubMed:11781573)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}