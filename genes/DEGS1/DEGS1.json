info","uniprot_function":[{"accession":"O15121","text":"Has sphingolipid-delta-4-desaturase activity. Converts D-erythro-sphinganine to D-erythro-sphingosine (E-sphing-4-enine) (PubMed:11937514, PubMed:30620337, PubMed:30620338). Catalyzes the equilibrium isomerization of retinols (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}