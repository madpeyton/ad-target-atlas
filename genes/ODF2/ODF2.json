,"pct_ad":0.162094,"pct_control":0.173243,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.165156,"donor_lfcse":0.0981387,"donor_log2fc_shrunk":-1.7729e-05},{"cell_type":"Oli","gene_symbol":"ODF2","gene_symbol_current":"ODF2","gene_id":"ENSG00000136811","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.879739,"donor_log2fc":0.0732736,"donor_lfcse":0.0857567,"donor_log2fc_shrunk":0.0126091}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000136811","module":"blue","kme":0.0246686,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136811","entrez_id":["4957"],"uniprot":["Q5BJF6"],"ncbi_summary":"The outer dense fibers are cytoskeletal structures that surround the axoneme in the middle piece and principal piece of the sperm tail. The fibers function in maintaining the elastic structure and recoil of the sperm tail as well as in protecting the tail from shear forces during epididymal transport and ejaculation. Defects in the outer dense fibers lead to abnormal sperm morphology and infertility. This gene encodes one of the major outer dense fiber proteins. Alternative splicing results in multiple transcript variants. The longer transcripts, also known as 'Cenexins', encode proteins with a C-terminal extension that are differentially targeted to somatic centrioles and thought to be crucial for the formation of microtubule organizing centers. [provided by RefSeq, Oct 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5BJF6","text":"Seems to be a major component of sperm tail outer dense fibers (ODF). ODFs are filamentous structures located on the outside of the axoneme in the midpiece and principal piece of the mammalian sperm tail and may help to maintain the passive elastic structures and elastic recoil of the sperm tail. May have a modulating influence on sperm motility. Functions as a general scaffold protein that is specifically localized at the distal/subdistal appendages of mother centrioles. Component of the centrosome matrix required for the localization of PLK1 and NIN to the centrosomes. Required for the formation and/or maintenance of normal CETN1 assembly."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}