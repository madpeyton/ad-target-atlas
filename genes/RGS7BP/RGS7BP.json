midnightblue","kme":0.257729,"hub":false,"module_direction":"higher in AD","module_padj":0.698612,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000186479","module":"turquoise","kme":0.14168,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000186479","module":"brown","kme":0.121629,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000186479","entrez_id":["401190"],"uniprot":["Q6MZT1"],"ncbi_summary":"This gene encodes a protein that binds to all members of the R7 subfamily of regulators of G protein signaling and regulates their translocation between the nucleus and the plasma membrane. The encoded protein could be regulated by reversible palmitoylation, which anchors it to the plasma membrane. Depalmitoylation localizes the protein to the nucleus. Polymorphisms in this gene may be associated with risk of aspirin-exacerbated respiratory disease. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene. [provided by RefSeq, Dec 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6MZT1","text":"Regulator of G protein-coupled receptor (GPCR) signaling. Regulatory subunit of the R7-Gbeta5 complexes that acts by controlling the subcellular location of the R7-Gbeta5 complexes. When palmitoylated, it targets the R7-Gbeta5 complexes to the plasma membrane, leading to inhibit G protein alpha subunits. When it is unpalmitoylated, the R7-Gbeta5 complexes undergo a nuclear/cytoplasmic shuttling. May also act by controlling the proteolytic stability of R7 proteins, probably by protecting them from degradation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}