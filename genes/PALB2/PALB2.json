est":"not significant","donor_padj":0.915781,"donor_log2fc":0.0202139,"donor_lfcse":0.048644,"donor_log2fc_shrunk":0.00378095,"degas_log2fc":-0.0834165,"degas_padj":8.48599e-07},{"cell_type":"Mic","gene_symbol":"PALB2","gene_symbol_current":"PALB2","gene_id":"ENSG00000083093","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.453898,"nucleus_log2fc":0.0801098,"nucleus_score":0.921451,"pct_ad":0.101393,"pct_control":0.0975806,"donor_test":"not significant","donor_padj":0.732365,"donor_log2fc":0.114457,"donor_lfcse":0.102753,"donor_log2fc_shrunk":0.0209876,"degas_log2fc":-0.117415,"degas_padj":0.146467},{"cell_type":"OPC","gene_symbol":"PALB2","gene_symbol_current":"PALB2","gene_id":"ENSG00000083093","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.053598,"donor_lfcse":0.115313,"donor_log2fc_shrunk":-4.18034e-06,"degas_log2fc":-0.185596,"degas_padj":0.0586636},{"cell_type":"Oli","gene_symbol":"PALB2","gene_symbol_current":"PALB2","gene_id":"ENSG00000083093","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.970698,"donor_log2fc":-0.0229198,"donor_lfcse":0.0829219,"donor_log2fc_shrunk":-0.00322642,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000083093","entrez_id":["79728"],"uniprot":["Q86YC2"],"ncbi_summary":"This gene encodes a protein that may function in tumor suppression. This protein binds to and colocalizes with the breast cancer 2 early onset protein (BRCA2) in nuclear foci and likely permits the stable intranuclear localization and accumulation of BRCA2. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q86YC2","text":"Plays a critical role in homologous recombination repair (HRR) through its ability to recruit BRCA2 and RAD51 to DNA breaks (PubMed:16793542, PubMed:19369211, PubMed:19423707, PubMed:22941656, PubMed:24141787, PubMed:28319063). Strongly stimulates the DNA strand-invasion activity of RAD51, stabilizes the nucleoprotein filament against a disruptive BRC3-BRC4 polypeptide and helps RAD51 to overcome the suppressive effect of replication protein A (RPA) (PubMed:20871615). Functionally cooperates with RAD51AP1 in promoting of D-loop formation by RAD51 (PubMed:20871616). Serves as the molecular scaffold in the formation of the BRCA1-PALB2-BRCA2 complex which is essential for homologous recombination (PubMed:19369211). Via its WD repeats is proposed to scaffold a HR complex containing RAD51C and BRCA2 which is thought to play a role in HR-mediated DNA repair (PubMed:24141787). Essential partner of BRCA2 that promotes the localization and stability of BRCA2 (PubMed:16793542). Also enables its recombinational repair and checkpoint functions of BRCA2 (PubMed:16793542). May act by promoting stable association of BRCA2 with nuclear structures, allowing BRCA2 to escape the effects of proteasome-mediated degradation (PubMed:16793542). Binds DNA with high affinity for D loop, which comprises single-stranded, double-stranded and branched DNA structures (PubMed:20871616). May play a role in the extension step after strand invasion at replication-dependent DNA double-strand breaks; together with BRCA2 is involved in both POLH localization at collapsed replication forks and DNA polymerization activity (PubMed:24485656)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}