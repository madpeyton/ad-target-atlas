rent":"ATP6V1B2","gene_id":"ENSG00000147416","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0335841,"nucleus_log2fc":0.143441,"nucleus_score":2.5868,"pct_ad":0.285863,"pct_control":0.265199,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.162879,"donor_lfcse":0.0727055,"donor_log2fc_shrunk":3.1938e-05,"degas_log2fc":-0.165344,"degas_padj":0.002366},{"cell_type":"Oli","gene_symbol":"ATP6V1B2","gene_symbol_current":"ATP6V1B2","gene_id":"ENSG00000147416","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.527681,"nucleus_log2fc":-0.0156038,"nucleus_score":-0.706674,"pct_ad":0.171871,"pct_control":0.17357,"donor_test":"not significant","donor_padj":0.986824,"donor_log2fc":0.00835059,"donor_lfcse":0.0807641,"donor_log2fc_shrunk":0.00123051,"degas_log2fc":-0.108336,"degas_padj":0.000167584}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000147416","module":"brown","kme":0.379085,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000147416","entrez_id":["526"],"uniprot":["P21281"],"ncbi_summary":"This gene encodes a component of vacuolar ATPase (V-ATPase), a multisubunit enzyme that mediates acidification of eukaryotic intracellular organelles. V-ATPase dependent organelle acidification is necessary for such intracellular processes as protein sorting, zymogen activation, receptor-mediated endocytosis, and synaptic vesicle proton gradient generation. V-ATPase is composed of a cytosolic V1 domain and a transmembrane V0 domain. The V1 domain consists of three A, three B, and two G subunits, as well as a C, D, E, F, and H subunit. The V1 domain contains the ATP catalytic site. The protein encoded by this gene is one of two V1 domain B subunit isoforms and is the only B isoform highly expressed in osteoclasts. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P21281","text":"Non-catalytic subunit of the V1 complex of vacuolar(H+)-ATPase (V-ATPase), a multisubunit enzyme composed of a peripheral complex (V1) that hydrolyzes ATP and a membrane integral complex (V0) that translocates protons (PubMed:33065002). V-ATPase is responsible for acidifying and maintaining the pH of intracellular compartments and in some cell types, is targeted to the plasma membrane, where it promotes acidification of the extracellular environment (PubMed:32001091). The V-ATPase complex also acts as an activator for mTORC1 on lysosomal membrane by promoting the guanine nucleotide exchange factor (GEF) of the Ragulator complex, thereby enabling mTORC1 recruitment (PubMed:22053050). In renal intercalated cells, can partially compensate the lack of ATP6V1B1 and mediate secretion of protons (H+) into the urine under base-line conditions but not in conditions of acid load (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}