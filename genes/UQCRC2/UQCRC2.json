r_lfcse":0.0588792,"donor_log2fc_shrunk":-0.00172696,"degas_log2fc":0.0433686,"degas_padj":0.357627},{"cell_type":"OPC","gene_symbol":"UQCRC2","gene_symbol_current":"UQCRC2","gene_id":"ENSG00000140740","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.326244,"nucleus_log2fc":0.0473138,"nucleus_score":1.31932,"pct_ad":0.537429,"pct_control":0.524979,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0137561,"donor_lfcse":0.0725128,"donor_log2fc_shrunk":2.75695e-06,"degas_log2fc":-0.254523,"degas_padj":1.35933e-12},{"cell_type":"Oli","gene_symbol":"UQCRC2","gene_symbol_current":"UQCRC2","gene_id":"ENSG00000140740","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":6.89812e-05,"nucleus_log2fc":-0.0808147,"nucleus_score":-4.13034,"pct_ad":0.321153,"pct_control":0.335506,"donor_test":"not significant","donor_padj":0.805852,"donor_log2fc":-0.0828861,"donor_lfcse":0.0684355,"donor_log2fc_shrunk":-0.0180141,"degas_log2fc":-0.260868,"degas_padj":1.18825e-37}],"modules":[{"cell_type":"In","gene_id":"ENSG00000140740","module":"tan","kme":0.241547,"hub":false,"module_direction":"higher in AD","module_padj":0.655614,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000140740","entrez_id":["7385"],"uniprot":["P22695"],"ncbi_summary":"The protein encoded by this gene is located in the mitochondrion, where it is part of the ubiquinol-cytochrome c reductase complex (also known as complex III). This complex constitutes a part of the mitochondrial respiratory chain. Defects in this gene are a cause of mitochondrial complex III deficiency nuclear type 5. [provided by RefSeq, Jul 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P22695","text":"Component of the ubiquinol-cytochrome c oxidoreductase, a multisubunit transmembrane complex that is part of the mitochondrial electron transport chain which drives oxidative phosphorylation. The respiratory chain contains 3 multisubunit complexes succinate dehydrogenase (complex II, CII), ubiquinol-cytochrome c oxidoreductase (cytochrome b-c1 complex, complex III, CIII) and cytochrome c oxidase (complex IV, CIV), that cooperate to transfer electrons derived from NADH and succinate to molecular oxygen, creating an electrochemical gradient over the inner membrane that drives transmembrane transport and the ATP synthase. The cytochrome b-c1 complex catalyzes electron transfer from ubiquinol to cytochrome c, linking this redox reaction to translocation of protons across the mitochondrial inner membrane, with protons being carried across the membrane as hydrogens on the quinol. In the process called Q cycle, 2 protons are consumed from the matrix, 4 protons are released into the intermembrane space and 2 electrons are passed to cytochrome c (By similarity). The 2 core subunits UQCRC1/QCR1 and UQCRC2/QCR2 are homologous to the 2 mitochondrial-processing peptidase (MPP) subunits beta-MPP and alpha-MPP respectively, and they seem to have preserved their MPP processing properties (By similarity). May be involved in the in situ processing of UQCRFS1 into the mature Rieske protein and its mitochondrial targeting sequence (MTS)/subunit 9 when incorporated into complex III (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}