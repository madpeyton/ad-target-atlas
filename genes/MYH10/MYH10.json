:-0.0172233,"nucleus_score":-0.483883,"pct_ad":0.595437,"pct_control":0.597629,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.00481415,"donor_lfcse":0.0657553,"donor_log2fc_shrunk":-1.3945e-05,"degas_log2fc":-0.264058,"degas_padj":2.80346e-15},{"cell_type":"Oli","gene_symbol":"MYH10","gene_symbol_current":"MYH10","gene_id":"ENSG00000133026","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.03446e-21,"nucleus_log2fc":-0.22111,"nucleus_score":-9.62288,"pct_ad":0.17216,"pct_control":0.201304,"donor_test":"not significant","donor_padj":0.945391,"donor_log2fc":-0.0456092,"donor_lfcse":0.101009,"donor_log2fc_shrunk":-0.00473535,"degas_log2fc":-0.0384728,"degas_padj":0.172805}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000133026","module":"blue","kme":0.0625612,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000133026","module":"magenta","kme":0.227212,"hub":false,"module_direction":"lower in AD","module_padj":0.209344,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000133026","module":"turquoise","kme":0.163791,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000133026","module":"turquoise","kme":0.0318068,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000133026","entrez_id":["4628"],"uniprot":["P35580"],"ncbi_summary":"This gene encodes a member of the myosin superfamily. The protein represents a conventional non-muscle myosin; it should not be confused with the unconventional myosin-10 (MYO10). Myosins are actin-dependent motor proteins with diverse functions including regulation of cytokinesis, cell motility, and cell polarity. Mutations in this gene have been associated with May-Hegglin anomaly and developmental defects in brain and heart. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Dec 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P35580","text":"Cellular myosin that appears to play a role in cytokinesis, cell shape, and specialized functions such as secretion and capping. Involved with LARP6 in the stabilization of type I collagen mRNAs for CO1A1 and CO1A2. During cell spreading, plays an important role in cytoskeleton reorganization, focal contacts formation (in the central part but not the margins of spreading cells), and lamellipodial extension; this function is mechanically antagonized by MYH9. (Microbial infection) Acts as a receptor for herpes simplex virus 1/HHV-1 envelope glycoprotein B."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}