5231737, PubMed:15385962, PubMed:16618801, PubMed:17344414, PubMed:18285464, PubMed:28229514, PubMed:29499137, PubMed:31959557). The PRC2 complex may also serve as a recruiting platform for DNA methyltransferases, thereby linking two epigenetic repression systems (PubMed:12351676, PubMed:12435631, PubMed:15099518, PubMed:15225548, PubMed:15385962, PubMed:15684044, PubMed:16431907, PubMed:18086877, PubMed:18285464). Genes repressed by the PRC2 complex include HOXC8, HOXA9, MYT1 and CDKN2A (PubMed:15231737, PubMed:16618801, PubMed:17200670, PubMed:31959557)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}