s_direction":"higher in AD","nucleus_padj":0.333922,"nucleus_log2fc":0.0217902,"nucleus_score":1.01896,"pct_ad":0.19409,"pct_control":0.192778,"donor_test":"not significant","donor_padj":0.727089,"donor_log2fc":0.104935,"donor_lfcse":0.0644237,"donor_log2fc_shrunk":0.0124773},{"cell_type":"Mic","gene_symbol":"HUS1","gene_symbol_current":"HUS1","gene_id":"ENSG00000136273","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.108619,"nucleus_log2fc":0.116811,"nucleus_score":1.84949,"pct_ad":0.124141,"pct_control":0.115438,"donor_test":"not significant","donor_padj":0.700058,"donor_log2fc":0.126039,"donor_lfcse":0.103079,"donor_log2fc_shrunk":0.0238584},{"cell_type":"OPC","gene_symbol":"HUS1","gene_symbol_current":"HUS1","gene_id":"ENSG00000136273","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.133474,"nucleus_log2fc":0.0999047,"nucleus_score":1.91485,"pct_ad":0.129735,"pct_control":0.117697,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0879743,"donor_lfcse":0.10068,"donor_log2fc_shrunk":9.06658e-06},{"cell_type":"Oli","gene_symbol":"HUS1","gene_symbol_current":"HUS1","gene_id":"ENSG00000136273","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.897341,"donor_log2fc":0.0543107,"donor_lfcse":0.0715488,"donor_log2fc_shrunk":0.0100633}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136273","entrez_id":["3364"],"uniprot":["O60921"],"ncbi_summary":"The protein encoded by this gene is a component of an evolutionarily conserved, genotoxin-activated checkpoint complex that is involved in the cell cycle arrest in response to DNA damage. This protein forms a heterotrimeric complex with checkpoint proteins RAD9 and RAD1. In response to DNA damage, the trimeric complex interacts with another protein complex consisting of checkpoint protein RAD17 and four small subunits of the replication factor C (RFC), which loads the combined complex onto the chromatin. The DNA damage induced chromatin binding has been shown to depend on the activation of the checkpoint kinase ATM, and is thought to be an early checkpoint signaling event. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Feb 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O60921","text":"Component of the 9-1-1 cell-cycle checkpoint response complex that plays a major role in DNA repair (PubMed:21659603). The 9-1-1 complex is recruited to DNA lesion upon damage by the RAD17-replication factor C (RFC) clamp loader complex (PubMed:21659603). Acts then as a sliding clamp platform on DNA for several proteins involved in long-patch base excision repair (LP-BER) (PubMed:21659603). The 9-1-1 complex stimulates DNA polymerase beta (POLB) activity by increasing its affinity for the 3'-OH end of the primer-template and stabilizes POLB to those sites where LP-BER proceeds; endonuclease FEN1 cleavage activity on substrates with double, nick, or gap flaps of distinct sequences and lengths; and DNA ligase I (LIG1) on long-patch base excision repair substrates (PubMed:21659603). The 9-1-1 complex is necessary for the recruitment of RHNO1 to sites of double-stranded breaks (DSB) occurring during the S phase (PubMed:21659603)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}