"],"dataset_symbols":["IFI27"],"explorer":"explorer.html?dataset=seaad_pfc#gene/IFI27","cell_types":[{"cell_type":"Ast","gene_symbol":"IFI27","gene_symbol_current":"IFI27","gene_id":"ENSG00000165949","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.802636,"donor_log2fc":0.240322,"donor_lfcse":0.192229,"donor_log2fc_shrunk":0.00400375,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Ex","gene_symbol":"IFI27","gene_symbol_current":"IFI27","gene_id":"ENSG00000165949","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.958986,"donor_log2fc":0.0314972,"donor_lfcse":0.172398,"donor_log2fc_shrunk":0.00094751,"degas_log2fc":null,"degas_padj":null},{"cell_type":"In","gene_symbol":"IFI27","gene_symbol_current":"IFI27","gene_id":"ENSG00000165949","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.860723,"donor_log2fc":0.117769,"donor_lfcse":0.181305,"donor_log2fc_shrunk":0.00170099,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"IFI27","gene_symbol_current":"IFI27","gene_id":"ENSG00000165949","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985858,"donor_log2fc":0.0233955,"donor_lfcse":0.215423,"donor_log2fc_shrunk":0.000619106,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165949","entrez_id":["3429"],"uniprot":["P40305"],"ncbi_summary":"Enables RNA polymerase II-specific DNA-binding transcription factor binding activity; identical protein binding activity; and lamin binding activity. Involved in several processes, including cellular protein metabolic process; defense response to other organism; and extrinsic apoptotic signaling pathway. Acts upstream of or within negative regulation of transcription by RNA polymerase II and regulation of protein export from nucleus. Located in mitochondrial membrane and nuclear inner membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P40305","text":"Probable adapter protein involved in different biological processes (PubMed:22427340, PubMed:27194766). Part of the signaling pathways that lead to apoptosis (PubMed:18330707, PubMed:24970806, PubMed:27673746). Involved in type-I interferon-induced apoptosis characterized by a rapid and robust release of cytochrome C from the mitochondria and activation of BAX and caspases 2, 3, 6, 8 and 9 (PubMed:18330707, PubMed:27673746). Also functions in TNFSF10-induced apoptosis (PubMed:24970806). May also have a function in the nucleus, where it may be involved in the interferon-induced negative regulation of the transcriptional activity of NR4A1, NR4A2 and NR4A3 through the enhancement of XPO1-mediated nuclear export of these nuclear receptors (PubMed:22427340). May thereby play a role in the vascular response to injury (By similarity). In the innate immune response, has an antiviral activity towards hepatitis C virus/HCV (PubMed:27194766, PubMed:27777077). May prevent the replication of the virus by recruiting both the hepatitis C virus non-structural protein 5A/NS5A and the ubiquitination machinery via SKP2, promoting the ubiquitin-mediated proteasomal degradation of NS5A (PubMed:27194766, PubMed:27777077). Also promotes virus-induced pyroptosis by activating CASP3 in the mitochondria after 'Lys-6'-linked ubiquitination by TRIM21 (PubMed:36426955)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}