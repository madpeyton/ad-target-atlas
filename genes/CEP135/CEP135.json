nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.553131,"donor_log2fc":0.245718,"donor_lfcse":0.112377,"donor_log2fc_shrunk":0.0240771,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000174799","module":"yellow","kme":0.198855,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000174799","entrez_id":["9662"],"uniprot":["Q66GS9"],"ncbi_summary":"This gene encodes a centrosomal protein, which acts as a scaffolding protein during early centriole biogenesis, and is also required for centriole-centriole cohesion during interphase. Mutations in this gene are associated with autosomal recessive primary microcephaly-8. [provided by RefSeq, Jun 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q66GS9","text":"Centrosomal microtubule-binding protein involved in centriole biogenesis (PubMed:27477386). Acts as a scaffolding protein during early centriole biogenesis. Required for the targeting of centriole satellite proteins to centrosomes such as of PCM1, SSX2IP and CEP290 and recruitment of WRAP73 to centrioles. Also required for centriole-centriole cohesion during interphase by acting as a platform protein for CEP250 at the centriole. Required for the recruitment of CEP295 to the proximal end of new-born centrioles at the centriolar microtubule wall during early S phase in a PLK4-dependent manner (PubMed:27185865)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}