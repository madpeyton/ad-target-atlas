icant","donor_padj":0.999342,"donor_log2fc":0.19168,"donor_lfcse":0.169853,"donor_log2fc_shrunk":6.91657e-06},{"cell_type":"Oli","gene_symbol":"FICD","gene_symbol_current":"FICD","gene_id":"ENSG00000198855","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.973523,"donor_log2fc":0.0290421,"donor_lfcse":0.133006,"donor_log2fc_shrunk":0.00174493}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000198855","module":"turquoise","kme":0.0579021,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000198855","entrez_id":["11153"],"uniprot":["Q9BVA6"],"ncbi_summary":"Enables several functions, including ATP binding activity; Hsp70 protein binding activity; and chaperone binding activity. Involved in protein adenylylation; regulation of IRE1-mediated unfolded protein response; and response to endoplasmic reticulum stress. Is integral component of endoplasmic reticulum membrane. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9BVA6","text":"Protein that can both mediate the addition of adenosine 5'-monophosphate (AMP) to specific residues of target proteins (AMPylation), and the removal of the same modification from target proteins (de-AMPylation), depending on the context (By similarity). The side chain of Glu-231 determines which of the two opposing activities (AMPylase or de-AMPylase) will take place (PubMed:36136088). Acts as a key regulator of the ERN1/IRE1-mediated unfolded protein response (UPR) by mediating AMPylation or de-AMPylation of HSPA5/BiP (PubMed:25601083, PubMed:36136088). In unstressed cells, acts as an adenylyltransferase by mediating AMPylation of HSPA5/BiP at 'Thr-518', thereby inactivating it (By similarity). In response to endoplasmic reticulum stress, acts as a phosphodiesterase by mediating removal of ATP (de-AMPylation) from HSPA5/BiP at 'Thr-518', leading to restore HSPA5/BiP activity (By similarity). Although it is able to AMPylate RhoA, Rac and Cdc42 Rho GTPases in vitro, Rho GTPases do not constitute physiological substrates (PubMed:19362538, PubMed:25601083)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}