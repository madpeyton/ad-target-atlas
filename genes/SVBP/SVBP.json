ataset=mathys2019#gene/SVBP","cell_types":[{"cell_type":"Ex","gene_symbol":"SVBP","gene_symbol_current":"SVBP","gene_id":"ENSG00000177868","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.214272,"nucleus_log2fc":0.0789251,"nucleus_score":1.41492,"pct_ad":0.160098,"pct_control":0.153055,"donor_test":"not significant","donor_padj":0.998789,"donor_log2fc":0.0085468,"donor_lfcse":0.191595,"donor_log2fc_shrunk":2.52762e-07},{"cell_type":"In","gene_symbol":"SVBP","gene_symbol_current":"SVBP","gene_id":"ENSG00000177868","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.520546,"nucleus_log2fc":0.116723,"nucleus_score":1.4212,"pct_ad":0.101154,"pct_control":0.0887021,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000177868","module":"turquoise","kme":0.229743,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000177868","module":"turquoise","kme":0.220365,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000177868","entrez_id":["374969"],"uniprot":["Q8N300"],"ncbi_summary":"Enables microtubule binding activity. Involved in axon development; proteolysis; and regulation of metallopeptidase activity. Acts upstream of or within negative regulation of endothelial cell migration; negative regulation of protein ubiquitination; and protein secretion. Located in apical part of cell. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8N300","text":"Enhances the tyrosine carboxypeptidase activity of VASH1 and VASH2, thereby promoting the removal of the C-terminal tyrosine residue of alpha-tubulin (PubMed:29146869, PubMed:31171830, PubMed:31235910, PubMed:31235911, PubMed:31270470, PubMed:31324789). This activity is critical for spindle function and accurate chromosome segregation during mitosis since microtubule detyrosination regulates mitotic spindle length and postioning (PubMed:31171830). Also required to enhance the solubility and secretion of VASH1 and VASH2 (PubMed:20736312, PubMed:27879017, PubMed:30607023). Plays a role in axon and excitatory synapse formation (PubMed:31235911)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}