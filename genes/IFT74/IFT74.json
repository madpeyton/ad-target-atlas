496,"donor_log2fc_shrunk":-0.0042747}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000096872","module":"blue","kme":0.13467,"hub":false,"module_direction":"lower in AD","module_padj":0.656828,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000096872","module":"blue","kme":0.132561,"hub":false,"module_direction":"higher in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000096872","entrez_id":["80173"],"uniprot":["Q96LB3"],"ncbi_summary":"This gene encodes a core intraflagellar transport (IFT) protein which belongs to a multi-protein complex involved in the transport of ciliary proteins along axonemal microtubules. IFT proteins are found at the base of the cilium as well as inside the cilium, where they assemble into long arrays between the ciliary base and tip. This protein, together with intraflagellar transport protein 81, binds and transports tubulin within cilia and is required for ciliogenesis. Naturally occurring mutations in this gene are associated with amyotrophic lateral sclerosis--frontotemporal dementia and Bardet-Biedl Syndrome. [provided by RefSeq, Mar 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96LB3","text":"Component of the intraflagellar transport (IFT) complex B: together with IFT81, forms a tubulin-binding module that specifically mediates transport of tubulin within the cilium (PubMed:23990561). Binds beta-tubulin via its basic region (PubMed:23990561). Required for ciliogenesis (PubMed:23990561). Essential for flagellogenesis during spermatogenesis (PubMed:33689014)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}