0102241","module":"turquoise","kme":0.0940629,"hub":false,"module_direction":"higher in AD","module_padj":0.500479,"module_significant":false},{"cell_type":"CUX2+","gene_id":"ENSG00000102241","module":"turquoise","kme":0.236353,"hub":false,"module_direction":"higher in AD","module_padj":0.789273,"module_significant":false},{"cell_type":"CUX2-","gene_id":"ENSG00000102241","module":"turquoise","kme":0.251833,"hub":false,"module_direction":"higher in AD","module_padj":0.787198,"module_significant":false},{"cell_type":"Inhibitory","gene_id":"ENSG00000102241","module":"turquoise","kme":0.150739,"hub":false,"module_direction":"higher in AD","module_padj":0.795497,"module_significant":false},{"cell_type":"Microglia","gene_id":"ENSG00000102241","module":"turquoise","kme":0.0896734,"hub":false,"module_direction":"higher in AD","module_padj":0.396297,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"mathys2019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000102241"],"dataset_symbols":["HTATSF1"],"explorer":"explorer.html?dataset=mathys2019#gene/HTATSF1","cell_types":[{"cell_type":"Ex","gene_symbol":"HTATSF1","gene_symbol_current":"HTATSF1","gene_id":"ENSG00000102241","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.17793e-06,"nucleus_log2fc":-0.195118,"nucleus_score":-5.19119,"pct_ad":0.21922,"pct_control":0.249402,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0882491,"donor_lfcse":0.1249,"donor_log2fc_shrunk":-5.89662e-06},{"cell_type":"In","gene_symbol":"HTATSF1","gene_symbol_current":"HTATSF1","gene_id":"ENSG00000102241","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.818519,"nucleus_log2fc":0.0445397,"nucleus_score":0.630616,"pct_ad":0.160603,"pct_control":0.153128,"donor_test":"not significant","donor_padj":0.999889,"donor_log2fc":0.145355,"donor_lfcse":0.161862,"donor_log2fc_shrunk":5.81968e-06}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000102241","module":"turquoise","kme":0.245238,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000102241","module":"turquoise","kme":0.236546,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000102241","entrez_id":["27336"],"uniprot":["O43719"],"ncbi_summary":"The protein encoded by this gene functions as a cofactor for the stimulation of transcriptional elongation by HIV-1 Tat, which binds to the HIV-1 promoter through Tat-TAR interaction. This protein may also serve as a dual-function factor to couple transcription and splicing and to facilitate their reciprocal activation. Alternatively spliced transcript variants have been found for this gene.[provided by RefSeq, Sep 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43719","text":"Component of the 17S U2 SnRNP complex of the spliceosome, a large ribonucleoprotein complex that removes introns from transcribed pre-mRNAs (PubMed:30567737, PubMed:32494006, PubMed:34822310). The 17S U2 SnRNP complex (1) directly participates in early spliceosome assembly and (2) mediates recognition of the intron branch site during pre-mRNA splicing by promoting the selection of the pre-mRNA branch-site adenosine, the nucleophile for the first step of splicing (PubMed:30567737, PubMed:32494006, PubMed:34822310). Within the 17S U2 SnRNP complex, HTATSF1 is required to stabilize the branchpoint-interacting stem loop (PubMed:34822310). HTATSF1 is displaced from the 17S U2 SnRNP complex before the stable addition of the 17S U2 SnRNP complex to the spliceosome, destabilizing the branchpoint-interacting stem loop and allowing to probe intron branch site sequences (PubMed:32494006, PubMed:34822310). Also acts as a regulator of transcriptional elongation, possibly by mediating the reciprocal stimulatory effect of splicing on transcriptional elongation (PubMed:10454543, PubMed:10913173, PubMed:11780068). Involved in double-strand break (DSB) repair via homologous recombination in S-phase by promoting the recruitment of TOPBP1 to DNA damage sites (PubMed:35597237). Mechanistically, HTATSF1 is (1) recruited to DNA damage sites in S-phase via interaction with poly-ADP-ribosylated RPA1 and (2) phosphorylated by CK2, promoting recruitment of TOPBP1, thereby facilitating RAD51 nucleofilaments formation and RPA displacement, followed by homologous recombination (PubMed:35597237). (Microbial infection) In case of infection by HIV-1, it is up-regulated by the HIV-1 proteins NEF and gp120, acts as a cofactor required for the Tat-enhanced transcription of the virus."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}