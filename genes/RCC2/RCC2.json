3624,"donor_log2fc":0.0219497,"donor_lfcse":0.0907771,"donor_log2fc_shrunk":0.00225949},{"cell_type":"In","gene_symbol":"RCC2","gene_symbol_current":"RCC2","gene_id":"ENSG00000179051","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0585707,"nucleus_log2fc":-0.0204114,"nucleus_score":-1.95982,"pct_ad":0.173706,"pct_control":0.177512,"donor_test":"not significant","donor_padj":0.94052,"donor_log2fc":0.0365129,"donor_lfcse":0.118102,"donor_log2fc_shrunk":0.00137341},{"cell_type":"Mic","gene_symbol":"RCC2","gene_symbol_current":"RCC2","gene_id":"ENSG00000179051","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.410965,"nucleus_log2fc":-0.0306287,"nucleus_score":-1.00278,"pct_ad":0.4,"pct_control":0.406106,"donor_test":"not significant","donor_padj":0.907255,"donor_log2fc":-0.0337831,"donor_lfcse":0.063178,"donor_log2fc_shrunk":-0.00907754},{"cell_type":"OPC","gene_symbol":"RCC2","gene_symbol_current":"RCC2","gene_id":"ENSG00000179051","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.907942,"nucleus_log2fc":-0.000725369,"nucleus_score":-0.187551,"pct_ad":0.2881,"pct_control":0.288908,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.0018462,"donor_lfcse":0.0657086,"donor_log2fc_shrunk":-9.27642e-06},{"cell_type":"Oli","gene_symbol":"RCC2","gene_symbol_current":"RCC2","gene_id":"ENSG00000179051","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":1.95805e-05,"nucleus_log2fc":0.144525,"nucleus_score":4.42319,"pct_ad":0.135792,"pct_control":0.124508,"donor_test":"not significant","donor_padj":0.857073,"donor_log2fc":0.121492,"donor_lfcse":0.12268,"donor_log2fc_shrunk":0.00873512}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000179051","entrez_id":["55920"],"uniprot":["Q9P258"],"ncbi_summary":"The protein encoded by this gene is a guanine exchange factor that is active on RalA, a small GTPase. The encoded protein and RalA are both essential for proper kinetochore-microtubule function in early mitosis. This protein has been shown to be a biomarker for colorectal cancer. [provided by RefSeq, Oct 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9P258","text":"Multifunctional protein that may affect its functions by regulating the activity of small GTPases, such as RAC1 and RALA (PubMed:12919680, PubMed:25074804, PubMed:26158537, PubMed:28869598). Required for normal progress through the cell cycle, both during interphase and during mitosis (PubMed:12919680, PubMed:23388455, PubMed:26158537). Required for the presence of normal levels of MAD2L1, AURKB and BIRC5 on inner centromeres during mitosis, and for normal attachment of kinetochores to mitotic spindles (PubMed:12919680, PubMed:26158537). Required for normal organization of the microtubule cytoskeleton in interphase cells (PubMed:23388455). Functions as guanine nucleotide exchange factor (GEF) for RALA (PubMed:26158537). Interferes with the activation of RAC1 by guanine nucleotide exchange factors (PubMed:25074804). Prevents accumulation of active, GTP-bound RAC1, and suppresses RAC1-mediated reorganization of the actin cytoskeleton and formation of membrane protrusions (PubMed:25074804, PubMed:28869598). Required for normal cellular responses to contacts with the extracellular matrix of adjacent cells, and for directional cell migration in response to a fibronectin gradient (in vitro) (PubMed:25074804, PubMed:28869598)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}