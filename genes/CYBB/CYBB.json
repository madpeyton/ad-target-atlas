c":-0.0384141,"donor_lfcse":0.1043,"donor_log2fc_shrunk":-0.00161697,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Mic","gene_symbol":"CYBB","gene_symbol_current":"CYBB","gene_id":"ENSG00000165168","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.411668,"nucleus_log2fc":0.0280182,"nucleus_score":1.00108,"pct_ad":0.676695,"pct_control":0.675,"donor_test":"not significant","donor_padj":0.972442,"donor_log2fc":-0.0245998,"donor_lfcse":0.128425,"donor_log2fc_shrunk":-0.00279051,"degas_log2fc":0.0156551,"degas_padj":0.648831},{"cell_type":"Oli","gene_symbol":"CYBB","gene_symbol_current":"CYBB","gene_id":"ENSG00000165168","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.846908,"donor_log2fc":-0.325379,"donor_lfcse":0.312941,"donor_log2fc_shrunk":-0.0036825,"degas_log2fc":null,"degas_padj":null}],"modules":[{"cell_type":"Mic","gene_id":"ENSG00000165168","module":"blue","kme":0.322178,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000165168","entrez_id":["1536"],"uniprot":["P04839"],"ncbi_summary":"Cytochrome b (-245) is composed of cytochrome b alpha (CYBA) and beta (CYBB) chain. It has been proposed as a primary component of the microbicidal oxidase system of phagocytes. CYBB deficiency is one of five described biochemical defects associated with chronic granulomatous disease (CGD). In this disorder, there is decreased activity of phagocyte NADPH oxidase; neutrophils are able to phagocytize bacteria but cannot kill them in the phagocytic vacuoles. The cause of the killing defect is an inability to increase the cell's respiration and consequent failure to deliver activated oxygen into the phagocytic vacuole. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P04839","text":"Catalytic subunit of the phagocyte NADPH oxidase complex that mediates the transfer of electrons from cytosolic NADPH to O2 to produce the superoxide anion (O2(-)) (PubMed:15338276, PubMed:36241643, PubMed:36413210, PubMed:38355798). In the activated complex, electrons are first transferred from NADPH to flavin adenine dinucleotide (FAD) and subsequently transferred via two heme molecules to molecular oxygen, producing superoxide through an outer-sphere reaction (Probable) (PubMed:38355798). Activation of the NADPH oxidase complex is initiated by the assembly of cytosolic subunits of the NADPH oxidase complex with the core NADPH oxidase complex to form a complex at the plasma membrane or phagosomal membrane (PubMed:19028840, PubMed:38355798). This activation process is initiated by phosphorylation dependent binding of the cytosolic NCF1/p47-phox subunit to the C-terminus of CYBA/p22-phox (By similarity). NADPH oxidase complex assembly is impaired through interaction with NRROS (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}