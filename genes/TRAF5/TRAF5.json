nificant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.693369,"donor_log2fc":-0.204474,"donor_lfcse":0.125387,"donor_log2fc_shrunk":-0.0147015}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000082512","module":"black","kme":0.282225,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000082512","module":"black","kme":0.343678,"hub":false,"module_direction":"lower in AD","module_padj":0.655614,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000082512","entrez_id":["7188"],"uniprot":["O00463"],"ncbi_summary":"The scaffold protein encoded by this gene is a member of the tumor necrosis factor receptor-associated factor (TRAF) protein family and contains a meprin and TRAF homology (MATH) domain, a RING-type zinc finger, and two TRAF-type zinc fingers. TRAF proteins are associated with, and mediate signal transduction from members of the TNF receptor superfamily. This protein is one of the components of a multiple protein complex which binds to tumor necrosis factor (TNF) receptor cytoplasmic domains and mediates TNF-induced activation. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jan 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00463","text":"Adapter protein and signal transducer that links members of the tumor necrosis factor receptor family to different signaling pathways by association with the receptor cytoplasmic domain and kinases. Mediates activation of NF-kappa-B and probably JNK. Seems to be involved in apoptosis. Plays a role in mediating activation of NF-kappa-B by EIF2AK2/PKR."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],