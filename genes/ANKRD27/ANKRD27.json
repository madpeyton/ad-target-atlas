shrunk":-0.00396607,"degas_log2fc":-0.0741658,"degas_padj":6.86375e-11},{"cell_type":"Mic","gene_symbol":"ANKRD27","gene_symbol_current":"ANKRD27","gene_id":"ENSG00000105186","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.172492,"nucleus_log2fc":-0.0996211,"nucleus_score":-1.59505,"pct_ad":0.216435,"pct_control":0.224194,"donor_test":"not significant","donor_padj":0.581499,"donor_log2fc":-0.112509,"donor_lfcse":0.0722045,"donor_log2fc_shrunk":-0.0412929,"degas_log2fc":-0.0319396,"degas_padj":0.586878},{"cell_type":"OPC","gene_symbol":"ANKRD27","gene_symbol_current":"ANKRD27","gene_id":"ENSG00000105186","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.406251,"nucleus_log2fc":-0.0921874,"nucleus_score":-1.1388,"pct_ad":0.181778,"pct_control":0.188146,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0676145,"donor_lfcse":0.0871022,"donor_log2fc_shrunk":-9.18087e-06,"degas_log2fc":-0.176902,"degas_padj":0.00831106},{"cell_type":"Oli","gene_symbol":"ANKRD27","gene_symbol_current":"ANKRD27","gene_id":"ENSG00000105186","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000615204,"nucleus_log2fc":-0.103571,"nucleus_score":-3.56979,"pct_ad":0.163898,"pct_control":0.173682,"donor_test":"not significant","donor_padj":0.937331,"donor_log2fc":-0.0369907,"donor_lfcse":0.072677,"donor_log2fc_shrunk":-0.00711009,"degas_log2fc":-0.123702,"degas_padj":2.0191e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000105186","entrez_id":["84079"],"uniprot":["Q96NW4"],"ncbi_summary":"Enables guanyl-nucleotide exchange factor activity and small GTPase binding activity. Involved in endocytic recycling and negative regulation of SNARE complex assembly. Acts upstream of or within early endosome to late endosome transport. Located in endosome; lysosome; and plasma membrane. Implicated in eosinophilic esophagitis. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96NW4","text":"May be a guanine exchange factor (GEF) for Rab21, Rab32 and Rab38 and regulate endosome dynamics (PubMed:16525121, PubMed:18477474). May regulate the participation of VAMP7 in membrane fusion events; in vitro inhibits VAMP7-mediated SNARE complex formation by trapping VAMP7 in a closed, fusogenically inactive conformation (PubMed:23104059). Involved in peripheral melanosomal distribution of TYRP1 in melanocytes; the function, which probably is implicating vesicle-trafficking, includes cooperation with Rab32, Rab38 and VAMP7 (By similarity). Involved in the regulation of neurite growth; the function seems to require its GEF activity, probably towards Rab21, and VAMP7 but not Rab32/38 (By similarity). Proposed to be involved in Golgi sorting of VAMP7 and transport of VAMP7 vesicles to the cell surface; the function seems to implicate kinesin heavy chain isoform 5 proteins, GOLGA4, RAB21 and MACF1 (PubMed:22705394). Required for the colocalization of VAMP7 and Rab21, probably on TGN sites (PubMed:19745841). Involved in GLUT1 endosome-to-plasma membrane trafficking; the function is dependent of association with VPS29 (PubMed:24856514). Regulates the proper trafficking of melanogenic enzymes TYR, TYRP1 and DCT/TYRP2 to melanosomes in melanocytes (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}