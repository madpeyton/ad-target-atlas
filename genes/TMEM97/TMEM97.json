g2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.285456,"donor_lfcse":0.183278,"donor_log2fc_shrunk":8.76861e-06},{"cell_type":"Oli","gene_symbol":"TMEM97","gene_symbol_current":"TMEM97","gene_id":"ENSG00000109084","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.897445,"donor_log2fc":0.136544,"donor_lfcse":0.180044,"donor_log2fc_shrunk":0.00454407}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000109084","module":"turquoise","kme":0.053384,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000109084","entrez_id":["27346"],"uniprot":["Q5BJF2"],"ncbi_summary":"TMEM97 is a conserved integral membrane protein that plays a role in controlling cellular cholesterol levels (Bartz et al., 2009 [PubMed 19583955]).[supplied by OMIM, Aug 2009].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q5BJF2","text":"Sigma-2 receptor implicated in the regulation of multiple cellular processes, including cholesterol biosynthesis and trafficking, membrane trafficking, autophagy, lipid membrane-associated protein trafficking, and stabilization of receptors at the cell surface, thereby contributing to the maintenance of cellular homeostasis(PubMed:19583955, PubMed:23922215, PubMed:25620095, PubMed:27378690, PubMed:28559337, PubMed:30443021, PubMed:34233061, PubMed:34799735, PubMed:35970844, PubMed:25566323). Forms a ternary complex with PGRMC1 and LDLR at the plasma membrane, promoting LDLR-mediated internalization of LDL cholesterol (PubMed:30443021). Reduces the availability of the lysosomal sterol transporter NPC1, likely through direct interaction, thereby regulating lipid transport, including cholesterol and LBPA, outside of late endosome/lysosome (PubMed:19583955, PubMed:27378690). Binds the regio- and stereoselective oxysterol 20(S)-hydroxycholesterol (20(S)-OHC). Ligand binding enhances association with NPC1 and modulates TMEM97-containing protein complexes involving PGRMC1 and TSPO, consistent with a role in cholesterol homeostasis (PubMed:34799735, PubMed:37047353). Also able to bind cholesterol (By similarity). Interacts with the salivary peptide histatin 1 (Hst 1/HTN1) at the ER membrane, which is critical for increasing mitochondria-ER contacts and stimulating Hst 1 wound healing properties (PubMed:34233061, PubMed:35970844). May alter the activity of some cytochrome P450 proteins (PubMed:22292588). Although sharing homology with sterol isomerases through the EXPERA domain, lacks sterol isomerase activity; instead, may function as a sterol or oxysterol sensor (PubMed:34880501, PubMed:25566323). Acts as an ER quality control factor by promoting proteolytic degradation of nonproductive and extramitochondrial precursor proteins in the ER membrane, thereby removing them from the ER surface (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}