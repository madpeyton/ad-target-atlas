nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.804647,"nucleus_log2fc":0.0938067,"nucleus_score":0.583317,"pct_ad":0.259533,"pct_control":0.243446,"donor_test":"not significant","donor_padj":0.96607,"donor_log2fc":0.0926508,"donor_lfcse":0.151717,"donor_log2fc_shrunk":0.00487719},{"cell_type":"OPC","gene_symbol":"PACS1","gene_symbol_current":"PACS1","gene_id":"ENSG00000175115","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.372002,"nucleus_log2fc":-0.220453,"nucleus_score":-1.61638,"pct_ad":0.240973,"pct_control":0.268966,"donor_test":"not significant","donor_padj":0.99097,"donor_log2fc":-0.0615049,"donor_lfcse":0.121709,"donor_log2fc_shrunk":-0.000619871},{"cell_type":"Oli","gene_symbol":"PACS1","gene_symbol_current":"PACS1","gene_id":"ENSG00000175115","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.966005,"donor_log2fc":0.0335206,"donor_lfcse":0.145394,"donor_log2fc_shrunk":0.00155171}],"modules":[{"cell_type":"In","gene_id":"ENSG00000175115","module":"blue","kme":0.103418,"hub":false,"module_direction":"higher in AD","module_padj":0.906476,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000175115","entrez_id":["55690"],"uniprot":["Q6VY07"],"ncbi_summary":"This gene encodes a protein with a putative role in the localization of trans-Golgi network (TGN) membrane proteins. Mouse and rat homologs have been identified and studies of the homologous rat protein indicate a role in directing TGN localization of furin by binding to the protease's phosphorylated cytosolic domain. In addition, the human protein plays a role in HIV-1 Nef-mediated downregulation of cell surface MHC-I molecules to the TGN, thereby enabling HIV-1 to escape immune surveillance. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q6VY07","text":"Coat protein that is involved in the localization of trans-Golgi network (TGN) membrane proteins that contain acidic cluster sorting motifs. Controls the endosome-to-Golgi trafficking of furin and mannose-6-phosphate receptor by connecting the acidic-cluster-containing cytoplasmic domain of these molecules with the adapter-protein complex-1 (AP-1) of endosomal clathrin-coated membrane pits. Involved in HIV-1 nef-mediated removal of MHC-I from the cell surface to the TGN. Required for normal ER Ca2+ handling in lymphocytes. Together with WDR37, it plays an essential role in lymphocyte development, quiescence and survival. Required for stabilizing peripheral lymphocyte populations (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}