t_control":0.283867,"donor_test":"not significant","donor_padj":0.73611,"donor_log2fc":0.111234,"donor_lfcse":0.0723999,"donor_log2fc_shrunk":0.0135723},{"cell_type":"Mic","gene_symbol":"USP38","gene_symbol_current":"USP38","gene_id":"ENSG00000170185","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.145644,"nucleus_log2fc":0.10449,"nucleus_score":1.69,"pct_ad":0.128319,"pct_control":0.120392,"donor_test":"not significant","donor_padj":0.732949,"donor_log2fc":0.112718,"donor_lfcse":0.101461,"donor_log2fc_shrunk":0.0214792},{"cell_type":"OPC","gene_symbol":"USP38","gene_symbol_current":"USP38","gene_id":"ENSG00000170185","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0066685,"nucleus_log2fc":0.244706,"nucleus_score":3.21108,"pct_ad":0.177304,"pct_control":0.156986,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.186618,"donor_lfcse":0.098623,"donor_log2fc_shrunk":9.71571e-06},{"cell_type":"Oli","gene_symbol":"USP38","gene_symbol_current":"USP38","gene_id":"ENSG00000170185","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.23121e-07,"nucleus_log2fc":0.161323,"nucleus_score":5.33604,"pct_ad":0.154857,"pct_control":0.140806,"donor_test":"not significant","donor_padj":0.78683,"donor_log2fc":0.133576,"donor_lfcse":0.1034,"donor_log2fc_shrunk":0.0140715}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000170185","module":"blue","kme":0.0683785,"hub":false,"module_direction":"lower in AD","module_padj":0.391996,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000170185","entrez_id":["84640"],"uniprot":["Q8NB14"],"ncbi_summary":"Enables thiol-dependent deubiquitinase. Involved in protein deubiquitination. Predicted to be active in cytosol and nucleus. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8NB14","text":"Deubiquitinating enzyme that plays a role in various cellular processes, including DNA repair, cell cycle regulation, and immune response (PubMed:22689415, PubMed:30497519, PubMed:31874856, PubMed:35238669). Plays a role in the inhibition of type I interferon signaling by mediating the 'Lys-33' to 'Lys-48' ubiquitination transition of TBK1 leading to its degradation (PubMed:27692986). Cleaves the ubiquitin chain from the histone demethylase LSD1/KDM1A and prevents it from degradation by the 26S proteasome, thus maintaining LSD1 protein level in cells (PubMed:30497519). Plays a role in the DNA damage response by regulating the deacetylase activity of HDAC1 (PubMed:31874856). Mechanistically, removes the 'Lys-63'-linked ubiquitin chain promoting the deacetylase activity of HDAC1 in response to DNA damage (PubMed:31874856). Also acts as a specific deubiquitinase of histone deacetylase 3/HDAC3 and cleaves its 'Lys-63'-linked ubiquitin chains to lower its histone deacetylase activity (PubMed:32404892). Regulates MYC levels and cell proliferation via antagonizing ubiquitin E3 ligase FBXW7 thereby preventing MYC 'Lys-48'-linked ubiquitination and degradation (PubMed:34102342). Participates in antiviral response by removing both 'Lys-48'-linked and 'Lys-63'-linked polyubiquitination of Zika virus envelope protein E (PubMed:34696459). Constitutively associated with IL-33R/IL1RL1, deconjugates its 'Lys-27'-linked polyubiquitination resulting in its autophagic degradation (PubMed:35238669)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}