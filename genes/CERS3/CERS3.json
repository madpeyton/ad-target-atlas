or_lfcse":0.1718,"donor_log2fc_shrunk":-0.00461138,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"CERS3","gene_symbol_current":"CERS3","gene_id":"ENSG00000154227","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.847348,"donor_log2fc":-0.250505,"donor_lfcse":0.24184,"donor_log2fc_shrunk":-0.00461926,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000154227","entrez_id":["204219"],"uniprot":["Q8IU89"],"ncbi_summary":"This gene is a member of the ceramide synthase family of genes. The ceramide synthase enzymes regulate sphingolipid synthesis by catalyzing the formation of ceramides from sphingoid base and acyl-coA substrates. This family member is involved in the synthesis of ceramides with ultra-long-chain acyl moieties (ULC-Cers), important to the epidermis in its role in creating a protective barrier from the environment. The protein encoded by this gene has also been implicated in modification of the lipid structures required for spermatogenesis. Mutations in this gene have been associated with male fertility defects, and epidermal defects, including ichthyosis. Alternative splicing results in multiple transcript variants encoding different isoforms. [provided by RefSeq, Aug 2015].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IU89","text":"Ceramide synthase that catalyzes the transfer of the acyl chain from acyl-CoA to a sphingoid base, with high selectivity toward very- and ultra-long-chain fatty acyl-CoA (chain length greater than C22) (PubMed:17977534, PubMed:22038835, PubMed:26887952). N-acylates sphinganine and sphingosine bases to form dihydroceramides and ceramides in de novo synthesis and salvage pathways, respectively (PubMed:17977534, PubMed:22038835, PubMed:26887952). It is crucial for the synthesis of ultra-long-chain ceramides in the epidermis, to maintain epidermal lipid homeostasis and terminal differentiation (PubMed:23754960)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}