gene_id":"ENSG00000089053","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.795998,"nucleus_log2fc":0.156829,"nucleus_score":0.600678,"pct_ad":0.100861,"pct_control":0.0923845,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"ANAPC5","gene_symbol_current":"ANAPC5","gene_id":"ENSG00000089053","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.80296,"nucleus_log2fc":-0.0545121,"nucleus_score":-0.552453,"pct_ad":0.208791,"pct_control":0.221456,"donor_test":"not significant","donor_padj":0.993604,"donor_log2fc":0.0343137,"donor_lfcse":0.134765,"donor_log2fc_shrunk":0.000382475},{"cell_type":"Oli","gene_symbol":"ANAPC5","gene_symbol_current":"ANAPC5","gene_id":"ENSG00000089053","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000186973,"nucleus_log2fc":-0.224289,"nucleus_score":-4.13608,"pct_ad":0.247157,"pct_control":0.271309,"donor_test":"not significant","donor_padj":0.597137,"donor_log2fc":-0.196431,"donor_lfcse":0.0689686,"donor_log2fc_shrunk":-0.131426}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000089053","module":"turquoise","kme":0.158662,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000089053","module":"blue","kme":0.188793,"hub":false,"module_direction":"lower in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000089053","entrez_id":["51433"],"uniprot":["Q9UJX4"],"ncbi_summary":"This gene encodes a tetratricopeptide repeat-containing component of the anaphase promoting complex/cyclosome (APC/C), a large E3 ubiquitin ligase that controls cell cycle progression by targeting a number of cell cycle regulators such as B-type cyclins for 26S proteasome-mediated degradation through ubiquitination. The encoded protein is required for the proper ubiquitination function of APC/C and for the interaction of APC/C with transcription coactivators. It also interacts with polyA binding protein and represses internal ribosome entry site-mediated translation. Multiple transcript variants encoding different isoforms have been found for this gene. These differences cause translation initiation at a downstream AUG and result in a shorter protein (isoform b), compared to isoform a. [provided by RefSeq, Nov 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9UJX4","text":"Component of the anaphase promoting complex/cyclosome (APC/C), a cell cycle-regulated E3 ubiquitin ligase that controls progression through the cell cycle (PubMed:18485873, PubMed:27120157, PubMed:27509861). APC/C acts by mediating ubiquitination and subsequent degradation of target proteins: it mainly mediates the formation of 'Lys-11'-linked polyubiquitin chains and, to a lower extent, the formation of 'Lys-48'- and 'Lys-63'-linked polyubiquitin chains (PubMed:18485873). APC/C catalyzes assembly of branched 'Lys-11'-/'Lys-48'-linked branched ubiquitin chains on target proteins (PubMed:29033132). APC/C is activated by CDC20 in the metaphase/anaphase transition of cell cycle, targeting the degradation of cyclin B and securin (PubMed:27120157, PubMed:27509861). APC/C is regulated by the mitotic checkpoint complex (MCC), which inhibits APC/C and delays chromosome segregation (PubMed:27509861)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}