l_current":"ADGRG2","gene_id":"ENSG00000173698","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.147957,"donor_lfcse":0.228304,"donor_log2fc_shrunk":-3.00974e-06}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000173698","module":"purple","kme":0.197147,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000173698","entrez_id":["10149"],"uniprot":["Q8IZP9"],"ncbi_summary":"This gene encodes a member of the G protein-coupled receptor family described as an epididymis-specific transmembrane protein. The encoded protein may be proteolytically processed as it contains a motif shown to be a protein scission motif in some members of this family (PMID: 11973329). Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Aug 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8IZP9","text":"Adhesion G protein-coupled receptor (aGPCR) for steroid hormones, such as dehydroepiandrosterone (DHEA; also named 3beta-hydroxyandrost-5-en-17-one) and androstenedione (PubMed:29393851, PubMed:35982227, PubMed:39884271). Involved in a signal transduction pathway controlling epididymal function and male fertility (PubMed:29393851). Ligand binding causes a conformation change that triggers signaling via guanine nucleotide-binding proteins (G proteins) and modulates the activity of downstream effectors, such as adenylate cyclase (PubMed:33303626, PubMed:34234254). ADGRG2 is coupled to G(s) G proteins and mediates activation of adenylate cyclase activity (PubMed:29393851, PubMed:34234254). Also able to couple with G(q) G proteins in vitro (PubMed:29393851). Together with CFTR, required to promote fluid reabsorption within efferent ductule (PubMed:29393851)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}