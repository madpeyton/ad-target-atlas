irection":"lower in AD","module_padj":0.572565,"module_significant":false}],"degas_bulk_de":false,"drug_target":false},"seaad_pfc":{"dataset_label":"SEA-AD (Gabitto et al. 2024)","gene_ids":["ENSG00000136159"],"dataset_symbols":["NUDT15"],"explorer":"explorer.html?dataset=seaad_pfc#gene/NUDT15","cell_types":[{"cell_type":"Ast","gene_symbol":"NUDT15","gene_symbol_current":"NUDT15","gene_id":"ENSG00000136159","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.908658,"donor_log2fc":0.123164,"donor_lfcse":0.207022,"donor_log2fc_shrunk":0.00175456},{"cell_type":"Ex","gene_symbol":"NUDT15","gene_symbol_current":"NUDT15","gene_id":"ENSG00000136159","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.0657212,"nucleus_log2fc":0.0133641,"nucleus_score":-1.88667,"pct_ad":0.107632,"pct_control":0.110438,"donor_test":"not significant","donor_padj":0.825261,"donor_log2fc":0.0938458,"donor_lfcse":0.140872,"donor_log2fc_shrunk":0.00432788},{"cell_type":"In","gene_symbol":"NUDT15","gene_symbol_current":"NUDT15","gene_id":"ENSG00000136159","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.75228,"donor_log2fc":0.168424,"donor_lfcse":0.126374,"donor_log2fc_shrunk":0.00511111},{"cell_type":"Oli","gene_symbol":"NUDT15","gene_symbol_current":"NUDT15","gene_id":"ENSG00000136159","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.690954,"donor_log2fc":0.248336,"donor_lfcse":0.151126,"donor_log2fc_shrunk":0.0122438}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136159","entrez_id":["55270"],"uniprot":["Q9NV35"],"ncbi_summary":"This gene encodes an enzyme that belongs to the Nudix hydrolase superfamily. Members of this superfamily catalyze the hydrolysis of nucleoside diphosphates, including substrates like 8-oxo-dGTP, which are a result of oxidative damage, and can induce base mispairing during DNA replication, causing transversions. The encoded enzyme is a negative regulator of thiopurine activation and toxicity. Mutations in this gene result in poor metabolism of thiopurines, and are associated with thiopurine-induced early leukopenia. Multiple pseudogenes of this gene have been identified. [provided by RefSeq, Apr 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NV35","text":"Catalyzes the hydrolysis of nucleoside triphosphates including dGTP, dTTP, dCTP, their oxidized forms like 8-oxo-dGTP and the prodrug thiopurine derivatives 6-thio-dGTP and 6-thio-GTP (PubMed:26238318). Could also catalyze the hydrolysis of some nucleoside diphosphate derivatives (PubMed:22556419, PubMed:26238318). Hydrolyzes oxidized nucleosides triphosphates like 8-oxo-dGTP in vitro, but the specificity and efficiency towards these substrates are low. Therefore, the potential in vivo sanitizing role of this enzyme, that would consist in removing oxidatively damaged forms of nucleosides to prevent their incorporation into DNA, is unclear (PubMed:22556419, PubMed:26238318). Through the hydrolysis of thioguanosine triphosphates may participate in the catabolism of thiopurine drugs (PubMed:25108385, PubMed:26238318). May also have a role in DNA synthesis and cell cycle progression by stabilizing PCNA (PubMed:19419956). Exhibits decapping activity towards dpCoA-capped RNAs in vitro (By similarity). In vitro, it catalyzes the hydrolysis of isoprene pyrophosphates, including (2E)-geranyl diphosphate, isopentenyl diphosphate, (2E,6E)-farnesyl diphosphate and dimethylallyl diphosphate (PubMed:38944687). It may therefore play a role in the control of cellular levels of these metabolites that are essential for multiple cellular processes, including isoprenoids synthesis and protein isoprenylation (Probable)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}