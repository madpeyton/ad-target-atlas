eus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.381578,"nucleus_log2fc":0.0256688,"nucleus_score":0.967969,"pct_ad":0.166354,"pct_control":0.163454,"donor_test":"not significant","donor_padj":0.935606,"donor_log2fc":0.0469315,"donor_lfcse":0.0904427,"donor_log2fc_shrunk":0.00558945,"degas_log2fc":0.00794212,"degas_padj":0.79698}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000159363","module":"red","kme":0.0950043,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000159363","entrez_id":["23400"],"uniprot":["Q9NQ11"],"ncbi_summary":"This gene encodes a member of the P5 subfamily of ATPases which transports inorganic cations as well as other substrates. Mutations in this gene are associated with Kufor-Rakeb syndrome (KRS), also referred to as Parkinson disease 9. Multiple transcript variants encoding different isoforms have been found for this gene.[provided by RefSeq, Nov 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NQ11","text":"ATPase which acts as a lysosomal polyamine exporter with high affinity for spermine (PubMed:31996848). Also stimulates cellular uptake of polyamines and protects against polyamine toxicity (PubMed:31996848). Plays a role in intracellular cation homeostasis and the maintenance of neuronal integrity (PubMed:22186024). Contributes to cellular zinc homeostasis (PubMed:24603074). Confers cellular protection against Mn(2+) and Zn(2+) toxicity and mitochondrial stress (PubMed:26134396). Required for proper lysosomal and mitochondrial maintenance (PubMed:22296644, PubMed:28137957). Regulates the autophagy-lysosome pathway through the control of SYT11 expression at both transcriptional and post-translational levels (PubMed:27278822). Facilitates recruitment of deacetylase HDAC6 to lysosomes to deacetylate CTTN, leading to actin polymerization, promotion of autophagosome-lysosome fusion and completion of autophagy (PubMed:30538141). Promotes secretion of exosomes as well as secretion of SCNA via exosomes (PubMed:24603074, PubMed:25392495). Plays a role in lipid homeostasis (PubMed:31132336)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}