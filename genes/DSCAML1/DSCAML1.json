odule_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000177103","module":"pink","kme":0.380168,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000177103","module":"blue","kme":0.350555,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000177103","entrez_id":["57453"],"uniprot":["Q8TD84"],"ncbi_summary":"The protein encoded by this gene is a member of the Ig superfamily of cell adhesion molecules and is involved in neuronal differentiation. The encoded membrane-bound protein localizes to the cell surface, where it forms aggregates that repel neuronal processes of the same cell type. [provided by RefSeq, Sep 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q8TD84","text":"Cell adhesion molecule that plays a role in neuronal self-avoidance (PubMed:11453658). Promotes repulsion between specific neuronal processes of either the same cell or the same subtype of cells. Promotes both isoneuronal self-avoidance for creating an orderly neurite arborization in retinal rod bipolar cells and heteroneuronal self-avoidance to maintain mosaic spacing between AII amacrine cells (By similarity). Adhesion molecule that promotes lamina-specific synaptic connections in the retina: expressed in specific subsets of interneurons and retinal ganglion cells (RGCs) and promotes synaptic connectivity via homophilic interactions (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}