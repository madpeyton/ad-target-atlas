_log2fc":0.142114,"nucleus_score":3.88607,"pct_ad":0.392943,"pct_control":0.367972,"donor_test":"not significant","donor_padj":0.723121,"donor_log2fc":0.081234,"donor_lfcse":0.0705801,"donor_log2fc_shrunk":0.0271601},{"cell_type":"OPC","gene_symbol":"CHM","gene_symbol_current":"CHM","gene_id":"ENSG00000188419","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.224902,"nucleus_log2fc":-0.0561491,"nucleus_score":-1.59311,"pct_ad":0.492842,"pct_control":0.507875,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0215234,"donor_lfcse":0.0796597,"donor_log2fc_shrunk":-3.50507e-06},{"cell_type":"Oli","gene_symbol":"CHM","gene_symbol_current":"CHM","gene_id":"ENSG00000188419","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":0.000181635,"nucleus_log2fc":-0.0630555,"nucleus_score":-3.89173,"pct_ad":0.357665,"pct_control":0.373412,"donor_test":"not significant","donor_padj":0.983293,"donor_log2fc":-0.0132226,"donor_lfcse":0.0892751,"donor_log2fc_shrunk":-0.00156798}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000188419","entrez_id":["1121"],"uniprot":["P24386"],"ncbi_summary":"This gene encodes component A of the RAB geranylgeranyl transferase holoenzyme. In the dimeric holoenzyme, this subunit binds unprenylated Rab GTPases and then presents them to the catalytic Rab GGTase subunit for the geranylgeranyl transfer reaction. Rab GTPases need to be geranylgeranyled on either one or two cysteine residues in their C-terminus to localize to the correct intracellular membrane. Mutations in this gene are a cause of choroideremia; also known as tapetochoroidal dystrophy (TCD). This X-linked disease is characterized by progressive dystrophy of the choroid, retinal pigment epithelium and retina. Alternatively spliced transcript variants have been found for this gene. [provided by RefSeq, Mar 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P24386","text":"Substrate-binding subunit of the Rab geranylgeranyltransferase (GGTase) complex. Binds unprenylated Rab proteins and presents the substrate peptide to the catalytic component B composed of RABGGTA and RABGGTB, and remains bound to it after the geranylgeranyl transfer reaction. The component A is thought to be regenerated by transferring its prenylated Rab back to the donor membrane. Besides, a pre-formed complex consisting of CHM and the Rab GGTase dimer (RGGT or component B) can bind to and prenylate Rab proteins; this alternative pathway is proposed to be the predominant pathway for Rab protein geranylgeranylation."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}