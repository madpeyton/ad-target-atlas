ted":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.161137,"nucleus_log2fc":-0.454052,"nucleus_score":-2.235,"pct_ad":0.163592,"pct_control":0.205993,"donor_test":"not tested","donor_padj":null,"donor_log2fc":null,"donor_lfcse":null,"donor_log2fc_shrunk":null},{"cell_type":"OPC","gene_symbol":"KAT6A","gene_symbol_current":"KAT6A","gene_id":"ENSG00000083168","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.732863,"nucleus_log2fc":0.108833,"nucleus_score":0.728617,"pct_ad":0.22135,"pct_control":0.211494,"donor_test":"not significant","donor_padj":0.977919,"donor_log2fc":0.177532,"donor_lfcse":0.13731,"donor_log2fc_shrunk":0.00194231},{"cell_type":"Oli","gene_symbol":"KAT6A","gene_symbol_current":"KAT6A","gene_id":"ENSG00000083168","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0461912,"nucleus_log2fc":0.124927,"nucleus_score":2.31237,"pct_ad":0.179034,"pct_control":0.165375,"donor_test":"not significant","donor_padj":0.975805,"donor_log2fc":0.0113959,"donor_lfcse":0.0732003,"donor_log2fc_shrunk":0.00175589}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000083168","module":"green","kme":0.127935,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000083168","entrez_id":["7994"],"uniprot":["Q92794"],"ncbi_summary":"This gene encodes a member of the MOZ, YBFR2, SAS2, TIP60 family of histone acetyltransferases. The protein is composed of a nuclear localization domain, a double C2H2 zinc finger domain that binds to acetylated histone tails, a histone acetyl-transferase domain, a glutamate/aspartate-rich region, and a serine- and methionine-rich transactivation domain. It is part of a complex that acetylates lysine-9 residues in histone 3, and in addition, it acts as a co-activator for several transcription factors. Allelic variants of this gene are associated with an autosomal dominant form of cognitive disability. Chromosomal translocations of this gene are associated with acute myeloid leukemia. Alternative splicing results in multiple transcript variants. [provided by RefSeq, Jul 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q92794","text":"Histone acetyltransferase that acetylates lysine residues in histone H3 and histone H4 (in vitro) (PubMed:11742995, PubMed:11965546). Component of the MOZ/MORF complex which has a histone H3 acetyltransferase activity (PubMed:11965546). May act as a transcriptional coactivator for RUNX1 and RUNX2 (PubMed:12771199). Acetylates p53/TP53 at 'Lys-120' and 'Lys-382' and controls its transcriptional activity via association with PML (PubMed:23431171). May play a role in leukemogenic gene transcription (PubMed:39794553)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}