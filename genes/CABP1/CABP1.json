rection":"lower in AD","nucleus_padj":2.4783e-06,"nucleus_log2fc":-0.2286,"nucleus_score":-5.21947,"pct_ad":0.355652,"pct_control":0.396274,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.187338,"donor_lfcse":0.155226,"donor_log2fc_shrunk":-8.17329e-06,"degas_log2fc":0.279563,"degas_padj":1.25364e-09},{"cell_type":"Oli","gene_symbol":"CABP1","gene_symbol_current":"CABP1","gene_id":"ENSG00000157782","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":1.62852e-24,"nucleus_log2fc":-0.261694,"nucleus_score":-10.3805,"pct_ad":0.1509,"pct_control":0.180538,"donor_test":"not significant","donor_padj":0.898266,"donor_log2fc":-0.145735,"donor_lfcse":0.192678,"donor_log2fc_shrunk":-0.0042294,"degas_log2fc":-0.0934611,"degas_padj":0.00147173}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000157782","module":"blue","kme":0.225194,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000157782","module":"turquoise","kme":0.201954,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000157782","module":"turquoise","kme":0.101475,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000157782","module":"brown","kme":0.167991,"hub":false,"module_direction":"lower in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000157782","entrez_id":["9478"],"uniprot":["Q9NZU7"],"ncbi_summary":"Calcium binding proteins are an important component of calcium mediated cellular signal transduction. This gene encodes a protein that belongs to a subfamily of calcium binding proteins which share similarity to calmodulin. The protein encoded by this gene regulates the gating of voltage-gated calcium ion channels. This protein inhibits calcium-dependent inactivation and supports calcium-dependent facilitation of ion channels containing voltage-dependent L-type calcium channel subunit alpha-1C. This protein also regulates calcium-dependent activity of inositol 1,4,5-triphosphate receptors, P/Q-type voltage-gated calcium channels, and transient receptor potential channel TRPC5. This gene is predominantly expressed in retina and brain. Alternative splicing results in multiple transcript variants encoding disinct isoforms. [provided by RefSeq, Jul 2012].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9NZU7","text":"Modulates calcium-dependent activity of inositol 1,4,5-triphosphate receptors (ITPRs) (PubMed:14570872). Inhibits agonist-induced intracellular calcium signaling (PubMed:15980432). Enhances inactivation and does not support calcium-dependent facilitation of voltage-dependent P/Q-type calcium channels (PubMed:11865310). Causes calcium-dependent facilitation and inhibits inactivation of L-type calcium channels by binding to the same sites as calmodulin in the C-terminal domain of CACNA1C, but has an opposite effect on channel function (PubMed:15140941). Suppresses the calcium-dependent inactivation of CACNA1D (By similarity). Inhibits TRPC5 channels (PubMed:15895247). Prevents NMDA receptor-induced cellular degeneration. Required for the normal transfer of light signals through the retina (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}