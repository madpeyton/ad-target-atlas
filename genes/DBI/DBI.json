_current":"DBI","gene_id":"ENSG00000155368","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"unclear","nucleus_padj":0.998749,"nucleus_log2fc":0.0114098,"nucleus_score":-0.00622144,"pct_ad":0.252747,"pct_control":0.255939,"donor_test":"not significant","donor_padj":0.993604,"donor_log2fc":0.0746603,"donor_lfcse":0.233115,"donor_log2fc_shrunk":0.000282909},{"cell_type":"Oli","gene_symbol":"DBI","gene_symbol_current":"DBI","gene_id":"ENSG00000155368","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":2.79595e-15,"nucleus_log2fc":0.595763,"nucleus_score":8.31268,"pct_ad":0.11868,"pct_control":0.0816262,"donor_test":"not significant","donor_padj":0.758006,"donor_log2fc":0.40313,"donor_lfcse":0.245708,"donor_log2fc_shrunk":0.00655143}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000155368","module":"greenyellow","kme":0.371052,"hub":true,"module_direction":"higher in AD","module_padj":0.56571,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000155368","module":"turquoise","kme":0.305718,"hub":false,"module_direction":"lower in AD","module_padj":0.572565,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000155368","module":"turquoise","kme":0.169656,"hub":false,"module_direction":"lower in AD","module_padj":0.446504,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000155368","module":"turquoise","kme":0.276053,"hub":false,"module_direction":"lower in AD","module_padj":0.704234,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000155368","module":"turquoise","kme":0.248226,"hub":false,"module_direction":"higher in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000155368","entrez_id":["1622"],"uniprot":["P07108"],"ncbi_summary":"This gene encodes diazepam binding inhibitor, a protein that is regulated by hormones and is involved in lipid metabolism and the displacement of beta-carbolines and benzodiazepines, which modulate signal transduction at type A gamma-aminobutyric acid receptors located in brain synapses. The protein is conserved from yeast to mammals, with the most highly conserved domain consisting of seven contiguous residues that constitute the hydrophobic binding site for medium- and long-chain acyl-Coenzyme A esters. Diazepam binding inhibitor is also known to mediate the feedback regulation of pancreatic secretion and the postprandial release of cholecystokinin, in addition to its role as a mediator in corticotropin-dependent adrenal steroidogenesis. Three pseudogenes located on chromosomes 6, 8 and 16 have been identified. Multiple transcript variants encoding different isoforms have been described for this gene. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P07108","text":"Binds medium- and long-chain acyl-CoA esters with very high affinity and may function as an intracellular carrier of acyl-CoA esters. It is also able to displace diazepam from the benzodiazepine (BZD) recognition site located on the GABA type A receptor. It is therefore possible that this protein also acts as a neuropeptide to modulate the action of the GABA receptor."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}