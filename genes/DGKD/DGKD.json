ene_symbol":"DGKD","gene_symbol_current":"DGKD","gene_id":"ENSG00000077044","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.869731,"donor_log2fc":-0.111099,"donor_lfcse":0.124223,"donor_log2fc_shrunk":-0.00683488}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000077044","module":"brown","kme":0.0561537,"hub":false,"module_direction":"lower in AD","module_padj":0.416898,"module_significant":false},{"cell_type":"In","gene_id":"ENSG00000077044","module":"magenta","kme":0.318534,"hub":false,"module_direction":"lower in AD","module_padj":0.216803,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000077044","module":"brown","kme":0.116478,"hub":false,"module_direction":"lower in AD","module_padj":0.683527,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000077044","module":"blue","kme":0.0918975,"hub":false,"module_direction":"lower in AD","module_padj":0.415372,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000077044","entrez_id":["8527"],"uniprot":["Q16760"],"ncbi_summary":"This gene encodes a cytoplasmic enzyme that phosphorylates diacylglycerol to produce phosphatidic acid. Diacylglycerol and phosphatidic acid are two lipids that act as second messengers in signaling cascades. Their cellular concentrations are regulated by the encoded protein, and so it is thought to play an important role in cellular signal transduction. Alternative splicing results in two transcript variants encoding different isoforms. [provided by RefSeq, Jul 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q16760","text":"Diacylglycerol kinase that converts diacylglycerol/DAG into phosphatidic acid/phosphatidate/PA and regulates the respective levels of these two bioactive lipids (PubMed:12200442, PubMed:23949095). Thereby, acts as a central switch between the signaling pathways activated by these second messengers with different cellular targets and opposite effects in numerous biological processes (Probable). By controlling the levels of diacylglycerol, regulates for instance the PKC and EGF receptor signaling pathways and plays a crucial role during development (By similarity). May also regulate clathrin-dependent endocytosis (PubMed:17880279)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}