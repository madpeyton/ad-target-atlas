leus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.943423,"donor_log2fc":-0.0688055,"donor_lfcse":0.181035,"donor_log2fc_shrunk":-0.00429461},{"cell_type":"OPC","gene_symbol":"ACP2","gene_symbol_current":"ACP2","gene_id":"ENSG00000134575","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.232327,"donor_lfcse":0.174516,"donor_log2fc_shrunk":-7.92607e-06},{"cell_type":"Oli","gene_symbol":"ACP2","gene_symbol_current":"ACP2","gene_id":"ENSG00000134575","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.712269,"donor_log2fc":-0.217841,"donor_lfcse":0.139467,"donor_log2fc_shrunk":-0.0127257}],"modules":[{"cell_type":"OPC","gene_id":"ENSG00000134575","module":"turquoise","kme":0.0618342,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000134575","entrez_id":["53"],"uniprot":["P11117"],"ncbi_summary":"The protein encoded by this gene belongs to the histidine acid phosphatase family, which hydrolyze orthophosphoric monoesters to alcohol and phosphate. This protein is localized to the lysosomal membrane, and is chemically and genetically distinct from the red cell acid phosphatase. Mice lacking this gene showed multiple defects, including bone structure alterations, lysosomal storage defects, and an increased tendency towards seizures. An enzymatically-inactive allele of this gene in mice showed severe growth retardation, hair-follicle abnormalities, and an ataxia-like phenotype. Alternatively spliced transcript variants have been found for this gene. A C-terminally extended isoform is also predicted to be produced by the use of an alternative in-frame translation termination codon via a stop codon readthrough mechanism. [provided by RefSeq, Oct 2017].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"P11117","text":"Lysosomal acid phosphatase that catalyzes the hydrolysis of orthophosphoric monoesters to alcohols and phosphate under acidic conditions (Probable) (PubMed:6090300). May contribute to the removal of mannose-6-phosphate (Man6P) from lysosomal proteins after their delivery to lysosomes, acting in concert with ACP5 (By similarity). (Microbial infection) Plays a crucial role in the membrane fusion step of the influenza A and B viruses entry process."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}