019":{"dataset_label":"Mathys et al. 2019","gene_ids":["ENSG00000101407"],"dataset_symbols":["TTI1"],"explorer":"explorer.html?dataset=mathys2019#gene/TTI1","cell_types":[{"cell_type":"Ex","gene_symbol":"TTI1","gene_symbol_current":"TTI1","gene_id":"ENSG00000101407","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":6.71173e-05,"nucleus_log2fc":-0.19045,"nucleus_score":-4.286,"pct_ad":0.145469,"pct_control":0.166613,"donor_test":"not significant","donor_padj":0.985617,"donor_log2fc":-0.0754331,"donor_lfcse":0.0750758,"donor_log2fc_shrunk":-1.39543e-05}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000101407","entrez_id":["9675"],"uniprot":["O43156"],"ncbi_summary":"Involved in regulation of TOR signaling. Located in cytoplasm. Part of TORC1 complex and TORC2 complex. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O43156","text":"Regulator of the DNA damage response (DDR). Part of the TTT complex that is required to stabilize protein levels of the phosphatidylinositol 3-kinase-related protein kinase (PIKK) family proteins. The TTT complex is involved in the cellular resistance to DNA damage stresses, like ionizing radiation (IR), ultraviolet (UV) and mitomycin C (MMC). Together with the TTT complex and HSP90 may participate in the proper folding of newly synthesized PIKKs. Promotes assembly, stabilizes and maintains the activity of mTORC1 and mTORC2 complexes, which regulate cell growth and survival in response to nutrient and hormonal signals."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_03","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}