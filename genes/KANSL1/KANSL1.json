eus_score":4.41895,"pct_ad":0.901432,"pct_control":0.902117,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.100508,"donor_lfcse":0.128962,"donor_log2fc_shrunk":6.35179e-06},{"cell_type":"Oli","gene_symbol":"KANSL1","gene_symbol_current":"KANSL1","gene_id":"ENSG00000120071","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"higher in AD","nucleus_padj":0.0,"nucleus_log2fc":0.446173,"nucleus_score":43.8376,"pct_ad":0.858979,"pct_control":0.813814,"donor_test":"not significant","donor_padj":0.686567,"donor_log2fc":0.246797,"donor_lfcse":0.148274,"donor_log2fc_shrunk":0.0128195}],"modules":[{"cell_type":"Ex","gene_id":"ENSG00000120071","module":"green","kme":0.298486,"hub":false,"module_direction":"higher in AD","module_padj":0.232138,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000120071","module":"yellow","kme":0.289208,"hub":false,"module_direction":"higher in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000120071","module":"blue","kme":0.233697,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":true,"target_cell_types":[{"cell_type":"Ex","rank":6},{"cell_type":"In","rank":2}],"approved_drugs_status":"not tested","approved_drugs_reason":"no structure with a usable bound ligand (drug-sized, not an additive, on this protein)","screening_hits_status":"not tested","screening_hits_reason":"not in GenomeScreenDB","approved_drugs":[],"n_screening_hits":0,"top_screening_hits":[],"notes":[]}},"description":[{"gene_id":"ENSG00000120071","entrez_id":["284058"],"uniprot":["Q7Z3B3"],"ncbi_summary":"This gene encodes a nuclear protein that is a subunit of two protein complexes involved with histone acetylation, the MLL1 complex and the NSL1 complex. The encoded protein has been implicated in a variety of cellular processes including enhancer regulation, cell proliferation, and mitosis. Mutations in this gene are associated with Koolen-de Vries Syndrome. [provided by RefSeq, May 2022].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q7Z3B3","text":"Non-catalytic component of the NSL histone acetyltransferase complex, a multiprotein complex that mediates histone H4 acetylation at 'Lys-5'- and 'Lys-8' (H4K5ac and H4K8ac) at transcription start sites and promotes transcription initiation (PubMed:20018852, PubMed:22547026, PubMed:33657400). The NSL complex also acts as a regulator of gene expression in mitochondria (PubMed:27768893). In addition to its role in transcription, KANSL1 also plays an essential role in spindle assembly during mitosis (PubMed:26243146). Associates with microtubule ends and contributes to microtubule stability (PubMed:26243146)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":["Q7Z3B3"]}