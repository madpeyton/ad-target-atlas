oise","kme":0.0786052,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000188976","module":"turquoise","kme":0.0484259,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000188976","entrez_id":["26155"],"uniprot":["Q9Y3T9"],"ncbi_summary":"Histone modification by histone acetyltransferases (HAT) and histone deacetylases (HDAC) can control major aspects of transcriptional regulation. NOC2L represents a novel HDAC-independent inhibitor of histone acetyltransferase (INHAT) (Hublitz et al., 2005 [PubMed 16322561]).[supplied by OMIM, Mar 2008].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y3T9","text":"Acts as an inhibitor of histone acetyltransferase activity; prevents acetylation of all core histones by the EP300/p300 histone acetyltransferase at p53/TP53-regulated target promoters in a histone deacetylases (HDAC)-independent manner. Acts as a transcription corepressor of p53/TP53- and TP63-mediated transactivation of the p21/CDKN1A promoter. Involved in the regulation of p53/TP53-dependent apoptosis. Associates together with TP63 isoform TA*-gamma to the p21/CDKN1A promoter."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}