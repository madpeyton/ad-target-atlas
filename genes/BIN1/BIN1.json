e":0.241225,"donor_log2fc_shrunk":-0.0180147,"degas_log2fc":-0.353534,"degas_padj":8.97315e-30},{"cell_type":"OPC","gene_symbol":"BIN1","gene_symbol_current":"BIN1","gene_id":"ENSG00000136717","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"higher in AD","nucleus_padj":0.0572515,"nucleus_log2fc":0.130941,"nucleus_score":2.35333,"pct_ad":0.226514,"pct_control":0.208975,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":0.223032,"donor_lfcse":0.111493,"donor_log2fc_shrunk":1.88079e-05,"degas_log2fc":-0.213625,"degas_padj":0.000556595},{"cell_type":"Oli","gene_symbol":"BIN1","gene_symbol_current":"BIN1","gene_id":"ENSG00000136717","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.297946,"nucleus_log2fc":-0.0160181,"nucleus_score":-1.14069,"pct_ad":0.820677,"pct_control":0.826683,"donor_test":"not significant","donor_padj":0.967389,"donor_log2fc":-0.0215522,"donor_lfcse":0.0658635,"donor_log2fc_shrunk":-0.00508537,"degas_log2fc":-0.132756,"degas_padj":5.02065e-32}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000136717","module":"blue","kme":0.102717,"hub":false,"module_direction":"lower in AD","module_padj":0.506562,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000136717","module":"green","kme":0.0466938,"hub":false,"module_direction":"higher in AD","module_padj":0.232138,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000136717","module":"blue","kme":0.249281,"hub":false,"module_direction":"higher in AD","module_padj":0.625991,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000136717","entrez_id":["274"],"uniprot":["O00499"],"ncbi_summary":"This gene encodes several isoforms of a nucleocytoplasmic adaptor protein, one of which was initially identified as a MYC-interacting protein with features of a tumor suppressor. Isoforms that are expressed in the central nervous system may be involved in synaptic vesicle endocytosis and may interact with dynamin, synaptojanin, endophilin, and clathrin. Isoforms that are expressed in muscle and ubiquitously expressed isoforms localize to the cytoplasm and nucleus and activate a caspase-independent apoptotic process. Studies in mouse suggest that this gene plays an important role in cardiac muscle development. Alternate splicing of the gene results in several transcript variants encoding different isoforms. Aberrant splice variants expressed in tumor cell lines have also been described. [provided by RefSeq, Mar 2016].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"O00499","text":"Is a key player in the control of plasma membrane curvature, membrane shaping and membrane remodeling. Required in muscle cells for the formation of T-tubules, tubular invaginations of the plasma membrane that function in depolarization-contraction coupling (PubMed:24755653). Is a negative regulator of endocytosis (By similarity). Is also involved in the regulation of intracellular vesicles sorting, modulation of BACE1 trafficking and the control of amyloid-beta production (PubMed:27179792). In neuronal circuits, endocytosis regulation may influence the internalization of PHF-tau aggregates (By similarity). May be involved in the regulation of MYC activity and the control cell proliferation (PubMed:8782822). Has actin bundling activity and stabilizes actin filaments against depolymerization in vitro (PubMed:28893863)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}