":-0.00279227,"degas_log2fc":0.119379,"degas_padj":0.00191686},{"cell_type":"OPC","gene_symbol":"MTF2","gene_symbol_current":"MTF2","gene_id":"ENSG00000143033","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0993159,"nucleus_log2fc":-0.0787451,"nucleus_score":-2.08046,"pct_ad":0.500596,"pct_control":0.515495,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.0554019,"donor_lfcse":0.0627558,"donor_log2fc_shrunk":-8.53036e-06,"degas_log2fc":-0.148855,"degas_padj":8.09657e-05},{"cell_type":"Oli","gene_symbol":"MTF2","gene_symbol_current":"MTF2","gene_id":"ENSG00000143033","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":7.99668e-29,"nucleus_log2fc":-0.219424,"nucleus_score":-11.3015,"pct_ad":0.319189,"pct_control":0.358716,"donor_test":"not significant","donor_padj":0.525155,"donor_log2fc":-0.171019,"donor_lfcse":0.0745249,"donor_log2fc_shrunk":-0.0557623,"degas_log2fc":-0.187464,"degas_padj":1.20977e-20}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000143033","module":"turquoise","kme":0.118001,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000143033","entrez_id":["22823"],"uniprot":["Q9Y483"],"ncbi_summary":"Enables methylated histone binding activity and transcription corepressor binding activity. Predicted to be involved in several processes, including regulation of histone H3-K27 methylation; regulation of transcription by RNA polymerase II; and segment specification. Predicted to act upstream of or within cellular response to leukemia inhibitory factor. Located in cytoplasm; focal adhesion; and nucleoplasm. [provided by Alliance of Genome Resources, Apr 2022]","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9Y483","text":"Polycomb group (PcG) protein that specifically binds histone H3 trimethylated at 'Lys-36' (H3K36me3) and recruits the PRC2 complex, thus enhancing PRC2 H3K27me3 methylation activity (PubMed:23142980, PubMed:23228662, PubMed:31959557). Regulates the transcriptional networks during embryonic stem cell self-renewal and differentiation (By similarity). Promotes recruitment of the PRC2 complex to the inactive X chromosome in differentiating XX ES cells and PRC2 recruitment to target genes in undifferentiated ES cells (By similarity). Required to repress Hox genes by enhancing H3K27me3 methylation of the PRC2 complex (By similarity). In some conditions may act as an inhibitor of PRC2 activity: able to activate the CDKN2A gene and promote cellular senescence by suppressing the catalytic activity of the PRC2 complex locally (By similarity). Binds to the metal-regulating-element (MRE) of MT1A gene promoter (By similarity)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}