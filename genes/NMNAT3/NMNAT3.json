,"gene_symbol":"NMNAT3","gene_symbol_current":"NMNAT3","gene_id":"ENSG00000163864","nucleus_tested":true,"nucleus_significant":false,"nucleus_direction":"lower in AD","nucleus_padj":0.0934515,"nucleus_log2fc":-0.0868565,"nucleus_score":-2.11093,"pct_ad":0.447062,"pct_control":0.460965,"donor_test":"not significant","donor_padj":0.999342,"donor_log2fc":-0.11933,"donor_lfcse":0.0704919,"donor_log2fc_shrunk":-2.5092e-05},{"cell_type":"Oli","gene_symbol":"NMNAT3","gene_symbol_current":"NMNAT3","gene_id":"ENSG00000163864","nucleus_tested":true,"nucleus_significant":true,"nucleus_direction":"lower in AD","nucleus_padj":3.77371e-97,"nucleus_log2fc":-0.50681,"nucleus_score":-21.0669,"pct_ad":0.188076,"pct_control":0.253906,"donor_test":"not significant","donor_padj":0.612837,"donor_log2fc":-0.316013,"donor_lfcse":0.159792,"donor_log2fc_shrunk":-0.0148589}],"modules":[{"cell_type":"Ast","gene_id":"ENSG00000163864","module":"turquoise","kme":0.195513,"hub":false,"module_direction":"lower in AD","module_padj":0.796936,"module_significant":false},{"cell_type":"Ex","gene_id":"ENSG00000163864","module":"yellow","kme":0.408483,"hub":false,"module_direction":"higher in AD","module_padj":0.552322,"module_significant":false},{"cell_type":"Mic","gene_id":"ENSG00000163864","module":"turquoise","kme":0.0531935,"hub":false,"module_direction":"lower in AD","module_padj":0.398013,"module_significant":false},{"cell_type":"OPC","gene_id":"ENSG00000163864","module":"turquoise","kme":0.038912,"hub":false,"module_direction":"higher in AD","module_padj":0.680759,"module_significant":false},{"cell_type":"Oli","gene_id":"ENSG00000163864","module":"turquoise","kme":0.153116,"hub":false,"module_direction":"higher in AD","module_padj":0.842971,"module_significant":false}],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000163864","entrez_id":["349565"],"uniprot":["Q96T66"],"ncbi_summary":"This gene encodes a member of the nicotinamide/nicotinic acid mononucleotide adenylyltransferase family. These enzymes use ATP to catalyze the synthesis of nicotinamide adenine dinucleotide or nicotinic acid adenine dinucleotide from nicotinamide mononucleotide or nicotinic acid mononucleotide, respectively. The encoded protein is localized to mitochondria and may also play a neuroprotective role as a molecular chaperone. Alternatively spliced transcript variants encoding multiple isoforms have been observed for this gene. [provided by RefSeq, Jan 2011].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q96T66","text":"Catalyzes the formation of NAD(+) from nicotinamide mononucleotide (NMN) and ATP (PubMed:16118205, PubMed:17402747, PubMed:26616331). Can also use the deamidated form; nicotinic acid mononucleotide (NaMN) as substrate with the same efficiency. Can use triazofurin monophosphate (TrMP) as substrate. Can also use GTP and ITP as nucleotide donors. Also catalyzes the reverse reaction, i.e. the pyrophosphorolytic cleavage of NAD(+). For the pyrophosphorolytic activity, can use NAD(+), NADH, NaAD, nicotinic acid adenine dinucleotide phosphate (NHD), nicotinamide guanine dinucleotide (NGD) as substrates. Fails to cleave phosphorylated dinucleotides NADP(+), NADPH and NaADP(+). Protects against axonal degeneration following injury (PubMed:16118205, PubMed:17402747). May be involved in the maintenance of axonal integrity (By similarity). Also functions as a stress-response chaperone protein that prevents toxic aggregation of proteins; this function may be independent of its NAD(+) synthesis activity (PubMed:18344983)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}