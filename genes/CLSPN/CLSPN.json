67,"donor_log2fc":-0.11718,"donor_lfcse":0.0824603,"donor_log2fc_shrunk":-0.0155045,"degas_log2fc":-0.00976582,"degas_padj":0.601919},{"cell_type":"In","gene_symbol":"CLSPN","gene_symbol_current":"CLSPN","gene_id":"ENSG00000092853","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.751245,"donor_log2fc":0.137775,"donor_lfcse":0.0994732,"donor_log2fc_shrunk":0.00674373,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Mic","gene_symbol":"CLSPN","gene_symbol_current":"CLSPN","gene_id":"ENSG00000092853","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.984393,"donor_log2fc":-0.0475672,"donor_lfcse":0.440317,"donor_log2fc_shrunk":-0.000484728,"degas_log2fc":null,"degas_padj":null},{"cell_type":"Oli","gene_symbol":"CLSPN","gene_symbol_current":"CLSPN","gene_id":"ENSG00000092853","nucleus_tested":false,"nucleus_significant":null,"nucleus_direction":"not tested","nucleus_padj":null,"nucleus_log2fc":null,"nucleus_score":null,"pct_ad":null,"pct_control":null,"donor_test":"not significant","donor_padj":0.784832,"donor_log2fc":-0.21644,"donor_lfcse":0.166279,"donor_log2fc_shrunk":-0.00872306,"degas_log2fc":null,"degas_padj":null}],"modules":[],"degas_bulk_de":false,"drug_target":false}},"description":[{"gene_id":"ENSG00000092853","entrez_id":["63967"],"uniprot":["Q9HAW4"],"ncbi_summary":"The product of this gene is an essential upstream regulator of checkpoint kinase 1 and triggers a checkpoint arrest of the cell cycle in response to replicative stress or DNA damage. The protein is also required for efficient DNA replication during a normal S phase. Multiple transcript variants encoding different isoforms have been found for this gene. [provided by RefSeq, Jun 2010].","ncbi_source":"NCBI Gene summary (RefSeq), via MyGene.info","uniprot_function":[{"accession":"Q9HAW4","text":"Required for checkpoint mediated cell cycle arrest in response to inhibition of DNA replication or to DNA damage induced by both ionizing and UV irradiation (PubMed:12766152, PubMed:15190204, PubMed:15707391, PubMed:16123041). Adapter protein which binds to BRCA1 and the checkpoint kinase CHEK1 and facilitates the ATR-dependent phosphorylation of both proteins (PubMed:12766152, PubMed:15096610, PubMed:15707391, PubMed:16123041). Also required to maintain normal rates of replication fork progression during unperturbed DNA replication. Binds directly to DNA, with particular affinity for branched or forked molecules and interacts with multiple protein components of the replisome such as the MCM2-7 complex and TIMELESS (PubMed:15226314, PubMed:34694004, PubMed:35585232). Important for initiation of DNA replication, recruits kinase CDC7 to phosphorylate MCM2-7 components (PubMed:27401717)."}],"uniprot_source":"UniProtKB/Swiss-Prot Function, release 2026_04","retrieved":"2026-10-21"}],"structures":[],"alphafold_accessions":[]}